  "Cache": {
    "CatalogTtlMinutes": 15,
    "SearchTtlMinutes": 5
  },
  "Sre": {
    "SloAvailabilityTarget": 99.9,
    "RtoHours": 4,
    "RpoHours": 1
  },
  "Observability": {
    "OpenTelemetry": {
      "Enabled": false,
      "ServiceName": "CarRentalSystem",
      "OtlpEndpoint": "",
      "Headers": ""
    }
  },
  "Analytics": {
    "Enabled": false,
    "Provider": "Noop",
    "WriteKey": ""
  },
  "Localization": {
    "DefaultCulture": "vi-VN",
    "SupportedCultures": [ "vi-VN", "en-US" ]
  },
  "ApiDocs": {
    "Enabled": false,
    "RequireAuth": true
  },
  "PublicApi": {
    "Enabled": false,
    "RequireApiKey": true,
    "RequireRateLimit": true,
    "RequireAudit": true,
    "RequireWebhookSigning": true
  },
  "Authentication": {
    "Google": {
      "ClientId": "",
      "ClientSecret": ""
    },
    "Microsoft": {
      "ClientId": "",
      "ClientSecret": "",
      "TenantId": ""
    }
  },
  "Snapshot": {
    "AllowUnsafeDownload": false,
    "AllowUnsafeRestore": false,
    "AllowUnsafeDetails": false
  },
  "Cors": {
    "AllowedOrigins": [
      "https://your-production-domain.example"
    ]
  },
  "Tracking": {
    "IngestSecret": "CHANGE_TO_A_LONG_RANDOM_SECRET"
  },
  "DataProtection": {
    "ApplicationName": "CarRentalSystem",
    "KeysPath": "C:\\CarRentalSystem\\keys"
  },
  "PayOS": {
    "ClientId": "YOUR_PAYOS_CLIENT_ID",
    "ApiKey": "YOUR_PAYOS_API_KEY",
    "ChecksumKey": "YOUR_PAYOS_CHECKSUM_KEY",
    "PayoutEnabled": false,
    "PartnerCode": "YOUR_PAYOS_PARTNER_CODE"
  },
  "SmtpSettings": {
    "Host": "smtp.your-provider.example",
    "Port": "587",
    "User": "YOUR_SMTP_USER",
    "Pass": "YOUR_SMTP_PASSWORD"
