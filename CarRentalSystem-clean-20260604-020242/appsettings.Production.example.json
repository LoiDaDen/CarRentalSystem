  "Ai": {
    "Enabled": false,
    "Provider": "OpenAI",
    "ApiKey": "",
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-4.1-mini"
  },
  "Groq": {
    "ApiKey": ""
  },
  "Recaptcha": {
    "SiteKey": "YOUR_RECAPTCHA_SITE_KEY",
    "SecretKey": "YOUR_RECAPTCHA_SECRET_KEY",
    "VerifyTimeoutSeconds": 6
  },
  "Admin": {
    "Pin": "CHANGE_TO_A_SECURE_6_DIGIT_PIN"
  }
