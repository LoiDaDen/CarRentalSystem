{
  "ConnectionStrings": {
    "DefaultConnection": "Server=YOUR_SQL_SERVER;Database=CarRentalDB;User Id=YOUR_SQL_USER;Password=YOUR_SQL_PASSWORD;Encrypt=True;TrustServerCertificate=False;MultipleActiveResultSets=false"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "your-production-domain.example",
  "App": {
    "PublicBaseUrl": "https://your-production-domain.example"
  },
  "Redis": {
    "ConnectionString": ""
  },
  "Features": {
    "WalletStoredValue": false,
    "WithDriverPublicBooking": false
  },
  "Security": {
    "RunMigrationsOnStartup": false,
    "SeedReferenceDataOnStartup": false,
    "TrustForwardedHeaders": false,
    "EnableRecurringJobs": true,
    "RequirePrivilegedMfa": true,
    "RequireRecaptcha": true,
    "RequirePrivilegedSso": false,
    "MfaExemptEmails": [
      "mgr.north@carrental.com",
      "mgr.central@carrental.com",
      "mgr.south@carrental.com",
      "mgr.southeast@carrental.com",
      "mgr.centralhighlands@carrental.com",
      "staff.north@carrental.com",
      "staff.central@carrental.com",
      "staff.south@carrental.com",
      "staff.southeast@carrental.com",
      "staff.centralhighlands@carrental.com"
    ],
    "AdminMfaExemptEmails": [
      "hloi78274@gmail.com"
    ]
  },
  "Auth": {
    "LoginTimeoutSeconds": 15,
    "MfaQueueTimeoutSeconds": 5,
    "EmailSendTimeoutSeconds": 12
  },
  "Database": {
    "CommandTimeoutSeconds": 20
  },
  "Audit": {
    "HashChainEnabled": true
  },
  "DisputeExport": {
    "IncludeSensitiveDefault": false
