<div class="theme-admin">
<style>
    .theme-admin .card { background: var(--admin-card-bg); border: 1px solid var(--admin-border-color); }
    .theme-admin .card-header { background: var(--admin-surface-200); border-bottom: 1px solid var(--admin-border-color); }
    .theme-admin .bg-light { background-color: var(--admin-surface-200) !important; }
    .theme-admin .text-muted { color: var(--admin-text-secondary) !important; }
    .theme-admin .text-dark { color: var(--admin-text) !important; }
    .theme-admin .table { color: var(--admin-text); }
</style>

@model IEnumerable<CarRentalSystem.Models.HolidayPricing>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Giá theo Ngày Lễ";
}

<!-- Price Calculator Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-4 pb-0">
        <h4 class="fw-bold mb-1">
            <i class="bi bi-calculator text-primary me-2"></i>Tính Giá Theo Ngày
        </h4>
        <p class="text-muted small mb-0">Nhập ngày bắt đầu, kết thúc và giá/ngày để xem tổng chi phí</p>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted text-uppercase">Ngày bắt đầu</label>
                <input type="date" id="calcStartDate" class="form-control form-control-lg rounded-3" value="@DateTime.Now.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted text-uppercase">Ngày kết thúc</label>
                <input type="date" id="calcEndDate" class="form-control form-control-lg rounded-3" value="@DateTime.Now.AddDays(6).ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-bold small text-muted text-uppercase">Giá / ngày (VNĐ)</label>
                <input type="number" id="calcPricePerDay" class="form-control form-control-lg rounded-3" placeholder="500000" value="500000" min="0" />
            </div>
            <div class="col-md-3">
                <button onclick="calculatePrice()" class="btn btn-primary btn-lg w-100 rounded-3 fw-bold">
                    <i class="bi bi-calculator me-2"></i>Tính Giá
                </button>
            </div>
        </div>
        
        <!-- Result -->
        <div id="priceResult" class="mt-4" style="display: none;">
            <div class="row g-3 mb-3">
                <div class="col-md-3">
                    <div class="card bg-light border-0 h-100">
                        <div class="card-body text-center py-3">
                            <div class="small text-muted text-uppercase fw-bold">Số ngày</div>
                            <div class="fs-3 fw-bold text-dark" id="resultTotalDays">-</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-light border-0 h-100">
                        <div class="card-body text-center py-3">
                            <div class="small text-muted text-uppercase fw-bold">Giá / ngày</div>
                            <div class="fs-5 fw-bold text-dark" id="resultPricePerDay">-</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-primary bg-opacity-10 border-0 h-100">
                        <div class="card-body text-center py-3">
                            <div class="small text-muted text-uppercase fw-bold">Hệ số TB</div>
                            <div class="fs-3 fw-bold text-primary" id="resultAvgMultiplier">-</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card bg-success bg-opacity-10 border-0 h-100">
                        <div class="card-body text-center py-3">
                            <div class="small text-muted text-uppercase fw-bold">Tổng cộng</div>
                            <div class="fs-4 fw-bold text-success" id="resultTotalPrice">-</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Summary badges -->
            <div class="d-flex flex-wrap gap-2 mb-3">
                <span class="badge bg-secondary px-3 py-2" id="badgeNormal">
                    <i class="bi bi-calendar3 me-1"></i>Ngày thường: <strong id="countNormal">0</strong>
                </span>
                <span class="badge bg-warning text-dark px-3 py-2" id="badgeWeekend">
                    <i class="bi bi-calendar-week me-1"></i>Cuối tuần: <strong id="countWeekend">0</strong>
                </span>
                <span class="badge bg-danger px-3 py-2" id="badgeHoliday">
                    <i class="bi bi-star-fill me-1"></i>Ngày lễ/Tết: <strong id="countHoliday">0</strong>
                </span>
            </div>
            
            <!-- Date breakdown table -->
            <div class="mt-3">
                <h6 class="fw-bold mb-3"><i class="bi bi-list-ul me-1"></i>Chi tiết từng ngày:</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-hover table-bordered mb-0">
                        <thead class="table-dark">
                            <tr class="text-center">
                                <th class="ps-3">Ngày</th>
                                <th>Thứ</th>
                                <th>Loại ngày</th>
                                <th>Hệ số</th>
                                <th>Giá ngày</th>
                            </tr>
                        </thead>
                        <tbody id="dateBreakdown" class="text-center">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cấu hình Multiplier -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body text-center py-4">
                <div class="mb-3">
                    <span class="badge bg-warning text-dark rounded-circle p-3">
                        <i class="bi bi-calendar-week fs-4"></i>
                    </span>
                </div>
                <h5 class="fw-bold">Cuối Tuần</h5>
                <div class="fs-3 fw-bold text-warning mb-2">x @ViewBag.WeekendMultiplier</div>
                <small class="text-muted">Thứ 7 & Chủ nhật</small>
                <div class="mt-2 text-success fw-bold">+@((ViewBag.WeekendMultiplier - 1) * 100)%</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body text-center py-4">
                <div class="mb-3">
                    <span class="badge bg-danger rounded-circle p-3">
                        <i class="bi bi-star-fill fs-4"></i>
                    </span>
                </div>
                <h5 class="fw-bold">Ngày Lễ Lớn</h5>
                <div class="fs-3 fw-bold text-danger mb-2">x @ViewBag.MajorHolidayMultiplier</div>
                <small class="text-muted">30/4, 1/5, 2/9...</small>
                <div class="mt-2 text-success fw-bold">+@((ViewBag.MajorHolidayMultiplier - 1) * 100)%</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 h-100">
            <div class="card-body text-center py-4">
                <div class="mb-3">
                    <span class="badge bg-primary rounded-circle p-3">
                        <i class="bi bi-gem fs-4"></i>
                    </span>
                </div>
                <h5 class="fw-bold">Tết Nguyên Đán</h5>
                <div class="fs-3 fw-bold text-primary mb-2">x @ViewBag.TetHolidayMultiplier</div>
                <small class="text-muted">7 ngày nghỉ Tết</small>
                <div class="mt-2 text-success fw-bold">+@((ViewBag.TetHolidayMultiplier - 1) * 100)%</div>
            </div>
        </div>
    </div>
</div>

<!-- Ngày lễ trong năm -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-white border-0 pt-4 pb-2">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bold mb-1">
                    <i class="bi bi-calendar-event text-danger me-2"></i>Ngày Lễ Việt Nam @ViewBag.CurrentYear
                </h4>
                <p class="text-muted small mb-0">Danh sách các ngày lễ được áp dụng tự động</p>
            </div>
            <div class="d-flex gap-2">
                <select id="yearSelect" class="form-select rounded-3" onchange="loadYearHolidays(this.value)">
                    <option value="@(ViewBag.CurrentYear - 1)">@(ViewBag.CurrentYear - 1)</option>
                    <option value="@ViewBag.CurrentYear" selected>@ViewBag.CurrentYear</option>
                    <option value="@(ViewBag.CurrentYear + 1)">@(ViewBag.CurrentYear + 1)</option>
                    <option value="@(ViewBag.CurrentYear + 2)">@(ViewBag.CurrentYear + 2)</option>
                </select>
            </div>
        </div>
    </div>
    <div class="card-body pt-2">
        <div id="holidayList" class="row g-2">
            <!-- Loaded via JS -->
            <div class="col-12 text-center py-4">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="text-muted mt-2">Đang tải...</p>
            </div>
        </div>
    </div>
</div>

<!-- Custom Pricing from DB -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 pt-4 pb-2">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h4 class="fw-bold mb-1">
                    <i class="bi bi-gear text-secondary me-2"></i>Cấu Hình Giá Tùy Chỉnh (DB)
                </h4>
                <p class="text-muted small mb-0">Override mặc định cho từng xe hoặc toàn hệ thống</p>
            </div>
            <a asp-action="Create" class="btn btn-primary rounded-3 fw-bold">
                <i class="bi bi-plus-lg me-2"></i>Thêm Mới
            </a>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-4 text-muted opacity-25 d-block mb-3"></i>
                <p class="text-muted">Chưa có cấu hình tùy chỉnh. Hệ thống đang dùng cấu hình mặc định.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background: #f8fafd;">
                        <tr class="text-muted small text-uppercase fw-bold" style="font-size: 0.72rem;">
                            <th class="ps-4 py-3">Tên ngày lễ</th>
                            <th class="py-3">Thời gian</th>
                            <th class="py-3">Xe áp dụng</th>
                            <th class="py-3 text-center">Hệ số</th>
                            <th class="py-3 text-center">Trạng thái</th>
                            <th class="py-3 text-end pe-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold">@item.HolidayName</div>
                                </td>
                                <td>
                                    <div class="small">
                                        <i class="bi bi-calendar3 me-1 text-muted"></i>
                                        @item.StartDate.ToString("dd/MM/yyyy") - @item.EndDate.ToString("dd/MM/yyyy")
                                    </div>
                                </td>
                                <td>
                                    @if (item.CarID == null)
                                    {
                                        <span class="badge bg-info rounded-pill px-3">Tất cả xe</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill px-3">@item.Car?.CarName</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-@(item.PriceMultiplier >= 2 ? "danger" : item.PriceMultiplier >= 1.5m ? "warning text-dark" : "success") rounded-pill px-3 py-2 fw-bold">
                                        x @item.PriceMultiplier.ToString("F2")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-@(item.IsActive ? "success" : "secondary") rounded-pill px-3">
                                        @(item.IsActive ? "Hoạt động" : "Tắt")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-1 justify-content-end">
                                        <form asp-action="ToggleActive" asp-route-id="@item.HolidayPricingID" method="post">
                                            <button type="submit" class="btn btn-sm btn-@(item.IsActive ? "outline-warning" : "outline-success") rounded-pill">
                                                <i class="bi bi-@(item.IsActive ? "pause" : "play")"></i>
                                            </button>
                                        </form>
                                        <a asp-action="Edit" asp-route-id="@item.HolidayPricingID" class="btn btn-sm btn-outline-primary rounded-pill">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-action="Delete" asp-route-id="@item.HolidayPricingID" method="post" onsubmit="return confirm('Xóa cấu hình này?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
</div>

@section Scripts {
    <script>
        // Format currency
        function formatCurrency(num) {
            return new Intl.NumberFormat('vi-VN').format(num) + ' đ';
        }
        
        // Calculate price - tính theo ngày
        async function calculatePrice() {
            const startDate = document.getElementById('calcStartDate').value;
            const endDate = document.getElementById('calcEndDate').value;
            const pricePerDay = parseFloat(document.getElementById('calcPricePerDay').value);
            
            if (!startDate || !endDate || isNaN(pricePerDay) || pricePerDay <= 0) {
                alert('Vui lòng nhập đầy đủ thông tin (giá phải > 0)!');
                return;
            }
            
            // Validate dates
            const start = new Date(startDate);
            const end = new Date(endDate);
            if (end < start) {
                alert('Ngày kết thúc phải lớn hơn hoặc bằng ngày bắt đầu!');
                return;
            }
            
            try {
                const response = await fetch(`/Admin/HolidayPricing/CalculatePrice?startDate=${startDate}&endDate=${endDate}&pricePerDay=${pricePerDay}`);
                const data = await response.json();
                
                document.getElementById('priceResult').style.display = 'block';
                
                // Summary stats
                document.getElementById('resultTotalDays').textContent = data.totalDays + ' ngày';
                document.getElementById('resultPricePerDay').textContent = formatCurrency(data.pricePerDay);
                document.getElementById('resultAvgMultiplier').textContent = 'x ' + data.avgMultiplier;
                document.getElementById('resultTotalPrice').textContent = formatCurrency(data.totalPrice);
                
                // Count badges
                document.getElementById('countNormal').textContent = data.normalDays;
                document.getElementById('countWeekend').textContent = data.weekendDays;
                document.getElementById('countHoliday').textContent = data.holidayDays;
                
                // Date breakdown
                let html = '';
                data.dateInfos.forEach(d => {
                    const typeClass = d.isHoliday ? 'bg-danger' : d.isWeekend ? 'bg-warning text-dark' : 'bg-light text-dark';
                    const typeName = d.isHoliday ? d.holidayName : d.isWeekend ? 'Cuối tuần' : 'Ngày thường';
                    const priceClass = d.multiplier > 1 ? 'text-danger fw-bold' : 'text-muted';
                    
                    html += `
                        <tr>
                            <td class="ps-3 text-start">${d.date}</td>
                            <td>${d.dayOfWeek}</td>
                            <td><span class="badge ${typeClass}">${typeName}</span></td>
                            <td class="fw-bold ${priceClass}">x ${d.multiplier.toFixed(2)}</td>
                            <td class="text-end pe-3 fw-bold ${priceClass}">${formatCurrency(d.dayPrice)}</td>
                        </tr>
                    `;
                });
                document.getElementById('dateBreakdown').innerHTML = html;
            } catch (err) {
                console.error(err);
                alert('Lỗi khi tính giá!');
            }
        }
        
        // Load holidays for a year
        async function loadYearHolidays(year) {
            const container = document.getElementById('holidayList');
            container.innerHTML = '<div class="col-12 text-center py-4"><div class="spinner-border text-primary"></div></div>';
            
            try {
                const response = await fetch(`/Admin/HolidayPricing/GetYearHolidays?year=${year}`);
                const data = await response.json();
                
                if (data.holidays.length === 0) {
                    container.innerHTML = '<div class="col-12 text-center py-4 text-muted">Không có ngày lễ nào</div>';
                    return;
                }
                
                let html = '';
                data.holidays.forEach(h => {
                    const typeClass = h.type === 'Tết' ? 'bg-primary' : 
                                     h.type === 'Ngày lễ' ? 'bg-danger' : 'bg-warning text-dark';
                    html += `
                        <div class="col-md-6 col-lg-4">
                            <div class="card border-0 shadow-sm h-100">
                                <div class="card-body py-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div>
                                            <div class="fw-bold">${h.date}</div>
                                            <small class="text-muted">${h.dayOfWeek}</small>
                                            <div class="small mt-1">${h.holidayName || '-'}</div>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge ${typeClass} px-2 py-2">${h.type}</span>
                                            <div class="fw-bold text-primary mt-1">x ${h.multiplier.toFixed(2)}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                });
                container.innerHTML = html;
            } catch (err) {
                console.error(err);
                container.innerHTML = '<div class="col-12 text-center py-4 text-danger">Lỗi khi tải ngày lễ</div>';
            }
        }
        
        // Load current year on page load
        document.addEventListener('DOMContentLoaded', function() {
            loadYearHolidays(@ViewBag.CurrentYear);
        });
    </script>
}
