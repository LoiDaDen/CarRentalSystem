@using CarRentalSystem.ViewModels.Cameras
@model CameraIndexViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Camera ANPR";
    var areas = ViewBag.Areas as List<Area> ?? new();
    var locations = ViewBag.Locations as List<Location> ?? new();
    var directions = ViewBag.Directions as string[] ?? new[] { CameraGateDirectionConstants.In, CameraGateDirectionConstants.Out, CameraGateDirectionConstants.Unknown };
    int? currentAreaId = ViewBag.CurrentAreaId as int?;
    int? currentLocationId = ViewBag.CurrentLocationId as int?;
}

<div class="theme-admin">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <h2 class="fw-800 mb-1"><i class="bi bi-camera-video-fill text-primary me-2"></i>Camera ANPR</h2>
            <p class="text-muted mb-0">Quản lý camera đọc biển số theo khu vực/địa điểm, secret webhook và link live NVR.</p>
        </div>
        <a asp-area="Admin" asp-controller="Camera" asp-action="Monitor" class="btn btn-primary rounded-3 fw-bold">
            <i class="bi bi-activity me-1"></i> Gate Monitor
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3">@TempData["Error"]</div>
    }
    @if (TempData["CameraSecret"] != null)
    {
        <div class="alert alert-warning rounded-3">
            <div class="fw-bold mb-1">Webhook secret chỉ hiển thị một lần</div>
            <code class="user-select-all">@TempData["CameraSecret"]</code>
            <div class="small mt-2">Dùng secret này để ký HMAC SHA-256 cho webhook camera. Hệ thống chỉ lưu bản mã hóa, không hiển thị lại secret cũ.</div>
        </div>
    }

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">Khu vực</label>
            <select name="areaId" class="form-select rounded-3 js-area-select" data-location-target="filter-location">
                <option value="">Tất cả khu vực</option>
                @foreach (var area in areas)
                {
                    <option value="@area.AreaID" selected="@(currentAreaId == area.AreaID)">@area.Name - @area.Province</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label small fw-bold text-muted">Địa điểm</label>
            <select id="filter-location" name="locationId" class="form-select rounded-3 js-location-select" data-placeholder="Tất cả địa điểm">
                <option value="">Tất cả địa điểm</option>
                @foreach (var location in locations)
                {
                    <option value="@location.LocationID" selected="@(currentLocationId == location.LocationID)">@location.Name</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold text-muted">Trạng thái</label>
            <select name="status" class="form-select rounded-3">
                <option value="">Tất cả</option>
                <option value="@CameraDeviceStatusConstants.Active" selected="@(ViewBag.CurrentStatus == CameraDeviceStatusConstants.Active)">Active</option>
                <option value="@CameraDeviceStatusConstants.Inactive" selected="@(ViewBag.CurrentStatus == CameraDeviceStatusConstants.Inactive)">Inactive</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-primary rounded-3 fw-bold w-100" type="submit">Lọc</button>
        </div>
    </form>

    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2 text-primary"></i>Thêm camera</h5>
        </div>
        <div class="card-body">
            <form asp-area="Admin" asp-controller="Camera" asp-action="Create" method="post" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Mã camera</label>
                    <input name="Code" class="form-control rounded-3" placeholder="GATE-IN-01" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Tên camera</label>
                    <input name="Name" class="form-control rounded-3" placeholder="Cổng vào depot" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Provider</label>
                    <input name="Provider" class="form-control rounded-3" placeholder="Hikvision/NVR/AI" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Khu vực</label>
                    <select name="AreaID" class="form-select rounded-3 js-area-select" data-location-target="create-location" required>
                        <option value="">Không chọn</option>
                        @foreach (var area in areas)
                        {
                            <option value="@area.AreaID">@area.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted">Địa điểm</label>
                    <select id="create-location" name="LocationID" class="form-select rounded-3 js-location-select" data-placeholder="Chọn khu vực trước" disabled>
                        <option value="">Không chọn</option>
                        @foreach (var location in locations)
                        {
                            <option value="@location.LocationID">@location.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Hướng mặc định</label>
                    <select name="DefaultDirection" class="form-select rounded-3">
                        @foreach (var direction in directions)
                        {
                            <option value="@direction">@direction</option>
                        }
                    </select>
                </div>
                <div class="col-md-8">
                    <label class="form-label small fw-bold text-muted">Live NVR URL</label>
                    <input name="LiveViewUrl" class="form-control rounded-3" placeholder="https://nvr.example.com/live/cam-01" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small fw-bold text-muted">Trạng thái</label>
                    <select name="Status" class="form-select rounded-3">
                        <option value="@CameraDeviceStatusConstants.Active">Active</option>
                        <option value="@CameraDeviceStatusConstants.Inactive">Inactive</option>
                    </select>
                </div>
                <div class="col-12">
                    <button type="submit" class="btn btn-primary rounded-3 fw-bold px-4">
                        <i class="bi bi-check-lg me-1"></i>Tạo camera
                    </button>
                </div>
            </form>
        </div>
    </div>

    <div class="row g-3">
        @if (!Model.Cameras.Any())
        {
            <div class="col-12">
                <div class="alert alert-info rounded-3">Chưa có camera nào trong phạm vi đang chọn.</div>
            </div>
        }
        @foreach (var camera in Model.Cameras)
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body">
                        <form asp-area="Admin" asp-controller="Camera" asp-action="Update" method="post" class="row g-2 align-items-end">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="CameraDeviceID" value="@camera.CameraDeviceID" />
                            <div class="col-md-2">
                                <label class="form-label small fw-bold text-muted">Mã</label>
                                <input name="Code" value="@camera.Code" class="form-control rounded-3 fw-bold" required />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-muted">Tên</label>
                                <input name="Name" value="@camera.Name" class="form-control rounded-3" required />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold text-muted">Provider</label>
                                <input name="Provider" value="@camera.Provider" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold text-muted">Khu vực</label>
                                <select name="AreaID" class="form-select rounded-3 js-area-select" data-location-target="camera-@camera.CameraDeviceID-location" required>
                                    <option value="">Không chọn</option>
                                    @foreach (var area in areas)
                                    {
                                        <option value="@area.AreaID" selected="@(camera.AreaID == area.AreaID)">@area.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label small fw-bold text-muted">Địa điểm</label>
                                <select id="camera-@camera.CameraDeviceID-location" name="LocationID" class="form-select rounded-3 js-location-select" data-placeholder="Chọn khu vực trước">
                                    <option value="">Không chọn</option>
                                    @foreach (var location in locations)
                                    {
                                        <option value="@location.LocationID" selected="@(camera.LocationID == location.LocationID)">@location.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold text-muted">Hướng</label>
                                <select name="DefaultDirection" class="form-select rounded-3">
                                    @foreach (var direction in directions)
                                    {
                                        <option value="@direction" selected="@(camera.DefaultDirection == direction)">@direction</option>
                                    }
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label small fw-bold text-muted">Live NVR URL</label>
                                <input name="LiveViewUrl" value="@camera.LiveViewUrl" class="form-control rounded-3" />
                            </div>
                            <div class="col-md-2">
                                <label class="form-label small fw-bold text-muted">Trạng thái</label>
                                <select name="Status" class="form-select rounded-3">
                                    <option value="@CameraDeviceStatusConstants.Active" selected="@(camera.Status == CameraDeviceStatusConstants.Active)">Active</option>
                                    <option value="@CameraDeviceStatusConstants.Inactive" selected="@(camera.Status == CameraDeviceStatusConstants.Inactive)">Inactive</option>
                                </select>
                            </div>
                            <div class="col-md-2 d-grid">
                                <button type="submit" class="btn btn-outline-primary rounded-3 fw-bold">Lưu</button>
                            </div>
                        </form>
                        <div class="d-flex flex-wrap justify-content-between gap-2 mt-3 pt-3 border-top">
                            <div class="small text-muted">
                                <span class="badge bg-light text-dark border me-1">@camera.AreaName</span>
                                <span class="badge bg-light text-dark border me-1">@camera.LocationName</span>
                                <span class="badge bg-info text-dark">@camera.EventCountToday event hôm nay</span>
                            </div>
                            <div class="d-flex gap-2">
                                @if (!string.IsNullOrWhiteSpace(camera.LiveViewUrl))
                                {
                                    <a href="@camera.LiveViewUrl" target="_blank" rel="noopener" class="btn btn-sm btn-outline-success rounded-3">
                                        <i class="bi bi-box-arrow-up-right me-1"></i>Live NVR
                                    </a>
                                }
                                <form asp-area="Admin" asp-controller="Camera" asp-action="RegenerateSecret" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@camera.CameraDeviceID" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning rounded-3">Regenerate secret</button>
                                </form>
                                <form asp-area="Admin" asp-controller="Camera" asp-action="Delete" method="post" onsubmit="return confirm('Xóa camera này?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@camera.CameraDeviceID" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger rounded-3">Xóa</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const areaLocations = @Json.Serialize(ViewBag.AreaLocations ?? Array.Empty<object>());
            const locationOptions = @Json.Serialize(ViewBag.LocationOptions ?? Array.Empty<object>());

            const normalizedLocations = locationOptions.map(item => ({
                value: String(item.locationID ?? item.locationId ?? item.LocationID),
                text: String(item.name ?? item.Name)
            })).filter(item => item.value && item.value !== 'undefined');

            const locationIdsByArea = areaLocations.reduce((map, item) => {
                const areaId = String(item.areaID ?? item.areaId ?? item.AreaID);
                const locationId = String(item.locationID ?? item.locationId ?? item.LocationID);
                if (!areaId || areaId === 'undefined' || !locationId || locationId === 'undefined') {
                    return map;
                }

                if (!map.has(areaId)) {
                    map.set(areaId, new Set());
                }
                map.get(areaId).add(locationId);
                return map;
            }, new Map());

            function rebuildLocationSelect(areaSelect) {
                const locationSelect = document.getElementById(areaSelect.dataset.locationTarget || '');
                if (!locationSelect) return;

                const areaId = areaSelect.value;
                const previousValue = locationSelect.value;
                const placeholder = locationSelect.dataset.placeholder || 'Không chọn';
                const allowedIds = areaId ? locationIdsByArea.get(areaId) : null;

                locationSelect.innerHTML = '';
                locationSelect.appendChild(new Option(areaId ? 'Không chọn' : placeholder, ''));

                if (!areaId) {
                    locationSelect.disabled = true;
                    locationSelect.value = '';
                    return;
                }

                const filteredLocations = normalizedLocations.filter(location => allowedIds?.has(location.value));
                for (const location of filteredLocations) {
                    locationSelect.appendChild(new Option(location.text, location.value));
                }

                locationSelect.disabled = false;
                locationSelect.value = filteredLocations.some(location => location.value === previousValue)
                    ? previousValue
                    : '';
            }

            for (const areaSelect of document.querySelectorAll('.js-area-select')) {
                rebuildLocationSelect(areaSelect);
                areaSelect.addEventListener('change', () => rebuildLocationSelect(areaSelect));
            }
        })();
    </script>
}
