@model IEnumerable<CarRentalSystem.Models.Promotion>
@{
    ViewData["Title"] = "Thùng rác - Mã Khuyến mãi";
    Layout = "_AdminLayout";
}

<div class="theme-admin">
<style>
    .theme-admin .fw-800 { font-weight: 800; }
    .theme-admin .table-promo td { padding: 1rem 1.25rem; vertical-align: middle; }
</style>

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h2 class="fw-800 mb-1" style="letter-spacing: -1px;">Thùng rác</h2>
        <p class="text-muted mb-0">Các mã khuyến mãi đã xóa. Có thể khôi phục hoặc xóa vĩnh viễn.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Promotions" asp-action="Index" class="btn btn-outline-secondary shadow-sm px-4 py-2 rounded-3 fw-bold">
            <i class="bi bi-arrow-left me-2"></i>Quay lại
        </a>
        @if (Model.Any())
        {
            <form asp-area="Admin" asp-controller="Promotions" asp-action="EmptyTrash" method="post" onsubmit="return confirm('Xóa vĩnh viễn tất cả?')">
                <button type="submit" class="btn btn-danger shadow-sm px-4 py-2 rounded-3 fw-bold">
                    <i class="bi bi-trash3 me-2"></i>Xóa tất cả
                </button>
            </form>
        }
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-promo">
            <thead style="background: #f8fafd;">
                <tr class="text-muted small text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.8px;">
                    <th class="ps-4">Mã Code</th>
                    <th>Mức Giảm</th>
                    <th>Xóa lúc</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-light text-dark border px-3 py-2 fw-bold" style="font-family: monospace; font-size: 0.9rem;">
                                <i class="bi bi-ticket-perforated me-1 text-primary"></i>@p.PromoCode
                            </span>
                        </td>
                        <td class="fw-800 text-danger">
                            -@p.DiscountPercent.ToString("0.##")%
                        </td>
                        <td class="small text-muted">
                            @(p.DeletedAt?.ToString("dd/MM/yyyy HH:mm") ?? "-")
                        </td>
                        <td class="text-end pe-4">
                            <form asp-action="Restore" asp-route-id="@p.PromotionID" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-success rounded-3 shadow-sm px-2 me-1" title="Khôi phục">
                                    <i class="bi bi-arrow-counterclockwise"></i>
                                </button>
                            </form>
                            <button type="button" class="btn btn-sm btn-danger rounded-3 shadow-sm px-2" data-bs-toggle="modal" data-bs-target="#permanentDeleteModal-@p.PromotionID">
                                <i class="bi bi-trash3-fill"></i>
                            </button>

                            <!-- Permanent Delete Modal -->
                            <div class="modal fade text-start" id="permanentDeleteModal-@p.PromotionID" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered modal-sm">
                                    <div class="modal-content border-0 shadow-lg rounded-4 text-center p-4">
                                        <div class="mb-3">
                                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10" style="width:60px;height:60px;">
                                                <i class="bi bi-exclamation-triangle-fill text-danger fs-3"></i>
                                            </span>
                                        </div>
                                        <h6 class="fw-800 mb-2">Xóa vĩnh viễn @p.PromoCode?</h6>
                                        <p class="text-muted small mb-4">Hành động này <strong>không thể hoàn tác</strong>.</p>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-light flex-grow-1 rounded-3 fw-bold" data-bs-dismiss="modal">Hủy</button>
                                            <form asp-action="PermanentDelete" asp-route-id="@p.PromotionID" method="post" class="flex-grow-1">
                                                <button type="submit" class="btn btn-danger w-100 rounded-3 fw-bold">Xóa vĩnh viễn</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center py-5 text-muted">
                            <i class="bi bi-trash3 display-4 opacity-10 d-block mb-3"></i>
                            <p class="fw-bold opacity-50 mb-0">Thùng rác trống</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
