@model CarRentalSystem.Models.CarType
@{
    ViewData["Title"] = "Chỉnh sửa Loại Xe";
    Layout = "_AdminLayout";
}

<div class="theme-admin">
<style>
    .theme-admin .form-control { border-radius: 12px; border: 1.5px solid var(--admin-border-color); padding: 0.75rem 1rem; font-weight: 500; transition: border-color 0.2s, box-shadow 0.2s; background: var(--admin-surface-100); color: var(--admin-text); }
    .theme-admin .form-control:focus { border-color: var(--admin-primary); box-shadow: 0 0 0 3px rgba(59,130,246,0.12); }
    .theme-admin .form-label { font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.6px; color: var(--admin-text-secondary); margin-bottom: 0.5rem; }
    .theme-admin .section-card { background: var(--admin-card-bg); border-radius: 20px; padding: 1.75rem; border: 1px solid var(--admin-border-color); box-shadow: var(--admin-shadow); margin-bottom: 1.5rem; max-width: 600px; margin: 0 auto; }
</style>

<div class="d-flex justify-content-between align-items-center mb-5" style="max-width: 600px; margin: 0 auto;">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">Chỉnh sửa Loại Xe</h2>
        <p class="text-muted mb-0">Cập nhật phân khúc @Model.Name.</p>
    </div>
    <a asp-action="Index" asp-route-tab="cartypes" class="btn btn-light rounded-3 px-4 py-2 fw-bold border">
        <i class="bi bi-arrow-left me-2"></i>Quay lại
    </a>
</div>

<div class="section-card">
    <form asp-action="EditCarType" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <input type="hidden" asp-for="CarTypeID" />
        
        <div class="mb-3">
            <label class="form-label">Tên Loại Xe <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        
        <div class="mb-4">
            <label class="form-label">Mô tả</label>
            <input asp-for="Description" class="form-control" />
            <span asp-validation-for="Description" class="text-danger small"></span>
        </div>
        
        <button type="submit" class="btn btn-primary w-100 rounded-3 py-3 fw-bold shadow-sm">
            <i class="bi bi-check-lg me-2"></i>Lưu thay đổi
        </button>
    </form>
</div>
</div>
</div>
