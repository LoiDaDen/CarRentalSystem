@model IEnumerable<CarRentalSystem.Models.SettlementReview>
@{
    ViewData["Title"] = "Settlement Reviews";
}

<h2>Settlement Reviews</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Booking</th>
            <th>Type</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Reason</th>
            <th>Created</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.SettlementReviewID</td>
            <td>@item.BookingID</td>
            <td>@item.ReviewType</td>
            <td>@item.Amount.ToString("N0") @item.Currency</td>
            <td>@item.Status</td>
            <td>@item.Reason</td>
            <td>@item.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
            <td>
                @if (item.Status == CarRentalSystem.Models.SettlementReviewStatusConstants.PendingReview)
                {
                    <form asp-action="Approve" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.SettlementReviewID" />
                        <input type="hidden" name="reason" value="Approved from admin settlement review." />
                        <button type="submit" class="btn btn-sm btn-success">Approve</button>
                    </form>
                    <form asp-action="Reject" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.SettlementReviewID" />
                        <input type="hidden" name="reason" value="Rejected from admin settlement review." />
                        <button type="submit" class="btn btn-sm btn-outline-danger">Reject</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
