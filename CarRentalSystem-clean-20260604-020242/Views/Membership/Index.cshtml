@model List<CarRentalSystem.Models.MembershipTier>
@{
    ViewData["Title"] = "Hạng Thành Viên";
    var currentUser = ViewBag.CurrentUser as CarRentalSystem.Models.User;
    var currentTier = ViewBag.CurrentTier as CarRentalSystem.Models.MembershipTier;
    var contractTypes = ViewBag.ContractTypes as List<CarRentalSystem.Models.ContractType>;
}

<style>
    .tier-card {
        border-radius: 20px;
        overflow: hidden;
        transition: transform .3s ease, box-shadow .3s ease;
        border: 2px solid #e9ecef;
    }
    .tier-card:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0,0,0,.15) !important;
    }
    .tier-card.active-tier {
        border-color: #10b981 !important;
        box-shadow: 0 0 0 4px rgba(16,185,129,.2);
        transform: scale(1.03);
    }
    .tier-header {
        padding: 2rem 1.5rem;
        text-align: center;
        position: relative;
        color: white;
        min-height: 170px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }
    .tier-icon {
        width: 70px; height: 70px;
        border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        margin: 0 auto .8rem;
        font-size: 1.8rem;
        background: rgba(255,255,255,.25);
        border: 2px solid rgba(255,255,255,.4);
    }
    .tier-name {
        font-size: 1.3rem;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        text-shadow: 0 2px 4px rgba(0,0,0,.25);
        margin-bottom: .3rem;
    }
    .tier-spending {
        opacity: .85;
        font-size: .85rem;
    }
    .tier-benefits {
        padding: 1.2rem 1.5rem;
    }
    .tier-benefits li {
        padding: .6rem 0;
        border-bottom: 1px solid #f0f0f0;
        display: flex;
        align-items: center;
        font-size: 0.92rem;
    }
    .tier-benefits li:last-child { border-bottom: none; }
    .benefit-value {
        font-weight: 700;
        font-size: 1rem;
    }
    .progress-section {
        background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
        border-radius: 20px;
        padding: 2rem;
        color: white;
    }
    .contract-card {
        border-radius: 16px;
        transition: transform .2s;
        border: 1px solid #e9ecef;
    }
    .contract-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }
</style>

<div class="container py-5">
    <!-- Hero -->
    <div class="text-center mb-5">
        <h2 class="fw-800 mb-3"><i class="bi bi-gem text-info me-2"></i>Chương trình Khách hàng Thân Thiết</h2>
        <p class="text-muted lead">Thuê xe nhiều hơn, tiết kiệm nhiều hơn. Tích lũy chi tiêu để nâng hạng và nhận ưu đãi đặc biệt!</p>
    </div>

    <!-- Current User Progress -->
    @if (currentUser != null)
    {
        <div class="progress-section mb-5 shadow">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center mb-3">
                        <div class="tier-icon" style="background: @(currentTier?.Color ?? "#cd7f32")30;">
                            <i class="bi @(currentTier?.Icon ?? "bi-award")" style="color: @(currentTier?.Color ?? "#cd7f32");"></i>
                        </div>
                        <div class="ms-3">
                            <small class="text-white-50 d-block">Hạng hiện tại</small>
                            <h4 class="fw-bold mb-0" style="color: @(currentTier?.Color ?? "#cd7f32");">@(currentTier?.Name ?? "Bronze")</h4>
                        </div>
                    </div>
                    <p class="text-white-50 small mb-0">Giảm <strong class="text-success">@(currentTier?.DiscountPercent ?? 0)%</strong> cho mọi chuyến thuê • Free ship <strong>@(currentTier?.FreeDeliveryKm ?? 0)km</strong></p>
                </div>
                <div class="col-md-6">
                    <small class="text-white-50 d-block mb-2">Tổng chi tiêu tích lũy</small>
                    <h3 class="fw-bold text-success mb-3">@(currentUser.TotalSpending.ToString("N0")) đ</h3>
                    @{
                        var nextTier = Model.OrderBy(t => t.MinSpending).FirstOrDefault(t => t.MinSpending > currentUser.TotalSpending);
                    }
                    @if (nextTier != null)
                    {
                        var progress = currentUser.TotalSpending > 0 ? (double)(currentUser.TotalSpending / nextTier.MinSpending * 100) : 0;
                        <div class="progress mb-2" style="height: 10px; border-radius: 5px; background: rgba(255,255,255,.1);">
                            <div class="progress-bar bg-success" style="width: @Math.Min(progress, 100)%; border-radius: 5px;"></div>
                        </div>
                        <small class="text-white-50">Còn <strong class="text-warning">@((nextTier.MinSpending - currentUser.TotalSpending).ToString("N0")) đ</strong> để lên hạng <strong style="color: @nextTier.Color;">@nextTier.Name</strong></small>
                    }
                    else
                    {
                        <small class="text-white-50"><i class="bi bi-trophy-fill text-warning me-1"></i>Bạn đã đạt hạng cao nhất! 🎉</small>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Tier Cards -->
    <div class="row g-4 mb-5">
        @{
            var tierGradients = new Dictionary<string, string> {
                {"Bronze",   "linear-gradient(135deg, #cd7f32, #8B5E3C)"},
                {"Silver",   "linear-gradient(135deg, #9CA3AF, #6B7280)"},
                {"Gold",     "linear-gradient(135deg, #F59E0B, #D97706)"},
                {"Platinum", "linear-gradient(135deg, #475569, #1E293B)"},
                {"Diamond",  "linear-gradient(135deg, #38BDF8, #0284C7)"},
            };
            var tierBorderColors = new Dictionary<string, string> {
                {"Bronze",   "#cd7f32"},
                {"Silver",   "#9CA3AF"},
                {"Gold",     "#F59E0B"},
                {"Platinum", "#475569"},
                {"Diamond",  "#38BDF8"},
            };
        }
        @foreach (var tier in Model)
        {
            var isCurrentTier = currentTier?.MembershipTierID == tier.MembershipTierID;
            var gradient = tierGradients.ContainsKey(tier.Name) ? tierGradients[tier.Name] : $"linear-gradient(135deg, {tier.Color ?? "#888"}, {tier.Color ?? "#666"})";
            var borderCol = tierBorderColors.ContainsKey(tier.Name) ? tierBorderColors[tier.Name] : (tier.Color ?? "#e9ecef");
            <div class="col-md-6 col-xl">
                <div class="tier-card bg-white shadow-sm h-100 @(isCurrentTier ? "active-tier" : "")" style="border-color: @(isCurrentTier ? "#10b981" : borderCol);">
                    <div class="tier-header" style="background: @gradient;">
                        @if (isCurrentTier)
                        {
                            <span class="badge position-absolute top-0 end-0 m-3 rounded-pill px-3 py-2 fw-bold shadow" style="background: rgba(255,255,255,.95); color: #10b981; border: 2px solid #10b981;">
                                <i class="bi bi-check-circle-fill me-1"></i>Hạng của bạn
                            </span>
                        }
                        <div class="tier-icon">
                            <i class="bi @tier.Icon text-white"></i>
                        </div>
                        <div class="tier-name text-white">@tier.Name</div>
                        <div class="tier-spending text-white">Từ @tier.MinSpending.ToString("N0") đ</div>
                    </div>
                    <ul class="tier-benefits list-unstyled mb-0">
                        <li>
                            <i class="bi bi-tag-fill text-success me-2 fs-6"></i>
                            <div class="flex-grow-1">Giảm giá</div>
                            <span class="benefit-value text-success">@tier.DiscountPercent.ToString("0.##")%</span>
                        </li>
                        <li>
                            <i class="bi bi-truck text-primary me-2 fs-6"></i>
                            <div class="flex-grow-1">Free ship</div>
                            <span class="benefit-value text-dark">@tier.FreeDeliveryKm km</span>
                        </li>
                        <li>
                            <i class="bi bi-clock text-info me-2 fs-6"></i>
                            <div class="flex-grow-1">Giờ miễn phí</div>
                            <span class="benefit-value text-dark">@tier.ExtraFreeHours h</span>
                        </li>
                        <li>
                            <i class="bi bi-headset text-warning me-2 fs-6"></i>
                            <div class="flex-grow-1">Hỗ trợ ưu tiên</div>
                            @if (tier.PrioritySupport)
                            {
                                <span class="badge bg-success rounded-pill px-2 py-1"><i class="bi bi-check-lg"></i></span>
                            }
                            else
                            {
                                <span class="text-muted fw-bold">—</span>
                            }
                        </li>
                    </ul>
                </div>
            </div>
        }
    </div>

    <!-- Contract Types -->
    @if (contractTypes != null && contractTypes.Any())
    {
        <div class="text-center mb-4">
            <h3 class="fw-800"><i class="bi bi-file-earmark-text me-2 text-primary"></i>Loại hợp đồng thuê xe</h3>
            <p class="text-muted">Chọn gói hợp đồng phù hợp với nhu cầu, thuê càng dài giá càng tốt</p>
        </div>
        <div class="row g-4">
            @foreach (var ct in contractTypes)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="contract-card bg-white shadow-sm p-4 h-100">
                        <div class="d-flex align-items-center mb-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                                <i class="bi bi-file-text text-primary"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold mb-0">@ct.Name</h6>
                                <span class="badge bg-success bg-opacity-10 text-success small">Giảm @ct.DiscountPercent%</span>
                            </div>
                        </div>
                        <p class="text-muted small mb-3">@ct.Description</p>
                        <div class="small">
                            <div class="d-flex justify-content-between mb-1">
                                <span class="text-muted">Thời hạn:</span>
                                <span class="fw-bold">@ct.MinDurationDays - @ct.MaxDurationDays ngày</span>
                            </div>
                            @if (ct.FreeMaintenanceCount > 0)
                            {
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted">Bảo trì miễn phí:</span>
                                    <span class="fw-bold text-primary">@ct.FreeMaintenanceCount lần</span>
                                </div>
                            }
                            @if (ct.FreeInsurance)
                            {
                                <div class="d-flex align-items-center text-success mt-2">
                                    <i class="bi bi-shield-check me-1"></i> Bảo hiểm miễn phí
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(ct.AfterSalesDescription))
                            {
                                <div class="alert alert-success py-2 px-3 mt-2 small mb-0" style="border-radius: 10px;">
                                    <i class="bi bi-gift me-1"></i> @ct.AfterSalesDescription
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>