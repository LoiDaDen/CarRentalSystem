@model CarRentalSystem.ViewModels.BlogDetailViewModel
@{
    var blog = Model.Blog;
    var cover = string.IsNullOrWhiteSpace(blog.CoverImageUrl)
        ? "https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?q=80&w=1400&auto=format&fit=crop"
        : blog.CoverImageUrl;
}

@section Styles {
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
}

<article class="blog-page">
    <header class="blog-detail-hero">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    @if (blog.Category != null)
                    {
                        <a class="blog-category-badge mb-3" asp-controller="Blog" asp-action="Index" asp-route-category="@blog.Category.Slug">@blog.Category.Name</a>
                    }
                    <h1 class="display-5 fw-800 mb-3">@blog.Title</h1>
                    <p class="lead text-muted mb-3">@blog.Summary</p>
                    <div class="blog-meta">
                        <span><i class="bi bi-person me-1"></i>@blog.AuthorName</span>
                        <span><i class="bi bi-calendar3 me-1"></i>@blog.PublishedDate.ToString("dd/MM/yyyy")</span>
                        <span><i class="bi bi-clock me-1"></i>@blog.ReadingTime phút đọc</span>
                        <span><i class="bi bi-eye me-1"></i>@blog.ViewCount lượt xem</span>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div class="container mt-4">
        <img src="@cover" alt="@(blog.CoverImageAlt ?? blog.Title)" class="blog-cover mb-4" />

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="blog-panel">
                    <nav class="blog-toc mb-4" id="blogToc" aria-label="Mục lục"></nav>
                    <div class="blog-article" id="blogArticle">
                        @Html.Raw(blog.Content)
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                        @foreach (var mapping in blog.BlogTagMappings)
                        {
                            if (mapping.BlogTag != null)
                            {
                                <a class="blog-chip" asp-controller="Blog" asp-action="Index" asp-route-tag="@mapping.BlogTag.Slug">#@mapping.BlogTag.Name</a>
                            }
                        }
                    </div>

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <a class="btn btn-outline-primary rounded-3 fw-bold" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u=@Uri.EscapeDataString(Context.Request.Scheme + "://" + Context.Request.Host + Context.Request.Path)">
                            <i class="bi bi-facebook me-1"></i>Chia sẻ
                        </a>
                        <button type="button" class="btn btn-outline-secondary rounded-3 fw-bold" id="copyBlogLink">
                            <i class="bi bi-link-45deg me-1"></i>Sao chép link
                        </button>
                    </div>
                </div>

                <section class="blog-cta mt-4">
                    <h3 class="h4 fw-bold">Bạn đang cần thuê xe tự lái cho chuyến đi sắp tới?</h3>
                    <p class="mb-3 opacity-75">Hãy xem ngay danh sách xe đang có và đặt xe chỉ trong vài phút.</p>
                    <a asp-controller="Car" asp-action="Index" class="btn btn-light rounded-3 fw-bold px-4">Xem xe ngay</a>
                </section>

                @await Html.PartialAsync("_RelatedBlogs", Model.RelatedBlogs)
            </div>
            <div class="col-lg-4">
                @await Html.PartialAsync("_BlogSidebar", new CarRentalSystem.ViewModels.BlogListViewModel
                {
                    Categories = Model.Categories,
                    PopularTags = Model.PopularTags,
                    LatestBlogs = Model.LatestBlogs
                })
            </div>
        </div>
    </div>
</article>

@section Scripts {
    <script>
        const article = document.getElementById('blogArticle');
        const toc = document.getElementById('blogToc');
        const headings = article ? article.querySelectorAll('h2') : [];
        if (toc && headings.length) {
            const title = document.createElement('div');
            title.className = 'blog-panel-title';
            title.textContent = 'Mục lục';
            toc.appendChild(title);
            headings.forEach((heading, index) => {
                const id = `section-${index + 1}`;
                heading.id = id;
                const link = document.createElement('a');
                link.href = `#${id}`;
                link.textContent = heading.textContent;
                toc.appendChild(link);
            });
        } else if (toc) {
            toc.remove();
        }

        document.getElementById('copyBlogLink')?.addEventListener('click', async (event) => {
            await navigator.clipboard?.writeText(window.location.href);
            event.currentTarget.innerHTML = '<i class="bi bi-check2 me-1"></i>Đã sao chép';
        });
    </script>
}
