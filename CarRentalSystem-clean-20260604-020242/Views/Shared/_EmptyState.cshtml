@model CarRentalSystem.ViewModels.EmptyStateViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<CarRentalSystem.SharedResource> L
@{
    var messageMargin = string.IsNullOrWhiteSpace(Model.ActionText) ? "mb-0" : "mb-3";
    var title = string.IsNullOrWhiteSpace(Model.Title) ? L["NoDataTitle"] : Model.Title;
    var message = string.IsNullOrWhiteSpace(Model.Message) ? L["NoDataMessage"] : Model.Message;
}

<div class="text-center py-5 px-3 border rounded-3 bg-light bg-opacity-50">
    <i class="bi @Model.Icon display-5 text-muted opacity-50 d-block mb-3"></i>
    <h5 class="fw-bold mb-2">@title</h5>
    <p class="text-muted @messageMargin">@message</p>
    @if (!string.IsNullOrWhiteSpace(Model.ActionText) &&
        !string.IsNullOrWhiteSpace(Model.ActionController) &&
        !string.IsNullOrWhiteSpace(Model.ActionName))
    {
        <a asp-area="@Model.ActionArea"
           asp-controller="@Model.ActionController"
           asp-action="@Model.ActionName"
           class="btn btn-primary rounded-pill px-4">
            @Model.ActionText
        </a>
    }
</div>
