@{
    ViewData["Title"] = "Truy cập bị từ chối";
}

<div class="container py-5 text-center" style="max-width: 600px;">
    <div class="mb-4">
        <div class="rounded-circle bg-danger bg-opacity-10 d-inline-flex align-items-center justify-content-center" style="width: 100px; height: 100px;">
            <i class="bi bi-shield-lock-fill text-danger" style="font-size: 2.5rem;"></i>
        </div>
    </div>
    <h3 class="fw-bold mb-3">Truy cập bị từ chối</h3>
    <p class="text-muted mb-4">Bạn không có quyền truy cập trang này. Vui lòng đăng nhập bằng tài khoản phù hợp hoặc liên hệ quản trị viên.</p>
    <div class="d-flex gap-3 justify-content-center">
        <a href="/" class="btn btn-primary rounded-pill px-4">
            <i class="bi bi-house me-1"></i>Trang chủ
        </a>
        <a asp-controller="Auth" asp-action="Login" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="bi bi-box-arrow-in-right me-1"></i>Đăng nhập
        </a>
    </div>
</div>
