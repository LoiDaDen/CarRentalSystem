@model CarRentalSystem.ViewModels.ForgotPasswordViewModel
@{
    ViewData["Title"] = "Quên mật khẩu";
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-5 col-lg-4">
        <div class="text-center mb-4">
            <h1 class="h3 fw-bold text-primary mb-2">Quên mật khẩu?</h1>
            <p class="text-muted mb-0">Nhập email tài khoản để nhận mã OTP đặt lại mật khẩu.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4">
                <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.Error
            </div>
        }

        <div class="card border-0 shadow-lg p-4 p-md-5 rounded-4">
            <form asp-action="ForgotPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="form-label small fw-bold text-muted text-uppercase ls-1">Email</label>
                    <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input asp-for="Email" class="form-control bg-transparent border-0 py-3" autocomplete="email" placeholder="email@example.com" autofocus />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold">
                    <i class="bi bi-send me-2"></i>Gửi mã OTP
                </button>
            </form>

            <div class="text-center mt-4 small">
                <a asp-action="Login" class="text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Quay lại đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
