@model IEnumerable<CarRentalSystem.Models.Car>
@{
    ViewData["Title"] = "Bản Đồ Định Vị Xe";
    Layout = "_AdminLayout";
}

<style>
    :root {
        --glass-bg: rgba(15, 23, 42, 0.8);
        --accent-blue: #3b82f6;
    }
    
    .tracking-container {
        position: relative;
        height: calc(100vh - 120px);
        border-radius: 24px;
        overflow: hidden;
        background: #000;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    }
    
    #map {
        height: 100%;
        width: 100%;
    }
    
    .overlay-panel {
        position: absolute;
        top: 24px;
        left: 24px;
        width: 350px;
        z-index: 1000;
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        color: #fff;
        padding: 24px;
    }

    .log-panel {
        position: absolute;
        bottom: 24px;
        right: 24px;
        width: 400px;
        max-height: 250px;
        z-index: 1000;
        background: var(--glass-bg);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 20px;
        color: #fff;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }

    .car-marker-icon {
        background: var(--accent-blue);
        border: 3px solid #fff;
        border-radius: 50%;
        box-shadow: 0 0 15px 5px rgba(59, 130, 246, 0.6);
        animation: pulseMarker 2s infinite;
    }

    @@keyframes pulseMarker {
        0% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0.7); }
        70% { box-shadow: 0 0 0 15px rgba(59, 130, 246, 0); }
        100% { box-shadow: 0 0 0 0 rgba(59, 130, 246, 0); }
    }

    .status-badge {
        font-size: 0.65rem;
        padding: 4px 8px;
        border-radius: 6px;
        text-transform: uppercase;
        font-weight: 700;
    }
</style>

<div class="tracking-container">
    <div id="map"></div>
    
    <!-- Sidebar Overlay -->
    <div class="overlay-panel animate__animated animate__fadeInLeft">
        <h4 class="fw-800 mb-4 d-flex align-items-center">
            <i class="bi bi-radar me-2 text-primary"></i> Live Radar
        </h4>
        
        <div class="mb-4">
            <label class="form-label small fw-bold text-white-50">LỰA CHỌN PHƯƠNG TIỆN</label>
            <div class="input-group border border-primary border-opacity-25 rounded-3">
                <select id="carIdSelect" class="form-select bg-dark text-white border-0 shadow-none" style="border-radius: 12px 0 0 12px;">
                    <option value="" class="bg-dark text-white-50">-- Chọn xe để theo dõi --</option>
                    @if (Model != null)
                    {
                        foreach (var car in Model)
                        {
                            <option value="@car.CarID" class="bg-dark text-white">@car.CarBrand?.Name @car.CarName (@car.LicensePlate)</option>
                        }
                    }
                </select>
                <button id="trackBtn" class="btn btn-primary px-3 border-0" style="border-radius: 0 12px 12px 0;">
                    <i class="bi bi-radar"></i>
                </button>
            </div>
        </div>

        <div id="carInfo" class="d-none">
            <div class="p-3 rounded-4 bg-white bg-opacity-5 mb-3 border border-white border-opacity-10">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="small text-white-50 fw-bold">Thông tin phương tiện</span>
                    <span class="status-badge bg-success">Đang kết nối</span>
                </div>
                <h5 id="displayCarName" class="fw-bold mb-0 text-primary">Xe #<span id="displayCarId">-</span></h5>
                <div class="row g-2 mt-2">
                    <div class="col-4">
                        <small class="text-white-50 d-block">Tốc độ</small>
                        <span id="displaySpeed" class="fw-800 fs-5">-</span> <small>km/h</small>
                    </div>
                    <div class="col-4">
                        <small class="text-white-50 d-block">Thời gian</small>
                        <span id="displayTime" class="small">-</span>
                    </div>
                    <div class="col-4 text-end">
                        <small class="text-white-50 d-block mb-1">Bám theo xe</small>
                        <div class="form-check form-switch d-inline-block">
                            <input class="form-check-input" type="checkbox" id="autoPanToggle" checked style="cursor: pointer;">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Log Panel -->
    <div class="log-panel shadow-lg">
        <div class="w-100">
            <div class="p-3 border-bottom border-white border-opacity-10 d-flex justify-content-between align-items-center">
                <span class="small fw-bold">NHẬT KÝ HÀNH TRÌNH</span>
                <i class="bi bi-list-task text-primary"></i>
            </div>
            <div id="statusLog" class="p-3 overflow-auto" style="height: 180px;">
                <div class="small text-white-50 text-center py-4">Chưa có dữ liệu theo dõi...</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        var map, marker, pathLine;
        var carId = 0;
        var pathCoords = [];
        var isAutoPan = true;
        var lastDbTimestamp = null; // To prevent duplicate updates when disconnected

        function initMap() {
            map = L.map('map', { zoomControl: false }).setView([21.0285, 105.8542], 13);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap &copy; CARTO',
                subdomains: 'abcd',
                maxZoom: 20
            }).addTo(map);
            L.control.zoom({ position: 'topright' }).addTo(map);

            // Initialize polyline for path tracing
            pathLine = L.polyline([], {
                color: '#3b82f6', 
                weight: 4, 
                opacity: 0.8, 
                dashArray: '10, 10', 
                lineJoin: 'round'
            }).addTo(map);
        }

        $('#autoPanToggle').change(function() {
            isAutoPan = $(this).is(':checked');
            if(isAutoPan && pathCoords.length > 0) {
                map.flyTo(pathCoords[pathCoords.length-1], 16, { animate: true, duration: 1 });
            }
        });

        $('#carIdSelect').change(function() {
            var selectedVal = $(this).val();
            if (selectedVal != carId && selectedVal) {
                if (marker) {
                    map.removeLayer(marker);
                    marker = null;
                }
                pathCoords = [];
                pathLine.setLatLngs([]);
                $('#statusLog').empty();
                $('#carInfo').addClass('d-none');
            }
        });

        function updateLocation() {
            carId = $('#carIdSelect').val();
            if (!carId) return;

            $.get('/Tracking/GetCarLocation?carId=' + carId, function(data) {
                if (data) {
                    // Prevent duplicate logs if the car hasn't updated its location (disconnected)
                    if (data.timestamp === lastDbTimestamp) {
                        return;
                    }
                    lastDbTimestamp = data.timestamp;

                    var pos = [data.latitude, data.longitude];
                    
                    // Add new pos to path and update line
                    pathCoords.push(pos);
                    pathLine.setLatLngs(pathCoords);

                    $('#carInfo').removeClass('d-none');
                    $('#displayCarId').text(carId);
                    $('#displaySpeed').text(data.speed.toFixed(1));
                    $('#displayTime').text(new Date(data.timestamp).toLocaleTimeString()); // Now using actual timestamp from IoT

                    if (!marker) {
                        var pulseIcon = L.divIcon({
                            className: 'car-marker-icon',
                            iconSize: [20, 20],
                            iconAnchor: [10, 10],
                            popupAnchor: [0, -10]
                        });
                        marker = L.marker(pos, {icon: pulseIcon}).addTo(map)
                            .bindPopup('<b class="text-dark">Xe #' + carId + ' (' + data.speed.toFixed(1) + ' km/h)</b>').openPopup();
                        
                        // First load, fly to car closely
                        map.flyTo(pos, 16, { animate: true, duration: 1.5 });
                    } else {
                        marker.setLatLng(pos);
                        marker.getPopup().setContent('<b class="text-dark">Xe #' + carId + ' (' + data.speed.toFixed(1) + ' km/h)</b>');
                        
                        if (isAutoPan) {
                            map.panTo(pos, { animate: true });
                        }
                    }
                    
                    var logContent = '<div class="mb-3 animate__animated animate__fadeInUp">' +
                        '<div class="d-flex justify-content-between mb-1">' +
                        '<span class="text-primary fw-bold" style="font-size: 0.7rem;">' + new Date(data.timestamp).toLocaleTimeString() + '</span>' +
                        '<span class="small text-white-50">' + data.speed.toFixed(1) + ' km/h</span>' +
                        '</div>' +
                        '<div class="small ps-2 border-start border-primary border-opacity-50">Vị trí: ' + data.latitude.toFixed(4) + ', ' + data.longitude.toFixed(4) + '</div>' +
                        '</div>';
                        
                    if ($('#statusLog .text-center').length) $('#statusLog').empty();
                    $('#statusLog').prepend(logContent);
                }
            });
        }

        $(document).ready(function() {
            initMap();
            $('#trackBtn').click(function() {
                $('#carIdSelect').trigger('change');
                updateLocation();
            });
            setInterval(function() {
                if (carId && $('#carIdSelect').val()) updateLocation();
            }, 5000);
        });
    </script>
}
