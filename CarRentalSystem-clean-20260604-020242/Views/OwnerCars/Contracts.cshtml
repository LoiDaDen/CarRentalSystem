@model CarRentalSystem.ViewModels.OwnerContractsViewModel
@using CarRentalSystem.Models
@{
    ViewData["Title"] = "Hợp đồng & Chữ ký số";
    var profile = Model.SignatureProfile;
}

<div class="owner-portal">
    @await Html.PartialAsync("_OwnerPortalHeader", Model.Chrome)

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger rounded-3">@TempData["Error"]</div>
    }

    <section class="owner-panel">
        <div class="owner-section-head">
            <div>
                <h2>Chọn cách ký hợp đồng</h2>
                <p class="owner-muted">Mỗi xe có thể dùng hợp đồng số do app quản lý hoặc hợp đồng giấy do bạn tự chuẩn bị và tự lưu.</p>
            </div>
            <span class="owner-badge @(profile?.IsReady == true ? "ok" : "warn")">
                @(profile?.IsReady == true ? "Chữ ký số sẵn sàng" : "Chưa có hồ sơ chữ ký số")
            </span>
        </div>

        <div class="contract-compare">
            <article>
                <h3><i class="bi bi-file-earmark-check"></i> Hợp đồng số</h3>
                <p>App tạo hợp đồng sau thanh toán, khách ký trong app, hệ thống lưu hash nội dung, hash chữ ký, IP, UserAgent và audit log.</p>
                <ul>
                    <li>Phù hợp khi muốn quản lý tập trung và xuất bằng chứng tranh chấp.</li>
                    <li>Cần hồ sơ chữ ký số của chủ xe trước khi bật cho xe.</li>
                    <li>MVP lưu hồ sơ/chữ ký mẫu; chưa tích hợp API ký số CA thật.</li>
                </ul>
            </article>
            <article>
                <h3><i class="bi bi-file-earmark-text"></i> Hợp đồng giấy tự quản</h3>
                <p>Bạn tự in, ký và lưu hợp đồng vật lý ngoài hệ thống. App chỉ nhắc bước ký giấy trong flow nhận xe.</p>
                <ul>
                    <li>Không cần setup chữ ký số.</li>
                    <li>Không upload file hợp đồng giấy lên app.</li>
                    <li>Bằng chứng tranh chấp phụ thuộc hồ sơ bạn tự lưu.</li>
                </ul>
            </article>
        </div>
        <div class="contract-comparison-table">
            <table class="owner-table">
                <thead>
                    <tr>
                        <th>Tiêu chí</th>
                        <th>Hợp đồng số</th>
                        <th>Hợp đồng giấy tự quản</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Quản lý trên app</td>
                        <td>Có danh sách hợp đồng, trạng thái ký, hash nội dung, audit log và dữ liệu export tranh chấp.</td>
                        <td>Không lưu file trên app; chủ xe tự cất bản giấy và tự cung cấp khi cần.</td>
                    </tr>
                    <tr>
                        <td>Trải nghiệm khách thuê</td>
                        <td>Khách ký trực tiếp sau thanh toán, trước bước lập biên bản nhận xe.</td>
                        <td>Khách ký giấy trực tiếp với chủ xe khi nhận xe hoặc theo thỏa thuận riêng.</td>
                    </tr>
                    <tr>
                        <td>Bằng chứng hệ thống</td>
                        <td>Lưu hash chữ ký, IP, UserAgent, thời điểm ký và snapshot định danh.</td>
                        <td>App chỉ ghi nhận mode vật lý; bằng chứng nằm ngoài hệ thống.</td>
                    </tr>
                    <tr>
                        <td>Chuẩn bị của chủ xe</td>
                        <td>Cần hoàn tất hồ sơ chữ ký số/chữ ký mẫu trước khi bật cho xe.</td>
                        <td>Không cần hồ sơ chữ ký số; cần tự chuẩn bị mẫu hợp đồng và nơi lưu giữ.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    <section class="owner-panel">
        <h2>Hồ sơ chữ ký số của chủ xe</h2>
        <p class="owner-muted">
            Bạn có thể tham khảo danh sách CA công cộng tại
            <a href="https://rootca.gov.vn/" target="_blank" rel="noopener">RootCA</a>
            và hướng dẫn đăng ký trực tuyến của
            <a href="https://neac.gov.vn/vi/tin-tuc-su-kien/detail/huong-dan-dang-ky-su-dung-dich-vu-chung-thuc-chu-ky-so-cong-cong-truc-tuyen-230.htm" target="_blank" rel="noopener">NEAC</a>.
            Sau khi đăng ký, nhập thông tin chứng thư và tải ảnh chữ ký mẫu vào đây.
        </p>

        <div class="signature-guide">
            <h3>Chủ xe cần làm gì để bật hợp đồng số?</h3>
            <ol>
                <li>Chọn một nhà cung cấp chứng thực chữ ký số công cộng từ danh sách RootCA hoặc theo hướng dẫn NEAC.</li>
                <li>Đăng ký chứng thư số bằng thông tin cá nhân/doanh nghiệp chính chủ, hoàn tất eKYC/hồ sơ theo yêu cầu của nhà cung cấp CA.</li>
                <li>Sau khi được cấp chứng thư, lấy tên nhà cung cấp, số serial, chủ thể chứng thư và ngày hết hạn từ hồ sơ chứng thư.</li>
                <li>Tải ảnh chữ ký mẫu của chủ xe lên app. App chỉ lưu metadata và ảnh chữ ký mẫu, không lưu private key hoặc file chứng thư nhạy cảm.</li>
                <li>Khi hồ sơ ở trạng thái sẵn sàng, chọn “Hợp đồng số” cho từng xe bên dưới. Các xe còn lại vẫn có thể để “Hợp đồng giấy tự quản”.</li>
            </ol>
        </div>

        <form asp-action="SaveSignatureProfile" method="post" enctype="multipart/form-data" class="owner-signature-form">
            @Html.AntiForgeryToken()
            <div class="grid-2">
                <label>Nhà cung cấp CA
                    <input name="ProviderName" value="@profile?.ProviderName" placeholder="VD: VNPT-CA, Viettel-CA, FPT-CA" required />
                </label>
                <label>Số serial chứng thư
                    <input name="CertificateSerialNumber" value="@profile?.CertificateSerialNumber" required />
                </label>
                <label>Chủ thể chứng thư
                    <input name="CertificateSubject" value="@profile?.CertificateSubject" placeholder="Tên cá nhân/doanh nghiệp trên chứng thư" required />
                </label>
                <label>Hiệu lực đến
                    <input name="CertificateValidUntil" type="date" value="@(profile?.CertificateValidUntil?.ToString("yyyy-MM-dd"))" />
                </label>
            </div>
            <label>Ảnh chữ ký mẫu
                <input name="signatureImage" type="file" accept="image/*" />
            </label>
            @if (!string.IsNullOrWhiteSpace(profile?.SignatureImageUrl))
            {
                <div class="signature-preview">
                    <img src="@profile.SignatureImageUrl" alt="Chữ ký mẫu chủ xe" />
                    <span class="owner-muted">Trạng thái: @profile.Status</span>
                </div>
            }
            <button class="owner-pill primary" type="submit">
                <i class="bi bi-save"></i> Lưu hồ sơ chữ ký số
            </button>
        </form>
    </section>

    <section class="owner-panel">
        <h2>Cấu hình hợp đồng theo xe</h2>
        @if (!Model.Cars.Any())
        {
            <div class="owner-empty">
                <div>
                    <i class="bi bi-car-front"></i>
                    <h2>Chưa có xe</h2>
                    <p class="owner-muted">Đăng xe trước rồi chọn cách ký hợp đồng cho từng xe.</p>
                </div>
            </div>
        }
        else
        {
            <div class="owner-table-wrap">
                <table class="owner-table">
                    <thead>
                        <tr>
                            <th>Xe</th>
                            <th>Đang dùng</th>
                            <th>Chọn chế độ</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var car in Model.Cars)
                        {
                            <tr>
                                <td><strong>@car.DisplayName</strong><br /><span class="owner-muted">@car.LicensePlate</span></td>
                                <td><span class="owner-badge @(car.ContractSigningMode == CarContractSigningModes.Digital ? "ok" : "info")">@car.ContractSigningModeLabel</span></td>
                                <td>
                                    <form asp-action="UpdateContractMode" method="post" class="contract-mode-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="carId" value="@car.CarID" />
                                        <select name="contractSigningMode">
                                            <option value="@CarContractSigningModes.PhysicalSelfManaged" selected="@(car.ContractSigningMode == CarContractSigningModes.PhysicalSelfManaged)">Hợp đồng giấy tự quản</option>
                                            <option value="@CarContractSigningModes.Digital" selected="@(car.ContractSigningMode == CarContractSigningModes.Digital)" disabled="@(!car.CanEnableDigital)">Hợp đồng số</option>
                                        </select>
                                        <button type="submit" class="owner-pill">Cập nhật</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="owner-panel">
        <h2>Hợp đồng số đã tạo</h2>
        @if (!Model.DigitalContracts.Any())
        {
            <div class="owner-empty">
                <div>
                    <i class="bi bi-file-earmark-check"></i>
                    <h2>Chưa có hợp đồng số</h2>
                    <p class="owner-muted">Khi khách thanh toán xe đang bật hợp đồng số, hợp đồng sẽ xuất hiện tại đây.</p>
                </div>
            </div>
        }
        else
        {
            <div class="owner-table-wrap">
                <table class="owner-table">
                    <thead>
                        <tr>
                            <th>Hợp đồng</th>
                            <th>Khách</th>
                            <th>Xe</th>
                            <th>Trạng thái</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.DigitalContracts)
                        {
                            <tr>
                                <td><strong>@item.ContractNo</strong><br /><span class="owner-muted">@item.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></td>
                                <td>@item.CustomerName</td>
                                <td>@item.CarSummary</td>
                                <td>
                                    <span class="owner-badge @(item.IsSignedByCustomer ? "ok" : "warn")">
                                        @(item.IsSignedByCustomer ? $"Đã ký {item.CustomerSignDate?.ToLocalTime().ToString("dd/MM HH:mm")}" : "Chờ khách ký")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-controller="DigitalContract" asp-action="Details" asp-route-id="@item.DigitalContractID" class="owner-pill">Xem</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>

<style>
    .owner-section-head {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        align-items: flex-start;
    }

    .contract-compare {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 14px;
        margin-top: 16px;
    }

    .contract-compare article {
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        padding: 16px;
        background: #f8fbff;
    }

    .contract-compare h3 {
        font-size: 1rem;
        font-weight: 850;
        margin-bottom: 8px;
        color: #0f172a;
    }

    .contract-compare ul {
        margin: 10px 0 0;
        padding-left: 18px;
        color: #475467;
    }

    .contract-comparison-table,
    .signature-guide {
        margin-top: 18px;
    }

    .signature-guide {
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        padding: 16px 18px;
        background: #f8fbff;
    }

    .signature-guide h3 {
        font-size: 1rem;
        font-weight: 850;
        margin-bottom: 10px;
        color: #0f172a;
    }

    .signature-guide ol {
        margin: 0;
        padding-left: 20px;
        color: #475467;
    }

    .signature-guide li + li {
        margin-top: 8px;
    }

    .owner-signature-form {
        display: grid;
        gap: 14px;
        margin-top: 14px;
    }

    .signature-preview {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .signature-preview img {
        max-height: 82px;
        max-width: 220px;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #fff;
        padding: 8px;
    }

    .contract-mode-form {
        display: flex;
        gap: 8px;
        align-items: center;
        justify-content: flex-end;
        flex-wrap: wrap;
    }

    .contract-mode-form select {
        min-height: 38px;
        border: 1px solid #c8d3df;
        border-radius: 8px;
        padding: 8px 10px;
    }

    @@media(max-width: 820px) {
        .contract-compare,
        .grid-2 {
            grid-template-columns: 1fr;
        }

        .owner-section-head {
            flex-direction: column;
        }
    }
</style>
