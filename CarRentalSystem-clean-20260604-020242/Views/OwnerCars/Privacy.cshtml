@model CarRentalSystem.ViewModels.OwnerPrivacyViewModel
@{
    ViewData["Title"] = "Chính sách dữ liệu";
}

<div class="owner-portal">
    @await Html.PartialAsync("_OwnerPortalHeader", Model.Chrome)

    <section class="owner-panel">
        <div style="min-height:220px;border-radius:8px;background:linear-gradient(135deg,#dbeafe,#dcfce7);display:grid;place-items:center;margin-bottom:20px;">
            <div class="text-center">
                <i class="bi bi-shield-lock" style="font-size:4rem;color:#2563eb;"></i>
                <h2 class="mt-3">Bảo vệ dữ liệu chủ xe</h2>
            </div>
        </div>

        <div class="owner-badges mb-4">
            <span class="owner-badge ok"><i class="bi bi-check-circle"></i> Đồng ý xử lý dữ liệu vị trí để vận hành chuyến thuê</span>
            <span class="owner-badge ok"><i class="bi bi-check-circle"></i> Đồng ý xử lý thông tin giao dịch để đối soát doanh thu</span>
            <span class="owner-badge ok"><i class="bi bi-check-circle"></i> Đồng ý lưu chứng từ phục vụ tranh chấp và kiểm toán</span>
        </div>

        <p>CarRental cam kết chỉ sử dụng dữ liệu chủ xe cho mục đích vận hành dịch vụ, bảo vệ tài sản, hỗ trợ tranh chấp, kế toán nội bộ và tuân thủ pháp luật.</p>
        <p class="owner-muted">Cập nhật lần cuối: @Model.LastUpdated.ToString("dd/MM/yyyy")</p>
        <button class="owner-filter-button w-100" type="button" disabled>Đã xác nhận</button>
    </section>
</div>
