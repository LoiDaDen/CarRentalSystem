@model CarRentalSystem.Controllers.OwnerCarCreateViewModel
@{
    ViewData["Title"] = "Đăng xe";
    var brands = ViewBag.Brands as IEnumerable<CarRentalSystem.Models.CarBrand> ?? Enumerable.Empty<CarRentalSystem.Models.CarBrand>();
    var serviceTypes = ViewBag.ServiceTypes as IEnumerable<CarRentalSystem.Models.ServiceType> ?? Enumerable.Empty<CarRentalSystem.Models.ServiceType>();
    var amenities = ViewBag.Amenities as IEnumerable<CarRentalSystem.Models.CarAmenity> ?? Enumerable.Empty<CarRentalSystem.Models.CarAmenity>();
    var initialStep = ViewBag.InitialStep is int step && step >= 1 && step <= 3 ? step : 1;
}

<div class="owner-portal owner-create-page">
    <section class="owner-create-hero">
        <div>
            <div class="owner-kicker">Partner onboarding</div>
            <h1>Đăng xe theo chuẩn cho thuê cao cấp</h1>
            <p>Hoàn thiện hồ sơ vận hành, đăng kiểm, vị trí và ảnh xe để admin duyệt nhanh hơn và khách thuê tin tưởng hơn.</p>
        </div>
        <div class="owner-create-hero-card">
            <span><i class="bi bi-shield-check"></i> Đăng kiểm bắt buộc</span>
            <span><i class="bi bi-images"></i> Tối thiểu 4 ảnh</span>
            <span><i class="bi bi-geo-alt"></i> Vị trí GPS rõ ràng</span>
        </div>
    </section>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="mioto-form owner-create-premium" id="ownerCarForm">
    @Html.AntiForgeryToken()
    <div class="steps">
        <button type="button" class="step @(initialStep == 1 ? "active" : "")" data-step="1"><span>1</span>Thông tin</button>
        <button type="button" class="step @(initialStep == 2 ? "active" : "")" data-step="2"><span>2</span>Cho thuê</button>
        <button type="button" class="step @(initialStep == 3 ? "active" : "")" data-step="3"><span>3</span>Hình ảnh</button>
    </div>

    <section class="panel step-panel @(initialStep == 1 ? "" : "d-none")" data-panel="1">
        <h2>Biển số xe</h2>
        <p class="note">Lưu ý: Biển số sẽ không thể thay đổi sau khi đăng ký.</p>
        <input asp-for="LicensePlate" class="input short" required />
        <h2>Hạn đăng kiểm</h2>
        <p class="note">Xe phải còn hạn đăng kiểm để được duyệt và cho thuê.</p>
        <input asp-for="NextInspectionDate" type="date" class="input short" required />
        <span asp-validation-for="NextInspectionDate" class="field-error"></span>

        <h2>Thông tin cơ bản</h2>
        <p class="note">Lưu ý: Các thông tin cơ bản sẽ không thể thay đổi sau khi đăng ký.</p>
        <div class="grid-2">
            <label>Hãng xe
                <select asp-for="BrandID" id="brandSelect" required>
                    <option value="">Chọn hãng xe</option>
                    @foreach (var brand in brands)
                    {
                        <option value="@brand.BrandID">@brand.Name</option>
                    }
                </select>
            </label>
            <label>Mẫu xe
                <select asp-for="CarModelID" id="modelSelect" required>
                    <option value="">Chọn hãng xe trước</option>
                </select>
            </label>
            <label>Số ghế
                <select asp-for="Seats">
                    <option>4</option><option>5</option><option>7</option><option>9</option><option>16</option>
                </select>
            </label>
            <label>Năm sản xuất
                <select asp-for="ManufactureYear">
                    @for (var y = DateTime.UtcNow.Year; y >= 1990; y--) { <option value="@y">@y</option> }
                </select>
            </label>
            <label>Truyền động
                <select asp-for="Transmission"><option>Tự động</option><option>Số sàn</option></select>
            </label>
            <label>Nhiên liệu
                <select asp-for="FuelType"><option>Xăng</option><option>Dầu</option><option>Điện</option><option>Hybrid</option></select>
            </label>
        </div>
        <h2>Mức tiêu thụ nhiên liệu</h2>
        <p class="muted">Số lít nhiên liệu cho quãng đường 100km.</p>
        <input asp-for="FuelConsumption" class="input short" placeholder="10" />
        <h2>Mô tả</h2>
        <textarea asp-for="Description" rows="4" placeholder="Mô tả tình trạng, trang bị, ưu điểm của xe..."></textarea>
        <h2>Tính năng</h2>
        <div class="amenities">
            @foreach (var amenity in amenities)
            {
                <label class="amenity">
                    <input type="checkbox" name="AmenityIDs" value="@amenity.CarAmenityID" />
                    <i class="bi @amenity.Icon"></i>
                    <span>@amenity.Name</span>
                </label>
            }
        </div>
    </section>

    <section class="panel step-panel @(initialStep == 2 ? "" : "d-none")" data-panel="2">
        <h2>Đơn giá thuê mặc định</h2>
        <p class="muted">Giá đề xuất: <span id="suggestedPrice">440K</span></p>
        <div class="money-row"><input asp-for="PricePerDay" type="number" min="100000" value="440000" required /><span>đ/ngày</span></div>

        <h2>Loại dịch vụ</h2>
        <select asp-for="ServiceTypeID">
            @foreach (var serviceType in serviceTypes)
            {
                <option value="@serviceType.ServiceTypeID">@serviceType.Name</option>
            }
        </select>

        <h2>Kiểu hợp đồng</h2>
        <p class="muted">Nếu chọn hợp đồng số, bạn cần hoàn tất hồ sơ chữ ký số trong tab Hợp đồng & Chữ ký số trước.</p>
        <select asp-for="ContractSigningMode">
            <option value="@CarRentalSystem.Models.CarContractSigningModes.PhysicalSelfManaged">Hợp đồng giấy tự quản</option>
            <option value="@CarRentalSystem.Models.CarContractSigningModes.Digital">Hợp đồng số trên app</option>
        </select>
        <span asp-validation-for="ContractSigningMode" class="field-error"></span>

        <div class="toggle-row"><h2>Giảm giá thuê tuần</h2><input type="checkbox" checked /></div>
        <label>Giảm giá thuê tuần (% trên đơn giá)
            <input asp-for="WeeklyDiscountPercent" type="range" min="0" max="40" />
        </label>

        <h2>Địa chỉ xe</h2>
        <div class="address-row">
            <input asp-for="CarAddress" id="carAddressInput" placeholder="Địa chỉ mặc định để giao nhận xe." required />
            <button type="button" id="btnUseCurrentLocation"><i class="bi bi-crosshair"></i></button>
        </div>
        <span asp-validation-for="CarAddress" class="field-error"></span>
        <div id="ownerMapPicker" class="map-picker"></div>
        <div class="map-helper">
            <i class="bi bi-geo-alt"></i>
            Nhập địa chỉ hoặc chọn trực tiếp trên bản đồ. Vị trí bản đồ là bắt buộc để khách dễ tìm điểm giao nhận xe.
        </div>
        <div id="locationError" class="field-error d-none">Vui lòng nhập địa chỉ và chọn vị trí xe trên bản đồ.</div>
        <div class="grid-3">
            <input asp-for="CityOrProvince" placeholder="Tỉnh/Thành phố" />
            <input asp-for="District" placeholder="Quận/Huyện" />
            <input asp-for="Ward" placeholder="Phường/Xã" />
        </div>
        <input asp-for="Latitude" type="hidden" id="latInput" />
        <input asp-for="Longitude" type="hidden" id="lngInput" />
        <span asp-validation-for="Latitude" class="field-error"></span>

        <div class="toggle-row"><h2>Giao xe tận nơi</h2><input asp-for="DeliveryEnabled" type="checkbox" /></div>
        <div class="grid-3">
            <label>Quãng đường giao xe tối đa<input asp-for="MaxDeliveryDistanceKm" type="number" min="0" /></label>
            <label>Phí giao nhận mỗi km<input asp-for="DeliveryFeePerKm" type="number" min="0" /></label>
            <label>Miễn phí trong vòng<input asp-for="FreeDeliveryRadiusKm" type="number" min="0" /></label>
        </div>

        <div class="toggle-row"><h2>Giới hạn số km</h2><input asp-for="MileageLimitEnabled" type="checkbox" /></div>
        <div class="grid-2">
            <label>Số km tối đa trong 1 ngày<input asp-for="DailyMileageLimitKm" type="number" min="0" /></label>
            <label>Phí vượt giới hạn mỗi km<input asp-for="ExtraMileageFeePerKm" type="number" min="0" /></label>
        </div>

        <h2>Điều khoản thuê xe</h2>
        <textarea asp-for="RentalTerms" rows="4" placeholder="Ghi rõ các yêu cầu để khách có thể thuê xe."></textarea>
    </section>

    <section class="panel step-panel @(initialStep == 3 ? "" : "d-none")" data-panel="3">
        <h2>Hình ảnh xe</h2>
        <p class="note">Bắt buộc upload ít nhất 4 ảnh. Nên có ảnh trước, sau, hai bên và nội thất.</p>
        <label class="image-dropzone" id="imageDropzone" for="imageInput">
            <input asp-for="ImageFiles" type="file" accept="image/*" multiple required id="imageInput" />
            <span class="upload-icon"><i class="bi bi-cloud-arrow-up"></i></span>
            <strong>Chọn hoặc kéo thả ảnh xe</strong>
            <small>JPG, PNG, WEBP. Cần tối thiểu 4 ảnh rõ nét.</small>
            <span class="image-count" id="imageCount">0/4 ảnh bắt buộc</span>
        </label>
        <span asp-validation-for="ImageFiles" class="text-danger"></span>
        <div id="imagePreviewGrid" class="upload-preview-grid"></div>
    </section>

    <div class="form-actions">
        <button type="button" class="btn-back" id="btnBack" disabled>Quay lại</button>
        <button type="button" class="btn-next" id="btnNext">Kế tiếp</button>
        <button type="submit" class="btn-next d-none" id="btnSubmit">Gửi duyệt</button>
    </div>
</form>
</div>

<style>
    .owner-create-page {
        max-width: 1080px;
    }

    .owner-create-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
        gap: 18px;
        align-items: stretch;
        margin-bottom: 18px;
        padding: 22px;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background:
            linear-gradient(90deg, rgba(15, 23, 42, .92), rgba(15, 23, 42, .68)),
            url('https://images.unsplash.com/photo-1542362567-b07e54358753?q=80&w=1600&auto=format&fit=crop') center/cover;
        color: #fff;
        box-shadow: 0 18px 44px rgba(15, 23, 42, .12);
    }

    .owner-create-hero h1 {
        color: #fff;
        margin: 0 0 8px;
        font-size: clamp(1.75rem, 3vw, 2.6rem);
        font-weight: 850;
        letter-spacing: 0;
    }

    .owner-create-hero p {
        max-width: 680px;
        margin: 0;
        color: rgba(255, 255, 255, .78);
        line-height: 1.65;
    }

    .owner-kicker {
        color: #93c5fd;
        font-size: .72rem;
        font-weight: 850;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .owner-create-hero-card {
        display: grid;
        gap: 10px;
        align-content: center;
        padding: 16px;
        border: 1px solid rgba(255, 255, 255, .18);
        border-radius: 8px;
        background: rgba(255, 255, 255, .12);
        backdrop-filter: blur(10px);
    }

    .owner-create-hero-card span {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 38px;
        color: #fff;
        font-weight: 800;
    }

    .mioto-form {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 0 24px;
        background: transparent;
    }

    .steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
        padding: 0;
        background: transparent;
        border: 0;
    }

    .step {
        min-height: 74px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #fff;
        color: #667085;
        font-weight: 850;
        text-align: left;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .06);
    }

    .step span {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        margin: 0;
        border-radius: 8px;
        background: #eef3f8;
        color: #334155;
        font-weight: 900;
    }

    .step.active {
        border-color: #b8cef8;
        background: #eaf1ff;
        color: #1d4ed8;
    }

    .step.active span {
        background: #2563eb;
        color: #fff;
    }

    .panel {
        background: #fff;
        padding: clamp(22px, 4vw, 42px);
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .06);
    }

    .panel h2 {
        font-size: 1.15rem;
        font-weight: 850;
        letter-spacing: 0;
        margin: 26px 0 10px;
        color: #0f172a;
    }

    .panel h2:first-child {
        margin-top: 0;
    }

    .note,
    .muted {
        color: #667085;
        font-size: .9rem;
    }

    .input,
    select,
    textarea,
    input[type=number],
    input[type=text],
    input[type=date] {
        width: 100%;
        min-height: 44px;
        border: 1px solid #c8d3df;
        border-radius: 8px;
        padding: 11px 14px;
        background: #fff;
        color: #0f172a;
        box-shadow: none;
    }

    .input:focus,
    select:focus,
    textarea:focus,
    input[type=number]:focus,
    input[type=text]:focus,
    input[type=date]:focus {
        border-color: #2563eb;
        outline: none;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .14);
    }

    .short {
        max-width: 360px;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .amenities {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .amenity {
        min-height: 82px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #f8fbff;
        cursor: pointer;
        font-weight: 750;
    }

    .amenity input {
        display: none;
    }

    .amenity:has(input:checked) {
        border-color: #93c5fd;
        background: #eaf1ff;
        color: #1d4ed8;
    }

    .amenity i {
        font-size: 22px;
    }

    .money-row,
    .address-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .money-row input {
        max-width: 240px;
    }

    .toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 14px;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #f8fbff;
        margin: 18px 0 10px;
    }

    .address-row button {
        width: 52px;
        min-height: 44px;
        border: 1px solid #c8d3df;
        background: #fff;
        border-radius: 8px;
        color: #2563eb;
    }

    .form-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        padding: 18px 0 0;
    }

    .btn-back,
    .btn-next {
        min-height: 48px;
        border-radius: 8px;
        padding: 14px 16px;
        border: 1px solid #2563eb;
        font-weight: 850;
    }

    .btn-back {
        background: #fff;
        color: #2563eb;
    }

    .btn-back:disabled {
        border-color: #d9e2ec;
        color: #94a3b8;
    }

    .btn-next {
        background: #0f9f6e;
        color: #fff;
        border-color: #0f9f6e;
    }

    .map-picker {
        height: 320px;
        border: 1px solid #dbe2ea;
        border-radius: 8px;
        margin: 14px 0 10px;
        overflow: hidden;
        position: relative;
        z-index: 1;
    }

    .map-helper {
        display: flex;
        gap: 8px;
        align-items: flex-start;
        color: #667085;
        font-size: 13px;
        line-height: 1.45;
        margin: 0 0 16px;
    }

    .map-helper i {
        color: #2563eb;
        margin-top: 1px;
    }

    .field-error {
        display: block;
        color: #dc2626;
        font-size: 13px;
        margin-top: 7px;
    }

    .field-error.d-none {
        display: none;
    }

    .image-dropzone {
        min-height: 220px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 28px 20px;
        border: 2px dashed #b8cef8;
        border-radius: 8px;
        background: #f8fbff;
        text-align: center;
        cursor: pointer;
        transition: border-color .2s, box-shadow .2s, transform .2s;
    }

    .image-dropzone:hover,
    .image-dropzone.drag-over {
        border-color: #2563eb;
        box-shadow: 0 18px 40px rgba(37, 99, 235, .14);
        transform: translateY(-1px);
    }

    .image-dropzone input {
        display: none;
    }

    .upload-icon {
        width: 62px;
        height: 62px;
        display: grid;
        place-items: center;
        border-radius: 999px;
        background: #eaf1ff;
        color: #2563eb;
        font-size: 30px;
        margin-bottom: 4px;
    }

    .image-dropzone strong {
        font-size: 18px;
        color: #111827;
    }

    .image-dropzone small {
        color: #667085;
    }

    .image-count {
        margin-top: 6px;
        border: 1px solid #bbf7d0;
        border-radius: 999px;
        background: #f0fdf4;
        color: #15803d;
        padding: 5px 12px;
        font-size: 13px;
        font-weight: 800;
    }

    .upload-preview-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-top: 18px;
    }

    .upload-preview-card {
        position: relative;
        min-width: 0;
        overflow: hidden;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 10px 24px rgba(15, 23, 42, .08);
    }

    .upload-preview-card img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        display: block;
    }

    .upload-preview-card .file-name {
        padding: 8px 10px;
        font-size: 12px;
        color: #475467;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .remove-image {
        position: absolute;
        top: 8px;
        right: 8px;
        width: 30px;
        height: 30px;
        border: 0;
        border-radius: 999px;
        background: rgba(17, 24, 39, .78);
        color: #fff;
        display: grid;
        place-items: center;
    }

    @@media(max-width: 900px) {
        .owner-create-hero,
        .grid-2,
        .grid-3,
        .amenities {
            grid-template-columns: 1fr;
        }

        .steps {
            grid-template-columns: 1fr;
        }
    }

    @@media(max-width: 760px) {
        .panel {
            padding: 22px;
        }

        .upload-preview-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .map-picker {
            height: 280px;
        }
    }
</style>

@section Scripts {
<script>
let currentStep = @initialStep;
const panels = document.querySelectorAll('.step-panel');
const steps = document.querySelectorAll('.step');
const btnBack = document.getElementById('btnBack');
const btnNext = document.getElementById('btnNext');
const btnSubmit = document.getElementById('btnSubmit');
function showStep(step){
    currentStep = step;
    panels.forEach(p=>p.classList.toggle('d-none', p.dataset.panel != step));
    steps.forEach(s=>s.classList.toggle('active', s.dataset.step == step));
    btnBack.disabled = step === 1;
    btnNext.classList.toggle('d-none', step === 3);
    btnSubmit.classList.toggle('d-none', step !== 3);
}
btnBack.addEventListener('click',()=>showStep(Math.max(1,currentStep-1)));
btnNext.addEventListener('click',()=>{
    if(currentStep === 2 && !validateLocation(true)) return;
    showStep(Math.min(3,currentStep+1));
});
steps.forEach(s=>s.addEventListener('click',()=>{
    const targetStep = Number(s.dataset.step);
    if(currentStep === 2 && targetStep > 2 && !validateLocation(true)) return;
    showStep(targetStep);
}));

document.getElementById('brandSelect').addEventListener('change', async function(){
    const modelSelect = document.getElementById('modelSelect');
    modelSelect.innerHTML = '<option value="">Đang tải...</option>';
    const res = await fetch(`/CarCatalog/Models?brandId=${this.value}`);
    const models = await res.json();
    modelSelect.innerHTML = '<option value="">Chọn mẫu xe</option>' + models.map(m=>`<option value="${m.id}" data-seats="${m.seatCount||''}" data-fuel="${m.fuelType||''}" data-transmission="${m.transmission||''}">${m.name}</option>`).join('');
});

function validateLocation(showMessage){
    const addressInput = document.getElementById('carAddressInput');
    const latInput = document.getElementById('latInput');
    const lngInput = document.getElementById('lngInput');
    const locationError = document.getElementById('locationError');
    const isValid = Boolean(addressInput.value.trim() && latInput.value && lngInput.value);
    if(locationError){
        locationError.classList.toggle('d-none', isValid || !showMessage);
    }
    addressInput.classList.toggle('is-invalid', !isValid && showMessage);
    return isValid;
}

document.addEventListener('DOMContentLoaded', function(){
    const latInput = document.getElementById('latInput');
    const lngInput = document.getElementById('lngInput');
    const hasInitialCoords = Boolean(latInput.value && lngInput.value);

    if(typeof SmartMap !== 'undefined'){
        const picker = SmartMap.initPickerMap({
            containerId: 'ownerMapPicker',
            btnLocationId: 'btnUseCurrentLocation',
            latInputId: 'latInput',
            lngInputId: 'lngInput',
            addressInputId: 'carAddressInput'
        });

        if(picker && !hasInitialCoords){
            latInput.value = '';
            lngInput.value = '';
        }
    }
});
const imageInput = document.getElementById('imageInput');
const imageDropzone = document.getElementById('imageDropzone');
const imagePreviewGrid = document.getElementById('imagePreviewGrid');
const imageCount = document.getElementById('imageCount');
let selectedImageFiles = [];

function fileKey(file){
    return `${file.name}-${file.size}-${file.lastModified}`;
}

function syncImageInput(){
    const transfer = new DataTransfer();
    selectedImageFiles.forEach(file => transfer.items.add(file));
    imageInput.files = transfer.files;
}

function renderImagePreviews(){
    imagePreviewGrid.innerHTML = '';
    selectedImageFiles.forEach((file, index)=>{
        const card = document.createElement('div');
        card.className = 'upload-preview-card';
        card.innerHTML = `
            <button type="button" class="remove-image" aria-label="Xóa ảnh" data-index="${index}">
                <i class="bi bi-x-lg"></i>
            </button>
            <img src="${URL.createObjectURL(file)}" alt="${file.name}">
            <div class="file-name" title="${file.name}">${file.name}</div>`;
        imagePreviewGrid.appendChild(card);
    });
    imageCount.textContent = `${selectedImageFiles.length}/4 ảnh bắt buộc`;
    imageCount.style.color = selectedImageFiles.length >= 4 ? '#15803d' : '#b91c1c';
}

function addImageFiles(files){
    const existing = new Set(selectedImageFiles.map(fileKey));
    [...files].forEach(file=>{
        if(file.type.startsWith('image/') && !existing.has(fileKey(file))){
            selectedImageFiles.push(file);
            existing.add(fileKey(file));
        }
    });
    syncImageInput();
    renderImagePreviews();
}

imageInput.addEventListener('change', function(){
    addImageFiles(this.files);
});

imagePreviewGrid.addEventListener('click', function(e){
    const button = e.target.closest('.remove-image');
    if(!button) return;
    selectedImageFiles.splice(Number(button.dataset.index), 1);
    syncImageInput();
    renderImagePreviews();
});

['dragenter','dragover'].forEach(eventName=>{
    imageDropzone.addEventListener(eventName, function(e){
        e.preventDefault();
        imageDropzone.classList.add('drag-over');
    });
});
['dragleave','drop'].forEach(eventName=>{
    imageDropzone.addEventListener(eventName, function(e){
        e.preventDefault();
        imageDropzone.classList.remove('drag-over');
    });
});
imageDropzone.addEventListener('drop', function(e){
    addImageFiles(e.dataTransfer.files);
});

document.getElementById('ownerCarForm').addEventListener('submit', function(e){
    if(!validateLocation(true)){
        e.preventDefault();
        showStep(2);
        return;
    }

    const count = imageInput.files.length;
    if(count < 4){
        e.preventDefault();
        alert('Vui lòng upload tối thiểu 4 ảnh xe.');
        showStep(3);
    }
});

showStep(currentStep);
renderImagePreviews();
</script>
}
