@model CarRentalSystem.ViewModels.OwnerFinesViewModel
@{
    ViewData["Title"] = "Tra cứu phạt nguội";
}

<div class="owner-portal">
    @await Html.PartialAsync("_OwnerPortalHeader", Model.Chrome)

    <form method="get" class="owner-toolbar">
        <div class="owner-field">
            <label for="carId">Chọn xe</label>
            <select id="carId" name="carId">
                <option value="">Nhập biển số thủ công</option>
                @foreach (var car in Model.Cars)
                {
                    <option value="@car.CarID" selected="@(Model.CarId == car.CarID)">@car.Name - @car.LicensePlate</option>
                }
            </select>
        </div>
        <div class="owner-field">
            <label for="plate">Biển số xe</label>
            <input id="plate" name="plate" value="@Model.Plate" placeholder="VD: 51A-123.45" />
        </div>
        <div></div>
        <button class="owner-filter-button" type="submit">Tra cứu</button>
    </form>

    <section class="owner-panel">
        <h2>Kết quả tra cứu</h2>
        @if (!Model.HasQuery)
        {
            <p class="owner-muted mb-0">Nhập biển số hoặc chọn xe để bắt đầu kiểm tra.</p>
        }
        else if (!Model.IsPlateOwned)
        {
            <div class="owner-badge danger mb-3"><i class="bi bi-exclamation-triangle"></i> Biển số này không thuộc xe của bạn</div>
            <p class="owner-muted mb-0">Vui lòng chọn đúng xe trong danh sách quản lý cho thuê.</p>
        }
        else
        {
            <div class="owner-empty">
                <div>
                    <i class="bi bi-shield-check"></i>
                    <h2>Chưa có dữ liệu tra cứu tự động</h2>
                    <p class="owner-muted">Biển số chuẩn hóa: <strong>@Model.NormalizedPlate</strong></p>
                    <p class="owner-muted">V1 chưa kết nối API phạt nguội chính thức. Chủ xe có thể dùng thông tin này để đối chiếu trên cổng tra cứu của cơ quan chức năng.</p>
                    <a class="owner-pill primary" href="https://www.csgt.vn/tra-cuu-phuong-tien-vi-pham.html" target="_blank" rel="noopener">
                        <i class="bi bi-box-arrow-up-right"></i>
                        Mở cổng tra cứu CSGT
                    </a>
                </div>
            </div>
        }
    </section>
</div>
