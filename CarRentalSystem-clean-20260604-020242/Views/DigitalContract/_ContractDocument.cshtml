@model CarRentalSystem.Models.DigitalContract

<div class="contract-document bg-white border rounded-3 p-4 text-start">
    <div class="d-flex flex-wrap justify-content-between gap-3 border-bottom pb-3 mb-4">
        <div>
            <div class="text-muted small">Mã hợp đồng</div>
            <h2 class="h4 fw-bold mb-0">@Model.ContractNo</h2>
        </div>
        <div class="text-end">
            <div class="text-muted small">Phiên bản</div>
            <div class="fw-bold">v@Model.ContractVersion</div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-6">
            <h3 class="h6 fw-bold text-uppercase text-muted">Bên thuê</h3>
            <dl class="row small mb-0">
                <dt class="col-5">Họ tên</dt>
                <dd class="col-7">@Model.CustomerName</dd>
                <dt class="col-5">CCCD/CMND</dt>
                <dd class="col-7">@Model.CustomerIdentityCard</dd>
                <dt class="col-5">Điện thoại</dt>
                <dd class="col-7">@Model.CustomerPhone</dd>
                <dt class="col-5">Địa chỉ</dt>
                <dd class="col-7">@Model.CustomerAddress</dd>
            </dl>
        </div>
        <div class="col-md-6">
            <h3 class="h6 fw-bold text-uppercase text-muted">Thông tin thuê xe</h3>
            <dl class="row small mb-0">
                <dt class="col-5">Xe</dt>
                <dd class="col-7">@Model.CarModel</dd>
                <dt class="col-5">Biển số</dt>
                <dd class="col-7">@Model.CarLicensePlate</dd>
                <dt class="col-5">Thời gian</dt>
                <dd class="col-7">@Model.RentalStartDate.ToString("HH:mm dd/MM/yyyy") - @Model.RentalEndDate.ToString("HH:mm dd/MM/yyyy")</dd>
                <dt class="col-5">Giá trị</dt>
                <dd class="col-7 fw-bold">@Model.TotalContractValue.ToString("N0") VND</dd>
                <dt class="col-5">Cọc/thế chấp</dt>
                <dd class="col-7">@Model.DepositAmount.ToString("N0") VND</dd>
            </dl>
        </div>
    </div>

    <h3 class="h6 fw-bold text-uppercase text-muted">Điều khoản</h3>
    <pre class="contract-terms small bg-light border rounded-3 p-3 mb-4">@Model.TermsAndConditions</pre>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <div class="text-muted small mb-2">Bên A</div>
                @if (!string.IsNullOrWhiteSpace(Model.OwnerSignatureUrl))
                {
                    <img src="@Model.OwnerSignatureUrl" alt="Chữ ký mẫu chủ xe" class="img-fluid d-block mb-2" style="max-height:100px;" />
                }
                <div class="fw-bold">Chủ xe / CarRentalSystem</div>
                <div class="small text-muted">
                    @(Model.IsSignedByOwner ? $"Đã xác nhận lúc {Model.OwnerSignDate?.ToString("HH:mm dd/MM/yyyy")}" : "Chưa xác nhận")
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="border rounded-3 p-3 h-100">
                <div class="text-muted small mb-2">Bên thuê</div>
                @if (!string.IsNullOrWhiteSpace(Model.CustomerSignatureUrl))
                {
                    <img src="@Model.CustomerSignatureUrl" alt="Chữ ký khách hàng" class="img-fluid d-block mb-2" style="max-height:120px;" />
                }
                <div class="fw-bold">@Model.CustomerName</div>
                <div class="small text-muted">
                    @(Model.IsSignedByCustomer ? $"Đã ký lúc {Model.CustomerSignDate?.ToString("HH:mm dd/MM/yyyy")}" : "Chưa ký")
                </div>
            </div>
        </div>
    </div>

    <div class="border-top mt-4 pt-3 small text-muted">
        <div>Hash nội dung: @(Model.RenderedContentHash ?? "N/A")</div>
        <div>Hash chữ ký: @(Model.CustomerSignatureHash ?? "N/A")</div>
        <div>Hash chữ ký chủ xe: @(Model.OwnerSignatureHash ?? "N/A")</div>
    </div>
</div>

<style>
    .contract-document {
        line-height: 1.55;
    }

    .contract-terms {
        white-space: pre-wrap;
        font-family: inherit;
        max-height: 520px;
        overflow: auto;
    }
</style>
