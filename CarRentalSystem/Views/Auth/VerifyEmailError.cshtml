@{
    ViewData["Title"] = "Lỗi Xác Thực Email";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-danger">
            <div class="card-body py-5 text-danger">
                <i class="bi bi-exclamation-triangle-fill" style="font-size: 4rem;"></i>
                <h2 class="mt-3 mb-4">Lỗi Xác Thực Email</h2>
                <p class="text-muted fs-5">
                    @ViewBag.Error
                </p>
                <p class="text-muted">
                    Token xác thực có thể đã hết hạn hoặc không còn hiệu lực. Bạn có thể yêu cầu gửi lại email xác thực từ trang đăng nhập.
                </p>
                <a asp-action="Login" asp-controller="Auth" class="btn btn-outline-danger px-4 py-2 mt-3">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Trở về Trang Đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>
