@{
    ViewData["Title"] = "Đăng ký thành công";
    var registeredEmail = TempData["RegisteredEmail"]?.ToString();
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm border-0">
            <div class="card-body py-5">
                <i class="bi bi-envelope-check text-success" style="font-size: 4rem;"></i>
                <h2 class="mt-3 mb-4">Đăng ký thành công!</h2>
                <p class="text-muted fs-5">
                    Tài khoản của bạn đã được tạo. Tuy nhiên, để bảo mật, bạn cần <strong>xác thực địa chỉ email</strong> trước khi có thể đăng nhập.
                </p>
                <div class="alert alert-info py-3 mb-4 text-start">
                    <i class="bi bi-info-circle-fill me-2"></i> Chúng tôi đã gửi một đường dẫn xác thực tới email của bạn. Vui lòng kiểm tra hộp thư đến (và thư mục Spam/Quảng cáo).
                </div>
                
                @if (!string.IsNullOrEmpty(registeredEmail))
                {
                    <form asp-action="ResendVerificationEmail" method="post" class="mb-4 text-center">
                        <input type="hidden" name="email" value="@registeredEmail" />
                        <p class="small text-muted mb-2">Không nhận được email xác thực?</p>
                        <button type="submit" id="resendBtn" class="btn btn-outline-secondary px-4 py-2" disabled>
                            <span id="resendText">Gửi lại email trong <span id="countdown">90</span>s</span>
                        </button>
                    </form>
                }

                <a asp-action="Login" asp-controller="Auth" class="btn btn-primary px-4 py-2">
                    <i class="bi bi-box-arrow-in-right me-2"></i> Trở về màn hình Đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var btn = document.getElementById("resendBtn");
            if (!btn) return;
            
            var countdownSpan = document.getElementById("countdown");
            var textSpan = document.getElementById("resendText");
            var timeLeft = 90;

            var timer = setInterval(function () {
                timeLeft--;
                countdownSpan.textContent = timeLeft;

                if (timeLeft <= 0) {
                    clearInterval(timer);
                    btn.disabled = false;
                    btn.classList.remove("btn-outline-secondary");
                    btn.classList.add("btn-outline-primary");
                    textSpan.innerHTML = "<i class='bi bi-arrow-clockwise me-2'></i> Gửi lại Email Xác Thực ngay";
                }
            }, 1000);
        });
    </script>
}
