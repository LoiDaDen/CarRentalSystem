@model CarRentalSystem.Models.User
@{
    ViewData["Title"] = "Hồ sơ của tôi";
}

<div class="row g-4 page-profile">
    <!-- Sidebar -->
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body text-center p-4">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-person-fill fs-1"></i>
                </div>
                <h5 class="fw-bold mb-1">@Model.Name</h5>
                <p class="text-muted small mb-0">Thành viên từ @Model.CreatedAt.ToString("MM/yyyy")</p>
            </div>
            <div class="list-group list-group-flush border-top">
                <a asp-controller="Auth" asp-action="Profile" class="list-group-item list-group-item-action d-flex align-items-center p-3 active border-success bg-success bg-opacity-10 text-success fw-bold">
                    <i class="bi bi-person me-3 fs-5"></i> Thông tin tài khoản
                </a>
                <a asp-controller="Booking" asp-action="MyBookings" class="list-group-item list-group-item-action d-flex align-items-center p-3">
                    <i class="bi bi-car-front me-3 fs-5 text-muted"></i> Chuyến xe của tôi
                </a>
                <a asp-controller="Auth" asp-action="Logout" class="list-group-item list-group-item-action d-flex align-items-center p-3 text-danger mt-2 border-top">
                    <i class="bi bi-box-arrow-right me-3 fs-5"></i> Đăng xuất
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="col-lg-9">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4 d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <h5 class="fw-bold mb-1"><i class="bi bi-gift text-primary me-2"></i>Mã giới thiệu</h5>
                    <p class="text-muted small mb-0">Bạn bè nhập mã này sẽ được giảm 100.000đ cho lần thuê xe đầu tiên.</p>
                </div>
                @if (Model.IsVerified && !string.IsNullOrWhiteSpace(Model.ReferralCode))
                {
                    <div class="input-group" style="max-width:260px;">
                        <input id="referralCodeBox" class="form-control form-control-lg bg-light fw-bold text-center" value="@Model.ReferralCode" readonly />
                        <button type="button" class="btn btn-primary" onclick="navigator.clipboard?.writeText(document.getElementById('referralCodeBox').value)">
                            <i class="bi bi-copy"></i>
                        </button>
                    </div>
                }
                else
                {
                    <span class="badge rounded-pill bg-warning text-dark px-3 py-2">Xác thực eKYC để nhận mã</span>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                <h4 class="fw-bold mb-0">Thông tin cá nhân</h4>
                <p class="text-muted small mt-1">Quản lý thông tin cá nhân của bạn.</p>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Auth" asp-action="Profile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="UserID" />
                    
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-bold">Họ và tên</label>
                            <input asp-for="Name" class="form-label form-control-lg form-control bg-light" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-bold">Số điện thoại</label>
                            <input asp-for="Phone" class="form-label form-control-lg form-control bg-light" placeholder="Chưa cung cấp" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    @* ═══ CCCD / GPLX — Mã hóa + PIN bảo mật ═══ *@
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CitizenId" class="form-label fw-bold"><i class="bi bi-shield-lock text-warning me-1"></i>Số CMND / CCCD</label>
                            @if (User.IsInRole("Admin"))
                            {
                                <input asp-for="CitizenId" class="form-control form-control-lg bg-light" placeholder="Nhập số thẻ" />
                            }
                            else
                            {
                                <div class="input-group input-group-lg">
                                    <input id="citizenIdDisplay" asp-for="CitizenId" class="form-control bg-light text-muted" readonly />
                                    <button type="button" class="btn btn-outline-primary rounded-end" id="btnToggleCccd" onclick="togglePii()" title="Nhấn để xem đầy đủ">
                                        <i class="bi bi-eye" id="cccdEyeIcon"></i>
                                    </button>
                                </div>
                                <small class="text-muted"><i class="bi bi-lock me-1"></i>Nhấn <i class="bi bi-eye"></i> và nhập mã PIN 6 số để xem.</small>
                            }
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DrivingLicenseNumber" class="form-label fw-bold"><i class="bi bi-shield-lock text-warning me-1"></i>Số GPLX (12 số)</label>
                            @if (User.IsInRole("Admin"))
                            {
                                <input asp-for="DrivingLicenseNumber" class="form-control form-control-lg bg-light" placeholder="Nhập đúng 12 chữ số" maxlength="12" pattern="\d{12}" />
                                <small class="text-muted">Bắt buộc đúng 12 chữ số.</small>
                            }
                            else
                            {
                                <div class="input-group input-group-lg">
                                    <input id="gplxDisplay" asp-for="DrivingLicenseNumber" class="form-control bg-light text-muted" readonly />
                                    <button type="button" class="btn btn-outline-primary rounded-end" onclick="togglePii()" title="Nhấn để xem đầy đủ">
                                        <i class="bi bi-eye" id="gplxEyeIcon"></i>
                                    </button>
                                </div>
                                <small class="text-muted"><i class="bi bi-lock me-1"></i>Nhấn <i class="bi bi-eye"></i> và nhập mã PIN 6 số để xem.</small>
                            }
                        </div>
                    </div>

                    @if (!User.IsInRole("Admin"))
                    {
                        <div class="mb-4">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill" onclick="showSetPinModal()">
                                <i class="bi bi-key me-1"></i>Đặt / Đổi mã PIN bảo mật
                            </button>
                        </div>
                    }

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-bold">Ngày sinh</label>
                            <input type="date" asp-for="DateOfBirth" class="form-control form-control-lg bg-light" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label fw-bold">Giới tính</label>
                            <select asp-for="Gender" class="form-select form-select-lg bg-light border-0 py-2">
                                <option value="">Chọn giới tính...</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-bold">Địa chỉ thường trú</label>
                            <input asp-for="Address" class="form-control form-control-lg bg-light" placeholder="Nhập địa chỉ" />
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control bg-light text-muted border-start-0 border-end-0" value="@Model.Email" readonly disabled />
                                <span class="input-group-text bg-light text-success border-start-0" title="Đã xác thực"><i class="bi bi-check-circle-fill"></i></span>
                            </div>
                            <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Email không thể thay đổi.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Mật khẩu</label>
                            <div class="input-group input-group-lg">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-lock"></i></span>
                                <input type="password" class="form-control bg-light text-muted border-start-0" value="********" readonly disabled />
                            </div>
                        </div>
                    </div>

                    <hr class="my-5 opacity-10" />
                    <h5 class="fw-bold mb-3"><i class="bi bi-person-badge text-primary me-2"></i> Xác thực danh tính (eKYC)</h5>
                    <p class="text-muted small mb-4">Upload ảnh CCCD và GPLX để xác minh danh tính.</p>
                    
                    @if(Model.IsVerified)
                    {
                        <div class="alert alert-success d-flex align-items-center mb-4 rounded-3">
                            <i class="bi bi-patch-check-fill fs-3 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Đã xác thực AI (eKYC) ✅</h6>
                                <div class="small">Hồ sơ thông tin cá nhân của bạn đã được đối soát tự động thành công.</div>
                            </div>
                        </div>

                        <div class="row g-4">
                            <div class="col-md-3">
                                <div class="border rounded-3 p-3 bg-light text-center h-100">
                                    <div class="mb-2 fw-bold small">Khuôn mặt</div>
                                    @if(!string.IsNullOrEmpty(Model.FaceUrl)) { <img src="@Model.FaceUrl" class="img-fluid rounded shadow-sm" style="height:80px;object-fit:cover;" /> }
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded-3 p-3 bg-light text-center h-100">
                                    <div class="mb-2 fw-bold small">CCCD (Mặt trước)</div>
                                    @if(!string.IsNullOrEmpty(Model.IdCardFrontUrl)) { <img src="@Model.IdCardFrontUrl" class="img-fluid rounded shadow-sm" style="height:80px;object-fit:cover;" /> }
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded-3 p-3 bg-light text-center h-100">
                                    <div class="mb-2 fw-bold small">CCCD (Mặt sau)</div>
                                    @if(!string.IsNullOrEmpty(Model.IdCardBackUrl)) { <img src="@Model.IdCardBackUrl" class="img-fluid rounded shadow-sm" style="height:80px;object-fit:cover;" /> }
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="border rounded-3 p-3 bg-light text-center h-100">
                                    <div class="mb-2 fw-bold small">GPLX</div>
                                    @if(!string.IsNullOrEmpty(Model.DrivingLicenseUrl)) { <img src="@Model.DrivingLicenseUrl" class="img-fluid rounded shadow-sm" style="height:80px;object-fit:cover;" /> }
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning d-flex align-items-center justify-content-between mb-4 rounded-3">
                            <div class="d-flex align-items-center">
                                <i class="bi bi-person-x fs-3 me-3 text-danger"></i>
                                <div>
                                    <h6 class="mb-0 fw-bold text-danger">Chưa xác thực eKYC</h6>
                                    <div class="small">Bạn cần thực hiện xác thực Tự động qua Trí tuệ Nhân tạo FPT.AI để thuê xe.</div>
                                </div>
                            </div>
                            <button type="button" class="btn btn-primary fw-bold rounded-pill shadow-sm" data-bs-toggle="modal" data-bs-target="#ekycQuickModal">
                                <i class="bi bi-shield-check me-1"></i> Bắt đầu Xác thực
                            </button>
                        </div>
                    }

                    <div class="d-flex justify-content-end pt-4 mt-4">
                        <button type="submit" class="btn btn-success btn-lg px-5 fw-bold rounded-pill shadow-sm">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════ *@
@* 🔐 MODAL: Nhập mã PIN để xem CCCD / GPLX     *@
@* ═══════════════════════════════════════════════ *@
<div class="modal fade" id="verifyPinModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 bg-primary bg-opacity-10 rounded-top-4">
                <h6 class="modal-title fw-bold"><i class="bi bi-shield-lock me-2"></i>Xác thực mã PIN</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-4">
                <p class="text-muted small mb-3">Nhập mã PIN 6 số để xem thông tin CCCD / GPLX</p>
                <div class="d-flex justify-content-center gap-1 mb-3" id="pinInputGroup">
                    <input type="password" class="form-control text-center fw-bold fs-4 pin-digit" maxlength="1" inputmode="numeric" style="width:45px;height:55px;border-radius:12px;" />
                    <input type="password" class="form-control text-center fw-bold fs-4 pin-digit" maxlength="1" inputmode="numeric" style="width:45px;height:55px;border-radius:12px;" />
                    <input type="password" class="form-control text-center fw-bold fs-4 pin-digit" maxlength="1" inputmode="numeric" style="width:45px;height:55px;border-radius:12px;" />
                    <input type="password" class="form-control text-center fw-bold fs-4 pin-digit" maxlength="1" inputmode="numeric" style="width:45px;height:55px;border-radius:12px;" />
                    <input type="password" class="form-control text-center fw-bold fs-4 pin-digit" maxlength="1" inputmode="numeric" style="width:45px;height:55px;border-radius:12px;" />
                    <input type="password" class="form-control text-center fw-bold fs-4 pin-digit" maxlength="1" inputmode="numeric" style="width:45px;height:55px;border-radius:12px;" />
                </div>
                <div id="pinError" class="text-danger small mb-2" style="display:none;"></div>
                <button type="button" class="btn btn-primary w-100 rounded-pill fw-bold" onclick="verifyPin()">
                    <i class="bi bi-unlock me-1"></i>Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

@* ═══════════════════════════════════════════════ *@
@* 🔑 MODAL: Đặt / Đổi mã PIN bảo mật           *@
@* ═══════════════════════════════════════════════ *@
<div class="modal fade" id="setPinModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 bg-warning bg-opacity-10 rounded-top-4">
                <h6 class="modal-title fw-bold"><i class="bi bi-key me-2"></i>Đặt mã PIN bảo mật</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-4">
                <div id="oldPinSection" style="display:none;" class="mb-3">
                    <label class="form-label small fw-bold">Mã PIN cũ</label>
                    <input type="password" id="oldPinInput" class="form-control form-control-lg text-center" maxlength="6" inputmode="numeric" placeholder="••••••" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Mã PIN mới (6 chữ số)</label>
                    <input type="password" id="newPinInput" class="form-control form-control-lg text-center" maxlength="6" inputmode="numeric" placeholder="••••••" />
                </div>
                <div class="mb-3">
                    <label class="form-label small fw-bold">Xác nhận mã PIN mới</label>
                    <input type="password" id="confirmPinInput" class="form-control form-control-lg text-center" maxlength="6" inputmode="numeric" placeholder="••••••" />
                </div>
                <div id="setPinError" class="text-danger small mb-2" style="display:none;"></div>
                <div id="setPinSuccess" class="text-success small mb-2" style="display:none;"></div>
                <button type="button" class="btn btn-warning w-100 rounded-pill fw-bold" onclick="setPin()">
                    <i class="bi bi-check-lg me-1"></i>Lưu mã PIN
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ═══ Auto-focus giữa các ô PIN digit ═══
    document.querySelectorAll('.pin-digit').forEach((input, idx, inputs) => {
        input.addEventListener('input', e => {
            e.target.value = e.target.value.replace(/\D/g, '');
            if (e.target.value && idx < inputs.length - 1) inputs[idx + 1].focus();
        });
        input.addEventListener('keydown', e => {
            if (e.key === 'Backspace' && !e.target.value && idx > 0) inputs[idx - 1].focus();
        });
        input.addEventListener('paste', e => {
            e.preventDefault();
            const paste = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6);
            paste.split('').forEach((ch, i) => { if (inputs[i]) inputs[i].value = ch; });
            if (paste.length > 0) inputs[Math.min(paste.length, inputs.length) - 1].focus();
        });
    });

    let piiRevealed = false;
    const maskedCccd = document.getElementById('citizenIdDisplay')?.value || '';
    const maskedGplx = document.getElementById('gplxDisplay')?.value || '';

    // ═══ Toggle hiện/ẩn PII ═══
    function togglePii() {
        if (piiRevealed) {
            // Ẩn lại
            document.getElementById('citizenIdDisplay').value = maskedCccd;
            document.getElementById('gplxDisplay').value = maskedGplx;
            document.getElementById('cccdEyeIcon').className = 'bi bi-eye';
            document.getElementById('gplxEyeIcon').className = 'bi bi-eye';
            piiRevealed = false;
            return;
        }
        // Kiểm tra đã đặt PIN chưa
        fetch('/Auth/HasPiiPin')
            .then(r => r.json())
            .then(data => {
                if (!data.hasPin) {
                    alert('⚠️ Bạn chưa đặt mã PIN bảo mật.\nVui lòng đặt mã PIN trước khi xem thông tin.');
                    showSetPinModal();
                } else {
                    // Mở modal nhập PIN
                    document.querySelectorAll('.pin-digit').forEach(i => i.value = '');
                    document.getElementById('pinError').style.display = 'none';
                    new bootstrap.Modal(document.getElementById('verifyPinModal')).show();
                    setTimeout(() => document.querySelector('.pin-digit').focus(), 300);
                }
            });
    }

    // ═══ Xác thực PIN → hiện PII ═══
    function verifyPin() {
        const digits = [...document.querySelectorAll('.pin-digit')].map(i => i.value).join('');
        if (digits.length !== 6) {
            document.getElementById('pinError').textContent = 'Vui lòng nhập đủ 6 số.';
            document.getElementById('pinError').style.display = 'block';
            return;
        }

        fetch('/Auth/VerifyPiiPin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pin: digits })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                bootstrap.Modal.getInstance(document.getElementById('verifyPinModal')).hide();
                document.getElementById('citizenIdDisplay').value = data.citizenId;
                document.getElementById('gplxDisplay').value = data.drivingLicenseNumber;
                document.getElementById('cccdEyeIcon').className = 'bi bi-eye-slash';
                document.getElementById('gplxEyeIcon').className = 'bi bi-eye-slash';
                piiRevealed = true;

                // ⏱️ Tự động ẩn lại sau 30 giây
                setTimeout(() => {
                    if (piiRevealed) {
                        document.getElementById('citizenIdDisplay').value = maskedCccd;
                        document.getElementById('gplxDisplay').value = maskedGplx;
                        document.getElementById('cccdEyeIcon').className = 'bi bi-eye';
                        document.getElementById('gplxEyeIcon').className = 'bi bi-eye';
                        piiRevealed = false;
                    }
                }, 30000);
            } else {
                document.getElementById('pinError').textContent = data.message;
                document.getElementById('pinError').style.display = 'block';
                document.querySelectorAll('.pin-digit').forEach(i => i.value = '');
                document.querySelector('.pin-digit').focus();
            }
        });
    }

    // ═══ Mở modal đặt PIN ═══
    async function showSetPinModal() {
        const res = await fetch('/Auth/HasPiiPin');
        const data = await res.json();
        document.getElementById('oldPinSection').style.display = data.hasPin ? 'block' : 'none';
        document.getElementById('oldPinInput').value = '';
        document.getElementById('newPinInput').value = '';
        document.getElementById('confirmPinInput').value = '';
        document.getElementById('setPinError').style.display = 'none';
        document.getElementById('setPinSuccess').style.display = 'none';
        new bootstrap.Modal(document.getElementById('setPinModal')).show();
    }

    // ═══ Lưu PIN ═══
    function setPin() {
        const oldPin = document.getElementById('oldPinInput').value;
        const newPin = document.getElementById('newPinInput').value;
        const confirmPin = document.getElementById('confirmPinInput').value;
        const errEl = document.getElementById('setPinError');
        const sucEl = document.getElementById('setPinSuccess');
        errEl.style.display = 'none';
        sucEl.style.display = 'none';

        if (!/^\d{6}$/.test(newPin)) {
            errEl.textContent = 'Mã PIN mới phải đúng 6 chữ số.';
            errEl.style.display = 'block';
            return;
        }
        if (newPin !== confirmPin) {
            errEl.textContent = 'Xác nhận mã PIN không khớp.';
            errEl.style.display = 'block';
            return;
        }

        fetch('/Auth/SetPiiPin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pin: newPin, oldPin: oldPin || null })
        })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                sucEl.textContent = data.message;
                sucEl.style.display = 'block';
                setTimeout(() => bootstrap.Modal.getInstance(document.getElementById('setPinModal')).hide(), 1500);
            } else {
                errEl.textContent = data.message;
                errEl.style.display = 'block';
            }
        });
    }
</script>
}
