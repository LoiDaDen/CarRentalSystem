@model CarRentalSystem.Models.User
@{
    ViewData["Title"] = "Hồ sơ của tôi";
}

<div class="row g-4">
    <!-- Sidebar -->
    <div class="col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body text-center p-4">
                <div class="bg-success bg-opacity-10 text-success rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-person-fill fs-1"></i>
                </div>
                <h5 class="fw-bold mb-1">@Model.Name</h5>
                <p class="text-muted small mb-0">Thành viên từ @Model.CreatedAt.ToString("MM/yyyy")</p>
            </div>
            <div class="list-group list-group-flush border-top">
                <a asp-controller="Auth" asp-action="Profile" class="list-group-item list-group-item-action d-flex align-items-center p-3 active border-success bg-success bg-opacity-10 text-success fw-bold">
                    <i class="bi bi-person me-3 fs-5"></i> Thông tin tài khoản
                </a>
                <a asp-controller="Booking" asp-action="MyBookings" class="list-group-item list-group-item-action d-flex align-items-center p-3">
                    <i class="bi bi-car-front me-3 fs-5 text-muted"></i> Chuyến xe của tôi
                </a>
                <a asp-controller="Auth" asp-action="Logout" class="list-group-item list-group-item-action d-flex align-items-center p-3 text-danger mt-2 border-top">
                    <i class="bi bi-box-arrow-right me-3 fs-5"></i> Đăng xuất
                </a>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="col-lg-9">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 pb-0 px-4">
                <h4 class="fw-bold mb-0">Thông tin cá nhân</h4>
                <p class="text-muted small mt-1">Quản lý thông tin cá nhân của bạn.</p>
            </div>
            <div class="card-body p-4">
                <form asp-controller="Auth" asp-action="Profile" method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="UserID" />
                    
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="Name" class="form-label fw-bold">Họ và tên</label>
                            <input asp-for="Name" class="form-label form-control-lg form-control bg-light" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-bold">Số điện thoại</label>
                            <input asp-for="Phone" class="form-label form-control-lg form-control bg-light" placeholder="Chưa cung cấp" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CitizenId" class="form-label fw-bold">Số CMND / CCCD</label>
                            <input asp-for="CitizenId" class="form-label form-control-lg form-control bg-light" placeholder="Nhập số thẻ" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="DrivingLicenseNumber" class="form-label fw-bold">Số Giấy Phép Lái Xe</label>
                            <input asp-for="DrivingLicenseNumber" class="form-label form-control-lg form-control bg-light" placeholder="Nhập hạng / số GPLX" />
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="DateOfBirth" class="form-label fw-bold">Ngày sinh</label>
                            <input type="date" asp-for="DateOfBirth" class="form-label form-control-lg form-control bg-light" />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Gender" class="form-label fw-bold">Giới tính</label>
                            <select asp-for="Gender" class="form-select form-select-lg bg-light border-0 py-2">
                                <option value="">Chọn giới tính...</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-12">
                            <label asp-for="Address" class="form-label fw-bold">Địa chỉ thường trú</label>
                            <input asp-for="Address" class="form-label form-control-lg form-control bg-light" placeholder="Nhập địa chỉ của bạn" />
                        </div>
                    </div>

                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Email</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-envelope"></i></span>
                                <input type="email" class="form-control form-control-lg bg-light text-muted border-start-0 border-end-0" value="@Model.Email" readonly disabled />
                                <span class="input-group-text bg-light text-success border-start-0" title="Đã xác thực email"><i class="bi bi-check-circle-fill"></i></span>
                            </div>
                            <small class="text-muted mt-1 d-block"><i class="bi bi-info-circle me-1"></i> Email không thể thay đổi sau khi đăng ký.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Mật khẩu</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted border-end-0"><i class="bi bi-lock"></i></span>
                                <input type="password" class="form-control form-control-lg bg-light text-muted border-start-0" value="********" readonly disabled />
                            </div>
                        </div>
                    </div>

                    <hr class="my-5 opacity-10" />
                    <h5 class="fw-bold mb-3"><i class="bi bi-person-badge text-primary me-2"></i> Xác thực danh tính (eKYC)</h5>
                    <p class="text-muted small mb-4">Để đảm bảo an toàn cho các giao dịch thuê xe, bạn cần cung cấp ảnh CCCD và Giấy Phép Lái Xe. Thông tin này sẽ được bảo mật tuyệt đối.</p>
                    
                    @if(Model.IsVerified)
                    {
                        <div class="alert alert-success d-flex align-items-center mb-4 rounded-3">
                            <i class="bi bi-patch-check-fill fs-3 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Đã xác thực danh tính (Tích Xanh ✅)</h6>
                                <div class="small">Tài khoản của bạn đã qua kiểm tra eKYC. Bạn có thể đặt xe mọi lúc mà không cần nộp thêm giấy tờ.</div>
                            </div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(Model.IdCardFrontUrl) && !string.IsNullOrEmpty(Model.DrivingLicenseUrl))
                    {
                        <div class="alert alert-warning d-flex align-items-center mb-4 rounded-3">
                            <i class="bi bi-hourglass-split fs-3 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Đang chờ xét duyệt (⏳)</h6>
                                <div class="small">Bạn đã nộp đủ hồ sơ. Đội ngũ Admin sẽ duyệt trong vòng 24 giờ.</div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary d-flex align-items-center mb-4 rounded-3">
                            <i class="bi bi-person-x fs-3 me-3 text-muted"></i>
                            <div>
                                <h6 class="mb-0 fw-bold">Chưa xác thực danh tính</h6>
                                <div class="small">Vui lòng upload ảnh CCCD (2 mặt) và GPLX ở dưới để gửi yêu cầu xác minh.</div>
                            </div>
                        </div>
                    }

                    <div class="row g-4">
                        <div class="col-md-4">
                            <div class="border rounded-3 p-3 bg-light text-center h-100">
                                <div class="mb-2 fw-bold small text-dark">CCCD (Mặt trước)</div>
                                @if(!string.IsNullOrEmpty(Model.IdCardFrontUrl)) { <img src="@Model.IdCardFrontUrl" class="img-fluid rounded mb-2 shadow-sm" style="max-height:100px;object-fit:cover;" /> }
                                <input type="file" name="uploadIdFront" class="form-control form-control-sm" accept="image/*" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded-3 p-3 bg-light text-center h-100">
                                <div class="mb-2 fw-bold small text-dark">CCCD (Mặt sau)</div>
                                @if(!string.IsNullOrEmpty(Model.IdCardBackUrl)) { <img src="@Model.IdCardBackUrl" class="img-fluid rounded mb-2 shadow-sm" style="max-height:100px;object-fit:cover;" /> }
                                <input type="file" name="uploadIdBack" class="form-control form-control-sm" accept="image/*" />
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="border rounded-3 p-3 bg-light text-center h-100">
                                <div class="mb-2 fw-bold small text-dark">Giấy Phép Lái Xe</div>
                                @if(!string.IsNullOrEmpty(Model.DrivingLicenseUrl)) { <img src="@Model.DrivingLicenseUrl" class="img-fluid rounded mb-2 shadow-sm" style="max-height:100px;object-fit:cover;" /> }
                                <input type="file" name="uploadLicense" class="form-control form-control-sm" accept="image/*" />
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end pt-4 mt-4">
                        <button type="submit" class="btn btn-success btn-lg px-5 fw-bold rounded-pill shadow-sm">Lưu thay đổi</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>