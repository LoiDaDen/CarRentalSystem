        // ============================================
        // DATA PARSER - CCCD
        // ============================================
        const QrDataParser = {
            patterns: {
                pipeSeparated: /^[0-9]{12}\|.*$/,
                mrzFormat: /^([A-Z<]{2,3})([A-Z0-9<]+)\n([A-Z0-9<]+)$/i
            },
            
            parse(qrData) {
                try {
                    if (!qrData || qrData.trim() === '') {
                        return { success: false, message: 'Dữ liệu QR trống' };
                    }
                    
                    let result = this.parsePipeSeparated(qrData);
                    if (result.success) return result;
                    
                    result = this.parseMrzFormat(qrData);
                    if (result.success) return result;
                    
                    result = this.parseSimpleFormat(qrData);
                    if (result.success) return result;
                    
                    return { success: false, message: 'Định dạng QR không được hỗ trợ. Vui lòng nhập tay.' };
                    
                } catch (err) {
                    console.error('QR Parse Error:', err);
                    return { success: false, message: 'Lỗi xử lý QR: ' + err.message };
                }
            },
            
            parsePipeSeparated(data) {
                const parts = data.split('|').map(p => p.trim());
                
                if (parts.length < 5) {
                    return { success: false, message: 'Dữ liệu không đủ fields' };
                }
                
                let citizenId = parts.find(p => /^[0-9]{12}$/.test(p)) || '';
                let fullName = parts.find(p => /^[A-ZÀÁÂÃÈÉÊÌÍÒÓÔÕÙÚĂĐĨŨƠàáâãèéêìíòóôõùúăđĩũơẠ-ỹ\s]+$/i.test(p) && p.length > 5) || '';
                let dob = parts.find(p => /^(\d{8}|\d{4}-\d{2}-\d{2})$/.test(p)) || '';
                let gender = parts.find(p => /^(Nam|Nữ|Nam|NU)$/i.test(p)) || '';
                let address = parts.filter(p => p.length > 10 && /\d/.test(p))
                                   .sort((a, b) => b.length - a.length)[0] || '';
                
                if (!citizenId || citizenId.length !== 12) {
                    return { success: false, message: 'Không tìm thấy số CCCD hợp lệ' };
                }
                
                if (!fullName) {
                    return { success: false, message: 'Không tìm thấy họ tên' };
                }
                
                return {
                    success: true,
                    data: {
                        citizenId: citizenId,
                        fullName: this.normalizeName(fullName),
                        dateOfBirth: this.parseDate(dob),
                        gender: this.normalizeGender(gender),
                        address: address
                    }
                };
            },
            
            parseMrzFormat(data) {
                const lines = data.split('\n');
                if (lines.length < 2) return { success: false };
                
                const infoLine = lines.find(l => l.includes('<') && l.length > 30) || '';
                if (!infoLine) return { success: false };
                
                const nameMatch = infoLine.match(/^[A-Z]{2}[A-Z<]{0,3}(.+?)(?:<<|$)/i);
                
                let citizenId = '';
                for (const line of lines) {
                    const match = line.match(/^([A-Z]{2})([0-9]{7})([0-9]{5})/i);
                    if (match) {
                        citizenId = match[2] + match[3];
                        break;
                    }
                }
                
                if (!citizenId || citizenId.length !== 12) {
                    return { success: false };
                }
                
                return {
                    success: true,
                    data: {
                        citizenId: citizenId,
                        fullName: nameMatch ? this.normalizeMrzName(nameMatch[1]) : '',
                        dateOfBirth: '',
                        gender: '',
                        address: ''
                    }
                };
            },
            
            parseSimpleFormat(data) {
                const ccidMatch = data.match(/(\d{12})/);
                if (!ccidMatch) {
                    return { success: false, message: 'Không tìm thấy số CCCD' };
                }
                
                const parts = data.split(/[|]/);
                
                return {
                    success: true,
                    data: {
                        citizenId: ccidMatch[1],
                        fullName: parts.length > 2 ? this.normalizeName(parts[2]) : '',
                        dateOfBirth: '',
                        gender: '',
                        address: ''
                    }
                };
            },
            
            normalizeName(name) {
                if (!name) return '';
                return name.toLowerCase().split(' ').map(word => word.charAt(0).toUpperCase() + word.slice(1)).join(' ').trim();
            },
            
            normalizeMrzName(name) {
                if (!name) return '';
                return name.replace(/</g, ' ').split(' ').filter(s => s)
                    .map(word => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()).join(' ').trim();
            },
            
            parseDate(dateStr) {
                if (!dateStr) return '';
                
                if (/^\d{8}$/.test(dateStr)) {
                    const dd = dateStr.substring(0, 2);
                    const mm = dateStr.substring(2, 4);
                    const yyyy = dateStr.substring(4, 8);
                    return `${yyyy}-${mm}-${dd}`;
                }
                
                if (dateStr.includes('/')) {
                    const parts = dateStr.split('/');
                    if (parts.length === 3) {
                        return `${parts[2]}-${parts[1].padStart(2, '0')}-${parts[0].padStart(2, '0')}`;
                    }
                }
                
                return dateStr;
            },
            
            normalizeGender(gender) {
                if (!gender) return '';
                const g = gender.toLowerCase().trim();
                if (g === 'nữ' || g === 'nu') return 'Nữ';
                if (g === 'nam') return 'Nam';
                return gender;
            }
        };
        
        // ============================================
        // DATA PARSER - GPLX
        // ============================================
        const GplxDataParser = {
            parse(qrData) {
                try {
                    if (!qrData || qrData.trim() === '') {
                        return { success: false, message: 'Dữ liệu QR trống' };
                    }
                    
                    // Thử các format khác nhau
                    let result = this.parsePipeFormat(qrData);
                    if (result.success) return result;
                    
                    result = this.parseSimpleFormat(qrData);
                    if (result.success) return result;
                    
                    return { success: false, message: 'Định dạng QR GPLX không được hỗ trợ' };
                    
                } catch (err) {
                    console.error('GPLX Parse Error:', err);
                    return { success: false, message: 'Lỗi xử lý GPLX: ' + err.message };
                }
            },
            
            // Format pipe-separated của GPLX Việt Nam
            // Format: SoGPLX|HangGPLX|NgayCap|NgayHetHan|HoTen|NgaySinh...
            parsePipeFormat(data) {
                const parts = data.split('|').map(p => p.trim());
                
                if (parts.length < 3) {
                    return { success: false, message: 'Dữ liệu GPLX không đủ' };
                }
                
                // Tìm số GPLX (12 số)
                let licenseNumber = parts.find(p => /^[0-9]{12}$/.test(p)) || '';
                
                // Tìm hạng GPLX
                let licenseClass = '';
                const classPatterns = ['B1', 'B2', 'C', 'D', 'E', 'F', 'A1', 'A2'];
                for (const part of parts) {
                    for (const cls of classPatterns) {
                        if (part.toUpperCase().includes(cls)) {
                            licenseClass = cls;
                            break;
                        }
                    }
                    if (licenseClass) break;
                }
                
                if (!licenseNumber || licenseNumber.length !== 12) {
                    return { success: false, message: 'Không tìm thấy số GPLX hợp lệ' };
                }
                
                return {
                    success: true,
                    data: {
                        licenseNumber: licenseNumber,
                        licenseClass: licenseClass
                    }
                };
            },
            
            // Format đơn giản - trích xuất 12 số
            parseSimpleFormat(data) {
                const match = data.match(/(\d{12})/);
                if (!match) {
                    return { success: false, message: 'Không tìm thấy số GPLX 12 chữ số' };
                }
                
                return {
                    success: true,
                    data: {
                        licenseNumber: match[1],
                        licenseClass: ''
                    }
                };
            }
        };
        
