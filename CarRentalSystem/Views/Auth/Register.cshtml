                    await GplxScanner.start();
                } catch (err) {
                    console.error('Lỗi khởi tạo GPLX:', err);
                    GplxScanner.showStatus('error', 'Không thể khởi tạo camera');
                }
            });
            
            gplxModal.addEventListener('hidden.bs.modal', async function() {
                await GplxScanner.stop();
                GplxScanner.isProcessing = false;
            });
            
            document.getElementById('closeGplxModalBtn')?.addEventListener('click', async function() {
                await GplxScanner.stop();
            });
            
            // Tab Events
            document.getElementById('camera-tab')?.addEventListener('shown.bs.tab', async function() {
                if (!QrScanner.isScanning) await QrScanner.start();
            });
            document.getElementById('upload-tab')?.addEventListener('shown.bs.tab', async function() {
                await QrScanner.stop();
            });
            
            document.getElementById('gplx-camera-tab')?.addEventListener('shown.bs.tab', async function() {
                if (!GplxScanner.isScanning) await GplxScanner.start();
            });
            document.getElementById('gplx-upload-tab')?.addEventListener('shown.bs.tab', async function() {
                await GplxScanner.stop();
            });

            // File Upload Bindings
            const cccdFileInput = document.getElementById('cccdImageUpload');
            if (cccdFileInput) {
                cccdFileInput.addEventListener('change', function(e) {
                    if (e.target.files && e.target.files.length > 0) {
                        QrScanner.scanImageFile(e.target.files[0]);
                        e.target.value = ''; // Reset input to allow re-selection
                    }
                });
            }
            
            const gplxFileInput = document.getElementById('gplxImageUpload');
            if (gplxFileInput) {
                gplxFileInput.addEventListener('change', function(e) {
                    if (e.target.files && e.target.files.length > 0) {
                        GplxScanner.scanImageFile(e.target.files[0]);
                        e.target.value = ''; // Reset input
                    }
                });
            }
            
            // CCCD after GPLX Modal events
            cccdFromGplxModal.addEventListener('shown.bs.modal', async function() {
                try {
                    if (!isCccdAfterGplxInitialized) {
                        await CccdAfterGplxScanner.init('cccd-reader');
                        isCccdAfterGplxInitialized = true;
                    }
                    await CccdAfterGplxScanner.start();
                } catch (err) {
                    console.error('Lỗi khởi tạo CCCD:', err);
                    CccdAfterGplxScanner.showStatus('error', 'Không thể khởi tạo camera');
                }
            });
            
            cccdFromGplxModal.addEventListener('hidden.bs.modal', async function() {
                await CccdAfterGplxScanner.stop();
                CccdAfterGplxScanner.isProcessing = false;
            });
            
            document.getElementById('closeCccdFromGplxModalBtn')?.addEventListener('click', async function() {
                await CccdAfterGplxScanner.stop();
            });
            
            // Form validation
            const form = document.getElementById('registerForm');
            form.addEventListener('submit', function(e) {
                const citizenId = document.getElementById('citizenIdInput').value;
                const license = document.getElementById('licenseInput').value;
                
                if (citizenId && citizenId.length !== 12) {
                    e.preventDefault();
                    alert('Số CCCD phải đúng 12 chữ số!');
                    return false;
                }
                
                if (license && license.length !== 12) {
                    e.preventDefault();
                    alert('Số GPLX phải đúng 12 chữ số!');
                    return false;
                }
            });
        });
    </script>
}
