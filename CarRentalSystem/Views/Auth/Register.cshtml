@model CarRentalSystem.Models.User
@{ ViewData["Title"] = "Tạo Tài Khoản"; }

<style>
    .qr-scanner-container {
        position: relative;
        width: 100%;
        max-width: 320px;
        margin: 0 auto;
        border-radius: 16px;
        overflow: hidden;
        background: #000;
        aspect-ratio: 1;
    }
    
    .qr-scanner-container video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    
    .qr-scanner-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 200px;
        height: 200px;
        border: 3px solid #3b82f6;
        border-radius: 12px;
        box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.5);
    }
    
    .qr-scanner-overlay::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, transparent, #10b981, transparent);
        animation: qr-scan-line 2s linear infinite;
    }
    
    @@keyframes qr-scan-line {
        0%, 100% { top: 0; }
        50% { top: calc(100% - 3px); }
    }
    
    .scanner-instructions {
        background: linear-gradient(135deg, #eff6ff, #dbeafe);
        border: 1px solid #93c5fd;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 16px;
    }
    
    .scanner-instructions h6 {
        color: #1e40af;
        margin-bottom: 8px;
    }
    
    .scanner-instructions ul {
        margin-bottom: 0;
        padding-left: 20px;
    }
    
    .scanner-instructions li {
        color: #3b82f6;
        font-size: 0.875rem;
    }
    
    .scan-status {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 16px;
        border-radius: 8px;
        margin-top: 12px;
        font-size: 0.9rem;
    }
    
    .scan-status.scanning {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fcd34d;
    }
    
    .scan-status.success {
        background: #d1fae5;
        color: #065f46;
        border: 1px solid #6ee7b7;
    }
    
    .scan-status.error {
        background: #fee2e2;
        color: #991b1b;
        border: 1px solid #fca5a5;
    }
    
    .btn-scan-qr {
        background: linear-gradient(135deg, #3b82f6, #1d4ed8);
        color: white;
        border: none;
        padding: 10px 20px;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s;
    }
    
    .btn-scan-qr:hover {
        background: linear-gradient(135deg, #1d4ed8, #1e40af);
        transform: translateY(-1px);
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
    }
    
    .qr-info-badge {
        background: #f0f9ff;
        border: 1px solid #bae6fd;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 0.8rem;
        color: #0369a1;
        margin-top: 12px;
    }
    
    .qr-info-badge i {
        margin-right: 6px;
    }
</style>

<div class="row justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="col-md-6 col-lg-5">
        <div class="text-center mb-5">
            <h1 class="fw-800 text-primary mb-2">Gia Nhập UltraDrive</h1>
            <p class="text-muted">Đăng ký để truy cập đội xe tự lái cao cấp của chúng tôi.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 py-3">
                <i class="bi bi-exclamation-triangle me-2"></i> @ViewBag.Error
            </div>
        }

        <div class="card border-0 shadow-lg p-4 p-md-5 rounded-4">
            <div class="text-center mb-4">
                <button type="button" class="btn-scan-qr" data-bs-toggle="modal" data-bs-target="#qrModal" id="openQrScanner">
                    <i class="bi bi-qr-code-scan me-2"></i>Quét QR trên CCCD gắn chip để tự động điền
                </button>
            </div>

            <form asp-action="Register" method="post" id="registerForm">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted text-uppercase ls-1">Số CCCD <span class="text-danger">*</span></label>
                        <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-person-badge text-muted"></i></span>
                            <input asp-for="CitizenId" id="citizenIdInput" class="form-control bg-transparent border-0 py-2" placeholder="Nhập 12 số CCCD" required maxlength="12" pattern="[0-9]{12}" />
                        </div>
                        <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Quét QR hoặc nhập tay 12 chữ số</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted text-uppercase ls-1">Họ và Tên <span class="text-danger">*</span></label>
                        <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-person text-muted"></i></span>
                            <input asp-for="Name" id="nameInput" class="form-control bg-transparent border-0 py-2" placeholder="VD: Nguyễn Văn A" required />
                        </div>
                    </div>
                    
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted text-uppercase ls-1">Giới tính <span class="text-danger">*</span></label>
                        <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-gender-ambiguous text-muted"></i></span>
                            <select asp-for="Gender" id="genderInput" class="form-select bg-transparent border-0 py-2" style="background-color: transparent;" required>
                                <option value="">Chọn giới tính</option>
                                <option value="Nam">Nam</option>
                                <option value="Nữ">Nữ</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted text-uppercase ls-1">Ngày sinh <span class="text-danger">*</span></label>
                        <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-calendar text-muted"></i></span>
                            <input asp-for="DateOfBirth" id="dobInput" type="date" class="form-control bg-transparent border-0 py-2" required />
                        </div>
                    </div>
                    
                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted text-uppercase ls-1">Địa chỉ thường trú <span class="text-danger">*</span></label>
                        <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-geo-alt text-muted"></i></span>
                            <input asp-for="Address" id="addressInput" class="form-control bg-transparent border-0 py-2" placeholder="VD: 123 Đường ABC, Phường X, Quận Y, TP HCM" required />
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted text-uppercase ls-1">Số Giấy phép lái xe (GPLX) <span class="text-danger">*</span></label>
                        <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-card-heading text-muted"></i></span>
                            <input asp-for="DrivingLicenseNumber" id="licenseInput" class="form-control bg-transparent border-0 py-2" placeholder="Nhập đúng 12 chữ số" maxlength="12" pattern="\d{12}" title="Số GPLX phải đúng 12 chữ số" required />
                            <button type="button" class="btn btn-outline-primary btn-sm" onclick="openGplxScanner()" title="Quét QR GPLX">
                                <i class="bi bi-qr-code-scan"></i>
                            </button>
                        </div>
                        <small class="text-muted"><i class="bi bi-info-circle me-1"></i>Quét QR hoặc nhập tay 12 chữ số</small>
                    </div>
                    
                    <div class="col-12" id="gplxClassRow" style="display: none;">
                        <label class="form-label small fw-bold text-muted text-uppercase ls-1">Hạng GPLX <span class="text-danger">*</span></label>
                        <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-award text-muted"></i></span>
                            <select id="gplxClassInput" class="form-select bg-transparent border-0 py-2" style="background-color: transparent;">
                                <option value="">Chọn hạng GPLX (Nếu có)</option>
                                <option value="A1">A1 - Xe mô tô hai bánh dưới 175 cm³</option>
                                <option value="A2">A2 - Xe mô tô hai bánh trên 175 cm³</option>
                                <option value="B1">B1 - Ô tô chở người đến 9 chỗ</option>
                                <option value="B2">B2 - Ô tô chở người đến 9 chỗ + xe tải dưới 3.5 tấn</option>
                                <option value="C">C - Ô tô tải trên 3.5 tấn</option>
                                <option value="D">D - Ô tô chở người trên 9 chỗ</option>
                                <option value="E">E - Ô tô kéo rơ moóc</option>
                                <option value="F">F - Các loại GPLX đặc biệt</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted text-uppercase ls-1">Địa chỉ Email <span class="text-danger">*</span></label>
                        <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-envelope text-muted"></i></span>
                            <input type="email" asp-for="Email" class="form-control bg-transparent border-0 py-2" placeholder="email@example.com" required />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted text-uppercase ls-1">Số điện thoại <span class="text-danger">*</span></label>
                        <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-phone text-muted"></i></span>
                            <input asp-for="Phone" id="phoneInput" class="form-control bg-transparent border-0 py-2" placeholder="090..." required />
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-muted text-uppercase ls-1">Mật khẩu <span class="text-danger">*</span></label>
                        <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                            <span class="input-group-text bg-transparent border-0"><i class="bi bi-lock text-muted"></i></span>
                            <input type="password" asp-for="PasswordHash" id="passwordInput" class="form-control bg-transparent border-0 py-2" placeholder="Tối thiểu 6 ký tự" required minlength="6" />
                        </div>
                    </div>
                </div>

                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                    <label class="form-check-label small" for="agreeTerms">
                        Tôi đồng ý với <a href="#" class="text-primary">Điều khoản sử dụng</a> và <a href="#" class="text-primary">Chính sách bảo mật</a>
                    </label>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm rounded-pill py-3 mt-4" id="submitBtn">
                    <i class="bi bi-person-plus me-2"></i>Tạo Tài Khoản
                </button>
                
                <div class="mt-4 text-center">
                    <p class="text-muted small mb-0">Đã có tài khoản? <a asp-action="Login" class="fw-bold text-decoration-none">Đăng nhập ngay</a></p>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- QR Scanner Modal cho CCCD -->
<div class="modal fade" id="qrModal" tabindex="-1" aria-labelledby="qrModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="qrModalLabel">
                    <i class="bi bi-qr-code-scan text-primary me-2"></i>Quét QR CCCD gắn chip
                </h5>
                <button type="button" id="closeQrModalBtn" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2 px-4">
                <ul class="nav nav-pills justify-content-center mb-4 bg-light rounded-pill p-1" id="qrTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill fw-bold px-4" id="camera-tab" data-bs-toggle="pill" data-bs-target="#camera-pane" type="button" role="tab" aria-controls="camera-pane" aria-selected="true">
                            <i class="bi bi-camera-video me-1"></i>Camera
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill fw-bold px-4" id="upload-tab" data-bs-toggle="pill" data-bs-target="#upload-pane" type="button" role="tab" aria-controls="upload-pane" aria-selected="false">
                            <i class="bi bi-file-image me-1"></i>Tải ảnh lên
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="qrTabContent">
                    <div class="tab-pane fade show active text-center" id="camera-pane" role="tabpanel" aria-labelledby="camera-tab">
                        <div class="scanner-instructions">
                            <h6><i class="bi bi-lightbulb me-1"></i>Hướng dẫn quét QR</h6>
                            <ul>
                                <li>Sử dụng <strong>CCCD gắn chip</strong></li>
                                <li>Đưa mã QR trên thẻ vào khung màu xanh</li>
                            </ul>
                        </div>
                        <div class="qr-scanner-container mx-auto" id="qrScannerContainer">
                            <div id="qr-reader"></div>
                            <div class="qr-scanner-overlay" id="qrScannerOverlay"></div>
                        </div>
                        
                        <div id="scanStatus" class="scan-status scanning mx-auto mt-3" style="display: none; max-width: 320px;">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span id="scanStatusText">Đang khởi tạo camera...</span>
                        </div>
                    </div>

                    <div class="tab-pane fade text-center" id="upload-pane" role="tabpanel" aria-labelledby="upload-tab">
                        <div class="p-5 border rounded-4 bg-light" style="border-style: dashed !important; border-width: 2px !important; border-color: #cbd5e1 !important;">
                            <i class="bi bi-cloud-arrow-up display-3 text-primary mb-3 d-block"></i>
                            <h6 class="fw-bold mb-2">Tải ảnh QR CCCD</h6>
                            <p class="text-muted small mb-4">Chấp nhận định dạng JPG, PNG.</p>
                            <input type="file" id="cccdImageUpload" class="form-control mb-3" accept="image/png, image/jpeg" style="max-width: 300px; margin: 0 auto;">
                        </div>
                        
                        <div id="scanUploadStatus" class="scan-status error mx-auto mt-3" style="display: none; max-width: 320px;">
                            <i class="bi bi-x-circle me-2"></i>
                            <span id="scanUploadStatusText">Lỗi ảnh</span>
                        </div>
                    </div>
                </div>

                <div class="qr-info-badge text-center mt-4">
                    <i class="bi bi-shield-check"></i> Thông tin được mã hóa và chỉ dùng xác minh
                </div>
            </div>
        </div>
    </div>
</div>

<!-- QR Scanner Modal cho GPLX -->
<div class="modal fade" id="gplxModal" tabindex="-1" aria-labelledby="gplxModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="gplxModalLabel">
                    <i class="bi bi-credit-card text-warning me-2"></i>Quét QR GPLX
                </h5>
                <button type="button" id="closeGplxModalBtn" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2 px-4">
                <ul class="nav nav-pills justify-content-center mb-4 bg-light rounded-pill p-1" id="gplxTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active rounded-pill fw-bold px-4 text-warning-emphasis" id="gplx-camera-tab" data-bs-toggle="pill" data-bs-target="#gplx-camera-pane" type="button" role="tab" aria-selected="true">
                            <i class="bi bi-camera-video me-1"></i>Camera
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link rounded-pill fw-bold px-4 text-warning-emphasis" id="gplx-upload-tab" data-bs-toggle="pill" data-bs-target="#gplx-upload-pane" type="button" role="tab" aria-selected="false">
                            <i class="bi bi-file-image me-1"></i>Tải ảnh lên
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="gplxTabContent">
                    <div class="tab-pane fade show active text-center" id="gplx-camera-pane" role="tabpanel">
                        <div class="scanner-instructions" style="background: linear-gradient(135deg, #fef3c7, #fde68a); border-color: #f59e0b;">
                            <h6 style="color: #b45309;"><i class="bi bi-lightbulb me-1"></i>Hướng dẫn quét GPLX</h6>
                            <ul>
                                <li style="color: #d97706;"><strong>Mặt sau GPLX mới</strong> có mã QR</li>
                                <li style="color: #d97706;">Đưa mã QR vào khung trên màn hình</li>
                            </ul>
                        </div>
                        <div class="qr-scanner-container mx-auto" id="gplxScannerContainer">
                            <div id="gplx-reader"></div>
                            <div class="qr-scanner-overlay" id="gplxScannerOverlay"></div>
                        </div>
                        <div id="gplxScanStatus" class="scan-status scanning mx-auto mt-3" style="display: none; max-width: 320px;">
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span id="gplxScanStatusText">Đang khởi tạo camera...</span>
                        </div>
                    </div>
                    
                    <div class="tab-pane fade text-center" id="gplx-upload-pane" role="tabpanel">
                        <div class="p-5 border rounded-4" style="background: #fffbeb; border-style: dashed !important; border-width: 2px !important; border-color: #fcd34d !important;">
                            <i class="bi bi-cloud-arrow-up display-3 text-warning mb-3 d-block"></i>
                            <h6 class="fw-bold mb-2 text-warning-emphasis">Tải ảnh QR mặt sau GPLX</h6>
                            <p class="text-muted small mb-4">Chấp nhận định dạng JPG, PNG.</p>
                            <input type="file" id="gplxImageUpload" class="form-control border-warning bg-white mb-3" accept="image/png, image/jpeg" style="max-width: 300px; margin: 0 auto;">
                        </div>
                        <div id="gplxScanUploadStatus" class="scan-status error mx-auto mt-3" style="display: none; max-width: 320px;">
                            <i class="bi bi-x-circle me-2"></i>
                            <span id="gplxScanUploadStatusText">Lỗi ảnh</span>
                        </div>
                    </div>
                </div>

                <div class="qr-info-badge text-center mt-4" style="background: #fef3c7; border-color: #fcd34d; color: #b45309;">
                    <i class="bi bi-info-circle"></i> Có thể quét tiếp CCCD sau bước này
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Nút mở modal quét CCCD từ modal GPLX -->
<div class="modal fade" id="cccdFromGplxModal" tabindex="-1" aria-labelledby="cccdFromGplxModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="cccdFromGplxModalLabel">
                    <i class="bi bi-qr-code-scan text-primary me-2"></i>Quét QR CCCD
                </h5>
                <button type="button" id="closeCccdFromGplxModalBtn" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center pt-2">
                <div class="alert alert-success d-flex align-items-center mb-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <div>
                        <strong>Đã quét GPLX thành công!</strong><br>
                        Bây giờ bạn có thể quét CCCD để điền thông tin còn lại.
                    </div>
                </div>
                
                <div class="qr-scanner-container" id="cccdScannerContainer">
                    <div id="cccd-reader"></div>
                    <div class="qr-scanner-overlay" id="cccdScannerOverlay"></div>
                </div>
                
                <div id="cccdScanStatus" class="scan-status scanning" style="display: none;">
                    <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                    <span id="cccdScanStatusText">Đang khởi tạo camera...</span>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
    <script>
        // ============================================
        // QR SCANNER CHO CCCD
        // ============================================
        const QrScanner = {
            html5QrCode: null,
            isScanning: false,
            isProcessing: false,
            config: {
                fps: 10,
                qrbox: { width: 250, height: 250 },
                aspectRatio: 1.0,
                disableFlip: false,
                preferredCamera: 'environment'
            },
            
            async init(containerId) {
                this.html5QrCode = new Html5Qrcode(containerId);
                return this.html5QrCode;
            },
            
            async scanImageFile(file) {
                if (!file || this.isProcessing) return;
                this.isProcessing = true;
                
                const statusEl = document.getElementById('scanUploadStatus');
                const textEl = document.getElementById('scanUploadStatusText');
                if (statusEl && textEl) {
                    statusEl.className = 'scan-status scanning mx-auto mt-3';
                    statusEl.style.display = 'flex';
                    textEl.textContent = 'Đang phân tích hình ảnh...';
                }
                
                try {
                    console.log('Bắt đầu phân tích ảnh file:', file.name);
                    
                    let tempContainer = document.getElementById('temp-qr-reader-cccd');
                    if (!tempContainer) {
                        tempContainer = document.createElement('div');
                        tempContainer.id = 'temp-qr-reader-cccd';
                        tempContainer.style.position = 'absolute';
                        tempContainer.style.opacity = '0';
                        tempContainer.style.pointerEvents = 'none';
