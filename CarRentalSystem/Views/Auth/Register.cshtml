@model CarRentalSystem.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Tạo tài khoản";
}

<style>
    .register-shell {
        min-height: 78vh;
        display: grid;
        place-items: center;
        padding: 40px 16px;
        background: linear-gradient(180deg, #f8fafc 0%, #eef2ff 100%);
    }

    .register-card {
        width: min(100%, 560px);
        border: 1px solid rgba(148, 163, 184, .28);
        border-radius: 18px;
        background: #fff;
        box-shadow: 0 24px 70px rgba(15, 23, 42, .12);
        padding: 32px;
    }

    .register-card .input-group {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        overflow: hidden;
        background: #f8fafc;
    }

    .register-card .input-group-text,
    .register-card .form-control {
        border: 0;
        background: transparent;
    }

    .register-card .form-control:focus {
        box-shadow: none;
        background: #fff;
    }
</style>

<div class="register-shell">
    <div class="register-card">
        <div class="text-center mb-4">
            <h1 class="h3 fw-bold mb-2">Tạo tài khoản CarRental</h1>
            <p class="text-muted mb-0">CCCD và GPLX sẽ được cập nhật từ eKYC khi bạn bắt đầu thuê xe.</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 shadow-sm">
                <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.Error
            </div>
        }

        <form asp-action="Register" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-semibold">Họ tên / tên hiển thị</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person"></i></span>
                    <input asp-for="Name" class="form-control py-3" autocomplete="name" placeholder="VD: Nguyen Van A" />
                </div>
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Phone" class="form-label fw-semibold">Số điện thoại</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-phone"></i></span>
                    <input asp-for="Phone" class="form-control py-3" autocomplete="tel" placeholder="090..." />
                </div>
                <span asp-validation-for="Phone" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label fw-semibold">Email</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                    <input asp-for="Email" class="form-control py-3" autocomplete="email" placeholder="email@example.com" />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label fw-semibold">Mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" type="password" class="form-control py-3" autocomplete="new-password" placeholder="Tối thiểu 6 ký tự" />
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ConfirmPassword" class="form-label fw-semibold">Xác nhận mật khẩu</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-shield-lock"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control py-3" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>
            </div>

            <div class="mt-3">
                <label asp-for="ReferralCode" class="form-label fw-semibold">Mã giới thiệu <span class="text-muted fw-normal">(nếu có)</span></label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-gift"></i></span>
                    <input asp-for="ReferralCode" class="form-control py-3 text-uppercase" maxlength="6" placeholder="ABC123" />
                </div>
                <div class="form-text">Mã hợp lệ giảm 100.000đ cho lần thuê xe đầu tiên sau khi thanh toán PayOS thành công.</div>
                <span asp-validation-for="ReferralCode" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 mt-4 fw-bold">
                <i class="bi bi-person-plus me-2"></i>Tạo tài khoản
            </button>
        </form>

        <div class="text-center mt-4 small">
            Đã có tài khoản?
            <a asp-action="Login" class="fw-bold text-decoration-none">Đăng nhập</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
