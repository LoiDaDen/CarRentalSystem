@model CarRentalSystem.Models.User
@{ ViewData["Title"] = "Đăng Nhập Thành Viên"; }

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-5 col-lg-4">
        <div class="text-center mb-5">
            <h1 class="fw-800 text-primary mb-2">Chào Mừng Trở Lại</h1>
            <p class="text-muted">Đăng nhập để quản lý các chuyến xe của bạn.</p>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success border-0 shadow-sm mb-4 py-3">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
            </div>
        }

        @{
            var lockedParam = Context.Request.Query["locked"].ToString();
            var blacklistedParam = Context.Request.Query["blacklisted"].ToString();
        }
        @if (lockedParam == "1")
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 py-3">
                <i class="bi bi-lock-fill me-2"></i> Tài khoản của bạn đã bị khóa. Vui lòng liên hệ quản trị viên để được hỗ trợ.
            </div>
        }
        @if (blacklistedParam == "1")
        {
            <div class="alert alert-dark border-0 shadow-sm mb-4 py-3">
                <i class="bi bi-slash-circle me-2"></i> Tài khoản của bạn đã bị chặn khỏi hệ thống. Vui lòng liên hệ quản trị viên.
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4 py-3">
                <i class="bi bi-exclamation-triangle me-2"></i> @ViewBag.Error
                
                @if (ViewBag.Error.ToString().Contains("xác thực"))
                {
                    <hr />
                    <a asp-action="VerifyEmailStep1" class="btn btn-outline-danger btn-sm rounded-pill mt-2">
                        <i class="bi bi-shield-check me-1"></i>Xác minh tài khoản
                    </a>
                }
            </div>
        }

        <div class="card border-0 shadow-lg p-4 p-md-5 rounded-4">
            <form asp-action="Login" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted text-uppercase ls-1">Địa chỉ Email</label>
                    <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-envelope text-muted"></i></span>
                        <input type="email" name="email" class="form-control bg-transparent border-0 py-3" placeholder="email@example.com" required />
                    </div>
                </div>
                <div class="mb-5">
                    <label class="form-label small fw-bold text-muted text-uppercase ls-1">Mật khẩu</label>
                    <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-lock text-muted"></i></span>
                        <input type="password" name="password" class="form-control bg-transparent border-0 py-3" placeholder="••••••••" required />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm rounded-pill py-3">Đăng Nhập</button>

                <div class="d-flex justify-content-between align-items-center mt-3 small">
                    <a asp-action="VerifyEmailStep1" class="text-decoration-none">
                        <i class="bi bi-shield-check me-1"></i>Xác minh tài khoản
                    </a>
                    <a asp-action="ForgotPassword" class="text-decoration-none">
                        <i class="bi bi-question-circle me-1"></i>Quên mật khẩu?
                    </a>
                </div>
                
                <div class="mt-5 text-center">
                    <p class="text-muted small mb-0">Chưa có tài khoản? <a asp-action="Register" class="fw-bold text-decoration-none">Đăng ký ngay</a></p>
                </div>
            </form>
        </div>
    </div>
</div>
