@model CarRentalSystem.Models.BookingTransaction
@{
    ViewData["Title"] = "Thanh toán giỏ hàng thành công";
    var paidAmount = ViewBag.PaidAmount as decimal? ?? Model.Bookings.Sum(b => b.Payment?.Amount ?? b.ReservationFee);
    var status = ViewBag.PayOSStatus as string ?? Model.Status;
}

<div class="container py-5">
    <div class="mx-auto bg-white border rounded-4 shadow-sm p-4 p-md-5 text-center" style="max-width: 840px;">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle bg-success-subtle text-success mb-4" style="width:88px;height:88px;">
            <i class="bi bi-check2-circle display-5"></i>
        </div>

        <h1 class="h2 fw-800 mb-2">Thanh toán giỏ hàng thành công!</h1>
        <p class="lead text-muted mb-4">PayOS đã ghi nhận phí giữ chỗ và hệ thống đã tạo các đơn thuê từ giỏ hàng của bạn.</p>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success text-start rounded-3">
                <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            </div>
        }

        <div class="bg-light rounded-4 p-3 p-md-4 text-start mb-4">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="text-muted small">Mã giao dịch</div>
                    <div class="fw-bold">TRX-@Model.TransactionID</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Số xe đã đặt</div>
                    <div class="fw-bold">@Model.Bookings.Count xe</div>
                </div>
                <div class="col-md-4">
                    <div class="text-muted small">Trạng thái PayOS</div>
                    <div class="fw-bold text-success">@status</div>
                </div>
                <div class="col-md-12">
                    <div class="text-muted small">Phí giữ chỗ đã thanh toán</div>
                    <div class="fw-bold text-primary fs-5">@paidAmount.ToString("N0")đ</div>
                </div>
            </div>
        </div>

        @if (Model.Bookings.Any())
        {
            <div class="text-start mb-4">
                <h2 class="h5 fw-bold mb-3">Các xe trong đơn</h2>
                <div class="d-grid gap-2">
                    @foreach (var booking in Model.Bookings)
                    {
                        <div class="border rounded-3 p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                            <div>
                                <div class="fw-bold">#@booking.BookingID - @booking.Car?.CarBrand?.Name @booking.Car?.CarName</div>
                                <div class="small text-muted">@booking.StartDate.ToString("HH:mm dd/MM/yyyy") - @booking.EndDate.ToString("HH:mm dd/MM/yyyy")</div>
                            </div>
                            <a asp-controller="Booking" asp-action="Details" asp-route-id="@booking.BookingID" class="btn btn-sm btn-outline-primary rounded-3 fw-bold">Chi tiết</a>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="alert alert-info text-start rounded-3">
            <i class="bi bi-info-circle me-2"></i>
            Khi nhận xe, bạn thanh toán phần còn lại và hoàn tất các bước bàn giao theo từng đơn thuê.
        </div>

        <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
            <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-primary rounded-3 fw-bold px-4">
                Chuyến xe của tôi
            </a>
            <a asp-controller="Car" asp-action="Index" class="btn btn-outline-primary rounded-3 fw-bold px-4">
                Xem xe khác
            </a>
        </div>
    </div>
</div>
