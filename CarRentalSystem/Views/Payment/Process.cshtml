@model CarRentalSystem.Models.Payment
@{ ViewData["Title"] = "Thanh toán an toàn"; }

<div class="container py-5">
    <div class="payment-panel mx-auto text-center">
            <div class="mb-4">
                <div class="payment-icon bg-primary bg-opacity-10 mx-auto mb-4 d-flex align-items-center justify-content-center">
                    <i class="bi bi-shield-lock-fill fs-1 text-primary"></i>
                </div>
                <div class="pt-eyebrow mb-1">Thanh toán</div>
                <h2 class="fw-800">Xác nhận đặt cọc giữ xe</h2>
                <p class="text-muted">Hoàn tất thanh toán để hệ thống giữ xe theo lịch bạn đã chọn.</p>
            </div>

            <div class="bg-light p-4 rounded-4 mb-4">
                <small class="text-muted text-uppercase fw-bold ls-1 d-block mb-2">Số tiền cần thanh toán</small>
                <h1 class="fw-800 text-primary mb-0">@Model.Amount.ToString("N0") <span class="fs-4">VND</span></h1>
            </div>

            <form asp-action="Process">
                <input type="hidden" asp-for="BookingID" />
                <input type="hidden" asp-for="Amount" />
                
                <div class="text-start mb-4">
                    <label class="form-label small fw-bold">Chọn phương thức thanh toán</label>
                    <div class="d-grid gap-2">
                        <input type="radio" class="btn-check" name="PaymentMethod" id="method1" value="Online" checked>
                        <label class="btn btn-outline-primary p-3 d-flex align-items-center justify-content-between" for="method1">
                            <span><i class="bi bi-credit-card-2-front me-2"></i> Thanh toán trực tuyến</span>
                            <i class="bi bi-check-circle-fill"></i>
                        </label>
                        
                        <input type="radio" class="btn-check" name="PaymentMethod" id="method2" value="Cash">
                        <label class="btn btn-outline-secondary p-3 d-flex align-items-center justify-content-between" for="method2">
                            <span><i class="bi bi-cash-stack me-2"></i> Thanh toán khi nhận xe</span>
                            <i class="bi bi-circle"></i>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm">Thanh toán và xác nhận</button>
            </form>
            
            <p class="small text-muted mt-4">
                <i class="bi bi-info-circle me-1"></i> Giao dịch được bảo vệ và mã hóa.
            </p>
    </div>
</div>
