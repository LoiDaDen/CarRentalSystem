@model CarRentalSystem.Models.Payment
@{ ViewData["Title"] = "Secure Payment"; }

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card border-0 shadow-lg p-4 p-md-5 text-center">
            <div class="mb-4">
                <div class="bg-primary bg-opacity-10 rounded-circle mx-auto mb-4 d-flex align-items-center justify-content-center" style="width: 80px; height: 80px;">
                    <i class="bi bi-shield-lock-fill fs-1 text-primary"></i>
                </div>
                <h2 class="fw-800">Secure Checkout</h2>
                <p class="text-muted">Complete your payment to confirm your reservation.</p>
            </div>

            <div class="bg-light p-4 rounded-4 mb-4">
                <small class="text-muted text-uppercase fw-bold ls-1 d-block mb-2">Amount to Pay</small>
                <h1 class="fw-800 text-primary mb-0">@Model.Amount.ToString("N0") <span class="fs-4">VND</span></h1>
            </div>

            <form asp-action="Process">
                <input type="hidden" asp-for="BookingID" />
                <input type="hidden" asp-for="Amount" />
                
                <div class="text-start mb-4">
                    <label class="form-label small fw-bold">Select Payment Method</label>
                    <div class="d-grid gap-2">
                        <input type="radio" class="btn-check" name="PaymentMethod" id="method1" value="Online" checked>
                        <label class="btn btn-outline-primary p-3 d-flex align-items-center justify-content-between" for="method1">
                            <span><i class="bi bi-credit-card-2-front me-2"></i> Online Payment</span>
                            <i class="bi bi-check-circle-fill"></i>
                        </label>
                        
                        <input type="radio" class="btn-check" name="PaymentMethod" id="method2" value="Cash">
                        <label class="btn btn-outline-secondary p-3 d-flex align-items-center justify-content-between" for="method2">
                            <span><i class="bi bi-cash-stack me-2"></i> Cash at Pickup</span>
                            <i class="bi bi-circle"></i>
                        </label>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 shadow-sm rounded-pill">Pay & Confirm</button>
            </form>
            
            <p class="small text-muted mt-4">
                <i class="bi bi-info-circle me-1"></i> Your transaction is encrypted and secure.
            </p>
        </div>
    </div>
</div>
