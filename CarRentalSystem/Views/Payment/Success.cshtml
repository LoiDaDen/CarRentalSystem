@model CarRentalSystem.Models.Booking
@{
    ViewData["Title"] = "Thanh toán thành công";
}

<div class="container mt-5 mb-5 text-center">
    <div class="payment-success-card p-5 shadow-lg rounded-4 bg-white mx-auto page-payment-success">
        <div class="success-checkmark mb-4">
            <div class="check-icon">
                <span class="icon-line line-tip"></span>
                <span class="icon-line line-long"></span>
                <div class="icon-circle"></div>
                <div class="icon-fix"></div>
            </div>
        </div>

        <h2 class="display-6 fw-bold text-success mb-3">Thanh toán hoàn tất!</h2>
        <p class="lead text-muted mb-4">Cảm ơn bạn đã tin tưởng dịch vụ <strong>CarRental</strong>. Đơn hàng của bạn đang được xử lý.</p>

        <div class="order-info-box p-3 bg-light rounded-3 mb-4 text-start">
            <div class="d-flex justify-content-between mb-2">
                <span class="text-secondary">Mã đơn hàng:</span>
                <span class="fw-bold">#@Model.BookingID</span>
            </div>
            <div class="d-flex justify-content-between mb-2">
                <span class="text-secondary">Xe đã thuê:</span>
                <span class="fw-bold">@Model.Car?.CarName</span>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-secondary">Số tiền cọc:</span>
                <span class="fw-bold text-primary">@((Model.TotalPrice * 0.2m).ToString("N0")) VNĐ</span>
            </div>
        </div>

        <div class="alert alert-info py-2" role="alert">
            <i class="bi bi-info-circle me-2"></i>
            Hệ thống sẽ tự động chuyển hướng về trang cá nhân sau <span id="countdown">5</span> giây...
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
            <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-primary btn-lg px-4 rounded-pill shadow">
                <i class="bi bi-calendar-check me-2"></i>Xem chuyến xe của tôi
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                Về trang chủ
            </a>
        </div>
    </div>
</div>

<style>
    .payment-success-card { border-top: 5px solid #28a745; animation: slideInDown 0.6s ease-out; }
    .success-checkmark { width: 80px; height: 115px; margin: 0 auto; }
    .check-icon {
        width: 80px; height: 80px; position: relative; border-radius: 50%;
        box-sizing: content-box; border: 4px solid #4CAF50;
    }
    .check-icon::before {
        content: ""; position: absolute; width: 40px; height: 80px;
        background: #fff; left: -10px; top: -10px; transform-origin: 100% 50%;
        border-radius: 100px 0 0 100px; animation: rotate-circle 4.25s ease-in;
    }
    .check-icon::after {
        content: ""; position: absolute; width: 100px; height: 100px;
        background: #fff; left: 20px; top: -10px; transform-origin: 0 50%;
        border-radius: 0 100px 100px 0; animation: rotate-circle 4.25s ease-in;
    }
    .icon-line { height: 5px; background-color: #4CAF50; display: block; border-radius: 2px; position: absolute; z-index: 10; }
    .icon-line.line-tip { top: 46px; left: 14px; width: 25px; transform: rotate(45deg); animation: icon-line-tip 0.75s; }
    .icon-line.line-long { top: 38px; right: 8px; width: 47px; transform: rotate(-45deg); animation: icon-line-long 0.75s; }
    .icon-circle { top: -4px; left: -4px; z-index: 10; }
    .icon-fix { top: 5px; left: 27px; z-index: 10; width: 4px; height: 5px; border-radius: 2px; }

    @@keyframes rotate-circle { 0% { transform: rotate(0deg); } 100% { transform: rotate(50deg); } }
    @@keyframes icon-line-tip { 0% { width: 0; } 54% { width: 25px; } 100% { width: 25px; } }
    @@keyframes icon-line-long { 0% { width: 0; } 54% { width: 47px; } 100% { width: 47px; } }
</style>

@section Scripts {
    <script>
        let count = 5;
        const el = document.getElementById('countdown');
        const timer = setInterval(() => {
            count--; if (el) el.textContent = count;
            if (count <= 0) clearInterval(timer);
        }, 1000);
    </script>
}
