@model CarRentalSystem.Models.Booking
@{
    ViewData["Title"] = "Thanh toán bị hủy";
}

<div class="container mt-5 mb-5 text-center">
    <div class="payment-cancel-card p-5 shadow-lg rounded-4 bg-white mx-auto" style="max-width: 600px;">
        <div class="cancel-icon mb-4">
            <i class="bi bi-x-circle text-danger display-1 animate__animated animate__shakeX"></i>
        </div>

        <h2 class="display-6 fw-bold text-danger mb-3">Thanh toán không thành công</h2>
        <p class="lead text-muted mb-4">Giao dịch đã bị từ chối hoặc bạn đã hủy thao tác thanh toán.</p>

        <div class="alert alert-warning rounded-3 mb-4 text-start">
            <h5 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Bạn vẫn có thể đặt cọc!</h5>
            <p class="mb-0 small">Đơn hàng số **#@Model.BookingID** vẫn đang được giữ cho bạn. Bạn có thể thực hiện lại việc đặt cọc trong phần quản lý chuyến xe.</p>
        </div>

        <div class="d-grid gap-2 d-md-flex justify-content-md-center mt-4">
            <a asp-controller="Booking" asp-action="Deposit" asp-route-id="@Model.BookingID" class="btn btn-danger btn-lg px-4 rounded-pill shadow">
                <i class="bi bi-arrow-repeat me-2"></i>Thử thanh toán lại
            </a>
            <a asp-controller="Booking" asp-action="MyBookings" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                Xem danh sách đơn
            </a>
        </div>
    </div>
</div>

<style>
    .payment-cancel-card {
        border-top: 5px solid #dc3545;
        animation: fadeIn 0.8s ease-in;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: scale(0.95); }
        to { opacity: 1; transform: scale(1); }
    }

    .animate__shakeX {
        display: inline-block;
        animation: shakeX 1s;
    }

    @@keyframes shakeX {
        from, to { transform: translate3d(0, 0, 0); }
        10%, 30%, 50%, 70%, 90% { transform: translate3d(-10px, 0, 0); }
        20%, 40%, 60%, 80% { transform: translate3d(10px, 0, 0); }
    }
</style>
