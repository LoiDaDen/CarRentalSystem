@model IEnumerable<CarRentalSystem.Models.Car>
@{
    ViewData["Title"] = "Quản lý cho thuê";
}

<div class="owner-shell">
    <aside class="owner-sidebar">
        <h2>Xin chào bạn!</h2>
        <a asp-controller="Auth" asp-action="Profile"><i class="bi bi-person"></i>Tài khoản của tôi</a>
        <a class="active" asp-controller="OwnerCars" asp-action="Index"><i class="bi bi-car-front"></i>Quản lý cho thuê</a>
        <a asp-controller="Booking" asp-action="MyBookings"><i class="bi bi-suitcase2"></i>Chuyến xe của tôi</a>
        <a asp-controller="PhysicalContracts" asp-action="Index"><i class="bi bi-file-earmark-text"></i>Hợp đồng vật lý</a>
        <a asp-controller="Auth" asp-action="Logout" class="danger"><i class="bi bi-box-arrow-left"></i>Đăng xuất</a>
    </aside>
    <main class="owner-main">
        <div class="owner-head">
            <div>
                <h1>Quản lý cho thuê</h1>
                <p>Danh sách xe bạn đã đăng lên hệ thống.</p>
            </div>
            <a asp-action="Create" class="btn-register"><i class="bi bi-plus-lg"></i> Đăng xe</a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="bi bi-car-front"></i>
                <p>Không tìm thấy xe nào.</p>
            </div>
        }
        else
        {
            <div class="car-grid">
                @foreach (var car in Model)
                {
                    <article class="owner-car-card">
                        <img src="@(car.CarImages?.FirstOrDefault()?.ImageUrl ?? car.ImageURL ?? "/images/default-car.png")" alt="@car.CarName" />
                        <div>
                            <h3>@car.CarBrand?.Name @car.CarModel?.Name</h3>
                            <p>@car.LicensePlate · @car.Seats chỗ · @car.FuelType</p>
                            <span class="badge-soft">@car.CarStatus?.Name</span>
                        </div>
                        <strong>@car.PricePerDay.ToString("N0")đ/ngày</strong>
                    </article>
                }
            </div>
        }
    </main>
</div>

<style>
    .owner-shell{display:grid;grid-template-columns:280px 1fr;gap:32px;align-items:start}
    .owner-sidebar{background:#fff;border-right:1px solid #e5e7eb;padding:28px 22px;min-height:70vh}
    .owner-sidebar h2{font-size:28px;font-weight:800;margin-bottom:24px}
    .owner-sidebar a{display:flex;align-items:center;gap:12px;padding:13px 8px;color:#111827;text-decoration:none;border-left:3px solid transparent}
    .owner-sidebar a.active{border-left-color:#5bd486;color:#111827;font-weight:700}
    .owner-sidebar a.danger{color:#ef4444;margin-top:12px;border-top:1px solid #e5e7eb}
    .owner-main{padding:16px 0}
    .owner-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:24px}
    .owner-head h1{font-size:32px;font-weight:800;margin:0}
    .owner-head p{color:#6b7280;margin:6px 0 0}
    .btn-register{display:inline-flex;align-items:center;gap:8px;border-radius:999px;padding:10px 18px;background:#5bd486;color:#062b16;text-decoration:none;font-weight:700}
    .empty-state{height:360px;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#6b7280;background:#f8fafc}
    .empty-state i{font-size:64px;color:#5bd486;margin-bottom:16px}
    .car-grid{display:grid;gap:16px}
    .owner-car-card{display:grid;grid-template-columns:140px 1fr auto;gap:18px;align-items:center;background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:14px}
    .owner-car-card img{width:140px;height:92px;object-fit:cover;border-radius:6px}
    .owner-car-card h3{font-size:18px;font-weight:800;margin:0 0 6px}
    .owner-car-card p{margin:0;color:#6b7280}
    .badge-soft{display:inline-block;margin-top:8px;background:#eefdf4;color:#168447;border:1px solid #b9f4d0;border-radius:999px;padding:4px 10px;font-size:12px;font-weight:700}
    @@media(max-width:900px){.owner-shell{grid-template-columns:1fr}.owner-sidebar{min-height:auto}.owner-head{align-items:flex-start;gap:16px;flex-direction:column}.owner-car-card{grid-template-columns:1fr}.owner-car-card img{width:100%;height:180px}}
</style>
