@model CarRentalSystem.ViewModels.OwnerFinesViewModel
@{
    ViewData["Title"] = "Tra cứu phạt nguội";
}

<div class="owner-portal">
    @await Html.PartialAsync("_OwnerPortalHeader", Model.Chrome)

    <section class="owner-panel">
        <h2>Tra cứu phạt nguội CSGT</h2>
        <div class="owner-empty">
            <div>
                <i class="bi bi-shield-check"></i>
                <h2>Mở cổng tra cứu chính thức</h2>
                <p class="owner-muted">DriveGo không tự tra cứu hoặc lưu dữ liệu phạt nguội. Chủ xe vui lòng mở cổng Cục Cảnh sát giao thông và nhập biển số xe trực tiếp trên hệ thống chính thức.</p>
                <a class="owner-pill primary" href="https://csgt.bocongan.gov.vn/tra-cuu-phat-nguoi" target="_blank" rel="noopener">
                    <i class="bi bi-box-arrow-up-right"></i>
                    Mở cổng tra cứu CSGT
                </a>
            </div>
        </div>
    </section>
</div>
