@model CarRentalSystem.Controllers.OwnerCarCreateViewModel
@{
    ViewData["Title"] = "Đăng xe";
    var brands = ViewBag.Brands as IEnumerable<CarRentalSystem.Models.CarBrand> ?? Enumerable.Empty<CarRentalSystem.Models.CarBrand>();
    var serviceTypes = ViewBag.ServiceTypes as IEnumerable<CarRentalSystem.Models.ServiceType> ?? Enumerable.Empty<CarRentalSystem.Models.ServiceType>();
    var amenities = ViewBag.Amenities as IEnumerable<CarRentalSystem.Models.CarAmenity> ?? Enumerable.Empty<CarRentalSystem.Models.CarAmenity>();
    var initialStep = ViewBag.InitialStep is int step && step >= 1 && step <= 3 ? step : 1;
}

<div class="owner-portal owner-create-page">
    <section class="owner-create-hero">
        <div>
            <div class="owner-kicker">Partner onboarding</div>
            <h1>Đăng xe theo chuẩn cho thuê cao cấp</h1>
            <p>Hoàn thiện hồ sơ vận hành, đăng kiểm, vị trí và ảnh xe để admin duyệt nhanh hơn và khách thuê tin tưởng hơn.</p>
        </div>
        <div class="owner-create-hero-card">
            <span><i class="bi bi-shield-check"></i> Đăng kiểm bắt buộc</span>
            <span><i class="bi bi-images"></i> Tối thiểu 4 ảnh</span>
            <span><i class="bi bi-geo-alt"></i> Vị trí GPS rõ ràng</span>
        </div>
    </section>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="mioto-form owner-create-premium" id="ownerCarForm" novalidate>
    @Html.AntiForgeryToken()
    <div class="steps">
        <button type="button" class="step @(initialStep == 1 ? "active" : "")" data-step="1"><span>1</span>Thông tin</button>
        <button type="button" class="step @(initialStep == 2 ? "active" : "")" data-step="2"><span>2</span>Cho thuê</button>
        <button type="button" class="step @(initialStep == 3 ? "active" : "")" data-step="3"><span>3</span>Hình ảnh</button>
    </div>
    <div id="stepValidationSummary" class="step-validation-summary d-none" role="alert" aria-live="assertive"></div>

    <section class="panel step-panel @(initialStep == 1 ? "" : "d-none")" data-panel="1">
        <h2>Biển số xe</h2>
        <p class="note">Lưu ý: Biển số sẽ không thể thay đổi sau khi đăng ký.</p>
        <input asp-for="LicensePlate" class="input short" required />
        <span asp-validation-for="LicensePlate" class="field-error"></span>
        <span id="licensePlateLiveFeedback" class="field-error d-none"></span>
        <h2>Hạn đăng kiểm</h2>
        <p class="note">Xe phải còn hạn đăng kiểm để được duyệt và cho thuê.</p>
        <input asp-for="NextInspectionDate" type="date" class="input short" required />
        <span asp-validation-for="NextInspectionDate" class="field-error"></span>

        <h2>Thông tin cơ bản</h2>
        <p class="note">Lưu ý: Các thông tin cơ bản sẽ không thể thay đổi sau khi đăng ký.</p>
        <div class="grid-2">
            <label>Hãng xe
                <select asp-for="BrandID" id="brandSelect" required>
                    <option value="">Chọn hãng xe</option>
                    @foreach (var brand in brands)
                    {
                        <option value="@brand.BrandID">@brand.Name</option>
                    }
                </select>
            </label>
            <label>Mẫu xe
                <select asp-for="CarModelID" id="modelSelect" required>
                    <option value="">Chọn hãng xe trước</option>
                </select>
            </label>
            <label>Số ghế
                <select asp-for="Seats">
                    <option>4</option><option>5</option><option>7</option><option>9</option><option>16</option>
                </select>
            </label>
            <label>Năm sản xuất
                <select asp-for="ManufactureYear">
                    @for (var y = DateTime.UtcNow.Year; y >= 1990; y--) { <option value="@y">@y</option> }
                </select>
            </label>
            <label>Truyền động
                <select asp-for="Transmission"><option>Tự động</option><option>Số sàn</option></select>
            </label>
            <label>Nhiên liệu
                <select asp-for="FuelType"><option>Xăng</option><option>Dầu</option><option>Điện</option><option>Hybrid</option></select>
            </label>
        </div>
        <div class="ai-suggestion-card" id="aiSuggestionCard" aria-live="polite">
            <div class="ai-suggestion-head">
                <div>
                    <span class="ai-kicker">AI gợi ý</span>
                    <strong id="aiSuggestionTitle">Chọn hãng và mẫu xe để nhận gợi ý</strong>
                </div>
                <button type="button" class="ai-apply-btn" id="applyAiSpecs" disabled>
                    <i class="bi bi-stars"></i> Áp dụng thông số
                </button>
            </div>
            <p id="aiSuggestionText">Hệ thống sẽ đề xuất số ghế, nhiên liệu, truyền động, giá thuê và mô tả dựa trên mẫu xe bạn chọn.</p>
            <div class="ai-suggestion-grid">
                <span>Số ghế <strong id="aiSeats">--</strong></span>
                <span>Năm SX <select id="aiYearSelect" class="ai-year-select" disabled><option>--</option></select></span>
                <span>Nhiên liệu <strong id="aiFuel">--</strong></span>
                <span>Truyền động <strong id="aiTransmission">--</strong></span>
                <span>Giá/ngày <strong id="aiPrice">--</strong></span>
            </div>
            <div class="ai-suggestion-actions">
                <button type="button" class="ai-link-btn" id="applyAiPrice" disabled>Áp dụng giá</button>
                <button type="button" class="ai-link-btn" id="applyAiDescription" disabled>Viết mô tả</button>
            </div>
        </div>
        <h2>Mức tiêu thụ nhiên liệu</h2>
        <p class="muted">Số lít nhiên liệu cho quãng đường 100km.</p>
        <input asp-for="FuelConsumption" class="input short" placeholder="10" />
        <h2>Mô tả</h2>
        <textarea asp-for="Description" rows="4" placeholder="Mô tả tình trạng, trang bị, ưu điểm của xe..."></textarea>
        <h2>Tính năng</h2>
        <div class="amenities">
            @foreach (var amenity in amenities)
            {
                <label class="amenity">
                    <input type="checkbox" name="AmenityIDs" value="@amenity.CarAmenityID" />
                    <i class="bi @amenity.Icon"></i>
                    <span>@amenity.Name</span>
                </label>
            }
        </div>
    </section>

    <section class="panel step-panel @(initialStep == 2 ? "" : "d-none")" data-panel="2">
        <h2>Đơn giá thuê mặc định</h2>
        <p class="muted">Giá đề xuất: <span id="suggestedPrice">440K</span></p>
        <div class="money-row"><input asp-for="PricePerDay" type="number" min="100000" required /><span>đ/ngày</span></div>
        <div class="commission-explainer" id="commissionExplainer" aria-live="polite">
            <div>
                <span>Giá khách thấy</span>
                <strong id="customerPricePreview">440.000đ/ngày</strong>
            </div>
            <div>
                <span>Tiền cọc hệ thống giữ</span>
                <strong class="commission-fee" id="depositPreview">@((Model.PricePerDay * 0.2m).ToString("N0"))đ</strong>
            </div>
            <div>
                <span>Giá thuê chủ xe nhận</span>
                <strong class="commission-income" id="ownerIncomePreview">440.000đ/ngày</strong>
            </div>
            <p>
                <i class="bi bi-info-circle"></i>
                Đây là ước tính theo đơn giá một ngày. Giá thuê và tiền cọc được trình bày riêng để đối soát hoàn/khấu trừ khi trả xe.
            </p>
        </div>

        <h2>Loại dịch vụ</h2>
        <select asp-for="ServiceTypeID">
            @foreach (var serviceType in serviceTypes)
            {
                <option value="@serviceType.ServiceTypeID">@serviceType.Name</option>
            }
        </select>

        <h2>Kiểu hợp đồng</h2>
        <p class="muted">Nếu chọn hợp đồng số, bạn cần hoàn tất hồ sơ chữ ký số trong tab Hợp đồng & Chữ ký số trước.</p>
        <select asp-for="ContractSigningMode">
            <option value="@CarRentalSystem.Models.CarContractSigningModes.PhysicalSelfManaged">Hợp đồng giấy tự quản</option>
            <option value="@CarRentalSystem.Models.CarContractSigningModes.Digital">Hợp đồng số trên app</option>
        </select>
        <span asp-validation-for="ContractSigningMode" class="field-error"></span>

        <div class="toggle-row"><h2>Giảm giá thuê tuần</h2><input type="checkbox" checked /></div>
        <label>Giảm giá thuê tuần (% trên đơn giá)
            <input asp-for="WeeklyDiscountPercent" type="range" min="0" max="40" />
        </label>

        <h2>Địa chỉ xe</h2>
        <div class="address-row">
            <input asp-for="CarAddress" id="carAddressInput" placeholder="Địa chỉ mặc định để giao nhận xe." required />
            <button type="button" id="btnUseCurrentLocation"><i class="bi bi-crosshair"></i></button>
        </div>
        <span asp-validation-for="CarAddress" class="field-error"></span>
        <div id="ownerMapPicker" class="map-picker"></div>
        <div class="map-helper">
            <i class="bi bi-geo-alt"></i>
            Nhập địa chỉ hoặc chọn trực tiếp trên bản đồ. Vị trí bản đồ là bắt buộc để khách dễ tìm điểm giao nhận xe.
        </div>
        <div id="locationError" class="field-error d-none">Vui lòng nhập địa chỉ và chọn vị trí xe trên bản đồ.</div>
        <div class="grid-3">
            <input asp-for="CityOrProvince" placeholder="Tỉnh/Thành phố" />
            <input asp-for="District" placeholder="Quận/Huyện" />
            <input asp-for="Ward" placeholder="Phường/Xã" />
        </div>
        <input asp-for="Latitude" type="hidden" id="latInput" />
        <input asp-for="Longitude" type="hidden" id="lngInput" />
        <span asp-validation-for="Latitude" class="field-error"></span>

        <div class="toggle-row"><h2>Giao xe tận nơi</h2><input asp-for="DeliveryEnabled" type="checkbox" /></div>
        <div class="grid-3">
            <label>Quãng đường giao xe tối đa<input asp-for="MaxDeliveryDistanceKm" type="number" min="0" /></label>
            <label>Phí giao nhận mỗi km<input asp-for="DeliveryFeePerKm" type="number" min="0" /></label>
            <label>Miễn phí trong vòng<input asp-for="FreeDeliveryRadiusKm" type="number" min="0" /></label>
        </div>

        <div class="toggle-row"><h2>Giới hạn số km</h2><input asp-for="MileageLimitEnabled" type="checkbox" /></div>
        <div class="grid-2">
            <label>Số km tối đa trong 1 ngày<input asp-for="DailyMileageLimitKm" type="number" min="0" /></label>
            <label>Phí vượt giới hạn mỗi km<input asp-for="ExtraMileageFeePerKm" type="number" min="0" /></label>
        </div>

        <h2>Điều khoản thuê xe</h2>
        <textarea asp-for="RentalTerms" rows="4" placeholder="Ghi rõ các yêu cầu để khách có thể thuê xe."></textarea>
    </section>

    <section class="panel step-panel @(initialStep == 3 ? "" : "d-none")" data-panel="3">
        <h2>Hình ảnh xe</h2>
        <p class="note">Bắt buộc upload ít nhất 4 ảnh. Nên có ảnh trước, sau, hai bên và nội thất.</p>
        <label class="image-dropzone" id="imageDropzone" for="imageInput">
            <input asp-for="ImageFiles" type="file" accept="image/*" multiple required id="imageInput" />
            <span class="upload-icon"><i class="bi bi-cloud-arrow-up"></i></span>
            <strong>Chọn hoặc kéo thả ảnh xe</strong>
            <small>JPG, PNG, WEBP. Cần tối thiểu 4 ảnh rõ nét.</small>
            <span class="image-count" id="imageCount">0/4 ảnh bắt buộc</span>
        </label>
        <span asp-validation-for="ImageFiles" class="text-danger"></span>
        <div id="imagePreviewGrid" class="upload-preview-grid"></div>
    </section>

    <div class="form-actions">
        <button type="button" class="btn-back" id="btnBack" disabled>Quay lại</button>
        <button type="button" class="btn-next" id="btnNext">Kế tiếp</button>
        <button type="submit" class="btn-next d-none" id="btnSubmit">Gửi duyệt</button>
    </div>
</form>
</div>

<style>
    .owner-create-page {
        max-width: 1080px;
    }

    .owner-create-hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
        gap: 18px;
        align-items: stretch;
        margin-bottom: 18px;
        padding: 22px;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background:
            linear-gradient(90deg, rgba(15, 23, 42, .92), rgba(15, 23, 42, .68)),
            url('https://images.unsplash.com/photo-1542362567-b07e54358753?q=80&w=1600&auto=format&fit=crop') center/cover;
        color: #fff;
        box-shadow: 0 18px 44px rgba(15, 23, 42, .12);
    }

    .owner-create-hero h1 {
        color: #fff;
        margin: 0 0 8px;
        font-size: clamp(1.75rem, 3vw, 2.6rem);
        font-weight: 850;
        letter-spacing: 0;
    }

    .owner-create-hero p {
        max-width: 680px;
        margin: 0;
        color: rgba(255, 255, 255, .78);
        line-height: 1.65;
    }

    .owner-kicker {
        color: #93c5fd;
        font-size: .72rem;
        font-weight: 850;
        letter-spacing: .08em;
        text-transform: uppercase;
        margin-bottom: 8px;
    }

    .owner-create-hero-card {
        display: grid;
        gap: 10px;
        align-content: center;
        padding: 16px;
        border: 1px solid rgba(255, 255, 255, .18);
        border-radius: 8px;
        background: rgba(255, 255, 255, .12);
        backdrop-filter: blur(10px);
    }

    .owner-create-hero-card span {
        display: flex;
        align-items: center;
        gap: 8px;
        min-height: 38px;
        color: #fff;
        font-weight: 800;
    }

    .mioto-form {
        max-width: 1080px;
        margin: 0 auto;
        padding: 0 0 24px;
        background: transparent;
    }

    .steps {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 14px;
        padding: 0;
        background: transparent;
        border: 0;
    }

    .step {
        min-height: 74px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #fff;
        color: #667085;
        font-weight: 850;
        text-align: left;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .06);
    }

    .step span {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        margin: 0;
        border-radius: 8px;
        background: #eef3f8;
        color: #334155;
        font-weight: 900;
    }

    .step.active {
        border-color: #b8cef8;
        background: #eaf1ff;
        color: #1d4ed8;
    }

    .step.active span {
        background: #2563eb;
        color: #fff;
    }

    .panel {
        background: #fff;
        padding: clamp(22px, 4vw, 42px);
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .06);
    }

    .panel h2 {
        font-size: 1.15rem;
        font-weight: 850;
        letter-spacing: 0;
        margin: 26px 0 10px;
        color: #0f172a;
    }

    .panel h2:first-child {
        margin-top: 0;
    }

    .note,
    .muted {
        color: #667085;
        font-size: .9rem;
    }

    .input,
    select,
    textarea,
    input[type=number],
    input[type=text],
    input[type=date] {
        width: 100%;
        min-height: 44px;
        border: 1px solid #c8d3df;
        border-radius: 8px;
        padding: 11px 14px;
        background: #fff;
        color: #0f172a;
        box-shadow: none;
    }

    .input:focus,
    select:focus,
    textarea:focus,
    input[type=number]:focus,
    input[type=text]:focus,
    input[type=date]:focus {
        border-color: #2563eb;
        outline: none;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, .14);
    }

    .short {
        max-width: 360px;
    }

    .grid-2 {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .amenities {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
    }

    .amenity {
        min-height: 82px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #f8fbff;
        cursor: pointer;
        font-weight: 750;
    }

    .amenity input {
        display: none;
    }

    .amenity:has(input:checked) {
        border-color: #93c5fd;
        background: #eaf1ff;
        color: #1d4ed8;
    }

    .amenity i {
        font-size: 22px;
    }

    .ai-suggestion-card {
        margin-top: 18px;
        padding: 16px;
        border: 1px solid #bfdbfe;
        border-radius: 8px;
        background: #f8fbff;
    }

    .ai-suggestion-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        margin-bottom: 10px;
    }

    .ai-kicker {
        display: block;
        color: #2563eb;
        font-size: .72rem;
        font-weight: 850;
        letter-spacing: .08em;
        text-transform: uppercase;
    }

    .ai-suggestion-head strong {
        display: block;
        margin-top: 2px;
        color: #0f172a;
        font-size: 1rem;
    }

    .ai-suggestion-card p {
        margin: 0 0 12px;
        color: #475569;
        font-size: .9rem;
        line-height: 1.55;
    }

    .ai-suggestion-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 10px;
    }

    .ai-suggestion-grid span {
        min-width: 0;
        padding: 10px;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #fff;
        color: #64748b;
        font-size: .78rem;
        font-weight: 750;
    }

    .ai-suggestion-grid strong {
        display: block;
        margin-top: 4px;
        color: #0f172a;
        font-size: .98rem;
        overflow-wrap: anywhere;
    }

    .ai-year-select {
        width: 100%;
        min-height: 32px;
        margin-top: 4px;
        padding: 5px 8px;
        border-radius: 8px;
        font-size: .95rem;
        font-weight: 850;
    }

    .ai-suggestion-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 12px;
    }

    .ai-apply-btn,
    .ai-link-btn {
        min-height: 38px;
        border: 1px solid #2563eb;
        border-radius: 8px;
        padding: 8px 12px;
        background: #2563eb;
        color: #fff;
        font-weight: 850;
    }

    .ai-link-btn {
        background: #fff;
        color: #1d4ed8;
    }

    .ai-apply-btn:disabled,
    .ai-link-btn:disabled {
        border-color: #cbd5e1;
        background: #f1f5f9;
        color: #94a3b8;
        cursor: not-allowed;
    }

    .money-row,
    .address-row {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .money-row input {
        max-width: 240px;
    }

    .commission-explainer {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-top: 14px;
        padding: 14px;
        border: 1px solid #bfdbfe;
        border-radius: 8px;
        background: #f8fbff;
    }

    .commission-explainer > div {
        min-width: 0;
        padding: 12px;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #fff;
    }

    .commission-explainer span,
    .commission-explainer strong {
        display: block;
    }

    .commission-explainer span {
        color: #64748b;
        font-size: .78rem;
        font-weight: 750;
    }

    .commission-explainer strong {
        margin-top: 6px;
        color: #0f172a;
        font-size: 1rem;
        overflow-wrap: anywhere;
    }

    .commission-explainer .commission-fee {
        color: #b91c1c;
    }

    .commission-explainer .commission-income {
        color: #15803d;
    }

    .commission-explainer p {
        grid-column: 1 / -1;
        margin: 2px 0 0;
        color: #475569;
        font-size: .82rem;
    }

    .toggle-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        padding: 14px;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #f8fbff;
        margin: 18px 0 10px;
    }

    .address-row button {
        width: 52px;
        min-height: 44px;
        border: 1px solid #c8d3df;
        background: #fff;
        border-radius: 8px;
        color: #2563eb;
    }

    .form-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        padding: 18px 0 0;
    }

    .btn-back,
    .btn-next {
        min-height: 48px;
        border-radius: 8px;
        padding: 14px 16px;
        border: 1px solid #2563eb;
        font-weight: 850;
    }

    .btn-back {
        background: #fff;
        color: #2563eb;
    }

    .btn-back:disabled {
        border-color: #d9e2ec;
        color: #94a3b8;
    }

    .btn-next {
        background: #0f9f6e;
