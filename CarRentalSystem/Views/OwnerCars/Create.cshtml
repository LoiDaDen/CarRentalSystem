</style>

@section Scripts {
<script>
let currentStep = @initialStep;
const panels = document.querySelectorAll('.step-panel');
const steps = document.querySelectorAll('.step');
const btnBack = document.getElementById('btnBack');
const btnNext = document.getElementById('btnNext');
const btnSubmit = document.getElementById('btnSubmit');
const stepValidationSummary = document.getElementById('stepValidationSummary');
const ownerCarForm = document.getElementById('ownerCarForm');
const pricePerDayInput = document.getElementById('PricePerDay');
const licensePlateInput = document.getElementById('LicensePlate');
const licensePlateLiveFeedback = document.getElementById('licensePlateLiveFeedback');
const brandSelect = document.getElementById('brandSelect');
const modelSelect = document.getElementById('modelSelect');
const seatsSelect = document.getElementById('Seats');
const manufactureYearSelect = document.getElementById('ManufactureYear');
const transmissionSelect = document.getElementById('Transmission');
const fuelTypeSelect = document.getElementById('FuelType');
const descriptionInput = document.getElementById('Description');
const suggestedPrice = document.getElementById('suggestedPrice');
const aiSuggestionTitle = document.getElementById('aiSuggestionTitle');
const aiSuggestionText = document.getElementById('aiSuggestionText');
const aiSeats = document.getElementById('aiSeats');
const aiYearSelect = document.getElementById('aiYearSelect');
const aiFuel = document.getElementById('aiFuel');
const aiTransmission = document.getElementById('aiTransmission');
const aiPrice = document.getElementById('aiPrice');
const applyAiSpecs = document.getElementById('applyAiSpecs');
const applyAiPrice = document.getElementById('applyAiPrice');
const applyAiDescription = document.getElementById('applyAiDescription');
const initialCarModelId = '@(Model.CarModelID?.ToString() ?? "")';
let currentAiSuggestion = null;
let priceTouched = Boolean(pricePerDayInput?.value && Number(pricePerDayInput.value) !== 440000);
let licensePlateCheckTimer = null;
let licensePlateAbortController = null;
let licensePlateIsDuplicate = false;
const formatCurrency = value => `${new Intl.NumberFormat('vi-VN').format(Math.max(0, Math.round(value || 0)))}đ`;
const normalizePlateForClient = value => (value || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
const normalizeText = value => (value || '')
    .toString()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase();

function selectedText(select){
    return select?.selectedOptions?.[0]?.textContent?.trim() || '';
}

function setSelectValue(select, value){
    if(!select || value === null || value === undefined || value === '') return;
    const wanted = normalizeText(value);
    const option = [...select.options].find(item =>
        normalizeText(item.value) === wanted || normalizeText(item.textContent) === wanted);
    if(option){
        select.value = option.value;
        select.dispatchEvent(new Event('change'));
    }
}

function roundToStep(value, step){
    return Math.round(value / step) * step;
}

function inferSeats(modelName){
    const key = normalizeText(modelName);
    if(/transit|sprinter|solati|hiace|coaster|county/.test(key)) return 16;
    if(/limousine|starex|caravelle|tourneo/.test(key)) return 9;
    if(/innova|fortuner|everest|xpander|ertiga|xl7|avanza|rush|santa fe|sorento|carnival|land cruiser|pajero|mux|mu-x|cr-v|crv|outlander|x-trail|trailblazer|explorer|cx-8|cx8|tang/.test(key)) return 7;
    if(/morning|i10|spark|wigo|fadil|fortwo/.test(key)) return 4;
    return 5;
}

function normalizeFuel(value, brandName, modelName){
    const key = `${normalizeText(value)} ${normalizeText(brandName)} ${normalizeText(modelName)}`;
    if(/hybrid|phev|hev/.test(key)) return 'Hybrid';
    if(/electric|ev|tesla|byd|dolphin|atto|seal|han|marvel/.test(key)) return 'Điện';
    if(/diesel|dau|d-max|qkr|transit|everest|fortuner|pajero|hiace|solati|sprinter/.test(key)) return 'Dầu';
    return 'Xăng';
}

function normalizeTransmission(value, modelName){
    const key = `${normalizeText(value)} ${normalizeText(modelName)}`;
    if(/manual|so san|carry|qkr/.test(key)) return 'Số sàn';
    return 'Tự động';
}

function getSuggestedYearRange(option){
    const currentYear = new Date().getFullYear();
    let fromYear = Number(option?.dataset?.fromYear || 0);
    let toYear = Number(option?.dataset?.toYear || 0);
    if(!fromYear) fromYear = currentYear - 12;
    if(!toYear) toYear = currentYear;
    fromYear = Math.max(1990, Math.min(fromYear, currentYear));
    toYear = Math.max(fromYear, Math.min(toYear, currentYear));
    return { fromYear, toYear };
}

function buildSuggestedYears(range){
    const years = [];
    for(let year = range.toYear; year >= range.fromYear; year--){
        years.push(year);
    }
    return years;
}

function clampYear(year, years){
    if(!years.length) return new Date().getFullYear();
    if(years.includes(year)) return year;
    return years[0];
}

function calculateSuggestedPrice(brandName, modelName, seats, fuelType, manufactureYear){
    const seatBase = { 4: 450000, 5: 560000, 7: 780000, 9: 1050000, 16: 1450000 };
    const brandKey = normalizeText(brandName);
    const modelKey = normalizeText(modelName);
    const brandFactor =
        /porsche|mercedes|land rover/.test(brandKey) ? 2.1 :
        /bmw|audi|lexus|tesla|volvo/.test(brandKey) ? 1.65 :
        /subaru|volkswagen|peugeot|byd|mini/.test(brandKey) ? 1.12 :
        /toyota|honda|mazda/.test(brandKey) ? 1.02 :
        /kia|hyundai|mitsubishi|suzuki|nissan|mg/.test(brandKey) ? .96 :
        1;
    const modelFactor =
        /s-class|7 series|a8|panamera|rangerover|range rover|model s|model x/.test(modelKey) ? 1.55 :
        /e-class|5 series|a6|rx|gle|x5|q7|land cruiser|carnival|model y/.test(modelKey) ? 1.28 :
        /camry|accord|cx-8|cx8|santa fe|sorento|everest|fortuner|legacy|outback|model 3|seal/.test(modelKey) ? 1.1 :
        /morning|i10|spark|wigo|fadil/.test(modelKey) ? .82 :
        1;
    const year = Number(manufactureYear) || new Date().getFullYear();
    const age = Math.max(0, new Date().getFullYear() - year);
    const ageFactor = age <= 1 ? 1.14 : age <= 3 ? 1.06 : age <= 6 ? 1 : age <= 10 ? .88 : .74;
    const fuelFactor = fuelType === 'Điện' ? 1.12 : fuelType === 'Hybrid' ? 1.08 : 1;
    return Math.min(3500000, Math.max(300000, roundToStep((seatBase[seats] || 560000) * brandFactor * modelFactor * ageFactor * fuelFactor, 10000)));
}

function buildAiDescription(suggestion){
    const useCase = suggestion.seats >= 7
        ? 'phù hợp gia đình, nhóm bạn hoặc chuyến đi nhiều hành lý'
        : 'phù hợp di chuyển trong phố, công tác hoặc du lịch ngắn ngày';
    return `${suggestion.brandName} ${suggestion.modelName} ${suggestion.manufactureYear}, ${suggestion.seats} chỗ, ${suggestion.transmission.toLowerCase()}, nhiên liệu ${suggestion.fuelType.toLowerCase()}. Xe được giữ sạch, vận hành ổn định, ${useCase}. Chủ xe hỗ trợ giao nhận đúng hẹn và kiểm tra xe rõ ràng trước mỗi chuyến.`;
}

function buildAiSuggestion(){
    const option = modelSelect?.selectedOptions?.[0];
    if(!option || !option.value) return null;

    const brandName = selectedText(brandSelect);
    const modelName = option.textContent.trim();
    const seats = Number(option.dataset.seats) || inferSeats(modelName);
    const fuelType = normalizeFuel(option.dataset.fuel, brandName, modelName);
    const transmission = normalizeTransmission(option.dataset.transmission, modelName);
    const suggestedYears = buildSuggestedYears(getSuggestedYearRange(option));
    const manufactureYear = clampYear(Number(manufactureYearSelect?.value) || new Date().getFullYear(), suggestedYears);
    const price = calculateSuggestedPrice(brandName, modelName, seats, fuelType, manufactureYear);

    return {
        brandName,
        modelName,
        seats,
        suggestedYears,
        fuelType,
        transmission,
        manufactureYear,
        price,
        description: buildAiDescription({ brandName, modelName, seats, fuelType, transmission, manufactureYear })
    };
}

function renderAiSuggestion(){
    currentAiSuggestion = buildAiSuggestion();
    const enabled = Boolean(currentAiSuggestion);
    applyAiSpecs.disabled = !enabled;
    applyAiPrice.disabled = !enabled;
    applyAiDescription.disabled = !enabled;

    if(!enabled){
        aiSuggestionTitle.textContent = 'Chọn hãng và mẫu xe để nhận gợi ý';
        aiSuggestionText.textContent = 'Hệ thống sẽ đề xuất số ghế, nhiên liệu, truyền động, giá thuê và mô tả dựa trên mẫu xe bạn chọn.';
        aiSeats.textContent = '--';
        aiYearSelect.innerHTML = '<option>--</option>';
        aiYearSelect.disabled = true;
        aiFuel.textContent = '--';
        aiTransmission.textContent = '--';
        aiPrice.textContent = '--';
        suggestedPrice.textContent = '440K';
        return;
    }

    aiSuggestionTitle.textContent = `${currentAiSuggestion.brandName} ${currentAiSuggestion.modelName}`;
    aiSuggestionText.textContent = 'Gợi ý này dùng dữ liệu catalog và luật định giá nội bộ, bạn vẫn có thể chỉnh lại trước khi gửi duyệt.';
    aiSeats.textContent = `${currentAiSuggestion.seats} chỗ`;
    aiYearSelect.disabled = false;
    aiYearSelect.innerHTML = currentAiSuggestion.suggestedYears
        .map(year => `<option value="${year}">${year}</option>`)
        .join('');
    aiYearSelect.value = currentAiSuggestion.manufactureYear;
    aiFuel.textContent = currentAiSuggestion.fuelType;
    aiTransmission.textContent = currentAiSuggestion.transmission;
    aiPrice.textContent = `${formatCurrency(currentAiSuggestion.price)}/ngày`;
    suggestedPrice.textContent = `${Math.round(currentAiSuggestion.price / 1000)}K`;

    if(!priceTouched || !pricePerDayInput.value || Number(pricePerDayInput.value) === 440000){
        applySuggestedPrice();
    }
}

function applySuggestedSpecs(){
    if(!currentAiSuggestion) return;
    setSelectValue(seatsSelect, currentAiSuggestion.seats);
    setSelectValue(manufactureYearSelect, currentAiSuggestion.manufactureYear);
    setSelectValue(fuelTypeSelect, currentAiSuggestion.fuelType);
    setSelectValue(transmissionSelect, currentAiSuggestion.transmission);
}

function applySuggestedPrice(){
    if(!currentAiSuggestion || !pricePerDayInput) return;
    pricePerDayInput.value = currentAiSuggestion.price;
    updateCommissionPreview();
}

function applySuggestedDescription(){
    if(!currentAiSuggestion || !descriptionInput) return;
    if(!descriptionInput.value.trim() || confirm('Mô tả hiện tại sẽ được thay bằng mô tả AI gợi ý. Tiếp tục?')){
        descriptionInput.value = currentAiSuggestion.description;
    }
}

async function loadModels(brandId, selectedModelId = ''){
    if(!brandId){
        modelSelect.innerHTML = '<option value="">Chọn hãng xe trước</option>';
        renderAiSuggestion();
        return;
    }

    modelSelect.innerHTML = '<option value="">Đang tải...</option>';
    try {
        const res = await fetch(`/CarCatalog/Models?brandId=${encodeURIComponent(brandId)}`);
        if(!res.ok) throw new Error('Cannot load models');
        const models = await res.json();
        modelSelect.innerHTML = '<option value="">Chọn mẫu xe</option>' + models.map(m=>`<option value="${m.id}" data-seats="${m.seatCount||''}" data-fuel="${m.fuelType||''}" data-transmission="${m.transmission||''}" data-from-year="${m.fromYear||''}" data-to-year="${m.toYear||''}">${m.name}</option>`).join('');
        if(selectedModelId){
            modelSelect.value = selectedModelId;
        }
    } catch {
        modelSelect.innerHTML = '<option value="">Không tải được mẫu xe</option>';
    }
    renderAiSuggestion();
}

function updateCommissionPreview(){
    const price = Number(pricePerDayInput?.value || 0);
    const deposit = Math.round(price * 0.2);
    const ownerIncome = price;
    document.getElementById('customerPricePreview').textContent = `${formatCurrency(price)}/ngày`;
    document.getElementById('depositPreview').textContent = `${formatCurrency(deposit)}`;
    document.getElementById('ownerIncomePreview').textContent = `${formatCurrency(ownerIncome)}/ngày`;
}

pricePerDayInput?.addEventListener('input', ()=>{
    priceTouched = true;
    updateCommissionPreview();
});

const validationLabels = {
    LicensePlate: 'biển số xe',
    NextInspectionDate: 'hạn đăng kiểm',
    BrandID: 'hãng xe',
    CarModelID: 'mẫu xe',
    PricePerDay: 'đơn giá thuê',
    CarAddress: 'địa chỉ xe',
    ImageFiles: 'ảnh xe'
};

function getValidationKey(field){
    return field?.getAttribute('name') || field?.id || '';
}

function getValidationLabel(field){
    return validationLabels[getValidationKey(field)] || 'thông tin này';
}

function getValidationMessageElement(field){
    const key = getValidationKey(field);
    if(!key) return null;

    let element = document.querySelector(`[data-valmsg-for="${key}"], [data-client-valmsg-for="${key}"]`);
    if(element) return element;

    element = document.createElement('span');
    element.className = 'field-error d-none';
    element.dataset.clientValmsgFor = key;

    const label = field.closest('label');
    if(label && label.contains(field)){
        label.appendChild(element);
        return element;
    }

    const row = field.closest('.money-row, .address-row, .image-dropzone');
    if(row){
        row.insertAdjacentElement('afterend', element);
        return element;
    }

    field.insertAdjacentElement('afterend', element);
    return element;
}

function setFieldError(field, message){
    if(!field) return;
    const text = message || '';
    field.setCustomValidity(text);
    field.classList.toggle('is-invalid', Boolean(text));
    const messageElement = getValidationMessageElement(field);
    if(messageElement){
        messageElement.textContent = text;
        messageElement.classList.add('field-error');
        messageElement.classList.toggle('d-none', !text);
    }
}

function getFieldErrorMessage(field){
    const label = getValidationLabel(field);
    const value = field.type === 'file' ? field.files?.length : field.value?.trim();

    if(field.required && !value){
        return field.tagName === 'SELECT'
            ? `Vui lòng chọn ${label}.`
            : `Vui lòng nhập ${label}.`;
    }

    if(field.type === 'number' && value && field.min !== '' && Number(value) < Number(field.min)){
        const minText = field.name === 'PricePerDay' ? formatCurrency(Number(field.min)) : field.min;
        return `${label.charAt(0).toUpperCase()}${label.slice(1)} phải từ ${minText} trở lên.`;
    }

    field.setCustomValidity('');
    if(!field.validity.valid){
        return field.validationMessage || `Vui lòng kiểm tra ${label}.`;
    }

    return '';
}

function validateField(field, showMessage = true){
    if(!field || field.disabled) return true;
    const message = getFieldErrorMessage(field);
    if(showMessage || !message){
        setFieldError(field, message);
    }
    return !message;
}

function validatePanelFields(step, showMessage = true){
    const panel = document.querySelector(`.step-panel[data-panel="${step}"]`);
    const fields = [...(panel?.querySelectorAll('input[required], select[required], textarea[required]') || [])]
        .filter(field => field.type !== 'file');
    const messages = [];
    let firstInvalid = null;

    fields.forEach(field => {
        if(!validateField(field, showMessage)){
            firstInvalid ??= field;
            messages.push(getFieldErrorMessage(field));
        }
    });

    return {
        valid: messages.length === 0,
        firstInvalid,
        message: messages[0] || ''
    };
}

function showValidationSummary(message){
    if(!stepValidationSummary) return;
    stepValidationSummary.textContent = message || '';
    stepValidationSummary.classList.toggle('d-none', !message);
}

function focusFirstInvalid(step, fallback){
    const panel = document.querySelector(`.step-panel[data-panel="${step}"]`);
    const firstInvalid = fallback || panel?.querySelector('.is-invalid, input:invalid, select:invalid, textarea:invalid');
    if(firstInvalid && typeof firstInvalid.focus === 'function'){
        firstInvalid.focus({ preventScroll: true });
        firstInvalid.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } else if(stepValidationSummary && !stepValidationSummary.classList.contains('d-none')){
        stepValidationSummary.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
}

function setLicensePlateFeedback(type, message){
    if(!licensePlateLiveFeedback) return;
    licensePlateLiveFeedback.textContent = message || '';
    licensePlateLiveFeedback.classList.toggle('d-none', !message);
    licensePlateLiveFeedback.classList.toggle('field-ok', type === 'ok');
    licensePlateLiveFeedback.classList.toggle('field-error', type === 'error');
    licensePlateLiveFeedback.classList.toggle('field-hint', type !== 'ok' && type !== 'error');
    licensePlateInput?.classList.toggle('is-invalid', type === 'error');
    licensePlateInput?.setAttribute('aria-invalid', type === 'error' ? 'true' : 'false');
}

async function checkLicensePlateNow(showBlockingError = false){
    const value = licensePlateInput?.value?.trim() || '';
    const normalizedValue = normalizePlateForClient(value);
    licensePlateIsDuplicate = false;
    if(!value){
        setLicensePlateFeedback('', '');
        if(showBlockingError){
            setFieldError(licensePlateInput, 'Vui lòng nhập biển số xe.');
        }
        return false;
    }
    if(normalizedValue.length < 5){
        const message = 'Nhập tiếp biển số để hệ thống kiểm tra trùng.';
        setLicensePlateFeedback(showBlockingError ? 'error' : '', message);
        if(showBlockingError){
            setFieldError(licensePlateInput, message);
        }
        return false;
    }

    const requestPlate = normalizedValue;
    if(licensePlateAbortController){
        licensePlateAbortController.abort();
    }
    licensePlateAbortController = new AbortController();
    setLicensePlateFeedback('', 'Đang kiểm tra biển số...');
    try {
        const res = await fetch(`/OwnerCars/CheckLicensePlate?licensePlate=${encodeURIComponent(value)}`, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            signal: licensePlateAbortController.signal
        });
        if(!res.ok) throw new Error('Cannot check license plate');
        const data = await res.json();
        if(normalizePlateForClient(licensePlateInput?.value?.trim() || '') !== requestPlate){
            return true;
        }
        licensePlateIsDuplicate = Boolean(data.exists);
        const message = data.message || '';
        setLicensePlateFeedback(licensePlateIsDuplicate ? 'error' : 'ok', message);
        setFieldError(licensePlateInput, licensePlateIsDuplicate ? message : '');
        return !licensePlateIsDuplicate;
    } catch (error) {
        if(error?.name === 'AbortError'){
            return true;
        }
        setLicensePlateFeedback('error', 'Chưa kiểm tra được biển số. Hệ thống vẫn sẽ kiểm tra lại khi gửi duyệt.');
        return true;
    }
}

licensePlateInput?.addEventListener('input', ()=>{
    licensePlateIsDuplicate = false;
    setFieldError(licensePlateInput, '');
    clearTimeout(licensePlateCheckTimer);
    const normalizedValue = normalizePlateForClient(licensePlateInput.value);
    if(!licensePlateInput.value.trim()){
        setLicensePlateFeedback('', '');
    } else if(normalizedValue.length < 5){
        setLicensePlateFeedback('', 'Nhập tiếp biển số để hệ thống kiểm tra trùng.');
    } else {
        setLicensePlateFeedback('', 'Đang kiểm tra biển số...');
    }
    licensePlateCheckTimer = setTimeout(checkLicensePlateNow, 150);
});

licensePlateInput?.addEventListener('blur', ()=>{
    clearTimeout(licensePlateCheckTimer);
    checkLicensePlateNow();
});

document.querySelectorAll('#ownerCarForm input, #ownerCarForm select, #ownerCarForm textarea').forEach(field => {
    if(field.type === 'hidden' || field.type === 'file') return;
    const clearIfValid = () => {
        showValidationSummary('');
        if(field.id === 'carAddressInput'){
            validateLocation(false);
            return;
        }
        validateField(field, false);
    };
    field.addEventListener('input', clearIfValid);
    field.addEventListener('change', clearIfValid);
});

function showStep(step){
    currentStep = step;
    panels.forEach(p=>p.classList.toggle('d-none', p.dataset.panel != step));
    steps.forEach(s=>s.classList.toggle('active', s.dataset.step == step));
    btnBack.disabled = step === 1;
    btnNext.classList.toggle('d-none', step === 3);
    btnSubmit.classList.toggle('d-none', step !== 3);
}
btnBack.addEventListener('click',()=>{
    showValidationSummary('');
    showStep(Math.max(1,currentStep-1));
});
btnNext.addEventListener('click', async ()=>{
    await goToStep(Math.min(3,currentStep+1));
});
steps.forEach(s=>s.addEventListener('click', async ()=>{
    await goToStep(Number(s.dataset.step));
}));

brandSelect.addEventListener('change', function(){
    loadModels(this.value);
});

modelSelect.addEventListener('change', ()=>{
    renderAiSuggestion();
    applySuggestedSpecs();
});

manufactureYearSelect?.addEventListener('change', renderAiSuggestion);
aiYearSelect?.addEventListener('change', ()=>{
    setSelectValue(manufactureYearSelect, aiYearSelect.value);
    renderAiSuggestion();
});
applyAiSpecs?.addEventListener('click', applySuggestedSpecs);
applyAiPrice?.addEventListener('click', ()=>{
    priceTouched = false;
    applySuggestedPrice();
});
applyAiDescription?.addEventListener('click', applySuggestedDescription);

function validateLocation(showMessage){
    const addressInput = document.getElementById('carAddressInput');
    const latInput = document.getElementById('latInput');
    const lngInput = document.getElementById('lngInput');
    const locationError = document.getElementById('locationError');
    const isValid = Boolean(addressInput.value.trim() && latInput.value && lngInput.value);
    const message = 'Vui lòng nhập địa chỉ và chọn vị trí xe trên bản đồ.';
    if(locationError){
        locationError.classList.toggle('d-none', isValid || !showMessage);
    }
    addressInput.classList.toggle('is-invalid', !isValid && showMessage);
    if(showMessage || isValid){
        setFieldError(addressInput, isValid ? '' : message);
    }
    return isValid;
}

function validateImages(showMessage){
    const count = imageInput?.files?.length || 0;
    const isValid = count >= 4;
    const message = `Vui lòng upload tối thiểu 4 ảnh xe. Hiện tại mới có ${count}/4 ảnh.`;
    imageDropzone?.classList.toggle('is-invalid', !isValid && showMessage);
    if(showMessage || isValid){
        setFieldError(imageInput, isValid ? '' : message);
    }
    return isValid;
}

async function validateStep(step, showMessage = true){
    showValidationSummary('');
    const fieldsResult = validatePanelFields(step, showMessage);

    if(step === 1){
        if(!fieldsResult.valid){
            if(showMessage) showValidationSummary(fieldsResult.message);
            focusFirstInvalid(step, fieldsResult.firstInvalid);
            return false;
        }

        if(!(await checkLicensePlateNow(showMessage))){
            if(showMessage) showValidationSummary('Vui lòng kiểm tra lại biển số xe trước khi qua bước tiếp theo.');
            focusFirstInvalid(step, licensePlateInput);
            return false;
        }

        return true;
    }

    if(step === 2){
        const locationValid = validateLocation(showMessage);
        if(!fieldsResult.valid || !locationValid){
            if(showMessage){
                showValidationSummary(fieldsResult.message || 'Vui lòng nhập địa chỉ và chọn vị trí xe trên bản đồ.');
            }
            focusFirstInvalid(step, fieldsResult.firstInvalid || document.getElementById('carAddressInput'));
            return false;
        }

        return true;
    }

    if(step === 3){
        if(!validateImages(showMessage)){
            if(showMessage) showValidationSummary('Vui lòng upload tối thiểu 4 ảnh xe trước khi gửi duyệt.');
            focusFirstInvalid(step, imageDropzone);
            return false;
        }

        return true;
    }

    return true;
}

async function goToStep(targetStep){
    if(targetStep <= currentStep){
        showValidationSummary('');
        showStep(targetStep);
        return;
    }

    while(currentStep < targetStep){
        if(!(await validateStep(currentStep, true))){
            return;
        }
        showStep(currentStep + 1);
    }
}

document.addEventListener('DOMContentLoaded', function(){
    const latInput = document.getElementById('latInput');
    const lngInput = document.getElementById('lngInput');
    const hasInitialCoords = Boolean(latInput.value && lngInput.value);

    if(typeof SmartMap !== 'undefined'){
        const picker = SmartMap.initPickerMap({
            containerId: 'ownerMapPicker',
            btnLocationId: 'btnUseCurrentLocation',
            latInputId: 'latInput',
            lngInputId: 'lngInput',
            addressInputId: 'carAddressInput'
        });

        if(picker && !hasInitialCoords){
            latInput.value = '';
            lngInput.value = '';
        }
    }
});
const imageInput = document.getElementById('imageInput');
const imageDropzone = document.getElementById('imageDropzone');
const imagePreviewGrid = document.getElementById('imagePreviewGrid');
const imageCount = document.getElementById('imageCount');
let selectedImageFiles = [];

function fileKey(file){
    return `${file.name}-${file.size}-${file.lastModified}`;
}

function syncImageInput(){
    const transfer = new DataTransfer();
    selectedImageFiles.forEach(file => transfer.items.add(file));
    imageInput.files = transfer.files;
}

function renderImagePreviews(){
    imagePreviewGrid.innerHTML = '';
    selectedImageFiles.forEach((file, index)=>{
        const card = document.createElement('div');
        card.className = 'upload-preview-card';
        card.innerHTML = `
            <button type="button" class="remove-image" aria-label="Xóa ảnh" data-index="${index}">
                <i class="bi bi-x-lg"></i>
            </button>
            <img src="${URL.createObjectURL(file)}" alt="${file.name}">
            <div class="file-name" title="${file.name}">${file.name}</div>`;
        imagePreviewGrid.appendChild(card);
    });
    imageCount.textContent = `${selectedImageFiles.length}/4 ảnh bắt buộc`;
    imageCount.style.color = selectedImageFiles.length >= 4 ? '#15803d' : '#b91c1c';
    validateImages(false);
}

function addImageFiles(files){
    const existing = new Set(selectedImageFiles.map(fileKey));
    [...files].forEach(file=>{
        if(file.type.startsWith('image/') && !existing.has(fileKey(file))){
            selectedImageFiles.push(file);
            existing.add(fileKey(file));
        }
    });
    syncImageInput();
    renderImagePreviews();
}

imageInput.addEventListener('change', function(){
    addImageFiles(this.files);
});

imagePreviewGrid.addEventListener('click', function(e){
    const button = e.target.closest('.remove-image');
    if(!button) return;
    selectedImageFiles.splice(Number(button.dataset.index), 1);
    syncImageInput();
    renderImagePreviews();
});

['dragenter','dragover'].forEach(eventName=>{
    imageDropzone.addEventListener(eventName, function(e){
        e.preventDefault();
        imageDropzone.classList.add('drag-over');
    });
});
['dragleave','drop'].forEach(eventName=>{
    imageDropzone.addEventListener(eventName, function(e){
        e.preventDefault();
        imageDropzone.classList.remove('drag-over');
    });
});
imageDropzone.addEventListener('drop', function(e){
    addImageFiles(e.dataTransfer.files);
});

let ownerCarFormSubmitting = false;
ownerCarForm.addEventListener('submit', async function(e){
    if(ownerCarFormSubmitting) return;
    e.preventDefault();

    for(let step = 1; step <= 3; step++){
        showStep(step);
        if(!(await validateStep(step, true))){
            return;
        }
    }

    ownerCarFormSubmitting = true;
    showValidationSummary('');
    this.submit();
});

if(brandSelect?.value){
    loadModels(brandSelect.value, initialCarModelId).then(()=>{
        if(modelSelect.value){
            applySuggestedSpecs();
        }
    });
} else {
    renderAiSuggestion();
}
showStep(currentStep);
renderImagePreviews();
updateCommissionPreview();
if(licensePlateInput?.value?.trim()){
    checkLicensePlateNow();
}
</script>
}
