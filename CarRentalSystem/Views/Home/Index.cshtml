@model IEnumerable<CarRentalSystem.Models.Car>
@{ ViewData["Title"] = "CarRental - Thuê Xe Tự Lái 24/7"; }

<style>
    .home-hero {
        background: linear-gradient(135deg, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.85) 100%),
                    url('https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?q=80&w=2070&auto=format&fit=crop')
                    no-repeat center center;
        background-size: cover;
        padding: 100px 0 80px;
        position: relative;
    }
    .home-hero h1 {
        font-size: 2.8rem;
        font-weight: 800;
        text-shadow: 2px 2px 12px rgba(0,0,0,0.7);
        letter-spacing: -0.5px;
        color: #ffffff !important;
    }
    .home-hero .hero-subtitle {
        font-size: 1.1rem;
        color: rgba(255,255,255,0.95);
        text-shadow: 1px 1px 6px rgba(0,0,0,0.6);
        font-weight: 500;
        max-width: 600px;
        margin: 0 auto;
        line-height: 1.6;
    }
    .home-hero .hero-subtitle strong {
        color: #4ade80;
        font-weight: 700;
    }
    .home-search {
        background: rgba(255,255,255,0.98);
        backdrop-filter: blur(10px);
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.15);
        margin-top: 30px;
        border: 1px solid rgba(255,255,255,0.3);
    }
    .home-input {
        border: none;
        border-bottom: 2px solid #e5e7eb;
        border-radius: 0;
        padding-left: 12px;
        font-weight: 500;
        box-shadow: none !important;
        background: transparent;
        font-size: 0.95rem;
    }
    .home-input:focus {
        border-bottom-color: #10b981;
        background: transparent;
        box-shadow: none !important;
    }
    .home-label { font-size: 0.85rem; color: #6c757d; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 2px; }
    .home-car-card { border-radius: 16px; transition: transform 0.3s ease, box-shadow 0.3s ease; border: 1px solid #f0f0f0; }
    .home-car-card:hover { transform: translateY(-5px); box-shadow: 0 15px 30px rgba(0,0,0,0.1); }
    .home-btn-search { border-radius: 12px; font-weight: 700; letter-spacing: 1px; }
    .badges-top { position: absolute; top: 10px; left: 10px; z-index: 2; }
    .price-tag { font-size: 1.25rem; font-weight: 800; color: #0d6efd; }
</style>
</style>

<div class="page-home">
<section class="home-hero text-white mb-5 ui-hero-banner">
    <div class="container text-center position-relative">
        <div class="hero-banner-content">
            <h1 class="display-3 fw-bolder mb-3 hero-title">Ứng dụng đặt xe thông minh 24/7</h1>
            <p class="lead mb-4 hero-subtitle">
                <strong>Giá chỉ từ 400K</strong>. Thuê xe linh hoạt 4h, 8h, 24h.
                <br>Cam kết xe đời mới, sạch sẽ, an toàn.
            </p>
        </div>

        <div class="home-search text-start mx-auto ui-search-panel home-search-panel">
            <!-- Tabs -->
            <ul class="nav nav-pills mb-3 justify-content-center gap-2" id="rentalTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active d-flex align-items-center gap-2 px-4 py-2 rounded-pill fw-bold tab-btn-primary" id="self-drive-tab" data-bs-toggle="tab" data-bs-target="#selfDrivePane" type="button" role="tab">
                        <i class="bi bi-car-front-fill"></i> Thuê xe tự lái
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link d-flex align-items-center gap-2 px-4 py-2 rounded-pill fw-bold tab-btn-secondary" id="monthly-tab" data-bs-toggle="tab" data-bs-target="#monthlyPane" type="button" role="tab">
                        <i class="bi bi-calendar-month"></i> Thuê xe theo tháng
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Tab 1: Self-Drive -->
                <div class="tab-pane fade show active" id="selfDrivePane" role="tabpanel">
                    <form asp-controller="Car" asp-action="Index" method="get" class="row g-3 align-items-end">
                        <div class="col-md-3">
                            <label class="home-label fw-bold"><i class="bi bi-geo-alt-fill text-primary"></i> Địa điểm nhận xe</label>
                            <select class="form-select home-input" name="location">
                                <option value="">Tất cả khu vực</option>
                                @if (ViewBag.Locations != null) {
                                    foreach (var loc in ViewBag.Locations) {
                                        <option value="@loc.Name">@loc.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="home-label fw-bold"><i class="bi bi-calendar-range text-primary"></i> Lịch thuê xe</label>
                            <div class="form-control home-input d-flex align-items-center justify-content-between" onclick="openCarCalendar({startInputId: 'heroStartDate', endInputId: 'heroEndDate', defaultStart: document.getElementById('heroStartDate').value, defaultEnd: document.getElementById('heroEndDate').value})" style="cursor: pointer; min-height: 48px;">
                                <span id="heroCalendarDisplay" data-calendar-display class="fw-bold text-dark">Chọn thời gian...</span>
                                <i class="bi bi-pencil-square text-muted"></i>
                            </div>
                            <input type="hidden" name="startDate" id="heroStartDate" required>
                            <input type="hidden" name="endDate" id="heroEndDate" required>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-success w-100 home-btn-search py-3 fs-5">TÌM XE</button>
                        </div>
                    </form>
                </div>

                <!-- Tab 2: Monthly Rental -->
                <div class="tab-pane fade" id="monthlyPane" role="tabpanel">
                    <form asp-controller="Car" asp-action="Index" method="get" class="row g-3 align-items-end">
                        <input type="hidden" name="rentalType" value="monthly" />
                        <div class="col-md-3">
                            <label class="home-label fw-bold"><i class="bi bi-geo-alt-fill text-primary"></i> Địa điểm nhận xe</label>
                            <select class="form-select home-input" name="location">
                                @if (ViewBag.Locations != null) {
                                    foreach (var loc in ViewBag.Locations) {
                                        <option value="@loc.Name">@loc.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="home-label fw-bold"><i class="bi bi-box text-primary"></i> Gói thuê</label>
                            <select class="form-select home-input" name="monthlyPackage">
                                <option value="1">1 tháng</option>
                                <option value="3">3 tháng</option>
                                <option value="6">6 tháng</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="home-label fw-bold"><i class="bi bi-clock text-primary"></i> Thời gian nhận xe</label>
                            <select class="form-select home-input" name="pickupTimeframe">
                                <option value="7">7 ngày tới</option>
                                <option value="14">14 ngày tới</option>
                                <option value="30">1 tháng tới</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <button type="submit" class="btn btn-success w-100 home-btn-search py-3 fs-5">XÁC NHẬN</button>
                        </div>
                        <div class="col-12 text-center">
                            <span class="badge bg-danger bg-opacity-75 px-3 py-2 rounded-pill">
                                <i class="bi bi-piggy-bank me-1"></i> Tiết kiệm 15% so với thuê ngày
                            </span>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
document.addEventListener('DOMContentLoaded', function() {
    var now = new Date(); var start = new Date(now.getTime() + 2 * 60 * 60 * 1000);
    var mins = start.getMinutes();
    if (mins > 0 && mins <= 30) start.setMinutes(30, 0, 0);
    else if (mins > 30) { start.setHours(start.getHours() + 1); start.setMinutes(0, 0, 0); }
    else start.setMinutes(0, 0, 0);
    var end = new Date(start.getTime() + 4 * 60 * 60 * 1000);
    function fmtDT(d) { return d.getFullYear() + '-' + String(d.getMonth()+1).padStart(2,'0') + '-' + String(d.getDate()).padStart(2,'0') + 'T' + String(d.getHours()).padStart(2,'0') + ':' + String(d.getMinutes()).padStart(2,'0'); }
    var s = document.getElementById('heroStartDate'); var e = document.getElementById('heroEndDate');
    if (s) s.value = fmtDT(start); if (e) e.value = fmtDT(end);
    var dDisp = document.getElementById('heroCalendarDisplay');
    if (dDisp) {
        var m1 = String(start.getMonth() + 1).padStart(2,'0'); var d1 = String(start.getDate()).padStart(2,'0');
        var h1 = String(start.getHours()).padStart(2,'0') + ':' + String(start.getMinutes()).padStart(2,'0');
        var m2 = String(end.getMonth() + 1).padStart(2,'0'); var d2 = String(end.getDate()).padStart(2,'0');
        var h2 = String(end.getHours()).padStart(2,'0') + ':' + String(end.getMinutes()).padStart(2,'0');
        dDisp.innerText = d1 + '/' + m1 + ' ' + h1 + ' - ' + d2 + '/' + m2 + ' ' + h2;
    }
    document.querySelectorAll('#rentalTabs .nav-link').forEach(function(tab) {
        tab.addEventListener('click', function() {
            document.querySelectorAll('#rentalTabs .nav-link').forEach(function(t) { t.classList.remove('tab-btn-primary'); t.classList.add('tab-btn-secondary'); });
            this.classList.remove('tab-btn-secondary'); this.classList.add('tab-btn-primary');
        });
    });
});
</script>

<!-- Xe Có Ngay Section -->
<div class="container py-4 mb-5">
    <div class="d-flex justify-content-between align-items-end mb-4">
        <div>
            <h2 class="fw-bolder mb-1">Xe Có Ngay</h2>
            <p class="text-muted mb-0">Các mẫu xe phổ thông trống lịch, có thể nhận ngay hôm nay.</p>
        </div>
        <a asp-controller="Car" asp-action="Index" class="text-primary fw-bold text-decoration-none">Xem thêm <i class="bi bi-arrow-right"></i></a>
    </div>

    <div class="row g-4">
        @if (ViewBag.AvailableCars != null)
        {
            foreach (var car in ViewBag.AvailableCars as IEnumerable<CarRentalSystem.Models.Car>)
            {
                var carReviews = car.Reviews?.Where(r => r.IsApproved).ToList() ?? new List<CarRentalSystem.Models.Review>();
                var carAvgRating = carReviews.Any() ? carReviews.Average(r => r.Rating) : 5.0;
                var carReviewCount = carReviews.Count;
                var p4h = Math.Round(car.PricePerDay * 0.25m / 10000m) * 10000m;
                var p8h = Math.Round(car.PricePerDay * 0.40m / 10000m) * 10000m;
                var p12h = Math.Round(car.PricePerDay * 0.55m / 10000m) * 10000m;
                var p24h = car.PricePerDay;
                var isElectric = car.FuelType != null && (car.FuelType.Contains("Điện") || car.FuelType.Contains("Electric"));
                <div class="col-lg-3 col-md-4 col-sm-6">
                    <a id="home-car-@car.CarID" href="@Url.Action("Details", "Car", new { id = car.CarID, duration = 24 })" class="text-decoration-none text-dark">
                        <div class="card home-car-card h-100 position-relative ui-elevated-card" style="cursor: pointer;">
                            <div class="badges-top">
                                <span class="badge bg-success shadow-sm px-2 py-1 rounded-pill" style="font-size: 0.7rem;">Sẵn sàng</span>
                            </div>
                            <img src="@(car.CarImages?.FirstOrDefault()?.ImageUrl ?? "https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&q=80&w=600")" class="card-img-top car-card-img" alt="@car.CarName" style="height: 140px; object-fit: cover;">
                            <div class="card-body p-3">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <span class="text-muted small fw-bold text-uppercase" style="font-size: 0.7rem;">@car.CarBrand?.Name</span>
                                    <div class="d-flex align-items-center gap-1 px-1 py-0 rounded-pill rating-badge" style="font-size: 0.65rem;">
                                        @for (int s = 1; s <= 5; s++)
                                        {
                                            <i class="bi @(s <= Math.Round(carAvgRating) ? "bi-star-fill" : "bi-star")" style="color: #f59e0b; font-size: 0.55rem;"></i>
                                        }
                                        <span class="fw-800 ms-1" style="color: #92400e; font-size: 0.6rem;">@carAvgRating.ToString("0.0")</span>
                                        @if (carReviewCount > 0)
                                        {
                                            <span class="text-muted" style="font-size: 0.5rem;">(@carReviewCount)</span>
                                        }
                                    </div>
                                </div>
                                <h5 class="fw-bold mb-1" style="font-size: 0.95rem;">@car.CarName</h5>
                                <div class="d-flex gap-2 mb-2 small text-muted" style="font-size: 0.75rem;">
                                    <span><i class="bi bi-gear"></i> @car.Transmission</span>
                                    <span><i class="bi bi-person"></i> @car.Seats</span>
                                    @if (isElectric)
                                    {
                                        <span><i class="bi bi-lightning-charge text-success"></i> Điện</span>
                                    }
                                    else
                                    {
                                        <span><i class="bi bi-fuel-pump"></i> @car.FuelType</span>
                                    }
                                </div>
                                <hr class="opacity-10 my-2">

                                <!-- Bảng giá tham khảo -->
                                <div class="mb-2">
                                    <div class="small text-muted mb-1"><i class="bi bi-tags-fill me-1"></i>Bảng giá</div>
                                    <div class="table-responsive">
                                        <table class="table table-sm table-bordered mb-0 text-center">
                                            <thead class="table-light">
                                                <tr>
                                                    <th class="py-1 px-2" style="font-size: 0.7rem;">4h</th>
                                                    <th class="py-1 px-2" style="font-size: 0.7rem;">8h</th>
                                                    <th class="py-1 px-2" style="font-size: 0.7rem;">12h</th>
                                                    <th class="py-1 px-2" style="font-size: 0.7rem;">24h</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr>
                                                    <td class="py-1 px-2 fw-bold text-success" style="font-size: 0.8rem;">@((p4h/1000).ToString("N0"))K</td>
                                                    <td class="py-1 px-2 fw-bold text-primary" style="font-size: 0.8rem;">@((p8h/1000).ToString("N0"))K</td>
                                                    <td class="py-1 px-2 fw-bold text-warning" style="font-size: 0.8rem;">@((p12h/1000).ToString("N0"))K</td>
                                                    <td class="py-1 px-2 fw-bold text-danger" style="font-size: 0.8rem;">@((p24h/1000).ToString("N0"))K</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </a>
                </div>
            }
        }
    </div>
</div>

<!-- Xe Xịn Section -->
