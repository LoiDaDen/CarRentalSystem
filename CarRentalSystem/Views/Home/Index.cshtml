@model CarRentalSystem.ViewModels.HomeIndexViewModel
@{
    ViewData["Title"] = "CarRental - Thuê xe tự lái 24/7";
    var availableCars = Model.AvailableCars;
    var premiumCars = Model.PremiumCars;
}

<style>
    .home-premium {
        width: 100vw;
        margin-left: calc(50% - 50vw);
        margin-top: -1.5rem;
        overflow: hidden;
    }

    .home-hero {
        position: relative;
        min-height: min(760px, calc(100vh - 76px));
        padding: clamp(4rem, 7vw, 7rem) 0 clamp(3rem, 5vw, 5rem);
        color: #fff;
        background:
            linear-gradient(90deg, rgba(8, 13, 25, .88) 0%, rgba(8, 13, 25, .64) 48%, rgba(8, 13, 25, .18) 100%),
            url('https://images.unsplash.com/photo-1503376780353-7e6692767b70?q=80&w=2200&auto=format&fit=crop') center/cover;
    }

    .home-hero h1 {
        max-width: 760px;
        color: #fff;
        font-size: clamp(2.25rem, 5vw, 4.85rem);
        font-weight: 900;
        line-height: 1.02;
        letter-spacing: 0;
    }

    .home-hero-copy {
        max-width: 650px;
        color: rgba(255, 255, 255, .82);
        font-size: 1.08rem;
        line-height: 1.75;
    }

    .home-hero-trust {
        display: flex;
        flex-wrap: wrap;
        gap: .65rem;
        margin-top: 1.35rem;
    }

    .home-hero-trust span {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        min-height: 38px;
        padding: .45rem .8rem;
        border: 1px solid rgba(255, 255, 255, .24);
        border-radius: 999px;
        background: rgba(255, 255, 255, .12);
        color: rgba(255, 255, 255, .92);
        font-weight: 800;
        font-size: .84rem;
        backdrop-filter: blur(10px);
    }

    .hero-search {
        max-width: 1080px;
        margin-top: 2rem;
        padding: 1rem;
        border: 1px solid rgba(255,255,255,.24);
        border-radius: 8px;
        background: rgba(255,255,255,.96);
        box-shadow: 0 22px 60px rgba(2, 6, 23, .28);
    }

    .hero-search .nav {
        gap: .5rem;
    }

    .hero-search .nav-link {
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        color: #334155;
        font-weight: 800;
    }

    .hero-search .nav-link.active {
        background: #2563eb;
        border-color: #2563eb;
        color: #fff;
    }

    .home-section {
        padding: clamp(3rem, 5vw, 5rem) 0;
    }

    .home-band {
        background: #fff;
        border-top: 1px solid #d9e2ec;
        border-bottom: 1px solid #d9e2ec;
    }

    .home-value-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 1rem;
    }

    .home-value-card {
        height: 100%;
        padding: 1.25rem;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .06);
    }

    .home-value-card i {
        width: 42px;
        height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #eaf1ff;
        color: #2563eb;
        font-size: 1.25rem;
        margin-bottom: .9rem;
    }

    .home-stat {
        padding: 1.25rem;
        border-left: 1px solid #d9e2ec;
    }

    .home-stat:first-child {
        border-left: 0;
    }

    .home-step {
        height: 100%;
        padding: 1.25rem;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #fff;
    }

    .home-step-number {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
        background: #eaf1ff;
        color: #2563eb;
        font-weight: 900;
    }

    @@media (max-width: 767.98px) {
        .home-hero {
            min-height: auto;
            padding-top: 3rem;
        }

        .hero-search {
            padding: .85rem;
        }

        .home-stat {
            border-left: 0;
            border-top: 1px solid #d9e2ec;
        }

        .home-stat:first-child {
            border-top: 0;
        }
    }

    @@media (max-width: 991.98px) {
        .home-value-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .home-value-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="home-premium">
    <section class="home-hero">
        <div class="container">
            <div class="pt-eyebrow text-white-50 mb-3">Thuê xe tự lái cao cấp</div>
            <h1>Thuê xe tự lái minh bạch, nhanh và an tâm.</h1>
            <p class="home-hero-copy mt-3 mb-0">
                Chọn xe theo khu vực, giữ xe bằng đặt cọc trực tuyến, nhận xe linh hoạt và theo dõi đầy đủ chi phí trước chuyến đi.
            </p>
            <div class="home-hero-trust" aria-label="Cam kết dịch vụ">
                <span><i class="bi bi-shield-check"></i>Xe xác minh hồ sơ</span>
                <span><i class="bi bi-receipt"></i>Giá minh bạch</span>
                <span><i class="bi bi-headset"></i>Hỗ trợ 24/7</span>
                <span><i class="bi bi-car-front"></i>Nhận xe linh hoạt</span>
            </div>

            <div class="hero-search">
                <ul class="nav nav-pills mb-3" id="rentalTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="self-drive-tab" data-bs-toggle="tab" data-bs-target="#selfDrivePane" type="button" role="tab">
                            <i class="bi bi-car-front-fill me-1"></i>Thuê xe tự lái
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="monthly-tab" data-bs-toggle="tab" data-bs-target="#monthlyPane" type="button" role="tab">
                            <i class="bi bi-calendar-month me-1"></i>Thuê theo tháng
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <div class="tab-pane fade show active" id="selfDrivePane" role="tabpanel">
                        <form asp-controller="Car" asp-action="Index" method="get">
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-4 col-md-6">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Địa điểm nhận xe</label>
                                    <select class="form-select" name="location">
                                        <option value="">Tất cả khu vực</option>
                                        @if (ViewBag.Locations != null)
                                        {
                                            foreach (var loc in ViewBag.Locations)
                                            {
                                                <option value="@loc.Name">@loc.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-lg-5 col-md-6">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Lịch thuê xe</label>
                                    <button type="button" class="form-control text-start d-flex align-items-center justify-content-between"
                                            onclick="openCarCalendar({startInputId: 'heroStartDate', endInputId: 'heroEndDate', defaultStart: document.getElementById('heroStartDate').value, defaultEnd: document.getElementById('heroEndDate').value})">
                                        <span id="heroCalendarDisplay" class="fw-bold">Chọn thời gian...</span>
                                        <i class="bi bi-calendar3 text-primary"></i>
                                    </button>
                                    <input type="hidden" name="startDate" id="heroStartDate" required>
                                    <input type="hidden" name="endDate" id="heroEndDate" required>
                                </div>
                                <div class="col-lg-3">
                                    <button type="submit" class="btn btn-success w-100 py-3">
                                        <i class="bi bi-search me-1"></i>Tìm xe phù hợp
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="tab-pane fade" id="monthlyPane" role="tabpanel">
                        <form asp-controller="Car" asp-action="Index" method="get">
                            <input type="hidden" name="rentalType" value="monthly" />
                            <div class="row g-3 align-items-end">
                                <div class="col-lg-4 col-md-4">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Địa điểm</label>
                                    <select class="form-select" name="location">
                                        @if (ViewBag.Locations != null)
                                        {
                                            foreach (var loc in ViewBag.Locations)
                                            {
                                                <option value="@loc.Name">@loc.Name</option>
                                            }
                                        }
                                    </select>
                                </div>
                                <div class="col-lg-3 col-md-4">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Gói thuê</label>
                                    <select class="form-select" name="monthlyPackage">
                                        <option value="1">1 tháng</option>
                                        <option value="3">3 tháng</option>
                                        <option value="6">6 tháng</option>
                                    </select>
                                </div>
                                <div class="col-lg-3 col-md-4">
                                    <label class="form-label small fw-bold text-uppercase text-muted">Thời gian nhận</label>
                                    <select class="form-select" name="pickupTimeframe">
                                        <option value="7">7 ngày tới</option>
                                        <option value="14">14 ngày tới</option>
                                        <option value="30">1 tháng tới</option>
                                    </select>
                                </div>
                                <div class="col-lg-2">
                                    <button type="submit" class="btn btn-success w-100 py-3">Xác nhận</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="home-band">
        <div class="container">
            <div class="row g-0 text-center">
                <div class="col-md-3 col-6 home-stat">
                    <div class="h2 fw-black text-primary mb-1">24/7</div>
                    <div class="text-muted fw-semibold">Hỗ trợ chuyến đi</div>
                </div>
                <div class="col-md-3 col-6 home-stat">
                    <div class="h2 fw-black text-success mb-1">500+</div>
                    <div class="text-muted fw-semibold">Xe nhiều phân khúc</div>
                </div>
                <div class="col-md-3 col-6 home-stat">
                    <div class="h2 fw-black text-warning mb-1">4.8</div>
                    <div class="text-muted fw-semibold">Điểm đánh giá</div>
                </div>
                <div class="col-md-3 col-6 home-stat">
                    <div class="h2 fw-black text-info mb-1">15%</div>
                    <div class="text-muted fw-semibold">Tiết kiệm thuê dài hạn</div>
                </div>
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="container">
            <div class="pt-page-header">
                <div>
                    <div class="pt-eyebrow mb-2">Vì sao chọn CarRental</div>
                    <h2 class="pt-title mb-1">Trải nghiệm thuê xe tự lái theo chuẩn cao cấp</h2>
                    <p class="pt-subtitle">Tập trung vào minh bạch, an toàn và tốc độ đặt xe thay vì chỉ hiển thị danh sách xe.</p>
                </div>
            </div>
            <div class="home-value-grid">
                <article class="home-value-card">
                    <i class="bi bi-patch-check"></i>
                    <h5>Xe đủ điều kiện vận hành</h5>
                    <p class="text-muted mb-0">Hiển thị trạng thái đăng kiểm, hồ sơ, ảnh xe và thông tin kỹ thuật quan trọng trước khi thuê.</p>
                </article>
                <article class="home-value-card">
                    <i class="bi bi-wallet2"></i>
                    <h5>Chi phí rõ trước chuyến đi</h5>
                    <p class="text-muted mb-0">Giá thuê, đặt cọc, phụ phí và điều khoản được gom vào luồng đặt xe để khách dễ quyết định.</p>
                </article>
                <article class="home-value-card">
                    <i class="bi bi-geo-alt"></i>
                    <h5>Tìm xe theo khu vực</h5>
                    <p class="text-muted mb-0">Lọc theo địa điểm, thời gian, phân khúc, hãng xe và ngân sách như một marketplace hiện đại.</p>
                </article>
                <article class="home-value-card">
                    <i class="bi bi-building-check"></i>
                    <h5>Quản trị vận hành tập trung</h5>
                    <p class="text-muted mb-0">Chủ xe và admin cùng theo dõi xe, cảnh báo, doanh thu và trạng thái duyệt trong một hệ thống.</p>
                </article>
            </div>
        </div>
    </section>

    <section class="home-section">
        <div class="container">
            <div class="pt-page-header">
                <div>
                    <div class="pt-eyebrow mb-2">Có sẵn ngay</div>
                    <h2 class="pt-title mb-1">Xe có ngay</h2>
                    <p class="pt-subtitle">Các mẫu xe sẵn sàng phục vụ trong khu vực bạn chọn.</p>
                </div>
                <a asp-controller="Car" asp-action="Index" class="btn btn-outline-primary">
                    Xem tất cả <i class="bi bi-arrow-right"></i>
                </a>
            </div>

            @if (availableCars.Any())
            {
                <div class="row g-4">
                    @foreach (var car in availableCars.Take(8))
                    {
                        <div class="col-xl-3 col-lg-4 col-sm-6">
                            <a href="@Url.Action("Details", "Car", new { id = car.CarID, duration = 24 })" class="pt-car-card">
                                <article class="card h-100 overflow-hidden">
                                    <div class="position-relative">
                                        <img src="@car.ImageUrl" class="pt-car-card-img" alt="@car.CarName"
                                             onerror="this.src='https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&q=80&w=800'"
                                             loading="lazy" decoding="async">
                                        <span class="badge bg-success position-absolute top-0 start-0 m-2">Sẵn sàng</span>
                                    </div>
                                    <div class="card-body">
                                        <div class="small text-muted fw-bold text-uppercase">@car.BrandName</div>
                                        <h5 class="mb-2 text-truncate">@car.CarName</h5>
                                        <div class="d-flex flex-wrap gap-3 small text-muted mb-3">
                                            <span><i class="bi bi-gear me-1"></i>@car.Transmission</span>
                                            <span><i class="bi bi-people me-1"></i>@car.Seats chỗ</span>
                                            <span><i class="bi bi-geo-alt me-1"></i>@car.LocationName</span>
                                        </div>
                                        <div class="d-flex align-items-center justify-content-between">
                                            <div><span class="pt-price">@((car.PricePerDay / 1000).ToString("N0"))K</span><span class="text-muted"> /24h</span></div>
                                            <div class="small fw-bold text-warning"><i class="bi bi-star-fill"></i> @car.AverageRating.ToString("0.0")</div>
                                        </div>
                                    </div>
                                </article>
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="pt-shell p-5 text-center">
                    <i class="bi bi-car-front display-5 text-muted d-block mb-3"></i>
                    <h4 class="fw-bold">Chưa có xe khả dụng</h4>
                    <p class="text-muted mb-0">Vui lòng thử khu vực hoặc thời gian khác.</p>
                </div>
            }
        </div>
    </section>

    <section class="home-section home-band">
        <div class="container">
            <div class="pt-page-header">
                <div>
                    <div class="pt-eyebrow mb-2">Dàn xe cao cấp</div>
                    <h2 class="pt-title mb-1">Xe sang và xe cao cấp</h2>
                    <p class="pt-subtitle">Dành cho công việc, sự kiện hoặc chuyến đi cần trải nghiệm tốt hơn.</p>
                </div>
                <a asp-controller="Car" asp-action="Index" asp-route-isPremium="true" class="btn btn-outline-primary">
                    Khám phá xe premium
                </a>
            </div>

            @if (premiumCars.Any())
            {
                <div class="row g-4">
                    @foreach (var car in premiumCars)
                    {
                        <div class="col-lg-4 col-md-6">
                            <a href="@Url.Action("Details", "Car", new { id = car.CarID, duration = 24 })" class="pt-car-card">
                                <article class="card h-100 overflow-hidden">
                                    <img src="@car.ImageUrl" class="pt-car-card-img" alt="@car.CarName"
                                         onerror="this.src='https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&q=80&w=900'"
                                         loading="lazy" decoding="async">
                                    <div class="card-body">
                                        <span class="badge bg-dark mb-2"><i class="bi bi-gem text-warning me-1"></i>Premium</span>
                                        <h5>@car.BrandName @car.CarName</h5>
                                        <div class="d-flex justify-content-between align-items-center mt-3">
                                            <span class="text-muted small">@car.Seats chỗ · @car.Transmission</span>
                                            <span class="pt-price">@((car.PricePerDay / 1000).ToString("N0"))K</span>
                                        </div>
                                    </div>
                                </article>
                            </a>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <section class="home-section">
        <div class="container">
            <div class="text-center mb-4">
                <div class="pt-eyebrow mb-2">Quy trình thuê xe</div>
                <h2 class="pt-title">3 bước đặt xe rõ ràng</h2>
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="home-step">
                        <span class="home-step-number mb-3">1</span>
                        <h5>Tìm xe phù hợp</h5>
                        <p class="text-muted mb-0">Chọn khu vực, thời gian thuê, phân khúc xe và xem giá ngay trước khi đặt.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="home-step">
                        <span class="home-step-number mb-3">2</span>
                        <h5>Đặt cọc giữ xe</h5>
                        <p class="text-muted mb-0">Xác nhận thông tin, chọn bảo hiểm/add-on và thanh toán đặt cọc trực tuyến.</p>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="home-step">
                        <span class="home-step-number mb-3">3</span>
                        <h5>Nhận xe và di chuyển</h5>
                        <p class="text-muted mb-0">Nhận xe tại điểm hẹn hoặc giao tận nơi, kiểm tra xe và bắt đầu chuyến đi.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var now = new Date();
            var start = new Date(now.getTime() + 2 * 60 * 60 * 1000);
            var mins = start.getMinutes();
            if (mins > 0 && mins <= 30) start.setMinutes(30, 0, 0);
            else if (mins > 30) { start.setHours(start.getHours() + 1); start.setMinutes(0, 0, 0); }
            else start.setMinutes(0, 0, 0);
            var end = new Date(start.getTime() + 4 * 60 * 60 * 1000);

            function fmtDT(d) {
                return d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0') + 'T' + String(d.getHours()).padStart(2, '0') + ':' + String(d.getMinutes()).padStart(2, '0');
            }

            var s = document.getElementById('heroStartDate');
            var e = document.getElementById('heroEndDate');
            if (s) s.value = fmtDT(start);
            if (e) e.value = fmtDT(end);

            var display = document.getElementById('heroCalendarDisplay');
            if (display) {
                display.innerText =
                    String(start.getDate()).padStart(2, '0') + '/' + String(start.getMonth() + 1).padStart(2, '0') + ' ' +
                    String(start.getHours()).padStart(2, '0') + ':' + String(start.getMinutes()).padStart(2, '0') + ' - ' +
                    String(end.getDate()).padStart(2, '0') + '/' + String(end.getMonth() + 1).padStart(2, '0') + ' ' +
                    String(end.getHours()).padStart(2, '0') + ':' + String(end.getMinutes()).padStart(2, '0');
            }
        });
    </script>
}
