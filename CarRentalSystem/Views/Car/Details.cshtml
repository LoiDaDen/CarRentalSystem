                                    <div>
                                        <div class="fw-bold mb-1 text-dark">Khách nhận tại vị trí xe đậu</div>
                                        <div class="text-muted small">@(Model.Car.CarAddress ?? Model.LocationName)</div>
                                    </div>
                                </label>

