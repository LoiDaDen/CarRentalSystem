@model CarRentalSystem.Models.CarDetailsViewModel
@{
    ViewData["Title"] = Model.Car.CarBrand?.Name + " " + Model.Car.CarName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/car-details.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <style>
        .flatpickr-day.disabled, .flatpickr-day.disabled:hover { background: #ffe0e0; color: #dc3545; text-decoration: line-through; }
        .flatpickr-calendar { box-shadow: 0 10px 40px rgba(0,0,0,.15); border-radius: 12px; overflow: hidden; }
        .btn-check:checked + .btn-outline-success .pkg-title { color: #ffffff !important; opacity: 0.9; }
        .btn-check:checked + .btn-outline-success .pkg-price { color: #ffffff !important; }
        .pkg-title { color: #065f46; font-size: 0.75rem; letter-spacing: 0.5px; }
    </style>
}

<div class="car-details-container pb-5 page-car-details">
    <div class="container-fluid px-0 mb-4">
        <div class="bg-dark text-white py-2 px-4 d-flex align-items-center">
            <a asp-action="Index" class="text-white text-decoration-none me-3"><i class="bi bi-arrow-left"></i></a>
            <h5 class="mb-0">Chi tiết xe</h5>
        </div>
        
        <div class="gallery-grid">
            <div class="gallery-main">
                <img src="@(Model.Car.CarImages?.OrderBy(i => i.ImageID).Select(i => i.ImageUrl).FirstOrDefault() ?? Model.Car.ImageURL ?? "https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?w=800&h=500&fit=crop")" alt="@Model.Car.CarName"
                     onerror="this.src='https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?w=800&h=500&fit=crop'">
            </div>
            <div class="gallery-thumbs">
                @{
                    var allImages = Model.Car.CarImages?.OrderBy(i => i.ImageID).Select(i => i.ImageUrl).ToList() ?? new List<string>();
                    var mainImg = allImages.FirstOrDefault() ?? Model.Car.ImageURL ?? "";
                    var thumbs = allImages.Skip(1).Take(4).ToList();
                    var extraImgs = new[] {
                        "https://images.unsplash.com/photo-1583121274602-3e2820c69888?w=400&h=250&fit=crop",
                        "https://images.unsplash.com/photo-1552519507-da3b142c6e3d?w=400&h=250&fit=crop",
                        "https://images.unsplash.com/photo-1533473359331-0135ef1b58bf?w=400&h=250&fit=crop",
                        "https://images.unsplash.com/photo-1544636331-e26879cd4d9b?w=400&h=250&fit=crop"
                    };
                    // Fill missing thumbs with extra car images
                    for (int i = thumbs.Count; i < 4; i++)
                    {
                        thumbs.Add(extraImgs[i % extraImgs.Length]);
                    }
                }
                @foreach (var thumbUrl in thumbs)
                {
                    <img src="@thumbUrl" alt="@Model.Car.CarName"
                         onerror="this.src='https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?w=400&h=250&fit=crop'">
                }
            </div>
        </div>
    </div>

    <div class="container-fluid px-lg-5">
        <div class="row g-5">
            <!-- Left Column: Details -->
            <div class="col-lg-8">
                <div class="d-flex justify-content-between align-items-start mb-4">
                    <div>
                        <div class="d-flex align-items-center flex-wrap gap-2 mb-1">
                            <h1 class="fw-800 mb-0">@Model.Car.CarBrand?.Name @Model.Car.CarName</h1>
                            @if(Model.Car.OwnerID == null)
                            {
                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25" style="font-size: 0.8rem;"><i class="bi bi-building"></i> Xe Hệ Thống</span>
                            }
                            else
                            {
                                <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25" style="font-size: 0.8rem;"><i class="bi bi-person-badge"></i> Xe Đối Tác @(Model.Car.Owner?.Name != null ? "- " + Model.Car.Owner.Name : "")</span>
                            }
                        </div>
                        <div class="text-muted"><i class="bi bi-geo-alt me-1"></i>@(Model.Car.CarAddress ?? Model.LocationName)</div>
                    </div>
                    <button class="btn btn-link text-dark text-decoration-none"><i class="bi bi-share me-1"></i>Chia sẻ</button>
                </div>

                <div class="section-card">
                    <h5 class="fw-bold mb-4">Đặc điểm</h5>
                    <div class="row g-4">
                        <div class="col-6 col-md-3">
                            <div class="characteristic-item">
                                <div class="characteristic-icon bg-success bg-opacity-10 text-success"><i class="bi bi-people"></i></div>
                                <div>
                                    <small class="text-muted d-block">Số ghế</small>
                                    <span class="fw-bold">@Model.Car.Seats chỗ</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="characteristic-item">
                                <div class="characteristic-icon bg-success bg-opacity-10 text-success"><i class="bi bi-gear"></i></div>
                                <div>
                                    <small class="text-muted d-block">Truyền động</small>
                                    <span class="fw-bold">@Model.Car.Transmission</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="characteristic-item">
                                <div class="characteristic-icon bg-success bg-opacity-10 text-success"><i class="bi bi-fuel-pump"></i></div>
                                <div>
                                    <small class="text-muted d-block">Nhiên liệu</small>
                                    <span class="fw-bold">@Model.Car.FuelType</span>
                                </div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="characteristic-item">
                                <div class="characteristic-icon bg-success bg-opacity-10 text-success"><i class="bi bi-droplet"></i></div>
                                <div>
                                    <small class="text-muted d-block">Tiêu hao</small>
                                    @{
                                        var fc = Model.Car.FuelConsumption ?? "8.0";
                                        var fcUnit = Model.Car.FuelType == "Điện" ? "kWh/100km" : "L/100km";
                                        var displayFc = fc.Contains("100km") ? fc : $"{fc} {fcUnit}";
                                    }
                                    <span class="fw-bold">@displayFc</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="section-card">
                    <h5 class="fw-bold mb-3">Mô tả</h5>
                    <p class="text-muted mb-0">@Model.Car.Description</p>
                </div>

                <!-- Bảng Master Chi Tiết Giá (Chim mồi) -->
                <div class="section-card">
                    <h5 class="fw-bold mb-3"><i class="bi bi-tags-fill text-success me-2"></i>Chi Tiết Bảng Giá</h5>
                    <table class="table table-bordered text-center mb-3" style="border-radius: 12px; overflow: hidden; border-color: #e2e8f0;">
                        <thead style="background: linear-gradient(135deg, #10b981, #059669); color: white;">
                            <tr>
                                <th class="py-3">Gói Thuê</th>
                                <th class="py-3">Giá</th>
                                <th class="py-3">Tiết kiệm</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-bold py-3"><i class="bi bi-clock me-1 text-success"></i>4 giờ</td>
                                <td class="fw-800 text-success py-3 fs-6">@Model.Pricing.Price4h.ToString("N0") đ</td>
                                <td class="py-3"><span class="badge bg-success bg-opacity-10 text-success">Phổ biến</span></td>
                            </tr>
                            <tr>
                                <td class="fw-bold py-3"><i class="bi bi-clock me-1 text-primary"></i>8 giờ</td>
                                <td class="fw-800 text-primary py-3 fs-6">@Model.Pricing.Price8h.ToString("N0") đ</td>
                                <td class="text-success py-3 fw-bold">-@(Math.Round((1 - Model.Pricing.Price8h / (Model.Pricing.Price4h * 2)) * 100))%</td>
                            </tr>
                            <tr>
                                <td class="fw-bold py-3"><i class="bi bi-clock me-1 text-warning"></i>12 giờ</td>
                                <td class="fw-800 text-warning py-3 fs-6">@Model.Pricing.Price12h.ToString("N0") đ</td>
                                <td class="text-success py-3 fw-bold">-@(Math.Round((1 - Model.Pricing.Price12h / (Model.Pricing.Price4h * 3)) * 100))%</td>
                            </tr>
                            <tr style="background: linear-gradient(135deg, #fef3c7, #fde68a);">
                                <td class="fw-bold py-3"><i class="bi bi-star-fill me-1 text-warning"></i>24 giờ <span class="badge bg-danger ms-1">HOT</span></td>
                                <td class="fw-800 text-danger py-3 fs-5">@Model.Pricing.Price24h.ToString("N0") đ</td>
                                <td class="text-danger py-3 fw-bold">
                                    @{
                                        var discountPercent = Model.Pricing.Price4h > 0
                                            ? Math.Round((1 - Model.Pricing.Price24h / (Model.Pricing.Price4h * 6)) * 100)
                                            : 0;
                                    }
                                    @if (discountPercent > 0)
                                    {
                                        @:-@discountPercent% 🔥
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                            </tr>
                            <tr class="table-light">
                                <td class="fw-bold py-3 text-muted"><i class="bi bi-plus-circle me-1"></i>Phụ thu / giờ thêm</td>
                                <td class="fw-bold py-3 text-muted">@((Model.Car.PricePerDay * 0.24m / 1000).ToString("N0"))K/giờ</td>
                                <td class="py-3 text-muted small">Áp dụng khi vượt gói</td>
                            </tr>
                        </tbody>
                    </table>
                    <div class="alert alert-info py-2 px-3 mb-0 d-flex align-items-center" style="border-radius: 10px; background: linear-gradient(135deg, #eff6ff, #dbeafe); border: 1px solid #93c5fd;">
                        <i class="bi bi-info-circle-fill text-primary me-2 fs-5"></i>
                        <small class="text-primary fw-bold">📅 Giá ngày Lễ/Tết có thể điều chỉnh theo nhu cầu. Vui lòng liên hệ hotline để biết thêm chi tiết.</small>
                    </div>
                </div>

                <div class="section-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="fw-bold mb-0">Vị trí xe</h5>
                        <a href="https://www.google.com/maps?q=@(Model.Car.Latitude ?? 10.7816),@(Model.Car.Longitude ?? 106.6994)" target="_blank" class="btn btn-outline-primary btn-sm rounded-pill px-3 shadow-sm mt-1">Mở trong Maps <i class="bi bi-box-arrow-up-right ms-1"></i></a>
                    </div>
                    <p class="text-muted mb-3 small"><i class="bi bi-geo-alt me-1"></i>@(Model.Car.CarAddress ?? Model.LocationName)</p>
                    <div id="carLocationMap" class="rounded-3 border shadow-sm overflow-hidden" style="height: 350px;"></div>
                </div>

                <div class="section-card">
                    <h5 class="fw-bold mb-4">Các tiện nghi khác</h5>
                    <div class="amenity-grid">
                        @foreach (var amenity in Model.Amenities)
                        {
                            <div class="amenity-item">
                                <i class="bi @amenity.Icon"></i>
                                <span>@amenity.Name</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="section-card">
                    <h5 class="fw-bold mb-3">Điều khoản</h5>
                    <div class="text-muted small">
                        <p class="mb-2">Quy định khác:</p>
                        <ul class="ps-3 mb-0">
                            <li>Sử dụng xe đúng mục đích.</li>
                            <li>Không sử dụng xe thuê vào mục đích phi pháp, trái pháp luật.</li>
                            <li>Không sử dụng xe thuê để cầm cố, thế chấp.</li>
                            <li>Không hút thuốc, nhả kẹo cao su, xả rác trong xe.</li>
                            <li>Không chở hàng quốc cấm dễ cháy nổ.</li>
                            <li>Không chở hoa quả, thực phẩm nặng mùi trong xe.</li>
                            <li>Khi trả xe, nếu xe bẩn hoặc có mùi trong xe, khách hàng vui lòng vệ sinh sạch sẽ hoặc gửi phụ thu phí vệ sinh xe.</li>
                            <li>Xe được giới hạn di chuyển 400km cho 24h, và lần lượt là 250km, 300km, 350km cho gói 4h, 8h, 12h.</li>
                        </ul>
                    </div>
                </div>

                <div class="section-card">
                    <h5 class="fw-bold mb-3">Chính sách hủy chuyến</h5>
                    <table class="cancellation-table">
                        <thead>
                            <tr>
                                <th></th>
                                <th>Ngày thường</th>
                                <th>Ngày lễ, Tết</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="text-start ps-3 text-success fw-bold"><i class="bi bi-check-circle me-2"></i>Hoàn 100% tiền giữ chỗ</td>
                                <td class="text-muted">Trước chuyến đi > 10 ngày</td>
                                <td class="text-muted">Không áp dụng</td>
                            </tr>
                            <tr>
                                <td class="text-start ps-3 text-warning fw-bold"><i class="bi bi-check-circle me-2"></i>Hoàn 30% tiền giữ chỗ</td>
                                <td class="text-muted">Trước chuyến đi > 5 ngày</td>
                                <td class="text-muted">Trước chuyến đi > 30 ngày</td>
                            </tr>
                            <tr>
                                <td class="text-start ps-3 text-danger fw-bold"><i class="bi bi-x-circle me-2"></i>Không hoàn tiền giữ chỗ</td>
                                <td class="text-muted">Trong vòng 5 ngày trước chuyến đi</td>
                                <td class="text-muted">Trong vòng 30 ngày trước chuyến đi</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="section-card mb-5">
                    <h5 class="fw-bold mb-3">Thông tin chủ xe</h5>
                    <div class="d-flex align-items-center">
                        <div class="bg-success rounded-circle p-2 me-3 text-white"><i class="bi bi-person"></i></div>
                        <span class="fw-bold">Xe được vận hành bởi @Model.OwnerName</span>
                    </div>
                </div>

                <!-- Maintenance Warning -->
                @if (Model.Car.NextInspectionDate.HasValue && Model.Car.NextInspectionDate.Value < DateTime.Now)
                {
                    <div class="alert alert-danger d-flex align-items-center gap-3 rounded-3 mb-4">
                        <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                        <div>
                            <strong>Xe đang tạm ngưng cho thuê</strong><br>
                            <small>Xe này đã quá hạn Đăng kiểm (@Model.Car.NextInspectionDate.Value.ToString("dd/MM/yyyy")). Vui lòng chọn xe khác.</small>
                        </div>
                    </div>
                }

                <!-- Reviews Section -->
                <div class="section-card">
                    <h5 class="fw-bold mb-4"><i class="bi bi-star-fill text-warning me-2"></i>Đánh giá từ khách hàng</h5>
                    @{
                        var reviews = Model.Car.Reviews?.Where(r => r.IsApproved).ToList() ?? new List<CarRentalSystem.Models.Review>();
                        var avgRating = reviews.Any() ? reviews.Average(r => r.Rating) : 0;
                    }
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="text-center">
                            <div class="fw-800 fs-1 text-success">@avgRating.ToString("0.0")</div>
                            <div class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= Math.Round(avgRating) ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </div>
                            <small class="text-muted">@reviews.Count đánh giá</small>
                        </div>
                    </div>

                    @foreach (var r in reviews.OrderByDescending(x => x.CreatedAt).Take(5))
                    {
                        <div class="border-bottom pb-3 mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="fw-bold"><i class="bi bi-person-circle me-1 text-muted"></i>@r.User?.Name</div>
                                <small class="text-muted">@r.CreatedAt.ToString("dd/MM/yyyy")</small>
                            </div>
                            <div class="text-warning small mb-1">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi @(i <= r.Rating ? "bi-star-fill" : "bi-star")"></i>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(r.Comment))
                            {
                                <p class="text-muted small mb-0">@r.Comment</p>
                            }
                        </div>
                    }

                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                    {
                        if (ViewBag.HasRentedThisCar == true)
                        {
                            if (ViewBag.HasReviewedThisCar == true)
                            {
                                <div class="alert alert-info mt-4 mb-0">
                                    <i class="bi bi-check-circle me-2"></i>Bạn đã đánh giá xe này rồi.
                                </div>
                            }
                            else
                            {
                                <form asp-controller="Review" asp-action="Create" method="post" class="mt-4 p-3 bg-light rounded-3">
                                    @Html.AntiForgeryToken()
                                    <h6 class="fw-bold mb-3">Để lại đánh giá của bạn</h6>
                                    <input type="hidden" name="CarID" value="@Model.Car.CarID" />
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Đánh giá sao</label>
                                        <select name="Rating" class="form-select" required>
                                            <option value="5">⭐⭐⭐⭐⭐ Xuất sắc</option>
                                            <option value="4">⭐⭐⭐⭐ Tốt</option>
                                            <option value="3">⭐⭐⭐ Bình thường</option>
                                            <option value="2">⭐⭐ Chưa hài lòng</option>
                                            <option value="1">⭐ Rất tệ</option>
                                        </select>
                                    </div>
                                    <div class="mb-3">
                                        <label class="form-label small fw-bold">Nhận xét (tùy chọn)</label>
                                        <textarea name="Comment" class="form-control" rows="2" placeholder="Chia sẻ trải nghiệm của bạn..."></textarea>
                                    </div>
                                    <button type="submit" class="btn btn-primary btn-sm fw-bold px-4">Gửi đánh giá</button>
                                </form>
                            }
                        }
                        else
                        {
                            <div class="alert alert-secondary mt-4 mb-0">
                                <i class="bi bi-info-circle me-2"></i>Chỉ khách hàng đã thuê xe mới có thể đánh giá.
                            </div>
                        }
                    }
                </div>

            </div>

            <!-- Right Column: Booking Form -->
            <div class="col-lg-4">
                @if (TempData["BookingError"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show mb-4 rounded-3" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["BookingError"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                
                <form asp-controller="Booking" asp-action="Checkout" method="get" id="bookingForm" class="booking-sidebar">
                    <input type="hidden" name="CarID" value="@Model.Car.CarID" />
                    <!-- The TotalPrice is calculated on the server to prevent tampering -->
                    <div class="section-card shadow-sm border-0 mb-4 p-4">
                        <div class="service-badge bg-success bg-opacity-10 text-success w-100 justify-content-center mb-4">
                            <i class="bi bi-phone"></i> Tự nhận xe
                        </div>
                        <ul class="list-unstyled small text-muted mb-4 px-2">
                            <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i>Tối ưu chi phí khi thuê gói theo giờ</li>
                            <li class="mb-2"><i class="bi bi-check2 text-success me-2"></i>Nhận và trả xe chủ động qua ứng dụng @Model.OwnerName</li>
                            <li class="mb-0"><i class="bi bi-check2 text-success me-2"></i>Đặt xe nhanh, không cần chờ chủ xe duyệt đơn</li>
                        </ul>
                        <div class="text-center">
                            <a href="#" class="text-success text-decoration-none small fw-bold">Cách thức hoạt động <i class="bi bi-arrow-right-circle ms-1"></i></a>
                        </div>
                    </div>

                    <div class="section-card shadow-sm border-0 p-4">
                        <div class="mb-4">
                            <label class="small fw-bold mb-2">Chọn gói thuê</label>
                            <div class="row g-2" id="pricePackageButtons">
                                @{
                                    var hrRate = Model.Car.PricePerHour;
                                    var pkg4 = Model.Pricing.Price4h;
                                    var pkg8 = Model.Pricing.Price8h;
                                    var pkg12 = Model.Pricing.Price12h;
                                    var pkg24 = Model.Pricing.Price24h;
                                    int[] comboHours = { 4, 8, 12, 24 };
                                }
                                @foreach (var h in comboHours)
                                {
                                    var hourlyTotal = hrRate * h;
                                    decimal comboPrice = 0;
                                    if (h == 4) comboPrice = pkg4;
                                    else if (h == 8) comboPrice = pkg8;
                                    else if (h == 12) comboPrice = pkg12;
                                    else comboPrice = pkg24;

                                    <div class="col-6 col-lg-3">
                                        <button type="button" class="btn btn-outline-success w-100 fw-bold pkg-btn d-flex flex-column align-items-center justify-content-center p-2 rounded-3 h-100 transition-all" data-hours="@h">
                                            <span style="font-size: 1rem;">@(h)h</span>
                                            <span class="small" style="font-size: 0.75rem;">@comboPrice.ToString("N0")đ</span>
                                        </button>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="border rounded-3 p-3 border-warning bg-warning bg-opacity-10 mb-4 position-relative">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="small fw-bold">Thời gian thuê</span>
                                <i class="bi bi-calendar-event text-success"></i>
                            </div>
                            @{
                                var now = DateTime.Now;
                                var startMin = now.Minute;
                                if (startMin > 0 && startMin <= 30) now = now.Date.AddHours(now.Hour).AddMinutes(30);
                                else if (startMin > 30) now = now.Date.AddHours(now.Hour + 1);
                                else now = now.Date.AddHours(now.Hour);

                                var defaultStart = ViewBag.StartDate ?? now.AddHours(2).ToString("yyyy-MM-ddTHH:mm");
                                string defaultEnd;
                                if (ViewBag.Duration != null) {
                                    int dur = (int)ViewBag.Duration;
                                    defaultEnd = DateTime.Parse(defaultStart).AddHours(dur).ToString("yyyy-MM-ddTHH:mm");
                                } else {
                                    defaultEnd = ViewBag.EndDate ?? now.AddHours(6).ToString("yyyy-MM-ddTHH:mm");
                                }
                            }
                            <div class="mt-2">
                                <div class="form-control bg-white fw-bold px-3 py-2 d-flex justify-content-between align-items-center shadow-sm cursor-pointer" onclick="openCarCalendar({startInputId: 'startDate', endInputId: 'endDate', disabledDates: window.carDisabledDates})" style="cursor: pointer;">
                                    <span id="bookingCalendarDisplay" data-calendar-display>Chọn thời gian thuê...</span>
                                    <i class="bi bi-pencil-square text-muted"></i>
                                </div>
                                <input type="hidden" id="startDate" name="StartDate" value="@defaultStart" required pattern=".*\S+.*">
                                <input type="hidden" id="endDate" name="EndDate" value="@defaultEnd" required pattern=".*\S+.*">
                            </div>
                            <div class="text-warning mt-2 custom-small-text">Đây là chuyến đặt sát giờ. Để xe được chuẩn bị tốt và vệ sinh chu đáo, vui lòng đặt trước 2 tiếng.</div>
                        </div>

                        <div class="mb-4">
                            <label class="small fw-bold mb-2">Vị trí nhận xe</label>
