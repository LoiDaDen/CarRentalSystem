</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>
    <script>
        const carData = {
            id: @Model.Car.CarID,
            price: @Model.Car.PricePerDay,
            pricePerHour: @Model.Car.PricePerHour,
            price4h: @Model.Pricing.Price4h,
            price8h: @Model.Pricing.Price8h,
            price12h: @Model.Pricing.Price12h,
            price24h: @Model.Pricing.Price24h,
            pricePerHour: @Model.Car.PricePerHour,
            lat: @(Model.Car.Latitude ?? 10.7816),
            lng: @(Model.Car.Longitude ?? 106.6994),
            brand: '@Model.Car.CarBrand?.Name',
            name: '@Model.Car.CarName',
            address: '@Html.Encode(Model.Car.CarAddress ?? Model.LocationName)',
            region: '@Html.Encode(Model.Car.Location?.Name ?? Model.LocationName)'
        };

        // === AVAILABILITY CALENDAR ===
        (async function initCalendar() {
            let disabledDates = [];
            try {
                const res = await fetch('/Car/BusyDates?carId=' + carData.id);
                if (res.ok) disabledDates = await res.json();
                window.carDisabledDates = disabledDates;
            } catch(e) {}

            const urlParams = new URLSearchParams(window.location.search);
            const queryStart = urlParams.get('startDate');
            const queryEnd = urlParams.get('endDate');

            // Read the pre-calculated, cleanly rounded defaults from C# generated HTML
            const startInputElem = document.getElementById('startDate');
            const endInputElem = document.getElementById('endDate');
            
            let defaultStart = startInputElem ? new Date(startInputElem.value) : new Date(Date.now() + 2 * 3600 * 1000);
            let defaultEnd = endInputElem ? new Date(endInputElem.value) : new Date(Date.now() + 6 * 3600 * 1000);

            if (queryStart) {
                const pd = new Date(queryStart);
                if (!isNaN(pd.getTime()) && pd.getFullYear() >= 2024) defaultStart = pd;
            }
            if (queryEnd) {
                const pd = new Date(queryEnd);
                if (!isNaN(pd.getTime()) && pd.getFullYear() >= 2024) defaultEnd = pd;
            } else if (queryStart) {
                defaultEnd = new Date(defaultStart.getTime() + 4 * 3600 * 1000);
            }
            
            if (startInputElem) {
                const ds = defaultStart;
                startInputElem.value = ds.getFullYear() + '-' + String(ds.getMonth()+1).padStart(2,'0') + '-' + String(ds.getDate()).padStart(2,'0') + 'T' + String(ds.getHours()).padStart(2,'0') + ':' + String(ds.getMinutes()).padStart(2,'0');
            }
            if (endInputElem) {
                const de = defaultEnd;
                endInputElem.value = de.getFullYear() + '-' + String(de.getMonth()+1).padStart(2,'0') + '-' + String(de.getDate()).padStart(2,'0') + 'T' + String(de.getHours()).padStart(2,'0') + ':' + String(de.getMinutes()).padStart(2,'0');
            }
            
            const displayObj = document.getElementById('bookingCalendarDisplay');
            if (displayObj) {
                const m1 = String(defaultStart.getMonth() + 1).padStart(2,'0'); const d1 = String(defaultStart.getDate()).padStart(2,'0');
                const h1 = String(defaultStart.getHours()).padStart(2,'0') + ':' + String(defaultStart.getMinutes()).padStart(2,'0');
                const m2 = String(defaultEnd.getMonth() + 1).padStart(2,'0'); const d2 = String(defaultEnd.getDate()).padStart(2,'0');
                const h2 = String(defaultEnd.getHours()).padStart(2,'0') + ':' + String(defaultEnd.getMinutes()).padStart(2,'0');
                displayObj.innerText = `${d1}/${m1} ${h1} - ${d2}/${m2} ${h2}`;
            }
        })();
    </script>
    <script src="~/js/car-details.js?v=@DateTime.Now.Ticks"></script>
}
