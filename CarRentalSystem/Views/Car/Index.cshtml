@using System.Globalization
@model IEnumerable<CarRentalSystem.Models.Car>
@{
    ViewData["Title"] = "CarRental - Tìm xe của bạn";
    var cars = Model?.ToList() ?? new List<CarRentalSystem.Models.Car>();
    var today = DateTime.UtcNow.AddHours(7).Date;
}

@functions {
    string GetBrandDomain(string name) {
        var n = name?.ToLower().Trim() ?? "";
        if (n.Contains("vinfast")) return "vinfastauto.com";
        if (n.Contains("mitsubishi")) return "mitsubishi-motors.com";
        if (n.Contains("mercedes")) return "mercedes-benz.com";
        if (n.Contains("bmw")) return "bmw.com";
        if (n.Contains("audi")) return "audi.com";
        if (n.Contains("peugeot")) return "peugeot.com";
        if (n.Contains("porsche")) return "porsche.com";
        if (n.Contains("lexus")) return "lexus.com";
        if (n.Contains("volvo")) return "volvo.com";
        if (n.Contains("suzuki")) return "globalsuzuki.com";
        if (n.Contains("nissan")) return "nissan-global.com";
        return n + ".com";
    }
}

<style>
    .catalog-hero {
        margin-top: -1rem;
        padding: 2rem 0;
    }

    .catalog-filter {
        position: sticky;
        top: 92px;
    }

    .brand-strip {
        display: flex;
        gap: .5rem;
        overflow-x: auto;
        padding-bottom: .35rem;
        scrollbar-width: thin;
    }

    .brand-chip {
        min-height: 40px;
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        flex: 0 0 auto;
        padding: .45rem .75rem;
        border: 1px solid #d9e2ec;
        border-radius: 999px;
        background: #fff;
        color: #334155;
        font-weight: 800;
        font-size: .82rem;
    }

    .brand-chip.active,
    .brand-chip:hover {
        background: #eaf1ff;
        border-color: #b8cef8;
        color: #2563eb;
    }

    .brand-chip img {
        width: 18px;
        height: 18px;
        object-fit: contain;
    }

    .catalog-card .car-image {
        aspect-ratio: 4 / 3;
        width: 100%;
        object-fit: cover;
        background: #eef3f8;
    }

    .catalog-trust-bar {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: .75rem;
        margin-bottom: 1.25rem;
    }

    .catalog-trust-item {
        display: flex;
        align-items: center;
        gap: .7rem;
        min-height: 64px;
        padding: .85rem 1rem;
        border: 1px solid #d9e2ec;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 8px 20px rgba(15, 23, 42, .06);
    }

    .catalog-trust-item i {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: 0 0 auto;
        border-radius: 8px;
        background: #eaf1ff;
        color: #2563eb;
    }

    .catalog-card .card-body {
        display: flex;
        flex-direction: column;
    }

    .catalog-card-title {
        display: -webkit-box;
        min-height: 2.6em;
        overflow: hidden;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }

    .catalog-card-location {
        min-height: 1.3rem;
        display: flex;
        align-items: center;
        color: #667085;
        font-size: .82rem;
        font-weight: 700;
    }

    .catalog-card-trust {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
        margin-top: auto;
        padding-top: .75rem;
    }

    .catalog-card-trust .badge {
        border: 1px solid transparent;
        background: #f8fbff;
        color: #334155;
    }

    @@media (max-width: 991.98px) {
        .catalog-filter {
            position: static;
        }

        .catalog-trust-bar {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 575.98px) {
        .catalog-trust-bar {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="catalog-hero">
    <div class="pt-page-header">
        <div>
            <div class="pt-eyebrow mb-2">Chợ xe CarRental</div>
            <h1 class="pt-title mb-1">Hơn @cars.Count xe sẵn sàng phục vụ</h1>
            <p class="pt-subtitle">Lọc xe theo khu vực, thời gian, loại xe và ngân sách cho chuyến đi của bạn.</p>
        </div>
        <a asp-controller="Car" asp-action="MapSearch" class="btn btn-outline-primary">
            <i class="bi bi-map"></i>Tìm trên bản đồ
        </a>
    </div>
</div>

<form method="get" asp-action="Index" id="filterForm">
    <section class="catalog-trust-bar" aria-label="Cam kết tìm xe">
        <div class="catalog-trust-item">
            <i class="bi bi-shield-check"></i>
            <div><strong>Xe xác minh</strong><div class="small text-muted">Hồ sơ, ảnh và đăng kiểm rõ ràng</div></div>
        </div>
        <div class="catalog-trust-item">
            <i class="bi bi-receipt"></i>
            <div><strong>Giá minh bạch</strong><div class="small text-muted">Thấy giá thuê trước khi đặt</div></div>
        </div>
        <div class="catalog-trust-item">
            <i class="bi bi-geo-alt"></i>
            <div><strong>Nhận xe linh hoạt</strong><div class="small text-muted">Tại điểm xe hoặc giao tận nơi</div></div>
        </div>
        <div class="catalog-trust-item">
            <i class="bi bi-stars"></i>
            <div><strong>Gợi ý phù hợp</strong><div class="small text-muted">Lọc theo nhu cầu và ngân sách</div></div>
        </div>
    </section>

    <div class="row g-4">
        <aside class="col-lg-3">
            <div class="pt-shell p-3 catalog-filter">
                <div class="mb-3">
                    <label class="form-label small fw-bold text-uppercase text-muted" for="catalogSearch">Tìm kiếm</label>
                    <div class="input-group">
                        <input id="catalogSearch" class="form-control" type="search" name="q" value="@ViewBag.SearchQuery" placeholder="Tên xe, hãng hoặc biển số" />
                        <button class="btn btn-outline-primary" type="submit" aria-label="Tìm xe"><i class="bi bi-search"></i></button>
                    </div>
                </div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <h5 class="fw-bold mb-0"><i class="bi bi-sliders2 me-1 text-primary"></i>Bộ lọc</h5>
                    <a href="@Url.Action("Index")" class="small fw-bold text-danger text-decoration-none">Xóa lọc</a>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-uppercase text-muted">Địa điểm</label>
                    <select class="form-select" name="location" onchange="document.getElementById('filterForm').submit()">
                        <option value="">Toàn quốc</option>
                        @if (ViewBag.Locations != null)
                        {
                            foreach (var loc in ViewBag.Locations)
                            {
                                <option value="@loc.Name" selected="@(Context.Request.Query["location"].ToString() == loc.Name.ToString())">@loc.Name</option>
                            }
                        }
                    </select>
                </div>

                @if (ViewBag.Contract == null)
                {
                    <div class="mb-3">
                        <label class="form-label small fw-bold text-uppercase text-muted">Thời gian nhận - trả</label>
                        <input type="datetime-local" class="form-control mb-2" name="startDate" value="@Context.Request.Query["startDate"]" onchange="document.getElementById('filterForm').submit()">
                        <input type="datetime-local" class="form-control" name="endDate" value="@Context.Request.Query["endDate"]" onchange="document.getElementById('filterForm').submit()">
                    </div>
                }
                else
                {
                    <input type="hidden" name="contractId" value="@(ViewBag.Contract.ContractTypeID)" />
                    <div class="alert alert-success py-2">
                        <div class="fw-bold">Đang áp dụng hợp đồng</div>
                        <div class="small">@ViewBag.Contract.Name · @ViewBag.Contract.MinDurationDays ngày</div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label small fw-bold text-uppercase text-muted">Loại xe</label>
                    @{
                        var categories = new[] { "", "Sedan 5 chỗ", "SUV 5 chỗ", "SUV 7 chỗ", "MPV 7 chỗ" };
                        var labels = new[] { "Tất cả", "Sedan 5 chỗ", "SUV 5 chỗ", "SUV 7 chỗ", "MPV 7 chỗ" };
                    }
                    @for (var i = 0; i < categories.Length; i++)
                    {
                        var id = "cat" + i;
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="category" value="@categories[i]" id="@id" @(Context.Request.Query["category"] == categories[i] ? "checked" : "") onchange="document.getElementById('filterForm').submit()">
                            <label class="form-check-label fw-semibold" for="@id">@labels[i]</label>
                        </div>
                    }
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-uppercase text-muted">Khoảng giá / ngày</label>
                    <div class="row g-2">
                        <div class="col-6">
                            <input type="number" class="form-control" name="minPrice" placeholder="Từ (K)" value="@Context.Request.Query["minPrice"]" min="0" onchange="document.getElementById('filterForm').submit()">
                        </div>
                        <div class="col-6">
                            <input type="number" class="form-control" name="maxPrice" placeholder="Đến (K)" value="@Context.Request.Query["maxPrice"]" min="0" onchange="document.getElementById('filterForm').submit()">
                        </div>
                    </div>
                </div>

                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" name="isPremium" value="true" id="isPremium" @(Context.Request.Query["isPremium"] == "true" ? "checked" : "") onchange="document.getElementById('filterForm').submit()">
                    <label class="form-check-label fw-semibold" for="isPremium"><i class="bi bi-gem text-warning me-1"></i>Xe cao cấp</label>
                </div>
            </div>
        </aside>

        <section class="col-lg-9">
            <div class="pt-shell p-3 mb-4">
                <div class="d-flex flex-column flex-xl-row gap-3 align-items-xl-center justify-content-between">
                    <div class="brand-strip flex-grow-1">
                        <button type="submit" name="brandId" value="" class="brand-chip @(string.IsNullOrEmpty(Context.Request.Query["brandId"]) ? "active" : "")">
                            <i class="bi bi-grid-3x3-gap-fill"></i>Tất cả hãng
                        </button>
                        @if (ViewBag.Brands != null)
                        {
                            foreach (var brand in ViewBag.Brands)
                            {
                                var bId = brand.BrandID.ToString();
                                var isAct = Context.Request.Query["brandId"] == bId ? "active" : "";
                                <button type="submit" name="brandId" value="@bId" class="brand-chip @isAct">
                                    <img src="https://logo.clearbit.com/@GetBrandDomain(brand.Name)" onerror="this.style.display='none'" alt="@brand.Name" loading="lazy" decoding="async" />
                                    <span>@brand.Name</span>
                                </button>
                            }
                        }
                    </div>
                    <select class="form-select w-auto" name="sort" onchange="document.getElementById('filterForm').submit()">
                        <option value="newest" selected="@(Context.Request.Query["sort"] == "newest" || string.IsNullOrEmpty(Context.Request.Query["sort"]))">Đề xuất mới nhất</option>
                        <option value="price_asc" selected="@(Context.Request.Query["sort"] == "price_asc")">Giá thấp đến cao</option>
                        <option value="price_desc" selected="@(Context.Request.Query["sort"] == "price_desc")">Giá cao đến thấp</option>
                    </select>
                </div>
            </div>

            <div class="row g-4" id="carGrid">
                @foreach (var car in cars)
                {
                    var carReviews = car.Reviews?.Where(r => r.IsApproved).ToList() ?? new List<CarRentalSystem.Models.Review>();
                    var carAvgRating = carReviews.Any() ? carReviews.Average(r => r.Rating) : 5.0;
                    var p24h = car.PricePerDay;
                    var isElectric = car.FuelType != null && (car.FuelType.Contains("Điện") || car.FuelType.Contains("Electric"));
                    var carImage = car.CarImages?.FirstOrDefault()?.ImageUrl ?? car.ImageURL ?? "https://images.unsplash.com/photo-1541899481282-d53bffe3c35d?auto=format&fit=crop&q=80&w=900";
                    var inspectionLabel = "Đăng kiểm cần bổ sung";
                    var inspectionBadgeClass = "text-warning border-warning";
                    var inspectionIcon = "bi-calendar-x";
                    if (car.NextInspectionDate.HasValue)
                    {
                        var daysLeft = (car.NextInspectionDate.Value.Date - today).Days;
                        if (daysLeft < 0)
                        {
                            inspectionLabel = "Tạm ngưng đăng kiểm";
                            inspectionBadgeClass = "text-danger border-danger";
                            inspectionIcon = "bi-exclamation-triangle";
                        }
                        else if (daysLeft <= 30)
                        {
                            inspectionLabel = $"Đăng kiểm còn {daysLeft} ngày";
                            inspectionBadgeClass = "text-warning border-warning";
                            inspectionIcon = "bi-calendar-event";
                        }
                        else
                        {
                            inspectionLabel = "Đăng kiểm hợp lệ";
                            inspectionBadgeClass = "text-success border-success";
                            inspectionIcon = "bi-shield-check";
                        }
                    }
                    <div class="col-xl-4 col-md-6">
                        <a id="car-link-@car.CarID" href="@Url.Action("Details", "Car", new { id = car.CarID, duration = 24, startDate = Context.Request.Query["startDate"], endDate = Context.Request.Query["endDate"], contractId = ViewBag.ContractId })" class="pt-car-card">
                            <article class="card catalog-card h-100 overflow-hidden">
                                <div class="position-relative">
                                    <img src="@carImage" class="car-image" alt="@car.CarName" loading="lazy" decoding="async">
                                    @if (car.IsPremium)
                                    {
                                        <span class="badge bg-dark position-absolute top-0 start-0 m-2"><i class="bi bi-gem text-warning me-1"></i>Premium</span>
                                    }
                                    @if (isElectric)
                                    {
                                        <span class="badge bg-primary position-absolute top-0 end-0 m-2"><i class="bi bi-lightning-charge-fill me-1"></i>Điện</span>
                                    }
                                </div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="small text-muted fw-bold text-uppercase">@car.CarBrand?.Name</span>
                                        <span class="small fw-bold text-warning"><i class="bi bi-star-fill"></i> @carAvgRating.ToString("0.0")</span>
                                    </div>
                                    <h5 class="catalog-card-title mb-2">@car.CarName</h5>
                                    <div class="catalog-card-location mb-2">
                                        <i class="bi bi-geo-alt me-1"></i>@(car.CarAddress ?? car.Location?.Name ?? "Điểm nhận xe linh hoạt")
                                    </div>
                                    <div class="d-flex flex-wrap gap-3 text-muted small mb-3">
                                        <span><i class="bi bi-gear me-1"></i>@car.Transmission</span>
                                        <span><i class="bi bi-people me-1"></i>@car.Seats chỗ</span>
                                        <span><i class="bi bi-fuel-pump me-1"></i>@car.FuelType</span>
                                    </div>
                                    <div class="catalog-card-trust">
                                        <span class="badge @inspectionBadgeClass"><i class="bi @inspectionIcon me-1"></i>@inspectionLabel</span>
                                        @if (car.DeliveryEnabled)
                                        {
                                            <span class="badge text-primary border-primary"><i class="bi bi-truck me-1"></i>Giao xe</span>
                                        }
                                        <span class="badge text-dark border"><i class="bi bi-patch-check me-1"></i>Hồ sơ xe</span>
                                    </div>
                                    <div class="d-flex align-items-end justify-content-between">
                                        <div>
                                            <div class="pt-price">@((p24h / 1000).ToString("N0"))K</div>
                                            <div class="small text-muted">0h - 24h</div>
                                        </div>
                                        <span class="btn btn-sm btn-outline-primary">Chi tiết</span>
                                    </div>
                                </div>
                            </article>
                        </a>
                    </div>
                }

                @if (!cars.Any())
                {
                    <div class="col-12">
                        <div class="pt-shell p-5 text-center">
                            <i class="bi bi-calendar-x display-4 text-danger opacity-75 d-block mb-3"></i>
                            <h4 class="fw-bold">Không tìm thấy xe phù hợp</h4>
                            <p class="text-muted">Thử đổi thời gian thuê, khu vực hoặc bộ lọc giá.</p>
                            <a asp-action="Index" class="btn btn-outline-danger">Bỏ lọc</a>
                        </div>
                    </div>
                }
            </div>

            @if (ViewBag.TotalCars > 0 && ViewBag.CurrentPage < ViewBag.TotalPages)
            {
                <div class="text-center mt-4" id="loadMoreContainer">
                    <button type="button" id="btnLoadMore" class="btn btn-outline-primary px-5" onclick="loadMoreCars()">
                        <span id="loadMoreText"><i class="bi bi-arrow-clockwise me-2"></i>Xem thêm @(Math.Min(ViewBag.PageSize, ViewBag.TotalCars - ViewBag.CurrentPage * ViewBag.PageSize)) xe</span>
                    </button>
                </div>
            }

            @if (ViewBag.TotalCars > 0)
            {
                <div class="text-center mt-3 mb-4">
                    <span class="text-muted small" id="showingCarsText">Hiển thị @(Math.Min((ViewBag.CurrentPage - 1) * ViewBag.PageSize + 1, ViewBag.TotalCars)) - @(Math.Min(ViewBag.CurrentPage * ViewBag.PageSize, ViewBag.TotalCars)) trong @ViewBag.TotalCars xe</span>
                </div>
            }
        </section>
    </div>
</form>

@section Scripts {
<script>
let currentPage = @ViewBag.CurrentPage;

function loadMoreCars() {
    currentPage++;
    $('#btnLoadMore').prop('disabled', true);
    $('#loadMoreText').html('<span class="spinner-border spinner-border-sm me-2"></span>Đang tải...');

    $.get('@Url.Action("LoadMoreCars", "Car")', {
        q: '@Context.Request.Query["q"]',
        brandId: '@Context.Request.Query["brandId"]',
        category: '@Context.Request.Query["category"]',
        location: '@Context.Request.Query["location"]',
        startDate: '@Context.Request.Query["startDate"]',
        endDate: '@Context.Request.Query["endDate"]',
        sort: '@Context.Request.Query["sort"]',
        isPremium: '@Context.Request.Query["isPremium"]',
        contractId: '@Context.Request.Query["contractId"]',
        minPrice: '@Context.Request.Query["minPrice"]',
        maxPrice: '@Context.Request.Query["maxPrice"]',
        page: currentPage
    }, function(data) {
        if (data.cars && data.cars.length > 0) {
            let html = '';
            data.cars.forEach(function(car) {
                html += `
                <div class="col-xl-4 col-md-6">
                    <a href="/Car/Details/${car.carId}?duration=24" class="pt-car-card">
                        <article class="card catalog-card h-100 overflow-hidden">
                            <div class="position-relative">
                                <img src="${car.imageUrl}" class="car-image" alt="${car.carName}" loading="lazy" decoding="async">
                                ${car.isPremium ? '<span class="badge bg-dark position-absolute top-0 start-0 m-2"><i class="bi bi-gem text-warning me-1"></i>Premium</span>' : ''}
                                ${car.isElectric ? '<span class="badge bg-primary position-absolute top-0 end-0 m-2"><i class="bi bi-lightning-charge-fill me-1"></i>Điện</span>' : ''}
                            </div>
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="small text-muted fw-bold text-uppercase">${car.brandName || ''}</span>
                                    <span class="small fw-bold text-warning"><i class="bi bi-star-fill"></i> ${Number(car.avgRating || 5).toFixed(1)}</span>
                                </div>
                                <h5 class="catalog-card-title mb-2">${car.carName}</h5>
                                <div class="catalog-card-location mb-2">
                                    <i class="bi bi-geo-alt me-1"></i>${car.locationName || 'Điểm nhận xe linh hoạt'}
                                </div>
                                <div class="d-flex flex-wrap gap-3 text-muted small mb-3">
                                    <span><i class="bi bi-gear me-1"></i>${car.transmission || ''}</span>
                                    <span><i class="bi bi-people me-1"></i>${car.seats} chỗ</span>
                                </div>
                                <div class="catalog-card-trust">
                                    <span class="badge text-success border-success"><i class="bi bi-shield-check me-1"></i>Đăng kiểm hợp lệ</span>
                                    <span class="badge text-dark border"><i class="bi bi-patch-check me-1"></i>Hồ sơ xe</span>
                                </div>
                                <div class="d-flex align-items-end justify-content-between">
                                    <div>
                                        <div class="pt-price">${(car.pricePerDay / 1000).toLocaleString('vi-VN')}K</div>
                                        <div class="small text-muted">0h - 24h</div>
                                    </div>
                                    <span class="btn btn-sm btn-outline-primary">Chi tiết</span>
                                </div>
                            </div>
                        </article>
                    </a>
                </div>`;
            });
            $('#carGrid').append(html);

            currentPage = data.currentPage;
            if (data.hasMore) {
                $('#loadMoreText').html('<i class="bi bi-arrow-clockwise me-2"></i>Xem thêm ' + data.remaining + ' xe');
                $('#btnLoadMore').prop('disabled', false);
            } else {
                $('#loadMoreContainer').hide();
            }

            $('#showingCarsText').text('Hiển thị 1 - ' + Math.min(currentPage * 12, data.totalCars) + ' trong ' + data.totalCars + ' xe');
        } else {
            $('#loadMoreContainer').hide();
        }
    }).fail(function() {
        $('#loadMoreText').html('<i class="bi bi-arrow-clockwise me-2"></i>Thử lại');
        $('#btnLoadMore').prop('disabled', false);
    });
}
</script>
}
