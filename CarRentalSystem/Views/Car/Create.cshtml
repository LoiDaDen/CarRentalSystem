@model CarRentalSystem.Models.Car
@{
    ViewData["Title"] = "Add New Car";
    Layout = "_AdminLayout";
    var serviceTypes = ViewBag.ServiceTypes as IEnumerable<CarRentalSystem.Models.ServiceType>;
}

<h2 class="mb-4">Add New Car</h2>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Loại dịch vụ</label>
                        <select asp-for="ServiceTypeID" class="form-select" required>
                            @if (serviceTypes != null)
                            {
                                @foreach (var serviceType in serviceTypes)
                                {
                                    <option value="@serviceType.ServiceTypeID" data-code="@serviceType.Code">@serviceType.Name</option>
                                }
                            }
                        </select>
                        <small class="text-muted">Thuê xe tự lái không được cấu hình tài xế. Xe có tài xế sẽ chờ duyệt riêng.</small>
                    </div>
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Brand</label>
                            <select asp-for="BrandID" class="form-select" required>
                                <option value="">Select Brand</option>
                                @foreach (var b in ViewBag.Brands) { <option value="@b.BrandID">@b.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Car Type</label>
                            <select asp-for="CarTypeID" class="form-select" required>
                                <option value="">Select Type</option>
                                @foreach (var t in ViewBag.CarTypes) { <option value="@t.CarTypeID">@t.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Car Name (Model)</label>
                            <input asp-for="CarName" class="form-control" required />
                        </div>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">License Plate</label>
                            <input asp-for="LicensePlate" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">VIN</label>
                            <input asp-for="VIN" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Number of Seats</label>
                            <input type="number" asp-for="Seats" class="form-control" required />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Location (Regional Server)</label>
                            <select asp-for="LocationID" class="form-select" required>
                                <option value="">Select Region</option>
                                @foreach (var l in ViewBag.Locations) { <option value="@l.LocationID">@l.Name</option> }
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Price Per Day (VND)</label>
                            <input type="number" step="0.01" asp-for="PricePerDay" class="form-control" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Status</label>
                            <select asp-for="CarStatusID" class="form-select">
                                <option value="1">Available</option>
                                <option value="3">Maintenance</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Car Image (.jpg, .png)</label>
                        <input type="file" name="imageFile" class="form-control" accept="image/*" required />
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-action="Manage" class="btn btn-secondary">Cancel</a>
                        <button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Save Car</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
