@{ 
    ViewData["Title"] = "Xác nhận Lịch trình & Giá thuê";
    var car = ViewBag.Car as CarRentalSystem.Models.Car;
    var contract = ViewBag.Contract as CarRentalSystem.Models.ContractType;
    var duration = ViewBag.Duration as string;
    var name = ViewBag.CustomerName as string;
    var phone = ViewBag.CustomerPhone as string;
    var selectedDatesStr = ViewBag.SelectedDates as string;

    // Selected driver rate
    decimal dRate = 0;
    if (ViewBag.SelectedDriver != null)
    {
        var driver = (CarRentalSystem.Models.Driver)ViewBag.SelectedDriver;
        dRate = driver.DailyRate;
    }

    // Calculate total contract price
    decimal pricePerDay = car.PricePerDay;
    decimal discountPct = contract.DiscountPercent;
    
    decimal totalBaseCostPerDay = pricePerDay + dRate;
    decimal discountedPerDay = totalBaseCostPerDay * (1 - discountPct / 100m);
    
    // Parse dates
    DateTime parsedStart = ViewBag.StartDateStr != null ? DateTime.Parse(ViewBag.StartDateStr) : DateTime.Now;
    DateTime parsedEnd = parsedStart;
    bool isCustomDate = !string.IsNullOrEmpty(selectedDatesStr);
    List<DateTime> customDateList = new List<DateTime>();
    
    // Parse duration to calculate total days
    int totalDays = 30; // default
    if (isCustomDate)
    {
        customDateList = selectedDatesStr.Split(',')
            .Where(d => !string.IsNullOrWhiteSpace(d))
            .Select(d => DateTime.Parse(d))
            .OrderBy(d => d)
            .ToList();
        totalDays = customDateList.Count;
        if (totalDays <= 0) totalDays = 1;
        parsedStart = customDateList.First();
        parsedEnd = customDateList.Last().AddDays(1);
    }
    else if (!string.IsNullOrEmpty(duration))
    {
        var parts = duration.Split(' ');
        if (parts.Length >= 2)
        {
            int num = 1;
            int.TryParse(parts[0], out num);
            if (num == 0) num = 1;
            
            var unit = parts[1].ToLower();
            if (unit.Contains("năm")) totalDays = num * 365;
            else if (unit.Contains("tháng")) totalDays = num * 30;
            else if (unit.Contains("tuần")) totalDays = num * 7;
            else if (unit.Contains("ngày")) totalDays = num;
        }
        parsedEnd = parsedStart.AddDays(totalDays);
    }
    decimal membershipDiscountPct = ViewBag.MembershipTier != null ? ViewBag.MembershipTier.DiscountPercent : 0;
    decimal totalContractPriceBeforeMem = discountedPerDay * totalDays;
    decimal memDiscountAmount = totalContractPriceBeforeMem * (membershipDiscountPct / 100m);
    decimal totalContractPrice = totalContractPriceBeforeMem - memDiscountAmount;
}

<div class="container py-5 mt-5">
    <div class="row gx-lg-5 justify-content-center">
        <!-- Left: Car Details (Summary) -->
        <div class="col-lg-5 mb-4">
            <h4 class="fw-bolder mb-4 text-dark"><i class="bi bi-calendar2-check text-primary me-2"></i>THÔNG TIN CHUYẾN ĐI</h4>
            <div class="card shadow-sm border-0 rounded-4">
                <div class="position-relative">
                    <img src="@(string.IsNullOrEmpty(car.ImageURL) ? "https://images.unsplash.com/photo-1549317661-bd32c8ce0db2?auto=format&fit=crop&q=80&w=600" : car.ImageURL)" 
                         class="card-img-top object-fit-cover" style="height: 250px; border-top-left-radius: 1rem; border-top-right-radius: 1rem;" alt="@car.CarName">
                    <span class="position-absolute top-0 start-0 m-3 badge bg-success fs-6 rounded-pill">@car.CarBrand?.Name</span>
                </div>
                <div class="card-body p-4">
                    <h5 class="fw-bolder mb-1">@car.CarName</h5>
                    <p class="text-muted small mb-3">Biển số: @car.LicensePlate • @car.Seats Chỗ</p>
                    
                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                        <span class="text-muted">Nhận xe:</span>
                        <span class="fw-bold">@parsedStart.ToString("HH:mm - dd/MM/yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2 pb-2 border-bottom">
                        <span class="text-muted">Trả xe:</span>
                        <span class="fw-bold">@parsedEnd.ToString("HH:mm - dd/MM/yyyy")</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Tổng ngày thuê:</span>
                        <span class="fw-bold text-dark">@totalDays ngày</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Checkout Details -->
        <div class="col-lg-6">
            <h4 class="fw-bolder mb-4 text-dark"><i class="bi bi-wallet2 text-success me-2"></i>CHI TIẾT TRẢ TOÁN & XÁC NHẬN</h4>
            
            <div class="card shadow-sm border-0 rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">Thông tin người đặt</h5>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Họ tên / Doanh nghiệp</label>
                            <input type="text" form="signForm" name="customerName" class="form-control form-control-sm shadow-none bg-light" value="@name" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1">Số điện thoại</label>
                            <input type="text" form="signForm" name="customerPhone" class="form-control form-control-sm shadow-none bg-light" value="@phone" required />
                        </div>
                    </div>

                    <h5 class="fw-bold mb-3 border-bottom pb-2">Gói cước dài hạn</h5>
                    <table class="table table-borderless table-sm mb-4">
                        <tbody>
                            <tr>
                                <td class="text-muted" style="width:180px">Gói áp dụng:</td>
                                <th class="text-primary fs-6">@contract.Name</th>
                            </tr>
                            <tr>
                                <td class="text-muted">Thời hạn gốc:</td>
                                <th>@duration</th>
                            </tr>
                            <tr>
                                <td class="text-muted">Quyền lợi:</td>
                                <th>Miễn phí bảo dưỡng @contract.FreeMaintenanceCount lần</th>
                            </tr>
                        </tbody>
                    </table>

                    <div class="bg-light p-3 p-md-4 rounded-3 mb-4 border">
                        <h6 class="fw-bold mb-3"><i class="bi bi-receipt me-2"></i>Tóm tắt chi phí</h6>
                        <div class="d-flex justify-content-between mb-2 small">
                            <span>Giá thuê cơ bản (@totalDays ngày):</span>
                            <span class="fw-bold">@string.Format("{0:N0}", pricePerDay * totalDays) VNĐ</span>
                        </div>
                        @if (dRate > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 small">
                                <span>Phí Dịch vụ Tài xế (@totalDays ngày):</span>
                                <span class="fw-bold">@string.Format("{0:N0}", dRate * totalDays) VNĐ</span>
                            </div>
                        }
                        
                        @if (discountPct > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 small">
                                <span>Giảm giá Hợp đồng Đai hạn (@contract.DiscountPercent.ToString("0.##")%):</span>
                                <span class="fw-bold text-success">-@string.Format("{0:N0}", ((pricePerDay + dRate) * totalDays) * (discountPct/100m)) VNĐ</span>
                            </div>
                        }
                        @if (memDiscountAmount > 0)
                        {
                            <div class="d-flex justify-content-between mb-2 small">
                                <span>Thành viên @ViewBag.MembershipTier?.Name (-@membershipDiscountPct%):</span>
                                <span class="fw-bold text-success">-@string.Format("{0:N0}", memDiscountAmount) VNĐ</span>
                            </div>
                        }

                        <hr>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold fs-6">Tổng chi phí thuê (Gồm Tài xế nếu có):</span>
                            <h5 class="fw-bold text-success mb-0">@string.Format("{0:N0}", totalContractPrice) VNĐ</h5>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-0 mt-3 pt-3 border-top">
                            <span class="fw-bold text-muted">Tiền thế chấp (Cọc):</span>
                            <span class="fw-bold text-dark fs-5">@string.Format("{0:N0}", car.DefaultDeposit) VNĐ</span>
                        </div>
                    </div>

                    <div class="alert alert-info border-0 p-3 rounded-3 mb-0" style="background-color: #eef2ff;">
                        <div class="d-flex">
                            <i class="bi bi-info-circle text-primary fs-4 me-3"></i>
                            <div>
                                <h6 class="fw-bold mb-1 text-primary">Quy trình Đặt Xe An Toàn</h6>
                                <p class="small text-muted mb-3">Với gói thuê dài hạn, bạn sẽ thực hiện xác nhận yêu cầu & kiểm tra xe trước, sau đó tiến hành thanh toán Tiền Cọc, và cuối cùng ký hợp đồng điện tử khi nhận xe.</p>
                                
                                <form asp-action="VehicleInspection" method="get" id="signForm">
                                    <input type="hidden" name="carId" value="@car.CarID" />
                                    <input type="hidden" name="contractId" value="@contract.ContractTypeID" />
                                    <input type="hidden" name="duration" value="@duration" />
                                    <input type="hidden" name="customerName" form="signForm" value="@name" />
                                    <input type="hidden" name="customerPhone" form="signForm" value="@phone" />
                                    <input type="hidden" name="startDateStr" value="@ViewBag.StartDateStr" />
                                    <input type="hidden" name="selectedDates" value="@ViewBag.SelectedDates" />
                                    <input type="hidden" name="selectedDriverId" value="" />

                                    <div class="d-grid gap-2">
                                        <button type="submit" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                            <i class="bi bi-camera-fill me-2"></i>XEM XE 360° VÀ ĐẶT CỌC
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
