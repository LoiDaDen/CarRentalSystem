@model CarRentalSystem.Models.User
@{
    ViewData["Title"] = "Định danh eKYC";
}

<style>
    .ekyc-header { background: linear-gradient(135deg, #1e3a8a, #3b82f6); color: white; padding: 40px 0; border-radius: 16px; margin-bottom: 30px; }
    .ekyc-card { border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 10px 25px rgba(0,0,0,0.05); padding: 24px; background: white; margin-bottom: 24px; transition: 0.3s; }
    .ekyc-card:hover { border-color: #3b82f6; }
    .upload-zone {
        border: 2px dashed #cbd5e1; border-radius: 12px; background: #f8fafc;
        padding: 30px 20px; text-align: center; cursor: pointer; position: relative; overflow: hidden;
        transition: all 0.2s; min-height: 150px; display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .upload-zone:hover { border-color: #3b82f6; background: #eff6ff; }
    .upload-zone i { font-size: 3rem; color: #94a3b8; margin-bottom: 10px; transition: 0.2s; }
    .upload-zone:hover i { color: #3b82f6; transform: scale(1.1); }
    .upload-zone .preview-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; background: #000; display: none; z-index: 2; }
    .upload-zone.has-preview i,
    .upload-zone.has-preview span { display: none; }
    .clear-btn { position: absolute; top: 5px; right: 5px; z-index: 3; background: rgba(239,68,68,0.9); color: white; border: none; border-radius: 50%; width: 28px; height: 28px; cursor: pointer; display: none; font-size: 0.8rem; }
    .upload-zone.has-preview .clear-btn { display: flex; align-items: center; justify-content: center; }
    .status-badge { padding: 8px 16px; border-radius: 20px; font-weight: 700; font-size: 0.9rem; }
</style>

<div class="container my-4">
    <div class="ekyc-header text-center">
        <h1><i class="bi bi-shield-check me-2"></i>Hồ sơ eKYC</h1>
        <p class="mb-0 text-white-50">Tải lên giấy tờ để Admin xác minh danh tính</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm rounded-4"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm rounded-4"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
    }

    <div class="row">
        <!-- Upload Form -->
        <div class="col-12">
            <form asp-action="Submit" method="post" enctype="multipart/form-data">
                <div class="ekyc-card">
                    <h5 class="fw-bold mb-4"><i class="bi bi-cloud-upload me-2 text-primary"></i>Tải lên tài liệu</h5>
                    <p class="text-muted small mb-3">Vui lòng tải lên đầy đủ các giấy tờ bên dưới để hoàn tất xác minh danh tính.</p>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">1. Căn Cước Công Dân (Mặt Trước)</label>
                            <label class="upload-zone w-100" id="idFrontZone">
                                <i class="bi bi-credit-card-2-front"></i>
                                <span class="fw-bold text-dark">Click để chọn ảnh</span>
                                <input type="file" name="idFront" class="d-none" accept="image/*" onchange="previewImage(this, 'idFrontZone', 'idFrontPreview')">
                                <img id="idFrontPreview" class="preview-img" alt="Preview">
                                <button type="button" class="clear-btn" onclick="clearImage(event, 'idFront')"><i class="bi bi-x"></i></button>
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">2. Căn Cước Công Dân (Mặt Sau)</label>
                            <label class="upload-zone w-100" id="idBackZone">
                                <i class="bi bi-credit-card-2-back"></i>
                                <span class="fw-bold text-dark">Click để chọn ảnh</span>
                                <input type="file" name="idBack" class="d-none" accept="image/*" onchange="previewImage(this, 'idBackZone', 'idBackPreview')">
                                <img id="idBackPreview" class="preview-img" alt="Preview">
                                <button type="button" class="clear-btn" onclick="clearImage(event, 'idBack')"><i class="bi bi-x"></i></button>
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">3. Giấy Phép Lái Xe (GPLX) - Mặt Trước</label>
                            <label class="upload-zone w-100" id="licenseZone">
                                <i class="bi bi-card-text"></i>
                                <span class="fw-bold text-dark">Click để chọn ảnh</span>
                                <input type="file" name="license" class="d-none" accept="image/*" onchange="previewImage(this, 'licenseZone', 'licensePreview')">
                                <img id="licensePreview" class="preview-img" alt="Preview">
                                <button type="button" class="clear-btn" onclick="clearImage(event, 'license')"><i class="bi bi-x"></i></button>
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">4. Giấy Phép Lái Xe (GPLX) - Mặt Sau</label>
                            <label class="upload-zone w-100" id="licenseBackZone">
                                <i class="bi bi-card-text"></i>
                                <span class="fw-bold text-dark">Click để chọn ảnh</span>
                                <input type="file" name="licenseBack" class="d-none" accept="image/*" onchange="previewImage(this, 'licenseBackZone', 'licenseBackPreview')">
                                <img id="licenseBackPreview" class="preview-img" alt="Preview">
                                <button type="button" class="clear-btn" onclick="clearImage(event, 'licenseBack')"><i class="bi bi-x"></i></button>
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">5. Ảnh Chân Dung (Selfie)</label>
                            <label class="upload-zone w-100" id="faceZone">
                                <i class="bi bi-person-bounding-box"></i>
                                <span class="fw-bold text-dark">Click để chọn ảnh</span>
                                <input type="file" name="face" class="d-none" accept="image/*" onchange="previewImage(this, 'faceZone', 'facePreview')">
                                <img id="facePreview" class="preview-img" alt="Preview">
                                <button type="button" class="clear-btn" onclick="clearImage(event, 'face')"><i class="bi bi-x"></i></button>
                            </label>
                        </div>
                    </div>
                </div>

                <div class="ekyc-card">
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                        <label class="form-check-label" for="agreeTerms">
                            Tôi xác nhận các giấy tờ tải lên là chính xác và đồng ý để Admin xác minh
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm">
                        <i class="bi bi-send me-2"></i>Gửi hồ sơ eKYC
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewImage(input, zoneId, previewId) {
            const file = input.files[0];
            const zone = document.getElementById(zoneId);
            const preview = document.getElementById(previewId);
            
            if (file) {
                const url = URL.createObjectURL(file);
                preview.src = url;
                preview.style.display = 'block';
                zone.classList.add('has-preview');
            }
        }

        function clearImage(event, inputName) {
            event.preventDefault();
            event.stopPropagation();
            
            const input = document.querySelector(`input[name="${inputName}"]`);
            const zone = input.closest('.upload-zone');
            const preview = zone.querySelector('img');
            
            input.value = '';
            preview.src = '';
            preview.style.display = 'none';
            zone.classList.remove('has-preview');
        }
    </script>
}
