@model CarRentalSystem.Models.User
@{
    ViewData["Title"] = "Định danh điện tử (eKYC)";
}

<style>
    .ekyc-header { background: linear-gradient(135deg, #1e3a8a, #3b82f6); color: white; padding: 40px 0; border-radius: 16px; margin-bottom: 30px; }
    .ekyc-card { border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 10px 25px rgba(0,0,0,0.05); padding: 24px; background: white; margin-bottom: 24px; transition: 0.3s; }
    .ekyc-card:hover { border-color: #3b82f6; }
    .upload-zone {
        border: 2px dashed #cbd5e1; border-radius: 12px; background: #f8fafc;
        padding: 30px 20px; text-align: center; cursor: pointer; position: relative; overflow: hidden;
        transition: all 0.2s; height: 200px; display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .upload-zone:hover { border-color: #3b82f6; background: #eff6ff; }
    .upload-zone i { font-size: 2.5rem; color: #94a3b8; margin-bottom: 10px; transition: 0.2s; }
    .upload-zone:hover i { color: #3b82f6; transform: scale(1.1); }
    .upload-zone .preview-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; background: #000; display: none; z-index: 2; }
    .status-badge { padding: 8px 16px; border-radius: 20px; font-weight: 700; font-size: 0.9rem; }
    #scannerOverlay {
        position: fixed; top: 0; left: 0; width: 100vw; height: 100vh;
        background: rgba(15,23,42,0.9); z-index: 9999; display: none;
        align-items: center; justify-content: center; flex-direction: column;
    }
    .face-scanner {
        width: 250px; height: 250px; border: 4px solid #3b82f6; border-radius: 20px;
        position: relative; overflow: hidden; box-shadow: 0 0 40px rgba(59,130,246,0.4);
    }
    .face-scanner::before {
        content: ''; position: absolute; width: 100%; height: 5px;
        background: #10b981; top: -5px; box-shadow: 0 0 15px #10b981;
        animation: scanBar 2s linear infinite;
    }
    @@keyframes scanBar { 0% { top: -5px; } 50% { top: 100%; } 100% { top: -5px; } }
    .scan-text { color: white; margin-top: 20px; font-weight: 700; font-size: 1.2rem; letter-spacing: 1px; }
</style>

<div class="container my-4">
    <div class="ekyc-header text-center">
        <h1><i class="bi bi-shield-check me-2"></i>Hệ thống Định danh eKYC Tự Động</h1>
        <p class="mb-0 text-white-50">Tích hợp Trí tuệ Nhân tạo FPT.AI - An toàn, Bảo mật, Nhanh chóng</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger shadow-sm rounded-4"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm rounded-4"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
    }

    <div class="row">
        <!-- Status Panel -->
        <div class="col-lg-4">
            <div class="ekyc-card bg-light">
                <h5 class="fw-bold mb-3">Tình trạng hồ sơ</h5>
                <div class="d-flex align-items-center mb-3">
                    <span class="me-auto text-muted">Trạng thái:</span>
                    @if (Model.VerificationStatus == "Verified")
                    {
                        <span class="status-badge bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle-fill me-1"></i>Đã phê duyệt</span>
                    }
                    else if (Model.VerificationStatus == "Pending")
                    {
                        <span class="status-badge bg-warning bg-opacity-10 text-warning"><i class="bi bi-clock-fill me-1"></i>Chờ xác thực</span>
                    }
                    else
                    {
                        <span class="status-badge bg-danger bg-opacity-10 text-danger"><i class="bi bi-x-circle-fill me-1"></i>Bị từ chối</span>
                    }
                </div>
                <hr>
                <div class="small text-muted">
                    <i class="bi bi-info-circle text-primary me-1"></i> Hồ sơ được bảo vệ bằng mã hóa End-to-End. Nhân viên hệ thống cũng không thể xem trực tiếp giấy tờ của bạn.
                </div>
            </div>
        </div>

        <!-- Upload Form -->
        <div class="col-lg-8">
            <form id="ekycForm" asp-action="Submit" method="post" enctype="multipart/form-data">
                <div class="ekyc-card">
                    <h5 class="fw-bold mb-4"><i class="bi bi-cloud-upload me-2 text-primary"></i>Tải lên tài liệu</h5>

                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">1. Căn Cước Công Dân (Mặt Trước)</label>
                            <label class="upload-zone" for="idFront">
                                <i class="bi bi-credit-card-2-front"></i>
                                <span class="fw-bold text-dark">Tải lên hoặc Chụp ảnh</span>
                                <span class="small text-muted mt-1">(Bằng Camera hoặc từ máy)</span>
                                <input type="file" id="idFront" name="idFront" class="d-none" accept="image/*" required>
                                <img id="idFrontPreview" class="preview-img" alt="Preview">
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">2. Căn Cước Công Dân (Mặt Sau)</label>
                            <label class="upload-zone" for="idBack">
                                <i class="bi bi-credit-card-2-back"></i>
                                <span class="fw-bold text-dark">Tải lên hoặc Chụp ảnh</span>
                                <span class="small text-muted mt-1">(Bằng Camera hoặc từ máy)</span>
                                <input type="file" id="idBack" name="idBack" class="d-none" accept="image/*" required>
                                <img id="idBackPreview" class="preview-img" alt="Preview">
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">3. Giấy Phép Lái Xe (GPLX)</label>
                            <label class="upload-zone" for="idLicense">
                                <i class="bi bi-card-text"></i>
                                <span class="fw-bold text-dark">Tải lên hoặc Chụp ảnh</span>
                                <span class="small text-muted mt-1">(Bằng Camera hoặc từ máy)</span>
                                <input type="file" id="idLicense" name="idLicense" class="d-none" accept="image/*" required>
                                <img id="idLicensePreview" class="preview-img" alt="Preview">
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold small text-muted">4. Ảnh Chân Dung (Selfie)</label>
                            <label class="upload-zone" for="idFace">
                                <i class="bi bi-person-bounding-box"></i>
                                <span class="fw-bold text-dark">Chụp ảnh chân dung</span>
                                <span class="small text-muted mt-1">(Hướng mặt vào camera, đủ ánh sáng)</span>
                                <input type="file" id="idFace" name="idFace" class="d-none" accept="image/*" capture="user" required>
                                <img id="idFacePreview" class="preview-img" alt="Preview">
                            </label>
                        </div>
                    </div>
                </div>

                <div class="ekyc-card">
                    <h5 class="fw-bold mb-3"><i class="bi bi-shield-lock text-warning me-2"></i>Xác nhận & Bảo mật</h5>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                        <label class="form-check-label" for="agreeTerms">
                            Tôi xác nhận các giấy tờ trên là chính xác và đồng ý với <a href="#">Điều khoản sử dụng</a>
                        </label>
                    </div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm">
                        <i class="bi bi-send me-2"></i>Gửi hồ sơ xác thực
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Scanner overlay -->
<div id="scannerOverlay">
    <div class="face-scanner"></div>
    <div class="scan-text">ĐANG QUÉT KHUÔN MẶT...</div>
</div>

@section Scripts {
    <script>
        // Image preview helper
        function setupPreview(inputId, previewId) {
            const inp = document.getElementById(inputId), prev = document.getElementById(previewId);
            if (!inp || !prev) return;
            inp.addEventListener('change', () => {
                const file = inp.files[0];
                if (file) {
                    const url = URL.createObjectURL(file);
                    prev.src = url; prev.style.display = 'block';
                }
            });
        }
        ['idFront','idBack','idLicense','idFace'].forEach(id => setupPreview(id, id+'Preview'));

        // Face scan overlay toggle
        document.getElementById('idFace')?.addEventListener('click', () => {
            document.getElementById('scannerOverlay').style.display = 'flex';
        });
        document.getElementById('idFace')?.addEventListener('change', () => {
            document.getElementById('scannerOverlay').style.display = 'none';
        });
    </script>
}
