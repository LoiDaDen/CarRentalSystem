@model CarRentalSystem.Models.User
@{
    ViewData["Title"] = "Định danh eKYC";
    var status = (ViewBag.Status as string) ?? Model.VerificationStatus;
    var currentReturnUrl = (Context.Request.Path + Context.Request.QueryString).ToString();
}

<style>
    @@keyframes ekycSpin { to { transform: rotate(360deg); } }

    .ekyc-hero {
        background: linear-gradient(135deg, #0f172a, #1d4ed8);
        color: #fff;
        border-radius: 24px;
        padding: 34px;
        margin-bottom: 24px;
        box-shadow: 0 24px 70px rgba(37, 99, 235, .22);
    }

    .ekyc-card {
        border: 1px solid #e2e8f0;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 18px 45px rgba(15, 23, 42, .08);
        padding: 22px;
        margin-bottom: 20px;
    }

    .ekyc-mode-tabs .nav-link {
        border: 1px solid #dbeafe;
        border-radius: 16px;
        color: #1e3a8a;
        font-weight: 700;
        padding: 14px 18px;
    }

    .ekyc-mode-tabs .nav-link.active {
        background: #2563eb;
        border-color: #2563eb;
        color: #fff;
        box-shadow: 0 12px 30px rgba(37, 99, 235, .26);
    }

    .ekyc-upload-card {
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        background: #f8fafc;
        padding: 16px;
        height: 100%;
    }

    .ekyc-file-preview {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 12px;
        padding: 10px;
        border: 1px solid #dbeafe;
        border-radius: 14px;
        background: #fff;
    }

    .ekyc-file-preview img {
        width: 76px;
        height: 54px;
        border-radius: 10px;
        object-fit: cover;
        border: 1px solid #e5e7eb;
        background: #f8fafc;
    }

    .ekyc-file-preview strong,
    .ekyc-file-preview span {
        display: block;
        overflow-wrap: anywhere;
    }

    .ekyc-face-capture {
        border: 1px solid #dbeafe;
        border-radius: 22px;
        background: linear-gradient(180deg, #eff6ff, #fff);
        padding: 18px;
    }

    .ekyc-camera-stage {
        position: relative;
        overflow: hidden;
        border-radius: 22px;
        background: #0f172a;
        aspect-ratio: 16 / 9;
        min-height: 260px;
        max-height: 420px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .ekyc-camera-stage video,
    .ekyc-camera-stage img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 22px;
    }

    .ekyc-face-frame {
        position: absolute;
        width: min(40%, 210px);
        aspect-ratio: 3 / 4;
        border: 3px solid rgba(96, 165, 250, .95);
        border-radius: 50%;
        box-shadow: 0 0 0 999px rgba(15, 23, 42, .42), 0 0 35px rgba(96, 165, 250, .45);
        pointer-events: none;
    }

    .ekyc-face-hint {
        position: absolute;
        left: 14px;
        right: 14px;
        bottom: 14px;
        border-radius: 14px;
        background: rgba(15, 23, 42, .72);
        color: #e0f2fe;
        padding: 10px 12px;
        font-size: .88rem;
    }

    .ekyc-qr-box {
        border: 1px solid #bfdbfe;
        border-radius: 24px;
        background: linear-gradient(180deg, #eff6ff, #fff);
        padding: 24px;
    }

    .ekyc-qr-image {
        width: min(280px, 100%);
        background: #fff;
        border-radius: 20px;
        padding: 14px;
        border: 1px solid #dbeafe;
        box-shadow: 0 16px 40px rgba(15, 23, 42, .12);
    }

    [data-ekyc-mobile-status] {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border-radius: 999px;
        padding: 8px 12px;
        background: #eef2ff;
        color: #3730a3;
        font-weight: 700;
    }

    [data-ekyc-mobile-status][data-state="Verified"] { background: #dcfce7; color: #166534; }
    [data-ekyc-mobile-status][data-state="PendingReview"] { background: #fef9c3; color: #854d0e; }
    [data-ekyc-mobile-status][data-state="Rejected"],
    [data-ekyc-mobile-status][data-state="Expired"] { background: #fee2e2; color: #991b1b; }

    .ekyc-submit-overlay {
        position: fixed;
        inset: 0;
        z-index: 5000;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(15, 23, 42, .72);
        backdrop-filter: blur(3px);
    }

    .ekyc-submit-overlay.active { display: flex; }
    .ekyc-submit-panel {
        width: min(430px, calc(100vw - 32px));
        border-radius: 18px;
        background: #fff;
        padding: 28px;
        text-align: center;
        box-shadow: 0 24px 80px rgba(15, 23, 42, .35);
    }

    .ekyc-submit-spinner {
        width: 54px;
        height: 54px;
        margin: 0 auto 18px;
        border-radius: 50%;
        border: 5px solid #dbeafe;
        border-top-color: #2563eb;
        animation: ekycSpin .8s linear infinite;
    }
</style>

<div class="container my-4">
    <div class="ekyc-submit-overlay" id="ekycSubmitOverlay" aria-live="polite" aria-busy="true">
        <div class="ekyc-submit-panel">
            <div class="ekyc-submit-spinner"></div>
            <h5 class="fw-bold mb-2">Đang xác thực hồ sơ</h5>
            <p class="text-muted mb-0">Hệ thống đang xử lý OCR, đối chiếu khuôn mặt và lưu hồ sơ. Vui lòng không tắt trang.</p>
        </div>
    </div>

    <section class="ekyc-hero">
        <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
            <div>
                <div class="text-uppercase small fw-bold text-white-50 mb-2">DriveGo Identity</div>
                <h1 class="fw-black mb-2"><i class="bi bi-shield-check me-2"></i>Xác thực eKYC</h1>
                <p class="mb-0 text-white-50">Bạn có thể làm trực tiếp trên máy tính hoặc quét QR để hoàn tất bằng điện thoại.</p>
            </div>
            <span class="badge rounded-pill bg-light text-primary px-3 py-2">Trạng thái: @status</span>
        </div>
    </section>

    @if (TempData["ErrorMessage"] != null)
    {
        var errors = (TempData["EkycWarnings"] as string)?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
        <div class="alert alert-danger rounded-4 shadow-sm">
            <strong>@TempData["ErrorMessage"]</strong>
            @if (errors.Length > 0)
            {
                <ul class="mb-0 mt-2">
                    @foreach (var error in errors)
                    {
                        <li>@error</li>
                    }
                </ul>
            }
        </div>
    }

    @if (TempData["WarningMessage"] != null)
    {
        var warnings = (TempData["EkycWarnings"] as string)?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
        <div class="alert alert-warning rounded-4 shadow-sm">
            <strong>@TempData["WarningMessage"]</strong>
            @if (warnings.Length > 0)
            {
                <ul class="mb-0 mt-2">
                    @foreach (var warning in warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            }
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success rounded-4 shadow-sm">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    <ul class="nav nav-pills ekyc-mode-tabs row g-3 mb-4" id="ekycModeTabs" role="tablist">
        <li class="nav-item col-md-6" role="presentation">
            <button class="nav-link active w-100 text-start" id="desktop-tab" data-bs-toggle="pill" data-bs-target="#desktop-pane" type="button" role="tab">
                <i class="bi bi-laptop me-2"></i>Sử dụng máy tính này
                <div class="small fw-normal opacity-75 mt-1">Tải ảnh giấy tờ và chụp selfie ngay trên trình duyệt.</div>
            </button>
        </li>
        <li class="nav-item col-md-6" role="presentation">
            <button class="nav-link w-100 text-start" id="mobile-tab" data-bs-toggle="pill" data-bs-target="#mobile-pane" type="button" role="tab">
                <i class="bi bi-qr-code-scan me-2"></i>Quét QR bằng điện thoại
                <div class="small fw-normal opacity-75 mt-1">Dùng camera điện thoại để chụp giấy tờ và khuôn mặt rõ hơn.</div>
            </button>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="desktop-pane" role="tabpanel" aria-labelledby="desktop-tab">
            <form asp-action="Submit" method="post" enctype="multipart/form-data" id="ekycForm" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@currentReturnUrl" />

                <div class="ekyc-card">
                    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-3">
                        <div>
                            <h5 class="fw-bold mb-1"><i class="bi bi-credit-card-2-front text-primary me-2"></i>Căn cước công dân</h5>
                            <p class="text-muted small mb-0">Tải đủ mặt trước và mặt sau CCCD để DriveGo đọc thông tin định danh.</p>
                        </div>
                        <button type="button" class="btn btn-outline-primary rounded-pill fw-semibold" id="scanCccdBtn">
                            <i class="bi bi-search me-1"></i>Quét CCCD
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="ekyc-upload-card">
                                <label class="form-label fw-semibold">CCCD mặt trước</label>
                                <input type="file" name="idFront" id="idFront" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/*" data-ekyc-file-input required>
                                <div class="ekyc-file-preview d-none" data-ekyc-file-preview>
                                    <img class="d-none" alt="Preview" data-ekyc-file-preview-image>
                                    <div class="small">
                                        <strong data-ekyc-file-preview-name></strong>
                                        <span class="text-muted" data-ekyc-file-preview-size></span>
                                    </div>
                                </div>
                                <div class="form-text">JPG, PNG hoặc WEBP, tối đa 5MB.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="ekyc-upload-card">
                                <label class="form-label fw-semibold">CCCD mặt sau</label>
                                <input type="file" name="idBack" id="idBack" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/*" data-ekyc-file-input required>
                                <div class="ekyc-file-preview d-none" data-ekyc-file-preview>
                                    <img class="d-none" alt="Preview" data-ekyc-file-preview-image>
                                    <div class="small">
                                        <strong data-ekyc-file-preview-name></strong>
                                        <span class="text-muted" data-ekyc-file-preview-size></span>
                                    </div>
                                </div>
                                <div class="form-text">Ảnh rõ 4 góc, không lóa sáng.</div>
                            </div>
                        </div>
                    </div>
                    <div id="cccdResult" class="mt-3" aria-live="polite"></div>
                </div>

                <div class="ekyc-card">
                    <div class="d-flex flex-column flex-md-row justify-content-between gap-3 mb-3">
                        <div>
                            <h5 class="fw-bold mb-1"><i class="bi bi-card-text text-info me-2"></i>Giấy phép lái xe</h5>
                            <p class="text-muted small mb-0">Tải đủ hai mặt GPLX để đối chiếu điều kiện thuê xe tự lái.</p>
                        </div>
                        <button type="button" class="btn btn-outline-primary rounded-pill fw-semibold" id="scanLicenseBtn">
                            <i class="bi bi-search me-1"></i>Quét GPLX
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="ekyc-upload-card">
                                <label class="form-label fw-semibold">GPLX mặt trước</label>
                                <input type="file" name="license" id="license" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/*" data-ekyc-file-input required>
                                <div class="ekyc-file-preview d-none" data-ekyc-file-preview>
                                    <img class="d-none" alt="Preview" data-ekyc-file-preview-image>
                                    <div class="small">
                                        <strong data-ekyc-file-preview-name></strong>
                                        <span class="text-muted" data-ekyc-file-preview-size></span>
                                    </div>
                                </div>
                                <div class="form-text">Ảnh rõ số GPLX và hạng bằng.</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="ekyc-upload-card">
                                <label class="form-label fw-semibold">GPLX mặt sau</label>
                                <input type="file" name="licenseBack" id="licenseBack" class="form-control" accept=".jpg,.jpeg,.png,.webp,image/*" data-ekyc-file-input required>
                                <div class="ekyc-file-preview d-none" data-ekyc-file-preview>
                                    <img class="d-none" alt="Preview" data-ekyc-file-preview-image>
                                    <div class="small">
                                        <strong data-ekyc-file-preview-name></strong>
                                        <span class="text-muted" data-ekyc-file-preview-size></span>
                                    </div>
                                </div>
                                <div class="form-text">Bổ sung mặt sau để hồ sơ đầy đủ.</div>
                            </div>
                        </div>
                    </div>
                    <div id="licenseResult" class="mt-3" aria-live="polite"></div>
                </div>

                <div class="ekyc-card">
                    <h5 class="fw-bold mb-1"><i class="bi bi-person-bounding-box text-primary me-2"></i>Quét khuôn mặt</h5>
                    <p class="text-muted small mb-3">Chụp selfie trực tiếp bằng camera, nhìn thẳng và giữ mặt trong khung.</p>
                    <div class="row g-4 align-items-start">
                        <div class="col-lg-7">
                            <div class="ekyc-face-capture" data-ekyc-face-capture>
                                <input type="file" name="face" id="face" class="d-none" accept=".jpg,.jpeg,.png,.webp,image/*" data-ekyc-face-input required>
                                <div class="ekyc-camera-stage mb-3">
                                    <div class="text-center text-white-50 px-3">
                                        <i class="bi bi-camera-video fs-1 d-block mb-2"></i>
                                        <div class="fw-semibold">Camera selfie bảo mật</div>
                                        <small>Ảnh chỉ dùng cho quy trình eKYC.</small>
                                    </div>
                                    <video class="d-none" autoplay playsinline muted data-ekyc-face-video></video>
                                    <canvas class="d-none" data-ekyc-face-canvas></canvas>
                                    <img class="d-none" alt="Ảnh selfie xem trước" data-ekyc-face-preview>
                                    <div class="ekyc-face-frame"></div>
                                    <div class="ekyc-face-hint" data-ekyc-face-status>Đưa mặt vào khung, nhìn thẳng camera và giữ yên.</div>
                                </div>
                                <div class="d-flex flex-wrap gap-2">
                                    <button type="button" class="btn btn-outline-primary rounded-pill" data-ekyc-face-start>Mở camera</button>
                                    <button type="button" class="btn btn-primary rounded-pill d-none" data-ekyc-face-capture-btn>Chụp selfie</button>
                                    <button type="button" class="btn btn-light rounded-pill d-none" data-ekyc-face-retake>Chụp lại</button>
                                    <button type="button" class="btn btn-outline-success rounded-pill ms-lg-auto" id="verifyFaceBtn" disabled>
                                        <i class="bi bi-person-check me-1"></i>Xác minh khuôn mặt
                                    </button>
                                </div>
                                <div class="text-danger small mt-2 d-none" data-ekyc-face-error></div>
                            </div>
                        </div>
                        <div class="col-lg-5">
                            <div class="alert alert-info rounded-4 border-0">
                                <div class="fw-bold mb-2">Mẹo để ảnh đạt chuẩn</div>
                                <ul class="mb-0 ps-3 small">
                                    <li>Đứng nơi đủ sáng, tránh ngược sáng.</li>
                                    <li>Không đội nón, không đeo kính che mắt.</li>
                                    <li>Giữ mặt trong khung và nhìn thẳng camera.</li>
                                </ul>
                            </div>
                            <div id="faceResult" aria-live="polite"></div>
                        </div>
                    </div>
                </div>

                <div class="ekyc-card">
                    <h5 class="fw-bold mb-3">Xác nhận xử lý dữ liệu</h5>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="EkycPrivacyConsent" value="true" id="EkycPrivacyConsent" required>
                        <label class="form-check-label" for="EkycPrivacyConsent">
                            Tôi đồng ý để DriveGo xử lý ảnh CCCD/GPLX, thông tin định danh và gửi dữ liệu cần thiết cho FPT.AI nhằm xác minh điều kiện thuê xe.
                            Xem <a asp-controller="Home" asp-action="Privacy" class="fw-semibold text-decoration-none">Thông báo xử lý dữ liệu cá nhân</a>.
                        </label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" name="EkycBiometricConsent" value="true" id="EkycBiometricConsent" required>
                        <label class="form-check-label" for="EkycBiometricConsent">
                            Tôi đồng ý xử lý ảnh khuôn mặt/sinh trắc học để đối chiếu selfie với CCCD/GPLX trong quy trình eKYC.
                        </label>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                        <label class="form-check-label" for="agreeTerms">
                            Tôi xác nhận giấy tờ tải lên là chính xác và thuộc về tôi.
                        </label>
                    </div>
                    <div class="text-danger small d-none mb-3" id="ekycFormError"></div>
                    <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm" id="ekycSubmitBtn">
                        <i class="bi bi-send me-2"></i>Gửi xác thực
                    </button>
                </div>
            </form>
        </div>

        <div class="tab-pane fade" id="mobile-pane" role="tabpanel" aria-labelledby="mobile-tab">
            <div class="ekyc-qr-box" data-ekyc-mobile-session data-create-url="/Ekyc/CreateMobileSession" data-status-url="/Ekyc/MobileSessionStatus" data-return-url="@currentReturnUrl">
                @Html.AntiForgeryToken()
                <div class="row g-4 align-items-center">
                    <div class="col-lg-5 text-center">
                        <img class="ekyc-qr-image d-none" alt="Mã QR eKYC trên điện thoại" data-ekyc-qr-image>
                        <div class="mt-3">
                            <a class="small fw-semibold d-none" href="#" target="_blank" rel="noopener" data-ekyc-mobile-url></a>
                        </div>
                    </div>
                    <div class="col-lg-7">
                        <h4 class="fw-bold mb-2">Quét QR để xác thực bằng điện thoại</h4>
                        <p class="text-muted">Mã QR có hiệu lực 15 phút và chỉ dùng một lần cho tài khoản của bạn.</p>
                        <ol class="small text-muted ps-3">
                            <li>Bấm “Tạo mã QR”.</li>
                            <li>Dùng camera điện thoại quét mã và mở liên kết DriveGo.</li>
                            <li>Chụp giấy tờ, selfie rồi gửi hồ sơ. Máy tính sẽ tự cập nhật trạng thái.</li>
                        </ol>
                        <div class="d-flex flex-wrap align-items-center gap-3 my-3">
                            <button type="button" class="btn btn-primary rounded-pill fw-bold px-4" data-ekyc-create-mobile>Tạo mã QR</button>
                            <span data-ekyc-mobile-status>Chưa tạo mã</span>
                            <span class="badge rounded-pill bg-light text-dark">Còn lại: <span data-ekyc-mobile-countdown>15:00</span></span>
                        </div>
                        <div class="alert alert-info rounded-4 border-0 d-none" data-ekyc-mobile-message></div>
                        <ul class="alert alert-warning rounded-4 ps-4 d-none" data-ekyc-mobile-warnings></ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ekyc-camera.js" asp-append-version="true"></script>
    <script src="~/js/ekyc-file-preview.js" asp-append-version="true"></script>
    <script src="~/js/ekyc-mobile-session.js" asp-append-version="true"></script>
    <script>
        (() => {
            const allowedTypes = ['image/jpeg', 'image/png', 'image/webp'];
            const maxSize = 5 * 1024 * 1024;
            const form = document.getElementById('ekycForm');
            const formError = document.getElementById('ekycFormError');

            document.getElementById('scanCccdBtn')?.addEventListener('click', scanCccd);
            document.getElementById('scanLicenseBtn')?.addEventListener('click', scanLicense);
            document.getElementById('verifyFaceBtn')?.addEventListener('click', verifyFace);

            ['idFront', 'idBack', 'license', 'licenseBack', 'face'].forEach(id => {
                document.getElementById(id)?.addEventListener('change', () => {
                    validateFileInput(id);
                    updateFaceButton();
                });
            });

            form?.addEventListener('submit', event => {
                const errors = validateDesktopForm();
                if (errors.length) {
                    event.preventDefault();
                    showFormError(errors.join(' '));
                    return;
                }
                document.getElementById('ekycSubmitOverlay')?.classList.add('active');
            });

            function token() {
                return document.querySelector('#ekycForm input[name="__RequestVerificationToken"]')?.value || '';
            }

            function showFormError(message) {
                if (!formError) return;
                formError.textContent = message;
                formError.classList.remove('d-none');
            }

            function clearFormError() {
                formError?.classList.add('d-none');
            }

            function validateFileInput(id) {
                const input = document.getElementById(id);
                const file = input?.files?.[0];
                if (!file) return true;
                if (!allowedTypes.includes(file.type)) {
                    input.value = '';
                    window.DriveGoEkycFilePreview?.update(input);
                    showFormError('Định dạng ảnh không hợp lệ. Chỉ chấp nhận JPG, PNG hoặc WEBP.');
                    return false;
                }
                if (file.size > maxSize) {
                    input.value = '';
                    window.DriveGoEkycFilePreview?.update(input);
                    showFormError('Ảnh quá lớn. Vui lòng chọn ảnh nhỏ hơn 5MB.');
                    return false;
                }
                clearFormError();
                return true;
            }

            function validateDesktopForm() {
                const errors = [];
                const labels = {
                    idFront: 'CCCD mặt trước',
                    idBack: 'CCCD mặt sau',
                    license: 'GPLX mặt trước',
                    licenseBack: 'GPLX mặt sau',
                    face: 'Ảnh selfie'
                };

                Object.keys(labels).forEach(id => {
                    const input = document.getElementById(id);
                    if (!input?.files?.length) errors.push(`${labels[id]} là bắt buộc.`);
                    else validateFileInput(id);
                });

                if (!document.getElementById('EkycPrivacyConsent')?.checked || !document.getElementById('EkycBiometricConsent')?.checked)
                    errors.push('Bạn cần đồng ý đầy đủ các nội dung xử lý dữ liệu eKYC.');
                if (!document.getElementById('agreeTerms')?.checked)
                    errors.push('Bạn cần xác nhận giấy tờ tải lên là chính xác.');

                return errors;
            }

            function updateFaceButton() {
                const hasFace = Boolean(document.getElementById('face')?.files?.length);
                const hasIdFront = Boolean(document.getElementById('idFront')?.files?.length);
                const button = document.getElementById('verifyFaceBtn');
                if (button) button.disabled = !(hasFace && hasIdFront);
            }

            function appendConsents(formData) {
                formData.append('EkycPrivacyConsent', document.getElementById('EkycPrivacyConsent')?.checked ? 'true' : 'false');
                formData.append('EkycBiometricConsent', document.getElementById('EkycBiometricConsent')?.checked ? 'true' : 'false');
            }

            function ensureConsents() {
                if (document.getElementById('EkycPrivacyConsent')?.checked && document.getElementById('EkycBiometricConsent')?.checked) return true;
                showFormError('Vui lòng đồng ý thông báo xử lý dữ liệu cá nhân và xử lý sinh trắc học trước khi dùng eKYC.');
                return false;
            }

            async function scanCccd() {
                if (!ensureConsents()) return;
                const idFront = document.getElementById('idFront')?.files?.[0];
                const idBack = document.getElementById('idBack')?.files?.[0];
                if (!idFront || !idBack) {
                    showFormError('Vui lòng tải đủ CCCD mặt trước và mặt sau.');
                    return;
                }

                const formData = new FormData();
                formData.append('idFront', idFront);
                formData.append('idBack', idBack);
                appendConsents(formData);
                await postOcr('/Ekyc/ScanIdCard', formData, 'cccdResult', renderCccdResult);
            }

            async function scanLicense() {
                if (!ensureConsents()) return;
                const license = document.getElementById('license')?.files?.[0];
                if (!license) {
                    showFormError('Vui lòng tải ảnh GPLX mặt trước.');
                    return;
                }

                const formData = new FormData();
                formData.append('license', license);
                appendConsents(formData);
                await postOcr('/Ekyc/ScanLicense', formData, 'licenseResult', renderLicenseResult);
            }

            async function verifyFace() {
                if (!ensureConsents()) return;
                const face = document.getElementById('face')?.files?.[0];
                const idCard = document.getElementById('idFront')?.files?.[0];
                if (!face || !idCard) {
                    showFormError('Vui lòng chụp selfie và tải CCCD mặt trước trước khi xác minh khuôn mặt.');
                    return;
                }

                const formData = new FormData();
                formData.append('face', face);
                formData.append('idCard', idCard);
                appendConsents(formData);
                await postOcr('/Ekyc/VerifyFace', formData, 'faceResult', renderFaceResult);
            }

            async function postOcr(url, formData, resultId, renderer) {
                const resultBox = document.getElementById(resultId);
                resultBox.innerHTML = '<div class="alert alert-info rounded-4">Đang xử lý...</div>';
                try {
                    const response = await fetch(url, {
                        method: 'POST',
                        headers: { RequestVerificationToken: token() },
                        body: formData
                    });
                    const result = await response.json();
                    resultBox.innerHTML = renderer(result);
                } catch {
                    resultBox.innerHTML = '<div class="alert alert-danger rounded-4">Không thể xử lý lúc này. Vui lòng thử lại.</div>';
                }
            }

            function renderCccdResult(result) {
                if (!result.success) return renderError('Lỗi quét CCCD', result.message);
                return renderSuccess('Đã quét CCCD', [
                    ['Số CCCD', result.citizenId],
                    ['Họ tên', result.fullName],
                    ['Ngày sinh', result.dateOfBirth],
                    ['Giới tính', result.gender],
                    ['Địa chỉ', result.address]
                ]);
            }

            function renderLicenseResult(result) {
                if (!result.success) return renderError('Lỗi quét GPLX', result.message);
                return renderSuccess('Đã quét GPLX', [
                    ['Số GPLX', result.licenseNumber],
                    ['Hạng', result.licenseClass],
                    ['Họ tên', result.fullName],
                    ['Ngày sinh', result.dateOfBirth]
                ]);
            }

            function renderFaceResult(result) {
                if (!result.success) return renderError('Lỗi xác minh khuôn mặt', result.message);
                const similarity = Number.isFinite(result.similarity) ? `${result.similarity.toFixed(1)}%` : 'đang cập nhật';
                return result.isMatch
                    ? `<div class="alert alert-success rounded-4"><strong>Khuôn mặt khớp.</strong> Độ tương đồng: ${similarity}.</div>`
                    : `<div class="alert alert-warning rounded-4"><strong>Chưa khớp khuôn mặt.</strong> Độ tương đồng: ${similarity}. Vui lòng chụp lại rõ hơn.</div>`;
            }

            function renderSuccess(title, rows) {
                return `<div class="alert alert-success rounded-4"><strong>${title}</strong><div class="row g-2 mt-2">${rows.map(([label, value]) => `<div class="col-md-6 small"><span class="text-muted">${label}:</span> <span class="fw-semibold">${value || 'Không phát hiện'}</span></div>`).join('')}</div></div>`;
            }

            function renderError(title, message) {
                return `<div class="alert alert-danger rounded-4"><strong>${title}:</strong> ${message || 'Không thể xử lý ảnh.'}</div>`;
            }
        })();
    </script>
}
