@model CarRentalSystem.Models.User
@{
    ViewData["Title"] = "Định danh eKYC";
}

@section Styles {
    <style>
        @@keyframes spin { to { transform: rotate(360deg); } }
    </style>
}

<style>
    .ekyc-header { background: linear-gradient(135deg, #1e3a8a, #3b82f6); color: white; padding: 40px 0; border-radius: 16px; margin-bottom: 30px; }
    .ekyc-card { border-radius: 16px; border: 1px solid #e2e8f0; box-shadow: 0 10px 25px rgba(0,0,0,0.05); padding: 24px; background: white; margin-bottom: 24px; transition: 0.3s; }
    .ekyc-card:hover { border-color: #3b82f6; }
    .upload-zone {
        border: 2px dashed #cbd5e1; border-radius: 12px; background: #f8fafc;
        padding: 30px 20px; text-align: center; cursor: pointer; position: relative; overflow: hidden;
        transition: all 0.2s; min-height: 150px; display: flex; flex-direction: column; align-items: center; justify-content: center;
    }
    .upload-zone:hover { border-color: #3b82f6; background: #eff6ff; }
    .upload-zone i { font-size: 3rem; color: #94a3b8; margin-bottom: 10px; transition: 0.2s; }
    .upload-zone:hover i { color: #3b82f6; transform: scale(1.1); }
    .upload-zone .preview-img { position: absolute; top: 0; left: 0; width: 100%; height: 100%; object-fit: contain; background: #000; display: none; z-index: 2; }
    .upload-zone.has-preview i, .upload-zone.has-preview span { display: none; }
    .upload-zone.has-preview .ocr-status { display: none; }
    .clear-btn { position: absolute; top: 5px; right: 5px; z-index: 3; background: rgba(239,68,68,0.9); color: white; border: none; border-radius: 50%; width: 28px; height: 28px; cursor: pointer; display: none; font-size: 0.8rem; }
    .upload-zone.has-preview .clear-btn { display: flex; align-items: center; justify-content: center; }
    .status-badge { padding: 8px 16px; border-radius: 20px; font-weight: 700; font-size: 0.9rem; }

    .ocr-loading { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 4; display: none; align-items: center; justify-content: center; flex-direction: column; color: white; border-radius: 12px; }
    .ocr-loading.active { display: flex; }
    .spinner { width: 32px; height: 32px; border: 3px solid rgba(255,255,255,0.3); border-top-color: white; border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 8px; }

    .ocr-result-card { border-radius: 12px; border: 1px solid #d1fae5; background: #f0fdf4; padding: 16px; margin-top: 12px; }
    .ocr-result-card.error { border-color: #fca5a5; background: #fef2f2; }
    .ocr-field { display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px dashed #d1fae5; font-size: 0.9rem; }
    .ocr-field:last-child { border-bottom: none; }
    .ocr-field-label { color: #6b7280; font-weight: 500; }
    .ocr-field-value { color: #065f46; font-weight: 600; text-align: right; max-width: 60%; word-break: break-all; }
    .ocr-field-value.empty { color: #9ca3af; font-style: italic; }

    .ocr-section-title { font-size: 0.85rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #3b82f6; margin-bottom: 8px; }

    .scan-btn { background: linear-gradient(135deg, #3b82f6, #1d4ed8); color: white; border: none; border-radius: 8px; padding: 6px 14px; font-size: 0.8rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
    .scan-btn:hover { transform: translateY(-1px); box-shadow: 0 4px 12px rgba(59,130,246,0.4); }
    .scan-btn:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }
    .scan-btn.scanning { background: linear-gradient(135deg, #f59e0b, #d97706); }

    /* Validation error states */
    .upload-zone .validation-error {
        display: none;
        color: #dc2626;
        font-size: 0.75rem;
        font-weight: 600;
        margin-top: 4px;
        width: 100%;
    }
    .upload-zone.is-invalid {
        border-color: #dc2626 !important;
        background: #fef2f2;
    }
    .upload-zone.is-invalid i,
    .upload-zone.is-invalid span { color: #dc2626 !important; }
    .ekyc-submit-overlay {
        position: fixed;
        inset: 0;
        z-index: 5000;
        display: none;
        align-items: center;
        justify-content: center;
        background: rgba(15, 23, 42, 0.72);
        backdrop-filter: blur(3px);
    }
    .ekyc-submit-overlay.active { display: flex; }
    .ekyc-submit-panel {
        width: min(420px, calc(100vw - 32px));
        border-radius: 16px;
        background: white;
        padding: 28px;
        text-align: center;
        box-shadow: 0 24px 80px rgba(15, 23, 42, 0.35);
    }
    .ekyc-submit-spinner {
        width: 54px;
        height: 54px;
        margin: 0 auto 18px;
        border-radius: 50%;
        border: 5px solid #dbeafe;
        border-top-color: #2563eb;
        animation: spin 0.8s linear infinite;
    }
</style>

<div class="container my-4">
    <div class="ekyc-submit-overlay" id="ekycSubmitOverlay" aria-live="polite" aria-busy="true">
        <div class="ekyc-submit-panel">
            <div class="ekyc-submit-spinner"></div>
            <h5 class="fw-bold mb-2">Đang xác thực hồ sơ</h5>
            <p class="text-muted mb-0">Hệ thống đang xử lý OCR, đối chiếu khuôn mặt và lưu hồ sơ. Vui lòng không tắt trang.</p>
        </div>
    </div>

    <div class="ekyc-header text-center">
        <h1><i class="bi bi-shield-check me-2"></i>Hồ sơ eKYC</h1>
        <p class="mb-0 text-white-50">Quét CCCD/GPLX bằng FPT.AI OCR — thông tin sẽ được tự động điền</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        var errors = (TempData["EkycWarnings"] as string)?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
        <div class="alert alert-danger shadow-sm rounded-4 d-flex align-items-start">
            <i class="bi bi-x-octagon-fill me-2 mt-1"></i>
            <div>
                <strong>@TempData["ErrorMessage"]</strong>
                @if (errors.Length > 0)
                {
                    <ul class="mb-0 mt-2 ps-3">
                        @foreach (var e in errors)
                        {
                            <li>@e</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success shadow-sm rounded-4"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]</div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        var warnings = (TempData["EkycWarnings"] as string)?.Split('|', StringSplitOptions.RemoveEmptyEntries) ?? Array.Empty<string>();
        <div class="alert alert-warning shadow-sm rounded-4 d-flex align-items-start">
            <i class="bi bi-exclamation-triangle-fill me-2 mt-1"></i>
            <div>
                <strong>@TempData["WarningMessage"]</strong>
                @if (warnings.Length > 0)
                {
                    <ul class="mb-0 mt-2 ps-3">
                        @foreach (var w in warnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                }
            </div>
        </div>
    }

    <form asp-action="Submit" method="post" enctype="multipart/form-data" id="ekycForm">
        @Html.AntiForgeryToken()

        <!-- === PHAN 1: QUET CCCD === -->
        <div class="ekyc-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1"><i class="bi bi-credit-card-2-front text-primary me-2"></i>Căn Cước Công Dân (CCCD)</h5>
                    <p class="text-muted small mb-0">Tải lên ảnh CCCD mặt trước và mặt sau, hệ thống sẽ tự động quét thông tin.</p>
                </div>
                <button type="button" class="scan-btn" id="scanCccdBtn" onclick="scanCccd()">
                    <i class="bi bi-search me-1"></i>Quét CCCD
                </button>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted ocr-section-title">1. CCCD Mặt Trước</label>
                    <label class="upload-zone w-100 @(Model.IdCardFrontUrl == null ? "is-invalid" : "")" id="idFrontZone">
                        <i class="bi bi-credit-card-2-front"></i>
                        <span class="fw-bold text-dark">Click để chọn ảnh</span>
                        <input type="file" name="idFront" id="idFront" class="d-none" accept="image/jpeg,image/png,image/webp" onchange="handleIdCardUpload(this, 'idFrontZone', 'idFrontPreview', 'scanCccdBtn')">
                        <img id="idFrontPreview" class="preview-img" alt="Preview">
                        <button type="button" class="clear-btn" onclick="clearImage(event, 'idFront', 'idFrontZone', 'idFrontPreview')"><i class="bi bi-x"></i></button>
                        <div class="ocr-status small text-muted mt-1">JPG, PNG, WEBP, tối đa 5MB</div>
                        <div class="ocr-loading" id="idFrontLoading">
                            <div class="spinner"></div>
                            <small>Đang quét CCCD...</small>
                        </div>
                        <div class="validation-error" id="idFrontError">
                            <i class="bi bi-exclamation-circle me-1"></i>Vui lòng tải lên ảnh CCCD mặt trước
                        </div>
                    </label>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted ocr-section-title">2. CCCD Mặt Sau</label>
                    <label class="upload-zone w-100 @(Model.IdCardBackUrl == null ? "is-invalid" : "")" id="idBackZone">
                        <i class="bi bi-credit-card-2-back"></i>
                        <span class="fw-bold text-dark">Click để chọn ảnh</span>
                        <input type="file" name="idBack" id="idBack" class="d-none" accept="image/jpeg,image/png,image/webp" onchange="handleIdCardUpload(this, 'idBackZone', 'idBackPreview', 'scanCccdBtn')">
                        <img id="idBackPreview" class="preview-img" alt="Preview">
                        <button type="button" class="clear-btn" onclick="clearImage(event, 'idBack', 'idBackZone', 'idBackPreview')"><i class="bi bi-x"></i></button>
                        <div class="ocr-status small text-muted mt-1">JPG, PNG, WEBP, tối đa 5MB</div>
                        <div class="ocr-loading" id="idBackLoading">
                            <div class="spinner"></div>
                            <small>Đang quét CCCD...</small>
                        </div>
                        <div class="validation-error" id="idBackError">
                            <i class="bi bi-exclamation-circle me-1"></i>Vui lòng tải lên ảnh CCCD mặt sau
                        </div>
                    </label>
                </div>
            </div>

            <!-- CCCD OCR Result -->
            <div id="cccdResult" class="mt-3"></div>
        </div>

        <!-- === PHAN 2: QUET GPLX === -->
        <div class="ekyc-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-bold mb-1"><i class="bi bi-card-text text-info me-2"></i>Giấy Phép Lái Xe (GPLX)</h5>
                    <p class="text-muted small mb-0">Tải lên ảnh GPLX mặt trước để quét thông tin.</p>
                </div>
                <button type="button" class="scan-btn" id="scanLicenseBtn" onclick="scanLicense()">
                    <i class="bi bi-search me-1"></i>Quét GPLX
                </button>
            </div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted ocr-section-title">3. GPLX Mặt Trước</label>
                    <label class="upload-zone w-100 @(Model.DrivingLicenseUrl == null ? "is-invalid" : "")" id="licenseZone">
                        <i class="bi bi-card-text"></i>
                        <span class="fw-bold text-dark">Click để chọn ảnh</span>
                        <input type="file" name="license" id="license" class="d-none" accept="image/jpeg,image/png,image/webp" onchange="handleLicenseUpload(this, 'licenseZone', 'licensePreview')">
                        <img id="licensePreview" class="preview-img" alt="Preview">
                        <button type="button" class="clear-btn" onclick="clearImage(event, 'license', 'licenseZone', 'licensePreview')"><i class="bi bi-x"></i></button>
                        <div class="ocr-status small text-muted mt-1">JPG, PNG, WEBP, tối đa 5MB</div>
                        <div class="ocr-loading" id="licenseLoading">
                            <div class="spinner"></div>
                            <small>Đang quét GPLX...</small>
                        </div>
                        <div class="validation-error" id="licenseError">
                            <i class="bi bi-exclamation-circle me-1"></i>Vui lòng tải lên ảnh GPLX mặt trước
                        </div>
                    </label>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted ocr-section-title">4. GPLX Mặt Sau</label>
                    <label class="upload-zone w-100 @(Model.DrivingLicenseBackUrl == null ? "is-invalid" : "")" id="licenseBackZone">
                        <i class="bi bi-card-text"></i>
                        <span class="fw-bold text-dark">Click để chọn ảnh</span>
                        <input type="file" name="licenseBack" id="licenseBack" class="d-none" accept="image/jpeg,image/png,image/webp" onchange="handleLicenseUpload(this, 'licenseBackZone', 'licenseBackPreview')">
                        <img id="licenseBackPreview" class="preview-img" alt="Preview">
                        <button type="button" class="clear-btn" onclick="clearImage(event, 'licenseBack', 'licenseBackZone', 'licenseBackPreview')"><i class="bi bi-x"></i></button>
                        <div class="ocr-status small text-muted mt-1">JPG, PNG, WEBP, tối đa 5MB</div>
                        <div class="validation-error" id="licenseBackError">
                            <i class="bi bi-exclamation-circle me-1"></i>Vui lòng tải lên ảnh GPLX mặt sau
                        </div>
                    </label>
                </div>
            </div>

            <!-- License OCR Result -->
            <div id="licenseResult" class="mt-3"></div>
        </div>

        <!-- === PHAN 3: ANH CHAN DUNG === -->
        <div class="ekyc-card">
            <h5 class="fw-bold mb-3"><i class="bi bi-person-bounding-box text-dark me-2"></i>Ảnh Chân Dung (Selfie)</h5>
            <p class="text-muted small mb-3">Chụp selfie để xác minh khuôn mặt khớp với CCCD.</p>
            <div class="row">
                <div class="col-md-6">
                    <label class="form-label fw-bold small text-muted ocr-section-title">5. Selfie</label>
                    <div class="upload-zone w-100 @(Model.FaceUrl == null ? "is-invalid" : "") camera-zone" id="faceZone">
                        <i class="bi bi-camera-video"></i>
                        <span class="fw-bold text-dark">Chụp khuôn mặt bằng camera</span>
                        <input type="file" name="face" id="face" class="d-none" accept="image/jpeg,image/png,image/webp">
                        <video id="faceCamera" class="w-100 rounded-3 mt-2 d-none" autoplay playsinline muted></video>
                        <canvas id="faceCanvas" class="d-none"></canvas>
                        <img id="facePreview" class="preview-img" alt="Preview">
                        <div class="d-flex gap-2 justify-content-center mt-2">
                            <button type="button" class="btn btn-sm btn-outline-primary" id="startFaceCameraBtn">Mở camera</button>
                            <button type="button" class="btn btn-sm btn-primary d-none" id="captureFaceBtn">Chụp ảnh</button>
                            <button type="button" class="btn btn-sm btn-light d-none" id="retakeFaceBtn">Chụp lại</button>
                        </div>
                        <div class="ocr-status small text-muted mt-1">Bắt buộc dùng camera thật, chụp rõ mặt, không đeo kính.</div>
                        <div class="ocr-loading" id="faceLoading">
                            <div class="spinner"></div>
                            <small>Đang so sánh khuôn mặt...</small>
                        </div>
                        <div class="validation-error" id="faceError">
                            <i class="bi bi-exclamation-circle me-1"></i>Vui lòng chụp ảnh selfie bằng camera
                        </div>
                    </div>
                    <button type="button" class="scan-btn mt-2 w-100" id="verifyFaceBtn" onclick="verifyFace()" disabled>
                        <i class="bi bi-person-check me-1"></i>Xác minh khuôn mặt
                    </button>
                    <div id="faceResult" class="mt-3"></div>
                </div>
                <div class="col-md-6 d-flex align-items-center justify-content-center">
                    <div class="text-center">
                        <img src="https://img.icons8.com/color/96/verified-account.png" alt="Face verify" class="mb-3" style="opacity:0.5">
                        <p class="text-muted small">Sau khi upload CCCD & ảnh selfie,<br>bấm "Xác minh khuôn mặt" để kiểm tra khớp</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- === PHAN 4: GUI HONG SO === -->
        <div class="ekyc-card">
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                <label class="form-check-label" for="agreeTerms">
                    Tôi xác nhận các giấy tờ tải lên là chính xác. Hệ thống sẽ tự động xác minh.
                </label>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold rounded-pill shadow-sm" id="ekycSubmitBtn">
                <i class="bi bi-send me-2"></i>Gửi &amp; Xác thực ngay
            </button>
        </div>
    </form>
</div>

@section Scripts {
<script>
    let hasCccdOcr = false;
    let hasLicenseOcr = false;

    // --- Image Upload Handlers ---
    const ALLOWED_TYPES = ['image/jpeg', 'image/png', 'image/webp'];
    const MAX_SIZE = 5 * 1024 * 1024; // 5MB

    function showZoneError(zoneId, errorId) {
        const zone = document.getElementById(zoneId);
        const errEl = document.getElementById(errorId);
        if (zone) zone.classList.add('is-invalid');
        if (errEl) errEl.style.display = 'block';
    }

    function clearZoneError(zoneId, errorId) {
        const zone = document.getElementById(zoneId);
        const errEl = document.getElementById(errorId);
        if (zone) zone.classList.remove('is-invalid');
        if (errEl) errEl.style.display = 'none';
    }

    function previewImage(input, zoneId, previewId, errorId) {
        const file = input.files[0];
        const zone = document.getElementById(zoneId);
        const preview = document.getElementById(previewId);
        if (!file || !zone || !preview) return;

        // Validate format
        if (!ALLOWED_TYPES.includes(file.type)) {
            alert('Định dạng không hợp lệ. Chỉ chấp nhận: JPG, JPEG, PNG, WEBP.');
            input.value = '';
            return;
        }

        // Validate file size (5MB)
        if (file.size > MAX_SIZE) {
            alert('File quá lớn. Vui lòng chọn file nhỏ hơn 5MB.');
            input.value = '';
            return;
        }

        // Clear error state
        clearZoneError(zoneId, errorId);

        const url = URL.createObjectURL(file);
        preview.src = url;
        preview.style.display = 'block';
        zone.classList.add('has-preview');
    }

    function handleIdCardUpload(input, zoneId, previewId, scanBtnId) {
        const errorId = zoneId.replace('Zone', 'Error');
        previewImage(input, zoneId, previewId, errorId);
        hasCccdOcr = false;
        updateScanButton(scanBtnId);
        const faceInput = document.getElementById('face');
        const verifyFaceBtn = document.getElementById('verifyFaceBtn');
        if (faceInput && verifyFaceBtn) verifyFaceBtn.disabled = !(input.files.length > 0 && faceInput.files.length > 0);
        document.getElementById('cccdResult').innerHTML = '';
        document.getElementById('extractedInfoCard').style.display = 'none';
    }

    function handleLicenseUpload(input, zoneId, previewId) {
        const errorId = zoneId.replace('Zone', 'Error');
        previewImage(input, zoneId, previewId, errorId);
        hasLicenseOcr = false;
        updateScanButton('scanLicenseBtn');
        document.getElementById('licenseResult').innerHTML = '';
    }

    function handleFaceUpload(input, zoneId, previewId) {
        const errorId = zoneId.replace('Zone', 'Error');
        previewImage(input, zoneId, previewId, errorId);
        // Enable face verify if both face and idFront are uploaded
        const verifyBtn = document.getElementById('verifyFaceBtn');
        const idFrontInput = document.getElementById('idFront');
        verifyBtn.disabled = !(idFrontInput.files.length > 0 && input.files.length > 0);
        document.getElementById('faceResult').innerHTML = '';
    }

    function initFaceCameraCapture() {
        const input = document.getElementById('face');
        const video = document.getElementById('faceCamera');
        const canvas = document.getElementById('faceCanvas');
        const preview = document.getElementById('facePreview');
        const startBtn = document.getElementById('startFaceCameraBtn');
        const captureBtn = document.getElementById('captureFaceBtn');
        const retakeBtn = document.getElementById('retakeFaceBtn');
        const zone = document.getElementById('faceZone');
        const error = document.getElementById('faceError');
        let stream = null;

        if (!input || !video || !canvas || !preview || !startBtn || !captureBtn || !retakeBtn) return;

        async function startCamera() {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                if (error) {
                    error.style.display = 'block';
                    error.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>Trinh duyet khong ho tro camera.';
                }
                return;
            }
            stream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
            video.srcObject = stream;
            video.classList.remove('d-none');
            preview.style.display = 'none';
            captureBtn.classList.remove('d-none');
            retakeBtn.classList.add('d-none');
        }

        function stopCamera() {
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
                stream = null;
            }
            video.srcObject = null;
        }

        startBtn.addEventListener('click', async () => {
            try {
                await startCamera();
            } catch {
                if (error) {
                    error.style.display = 'block';
                    error.innerHTML = '<i class="bi bi-exclamation-circle me-1"></i>Không mở được camera. Vui lòng cấp quyền camera.';
                }
            }
        });

        captureBtn.addEventListener('click', () => {
            if (!video.videoWidth || !video.videoHeight) return;
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            canvas.getContext('2d').drawImage(video, 0, 0, canvas.width, canvas.height);
            canvas.toBlob(blob => {
                if (!blob) return;
                const file = new File([blob], 'face-camera.jpg', { type: 'image/jpeg' });
                const dt = new DataTransfer();
                dt.items.add(file);
                input.files = dt.files;
                preview.src = URL.createObjectURL(file);
                preview.style.display = 'block';
                zone.classList.add('has-preview');
                clearZoneError('faceZone', 'faceError');
                const idFrontInput = document.getElementById('idFront');
                document.getElementById('verifyFaceBtn').disabled = !(idFrontInput.files.length > 0 && input.files.length > 0);
                document.getElementById('faceResult').innerHTML = '';
                stopCamera();
                video.classList.add('d-none');
                captureBtn.classList.add('d-none');
                retakeBtn.classList.remove('d-none');
            }, 'image/jpeg', 0.92);
        });

        retakeBtn.addEventListener('click', async () => {
            input.value = '';
            zone.classList.remove('has-preview');
            await startCamera();
        });
    }

    function clearImage(event, inputName, zoneId, previewId) {
        event.preventDefault();
        event.stopPropagation();
        const input = document.getElementById(inputName) || document.querySelector(`input[name="${inputName}"]`);
        const zone = document.getElementById(zoneId);
        const preview = document.getElementById(previewId);
        if (!input || !zone || !preview) return;

        input.value = '';
        preview.src = '';
        preview.style.display = 'none';
        zone.classList.remove('has-preview');

        // Re-apply error state (mark as invalid since cleared)
        const errorId = zoneId.replace('Zone', 'Error');
        showZoneError(zoneId, errorId);
    }

    function updateScanButton(btnId) {
        const btn = document.getElementById(btnId);
        if (!btn) return;
        const hasImages = document.getElementById('idFront').files.length > 0 || document.getElementById('idBack').files.length > 0;
        btn.disabled = !hasImages;
    }

    // --- Form validation before submit ---
    function validateAllZones() {
        const required = [
            { inputId: 'idFront', zoneId: 'idFrontZone', errorId: 'idFrontError', label: 'CCCD mat truoc' },
            { inputId: 'idBack', zoneId: 'idBackZone', errorId: 'idBackError', label: 'CCCD mat sau' },
            { inputId: 'license', zoneId: 'licenseZone', errorId: 'licenseError', label: 'GPLX mat truoc' },
            { inputId: 'licenseBack', zoneId: 'licenseBackZone', errorId: 'licenseBackError', label: 'GPLX mat sau' },
            { inputId: 'face', zoneId: 'faceZone', errorId: 'faceError', label: 'Anh selfie' },
        ];

        let hasErrors = false;
        required.forEach(function(item) {
            const input = document.getElementById(item.inputId);
            const file = input ? input.files[0] : null;

            if (!file) {
                showZoneError(item.zoneId, item.errorId);
                hasErrors = true;
            } else {
                clearZoneError(item.zoneId, item.errorId);
                // Double-check format & size
                if (!ALLOWED_TYPES.includes(file.type)) {
                    alert('Định dạng ảnh ' + item.label + ' không hợp lệ. Chỉ chấp nhận: JPG, JPEG, PNG, WEBP.');
                    hasErrors = true;
                }
                if (file.size > MAX_SIZE) {
                    alert('Anh ' + item.label + ' qua lon (>5MB).');
                    hasErrors = true;
                }
            }
        });

        if (hasErrors) {
            // Scroll to first error
            const firstError = document.querySelector('.upload-zone.is-invalid');
            if (firstError) {
                firstError.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
            alert('Vui lòng tải lên đầy đủ 5 ảnh theo yêu cầu.');
            return false;
        }
        return true;
    }

    // Hook into form submit
    document.addEventListener('DOMContentLoaded', function() {
        updateScanButton('scanCccdBtn');

        var form = document.getElementById('ekycForm');
        if (form) {
            form.addEventListener('submit', function(e) {
                if (!validateAllZones()) {
                    e.preventDefault();
                    resetEkycSubmitLoading();
                    return;
                }
                showEkycSubmitLoading();
            });
        }

        window.addEventListener('pageshow', resetEkycSubmitLoading);
    });

    function showEkycSubmitLoading() {
        const overlay = document.getElementById('ekycSubmitOverlay');
        const btn = document.getElementById('ekycSubmitBtn');
        if (overlay) overlay.classList.add('active');
        if (btn) {
            btn.disabled = true;
            btn.dataset.originalHtml = btn.dataset.originalHtml || btn.innerHTML;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang xác thực...';
        }
    }

    function resetEkycSubmitLoading() {
        const overlay = document.getElementById('ekycSubmitOverlay');
        const btn = document.getElementById('ekycSubmitBtn');
        if (overlay) overlay.classList.remove('active');
        if (btn) {
            btn.disabled = false;
            if (btn.dataset.originalHtml) btn.innerHTML = btn.dataset.originalHtml;
        }
    }

    // --- CCCD OCR ---
    async function scanCccd() {
        const idFront = document.getElementById('idFront').files[0];
        const idBack = document.getElementById('idBack').files[0];
        if (!idFront && !idBack) {
            alert('Vui lòng tải lên ít nhất 1 ảnh CCCD.');
            return;
        }

        const btn = document.getElementById('scanCccdBtn');
        const frontLoading = document.getElementById('idFrontLoading');
        const backLoading = document.getElementById('idBackLoading');

        btn.disabled = true;
        btn.classList.add('scanning');
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang quét...';
        if (frontLoading) frontLoading.classList.add('active');
        if (backLoading && idBack) backLoading.classList.add('active');

        const formData = new FormData();
        if (idFront) formData.append('idFront', idFront);
        if (idBack) formData.append('idBack', idBack);

        try {
            const response = await fetch('/Ekyc/ScanIdCard', {
                method: 'POST',
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: formData
            });
            const result = await response.json();

            const resultDiv = document.getElementById('cccdResult');
            if (result.success) {
                hasCccdOcr = true;
                resultDiv.innerHTML = `
                    <div class="ocr-result-card">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong class="text-success">Đã quét thành công</strong>
                            <small class="text-muted ms-auto">${result.message || ''}</small>
                        </div>
                        <div class="row">
                            <div class="col-6"><div class="ocr-field"><span class="ocr-field-label">Số CCCD</span><span class="ocr-field-value">${result.citizenId || '<span class="empty">Không phát hiện</span>'}</span></div></div>
                            <div class="col-6"><div class="ocr-field"><span class="ocr-field-label">Họ tên</span><span class="ocr-field-value">${result.fullName || '<span class="empty">Không phát hiện</span>'}</span></div></div>
                            <div class="col-6"><div class="ocr-field"><span class="ocr-field-label">Ngày sinh</span><span class="ocr-field-value">${result.dateOfBirth || '<span class="empty">Không phát hiện</span>'}</span></div></div>
                            <div class="col-6"><div class="ocr-field"><span class="ocr-field-label">Giới tính</span><span class="ocr-field-value">${result.gender || '<span class="empty">Không phát hiện</span>'}</span></div></div>
                            <div class="col-6"><div class="ocr-field"><span class="ocr-field-label">Quốc tịch</span><span class="ocr-field-value">${result.nationality || '<span class="empty">Không phát hiện</span>'}</span></div></div>
                            <div class="col-6"><div class="ocr-field"><span class="ocr-field-label">Nơi cấp</span><span class="ocr-field-value">${result.issueLocation || '<span class="empty">Không phát hiện</span>'}</span></div></div>
                            <div class="col-12"><div class="ocr-field"><span class="ocr-field-label">Địa chỉ</span><span class="ocr-field-value">${result.address || '<span class="empty">Không phát hiện</span>'}</span></div></div>
                        </div>
                    </div>`;

                // Auto-fill form fields
                document.getElementById('extractedInfoCard').style.display = 'block';
                if (result.citizenId) document.getElementById('citizenIdInput').value = result.citizenId;
                if (result.fullName) document.getElementById('fullNameInput').value = result.fullName;
                if (result.dateOfBirth) {
                    const parts = result.dateOfBirth.split('/');
                    if (parts.length === 3) document.getElementById('dobInput').value = `${parts[2]}-${parts[1]}-${parts[0]}`;
                }
                if (result.gender) document.getElementById('genderInput').value = result.gender;
                if (result.nationality) document.getElementById('nationalityInput').value = result.nationality;
                if (result.address) document.getElementById('addressInput').value = result.address;

                // Update hidden fields
                document.getElementById('hCitizenId').value = result.citizenId || '';
                document.getElementById('hFullName').value = result.fullName || '';
                document.getElementById('hDateOfBirth').value = result.dateOfBirth ? `${parts[2]}-${parts[1]}-${parts[0]}` : '';
                document.getElementById('hGender').value = result.gender || '';
                document.getElementById('hNationality').value = result.nationality || '';
                document.getElementById('hAddress').value = result.address || '';
            } else {
                resultDiv.innerHTML = `<div class="ocr-result-card error"><i class="bi bi-exclamation-circle text-danger me-2"></i><strong>Lỗi quét CCCD:</strong> ${result.message}</div>`;
            }
        } catch (err) {
            document.getElementById('cccdResult').innerHTML = `<div class="ocr-result-card error"><i class="bi bi-exclamation-circle text-danger me-2"></i><strong>Lỗi:</strong> ${err.message}</div>`;
        } finally {
            btn.disabled = false;
            btn.classList.remove('scanning');
            btn.innerHTML = '<i class="bi bi-search me-1"></i>Quét CCCD';
            if (frontLoading) frontLoading.classList.remove('active');
            if (backLoading) backLoading.classList.remove('active');
        }
    }

    // --- License OCR ---
    async function scanLicense() {
        const license = document.getElementById('license').files[0];
        if (!license) {
            alert('Vui lòng tải lên ảnh GPLX mặt trước.');
            return;
        }

        const btn = document.getElementById('scanLicenseBtn');
        const loading = document.getElementById('licenseLoading');

        btn.disabled = true;
        btn.classList.add('scanning');
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang quét...';
        if (loading) loading.classList.add('active');

        const formData = new FormData();
        formData.append('license', license);

        try {
            const response = await fetch('/Ekyc/ScanLicense', {
                method: 'POST',
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: formData
            });
            const result = await response.json();

            const resultDiv = document.getElementById('licenseResult');
            if (result.success) {
                hasLicenseOcr = true;
                resultDiv.innerHTML = `
                    <div class="ocr-result-card">
                        <div class="d-flex align-items-center mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            <strong class="text-success">Đã quét thành công</strong>
                            <small class="text-muted ms-auto">${result.message || ''}</small>
                        </div>
                        <div class="row">
                            <div class="col-6"><div class="ocr-field"><span class="ocr-field-label">Số GPLX</span><span class="ocr-field-value">${result.licenseNumber || '<span class="empty">Không phát hiện</span>'}</span></div></div>
                            <div class="col-6"><div class="ocr-field"><span class="ocr-field-label">Hạng</span><span class="ocr-field-value">${result.licenseClass || '<span class="empty">Không phát hiện</span>'}</span></div></div>
                            <div class="col-6"><div class="ocr-field"><span class="ocr-field-label">Họ tên</span><span class="ocr-field-value">${result.fullName || '<span class="empty">Không phát hiện</span>'}</span></div></div>
                            <div class="col-6"><div class="ocr-field"><span class="ocr-field-label">Ngày sinh</span><span class="ocr-field-value">${result.dateOfBirth || '<span class="empty">Không phát hiện</span>'}</span></div></div>
                            <div class="col-12"><div class="ocr-field"><span class="ocr-field-label">Địa chỉ</span><span class="ocr-field-value">${result.address || '<span class="empty">Không phát hiện</span>'}</span></div></div>
                        </div>
                    </div>`;

                document.getElementById('extractedInfoCard').style.display = 'block';
                if (result.licenseNumber) document.getElementById('licenseNumberInput').value = result.licenseNumber;
                if (result.licenseClass) document.getElementById('licenseClassInput').value = result.licenseClass;
                if (!document.getElementById('fullNameInput').value && result.fullName) document.getElementById('fullNameInput').value = result.fullName;
                if (!document.getElementById('addressInput').value && result.address) document.getElementById('addressInput').value = result.address;

                document.getElementById('hLicenseNumber').value = result.licenseNumber || '';
                document.getElementById('hLicenseClass').value = result.licenseClass || '';
            } else {
                resultDiv.innerHTML = `<div class="ocr-result-card error"><i class="bi bi-exclamation-circle text-danger me-2"></i><strong>Lỗi quét GPLX:</strong> ${result.message}</div>`;
            }
        } catch (err) {
            document.getElementById('licenseResult').innerHTML = `<div class="ocr-result-card error"><i class="bi bi-exclamation-circle text-danger me-2"></i><strong>Lỗi:</strong> ${err.message}</div>`;
        } finally {
            btn.disabled = false;
            btn.classList.remove('scanning');
            btn.innerHTML = '<i class="bi bi-search me-1"></i>Quét GPLX';
            if (loading) loading.classList.remove('active');
        }
    }

    // --- Face Verification ---
    async function verifyFace() {
        const face = document.getElementById('face').files[0];
        const idFront = document.getElementById('idFront').files[0];
        if (!face || !idFront) {
            alert('Vui lòng tải lên cả ảnh CCCD mặt trước và ảnh selfie.');
            return;
        }

        const btn = document.getElementById('verifyFaceBtn');
        const loading = document.getElementById('faceLoading');

        btn.disabled = true;
        btn.classList.add('scanning');
        btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang xác minh...';
        if (loading) loading.classList.add('active');

        const formData = new FormData();
        formData.append('face', face);
        formData.append('idCard', idFront);

        try {
            const response = await fetch('/Ekyc/VerifyFace', {
                method: 'POST',
                headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value },
                body: formData
            });
            const result = await response.json();

            const resultDiv = document.getElementById('faceResult');
            if (result.success) {
                const isMatch = result.isMatch;
                const similarity = result.similarity ? result.similarity.toFixed(1) : '?';
                if (isMatch) {
                    resultDiv.innerHTML = `<div class="ocr-result-card"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Khớp khuôn mặt!</strong> Độ tương đồng: ${similarity}% — ${result.message || ''}</div>`;
                } else {
                    resultDiv.innerHTML = `<div class="ocr-result-card error"><i class="bi bi-exclamation-triangle text-warning me-2"></i><strong>Cảnh báo:</strong> Khuôn mặt không khớp (${similarity}%). Vui lòng chụp lại selfie rõ ràng hơn.</div>`;
                }
            } else {
                resultDiv.innerHTML = `<div class="ocr-result-card error"><i class="bi bi-exclamation-circle text-danger me-2"></i><strong>Lỗi xác minh:</strong> ${result.message}</div>`;
            }
        } catch (err) {
            document.getElementById('faceResult').innerHTML = `<div class="ocr-result-card error"><i class="bi bi-exclamation-circle text-danger me-2"></i><strong>Lỗi:</strong> ${err.message}</div>`;
        } finally {
            btn.disabled = false;
            btn.classList.remove('scanning');
            btn.innerHTML = '<i class="bi bi-person-check me-1"></i>Xác minh khuôn mặt';
            if (loading) loading.classList.remove('active');
        }
    }

    initFaceCameraCapture();
</script>
}
