@model CarRentalSystem.Helpers.PaginatedList<CarRentalSystem.Models.Booking>
@{
    ViewData["Title"] = "Quản lý đơn đặt xe";
    Layout = "_AdminLayout";
}

<h2 class="mb-4">Quản lý đơn đặt xe</h2>

<div class="table-responsive bg-white shadow-sm rounded">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Mã đơn</th>
                <th>Khách hàng</th>
                <th>Xe</th>
                <th>Thời gian</th>
                <th>Tổng tiền</th>
                <th>Trạng thái</th>
                <th>Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td class="fw-bold">#@booking.BookingID</td>
                    <td>
                        <div>@booking.User?.Name</div>
                        <small class="text-muted">@booking.User?.Email</small>
                    </td>
                    <td>@booking.Car?.CarBrand?.Name @booking.Car?.CarName</td>
                    <td>
                        <div>@booking.StartDate.ToString("dd/MM/yyyy")</div>
                        <small class="text-muted">đến @booking.EndDate.ToString("dd/MM/yyyy")</small>
                    </td>
                    <td>@booking.TotalPrice.ToString("N0") đ</td>
                    <td>
                        <span class="badge @(booking.BookingStatus?.Name == "Pending" ? "bg-warning text-dark" : booking.BookingStatus?.Name == "Confirmed" ? "bg-success" : booking.BookingStatus?.Name == "Completed" ? "bg-primary" : "bg-danger")">
                            @UiLabels.BookingStatus(booking.BookingStatus?.Name)
                        </span>
                    </td>
                    <td>
                        @if (booking.BookingStatus?.Name == "Pending")
                        {
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@booking.BookingID" />
                                <input type="hidden" name="status" value="Confirmed" />
                                <button type="submit" class="btn btn-sm btn-success" title="Xác nhận đơn"><i class="bi bi-check-lg"></i></button>
                            </form>
                        }
                        else if (booking.BookingStatus?.Name == "Confirmed")
                        {
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@booking.BookingID" />
                                <input type="hidden" name="status" value="Completed" />
                                <button type="submit" class="btn btn-sm btn-primary" title="Đánh dấu hoàn tất"><i class="bi bi-flag-fill"></i></button>
                            </form>
                        }
                        <form asp-action="UpdateStatus" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@booking.BookingID" />
                            <input type="hidden" name="status" value="Cancelled" />
                            <button type="submit" class="btn btn-sm btn-danger" title="Hủy đơn"><i class="bi bi-x-lg"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-3" aria-label="Trang đơn đặt xe">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                <a class="page-link" asp-action="Manage" asp-route-page="@(Model.PageIndex - 1)">Trước</a>
            </li>
            <li class="page-item disabled">
                <span class="page-link">@Model.PageIndex / @Model.TotalPages</span>
            </li>
            <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                <a class="page-link" asp-action="Manage" asp-route-page="@(Model.PageIndex + 1)">Sau</a>
            </li>
        </ul>
    </nav>
}
