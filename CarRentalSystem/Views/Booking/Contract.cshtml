@model CarRentalSystem.Models.DigitalContract
@{ ViewData["Title"] = "Hợp Đồng Điện Tử"; }

@section Styles {
    <style>
        @@media print {
            /* Hide layout elements like header, footer, navbar, and buttons */
            header, footer, nav, .navbar, .btn, button, a, #chatbot-widget {
                display: none !important;
            }
            /* Set a clean white background and reset padding */
            body, main {
                background: white !important;
                padding: 0 !important;
                margin: 0 !important;
            }
            /* Flatten the card */
            .card {
                border: none !important;
                box-shadow: none !important;
            }
            .card-body {
                padding: 0 !important;
            }
            .bg-light {
                background-color: transparent !important;
            }
            .print-avoid-break, .bg-light, .row.text-center.mt-5 {
                break-inside: avoid !important;
                page-break-inside: avoid !important;
            }
            /* Compact layout for better fitting on a single page */
            .mb-5 { margin-bottom: 1rem !important; }
            .mb-4, .mb-3 { margin-bottom: 0.5rem !important; }
            .p-3 { padding: 0.5rem !important; }
            .p-4, .p-md-5, .p-md-4 { padding: 1rem !important; }
            h3 { font-size: 1.5rem !important; }
            h5 { font-size: 1.1rem !important; }
            h6 { font-size: 0.95rem !important; }
            body, .card-body, pre { font-size: 0.9rem !important; line-height: 1.4 !important; }
            pre { padding: 0 !important; }
        }
    </style>
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card shadow border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-5">
                    <h5 class="fw-bold mb-1">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</h5>
                    <h6 class="fw-bold text-decoration-underline mb-3">Độc Lập – Tự Do – Hạnh Phúc</h6>
                    <div class="mb-4">----------oOo----------</div>
                    <h3 class="fw-bold mb-2">HỢP ĐỒNG THUÊ XE</h3>
                    <p class="mb-1">Số: @(Model.BookingID != null ? Model.BookingID : $"T{Model.TransactionID}") - @Model.ContractNo / HĐTX</p>
                    <p class="small font-italic">Hôm nay, ngày @Model.CreatedAt.ToString("dd") tháng @Model.CreatedAt.ToString("MM") năm @Model.CreatedAt.ToString("yyyy"), chúng tôi gồm:</p>
                </div>

                <div class="row g-4 mb-4">
                    <div class="col-md-6 border-end-md">
                        <h6 class="fw-bold text-primary mb-3">BÊN CHO THUÊ (BÊN A)</h6>
                        <p class="mb-1"><strong>Tên đơn vị:</strong> CarRentalSystem</p>
                        <p class="mb-1"><strong>Mã số thuế:</strong> xxxxxxx</p>
                        <p class="mb-1"><strong>Địa chỉ:</strong> xxxxxxx</p>
                        <p class="mb-1"><strong>Điện thoại:</strong> 1900 1234</p>
                        <p class="mb-1"><strong>Số tài khoản:</strong> 00868497745 Ngân Hàng Quân Đội MB</p>
                    </div>
                    <div class="col-md-6 px-md-4">
                        <h6 class="fw-bold text-primary mb-3">BÊN THUÊ (BÊN B)</h6>
                        @if (Model.IsSignedByCustomer)
                        {
                            <p class="mb-1"><strong>Họ tên người mua hàng / Tên đơn vị:</strong> @Model.CustomerName</p>
                            <p class="mb-1"><strong>MST/CCCD chủ hộ:</strong> @Model.CustomerIdentityCard</p>
                            <p class="mb-1"><strong>MSĐVCQHVNS:</strong> @Model.CustomerDepartmentCode</p>
                            <p class="mb-1"><strong>Địa chỉ:</strong> @Model.CustomerAddress</p>
                            <p class="mb-1"><strong>Điện thoại:</strong> @Model.CustomerPhone</p>
                            <p class="mb-1"><strong>Hình thức thanh toán:</strong> TM/CK  &nbsp;&nbsp; <strong>Số tài khoản:</strong> @Model.CustomerBankAccount</p>
                        }
                        else
                        {
                            <p class="small text-muted mb-2 fst-italic">Vui lòng điền thông tin để tạo hợp đồng hợp lệ:</p>
                            <div class="row g-2">
                                <div class="col-12 col-md-6 mb-2">
                                    <label class="small fw-bold">Họ tên người mua / Tên đơn vị <span class="text-danger">*</span></label>
                                    <input type="text" form="signForm" name="customerName" class="form-control form-control-sm" value="@(string.IsNullOrEmpty(Model.CustomerName) ? "" : Model.CustomerName)" required>
                                </div>
                                <div class="col-12 col-md-6 mb-2">
                                    <label class="small fw-bold">Điện thoại <span class="text-danger">*</span></label>
                                    <input type="text" form="signForm" name="customerPhone" class="form-control form-control-sm" value="@(string.IsNullOrEmpty(Model.CustomerPhone) ? "" : Model.CustomerPhone)" required>
                                </div>
                                <div class="col-6 mb-2">
                                    <label class="small fw-bold">MST/CCCD chủ hộ <span class="text-danger">*</span></label>
                                    <input type="text" form="signForm" name="customerIdentityCard" class="form-control form-control-sm" value="@(Model.CustomerIdentityCard == "Chưa cập nhật" ? "" : Model.CustomerIdentityCard)" required>
                                </div>
                                <div class="col-6 mb-2">
                                    <label class="small fw-bold">MSĐVCQHVNS</label>
                                    <input type="text" form="signForm" name="customerDepartmentCode" class="form-control form-control-sm" value="@Model.CustomerDepartmentCode">
                                </div>
                                <div class="col-12 mb-2">
                                    <label class="small fw-bold">Địa chỉ <span class="text-danger">*</span></label>
                                    <input type="text" form="signForm" name="customerAddress" class="form-control form-control-sm" value="@(Model.CustomerAddress == "Chưa cập nhật" ? "" : Model.CustomerAddress)" required>
                                </div>
                                <div class="col-4 mb-2">
                                    <label class="small fw-bold">Hình thức TT</label>
                                    <input type="text" form="signForm" name="paymentMethod" class="form-control form-control-sm bg-light" value="TM/CK" readonly>
                                </div>
                                <div class="col-8 mb-2">
                                    <label class="small fw-bold">Số tài khoản</label>
                                    <input type="text" form="signForm" name="customerBankAccount" class="form-control form-control-sm" value="@Model.CustomerBankAccount">
                                </div>
                            </div>
                        }

                    </div>
                </div>

                <div class="bg-light p-3 p-md-4 rounded-3 mb-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-car-front me-2"></i>Chi Chiết Thuê Xe</h6>
                    <table class="table table-borderless table-sm mb-0">
                        <tbody>
                            <tr><td style="width:150px">Dòng xe:</td><th>@Model.CarModel</th></tr>
                            <tr><td>Biển số:</td><th>@Model.CarLicensePlate</th></tr>
                            <tr><td>Ngày nhận:</td><th>@Model.RentalStartDate.ToString("dd/MM/yyyy HH:mm")</th></tr>
                            <tr><td>Ngày trả:</td><th>@Model.RentalEndDate.ToString("dd/MM/yyyy HH:mm")</th></tr>
                        </tbody>
                    </table>
                </div>

                <div class="bg-light p-3 p-md-4 rounded-3 mb-4">
                    <h6 class="fw-bold mb-3"><i class="bi bi-cash-stack me-2"></i>Giá Trị Hợp Đồng</h6>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Giá căn cứ (Theo gói/ngày):</span>
                        <span class="fw-bold">@Model.RentalPricePerDay.ToString("N0") VNĐ</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Tiền đặt cọc (Giữ chỗ):</span>
                        <span class="fw-bold">@Model.DepositAmount.ToString("N0") VNĐ</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">Tổng Giá Trị Hợp Đồng:</span>
                        <h5 class="fw-bold text-primary mb-0">@Model.TotalContractValue.ToString("N0") VNĐ</h5>
                    </div>
                    <small class="text-muted fst-italic mt-2 d-block">(*) Phí bảo hiểm và chi phí giao nhận được bao gồm (nếu có).</small>
                </div>

                <div class="mb-5 print-avoid-break">
                    <h6 class="fw-bold mb-3"><i class="bi bi-file-text me-2"></i>Điều Khoản Hợp Đồng</h6>
                    <div class="mt-3">
                        <pre style="white-space: pre-wrap; font-family: inherit; font-size: 1rem; line-height: 1.6;" class="mb-0 text-dark">@Model.TermsAndConditions</pre>
                    </div>
                </div>

                @if (!Model.IsSignedByCustomer)
                {
                    <div class="alert alert-warning border-0 p-4 rounded-4 shadow-sm mb-0 text-center">
                        <h6 class="fw-bold mb-3"><i class="bi bi-pen me-2"></i>Xác nhận ký hợp đồng HĐ-#@(Model.BookingID != null ? Model.BookingID : $"T{Model.TransactionID}")</h6>
                        <p class="small text-muted mb-4">Bằng việc nhấn "Đồng ý và Ký hợp đồng", tôi xác nhận đã đọc, hiểu rõ và đồng ý với tất cả các điều khoản nêu trên.</p>
                        
                        <form asp-action="SignContract" method="post" id="signForm">
                            <input type="hidden" name="id" value="@Model.DigitalContractID" />
                            <div class="form-check text-start d-inline-block mb-4">
                                <input class="form-check-input" type="checkbox" id="agreeTerms" required>
                                <label class="form-check-label small" for="agreeTerms">
                                    Tôi đồng ý với các điều khoản Hợp Đồng Hợp Đồng Thuê Xe Tự Lái
                                </label>
                            </div>
                            <div class="d-flex gap-2 justify-content-center">
                                <a asp-action="MyBookings" class="btn btn-light rounded-pill px-4">Quay lại</a>
                                <button type="submit" class="btn btn-primary rounded-pill px-5 fw-bold"><i class="bi bi-vector-pen me-2"></i>Đồng Ý và Ký Hợp Đồng</button>
                            </div>
                        </form>
                    </div>
                }
                else
                {
                    <div class="row text-center mt-5">
                        <div class="col-6">
                            <h6 class="fw-bold">ĐẠI DIỆN BÊN A</h6>
                            <p class="small text-muted mb-4">SmartRental</p>
                            @if (Model.IsSignedByOwner)
                            {
                                <div class="text-success mb-2"><i class="bi bi-shield-check display-6"></i></div>
                                <span class="badge bg-success bg-opacity-10 text-success border border-success px-3 fs-6">Đã xác nhận tự động</span>
                                <p class="small text-muted mt-2">@Model.OwnerSignDate?.ToString("dd/MM/yyyy HH:mm")</p>
                            }
                            else
                            {
                                <span class="badge bg-light text-muted px-3 fs-6">Chưa ký</span>
                            }
                        </div>
                        <div class="col-6">
                            <h6 class="fw-bold">BÊN THUÊ (BÊN B)</h6>
                            <p class="small text-muted mb-4">@Model.CustomerName</p>
                            <div class="text-primary mb-2"><i class="bi bi-check-circle-fill display-6"></i></div>
                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary px-3 fs-6">Đã ký điện tử</span>
                            <p class="small text-muted mt-2">@Model.CustomerSignDate?.ToString("dd/MM/yyyy HH:mm")</p>
                        </div>
                    </div>
                    <div class="text-center mt-4">
                        <a asp-action="MyBookings" class="btn btn-light rounded-pill px-4">Quay lại Quản lý đơn</a>
                        <button class="btn btn-outline-dark rounded-pill px-4 ms-2" onclick="window.print()"><i class="bi bi-printer me-2"></i>In Hợp đồng</button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
