    ViewData["Title"] = "Thá»§ tá»¥c thanh toÃ¡n";
    var diffTime = Model.EndDate - Model.StartDate;
    var totalHours = Math.Ceiling(diffTime.TotalHours);
    if (totalHours <= 0) totalHours = 1;
    var rentalDays = (int)Math.Ceiling(totalHours / 24.0);
    if (rentalDays == 0) rentalDays = 1;
}

<style>
