            var code = document.getElementById('promoCodeInput').value.trim().toUpperCase();
            if (!code) return;

            document.getElementById('promoBtnSpinner').classList.remove('d-none');
            document.getElementById('promoBtnText').textContent = 'Äang kiá»ƒm tra...';
            document.getElementById('applyPromoBtn').disabled = true;
            document.getElementById('promoError').classList.add('d-none');
            document.getElementById('promoSuccess').classList.add('d-none');

            try {
                var totalPrice = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TotalPrice));
                var res = await fetch('/api/Voucher/check?code=' + encodeURIComponent(code) + '&totalPrice=' + totalPrice);
                var data = await res.json();

                if (data.success) {
                    promoApplied = true;
                    promoDiscount = data.discountAmount;
                    document.getElementById('promotionIdInput').value = data.promotionId;
                    document.getElementById('promoSuccess').classList.remove('d-none');
                    document.getElementById('promoSuccessText').textContent = 'Giáº£m ' + data.discountAmount.toLocaleString('vi-VN') + 'Ä‘ cho Ä‘Æ¡n hÃ ng!';
                    document.getElementById('promoCodeInput').readOnly = true;
                    document.getElementById('applyPromoBtn').innerHTML = '<i class="bi bi-check-circle-fill"></i> ÄÃ£ Ã¡p dá»¥ng';
                    document.getElementById('applyPromoBtn').classList.remove('btn-outline-primary');
                    document.getElementById('applyPromoBtn').classList.add('btn-success');
                    document.getElementById('applyPromoBtn').disabled = false;

                    var discountedTotal = totalPrice - promoDiscount;
                    document.getElementById('voucherDiscountRow').classList.remove('d-none');
                    document.getElementById('voucherDiscountAmount').textContent = '-' + promoDiscount.toLocaleString('vi-VN') + 'Ä‘';
                    document.getElementById('depositAmountDisplay').textContent = Math.max(0, Math.round(discountedTotal * 0.2)).toLocaleString('vi-VN') + ' Ä‘';
                    document.getElementById('balanceAmountDisplay').textContent = Math.max(0, Math.round(discountedTotal * 0.8)).toLocaleString('vi-VN') + ' Ä‘';
                    document.getElementById('rentalTotalDisplay').textContent = Math.max(0, Math.round(discountedTotal)).toLocaleString('vi-VN') + ' Ä‘';
                    document.getElementById('rentalRemainingDisplay').textContent = Math.max(0, Math.round(discountedTotal * 0.8)).toLocaleString('vi-VN') + ' Ä‘';
                } else {
                    document.getElementById('promoError').classList.remove('d-none');
                    document.getElementById('promoError').textContent = data.message || 'MÃ£ voucher khÃ´ng há»£p lá»‡ hoáº·c Ä‘Ã£ háº¿t háº¡n.';
                }
            } catch (e) {
                document.getElementById('promoError').classList.remove('d-none');
                document.getElementById('promoError').textContent = 'KhÃ´ng thá»ƒ kiá»ƒm tra mÃ£ voucher. Thá»­ láº¡i sau.';
            }

            document.getElementById('promoBtnSpinner').classList.add('d-none');
            document.getElementById('promoBtnText').textContent = promoApplied ? 'ÄÃ£ Ã¡p dá»¥ng' : 'Ãp dá»¥ng';
            document.getElementById('applyPromoBtn').disabled = promoApplied;
        }

