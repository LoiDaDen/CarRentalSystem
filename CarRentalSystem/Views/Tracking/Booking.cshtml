@model CarRentalSystem.Models.Booking
@{
    ViewData["Title"] = "Theo dõi giao/nhận xe #" + Model.BookingID;
}

<style>
    .tracking-shell{max-width:1120px;margin:0 auto}
    .tracking-map{height:520px;border-radius:16px;overflow:hidden;border:1px solid #e5e7eb;background:#f8fafc}
    .tracking-stat{border:1px solid #e5e7eb;border-radius:12px;padding:14px;background:#fff}
    .tracking-dot-live{width:10px;height:10px;border-radius:999px;background:#22c55e;display:inline-block;box-shadow:0 0 0 6px rgba(34,197,94,.15)}
    .tracking-dot-stale{width:10px;height:10px;border-radius:999px;background:#f59e0b;display:inline-block;box-shadow:0 0 0 6px rgba(245,158,11,.15)}
    .tracking-dot-fallback{width:10px;height:10px;border-radius:999px;background:#94a3b8;display:inline-block;box-shadow:0 0 0 6px rgba(148,163,184,.15)}
    @@media(max-width:768px){.tracking-map{height:420px}}
</style>

<div class="container py-4 tracking-shell">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <div>
            <div class="text-muted small">Mã đơn #@Model.BookingID</div>
            <h2 class="fw-800 mb-0">@Model.Car?.CarBrand?.Name @Model.Car?.CarName</h2>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingID" class="btn btn-outline-secondary rounded-3">
                <i class="bi bi-arrow-left me-1"></i>Chi tiết đơn
            </a>
            <a id="googleMapsLink" href="#" target="_blank" rel="noopener" class="btn btn-success rounded-3">
                <i class="bi bi-signpost-split me-1"></i>Google Maps
            </a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-3"><div class="tracking-stat"><div class="small text-muted">Trạng thái GPS</div><div class="fw-bold" id="trackingStatus">Đang tải...</div></div></div>
        <div class="col-md-3"><div class="tracking-stat"><div class="small text-muted">Khoảng cách còn lại</div><div class="fw-bold" id="distanceText">-</div></div></div>
        <div class="col-md-3"><div class="tracking-stat"><div class="small text-muted">ETA</div><div class="fw-bold" id="etaText">-</div></div></div>
        <div class="col-md-3"><div class="tracking-stat"><div class="small text-muted">Cập nhật cuối</div><div class="fw-bold" id="updatedText">-</div></div></div>
    </div>

    <div id="trackingMap" class="tracking-map"></div>
    <div class="alert alert-info mt-3 mb-0 rounded-3" id="trackingHint">
        Bản đồ hiển thị vị trí GPS thật khi nhân sự/chủ xe bật tracker. Nếu chưa có GPS, hệ thống dùng vị trí xe đã đăng ký và ghi rõ là ước tính.
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script>
        const bookingId = @Model.BookingID;
        let map, carMarker, destinationMarker, routeLine;

        function initTrackingMap(lat, lng) {
            if (map) return;
            map = L.map('trackingMap').setView([lat, lng], 14);
            L.tileLayer('https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png', {
                attribution: '&copy; OpenStreetMap &copy; CARTO'
            }).addTo(map);
        }

        function renderSnapshot(snapshot) {
            if (!snapshot || !snapshot.current || !snapshot.destination) return;
            initTrackingMap(snapshot.current.lat, snapshot.current.lng);

            const carPos = [snapshot.current.lat, snapshot.current.lng];
            const destPos = [snapshot.destination.lat, snapshot.destination.lng];
            const carIcon = L.divIcon({
                className: '',
                html: '<div style="width:34px;height:34px;border-radius:50%;background:#2563eb;color:#fff;display:grid;place-items:center;border:3px solid #fff;box-shadow:0 8px 24px rgba(37,99,235,.35)"><i class="bi bi-car-front-fill"></i></div>',
                iconSize: [34, 34],
                iconAnchor: [17, 17]
            });
            const destIcon = L.divIcon({
                className: '',
                html: '<div style="width:30px;height:30px;border-radius:50%;background:#16a34a;color:#fff;display:grid;place-items:center;border:3px solid #fff;box-shadow:0 8px 24px rgba(22,163,74,.30)"><i class="bi bi-geo-alt-fill"></i></div>',
                iconSize: [30, 30],
                iconAnchor: [15, 15]
            });

            if (!carMarker) carMarker = L.marker(carPos, { icon: carIcon }).addTo(map);
            else carMarker.setLatLng(carPos);

            if (!destinationMarker) destinationMarker = L.marker(destPos, { icon: destIcon }).addTo(map);
            else destinationMarker.setLatLng(destPos);

            const route = (snapshot.routeCoordinates || []).map(p => [p.lat, p.lng]);
            if (!routeLine) routeLine = L.polyline(route, { color: '#22c55e', weight: 5, opacity: .85 }).addTo(map);
            else routeLine.setLatLngs(route);
            if (route.length > 1) map.fitBounds(L.latLngBounds(route).pad(0.25));

            const dotClass = snapshot.trackingStatus === 'live' ? 'tracking-dot-live' : snapshot.trackingStatus === 'stale' ? 'tracking-dot-stale' : 'tracking-dot-fallback';
            const statusText = snapshot.trackingStatus === 'live' ? 'Đang cập nhật trực tiếp' : snapshot.trackingStatus === 'stale' ? 'GPS cũ, đang chờ cập nhật mới' : 'Chưa có GPS, dùng vị trí đăng ký';
            document.getElementById('trackingStatus').innerHTML = `<span class="${dotClass} me-2"></span>${statusText}`;
            document.getElementById('distanceText').textContent = `${Number(snapshot.distanceKm || 0).toFixed(1)} km`;
            document.getElementById('etaText').textContent = snapshot.etaMinutes ? `~${snapshot.etaMinutes} phút` : '-';
            document.getElementById('updatedText').textContent = snapshot.lastUpdatedUtc ? new Date(snapshot.lastUpdatedUtc).toLocaleTimeString('vi-VN') : '-';
            document.getElementById('googleMapsLink').href = snapshot.googleMapsUrl || '#';
        }

        async function loadSnapshot() {
            const response = await fetch(`/Tracking/Snapshot?bookingId=${bookingId}`);
            if (response.ok) renderSnapshot(await response.json());
        }

        loadSnapshot();
        setInterval(loadSnapshot, 5000);

        if (window.signalR) {
            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/hubs/tracking')
                .withAutomaticReconnect()
                .build();

            connection.on('trackingSnapshot', renderSnapshot);
            connection.start()
                .then(() => connection.invoke('JoinBooking', bookingId))
                .catch(() => {});
        }
    </script>
}
