@model CarRentalSystem.Models.Blog
@{
    var image = string.IsNullOrWhiteSpace(Model.ThumbnailUrl)
        ? "https://images.unsplash.com/photo-1449965408869-eaa3f722e40d?q=80&w=900&auto=format&fit=crop"
        : Model.ThumbnailUrl;
}

<article class="blog-card d-flex flex-column">
    <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@Model.Slug">
        <img src="@image" alt="@(Model.ThumbnailAlt ?? Model.Title)" class="blog-card-img" loading="lazy" />
    </a>
    <div class="p-3 d-flex flex-column flex-grow-1">
        @if (Model.Category != null)
        {
            <a class="blog-category-badge mb-2" asp-controller="Blog" asp-action="Index" asp-route-category="@Model.Category.Slug">@Model.Category.Name</a>
        }
        <h3 class="h5 fw-bold mb-2">
            <a class="blog-title-link" asp-controller="Blog" asp-action="Detail" asp-route-slug="@Model.Slug">@Model.Title</a>
        </h3>
        <p class="blog-summary small mb-3">@Model.Summary</p>
        <div class="blog-meta mt-auto mb-3">
            <span><i class="bi bi-calendar3 me-1"></i>@Model.PublishedDate.ToString("dd/MM/yyyy")</span>
            <span><i class="bi bi-clock me-1"></i>@Model.ReadingTime phút đọc</span>
        </div>
        <a class="btn btn-outline-primary rounded-3 fw-bold" asp-controller="Blog" asp-action="Detail" asp-route-slug="@Model.Slug">
            Đọc tiếp <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</article>
