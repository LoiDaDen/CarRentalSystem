@model CarRentalSystem.Models.Blog?

@if (Model != null)
{
    var image = string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? Model.ThumbnailUrl : Model.CoverImageUrl;
    <section class="featured-blog mb-4">
        <div class="row g-0 align-items-stretch">
            <div class="col-lg-6">
                <img src="@image" alt="@(Model.CoverImageAlt ?? Model.Title)" class="w-100 featured-blog-img" />
            </div>
            <div class="col-lg-6">
                <div class="p-4 p-lg-5 h-100 d-flex flex-column justify-content-center">
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                        <span class="badge bg-warning text-dark rounded-pill px-3 py-2">Bài viết nổi bật</span>
                        @if (Model.Category != null)
                        {
                            <a class="blog-category-badge" asp-controller="Blog" asp-action="Index" asp-route-category="@Model.Category.Slug">@Model.Category.Name</a>
                        }
                    </div>
                    <h2 class="fw-800 mb-3">@Model.Title</h2>
                    <p class="text-muted mb-3">@Model.Summary</p>
                    <div class="blog-meta mb-4">
                        <span><i class="bi bi-person me-1"></i>@Model.AuthorName</span>
                        <span><i class="bi bi-calendar3 me-1"></i>@Model.PublishedDate.ToString("dd/MM/yyyy")</span>
                        <span><i class="bi bi-clock me-1"></i>@Model.ReadingTime phút đọc</span>
                    </div>
                    <div>
                        <a asp-controller="Blog" asp-action="Detail" asp-route-slug="@Model.Slug" class="btn btn-primary rounded-3 fw-bold px-4">
                            Đọc bài viết <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>
}
