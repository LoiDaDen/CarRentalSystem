@{
    ViewData["Title"] = "Không tìm thấy bài viết";
}

@section Styles {
    <link rel="stylesheet" href="~/css/blog.css" asp-append-version="true" />
}

<div class="blog-page py-5">
    <div class="container">
        <div class="blog-empty text-center mx-auto" style="max-width: 680px;">
            <i class="bi bi-journal-x display-4 text-primary d-block mb-3"></i>
            <h1 class="h3 fw-bold">Không tìm thấy bài viết</h1>
            <p class="text-muted mb-4">Bài viết có thể đã được gỡ, đổi đường dẫn hoặc chưa được xuất bản.</p>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a asp-controller="Blog" asp-action="Index" class="btn btn-primary rounded-3 fw-bold">Về Blog</a>
                <a asp-controller="Car" asp-action="Index" class="btn btn-outline-primary rounded-3 fw-bold">Xem xe đang có</a>
            </div>
        </div>
    </div>
</div>
