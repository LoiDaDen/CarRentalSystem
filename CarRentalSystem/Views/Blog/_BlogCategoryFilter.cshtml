@model CarRentalSystem.ViewModels.BlogListViewModel

<div class="blog-panel">
    <div class="blog-panel-title">Danh mục bài viết</div>
    <div class="d-flex flex-wrap gap-2">
        <a class="blog-chip @(string.IsNullOrWhiteSpace(Model.CurrentCategorySlug) ? "active" : "")" asp-controller="Blog" asp-action="Index" asp-route-keyword="@Model.CurrentKeyword">
            Tất cả
        </a>
        @foreach (var category in Model.Categories)
        {
            <a class="blog-chip @(Model.CurrentCategorySlug == category.Slug ? "active" : "")"
               asp-controller="Blog"
               asp-action="Index"
               asp-route-category="@category.Slug"
               asp-route-keyword="@Model.CurrentKeyword">
                @category.Name
            </a>
        }
    </div>
</div>
