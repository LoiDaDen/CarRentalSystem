@using CarRentalSystem.Data
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims
@inject ApplicationDbContext LayoutDb
@{
    var layoutUserName = User.Identity?.Name ?? "Admin";
    string? layoutFaceUrl = null;
    if (User.Identity?.IsAuthenticated == true &&
        int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var layoutUserId))
    {
        layoutFaceUrl = await LayoutDb.Users
            .AsNoTracking()
            .Where(u => u.UserID == layoutUserId)
            .Select(u => u.FaceUrl)
            .FirstOrDefaultAsync();
    }

    var layoutNameParts = layoutUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var layoutInitials = layoutNameParts.Length == 0
        ? "AD"
        : string.Concat(layoutNameParts.Take(2).Select(p => p[0])).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản trị Hệ thống</title>
    <script>
        (() => {
            const savedTheme = localStorage.getItem('admin-theme') || 'dark';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    @RenderSection("Styles", required: false)
    <style>
        html { font-size: 13px; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: var(--admin-bg, #0f172a); color: var(--admin-text, #f1f5f9); }
        .admin-main-content { font-size: 0.85rem; }
        .admin-sidebar { background: linear-gradient(180deg, var(--admin-bg-900, #0f172a) 0%, var(--admin-surface, #1e293b) 100%); color: var(--admin-text-secondary, #94a3b8); border-right: 1px solid var(--admin-border, rgba(255,255,255,0.08)); font-size: 0.8rem; }
        .admin-link { color: #94a3b8; padding: 0.6rem 1rem; border-radius: 12px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); margin-bottom: 0.35rem; text-decoration: none; display: flex; align-items: center; font-weight: 500; font-size: 0.8rem; }
        .admin-link:hover { background: rgba(255,255,255,0.08); color: #fff; transform: translateX(4px); }
        .admin-link i { font-size: 1.25rem; margin-right: 0.75rem; transition: transform 0.3s ease; }
        .admin-link.active { background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%); color: #fff; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4); }
        .admin-link.active i { transform: scale(1.1); }
        .navbar-brand { font-weight: 800; letter-spacing: -1px; background: linear-gradient(135deg, #fff 0%, #94a3b8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }

        /* Logo size */
        .logo-admin-desktop { width: 32px; height: 32px; object-fit: contain; }
        .logo-admin-mobile { width: 28px; height: 28px; object-fit: contain; }
        .logo-admin-offcanvas { width: 28px; height: 28px; object-fit: contain; }
        
        /* Sidebar Dropdown Enhancements */
        .admin-link[aria-expanded="true"] .bi-chevron-down { transform: rotate(180deg); transition: transform 0.3s ease; }
        .admin-link .bi-chevron-down { transition: transform 0.3s ease; }
        .collapse-horizontal { transition: width 0.3s ease; }
        .collapse:not(.show) { display: none; }
        .collapsing { transition: height 0.3s ease; }
        
        .ps-3 { padding-left: 1.5rem !important; }
        .admin-sidebar .admin-link i { width: 1.25rem; text-align: center; }

        /* Dark mode specific overrides */
        .admin-sidebar .text-white-50 { color: rgba(255,255,255,0.5) !important; }

        .admin-shell-row {
            min-height: 100vh;
        }

        .admin-main-content {
            min-width: 0;
            margin-left: 0 !important;
        }

        .admin-desktop-topbar {
            min-width: 0;
        }

        .admin-desktop-topbar .dropdown-menu {
            max-width: min(380px, calc(100vw - 32px));
        }

        .admin-global-search {
            max-width: 100%;
        }

        @@media (min-width: 992px) {
            .dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 15px;
                background: transparent;
            }
        }

        @@media (min-width: 768px) {
            .admin-sidebar {
                width: 280px !important;
                flex: 0 0 280px !important;
                max-width: 280px !important;
                position: sticky !important;
                top: 0;
            }

            .admin-main-content {
                flex: 1 1 calc(100% - 280px) !important;
                max-width: calc(100% - 280px) !important;
                padding-left: 24px !important;
                padding-right: 24px !important;
                padding-top: 24px !important;
                padding-bottom: 24px !important;
            }
        }

        @@media (max-width: 767.98px) {
            html {
                font-size: 13px;
            }

            .admin-mobile-header {
                padding: 12px 14px !important;
            }

            .admin-mobile-header .navbar-brand {
                min-width: 0;
                font-size: 1.05rem !important;
            }

            .admin-mobile-header .btn {
                width: 46px;
                height: 46px;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                border-radius: 14px;
                background: rgba(255, 255, 255, 0.08);
            }

            .admin-sidebar {
                width: min(88vw, 320px) !important;
                max-width: min(88vw, 320px) !important;
                position: fixed !important;
            }

            .admin-sidebar .admin-link {
                min-height: 42px;
                padding: 0.65rem 0.8rem;
                border-radius: 12px;
            }

            .admin-main-content {
                width: 100% !important;
                max-width: 100% !important;
                padding: 12px !important;
                overflow-x: hidden;
            }

            .admin-global-search {
                margin-bottom: 12px !important;
            }

            .admin-global-search input {
                min-height: 46px;
                font-size: 16px;
            }
        }
    </style>
</head>
<body class="theme-admin">
    <div class="container-fluid p-0">
        <!-- Mobile Header -->
        <div class="admin-mobile-header d-md-none bg-dark text-white p-3 d-flex justify-content-between align-items-center shadow-sm sticky-top z-3">
            <a class="navbar-brand d-flex align-items-center fs-5 m-0" href="/">
                <img src="/images/car_rental_logo.png" alt="Logo" class="me-2 logo-admin-mobile" />
                CarRental
            </a>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-light border-0 admin-theme-toggle" type="button" title="Đổi giao diện sáng/tối" aria-label="Đổi giao diện sáng/tối">
                    <i class="bi bi-moon-stars-fill" data-theme-icon></i>
                </button>
                <button class="btn btn-outline-light border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar">
                    <i class="bi bi-list fs-3"></i>
                </button>
            </div>
        </div>

        <div class="row g-0 admin-shell-row">
            <!-- Sidebar -->
            <div class="col-12 col-md-auto admin-sidebar offcanvas-md offcanvas-start d-flex flex-column z-index-master" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel" style="height: 100vh; overflow-y: auto; position: sticky; top: 0;">
                <div class="offcanvas-header d-md-none border-bottom border-light border-opacity-10 mt-2">
                    <span class="offcanvas-title text-white fs-5 fw-bold" id="adminSidebarLabel">
                        <img src="/images/car_rental_logo.png" alt="Logo" class="me-2 logo-admin-offcanvas" />
                        CarRental
                    </span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close"></button>
                </div>
                
                <div class="px-3 py-4 mb-2 d-none d-md-block">
                    <a class="navbar-brand d-flex align-items-center mb-1 fs-4" href="/">
                        <img src="/images/car_rental_logo.png" alt="Logo" class="me-2 logo-admin-desktop" />
                        CarRental
                    </a>
                    <span class="text-white-50 small text-uppercase fw-bold opacity-50 ls-1 text-control-center">Trung tâm Điều hành</span>
                    <div class="mt-2">
                        @if (User.IsInRole("Admin"))
                        {
                            <span class="badge bg-primary rounded-pill px-2 py-1" style="font-size:0.65rem;">
                                <i class="bi bi-shield-lock-fill me-1"></i>Quản trị viên
                            </span>
                        }
                        else if (User.IsInRole("Manager"))
                        {
                            <span class="badge bg-danger rounded-pill px-2 py-1" style="font-size:0.65rem;">
                                <i class="bi bi-shield-check-fill me-1"></i>Quản lý
                            </span>
                        }
                        else if (User.IsInRole("Staff"))
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-2 py-1" style="font-size:0.65rem;">
                                <i class="bi bi-person-badge-fill me-1"></i>Nhân viên
                            </span>
                        }
                    </div>
                </div>

                <!-- Dropdown chon khu vuc (chi hien thi neu co it nhat 1 khu vuc) -->
                @await Component.InvokeAsync("AreaSelector")

                <!-- Badge counts from database (set before nav renders) -->
                @await Component.InvokeAsync("AdminBadgeCounts")

                @{
                    var pendingDriverCount = ViewData["PendingDriverCount"] as int? ?? 0;
                    var contractBadgeCount = ViewData["ContractBadgeCount"] as int? ?? 0;
                }

                <nav class="nav flex-column px-2 pb-4 flex-grow-1">
                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i> Tổng quan
                    </a>

                    @if (User.IsInRole("Admin") || User.IsInRole("Manager"))
                    {
                        <div class="mb-2">
                            <a class="admin-link d-flex justify-content-between align-items-center w-100" data-bs-toggle="collapse" href="#managementDropdown" role="button" aria-expanded="false">
                                <span><i class="bi bi-kanban-fill"></i> Quản lý</span>
                                <i class="bi bi-chevron-down small opacity-50 ms-auto" style="font-size: 0.75rem;"></i>
                            </a>
                            <div class="collapse @(new[]{"Car", "CarApproval", "Booking", "User", "Maintenance", "Driver", "Membership", "PartnerContract", "DigitalContract", "HolidayPricing"}.Contains(ViewContext.RouteData.Values["controller"]?.ToString()) ? "show" : "") ps-3" id="managementDropdown">
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Car" && ViewContext.RouteData.Values["action"]?.ToString() == "Manage" ? "active" : "")" asp-area="Admin" asp-controller="Car" asp-action="Manage">
                                        <i class="bi bi-car-front-fill" style="font-size: 1.1rem;"></i> Đội xe
                                    </a>
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CarApproval" ? "active" : "")" asp-area="Admin" asp-controller="CarApproval" asp-action="Index">
                                        <i class="bi bi-check2-square" style="font-size: 1.1rem;"></i> Duyệt Xe Mới
                                    </a>
                                }
                                @if (User.IsInRole("Manager"))
                                {
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CarApproval" ? "active" : "")" asp-area="Admin" asp-controller="CarApproval" asp-action="Index">
                                        <i class="bi bi-check2-square" style="font-size: 1.1rem;"></i> Duyệt Xe Mới
                                    </a>
                                }
                                @if (User.IsInRole("Admin"))
                                {
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payment" ? "active" : "")" asp-area="Admin" asp-controller="Payment" asp-action="Index">
                                        <i class="bi bi-currency-exchange" style="font-size: 1.1rem;"></i> Lịch sử Giao dịch
                                    </a>
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "DigitalContract" ? "active" : "")" asp-area="Admin" asp-controller="DigitalContract" asp-action="Index">
                                        <i class="bi bi-file-earmark-medical-fill" style="font-size: 1.1rem;"></i> Hợp đồng số
                                    </a>
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "PartnerContract" ? "active" : "")" asp-area="Admin" asp-controller="PartnerContract" asp-action="Index">
                                        <i class="bi bi-file-earmark-person-fill" style="font-size: 1.1rem;"></i> HĐ Đối tác/Tài xế
                                        @if (contractBadgeCount > 0)
                                        {
                                            <span class="badge bg-danger rounded-pill ms-auto" style="font-size: 0.65rem; padding: 2px 6px;">
                                                @(contractBadgeCount > 99 ? "99+" : contractBadgeCount)
                                            </span>
                                        }
                                    </a>
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-area="Admin" asp-controller="User" asp-action="Index">
                                        <i class="bi bi-people-fill" style="font-size: 1.1rem;"></i> Người dùng
                                    </a>
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "User" && ViewContext.RouteData.Values["action"]?.ToString() == "PartnerRequests" ? "active" : "")" asp-area="Admin" asp-controller="User" asp-action="PartnerRequests">
                                        <i class="bi bi-person-badge-fill" style="font-size: 1.1rem;"></i> Duyệt Đối tác
                                    </a>
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Driver" ? "active" : "")" asp-area="Admin" asp-controller="Driver" asp-action="Index">
                                        <i class="bi bi-person-workspace" style="font-size: 1.1rem;"></i> Hồ sơ Tài xế
                                        @if (pendingDriverCount > 0)
                                        {
                                            <span class="badge bg-danger rounded-pill ms-auto" style="font-size: 0.65rem; padding: 2px 6px;">
                                                @(pendingDriverCount > 99 ? "99+" : pendingDriverCount)
                                            </span>
                                        }
                                    </a>
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Membership" ? "active" : "")" asp-area="Admin" asp-controller="Membership" asp-action="Index">
                                        <i class="bi bi-gem text-info" style="font-size: 1.1rem;"></i> Hạng TV & Hợp đồng
                                    </a>
                                }
                                <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking" ? "active" : "")" asp-area="Admin" asp-controller="Booking" asp-action="Index">
                                    <i class="bi bi-calendar2-check-fill" style="font-size: 1.1rem;"></i> Đơn đặt xe
                                </a>
                                <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Maintenance" ? "active" : "")" asp-area="Admin" asp-controller="Maintenance" asp-action="Index">
                                    <i class="bi bi-tools" style="font-size: 1.1rem;"></i> Bảo trì
                                </a>

                                @if (User.IsInRole("Manager"))
                                {
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Car" && ViewContext.RouteData.Values["action"]?.ToString() != "Trash" ? "active" : "")" asp-area="Admin" asp-controller="Car" asp-action="Manage">
                                        <i class="bi bi-car-front-fill" style="font-size: 1.1rem;"></i> Đội xe
                                    </a>
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Car" && ViewContext.RouteData.Values["action"]?.ToString() == "Trash" ? "active" : "")" asp-area="Admin" asp-controller="Car" asp-action="Trash">
                                        <i class="bi bi-trash3" style="font-size: 1.1rem;"></i> Thùng rác xe
                                    </a>
                                }
                            </div>
                        </div>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="mb-2">
                            <a class="admin-link d-flex justify-content-between align-items-center w-100" data-bs-toggle="collapse" href="#crmDropdown" role="button" aria-expanded="false">
                                <span><i class="bi bi-headset"></i> CRM & Marketing</span>
                                <i class="bi bi-chevron-down small opacity-50 ms-auto" style="font-size: 0.75rem;"></i>
                            </a>
                            <div class="collapse @(new[]{"Promotions", "Contacts", "Reviews"}.Contains(ViewContext.RouteData.Values["controller"]?.ToString()) ? "show" : "") ps-3" id="crmDropdown">
                                <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Promotions" ? "active" : "")" asp-area="Admin" asp-controller="Promotions" asp-action="Index">
                                    <i class="bi bi-ticket-perforated-fill" style="font-size: 1.1rem;"></i> Mã Khuyến Mãi
                                </a>
                                <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Contacts" ? "active" : "")" asp-area="Admin" asp-controller="Contacts" asp-action="Index">
                                    <i class="bi bi-envelope-paper-heart-fill" style="font-size: 1.1rem;"></i> Hỗ trợ (Inbox)
                                </a>
                                <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reviews" ? "active" : "")" asp-area="Admin" asp-controller="Reviews" asp-action="Index">
                                    <i class="bi bi-star-fill text-warning" style="font-size: 1.1rem;"></i> Kiểm duyệt Đánh giá
                                </a>
                            </div>
                        </div>

                        <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Alert" ? "active" : "")" asp-area="Admin" asp-controller="Alert" asp-action="Index">
                            <i class="bi bi-shield-lock-fill"></i> Bảo mật
                        </a>

                        <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AuditLog" ? "active" : "")" asp-area="Admin" asp-controller="AuditLog" asp-action="Index">
                            <i class="bi bi-clipboard-data-fill"></i> Audit Log
                        </a>

                        <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Snapshot" ? "active" : "")" asp-area="Admin" asp-controller="Snapshot" asp-action="Index">
                            <i class="bi bi-archive-fill"></i> Sao lưu & Phục hồi
                        </a>
                    }

                    @if (User.IsInRole("Manager") || User.IsInRole("Staff") || User.IsInRole("Admin"))
                    {
                        <div class="mb-2">
                            <a class="admin-link d-flex justify-content-between align-items-center w-100" data-bs-toggle="collapse" href="#areaDropdown" role="button" aria-expanded="false">
                                <span><i class="bi bi-geo-alt-fill"></i> Khu vực</span>
                                <i class="bi bi-chevron-down small opacity-50 ms-auto" style="font-size: 0.75rem;"></i>
                            </a>
                            <div class="collapse @(new[]{"AreaDashboard", "Area", "AreaStaff", "CarApproval"}.Contains(ViewContext.RouteData.Values["controller"]?.ToString()) ? "show" : "") ps-3" id="areaDropdown">
                                <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AreaDashboard" ? "active" : "")" asp-area="Admin" asp-controller="AreaDashboard" asp-action="Index">
                                    <i class="bi bi-grid-3x3-gap-fill" style="font-size: 1.1rem;"></i> Dashboard Khu vực
                                </a>
                                <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "CarApproval" ? "active" : "")" asp-area="Admin" asp-controller="CarApproval" asp-action="Index">
                                    <i class="bi bi-check2-square" style="font-size: 1.1rem;"></i> Duyệt Xe Mới
                                </a>
                                @if (User.IsInRole("Manager") || User.IsInRole("Admin"))
                                {
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Area" ? "active" : "")" asp-area="Admin" asp-controller="Area" asp-action="Index">
                                        <i class="bi bi-geo-alt-fill" style="font-size: 1.1rem;"></i> Danh sách Khu vực
                                    </a>
                                }
                                @if (User.IsInRole("Admin") || User.IsInRole("Manager") || User.IsInRole("Staff"))
                                {
                                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AreaBooking" ? "active" : "")" asp-area="Admin" asp-controller="AreaBooking" asp-action="Index">
                                        <i class="bi bi-clipboard-check" style="font-size: 1.1rem;"></i> Đơn xe khu vực
                                    </a>
                                }
                            </div>
                        </div>

                    }

                    @if (User.IsInRole("Admin"))
                    {

                        <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Lookups" ? "active" : "")" asp-area="Admin" asp-controller="Lookups" asp-action="Index">
                            <i class="bi bi-sliders2"></i> Danh mục hệ thống
                        </a>

                        <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "HolidayPricing" ? "active" : "")" asp-area="Admin" asp-controller="HolidayPricing" asp-action="Index">
                            <i class="bi bi-calendar-event"></i> Giá theo ngày lễ
                        </a>

                        <div class="mb-2">
                            <a class="admin-link d-flex justify-content-between align-items-center w-100" data-bs-toggle="collapse" href="#trackingDropdownAdmin" role="button" aria-expanded="false">
                                <span><i class="bi bi-radar"></i> Theo dõi</span>
                                <i class="bi bi-chevron-down small opacity-50 ms-auto" style="font-size: 0.75rem;"></i>
                            </a>
                            <div class="collapse show ps-3" id="trackingDropdownAdmin">
                                <a class="admin-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Map" ? "active" : "")" asp-area="" asp-controller="Tracking" asp-action="Map">
                                    <i class="bi bi-geo-alt-fill" style="font-size: 1.1rem;"></i> Bản đồ số
                                </a>
                                <a class="admin-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Connect" ? "active" : "")" asp-area="" asp-controller="Tracking" asp-action="Connect">
                                    <i class="bi bi-phone-vibrate-fill" style="font-size: 1.1rem;"></i> Kết nối IoT
                                </a>
                            </div>
                        </div>
                    }

                    <div class="mt-auto pt-4 px-2 mb-3">
                        <div class="border-top border-white border-opacity-10 pt-4">
                            <a class="admin-link text-info" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-display"></i> Xem website
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="admin-link text-success" asp-area="" asp-controller="Guide" asp-action="Index" asp-route-role="admin">
                                    <i class="bi bi-book-fill"></i> Hướng dẫn sử dụng
                                </a>
                            }
                            else if (User.IsInRole("Manager"))
                            {
                                <a class="admin-link text-success" asp-area="" asp-controller="Guide" asp-action="Index" asp-route-role="manager">
                                    <i class="bi bi-book-fill"></i> Hướng dẫn (Manager)
                                </a>
                            }
                            else if (User.IsInRole("Staff"))
                            {
                                <a class="admin-link text-success" asp-area="" asp-controller="Guide" asp-action="Index" asp-route-role="staff">
                                    <i class="bi bi-book-fill"></i> Hướng dẫn (Staff)
                                </a>
                            }
                            <a class="admin-link text-danger" asp-area="" asp-controller="Auth" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                            </a>
                        </div>
                    </div>
                </nav>
            </div>

            <!-- Main content -->
            <main class="col-12 col-md admin-main-content app-main-shell" style="min-height: 100vh; overflow-x: hidden; background-color: var(--admin-bg);">
                <!-- Desktop Top Navbar -->
                <div class="admin-desktop-topbar d-none d-md-flex justify-content-between align-items-center mb-4 p-3 rounded-4 shadow-sm" style="background-color: var(--admin-surface); border: 1px solid var(--admin-border);">
                    <div class="d-flex align-items-center">
                        @if (User.IsInRole("Admin"))
                        {
                            <h5 class="mb-0 fw-bold ms-2" style="color: var(--admin-text);"><i class="bi bi-shield-lock-fill text-primary me-2"></i>Hệ thống Quản trị CarRental</h5>
                        }
                        else if (User.IsInRole("Manager"))
                        {
                            <h5 class="mb-0 fw-bold ms-2" style="color: var(--admin-text);"><i class="bi bi-shield-check-fill text-danger me-2"></i>Quản lý Khu vực</h5>
                        }
                        else
                        {
                            <h5 class="mb-0 fw-bold ms-2" style="color: var(--admin-text);"><i class="bi bi-person-badge-fill text-warning me-2"></i>Nhân viên Khu vực</h5>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn rounded-circle admin-theme-toggle" type="button" id="adminThemeToggle" title="Đổi giao diện sáng/tối" aria-label="Đổi giao diện sáng/tối">
                            <i class="bi bi-moon-stars-fill" data-theme-icon></i>
                        </button>
                        <div class="dropdown">
                            <button class="btn rounded-circle position-relative notif-bell-btn" data-bs-toggle="dropdown" aria-expanded="false" id="notifBellBtn" style="background-color: var(--admin-surface-2); border: 1px solid var(--admin-border);">
                                <i class="bi bi-bell-fill" style="color: var(--admin-text-secondary);"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notifBadge" style="display:none; font-size:0.6rem;">
                                    0
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm mt-2 p-0" style="min-width: 340px; max-height: 400px; overflow-y: auto; background-color: var(--admin-surface); border: 1px solid var(--admin-border);" id="notifDropdown">
                                <li class="px-3 py-2 border-bottom" style="background-color: var(--admin-surface-2); border-color: var(--admin-border) !important;">
                                    <strong class="small" style="color: var(--admin-text);">Thông báo gần đây</strong>
                                </li>
                                <li><div class="text-center py-3" style="color: #64748b;">
                                        <i class="bi bi-bell-slash fs-3 d-block mb-2 opacity-50"></i>
                                        <small>Đang tải...</small>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark" id="adminProfileDrop" data-bs-toggle="dropdown" aria-expanded="false">
                                @if (!string.IsNullOrWhiteSpace(layoutFaceUrl))
                                {
                                    <img src="@layoutFaceUrl" alt="@layoutUserName" width="38" height="38" class="rounded-circle me-2 shadow-sm" style="border-radius: 50% !important; object-fit: cover;">
                                }
                                else
                                {
                                    <span class="rounded-circle me-2 shadow-sm d-inline-flex align-items-center justify-content-center fw-bold text-white" style="width:38px;height:38px;background:#0ea5e9;">@layoutInitials</span>
                                }
                                <strong>@(User.Identity.Name ?? "Quản trị viên")</strong>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm mt-2" aria-labelledby="adminProfileDrop" style="background-color: var(--admin-surface); border: 1px solid var(--admin-border);">
                                <li><a class="dropdown-item py-2" asp-area="" asp-controller="Auth" asp-action="Profile"><i class="bi bi-person me-2 text-primary"></i> Hồ sơ cá nhân</a></li>
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item py-2" asp-area="Admin" asp-controller="Lookups" asp-action="Index"><i class="bi bi-gear me-2 text-secondary"></i> Cài đặt danh mục</a></li>
                                }
                                <li><hr class="dropdown-divider my-2"></li>
                                <li><a class="dropdown-item text-danger py-2 fw-bold" asp-area="" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                <div class="admin-global-search mb-3" data-admin-global-search>
                    <i class="bi bi-search"></i>
                    <input type="search" class="form-control" placeholder="Tìm nhanh trong bảng hiện tại..." data-admin-table-search />
                </div>
                @RenderBody()
            </main>
        </div>
    </div>
    
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/smartrental-map.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const themeToggles = document.querySelectorAll('.admin-theme-toggle');
            const themeIcons = document.querySelectorAll('[data-theme-icon]');

            function applyAdminTheme(theme) {
                document.documentElement.setAttribute('data-bs-theme', theme);
                localStorage.setItem('admin-theme', theme);
                themeIcons.forEach(icon => {
                    icon.className = theme === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
                });
            }

            applyAdminTheme(document.documentElement.getAttribute('data-bs-theme') || 'dark');
            themeToggles.forEach(btn => {
                btn.addEventListener('click', () => {
                    const nextTheme = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                    applyAdminTheme(nextTheme);
                });
            });

            @if (TempData["Success"] != null) {
                <text>
                Toastify({
                    text: "@Html.Raw(TempData["Success"])",
                    duration: 4000,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #00b09b, #96c93d)", borderRadius: "12px" }
                }).showToast();
                </text>
            }
            @if (TempData["Error"] != null) {
                <text>
                Toastify({
                    text: "@Html.Raw(TempData["Error"])",
                    duration: 5000,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #ff5f6d, #ffc371)", borderRadius: "12px" }
                }).showToast();
                </text>
            }

            // Notification Bell Polling
            let currentNotifCount = 0;
            
            function loadNotifications() {
                fetch('/Admin/Booking/GetRecentNotifications')
                    .then(r => r.json())
                    .then(data => {
                        const badge = document.getElementById('notifBadge');
                        const dropdown = document.getElementById('notifDropdown');
                        
                        currentNotifCount = data.count || 0;
                        const lastSeenStr = localStorage.getItem('lastSeenNotifCount') || '0';
                        const lastSeenCount = parseInt(lastSeenStr);
                        
                        if (currentNotifCount > 0 && currentNotifCount > lastSeenCount) {
                            badge.textContent = currentNotifCount - lastSeenCount;
                            badge.style.display = 'inline-block';
                        } else {
                            badge.style.display = 'none';
                        }

                        // Keep header
                        let html = '<li class="px-3 py-2 border-bottom admin-notification-header"><strong class="small">Thông báo gần đây (' + currentNotifCount + ')</strong></li>';
                        
                        if (data.items && data.items.length > 0) {
                            data.items.forEach(function(item) {
                                html += '<li><a class="dropdown-item py-2 d-flex align-items-start gap-2 border-bottom" href="/Admin/Booking/Index">' +
                                    '<i class="bi ' + item.icon + ' mt-1"></i>' +
                                    '<div><div class="small">' + item.message + '</div>' +
                                    '<small class="text-muted">' + item.time + '</small></div></a></li>';
                            });
                        } else {
                            html += '<li><div class="text-center py-3" style="color: #64748b;"><i class="bi bi-bell-slash fs-3 d-block mb-2 opacity-50"></i><small>Chưa có thông báo mới.</small></div></li>';
                        }
                        dropdown.innerHTML = html;
                    })
                    .catch(err => console.error('Notification fetch error:', err));
            }

            loadNotifications();
            setInterval(loadNotifications, 15000); // Poll every 15s

            // Hide badge on click and save seen count
            const notifBtn = document.getElementById('notifBellBtn');
            if (notifBtn) {
                notifBtn.addEventListener('click', function() {
                    const badge = document.getElementById('notifBadge');
                    if (badge) {
                        badge.style.display = 'none';
                    }
                    localStorage.setItem('lastSeenNotifCount', currentNotifCount.toString());
                });
            }
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
