<!DOCTYPE html>
<html lang="vi" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý Khu vực</title>
    <script>
        (() => {
            const savedTheme = localStorage.getItem('admin-theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    @RenderSection("Styles", required: false)
    <style>
        html { font-size: 13px; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: var(--admin-bg, #f8f9fa); color: var(--admin-text, #0f172a); }
        .admin-main-content { font-size: 0.85rem; }
        .admin-sidebar { background: #0f172a; color: #94a3b8; border-right: 1px solid rgba(255,255,255,0.05); font-size: 0.8rem; }
        .admin-link { color: #94a3b8; padding: 0.6rem 1rem; border-radius: 12px; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); margin-bottom: 0.35rem; text-decoration: none; display: flex; align-items: center; font-weight: 500; font-size: 0.8rem; }
        .admin-link:hover { background: rgba(255,255,255,0.05); color: #fff; transform: translateX(4px); }
        .admin-link i { font-size: 1.25rem; margin-right: 0.75rem; transition: transform 0.3s ease; }
        .admin-link.active { background: #3b82f6; color: #fff; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3); }
        .admin-link.active i { transform: scale(1.1); }
        .navbar-brand { font-weight: 800; letter-spacing: -1px; background: linear-gradient(135deg, #fff 0%, #94a3b8 100%); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
        .area-badge { background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.3); color: #60a5fa; border-radius: 20px; padding: 0.35rem 0.75rem; font-size: 0.7rem; font-weight: 600; }
        .section-label { font-size: 0.65rem; text-transform: uppercase; letter-spacing: 1px; color: rgba(148, 163, 184, 0.5); font-weight: 700; padding: 0.5rem 1rem 0.25rem; }
    </style>
</head>
<body class="theme-carrental theme-admin">
    <div class="container-fluid p-0">
        <!-- Mobile Header -->
        <div class="d-md-none bg-dark text-white p-3 d-flex justify-content-between align-items-center shadow-sm sticky-top z-3">
            <a class="navbar-brand d-flex align-items-center fs-5 m-0" href="/">
                <img src="/images/car_rental_logo.png" alt="Logo" class="me-2 logo-admin-mobile" />
                CarRental
            </a>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-outline-light border-0 admin-theme-toggle" type="button" title="Đổi giao diện sáng/tối" aria-label="Đổi giao diện sáng/tối">
                    <i class="bi bi-moon-stars-fill" data-theme-icon></i>
                </button>
                <button class="btn btn-outline-light border-0" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminSidebar" aria-controls="adminSidebar">
                    <i class="bi bi-list fs-3"></i>
                </button>
            </div>
        </div>

        <div class="row g-0">
            <!-- Sidebar -->
            <div class="col-12 col-md-2 admin-sidebar offcanvas-md offcanvas-start d-flex flex-column z-index-master" tabindex="-1" id="adminSidebar" aria-labelledby="adminSidebarLabel" style="height: 100vh; overflow-y: auto; position: sticky; top: 0;">
                <div class="offcanvas-header d-md-none border-bottom border-light border-opacity-10 mt-2">
                    <span class="offcanvas-title text-white fs-5 fw-bold" id="adminSidebarLabel">
                        <img src="/images/car_rental_logo.png" alt="Logo" class="me-2 logo-admin-offcanvas" />
                        CarRental
                    </span>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" data-bs-target="#adminSidebar" aria-label="Close"></button>
                </div>

                <div class="px-3 py-4 mb-2 d-none d-md-block">
                    <a class="navbar-brand d-flex align-items-center mb-1 fs-4" href="/">
                        <img src="/images/car_rental_logo.png" alt="Logo" class="me-2 logo-admin-desktop" />
                        CarRental
                    </a>
                    <span class="text-white-50 small text-uppercase fw-bold opacity-50 ls-1 text-control-center">Quản lý Khu vực</span>
                    <div class="mt-2">
                        @{
                            var sidebarRole = User.IsInRole("Manager") ? "Quản lý KV" : "Nhân viên KV";
                            var roleClass = User.IsInRole("Manager") ? "bg-danger" : "bg-warning text-dark";
                        }
                        <span class="badge @roleClass rounded-pill px-2 py-1" style="font-size:0.65rem;">
                            <i class="bi bi-shield-check me-1"></i>@sidebarRole
                        </span>
                    </div>
                </div>

                <!-- Dropdown chon khu vuc -->
                <div class="px-2 mb-1">
                    @await Component.InvokeAsync("AreaSelector")
                </div>

                <nav class="nav flex-column px-2 pb-4 flex-grow-1">
                    <!-- Tổng quan -->
                    <div class="section-label">Tổng quan</div>
                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "")" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2-fill"></i> Tổng quan
                    </a>
                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AreaDashboard" ? "active" : "")" asp-area="Admin" asp-controller="AreaDashboard" asp-action="Index">
                        <i class="bi bi-geo-alt-fill"></i> Khu vực của tôi
                    </a>

                    <!-- Quản lý -->
                    <div class="section-label mt-3">Quản lý</div>
                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Car" ? "active" : "")" asp-area="Admin" asp-controller="Car" asp-action="Manage">
                        <i class="bi bi-car-front-fill"></i> Đội xe
                    </a>
                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Booking" ? "active" : "")" asp-area="Admin" asp-controller="Booking" asp-action="Index">
                        <i class="bi bi-calendar2-check-fill"></i> Đơn đặt xe
                    </a>
                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Maintenance" ? "active" : "")" asp-area="Admin" asp-controller="Maintenance" asp-action="Index">
                        <i class="bi bi-tools"></i> Bảo trì
                    </a>

                    <!-- Cài đặt khu vực (chỉ Manager) -->
                    @if (User.IsInRole("Manager"))
                    {
                        <div class="section-label mt-3">Cài đặt Khu vực</div>
                        <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Area" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-area="Admin" asp-controller="Area" asp-action="Index">
                            <i class="bi bi-geo-alt-fill"></i> Danh sách Khu vực
                        </a>
                        <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "AreaStaff" ? "active" : "")" asp-area="Admin" asp-controller="AreaStaff" asp-action="Index" asp-route-areaId="@(ViewContext.HttpContext.Request.Cookies["CurrentAreaId"] ?? "0")">
                            <i class="bi bi-people-fill"></i> Phân quyền KV
                        </a>
                    }

                    <!-- Theo dõi -->
                    <div class="section-label mt-3">Theo dõi</div>
                    <a class="admin-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Map" ? "active" : "")" asp-area="" asp-controller="Tracking" asp-action="Map">
                        <i class="bi bi-geo-alt-fill"></i> Bản đồ số
                    </a>
                    <a class="admin-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Connect" ? "active" : "")" asp-area="" asp-controller="Tracking" asp-action="Connect">
                        <i class="bi bi-phone-vibrate-fill"></i> Kết nối IoT
                    </a>
                    <a class="admin-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Camera" ? "active" : "")" asp-area="Admin" asp-controller="Camera" asp-action="Monitor">
                        <i class="bi bi-camera-video-fill"></i> Camera ANPR
                    </a>

                    <!-- Footer -->
                    <div class="mt-auto pt-4 px-2 mb-3">
                        <div class="border-top border-white border-opacity-10 pt-4">
                            <a class="admin-link text-info" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-display"></i> Xem website
                            </a>
                            <a class="admin-link text-danger" asp-area="" asp-controller="Auth" asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i> Đăng xuất
                            </a>
                        </div>
                    </div>
                </nav>
            </div>

            <!-- Main content -->
            <main class="col-12 col-md-10 ms-sm-auto px-md-4 py-4 admin-main-content app-main-shell" style="min-height: 100vh; overflow-x: hidden; background-color: var(--admin-bg);">
                <!-- Desktop Top Navbar -->
                <div class="d-none d-md-flex justify-content-between align-items-center mb-4 bg-white p-3 rounded-4 shadow-sm border border-light">
                    <div class="d-flex align-items-center gap-3">
                        <div>
                            <h5 class="mb-0 fw-bold ms-2 text-dark">
                                @if (User.IsInRole("Manager"))
                                {
                                    <i class="bi bi-shield-check text-danger me-2"></i>
                                }
                                else
                                {
                                    <i class="bi bi-person-badge text-warning me-2"></i>
                                }
                                Quản lý Khu vực
                            </h5>
                        </div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn rounded-circle admin-theme-toggle" type="button" title="Đổi giao diện sáng/tối" aria-label="Đổi giao diện sáng/tối">
                            <i class="bi bi-moon-stars-fill" data-theme-icon></i>
                        </button>
                        <div class="dropdown">
                            <button class="btn btn-light rounded-circle position-relative notif-bell-btn" data-bs-toggle="dropdown" aria-expanded="false" id="notifBellBtn">
                                <i class="bi bi-bell-fill text-secondary"></i>
                                <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="notifBadge" style="display:none; font-size:0.6rem;">
                                    0
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2 p-0" style="min-width: 340px; max-height: 400px; overflow-y: auto;" id="notifDropdown">
                                <li class="px-3 py-2 bg-light border-bottom">
                                    <strong class="small">Thông báo gần đây</strong>
                                </li>
                                <li id="notifLoading">
                                    <div class="text-center py-3 text-muted">
                                        <i class="bi bi-bell-slash fs-3 d-block mb-2 opacity-50"></i>
                                        <small>Đang tải...</small>
                                    </div>
                                </li>
                            </ul>
                        </div>
                        <div class="dropdown">
                            <a href="#" class="d-flex align-items-center text-decoration-none dropdown-toggle text-dark" id="adminProfileDrop" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="https://ui-avatars.com/api/?name=@(User.Identity.Name ?? "User")&background=0D8ABC&color=fff" alt="mdo" width="38" height="38" class="rounded-circle me-2 shadow-sm">
                                <strong>@(User.Identity.Name ?? "Quản lý")</strong>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2" aria-labelledby="adminProfileDrop">
                                <li><a class="dropdown-item py-2" asp-area="" asp-controller="Auth" asp-action="Profile"><i class="bi bi-person me-2 text-primary"></i> Hồ sơ cá nhân</a></li>
                                <li><hr class="dropdown-divider my-2"></li>
                                <li><a class="dropdown-item text-danger py-2 fw-bold" asp-area="" asp-controller="Auth" asp-action="Logout"><i class="bi bi-box-arrow-right me-2"></i> Đăng xuất</a></li>
                            </ul>
                        </div>
                    </div>
                </div>

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/smartrental-map.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const themeToggles = document.querySelectorAll('.admin-theme-toggle');
            const themeIcons = document.querySelectorAll('[data-theme-icon]');

            function applyAdminTheme(theme) {
                document.documentElement.setAttribute('data-bs-theme', theme);
                localStorage.setItem('admin-theme', theme);
                themeIcons.forEach(icon => {
                    icon.className = theme === 'dark' ? 'bi bi-sun-fill' : 'bi bi-moon-stars-fill';
                });
            }

            applyAdminTheme(document.documentElement.getAttribute('data-bs-theme') || 'light');
            themeToggles.forEach(btn => {
                btn.addEventListener('click', () => {
                    const nextTheme = document.documentElement.getAttribute('data-bs-theme') === 'dark' ? 'light' : 'dark';
                    applyAdminTheme(nextTheme);
                });
            });

            @if (TempData["Success"] != null) {
                <text>
                Toastify({
                    text: @Json.Serialize(TempData["Success"]?.ToString() ?? ""),
                    duration: 4000,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #00b09b, #96c93d)", borderRadius: "12px" }
                }).showToast();
                </text>
            }
            @if (TempData["Error"] != null) {
                <text>
                Toastify({
                    text: @Json.Serialize(TempData["Error"]?.ToString() ?? ""),
                    duration: 5000,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #ff5f6d, #ffc371)", borderRadius: "12px" }
                }).showToast();
                </text>
            }
            @if (TempData["Info"] != null) {
                <text>
                Toastify({
                    text: @Json.Serialize(TempData["Info"]?.ToString() ?? ""),
                    duration: 5000,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #3b82f6, #60a5fa)", borderRadius: "12px" }
                }).showToast();
                </text>
            }

            // Notification Bell Polling
            let currentNotifCount = 0;

            function loadNotifications() {
                fetch('/Admin/Booking/GetRecentNotifications')
                    .then(r => r.json())
                    .then(data => {
                        const badge = document.getElementById('notifBadge');
                        const dropdown = document.getElementById('notifDropdown');

                        currentNotifCount = data.count || 0;
                        const lastSeenStr = localStorage.getItem('lastSeenNotifCount') || '0';
                        const lastSeenCount = parseInt(lastSeenStr);

                        if (currentNotifCount > 0 && currentNotifCount > lastSeenCount) {
                            badge.textContent = currentNotifCount - lastSeenCount;
                            badge.style.display = 'inline-block';
                        } else {
                            badge.style.display = 'none';
                        }

                        let html = '<li class="px-3 py-2 border-bottom admin-notification-header"><strong class="small">Thông báo gần đây (' + currentNotifCount + ')</strong></li>';

                        if (data.items && data.items.length > 0) {
                            data.items.forEach(function(item) {
                                html += '<li><a class="dropdown-item py-2 d-flex align-items-start gap-2 border-bottom" href="/Admin/Booking/Index">' +
                                    '<i class="bi ' + item.icon + ' mt-1"></i>' +
                                    '<div><div class="small">' + item.message + '</div>' +
                                    '<small class="text-muted">' + item.time + '</small></div></a></li>';
                            });
                        } else {
                            html += '<li><div class="text-center py-3 text-muted"><i class="bi bi-bell-slash fs-3 d-block mb-2 opacity-50"></i><small>Chưa có thông báo mới.</small></div></li>';
                        }
                        dropdown.innerHTML = html;
                    })
                    .catch(err => console.error('Notification fetch error:', err));
            }

            loadNotifications();
            setInterval(loadNotifications, 15000);

            const notifBtn = document.getElementById('notifBellBtn');
            if (notifBtn) {
                notifBtn.addEventListener('click', function() {
                    const badge = document.getElementById('notifBadge');
                    if (badge) badge.style.display = 'none';
                    localStorage.setItem('lastSeenNotifCount', currentNotifCount.toString());
                });
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
