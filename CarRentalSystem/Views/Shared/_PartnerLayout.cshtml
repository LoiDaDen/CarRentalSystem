<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Partner Portal | CarRental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    @RenderSection("Styles", required: false)
    <style>
        * { font-family: 'Plus Jakarta Sans', sans-serif; }
        body { background: #0d1117; color: #e2e8f0; }

        /* Sidebar */
        .partner-sidebar {
            background: linear-gradient(180deg, #0d1117 0%, #161b22 100%);
            border-right: 1px solid rgba(255,255,255,0.06);
            width: 260px;
            min-height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            overflow-y: auto;
            z-index: 100;
            transition: all 0.3s ease;
        }

        .partner-main {
            margin-left: 260px;
            min-height: 100vh;
            background: #f0f4f8;
            color: #1e293b;
        }

        .partner-topbar {
            background: #fff;
            border-bottom: 1px solid #e2e8f0;
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 99;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .sidebar-logo {
            padding: 1.5rem 1.5rem 1rem;
            border-bottom: 1px solid rgba(255,255,255,0.06);
        }

        .sidebar-brand {
            font-size: 1.25rem;
            font-weight: 800;
            background: linear-gradient(135deg, #f59e0b, #ef4444);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-decoration: none;
            letter-spacing: -0.5px;
        }

        .sidebar-section {
            padding: 0.75rem 1rem;
            font-size: 0.6rem;
            font-weight: 800;
            letter-spacing: 1.5px;
            text-transform: uppercase;
            color: rgba(255,255,255,0.25);
            margin-top: 0.5rem;
        }

        .partner-nav-link {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            padding: 0.7rem 1.25rem;
            border-radius: 12px;
            margin: 0.2rem 0.75rem;
            color: rgba(255,255,255,0.55);
            text-decoration: none;
            font-weight: 500;
            font-size: 0.9rem;
            transition: all 0.25s ease;
        }

        .partner-nav-link:hover {
            background: rgba(255,255,255,0.06);
            color: #fff;
            transform: translateX(3px);
        }

        .partner-nav-link.active {
            background: linear-gradient(135deg, rgba(245,158,11,0.2), rgba(239,68,68,0.1));
            color: #f59e0b;
            font-weight: 700;
            border-left: 3px solid #f59e0b;
        }

        .partner-nav-link i {
            font-size: 1.15rem;
            width: 20px;
            text-align: center;
            flex-shrink: 0;
        }

        /* Cards */
        .stat-card {
            border-radius: 20px;
            border: none;
            overflow: hidden;
            transition: transform 0.25s ease, box-shadow 0.25s ease;
        }
        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 40px rgba(0,0,0,0.1) !important;
        }

        .fw-800 { font-weight: 800; }

        /* Mobile */
        @@media (max-width: 991px) {
            .partner-sidebar { display: none; }
            .partner-main { margin-left: 0; }
        }

        /* Status badge colors */
        .badge-available { background: rgba(16,185,129,0.15); color: #10b981; }
        .badge-rented { background: rgba(59,130,246,0.15); color: #3b82f6; }
        .badge-pending { background: rgba(245,158,11,0.15); color: #f59e0b; }
        .badge-maintenance { background: rgba(239,68,68,0.15); color: #ef4444; }

        .content-area { padding: 2rem; }
    </style>
</head>
<body class="theme-carrental theme-partner">
    <!-- Sidebar -->
    <div class="partner-sidebar d-none d-lg-flex flex-column">
        <div class="sidebar-logo">
            <a href="/" class="sidebar-brand d-flex align-items-center">
                <img src="/images/car_rental_logo.png" alt="Logo" class="me-2 logo-partner-main" />
                CarRental
            </a>
            <div class="mt-1 partner-portal-label">Partner Portal</div>
        </div>

        <!-- User info -->
        <div class="px-3 py-3 border-bottom border-white border-opacity-5">
            <div class="d-flex align-items-center gap-3">
                <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                     class="partner-avatar">
                    <i class="bi bi-person-fill text-white"></i>
                </div>
                <div>
                    <div class="text-white fw-700 small">@(User.Identity?.Name ?? "Đối tác")</div>
                    <div class="small partner-account-label">Partner Account</div>
                </div>
            </div>
        </div>

        <nav class="flex-grow-1 py-2">
            <div class="sidebar-section">Tổng quan</div>
            <a class="partner-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
               asp-area="Partner" asp-controller="Dashboard" asp-action="Index">
                <i class="bi bi-grid-1x2-fill"></i> Dashboard
            </a>

            <div class="sidebar-section">Quản lý xe</div>
            <a class="partner-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "MyCars" ? "active" : "")"
               asp-area="Partner" asp-controller="Dashboard" asp-action="MyCars">
                <i class="bi bi-car-front-fill"></i> Đội xe của tôi
            </a>
            <a class="partner-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "AddCar" ? "active" : "")"
               asp-area="Partner" asp-controller="Dashboard" asp-action="AddCar">
                <i class="bi bi-plus-circle-fill"></i> Đăng xe mới
            </a>
            <a class="partner-nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Bookings" ? "active" : "")"
               asp-area="Partner" asp-controller="Dashboard" asp-action="Bookings">
                <i class="bi bi-calendar2-check-fill"></i> Đơn thuê xe
            </a>

            <div class="sidebar-section">Tài khoản</div>
            <a class="partner-nav-link" asp-area="" asp-controller="Auth" asp-action="Profile">
                <i class="bi bi-person-circle"></i> Hồ sơ cá nhân
            </a>
            <a class="partner-nav-link" asp-area="" asp-controller="Guide" asp-action="Index" asp-route-role="partner">
                <i class="bi bi-book-fill"></i> Hướng dẫn sử dụng
            </a>
            <a class="partner-nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                <i class="bi bi-display"></i> Xem trang chủ
            </a>
        </nav>

        <div class="px-3 py-3 border-top border-white border-opacity-5">
            <a class="partner-nav-link text-danger" asp-area="" asp-controller="Auth" asp-action="Logout">
                <i class="bi bi-box-arrow-right"></i> Đăng xuất
            </a>
        </div>
    </div>

    <!-- Main -->
    <div class="partner-main">
        <!-- Top bar -->
        <div class="partner-topbar">
            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-sm d-lg-none" id="sidebarToggle">
                    <i class="bi bi-list fs-4"></i>
                </button>
                <div>
                    <h6 class="fw-800 mb-0 text-dark">@ViewData["Title"]</h6>
                    <small class="text-muted" style="font-size:0.7rem;">CarRental Partner Portal</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-3">
                <a asp-area="Partner" asp-controller="Dashboard" asp-action="AddCar" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold shadow-sm">
                    <i class="bi bi-plus-lg me-1"></i>Đăng xe mới
                </a>
                <div class="rounded-circle d-flex align-items-center justify-content-center"
                     class="partner-avatar-sm">
                    <i class="bi bi-person-fill text-white"></i>
                </div>
            </div>
        </div>

        <div class="content-area app-main-shell">
            @RenderBody()
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/smartrental-map.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @if (TempData["Success"] != null) {
                <text>
                Toastify({
                    text: "@TempData["Success"]",
                    duration: 4000,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #f59e0b, #10b981)", borderRadius: "12px" }
                }).showToast();
                </text>
            }
            @if (TempData["Error"] != null) {
                <text>
                Toastify({
                    text: "@TempData["Error"]",
                    duration: 5000,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #ef4444, #dc2626)", borderRadius: "12px" }
                }).showToast();
                </text>
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
