<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarRental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/airbnb.css">
    <style>
        .hover-white:hover { color: white !important; }
        .hover-primary:hover { border-color: #0d6efd !important; color: #0d6efd !important; }
        
        @@media (min-width: 992px) {
            .dropdown:hover > .dropdown-menu { display: block; margin-top: 0; }
            .dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 15px;
                background: transparent;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="theme-carrental theme-public">
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark sticky-top text-nowrap app-navbar" style="z-index: 1050;">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/images/car_rental_logo.png" alt="Logo" class="me-2 logo-main" />
                    <span class="fw-bold">CarRental</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
@using CarRentalSystem.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@{
    var layoutLocations = await DbContext.Locations.ToListAsync();
    var currentRegionIdStr = Context.Request.Cookies["RegionID"];
    int? layoutCurrentRegionId = !string.IsNullOrEmpty(currentRegionIdStr) && int.TryParse(currentRegionIdStr, out int _parsedId) ? _parsedId : null;
    var currentRegionName = layoutCurrentRegionId.HasValue ? layoutLocations.FirstOrDefault(l => l.LocationID == layoutCurrentRegionId)?.Name ?? "Toàn quốc" : "Toàn quốc";
}
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Car" asp-action="Index">Đội xe</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Car" asp-action="MapSearch">
                                <i class="bi bi-map me-1"></i>Tìm xe trên bản đồ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-success fw-bold" asp-controller="LongTerm" asp-action="Index">
                                <i class="bi bi-briefcase me-1"></i>Thuê dài hạn
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Driver" asp-action="Index">
                                <i class="bi bi-person-badge me-1"></i>Thuê tài xế
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Membership" asp-action="Index">
                                <i class="bi bi-gem me-1"></i>Hạng thành viên
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-shield-lock me-1"></i>Quản trị
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item dropdown px-2 border-end border-secondary border-opacity-25 me-2">
                            <a class="nav-link dropdown-toggle text-warning fw-bold d-flex align-items-center" href="#" id="regionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-geo-alt-fill me-1 fs-5"></i>
                                <div class="d-none d-lg-block text-start ms-1">
                                    <span class="d-block text-white-50 text-region-label">Khu vực hiển thị</span>
                                    <span class="text-region-name">@currentRegionName</span>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow-lg border-0 dropdown-region" aria-labelledby="regionDropdown">
                                <li>
                                    <form asp-controller="Home" asp-action="SetRegion" method="post" class="m-0">
                                        <input type="hidden" name="locationId" value="" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="dropdown-item py-2 @(layoutCurrentRegionId == null ? "active fw-bold text-white bg-primary" : "")">
                                            <i class="bi bi-globe-asia-australia me-2"></i>Khu vực Toàn quốc
                                        </button>
                                    </form>
                                </li>
                                @foreach (var loc in layoutLocations)
                                {
                                    <li>
                                        <form asp-controller="Home" asp-action="SetRegion" method="post" class="m-0">
                                            <input type="hidden" name="locationId" value="@loc.LocationID" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="dropdown-item py-2 @(layoutCurrentRegionId == loc.LocationID ? "active fw-bold text-white bg-primary" : "")">
                                                <i class="bi bi-geo me-2"></i>Khu vực @loc.Name
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item px-2 border-end border-secondary border-opacity-25 me-2">
                                <a class="nav-link position-relative d-flex align-items-center py-1" asp-controller="Cart" asp-action="Index" id="cartLink" title="Giỏ hàng của tôi">
                                    <i class="bi bi-cart3 fs-4 text-white"></i>
                                    <span id="cartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger cart-badge">0</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown px-3">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="text-end me-2 d-none d-lg-block">
                                        <span class="text-white-50 small d-block text-greeting">Xin chào,</span>
                                        <span class="text-white fw-bold">@User.Identity.Name</span>
                                    </div>
                                    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center avatar-sm">
                                        <i class="bi bi-person-fill text-white"></i>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark animate slideIn shadow-lg border-0 dropdown-user" aria-labelledby="userDropdown">
                                    <li class="px-3 py-3 text-center border-bottom border-light border-opacity-10 mb-2">
                                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 avatar-md">
                                            <i class="bi bi-person-fill text-white fs-4"></i>
                                        </div>
                                        <h6 class="mb-0 text-white fw-bold">@User.Identity.Name</h6>
                                        <small class="text-white-50">
                                            @if (User.IsInRole("Admin")) { <text>Quản trị viên</text> }
                                            else if (User.IsInRole("Partner")) { <text>Đối tác</text> }
                                            else if (User.IsInRole("Staff")) { <text>Nhân viên</text> }
                                            else { <text>Thành viên</text> }
                                        </small>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center text-white" asp-controller="Auth" asp-action="Profile">
                                            <i class="bi bi-person text-white-50 me-3 fs-5"></i><span>Hồ sơ cá nhân</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center text-white" asp-controller="Ekyc" asp-action="Index">
                                            <i class="bi bi-shield-check text-success opacity-75 me-3 fs-5"></i><span>Xác thực eKYC</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center text-white" asp-controller="Booking" asp-action="MyBookings">
                                            <i class="bi bi-car-front text-white-50 me-3 fs-5"></i><span>Chuyến xe của tôi</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center text-warning" asp-area="Partner" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-building-check text-warning opacity-75 me-3 fs-5"></i><span class="fw-bold">Cổng Đối Tác (Partner)</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider border-light border-opacity-10 my-2"></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <h6 class="dropdown-header text-warning fw-bold text-uppercase admin-panel-label">Admin Panel</h6>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center text-white" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 text-white-50 me-3 fs-5"></i><span>Bảng điều khiển</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center text-info" asp-area="" asp-controller="Tracking" asp-action="Map">
                                                <i class="bi bi-radar text-info opacity-75 me-3 fs-5"></i><span>Theo dõi Live</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider border-light border-opacity-10 my-2"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item text-danger py-2 d-flex align-items-center" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right text-danger opacity-75 me-3 fs-5"></i><span class="fw-bold">Đăng xuất</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item ms-lg-3">
                                <a class="btn btn-primary btn-sm px-4" asp-controller="Auth" asp-action="Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-4 app-main-shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white pt-5 mt-5 border-top border-secondary border-opacity-25 app-footer">
        <div class="container py-4">
            <div class="row g-4">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <a class="navbar-brand d-inline-block mb-3 text-white text-decoration-none fs-4 fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="/images/car_rental_logo.png" alt="Logo" class="me-2 logo-footer" />
                        CarRental
                    </a>
                    <p class="text-white-50 small mb-4">Dịch vụ cho thuê xe tự lái cao cấp, tích hợp định vị trực tuyến, mang lại chuyến đi an toàn và minh bạch.</p>
                    <div class="d-flex gap-2">
                        <a href="#" class="text-white bg-secondary bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center transition-all hover-primary border border-transparent social-btn"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white bg-secondary bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center transition-all hover-primary border border-transparent social-btn"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="text-white bg-secondary bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center transition-all hover-primary border border-transparent social-btn"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                    <h6 class="text-uppercase fw-bold text-primary mb-4" style="letter-spacing: 1px;">Khám Phá</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Về chúng tôi</a></li>
                        <li class="mb-2"><a asp-controller="Car" asp-action="Index" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Đội xe</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Bảng giá</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Ưu đãi</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                    <h6 class="text-uppercase fw-bold text-primary mb-4" style="letter-spacing: 1px;">Hỗ Trợ</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Hỏi đáp FAQ</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Bảo mật</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Điều khoản</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Hướng dẫn</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-4">
                    <h6 class="text-uppercase fw-bold text-primary mb-4" style="letter-spacing: 1px;">Liên Hệ</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3 d-flex text-white-50 align-items-start">
                            <i class="bi bi-geo-alt-fill text-primary me-3 mt-1 fs-5"></i> 
                            <span>123 Tòa nhà Innovation, Quận 1<br/>TP. Hồ Chí Minh, Việt Nam</span>
                        </li>
                        <li class="mb-3 d-flex text-white-50 align-items-center">
                            <i class="bi bi-telephone-fill text-primary me-3 fs-5"></i> 
                            <span>1900 1234 (Hỗ trợ 24/7)</span>
                        </li>
                        <li class="d-flex text-white-50 align-items-center">
                            <i class="bi bi-envelope-fill text-primary me-3 fs-5"></i> 
                            <span>support@smartrental.vn</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="bg-black py-3 border-top border-secondary border-opacity-25 text-center text-md-start">
            <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
                <span class="text-white-50 small mb-2 mb-md-0">&copy; 2026 CarRental. All rights reserved.</span>
                <div>
                    <i class="bi bi-credit-card mx-2 text-white-50 fs-4"></i>
                    <i class="bi bi-paypal mx-2 text-white-50 fs-4"></i>
                    <i class="bi bi-apple mx-2 text-white-50 fs-4"></i>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/smartrental-map.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('input[type="datetime-local"]').forEach(function(el) {
                var currentVal = el.value;
                flatpickr(el, {
                    enableTime: true,
                    time_24hr: true,
                    dateFormat: 'Y-m-d\\TH:i',
                    altInput: true,
                    altFormat: 'd/m/Y - H:i',
                    locale: 'vn',
                    defaultDate: currentVal || null,
                    allowInput: true,
                    disableMobile: true
                });
            });
        });
    </script>
    <!-- AI Chatbot Widget -->
    <div id="chatbot-widget" style="position:fixed;bottom:90px;right:20px;width:370px;max-height:500px;z-index:9999;display:none;border-radius:20px;overflow:hidden;box-shadow:0 10px 40px rgba(0,0,0,.2);">
        <div style="background:linear-gradient(135deg,#0f172a,#1e40af);padding:16px 20px;display:flex;align-items:center;justify-content:space-between;">
            <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:38px;height:38px;background:rgba(255,255,255,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i class="bi bi-robot text-white fs-5"></i></div>
                <div><div style="color:#fff;font-weight:700;font-size:.95rem;">SmartCar AI</div><div style="color:rgba(255,255,255,.6);font-size:.7rem;">Trợ lý ảo 24/7</div></div>
            </div>
            <button onclick="document.getElementById('chatbot-widget').style.display='none'" style="background:none;border:none;color:rgba(255,255,255,.6);font-size:1.2rem;cursor:pointer;"><i class="bi bi-x-lg"></i></button>
        </div>
        <div id="chat-messages" style="height:320px;overflow-y:auto;padding:16px;background:#f8fafc;display:flex;flex-direction:column;gap:10px;">
            <div style="background:linear-gradient(135deg,#e0e7ff,#ede9fe);padding:12px 16px;border-radius:16px 16px 16px 4px;max-width:85%;font-size:.85rem;line-height:1.5;">Xin chào! 👋 Tôi là trợ lý ảo SmartCar. Bạn cần hỗ trợ gì ạ?</div>
        </div>
        <div style="padding:12px;background:#fff;border-top:1px solid #e2e8f0;display:flex;gap:8px;">
            <input id="chat-input" type="text" placeholder="Nhập câu hỏi..." style="flex:1;border:1px solid #e2e8f0;border-radius:24px;padding:10px 16px;font-size:.85rem;outline:none;" onkeypress="if(event.key==='Enter')sendChat()" />
            <button onclick="sendChat()" style="width:40px;height:40px;border-radius:50%;border:none;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;"><i class="bi bi-send-fill"></i></button>
        </div>
    </div>
    <button onclick="var w=document.getElementById('chatbot-widget');w.style.display=w.style.display==='none'?'flex':'none';w.style.flexDirection='column';" style="position:fixed;bottom:20px;right:20px;width:60px;height:60px;border-radius:50%;border:none;background:linear-gradient(135deg,#2563eb,#7c3aed);color:#fff;font-size:1.5rem;cursor:pointer;z-index:9998;box-shadow:0 6px 20px rgba(37,99,235,.4);display:flex;align-items:center;justify-content:center;transition:transform .3s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
        <i class="bi bi-chat-dots-fill"></i>
    </button>
    <script>
        function sendChat(){var i=document.getElementById('chat-input'),m=i.value.trim();if(!m)return;var c=document.getElementById('chat-messages');c.innerHTML+='<div style="background:#2563eb;color:#fff;padding:10px 16px;border-radius:16px 16px 4px 16px;max-width:85%;margin-left:auto;font-size:.85rem;">'+m.replace(/</g,'&lt;')+'</div>';i.value='';c.scrollTop=c.scrollHeight;fetch('/api/Chat',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({message:m})}).then(r=>r.json()).then(d=>{c.innerHTML+='<div style="background:linear-gradient(135deg,#e0e7ff,#ede9fe);padding:12px 16px;border-radius:16px 16px 16px 4px;max-width:85%;font-size:.85rem;line-height:1.5;white-space:pre-line;">'+d.reply+'</div>';c.scrollTop=c.scrollHeight;}).catch(()=>{c.innerHTML+='<div style="background:#fee2e2;padding:10px 16px;border-radius:16px;max-width:85%;font-size:.85rem;color:#dc2626;">Lỗi kết nối. Vui lòng thử lại.</div>';c.scrollTop=c.scrollHeight;});}
    </script>

    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @if (TempData["Success"] != null) {
                <text>
                Toastify({
                    text: "@Html.Raw(TempData["Success"])",
                    duration: 4000,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #00b09b, #96c93d)", borderRadius: "12px" }
                }).showToast();
                </text>
            }
            @if (TempData["Error"] != null) {
                <text>
                Toastify({
                    text: "@Html.Raw(TempData["Error"])",
                    duration: 5000,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #ff5f6d, #ffc371)", borderRadius: "12px" }
                }).showToast();
                </text>
            }
        });

        async function updateCartBadge() {
            try {
                const res = await fetch('/Cart/GetCartCount');
                if (res.ok) {
                    const data = await res.json();
                    const badge = document.getElementById('cartBadge');
                    if (badge && data.count > 0) {
                        badge.textContent = data.count;
                        badge.style.display = 'block';
                    } else if (badge) {
                        badge.style.display = 'none';
                    }
                }
            } catch(e) {}
        }
        @if (User.Identity.IsAuthenticated) {
            <text>document.addEventListener('DOMContentLoaded', updateCartBadge);</text>
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
