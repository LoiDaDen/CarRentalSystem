@using System.Security.Claims
@inject ApplicationDbContext LayoutDb
@{
    var layoutUserName = User.Identity?.Name ?? "User";
    string? layoutFaceUrl = null;
    if (User.Identity?.IsAuthenticated == true &&
        int.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var layoutUserId))
    {
        layoutFaceUrl = await LayoutDb.Users
            .AsNoTracking()
            .Where(u => u.UserID == layoutUserId)
            .Select(u => u.FaceUrl)
            .FirstOrDefaultAsync();
    }

    var layoutNameParts = layoutUserName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
    var layoutInitials = layoutNameParts.Length == 0
        ? "U"
        : string.Concat(layoutNameParts.Take(2).Select(p => p[0])).ToUpperInvariant();
    var layoutController = ViewContext.RouteData.Values["controller"]?.ToString();
    var layoutAction = ViewContext.RouteData.Values["action"]?.ToString();
    var layoutArea = ViewContext.RouteData.Values["area"]?.ToString();
    var isHomeActive = string.Equals(layoutController, "Home", StringComparison.OrdinalIgnoreCase);
    var isCarListActive = string.Equals(layoutController, "Car", StringComparison.OrdinalIgnoreCase)
        && string.Equals(layoutAction, "Index", StringComparison.OrdinalIgnoreCase);
    var isMapSearchActive = string.Equals(layoutController, "Car", StringComparison.OrdinalIgnoreCase)
        && string.Equals(layoutAction, "MapSearch", StringComparison.OrdinalIgnoreCase);
    var isBlogActive = string.Equals(layoutController, "Blog", StringComparison.OrdinalIgnoreCase);
    var isLongTermActive = string.Equals(layoutController, "LongTerm", StringComparison.OrdinalIgnoreCase);
    var isOwnerCarsActive = string.Equals(layoutController, "OwnerCars", StringComparison.OrdinalIgnoreCase);
    var isMembershipActive = string.Equals(layoutController, "Membership", StringComparison.OrdinalIgnoreCase);
    var isAdminAreaActive = string.Equals(layoutArea, "Admin", StringComparison.OrdinalIgnoreCase);
    var isWithDriverPublicEnabled = false;
}
<!DOCTYPE html>
