<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CarRental</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/themes/airbnb.css">
    <style>
        .hover-white:hover { color: white !important; }
        .hover-primary:hover { border-color: #0d6efd !important; color: #0d6efd !important; }
        .typing-dots span { animation: typingDot 1.4s infinite; }
        .typing-dots span:nth-child(2) { animation-delay: 0.2s; }
        .typing-dots span:nth-child(3) { animation-delay: 0.4s; }
        @@keyframes typingDot {
            0%, 80%, 100% { opacity: 0; }
            40% { opacity: 1; }
        }
        
        @@media (min-width: 992px) {
            .dropdown:hover > .dropdown-menu { display: block; margin-top: 0; }
            .dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 15px;
                background: transparent;
            }
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="theme-carrental theme-public">
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark sticky-top text-nowrap app-navbar" style="z-index: 1050;">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/images/car_rental_logo.png" alt="Logo" class="me-2 logo-main" />
                    <span class="fw-bold">CarRental</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarNav">
@using CarRentalSystem.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext DbContext
@{
    var layoutLocations = await DbContext.Locations.ToListAsync();
    var currentRegionIdStr = Context.Request.Cookies["RegionID"];
    int? layoutCurrentRegionId = !string.IsNullOrEmpty(currentRegionIdStr) && int.TryParse(currentRegionIdStr, out int _parsedId) ? _parsedId : null;
    var currentRegionName = layoutCurrentRegionId.HasValue ? layoutLocations.FirstOrDefault(l => l.LocationID == layoutCurrentRegionId)?.Name ?? "Toàn quốc" : "Toàn quốc";
}
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Trang chủ</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Car" asp-action="Index">Đội xe</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Car" asp-action="MapSearch">
                                <i class="bi bi-map me-1"></i>Tìm xe trên bản đồ
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-success fw-bold" asp-controller="LongTerm" asp-action="Index">
                                <i class="bi bi-briefcase me-1"></i>Thuê dài hạn
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Driver" asp-action="Index">
                                <i class="bi bi-person-badge me-1"></i>Thuê tài xế
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Membership" asp-action="Index">
                                <i class="bi bi-gem me-1"></i>Hạng thành viên
                            </a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-warning fw-bold" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                    <i class="bi bi-shield-lock me-1"></i>Quản trị
                                </a>
                            </li>
                        }
                        else if (User.IsInRole("Manager") || User.IsInRole("Staff"))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-danger fw-bold" asp-area="Admin" asp-controller="AreaDashboard" asp-action="Index">
                                    <i class="bi bi-geo-alt-fill me-1"></i>Khu vực
                                </a>
                            </li>
                        }
                    </ul>
                    <ul class="navbar-nav align-items-center">
                        <li class="nav-item dropdown px-2 border-end border-secondary border-opacity-25 me-2">
                            <a class="nav-link dropdown-toggle text-warning fw-bold d-flex align-items-center" href="#" id="regionDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-geo-alt-fill me-1 fs-5"></i>
                                <div class="d-none d-lg-block text-start ms-1">
                                    <span class="d-block text-white-50 text-region-label">Khu vực hiển thị</span>
                                    <span class="text-region-name">@currentRegionName</span>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark shadow-lg border-0 dropdown-region" aria-labelledby="regionDropdown">
                                <li>
                                    <form asp-controller="Home" asp-action="SetRegion" method="post" class="m-0">
                                        <input type="hidden" name="locationId" value="" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                        <button type="submit" class="dropdown-item py-2 @(layoutCurrentRegionId == null ? "active fw-bold text-white bg-primary" : "")">
                                            <i class="bi bi-globe-asia-australia me-2"></i>Khu vực Toàn quốc
                                        </button>
                                    </form>
                                </li>
                                @foreach (var loc in layoutLocations)
                                {
                                    <li>
                                        <form asp-controller="Home" asp-action="SetRegion" method="post" class="m-0">
                                            <input type="hidden" name="locationId" value="@loc.LocationID" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="dropdown-item py-2 @(layoutCurrentRegionId == loc.LocationID ? "active fw-bold text-white bg-primary" : "")">
                                                <i class="bi bi-geo me-2"></i>Khu vực @loc.Name
                                            </button>
                                        </form>
                                    </li>
                                }
                            </ul>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item px-2 border-end border-secondary border-opacity-25 me-2">
                                <a class="nav-link position-relative d-flex align-items-center py-1" asp-controller="Cart" asp-action="Index" id="cartLink" title="Giỏ hàng của tôi">
                                    <i class="bi bi-cart3 fs-4 text-white"></i>
                                    <span id="cartBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger cart-badge">0</span>
                                </a>
                            </li>
                            <li class="nav-item dropdown px-3">
                                <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <div class="text-end me-2 d-none d-lg-block">
                                        <span class="text-white-50 small d-block text-greeting">Xin chào,</span>
                                        <span class="text-white fw-bold">@User.Identity.Name</span>
                                    </div>
                                    <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center avatar-sm">
                                        <i class="bi bi-person-fill text-white"></i>
                                    </div>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark animate slideIn shadow-lg border-0 dropdown-user" aria-labelledby="userDropdown">
                                    <li class="px-3 py-3 text-center border-bottom border-light border-opacity-10 mb-2">
                                        <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2 avatar-md">
                                            <i class="bi bi-person-fill text-white fs-4"></i>
                                        </div>
                                        <h6 class="mb-0 text-white fw-bold">@User.Identity.Name</h6>
                                        <small class="text-white-50">
                                            @if (User.IsInRole("Admin")) { <text><span class="badge bg-primary rounded-pill px-2 py-1" style="font-size:0.6rem;"><i class="bi bi-shield-lock-fill me-1"></i>Quản trị viên</span></text> }
                                            else if (User.IsInRole("Manager")) { <text><span class="badge bg-danger rounded-pill px-2 py-1" style="font-size:0.6rem;"><i class="bi bi-shield-check-fill me-1"></i>Quản lý</span></text> }
                                            else if (User.IsInRole("Staff")) { <text><span class="badge bg-warning text-dark rounded-pill px-2 py-1" style="font-size:0.6rem;"><i class="bi bi-person-badge-fill me-1"></i>Nhân viên</span></text> }
                                            else if (User.IsInRole("Partner")) { <text>Đối tác</text> }
                                            else { <text>Thành viên</text> }
                                        </small>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center text-white" asp-controller="Auth" asp-action="Profile">
                                            <i class="bi bi-person text-white-50 me-3 fs-5"></i><span>Hồ sơ cá nhân</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center text-white" asp-controller="Booking" asp-action="MyBookings">
                                            <i class="bi bi-car-front text-white-50 me-3 fs-5"></i><span>Chuyến xe của tôi</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center text-white" asp-controller="Ekyc" asp-action="Index">
                                            <i class="bi bi-shield-check text-success opacity-75 me-3 fs-5"></i><span>Xác thực eKYC</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center text-warning" asp-area="Partner" asp-controller="Dashboard" asp-action="Index">
                                            <i class="bi bi-building-check text-warning opacity-75 me-3 fs-5"></i><span class="fw-bold">Cổng Đối Tác (Partner)</span>
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item py-2 d-flex align-items-center text-info" asp-area="Driver" asp-controller="DriverDashboard" asp-action="Index">
                                            <i class="bi bi-steering text-info opacity-75 me-3 fs-5"></i><span>Cổng Tài Xế (Driver)</span>
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider border-light border-opacity-10 my-2"></li>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <li>
                                            <h6 class="dropdown-header text-warning fw-bold text-uppercase admin-panel-label">Admin Panel</h6>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center text-white" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                                                <i class="bi bi-speedometer2 text-white-50 me-3 fs-5"></i><span>Bảng điều khiển</span>
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center text-info" asp-area="" asp-controller="Tracking" asp-action="Map">
                                                <i class="bi bi-radar text-info opacity-75 me-3 fs-5"></i><span>Theo dõi Live</span>
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider border-light border-opacity-10 my-2"></li>
                                    }
                                    else if (User.IsInRole("Manager") || User.IsInRole("Staff"))
                                    {
                                        <li>
                                            <h6 class="dropdown-header text-danger fw-bold text-uppercase">Khu vực Quản lý</h6>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2 d-flex align-items-center text-danger" asp-area="Admin" asp-controller="AreaDashboard" asp-action="Index">
                                                <i class="bi bi-geo-alt-fill text-danger opacity-75 me-3 fs-5"></i><span>Dashboard Khu vực</span>
                                            </a>
                                        </li>
                                    }
                                    <li>
                                        <a class="dropdown-item text-danger py-2 d-flex align-items-center" asp-controller="Auth" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right text-danger opacity-75 me-3 fs-5"></i><span class="fw-bold">Đăng xuất</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                            </li>
                            <li class="nav-item ms-lg-3">
                                <a class="btn btn-primary btn-sm px-4" asp-controller="Auth" asp-action="Register">Đăng ký</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-4 app-main-shell">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white pt-5 mt-5 border-top border-secondary border-opacity-25 app-footer">
        <div class="container py-4">
            <div class="row g-4">
                <div class="col-lg-4 mb-4 mb-lg-0">
                    <a class="navbar-brand d-inline-block mb-3 text-white text-decoration-none fs-4 fw-bold" asp-area="" asp-controller="Home" asp-action="Index">
                        <img src="/images/car_rental_logo.png" alt="Logo" class="me-2 logo-footer" />
                        CarRental
                    </a>
                    <p class="text-white-50 small mb-4">Dịch vụ cho thuê xe tự lái cao cấp, tích hợp định vị trực tuyến, mang lại chuyến đi an toàn và minh bạch.</p>
                    <div class="d-flex gap-2">
                        <a href="#" class="text-white bg-secondary bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center transition-all hover-primary border border-transparent social-btn"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-white bg-secondary bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center transition-all hover-primary border border-transparent social-btn"><i class="bi bi-twitter"></i></a>
                        <a href="#" class="text-white bg-secondary bg-opacity-25 rounded-circle d-flex align-items-center justify-content-center transition-all hover-primary border border-transparent social-btn"><i class="bi bi-instagram"></i></a>
                    </div>
                </div>
                <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                    <h6 class="text-uppercase fw-bold text-primary mb-4" style="letter-spacing: 1px;">Khám Phá</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Về chúng tôi</a></li>
                        <li class="mb-2"><a asp-controller="Car" asp-action="Index" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Đội xe</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Bảng giá</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Ưu đãi</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-4 mb-4 mb-md-0">
                    <h6 class="text-uppercase fw-bold text-primary mb-4" style="letter-spacing: 1px;">Hỗ Trợ</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Hỏi đáp FAQ</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Bảo mật</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Điều khoản</a></li>
                        <li class="mb-2"><a href="#" class="text-white-50 text-decoration-none hover-white transition-all"><i class="bi bi-chevron-right small me-1"></i> Hướng dẫn</a></li>
                    </ul>
                </div>
                <div class="col-lg-4 col-md-4">
                    <h6 class="text-uppercase fw-bold text-primary mb-4" style="letter-spacing: 1px;">Liên Hệ</h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-3 d-flex text-white-50 align-items-start">
                            <i class="bi bi-geo-alt-fill text-primary me-3 mt-1 fs-5"></i> 
                            <span>123 Tòa nhà Innovation, Quận 1<br/>TP. Hồ Chí Minh, Việt Nam</span>
                        </li>
                        <li class="mb-3 d-flex text-white-50 align-items-center">
                            <i class="bi bi-telephone-fill text-primary me-3 fs-5"></i> 
                            <span>1900 1234 (Hỗ trợ 24/7)</span>
                        </li>
                        <li class="d-flex text-white-50 align-items-center">
                            <i class="bi bi-envelope-fill text-primary me-3 fs-5"></i> 
                            <span>support@smartrental.vn</span>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="bg-black py-3 border-top border-secondary border-opacity-25 text-center text-md-start">
            <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
                <span class="text-white-50 small mb-2 mb-md-0">&copy; 2026 CarRental. All rights reserved.</span>
                <div>
                    <i class="bi bi-credit-card mx-2 text-white-50 fs-4"></i>
                    <i class="bi bi-paypal mx-2 text-white-50 fs-4"></i>
                    <i class="bi bi-apple mx-2 text-white-50 fs-4"></i>
                </div>
            </div>
        </div>
    </footer>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/js/smartrental-map.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/vn.js"></script>
    @await Html.PartialAsync("_CarCalendarModal")
    <script src="~/js/global-calendar.js" asp-append-version="true"></script>
    <script>
        // Custom global setup if needed, individual inputs are now handled by global-calendar.js
    </script>
    <!-- AI Chatbot Widget -->
    <div id="chatbot-widget" style="position:fixed;bottom:90px;right:20px;width:370px;max-height:520px;z-index:9999;display:none;border-radius:20px;overflow:hidden;box-shadow:0 10px 40px rgba(0,0,0,.2);">
        <div style="background:linear-gradient(135deg,#0f172a,#1e40af);padding:16px 20px;display:flex;align-items:center;justify-content:space-between;">
            <div style="display:flex;align-items:center;gap:10px;">
                <div style="width:38px;height:38px;background:rgba(255,255,255,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;"><i class="bi bi-robot text-white fs-5"></i></div>
                <div><div style="color:#fff;font-weight:700;font-size:.95rem;">SmartCar AI</div><div style="color:rgba(255,255,255,.6);font-size:.7rem;">Trợ lý ảo 24/7</div></div>
            </div>
            <div style="display:flex;gap:8px;align-items:center;">
                <button onclick="clearChatHistory()" title="Xóa lịch sử chat" style="background:none;border:none;color:rgba(255,255,255,.6);font-size:.85rem;cursor:pointer;padding:4px 8px;border-radius:8px;"><i class="bi bi-trash"></i></button>
                <button onclick="document.getElementById('chatbot-widget').style.display='none'" style="background:none;border:none;color:rgba(255,255,255,.6);font-size:1.2rem;cursor:pointer;"><i class="bi bi-x-lg"></i></button>
            </div>
        </div>
        <div id="chat-messages" style="height:300px;overflow-y:auto;padding:16px;background:#f8fafc;display:flex;flex-direction:column;gap:10px;">
            <div style="background:linear-gradient(135deg,#e0e7ff,#ede9fe);padding:12px 16px;border-radius:16px 16px 16px 4px;max-width:85%;font-size:.85rem;line-height:1.5;">Xin chào! 👋 Tôi là trợ lý ảo SmartCar. Bạn cần hỗ trợ gì ạ?</div>
        </div>
        <div id="chat-quick-replies" style="padding:8px 12px 4px;background:#fff;border-top:1px solid #e2e8f0;display:flex;flex-wrap:wrap;gap:6px;">
            <button onclick="requestGuide('customer')" style="background:#eff6ff;border:1px solid #bfdbfe;color:#1d4ed8;padding:6px 12px;border-radius:20px;font-size:.75rem;cursor:pointer;font-weight:600;white-space:nowrap;">
                <i class="bi bi-book me-1"></i>Hướng dẫn sử dụng
            </button>
            <button onclick="requestGuide('booking')" style="background:#f0fdf4;border:1px solid #bbf7d0;color:#15803d;padding:6px 12px;border-radius:20px;font-size:.75rem;cursor:pointer;font-weight:600;white-space:nowrap;">
                <i class="bi bi-car-front me-1"></i>Đặt xe
            </button>
            <button onclick="requestGuide('payment')" style="background:#fefce8;border:1px solid #fef08a;color:#a16207;padding:6px 12px;border-radius:20px;font-size:.75rem;cursor:pointer;font-weight:600;white-space:nowrap;">
                <i class="bi bi-credit-card me-1"></i>Thanh toán
            </button>
            <button onclick="requestGuide('ekyc')" style="background:#fdf4ff;border:1px solid #e9d5ff;color:#7e22ce;padding:6px 12px;border-radius:20px;font-size:.75rem;cursor:pointer;font-weight:600;white-space:nowrap;">
                <i class="bi bi-shield-check me-1"></i>Xác thực eKYC
            </button>
        </div>
        <div style="padding:10px 12px 12px;background:#fff;border-top:1px solid #e2e8f0;display:flex;gap:8px;">
            <input id="chat-input" type="text" placeholder="Nhập câu hỏi..." style="flex:1;border:1px solid #e2e8f0;border-radius:24px;padding:10px 16px;font-size:.85rem;outline:none;" onkeypress="if(event.key==='Enter')sendChat()" oninput="checkGuideKeywords(this.value)" />
            <button onclick="sendChat()" style="width:40px;height:40px;border-radius:50%;border:none;background:linear-gradient(135deg,#2563eb,#1d4ed8);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;"><i class="bi bi-send-fill"></i></button>
        </div>
    </div>
    <button onclick="var w=document.getElementById('chatbot-widget');w.style.display=w.style.display==='none'?'flex':'none';w.style.flexDirection='column';" style="position:fixed;bottom:20px;right:20px;width:60px;height:60px;border-radius:50%;border:none;background:linear-gradient(135deg,#2563eb,#7c3aed);color:#fff;font-size:1.5rem;cursor:pointer;z-index:9998;box-shadow:0 6px 20px rgba(37,99,235,.4);display:flex;align-items:center;justify-content:center;transition:transform .3s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
        <i class="bi bi-chat-dots-fill"></i>
    </button>

    <!-- Guide Modal -->
    <div class="modal fade" id="guideModal" tabindex="-1" aria-labelledby="guideModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header" style="background:linear-gradient(135deg,#0f172a,#1e40af);color:#fff;">
                    <h5 class="modal-title d-flex align-items-center gap-2" id="guideModalLabel">
                        <i class="bi bi-book-fill"></i> Hướng dẫn sử dụng
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" id="guideModalBody" style="max-height:65vh;overflow-y:auto;font-size:.9rem;line-height:1.7;">
                    <!-- Guide content loaded here -->
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <a id="guideModalLink" href="#" target="_blank" class="btn btn-primary">
                        <i class="bi bi-box-arrow-up-right me-1"></i>Mở trang Hướng dẫn
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        var guideKeywords = {
            customer: ['hướng dẫn', 'hdsd', 'hd', 'sử dụng', 'cách', 'hướng dẫn sử dụng', 'chỉ tôi', 'giúp tôi', 'tôi cần', 'làm sao', 'cách thuê', 'thuê xe', 'đặt xe', 'đăng ký', 'tài khoản', 'mật khẩu'],
            booking: ['đặt', 'thuê', 'xe', 'chuyến', 'ngày', 'giờ', 'nhận xe', 'trả xe', 'lịch', 'car', 'rent', 'booking'],
            payment: ['thanh toán', 'tiền', 'visa', 'napas', 'momo', 'zalo', 'chuyển khoản', 'hoàn tiền', 'refund', 'giá', 'phí'],
            ekcy: ['ekyc', 'ekc', 'xác thực', 'cccd', 'cmnd', 'bằng lái', ' căn cước', 'căn cước', 'xác minh', 'định danh', 'license', 'identity']
        };

        var guideResponses = {
            customer: {
                title: 'Hướng dẫn sử dụng — Khách hàng',
                text: 'Dưới đây là hướng dẫn sử dụng dành cho Khách hàng. Từ đăng ký, xác thực eKYC, tìm xe, đặt xe đến thanh toán và quản lý chuyến xe.',
                link: '/Guide?role=customer'
            },
            booking: {
                title: 'Hướng dẫn đặt xe',
                text: 'Quy trình đặt xe: 1) Đăng nhập & xác thực eKYC, 2) Chọn xe phù hợp, 3) Chọn ngày giờ nhận/trả, 4) Chọn địa điểm, 5) Thêm dịch vụ bổ sung (bảo hiểm, GPS...), 6) Thanh toán & xác nhận.',
                link: '/Guide?role=customer'
            },
            payment: {
                title: 'Hướng dẫn thanh toán',
                text: 'Chúng tôi hỗ trợ: Thẻ Visa/Mastercard, Thẻ ATM nội địa (Napas), Ví điện tử (MoMo, ZaloPay), Chuyển khoản ngân hàng. Thanh toán bảo mật qua cổng thanh toán. Hoàn tiền 3-5 ngày nếu hủy đơn đúng chính sách.',
                link: '/Guide?role=customer'
            },
            ekcy: {
                title: 'Hướng dẫn xác thực eKYC',
                text: 'Để thuê xe, bạn cần xác thực eKYC: 1) Truy cập /Ekyc/Index, 2) Upload ảnh CCCD mặt trước & sau, 3) Upload ảnh bằng lái, 4) Upload ảnh chân dung (selfie), 5) Chờ Admin duyệt trong 24h.',
                link: '/Guide?role=customer'
            }
        };

        var guideModal = null;
        document.addEventListener('DOMContentLoaded', function() {
            guideModal = new bootstrap.Modal(document.getElementById('guideModal'));
        });

        function requestGuide(type) {
            var c = document.getElementById('chat-messages');
            var info = guideResponses[type];

            var userMsg = type === 'customer' ? 'Tôi cần hướng dẫn sử dụng'
                : type === 'booking' ? 'Hướng dẫn đặt xe'
                : type === 'payment' ? 'Hướng dẫn thanh toán'
                : 'Hướng dẫn xác thực eKYC';

            c.innerHTML += '<div style="background:#2563eb;color:#fff;padding:10px 16px;border-radius:16px 16px 4px 16px;max-width:85%;margin-left:auto;font-size:.85rem;">' + userMsg.replace(/</g,'&lt;') + '</div>';
            c.scrollTop = c.scrollHeight;

            var botHtml = '<div style="background:linear-gradient(135deg,#e0e7ff,#ede9fe);padding:12px 16px;border-radius:16px 16px 16px 4px;max-width:85%;font-size:.85rem;line-height:1.5;">';
            botHtml += '<div style="font-weight:700;margin-bottom:6px;color:#1d4ed8;"><i class="bi bi-book-fill me-1"></i>' + info.title + '</div>';
            botHtml += '<div style="margin-bottom:10px;">' + info.text + '</div>';
            botHtml += '<div style="display:flex;gap:8px;flex-wrap:wrap;">';
            botHtml += '<a href="' + info.link + '" target="_blank" class="btn btn-primary btn-sm" style="border-radius:8px;font-size:.8rem;font-weight:600;">';
            botHtml += '<i class="bi bi-book me-1"></i>Xem Hướng dẫn</a>';
            botHtml += '</div></div>';
            c.innerHTML += botHtml;
            c.scrollTop = c.scrollHeight;
        }

        function checkGuideKeywords(text) {
            if (!text || text.trim().length < 3) return;
        }

        function openGuideModal(link, title) {
            document.getElementById('guideModalLabel').innerHTML = '<i class="bi bi-book-fill"></i> ' + title;
            document.getElementById('guideModalBody').innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><div class="mt-2 text-muted small">Đang tải nội dung...</div></div>';
            document.getElementById('guideModalLink').href = link;

            fetch(link)
                .then(function(r) { return r.text(); })
                .then(function(text) {
                    document.getElementById('guideModalBody').innerHTML = parseMarkdown(text);
                })
                .catch(function() {
                    document.getElementById('guideModalBody').innerHTML = '<div class="alert alert-warning"><i class="bi bi-exclamation-triangle me-2"></i>Không thể tải nội dung. Vui lòng <a href="' + link + '" target="_blank">mở trang Hướng dẫn</a>.</div>';
                });

            if (guideModal) guideModal.show();
        }

        function parseMarkdown(text) {
            var html = text
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')

                .replace(/^### (.+)$/gm, '<h5 class="mt-3 fw-bold">$1</h5>')
                .replace(/^## (.+)$/gm, '<h4 class="mt-4 fw-bold text-primary">$1</h4>')
                .replace(/^# (.+)$/gm, '<h3 class="fw-bold">$1</h3>')

                .replace(/^> \*\*(.+?)\*\*(.*)$/gm, '<div class="alert alert-info mb-2"><strong>$1</strong>$2</div>')

                .replace(/^---$/gm, '<hr class="my-3"/>')

                .replace(/\*\*\*(.+?)\*\*\*/g, '<strong><em>$1</em></strong>')
                .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
                .replace(/\*(.+?)\*/g, '<em>$1</em>')

                .replace(/```([\s\S]*?)```/g, '<pre class="bg-dark text-light p-3 rounded-3 small"><code>$1</code></pre>')

                .replace(/`([^`]+)`/g, '<code class="bg-light px-1 rounded">$1</code>')

                .replace(/^[\-\*] (.+)$/gm, '<li>$1</li>')
                .replace(/(<li>.*<\/li>\n?)+/g, '<ul class="mb-2">$&</ul>')

                .replace(/^\d+\. (.+)$/gm, '<li>$1</li>')

                .replace(/\|(.+)\|/g, function(m) {
                    var cells = m.split('|').filter(function(c) { return c.trim(); });
                    if (cells.every(function(c) { return /^[\-\s]+$/.test(c.trim()); })) return '';
                    return '<tr>' + cells.map(function(c) { return '<td>' + c.trim() + '</td>'; }).join('') + '</tr>';
                })
                .replace(/(<tr>.*<\/tr>\n?)+/g, '<table class="table table-bordered table-sm table-striped mb-2"><tbody>$&</tbody></table>')

                .replace(/\n\n/g, '</p><p>')
                .replace(/^(?!<[huplto])/gm, '');

            html = '<p>' + html + '</p>';
            html = html.replace(/<p>\s*<\/p>/g, '');
            html = html.replace(/<p>(<[huto])/g, '$1');
            html = html.replace(/(<\/[huto][\s\S]*?>)<\/p>/g, '$1');

            return html;
        }

        function getChatSessionId() {
            var id = localStorage.getItem('chat_session_id');
            if (!id) {
                id = 'session_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9);
                localStorage.setItem('chat_session_id', id);
            }
            return id;
        }

        function sendChat() {
            var i = document.getElementById('chat-input');
            var m = i.value.trim();
            if (!m) return;
            var c = document.getElementById('chat-messages');

            c.innerHTML += '<div style="background:#2563eb;color:#fff;padding:10px 16px;border-radius:16px 16px 4px 16px;max-width:85%;margin-left:auto;font-size:.85rem;">' + m.replace(/</g,'&lt;') + '</div>';
            i.value = '';
            i.disabled = true;
            c.scrollTop = c.scrollHeight;

            var typingId = 'typing-' + Date.now();
            c.innerHTML += '<div id="' + typingId + '" style="background:linear-gradient(135deg,#e0e7ff,#ede9fe);padding:12px 16px;border-radius:16px 16px 16px 4px;max-width:85%;font-size:.85rem;line-height:1.5;color:#6b7280;"><span>SmartCar đang nhập</span><span class="typing-dots"><span>.</span><span>.</span><span>.</span></span></div>';
            c.scrollTop = c.scrollHeight;

            var sessionId = getChatSessionId();
            fetch('/api/Chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: m, sessionId: sessionId })
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                var typingEl = document.getElementById(typingId);
                if (typingEl) typingEl.remove();

                var replyDiv = document.createElement('div');
                replyDiv.style.cssText = 'background:linear-gradient(135deg,#e0e7ff,#ede9fe);padding:12px 16px;border-radius:16px 16px 16px 4px;max-width:85%;font-size:.85rem;line-height:1.5;white-space:pre-line;';
                c.appendChild(replyDiv);

                var replyText = d.reply;
                var charIdx = 0;
                var typeSpeed = 15;

                function typeChar() {
                    if (charIdx < replyText.length) {
                        replyDiv.textContent += replyText.charAt(charIdx);
                        charIdx++;
                        c.scrollTop = c.scrollHeight;
                        var delay = typeSpeed + Math.random() * 10;
                        setTimeout(typeChar, delay);
                    } else {
                        i.disabled = false;
                        i.focus();
                    }
                }
                typeChar();
            })
            .catch(function() {
                var typingEl = document.getElementById(typingId);
                if (typingEl) typingEl.remove();
                c.innerHTML += '<div style="background:#fee2e2;padding:10px 16px;border-radius:16px;max-width:85%;font-size:.85rem;color:#dc2626;">Lỗi kết nối. Vui lòng thử lại.</div>';
                c.scrollTop = c.scrollHeight;
                i.disabled = false;
            });
        }

        function clearChatHistory() {
            var c = document.getElementById('chat-messages');
            var sessionId = getChatSessionId();
            fetch('/api/Chat', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ message: '/clear', sessionId: sessionId, clearHistory: true })
            })
            .then(function(r) { return r.json(); })
            .then(function(d) {
                c.innerHTML = '<div style="background:linear-gradient(135deg,#e0e7ff,#ede9fe);padding:12px 16px;border-radius:16px 16px 16px 4px;max-width:85%;font-size:.85rem;line-height:1.5;">' + d.reply + '</div>';
                c.scrollTop = c.scrollHeight;
            })
            .catch(function() {});
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/toastify-js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            @if (TempData["Success"] != null) {
                <text>
                Toastify({
                    text: "@Html.Raw(TempData["Success"])",
                    duration: 4000,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #00b09b, #96c93d)", borderRadius: "12px" }
                }).showToast();
                </text>
            }
            @if (TempData["Error"] != null) {
                <text>
                Toastify({
                    text: "@Html.Raw(TempData["Error"])",
                    duration: 5000,
                    gravity: "top",
                    position: "right",
                    style: { background: "linear-gradient(to right, #ff5f6d, #ffc371)", borderRadius: "12px" }
                }).showToast();
                </text>
            }
        });

        async function updateCartBadge() {
            try {
                const res = await fetch('/Cart/GetCartCount');
                if (res.ok) {
                    const data = await res.json();
                    const badge = document.getElementById('cartBadge');
                    if (badge && data.count > 0) {
                        badge.textContent = data.count;
                        badge.style.display = 'block';
                    } else if (badge) {
                        badge.style.display = 'none';
                    }
                }
            } catch(e) {}
        }
        @if (User.Identity.IsAuthenticated) {
            <text>document.addEventListener('DOMContentLoaded', updateCartBadge);</text>
        }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
