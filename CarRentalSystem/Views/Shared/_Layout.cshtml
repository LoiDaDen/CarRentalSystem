        }

        .theme-carrental .app-navbar .main-nav-btn.nav-admin-btn:hover,
        .theme-carrental .app-navbar .main-nav-btn.nav-admin-btn.active {
            border-color: rgba(251, 191, 36, 0.92);
            background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
            color: #111827;
        }

        .theme-carrental .app-navbar .nav-utility {
            flex: 0 0 auto;
            min-width: 0;
            align-items: center;
        }

        .theme-carrental .app-navbar .nav-utility .nav-link {
            min-height: 38px;
        }

        .theme-carrental .app-navbar .text-region-name,
        .theme-carrental .app-navbar .user-profile-link .text-white {
            display: block;
            max-width: 116px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .theme-carrental .app-main-shell {
            width: min(100%, 1536px);
            max-width: 1536px;
            min-width: 0;
            margin-inline: auto;
            padding-inline: clamp(1rem, 2.6vw, 2rem);
        }

        .theme-carrental .app-main-shell > main {
            min-width: 0;
            max-width: 100%;
        }

        .theme-carrental .page-shell,
        .theme-carrental .content-shell,
        .theme-carrental .split-layout,
        .theme-carrental .sidebar-panel,
        .theme-carrental .main-panel {
            min-width: 0;
            max-width: 100%;
        }
        
        @@media (min-width: 1400px) {
            .dropdown:hover > .dropdown-menu { display: block; margin-top: 0; }
            .dropdown-menu::before {
                content: "";
                position: absolute;
                top: -15px;
                left: 0;
                width: 100%;
                height: 15px;
                background: transparent;
            }
        }

        @@media (max-width: 1599.98px) and (min-width: 1400px) {
            .theme-carrental .app-navbar .main-nav-btn {
                padding-inline: 0.56rem;
                font-size: 0.82rem;
            }

            .theme-carrental .app-navbar .navbar-brand {
                font-size: 1.15rem;
            }

            .theme-carrental .app-navbar .navbar-brand .logo-main {
                height: 31px;
            }

            .theme-carrental .app-navbar .text-greeting,
            .theme-carrental .app-navbar .text-region-label {
                display: none !important;
            }
        }

        @@media (max-width: 1399.98px) {
            .theme-carrental .app-navbar {
                padding: 0.65rem 0 !important;
            }

            .theme-carrental .app-navbar .navbar-toggler {
                width: 48px;
                height: 48px;
                border-radius: 14px;
                border-color: rgba(255, 255, 255, 0.18);
                background: rgba(255, 255, 255, 0.08);
            }

            .theme-carrental .app-navbar .navbar-collapse {
                margin-top: 0.75rem;
                padding: 0.85rem;
                border: 1px solid rgba(255, 255, 255, 0.1);
                border-radius: 18px;
                background: rgba(15, 23, 42, 0.98);
                max-height: calc(100dvh - 86px);
                overflow-y: auto;
            }

            .theme-carrental .app-navbar .navbar-nav {
                width: 100%;
                align-items: stretch !important;
                gap: 0.45rem;
            }

            .theme-carrental .app-navbar .nav-item {
                width: 100%;
                margin: 0 !important;
                padding-left: 0 !important;
                padding-right: 0 !important;
                border-right: 0 !important;
            }

            .theme-carrental .app-navbar .nav-link,
            .theme-carrental .app-navbar .main-nav-btn,
            .theme-carrental .app-navbar .btn {
                width: 100%;
                min-height: 44px;
                display: flex;
                align-items: center;
                justify-content: flex-start;
                white-space: normal;
            }

            .theme-carrental .app-navbar #regionDropdown .d-none,
            .theme-carrental .app-navbar .user-profile-link .d-none {
                display: block !important;
            }

            .theme-carrental .app-navbar #cartLink {
                justify-content: flex-start;
                gap: 0.65rem;
            }

            .theme-carrental .app-navbar #cartLink::after {
                content: "Giỏ hàng";
                color: rgba(255, 255, 255, 0.9);
                font-weight: 700;
                font-size: 0.9rem;
            }

            .theme-carrental .app-navbar .dropdown-menu {
                position: static !important;
                width: 100%;
                margin-top: 0.4rem !important;
                transform: none !important;
            }

            .theme-carrental .app-navbar .nav-utility {
                margin-top: 0.45rem;
            }

            .theme-carrental .app-navbar .text-region-name,
            .theme-carrental .app-navbar .user-profile-link .text-white {
                max-width: none;
                white-space: normal;
            }
