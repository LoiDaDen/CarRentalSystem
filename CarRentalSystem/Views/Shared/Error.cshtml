@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-lg border-0" style="border-radius: 16px;">
                <div class="card-body text-center py-5">
                    <div class="mb-4">
                        <i class="bi bi-exclamation-triangle text-danger" style="font-size: 5rem;"></i>
                    </div>
                    <h1 class="text-danger mb-3">Oops! Đã xảy ra lỗi</h1>
                    <p class="text-muted mb-4">Rất tiếc, đã có lỗi không mong muốn xảy ra. Vui lòng thử lại sau.</p>
                    
                    @if (Model != null && Model.ShowRequestId)
                    {
                        <div class="alert alert-light">
                            <strong>Request ID:</strong> <code>@Model.RequestId</code>
                        </div>
                    }
                    
                    <div class="mt-4">
                        <a href="/" class="btn btn-primary btn-lg px-5">
                            <i class="bi bi-house me-2"></i>Quay về trang chủ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
