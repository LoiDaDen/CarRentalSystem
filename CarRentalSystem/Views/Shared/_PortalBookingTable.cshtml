@model IReadOnlyList<CarRentalSystem.ViewModels.PortalBookingRowViewModel>
@if (Model.Count == 0)
{
    <div class="portal-empty">Không có booking phù hợp.</div>
}
else
{
    <div class="table-responsive"><table class="table portal-table">
        <thead><tr><th>Booking</th><th>Khách hàng</th><th>Xe</th><th>Thời gian</th><th>Trạng thái</th><th>Phụ trách</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr><td class="fw-bold">#@item.BookingID</td><td>@item.CustomerName<br /><small class="text-muted">@item.MaskedPhone</small></td><td>@item.CarName<br /><small class="text-muted">@item.LicensePlate</small></td><td>@item.StartDate.ToString("dd/MM HH:mm")<br /><small class="text-muted">đến @item.EndDate.ToString("dd/MM HH:mm")</small></td><td><span class="badge text-bg-light">@item.Status</span></td><td>@(item.AssignedStaffName ?? "Chưa phân công")</td><td><a class="btn btn-sm btn-outline-primary" asp-controller="Booking" asp-action="Details" asp-route-id="@item.BookingID">Xem</a></td></tr>
        }
        </tbody>
    </table></div>
}
