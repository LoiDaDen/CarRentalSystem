@model IEnumerable<CarRentalSystem.Models.PhysicalContract>
@{
    ViewData["Title"] = "Hợp đồng vật lý";
    var types = ViewBag.Types as IEnumerable<CarRentalSystem.Models.PhysicalContractType> ?? Enumerable.Empty<CarRentalSystem.Models.PhysicalContractType>();
}

<div class="contracts-page">
    <div class="page-head">
        <div>
            <h1>Hợp đồng vật lý</h1>
            <p>Lưu ảnh/PDF hợp đồng giấy, biên bản bàn giao và hồ sơ xe.</p>
        </div>
    </div>

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <form asp-action="Upload" method="post" enctype="multipart/form-data" class="upload-contract">
        @Html.AntiForgeryToken()
        <input name="title" placeholder="Tên hợp đồng/tài liệu" />
        <input name="carId" type="number" placeholder="CarID nếu gắn với xe" />
        <input name="bookingId" type="number" placeholder="BookingID nếu gắn với đơn" />
        <textarea name="note" rows="2" placeholder="Ghi chú để AI gợi ý chính xác hơn"></textarea>
        <input name="file" type="file" accept="image/*,.pdf" required />
        <button type="submit">Upload & AI gợi ý</button>
    </form>

    <form method="get" class="filter-row">
        <select name="typeCode">
            <option value="">Tất cả loại hợp đồng</option>
            @foreach (var type in types)
            {
                <option value="@type.Code">@type.Name</option>
            }
        </select>
        <button type="submit">Lọc</button>
    </form>

    <div class="contract-list">
        @foreach (var item in Model)
        {
            var suggestedType = types.FirstOrDefault(t => t.Code == item.SuggestedContractTypeCode);
            <article class="contract-card">
                <div>
                    <h3>@(item.Title ?? $"Tài liệu #{item.PhysicalContractID}")</h3>
                    <p>@item.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @item.FileKind · @item.Status</p>
                    <a href="@item.FileUrl" target="_blank">Xem file</a>
                </div>
                <div class="ai-box">
                    <strong>AI gợi ý: @(suggestedType?.Name ?? item.SuggestedContractTypeCode ?? "Chưa có")</strong>
                    <span>@(item.AiConfidence?.ToString("0") ?? "0")%</span>
                    <p>@item.AiReason</p>
                </div>
                <form asp-action="ConfirmType" method="post" class="confirm-type">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@item.PhysicalContractID" />
                    <select name="contractTypeId">
                        @foreach (var type in types)
                        {
                            <option value="@type.PhysicalContractTypeID" selected="@(type.Code == item.SuggestedContractTypeCode)">@type.Name</option>
                        }
                    </select>
                    <button type="submit">Xác nhận</button>
                </form>
            </article>
        }
    </div>
</div>

<style>
    .contracts-page{max-width:1100px;margin:0 auto}.page-head h1{font-weight:800}.page-head p{color:#6b7280}
    .upload-contract,.filter-row{display:grid;gap:12px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:18px;margin:18px 0}
    .upload-contract input,.upload-contract textarea,.filter-row select,.confirm-type select{border:1px solid #ddd;border-radius:7px;padding:11px 12px}
    .upload-contract button,.filter-row button,.confirm-type button{border:0;background:#5bd486;color:#06351a;border-radius:7px;padding:11px 14px;font-weight:800}
    .contract-list{display:grid;gap:14px}.contract-card{display:grid;grid-template-columns:1.2fr 1fr auto;gap:18px;background:#fff;border:1px solid #e5e7eb;border-radius:8px;padding:18px;align-items:center}
    .contract-card h3{font-size:18px;font-weight:800}.contract-card p{color:#6b7280;margin:4px 0}.ai-box{background:#fff7ed;border-left:4px solid #fb923c;padding:12px;border-radius:6px}.ai-box span{float:right;color:#16a34a;font-weight:800}.confirm-type{display:grid;gap:10px}
    @@media(max-width:900px){.contract-card{grid-template-columns:1fr}}
</style>
