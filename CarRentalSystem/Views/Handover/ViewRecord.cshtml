@model CarRentalSystem.Models.HandoverRecord
@using CarRentalSystem.Models
@{
    var isCheckIn = Model.Type == "CheckIn";
    var typeText = isCheckIn ? "Biên bản giao xe" : "Biên bản trả xe";
    ViewData["Title"] = typeText;

    string StatusLabel(string status) => status switch
    {
        HandoverInventoryConditionStatusConstants.Present => "Có",
        HandoverInventoryConditionStatusConstants.Absent => "Không có",
        HandoverInventoryConditionStatusConstants.Intact => "Còn đủ",
        HandoverInventoryConditionStatusConstants.Missing => "Thiếu",
        HandoverInventoryConditionStatusConstants.Damaged => "Hư hỏng",
        _ => status
    };
}

<style>
    .img-gallery { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
    .img-gallery img { width: 100%; border-radius: 12px; border: 2px solid #e2e8f0; object-fit: cover; aspect-ratio: 16/10; }
    .info-card { background: #f8fafc; border-radius: 12px; padding: 16px; margin-bottom: 16px; }
</style>

<div class="container py-4" style="max-width: 860px; margin: 0 auto;">
    <div class="d-flex align-items-center mb-4">
        <a href="javascript:history.back()" class="text-dark me-3"><i class="bi bi-arrow-left fs-4"></i></a>
        <h4 class="fw-bold mb-0">@typeText</h4>
    </div>

    @if (Model.Booking != null)
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary text-white rounded p-3 me-3"><i class="bi bi-car-front-fill fs-4"></i></div>
                    <div>
                        <h5 class="fw-bold mb-1">Đơn thuê #@Model.Booking.BookingID - @Model.Booking.Car?.CarBrand?.Name @Model.Booking.Car?.CarName</h5>
                        <p class="text-muted mb-0 small">
                            <i class="bi bi-calendar-event me-1"></i>
                            @Model.Booking.StartDate.ToString("dd/MM/yyyy HH:mm") - @Model.Booking.EndDate.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    </div>
                </div>
                <div class="row g-3 small">
                    <div class="col-md-6"><strong>Khách thuê:</strong> @Model.Booking.User?.Name</div>
                    <div class="col-md-6"><strong>Biển số:</strong> @Model.Booking.Car?.LicensePlate</div>
                </div>
            </div>
        </div>
    }

    <div class="info-card">
        <div class="row g-3">
            <div class="col-6">
                <div class="d-flex align-items-center">
                    <i class="bi bi-speedometer2 text-primary me-2 fs-5"></i>
                    <div>
                        <small class="text-muted d-block">Số km (ODO)</small>
                        <strong>@Model.Odo.ToString("N0") km</strong>
                    </div>
                </div>
            </div>
            <div class="col-6">
                <div class="d-flex align-items-center">
                    <i class="bi bi-fuel-pump text-warning me-2 fs-5"></i>
                    <div>
                        <small class="text-muted d-block">Mức nhiên liệu</small>
                        <strong>@Model.FuelLevel</strong>
                    </div>
                </div>
            </div>
            <div class="col-12">
                <div class="d-flex align-items-center">
                    <i class="bi bi-calendar-check text-success me-2 fs-5"></i>
                    <div>
                        <small class="text-muted d-block">Thời gian ghi nhận</small>
                        <strong>@Model.RecordDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model.InventoryItems.Any())
    {
        var compensationAmount = Model.InventoryItems.Sum(i => i.MissingCharge);
        <h6 class="fw-bold mb-3"><i class="bi bi-list-check text-primary me-2"></i>Linh kiện, phụ kiện và trang bị xe</h6>
        <div class="table-responsive mb-4">
            <table class="table table-sm align-middle">
                <thead>
                    <tr>
                        <th>Trang bị</th>
                        <th class="text-center">Số lượng chuẩn</th>
                        <th class="text-center">Số lượng thực tế</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-end">Phí bồi thường</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in Model.InventoryItems.OrderBy(i => i.ItemName))
                {
                    <tr class="@(item.MissingCharge > 0 ? "table-warning" : "")">
                        <td>
                            <div class="fw-bold">@item.ItemName</div>
                            @if (!string.IsNullOrWhiteSpace(item.Notes))
                            {
                                <div class="small text-muted">@item.Notes</div>
                            }
                        </td>
                        <td class="text-center">@item.ExpectedQuantity</td>
                        <td class="text-center">@item.ActualQuantity</td>
                        <td class="text-center">@StatusLabel(item.ConditionStatus)</td>
                        <td class="text-end">@item.MissingCharge.ToString("N0")đ</td>
                    </tr>
                }
                </tbody>
                <tfoot>
                    <tr>
                        <th colspan="4" class="text-end">Tổng phí bồi thường phụ kiện</th>
                        <th class="text-end text-danger">@compensationAmount.ToString("N0")đ</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.FrontImgUrl) || !string.IsNullOrEmpty(Model.BackImgUrl) || !string.IsNullOrEmpty(Model.LeftImgUrl) || !string.IsNullOrEmpty(Model.RightImgUrl) || !string.IsNullOrEmpty(Model.InsideImgUrl))
    {
        <h6 class="fw-bold mb-3"><i class="bi bi-camera-fill text-secondary me-2"></i>Hình ảnh hiện trạng xe</h6>
        <div class="img-gallery mb-4">
            @if (!string.IsNullOrEmpty(Model.FrontImgUrl))
            {
                <div>
                    <label class="d-block small text-muted fw-bold mb-1">Mặt trước</label>
                    <img src="@Model.FrontImgUrl" alt="Mặt trước" />
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.BackImgUrl))
            {
                <div>
                    <label class="d-block small text-muted fw-bold mb-1">Mặt sau</label>
                    <img src="@Model.BackImgUrl" alt="Mặt sau" />
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.LeftImgUrl))
            {
                <div>
                    <label class="d-block small text-muted fw-bold mb-1">Hông trái</label>
                    <img src="@Model.LeftImgUrl" alt="Hông trái" />
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.RightImgUrl))
            {
                <div>
                    <label class="d-block small text-muted fw-bold mb-1">Hông phải</label>
                    <img src="@Model.RightImgUrl" alt="Hông phải" />
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.InsideImgUrl))
            {
                <div>
                    <label class="d-block small text-muted fw-bold mb-1">Nội thất xe</label>
                    <img src="@Model.InsideImgUrl" alt="Nội thất" />
                </div>
            }
        </div>
    }

    @if (!string.IsNullOrEmpty(Model.SignatureUrl))
    {
        <h6 class="fw-bold mb-3"><i class="bi bi-pen-fill text-primary me-2"></i>Chữ ký xác nhận</h6>
        <div class="card border-0 bg-light rounded-4 p-3 text-center mb-4">
            <img src="@Model.SignatureUrl" alt="Chữ ký xác nhận" style="max-height: 120px;" />
        </div>
    }

    <a href="javascript:history.back()" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-2"></i>Quay lại
    </a>
</div>
