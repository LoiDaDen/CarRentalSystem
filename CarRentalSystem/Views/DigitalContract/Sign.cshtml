@model CarRentalSystem.Models.DigitalContract
@{
    ViewData["Title"] = "Ký hợp đồng số";
}

<div class="container py-4 py-lg-5" style="max-width: 960px;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="text-muted small text-uppercase fw-bold">Ký hợp đồng số</div>
            <h1 class="h3 fw-bold mb-0">@Model.ContractNo</h1>
        </div>
        <a asp-action="Details" asp-route-id="@Model.DigitalContractID" class="btn btn-outline-secondary rounded-3">
            <i class="bi bi-eye me-1"></i>Xem hợp đồng
        </a>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
    }

    @await Html.PartialAsync("_ContractDocument", Model)

    <form asp-action="Sign" asp-route-id="@Model.DigitalContractID" method="post" class="mt-4">
        @Html.AntiForgeryToken()
        <div class="card border-0 shadow-sm rounded-3">
            <div class="card-body p-4">
                <label class="form-label fw-bold">
                    <i class="bi bi-pen me-2 text-primary"></i>Chữ ký khách hàng
                </label>
                <p class="small text-muted mb-3">Vui lòng ký trong khung bên dưới để xác nhận đã đọc và đồng ý nội dung hợp đồng.</p>

                <div class="signature-pad border rounded-3 bg-white overflow-hidden">
                    <canvas id="signatureCanvas"></canvas>
                </div>
                <input type="hidden" name="signatureBase64" id="signatureBase64" />

                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mt-3">
                    <span class="small text-danger d-none" id="signatureWarning">Bạn chưa ký tên.</span>
                    <button type="button" class="btn btn-outline-secondary rounded-3 ms-auto" id="clearSignature">
                        <i class="bi bi-eraser me-1"></i>Xóa ký lại
                    </button>
                    <button type="submit" class="btn btn-primary rounded-3 fw-bold px-4">
                        <i class="bi bi-check2-circle me-1"></i>Xác nhận ký
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<style>
    .signature-pad {
        height: 220px;
        touch-action: none;
    }

    #signatureCanvas {
        width: 100%;
        height: 100%;
        display: block;
        cursor: crosshair;
    }
</style>

@section Scripts {
    <script>
        (function () {
            const canvas = document.getElementById('signatureCanvas');
            const hidden = document.getElementById('signatureBase64');
            const warning = document.getElementById('signatureWarning');
            const clearButton = document.getElementById('clearSignature');
            const form = document.querySelector('form');
            if (!canvas || !hidden || !warning || !clearButton || !form) return;

            const ctx = canvas.getContext('2d');
            let isDrawing = false;
            let hasDrawn = false;

            function resizeCanvas() {
                const rect = canvas.getBoundingClientRect();
                const ratio = window.devicePixelRatio || 1;
                canvas.width = Math.max(1, Math.floor(rect.width * ratio));
                canvas.height = Math.max(1, Math.floor(rect.height * ratio));
                ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
                ctx.lineWidth = 3;
                ctx.lineJoin = 'round';
                ctx.lineCap = 'round';
                ctx.strokeStyle = '#111827';
            }

            function getPoint(event) {
                const rect = canvas.getBoundingClientRect();
                const source = event.touches ? event.touches[0] : event;
                return {
                    x: source.clientX - rect.left,
                    y: source.clientY - rect.top
                };
            }

            function start(event) {
                event.preventDefault();
                isDrawing = true;
                hasDrawn = true;
                warning.classList.add('d-none');
                const point = getPoint(event);
                ctx.beginPath();
                ctx.moveTo(point.x, point.y);
            }

            function move(event) {
                if (!isDrawing) return;
                event.preventDefault();
                const point = getPoint(event);
                ctx.lineTo(point.x, point.y);
                ctx.stroke();
                hidden.value = canvas.toDataURL('image/png');
            }

            function end() {
                if (isDrawing) {
                    hidden.value = canvas.toDataURL('image/png');
                }
                isDrawing = false;
            }

            clearButton.addEventListener('click', function () {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                hidden.value = '';
                hasDrawn = false;
            });

            form.addEventListener('submit', function (event) {
                if (!hasDrawn || !hidden.value) {
                    event.preventDefault();
                    warning.classList.remove('d-none');
                }
            });

            canvas.addEventListener('mousedown', start);
            canvas.addEventListener('mousemove', move);
            window.addEventListener('mouseup', end);
            canvas.addEventListener('touchstart', start, { passive: false });
            canvas.addEventListener('touchmove', move, { passive: false });
            window.addEventListener('touchend', end);
            window.addEventListener('resize', resizeCanvas);
            resizeCanvas();
        })();
    </script>
}
