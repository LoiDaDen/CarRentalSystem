@model CarRentalSystem.Models.RentalContract
@{
    ViewData["Title"] = "Create Contract";
    Layout = "_AdminLayout";
    var booking = ViewBag.Booking as CarRentalSystem.Models.Booking;
}

<h2 class="mb-4">Hoàn tất hợp đồng thuê xe</h2>

<div class="row">
    <div class="col-md-5">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light fw-bold">Tóm tắt đơn thuê #@booking.BookingID</div>
            <div class="card-body">
                <p><strong>Khách hàng:</strong> @booking.User.Name (@booking.User.Email)</p>
                <p><strong>Xe:</strong> @booking.Car.CarBrand?.Name @booking.Car.CarName</p>
                <p><strong>Thời gian:</strong> @booking.StartDate.ToString("dd/MM/yyyy") to @booking.EndDate.ToString("dd/MM/yyyy")</p>
                <p><strong>Giá gốc:</strong> @booking.TotalPrice.ToString("N0") VND</p>
            </div>
        </div>
    </div>

    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="BookingID" />
                    
                    <h5 class="border-bottom pb-2 mb-3">Chỉ số ODO</h5>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">KM bắt đầu</label>
                            <input type="number" step="0.1" asp-for="StartKm" class="form-control" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">KM kết thúc</label>
                            <input type="number" step="0.1" asp-for="EndKm" class="form-control" required />
                        </div>
                    </div>

                    <div class="alert alert-info mt-3">
                        <i class="bi bi-info-circle"></i> Hệ thống sẽ tự động ghi nhận tổng số km đã đi dựa trên chỉ số odometer.
                    </div>

                    <button type="submit" class="btn btn-success w-100 btn-lg mt-3">Tạo hợp đồng và hoàn tất</button>
                </form>
            </div>
        </div>
    </div>
</div>
