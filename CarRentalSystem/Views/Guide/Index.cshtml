@model GuideViewModel
@using System.Text.Json
@{
    Layout = null;
    var tutorialJson = Model.Tutorial == null ? "null" : JsonSerializer.Serialize(Model.Tutorial, new JsonSerializerOptions(JsonSerializerDefaults.Web));
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hướng dẫn @Model.RoleName | CarRentalSystem</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/guide.css" asp-append-version="true" />
</head>
<body style="--guide-accent:@Model.RoleColor">
    <header class="guide-topbar">
        <a class="guide-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-car-front-fill"></i> CarRentalSystem Guide</a>
        <span class="guide-role"><i class="bi @Model.RoleIcon"></i> @Model.RoleName</span>
        <nav>
            @if (!Model.IsInternal)
            {
                <a class="@(Model.Role == "customer" ? "active" : "")" href="/Guide?role=customer">Khách hàng</a>
                <a class="@(Model.Role == "driver" ? "active" : "")" href="/Guide?role=driver">Tài xế</a>
            }
            <a asp-controller="Home" asp-action="Index"><i class="bi bi-house"></i> Trang chủ</a>
        </nav>
    </header>

    <main class="guide-shell">
        <section class="guide-hero">
            <span class="guide-hero-icon"><i class="bi @Model.RoleIcon"></i></span>
            <div>
                <span class="guide-kicker">Hướng dẫn theo quyền truy cập</span>
                <h1>Hướng dẫn @Model.RoleName</h1>
                <p>@(Model.IsInternal ? Model.Tutorial?.Description : "Tài liệu từng bước giúp bạn sử dụng hệ thống thuê xe an toàn và hiệu quả.")</p>
            </div>
        </section>

        @if (Model.IsInternal && Model.Tutorial != null)
        {
            <section class="guide-section">
                <div class="guide-section-heading">
                    <div><span class="guide-kicker">Tutorial chính</span><h2>Các chức năng cần biết</h2></div>
                    <span class="guide-version">@Model.Tutorial.TutorialKey</span>
                </div>
                <div class="guide-step-grid">
                    @for (var index = 0; index < Model.Tutorial.Steps.Count; index++)
                    {
                        var step = Model.Tutorial.Steps[index];
                        <article class="guide-step-card">
                            <span class="guide-step-number">@(index + 1)</span>
                            <i class="bi @step.Icon"></i>
                            <h3>@step.Title</h3>
                            <p>@step.Description</p>
                            @if (!string.IsNullOrWhiteSpace(step.Route))
                            {
                                <a href="@step.Route">Mở chức năng <i class="bi bi-arrow-right"></i></a>
                            }
                        </article>
                    }
                </div>
            </section>

            <section class="guide-section">
                <div class="guide-section-heading"><div><span class="guide-kicker">Phụ lục hướng dẫn</span><h2>Hướng dẫn theo từng module</h2></div></div>
                <div class="guide-module-list">
                    @foreach (var guide in Model.QuickGuides.Where(item => item.Controller != "*"))
                    {
                        <details>
                            <summary><span><i class="bi bi-journal-check"></i> @guide.Title</span><i class="bi bi-chevron-down"></i></summary>
                            <div class="guide-module-body">
                                <p>@guide.Description</p>
                                <h3>Thao tác chính</h3>
                                <ul>@foreach (var item in guide.MainActions) { <li>@item</li> }</ul>
                                <h3>Lưu ý</h3>
                                <ul>@foreach (var item in guide.Notes) { <li>@item</li> }</ul>
                            </div>
                        </details>
                    }
                </div>
            </section>
        }
        else
        {
            <section class="guide-section guide-document" id="guideDocument"></section>
            <textarea id="guideMarkdown" hidden>@Model.MarkdownContent</textarea>
        }
    </main>

    @if (!Model.IsInternal)
    {
        <script>
            const source = document.getElementById("guideMarkdown").value;
            const escapeHtml = (value) => value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            const inline = (value) => value.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>").replace(/`(.+?)`/g, "<code>$1</code>");
            let html = "";
            let list = "";
            const closeList = () => { if (list) { html += `</${list}>`; list = ""; } };
            escapeHtml(source).split(/\r?\n/).forEach((raw) => {
                const line = raw.trim();
                if (!line) { closeList(); return; }
                if (line.startsWith("# ")) { closeList(); html += `<h1>${inline(line.slice(2))}</h1>`; return; }
                if (line.startsWith("## ")) { closeList(); html += `<h2>${inline(line.slice(3))}</h2>`; return; }
                if (line.startsWith("### ")) { closeList(); html += `<h3>${inline(line.slice(4))}</h3>`; return; }
                if (line.startsWith("> ")) { closeList(); html += `<blockquote>${inline(line.slice(2))}</blockquote>`; return; }
                if (/^[-*] /.test(line)) { if (list !== "ul") { closeList(); list = "ul"; html += "<ul>"; } html += `<li>${inline(line.slice(2))}</li>`; return; }
                if (/^\d+\. /.test(line)) { if (list !== "ol") { closeList(); list = "ol"; html += "<ol>"; } html += `<li>${inline(line.replace(/^\d+\. /, ""))}</li>`; return; }
                closeList(); html += `<p>${inline(line)}</p>`;
            });
            closeList();
            document.getElementById("guideDocument").innerHTML = html;
        </script>
    }
</body>
</html>
