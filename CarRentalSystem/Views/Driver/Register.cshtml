@{ 
    ViewData["Title"] = "Đăng Ký Tài Xế"; 
    var currentUser = ViewBag.CurrentUser as CarRentalSystem.Models.User;
}

<style>
    .driver-register-shell {
        max-width: 760px;
    }

    .driver-avatar-panel {
        border: 1px dashed rgba(16, 185, 129, 0.55);
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.08), rgba(59, 130, 246, 0.06));
        border-radius: 18px;
        padding: 18px;
    }

    .driver-avatar-preview {
        width: 108px;
        height: 108px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #fff;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.16);
        background: #ecfdf5;
    }

    .driver-avatar-placeholder {
        width: 108px;
        height: 108px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #ecfdf5;
        color: #059669;
        border: 4px solid #fff;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.16);
        font-size: 2.5rem;
    }

    @@media (max-width: 575.98px) {
        .driver-register-shell {
            padding-top: 16px !important;
            padding-left: 12px;
            padding-right: 12px;
        }

        .driver-register-shell .card {
            border-radius: 16px !important;
            padding: 16px !important;
        }

        .driver-register-shell h2 {
            font-size: 1.45rem;
            line-height: 1.25;
        }

        .driver-register-shell .text-muted {
            line-height: 1.55;
        }

        .driver-register-shell .form-control,
        .driver-register-shell .form-select {
            min-height: 48px;
            font-size: 16px;
        }

        .driver-avatar-panel {
            padding: 16px;
            text-align: center;
        }

        .driver-avatar-preview,
        .driver-avatar-placeholder {
            width: 96px;
            height: 96px;
        }

        .driver-avatar-panel .btn {
            width: 100%;
        }

        .driver-register-shell button[type="submit"] {
            min-height: 52px;
            white-space: normal;
        }
    }
</style>

<div class="container py-4 driver-register-shell">
    <div class="text-center mb-4">
        <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:80px;height:80px;">
            <i class="bi bi-person-badge-fill text-success fs-1"></i>
        </div>
        <h2 class="fw-800">Đăng Ký Làm Tài Xế</h2>
        <p class="text-muted">Gia nhập đội ngũ tài xế chuyên nghiệp của CarRental. Thu nhập hấp dẫn, linh hoạt thời gian.</p>
    </div>

    <div class="card shadow-sm border-0 rounded-4 p-4">
        <form asp-action="Register" method="post" enctype="multipart/form-data" id="driverRegisterForm">
            @Html.AntiForgeryToken()
            <div class="driver-avatar-panel mb-4">
                <div class="d-flex align-items-center gap-3 flex-column flex-sm-row">
                    <div>
                        <div id="driverAvatarPlaceholder" class="driver-avatar-placeholder">
                            <i class="bi bi-person-bounding-box"></i>
                        </div>
                        <img id="driverAvatarPreview" class="driver-avatar-preview d-none" alt="Ảnh đại diện tài xế" />
                    </div>
                    <div class="flex-grow-1">
                        <label class="form-label fw-bold mb-1">Ảnh đại diện tài xế <span class="text-danger">*</span></label>
                        <p class="text-muted small mb-3">Ảnh chân dung rõ mặt giúp khách hàng nhận diện tài xế khi nhận chuyến.</p>
                        <input type="file" name="avatarFile" id="avatarFile" class="d-none" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required>
                        <label for="avatarFile" class="btn btn-outline-success rounded-pill px-4 fw-bold mb-2">
                            <i class="bi bi-camera me-2"></i>Chọn ảnh
                        </label>
                        <div class="small text-muted">JPG, PNG, WEBP, tối đa 5MB.</div>
                    </div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Họ và tên <span class="text-danger">*</span></label>
                    <input type="text" name="FullName" class="form-control" placeholder="Nguyễn Văn A" value="@(currentUser?.Name ?? "")" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Số điện thoại <span class="text-danger">*</span></label>
                    <input type="text" name="Phone" class="form-control" placeholder="0901234567" value="@(currentUser?.Phone ?? "")" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Loại bằng lái <span class="text-danger">*</span></label>
                    <select name="LicenseType" class="form-select" required>
                        <option value="B1">B1 - Xe dưới 9 chỗ</option>
                        <option value="B2" selected>B2 - Xe dưới 9 chỗ (lái xe thuê)</option>
                        <option value="C">C - Xe tải</option>
                        <option value="D">D - Xe khách</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Số bằng lái</label>
                    <input type="text" name="LicenseNumber" class="form-control" placeholder="Số trên bằng lái xe">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Kinh nghiệm (năm) <span class="text-danger">*</span></label>
                    <input type="number" name="ExperienceYears" class="form-control" value="1" min="0" max="50" required>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Khu vực hoạt động</label>
                    <select name="LocationID" class="form-select">
                        <option value="">Toàn quốc</option>
                        @if (ViewBag.Locations != null)
                        {
                            foreach (var loc in ViewBag.Locations)
                            {
                                <option value="@loc.LocationID">@loc.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Giá theo giờ (VNĐ)</label>
                    <input type="number" name="HourlyRate" class="form-control" value="80000" min="50000">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold small">Giá theo ngày (VNĐ)</label>
                    <input type="number" name="DailyRate" class="form-control" value="500000" min="200000">
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold small">Giới thiệu bản thân</label>
                    <textarea name="Description" class="form-control" rows="3" placeholder="Tôi có nhiều năm kinh nghiệm lái xe đường dài, an toàn, thân thiện..."></textarea>
                </div>
            </div>

            <div class="alert alert-success mt-4 small d-flex align-items-start">
                <i class="bi bi-info-circle-fill me-2 mt-1"></i>
                <div>
                    <strong>Lưu ý:</strong> Sau khi đăng ký, hồ sơ của bạn sẽ được Admin xét duyệt trong vòng 24h. 
                    Bạn sẽ nhận thông báo qua email khi hồ sơ được duyệt.
                </div>
            </div>

            <button type="submit" class="btn btn-success btn-lg w-100 fw-bold rounded-pill mt-3">
                <i class="bi bi-send me-2"></i>Gửi Đăng Ký
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('avatarFile')?.addEventListener('change', function () {
            const file = this.files && this.files[0];
            const preview = document.getElementById('driverAvatarPreview');
            const placeholder = document.getElementById('driverAvatarPlaceholder');
            if (!file || !preview || !placeholder) return;

            preview.src = URL.createObjectURL(file);
            preview.classList.remove('d-none');
            placeholder.classList.add('d-none');
        });
    </script>
}
