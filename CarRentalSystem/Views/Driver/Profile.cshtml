@model CarRentalSystem.Models.Driver
@{ ViewData["Title"] = Model.FullName + " - Tài Xế"; }

<div class="container py-4" style="max-width: 800px;">
    <a asp-action="Index" class="text-decoration-none text-muted small mb-3 d-inline-block"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
    
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="text-center p-5" style="background: linear-gradient(135deg, #10b981, #059669);">
            @if (!string.IsNullOrEmpty(Model.AvatarUrl))
            {
                <img src="@Model.AvatarUrl" alt="@Model.FullName" class="rounded-circle border border-4 border-white shadow mb-3" style="width:120px;height:120px;object-fit:cover;">
            }
            else
            {
                <div class="rounded-circle bg-white bg-opacity-25 d-inline-flex align-items-center justify-content-center mb-3" style="width:120px;height:120px;">
                    <i class="bi bi-person-fill text-white" style="font-size: 3rem;"></i>
                </div>
            }
            <h2 class="fw-800 text-white mb-1">@Model.FullName</h2>
            <div class="text-white-50"><i class="bi bi-geo-alt me-1"></i>@(Model.Location?.Name ?? "Toàn quốc")</div>
            
            <div class="d-flex justify-content-center gap-2 mt-3">
                @for (int i = 1; i <= 5; i++)
                {
                    <i class="bi @(i <= Math.Round((double)Model.Rating) ? "bi-star-fill" : "bi-star") text-warning fs-5"></i>
                }
                <span class="text-white fw-bold ms-2 fs-5">@Model.Rating.ToString("0.0")</span>
            </div>
        </div>

        <div class="card-body p-4">
            <div class="row g-3 mb-4">
                <div class="col-4 text-center">
                    <div class="p-3 bg-success bg-opacity-10 rounded-3">
                        <div class="fw-800 fs-4 text-success">@Model.ExperienceYears</div>
                        <div class="text-muted small fw-bold">Năm kinh nghiệm</div>
                    </div>
                </div>
                <div class="col-4 text-center">
                    <div class="p-3 bg-primary bg-opacity-10 rounded-3">
                        <div class="fw-800 fs-4 text-primary">@Model.TotalTrips</div>
                        <div class="text-muted small fw-bold">Chuyến đi</div>
                    </div>
                </div>
                <div class="col-4 text-center">
                    <div class="p-3 bg-warning bg-opacity-10 rounded-3">
                        <div class="fw-800 fs-4 text-warning">@Model.LicenseType</div>
                        <div class="text-muted small fw-bold">Bằng lái</div>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mb-4">
                    <h6 class="fw-bold"><i class="bi bi-chat-quote me-2"></i>Giới thiệu</h6>
                    <p class="text-muted">@Model.Description</p>
                </div>
            }

            <div class="border-top pt-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-tags me-2"></i>Bảng giá</h6>
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 border rounded-3 text-center">
                            <div class="text-muted small">Theo giờ</div>
                            <div class="fw-800 fs-4 text-success">@Model.HourlyRate.ToString("N0")<span class="fs-6 text-muted fw-normal">đ</span></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 border rounded-3 text-center">
                            <div class="text-muted small">Theo ngày</div>
                            <div class="fw-800 fs-4 text-primary">@Model.DailyRate.ToString("N0")<span class="fs-6 text-muted fw-normal">đ</span></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
