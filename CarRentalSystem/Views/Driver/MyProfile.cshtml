@model CarRentalSystem.Models.Driver
@{ ViewData["Title"] = "Hồ Sơ Tài Xế"; }

<style>
    .driver-profile-avatar {
        width: 112px;
        height: 112px;
        border-radius: 50%;
        object-fit: cover;
        border: 4px solid #fff;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.16);
        background: #ecfdf5;
    }

    .driver-profile-avatar-placeholder {
        width: 112px;
        height: 112px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #059669;
        background: #ecfdf5;
        border: 4px solid #fff;
        box-shadow: 0 12px 30px rgba(15, 23, 42, 0.16);
        font-size: 2.5rem;
    }

    .driver-profile-stat,
    .driver-contract-summary-card {
        height: 100%;
    }

    .driver-contract-actions {
        flex-wrap: wrap;
    }

    @@media (max-width: 575.98px) {
        .driver-profile-shell {
            padding-top: 16px !important;
            padding-left: 12px;
            padding-right: 12px;
        }

        .driver-profile-shell > h3 {
            font-size: 1.25rem;
            line-height: 1.35;
        }

        .driver-profile-shell .card {
            border-radius: 16px !important;
        }

        .driver-profile-shell .card-body {
            padding: 16px !important;
        }

        .driver-avatar-update {
            text-align: center;
        }

        .driver-profile-avatar,
        .driver-profile-avatar-placeholder {
            width: 96px;
            height: 96px;
        }

        .driver-avatar-update .btn,
        .driver-avatar-update button {
            width: 100%;
        }

        .driver-profile-stats > [class*="col-"],
        .driver-contract-summary > [class*="col-"] {
            flex: 0 0 100%;
            max-width: 100%;
            width: 100%;
        }

        .driver-contract-card-header,
        .driver-contract-actions,
        .driver-contract-modal-actions {
            flex-direction: column;
            align-items: stretch !important;
        }

        .driver-contract-card-header .badge,
        .driver-contract-actions .btn,
        .driver-contract-actions button,
        .driver-contract-modal-actions .btn,
        .driver-contract-modal-actions form {
            width: 100%;
        }
    }
</style>

<div class="container py-4 driver-profile-shell" style="max-width: 700px;">
    <h3 class="fw-800 mb-4"><i class="bi bi-person-badge text-success me-2"></i>Hồ Sơ Tài Xế Của Tôi</h3>
    
    <div class="card shadow-sm border-0 rounded-4 mb-4">
        <div class="card-body p-4">
            <div class="driver-avatar-update d-flex align-items-center gap-3 flex-column flex-sm-row">
                <div>
                    @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" alt="@Model.FullName" class="driver-profile-avatar" id="myDriverAvatarPreview">
                    }
                    else
                    {
                        <div class="driver-profile-avatar-placeholder" id="myDriverAvatarPlaceholder">
                            <i class="bi bi-person-bounding-box"></i>
                        </div>
                        <img alt="@Model.FullName" class="driver-profile-avatar d-none" id="myDriverAvatarPreview">
                    }
                </div>
                <div class="flex-grow-1">
                    <div class="fw-bold mb-1">Ảnh đại diện tài xế</div>
                    <div class="text-muted small mb-3">Ảnh này sẽ hiển thị cho khách hàng khi họ xem hoặc chọn tài xế.</div>
                    <form asp-action="UpdateAvatar" method="post" enctype="multipart/form-data" class="d-flex flex-column flex-sm-row gap-2">
                        @Html.AntiForgeryToken()
                        <input type="file" name="avatarFile" id="myDriverAvatarFile" class="d-none" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" required>
                        <label for="myDriverAvatarFile" class="btn btn-outline-success rounded-pill px-4 fw-bold mb-0">
                            <i class="bi bi-camera me-2"></i>Chọn ảnh
                        </label>
                        <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold">
                            <i class="bi bi-upload me-2"></i>Cập nhật
                        </button>
                    </form>
                    <div class="small text-muted mt-2">JPG, PNG, WEBP, tối đa 5MB.</div>
                </div>
            </div>
        </div>
    </div>

    @if (!Model.IsApproved)
    {
        <div class="alert alert-warning d-flex align-items-center py-3" style="border-radius: 12px;">
            <i class="bi bi-hourglass-split me-3 fs-3"></i>
            <div>
                <strong>Đang chờ duyệt</strong><br>
                <small>Hồ sơ của bạn đang được Admin xem xét. Bạn sẽ nhận thông báo khi được duyệt.</small>
            </div>
        </div>
    }
    else
    {
        var driverContracts2 = ViewBag.DriverContracts as List<CarRentalSystem.Models.DriverContract> ?? new List<CarRentalSystem.Models.DriverContract>();
        var activeContract = driverContracts2.FirstOrDefault(c => c.Status == "Active");
        var pendingContract = driverContracts2.FirstOrDefault(c => c.Status == "Pending");
        
        if (activeContract != null)
        {
            <div class="alert alert-success d-flex align-items-center py-3" style="border-radius: 12px;">
                <i class="bi bi-check-circle-fill me-3 fs-3"></i>
                <div>
                    <strong>Đã được duyệt & Hợp đồng có hiệu lực</strong> - Bạn đã có thể nhận chuyến!
                    <small class="d-block text-muted">HĐ: @activeContract.ContractNo · Ký ngày: @activeContract.PartyBSignDate?.ToString("dd/MM/yyyy")</small>
                </div>
            </div>
        }
        else if (pendingContract != null)
        {
            var daysLeft = (pendingContract.ExpiresAt - DateTime.Now).TotalDays;
            <div class="alert alert-info d-flex align-items-center py-3" style="border-radius: 12px;">
                <i class="bi bi-file-earmark-text me-3 fs-3"></i>
                <div>
                    <strong>Đã được duyệt - Hợp đồng chờ ký!</strong>
                    @if (daysLeft > 0)
                    {
                        <small class="d-block">Bạn còn <strong>@Math.Ceiling(daysLeft) ngày</strong> <text>để ký xác nhận hợp đồng. Xem bên dưới ↓</text></small>
                    }
                    else
                    {
                        <small class="d-block text-danger">Hợp đồng đã quá hạn ký. Vui lòng liên hệ Admin.</small>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-success d-flex align-items-center py-3" style="border-radius: 12px;">
                <i class="bi bi-check-circle-fill me-3 fs-3"></i>
                <div>
                    <strong>Đã được duyệt</strong> - Bạn đã có thể nhận chuyến!
                </div>
            </div>
        }
    }

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-4">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Họ tên</label>
                    <div class="fw-bold">@Model.FullName</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Số điện thoại</label>
                    <div class="fw-bold">@(Model.Phone ?? "Chưa cập nhật")</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Loại bằng lái</label>
                    <div class="fw-bold">@Model.LicenseType</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Kinh nghiệm</label>
                    <div class="fw-bold">@Model.ExperienceYears năm</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Khu vực</label>
                    <div class="fw-bold">@(Model.Location?.Name ?? "Toàn quốc")</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label small fw-bold text-muted">Đánh giá</label>
                    <div>
                        @for (int i = 1; i <= 5; i++)
                        {
                            <i class="bi @(i <= Math.Round((double)Model.Rating) ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                        }
                        <span class="fw-bold ms-1">@Model.Rating.ToString("0.0")</span>
                    </div>
                </div>
            </div>

            <div class="border-top mt-4 pt-4">
                <div class="row g-3 text-center driver-profile-stats">
                    <div class="col-4">
                        <div class="p-3 bg-success bg-opacity-10 rounded-3 driver-profile-stat">
                            <div class="fw-800 fs-4 text-success">@Model.TotalTrips</div>
                            <div class="text-muted small">Tổng chuyến</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-primary bg-opacity-10 rounded-3 driver-profile-stat">
                            <div class="fw-800 fs-5 text-primary">@Model.HourlyRate.ToString("N0")đ</div>
                            <div class="text-muted small">Giá/giờ</div>
                        </div>
                    </div>
                    <div class="col-4">
                        <div class="p-3 bg-warning bg-opacity-10 rounded-3 driver-profile-stat">
                            <div class="fw-800 fs-5 text-warning">@Model.DailyRate.ToString("N0")đ</div>
                            <div class="text-muted small">Giá/ngày</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @{
        var contracts = ViewBag.DriverContracts as List<CarRentalSystem.Models.DriverContract> ?? new List<CarRentalSystem.Models.DriverContract>();
    }

    @if (contracts.Any())
    {
        <div class="mt-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-file-earmark-text text-primary me-2"></i>Hợp đồng của tôi</h5>

            @foreach (var contract in contracts)
            {
                var daysLeft = (contract.ExpiresAt - DateTime.Now).TotalDays;
                var isPending = contract.Status == "Pending";
                var isActive = contract.Status == "Active";

                <div class="card border-0 shadow-sm rounded-4 mb-3 @(isPending ? "border-start border-warning border-4" : isActive ? "border-start border-success border-4" : "")">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-3 driver-contract-card-header">
                            <div>
                                <h6 class="fw-bold mb-1">HĐ Đối tác Tài xế</h6>
                                <p class="text-muted small mb-0">Số: <strong>@contract.ContractNo</strong> · Ngày tạo: @contract.CreatedAt.ToString("dd/MM/yyyy")</p>
                            </div>
                            <div>
                                @if (isPending)
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2">
                                        <i class="bi bi-hourglass-split me-1"></i>Chờ ký
                                    </span>
                                }
                                else if (isActive)
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-2">
                                        <i class="bi bi-check-circle me-1"></i>Đã ký
                                    </span>
                                }
                                else if (contract.Status == "Expired")
                                {
                                    <span class="badge bg-secondary rounded-pill px-3 py-2">
                                        <i class="bi bi-clock-history me-1"></i>Hết hạn
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-2">
                                        <i class="bi bi-x-circle me-1"></i>Đã hủy
                                    </span>
                                }
                            </div>
                        </div>

                        <!-- Contract summary -->
                        <div class="row g-2 mb-3 driver-contract-summary">
                            <div class="col-4">
                                <div class="bg-light rounded-3 p-2 text-center driver-contract-summary-card">
                                    <div class="small text-muted">Lương cố định</div>
                                    <div class="fw-bold text-success">@contract.BaseSalary.ToString("N0")đ/ngày</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-light rounded-3 p-2 text-center driver-contract-summary-card">
                                    <div class="small text-muted">Phí chuyến</div>
                                    <div class="fw-bold text-primary">@contract.TripFee.ToString("N0")đ/giờ</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-light rounded-3 p-2 text-center driver-contract-summary-card">
                                    <div class="small text-muted">Thanh toán</div>
                                    <div class="fw-bold">Ngày @contract.PaymentDay</div>
                                </div>
                            </div>
                        </div>

                        @if (isPending)
                        {
                            <div class="alert @(daysLeft > 0 ? "alert-warning" : "alert-danger") mb-3 small">
                                @if (daysLeft > 0)
                                {
                                    <i class="bi bi-clock-fill me-1"></i>
                                    <strong>Còn @Math.Ceiling(daysLeft) ngày</strong> <text>để ký xác nhận.</text>
                                    <span class="d-block mt-1">Hạn ký: @contract.ExpiresAt.ToString("dd/MM/yyyy HH:mm")</span>
                                }
                                else
                                {
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    <strong>Đã quá hạn ký!</strong> <text>Liên hệ Admin để được hỗ trợ.</text>
                                }
                            </div>

                            <div class="d-flex gap-2 driver-contract-actions">
                                <a asp-action="MyContract" asp-route-id="@contract.DriverContractID" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    <i class="bi bi-eye me-1"></i>Xem chi tiết
                                </a>
                                @if (daysLeft > 0)
                                {
                                    <button type="button" class="btn btn-success btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#signDriverModal-@contract.DriverContractID">
                                        <i class="bi bi-pen me-1"></i>Ký xác nhận
                                    </button>
                                }
                            </div>

                            @if (daysLeft > 0)
                            {
                                <!-- Sign Modal -->
                                <div class="modal fade" id="signDriverModal-@contract.DriverContractID" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content rounded-4 border-0 shadow">
                                            <div class="modal-header bg-success text-white border-0 rounded-top-4">
                                                <h5 class="modal-title"><i class="bi bi-pen me-2"></i>Ký xác nhận Hợp đồng Tài xế</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body p-4">
                                                <div class="text-center mb-3">
                                                    <i class="bi bi-shield-check display-3 text-success"></i>
                                                </div>
                                                <p class="text-center">
                                                    Bạn xác nhận đã đọc và đồng ý với toàn bộ điều khoản của hợp đồng
                                                    <strong>#@contract.ContractNo</strong>?
                                                </p>
                                                <div class="alert alert-info small">
                                                    <i class="bi bi-info-circle me-1"></i>
                                                    Sau khi ký, hợp đồng sẽ có hiệu lực <strong>vĩnh viễn</strong> cho đến khi bạn quyết định chấm dứt.
                                                </div>
                                            </div>
                                            <div class="modal-footer border-0 driver-contract-modal-actions">
                                                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Hủy</button>
                                                <form asp-controller="Driver" asp-action="SignContract" asp-route-id="@contract.DriverContractID" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-success rounded-pill px-4">
                                                        <i class="bi bi-check-lg me-1"></i>Xác nhận ký
                                                    </button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else if (isActive)
                        {
                            <div class="d-flex gap-2 driver-contract-actions">
                                <a asp-action="MyContract" asp-route-id="@contract.DriverContractID" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                    <i class="bi bi-eye me-1"></i>Xem chi tiết
                                </a>
                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#cancelDriverModal-@contract.DriverContractID">
                                    <i class="bi bi-x-lg me-1"></i>Chấm dứt HĐ
                                </button>
                            </div>

                            <!-- Cancel Modal -->
                            <div class="modal fade" id="cancelDriverModal-@contract.DriverContractID" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content rounded-4 border-0 shadow">
                                        <div class="modal-header bg-danger text-white border-0 rounded-top-4">
                                            <h5 class="modal-title"><i class="bi bi-exclamation-triangle me-2"></i>Chấm dứt Hợp đồng</h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                        </div>
                                        <form asp-controller="Driver" asp-action="CancelContract" asp-route-id="@contract.DriverContractID" method="post">
                                            @Html.AntiForgeryToken()
                                            <div class="modal-body p-4">
                                                <p>Xác nhận chấm dứt hợp đồng <strong>#@contract.ContractNo</strong>?</p>
                                                <div class="mb-3">
                                                    <label class="form-label">Lý do</label>
                                                    <textarea name="reason" class="form-control rounded-3" rows="3" placeholder="Nhập lý do..."></textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-0 driver-contract-modal-actions">
                                                <button type="button" class="btn btn-light rounded-pill px-3" data-bs-dismiss="modal">Quay lại</button>
                                                <button type="submit" class="btn btn-danger rounded-pill px-4">
                                                    <i class="bi bi-x-lg me-1"></i>Xác nhận hủy
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a asp-action="MyContract" asp-route-id="@contract.DriverContractID" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                <i class="bi bi-eye me-1"></i>Xem chi tiết
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        document.getElementById('myDriverAvatarFile')?.addEventListener('change', function () {
            const file = this.files && this.files[0];
            const preview = document.getElementById('myDriverAvatarPreview');
            const placeholder = document.getElementById('myDriverAvatarPlaceholder');
            if (!file || !preview) return;

            preview.src = URL.createObjectURL(file);
            preview.classList.remove('d-none');
            placeholder?.classList.add('d-none');
        });
    </script>
}
