# CarRentalSystem environment variables
# Copy to .env locally or configure these values in a secrets manager.
# Never commit real credentials.

ASPNETCORE_ENVIRONMENT=Development

# Public URL used for PayOS return/cancel links.
# For local PayOS testing, expose the app with ngrok/cloudflared and set this to the HTTPS tunnel URL.
App__PublicBaseUrl=

# Database
ConnectionStrings__DefaultConnection=Server=YOUR_DB_SERVER;Database=CarRentalDB;User Id=YOUR_DB_USER;Password=YOUR_DB_PASSWORD;TrustServerCertificate=True;Encrypt=True

# Startup safety
Security__RunMigrationsOnStartup=false
Security__SeedReferenceDataOnStartup=false
Security__TrustForwardedHeaders=false

# Redis (optional)
Redis__ConnectionString=

# PayOS
PayOS__ClientId=YOUR_PAYOS_CLIENT_ID
PayOS__ApiKey=YOUR_PAYOS_API_KEY
PayOS__ChecksumKey=YOUR_PAYOS_CHECKSUM_KEY

# SMTP
SmtpSettings__Host=smtp.gmail.com
SmtpSettings__Port=587
SmtpSettings__User=YOUR_SMTP_USER
SmtpSettings__Pass=YOUR_SMTP_APP_PASSWORD

# FPT.AI eKYC
FptAi__ApiKey=YOUR_FPT_AI_API_KEY
FptAi__MaxThrottlingRetries=3

# AI providers
Ai__Enabled=false
Ai__Provider=OpenAI
Ai__ApiKey=YOUR_OPENAI_OR_GROQ_COMPATIBLE_API_KEY
Ai__BaseUrl=https://api.openai.com/v1/
Ai__Model=gpt-4.1-mini
# Groq-compatible option:
# Ai__Provider=Groq
# Ai__BaseUrl=https://api.groq.com/openai/v1/
# Ai__Model=llama-3.3-70b-versatile
Groq__ApiKey=YOUR_GROQ_API_KEY
Gemini__ApiKey=YOUR_GEMINI_API_KEY

# reCAPTCHA
Recaptcha__SiteKey=YOUR_RECAPTCHA_SITE_KEY
Recaptcha__SecretKey=YOUR_RECAPTCHA_SECRET_KEY

# Admin PIN
Admin__Pin=CHANGE_TO_A_SECURE_6_DIGIT_PIN
