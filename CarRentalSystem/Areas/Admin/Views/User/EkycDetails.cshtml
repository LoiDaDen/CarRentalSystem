@model CarRentalSystem.Models.User
@{
    ViewData["Title"] = "Chi tiết eKYC";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <div>
        <a asp-action="EkycPending" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
        <h1 class="h3 mb-0 text-gray-800">
            <i class="bi bi-shield-check text-primary me-2"></i>Chi tiết eKYC
        </h1>
    </div>
    @if (Model.VerificationStatus == "Pending")
    {
        <div class="badge bg-warning text-dark fs-5 px-3 py-2">
            <i class="bi bi-clock-fill me-1"></i>Chờ duyệt
        </div>
    }
</div>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <!-- Left Column - User Info & Actions -->
    <div class="col-lg-4">
        <!-- PIN Verification Card -->
        <div class="card shadow-sm mb-4 border-0" style="border-radius: 16px;">
            <div class="card-header bg-gradient py-3" style="background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%); border-radius: 16px 16px 0 0;">
                <h5 class="mb-0 text-white fw-bold"><i class="bi bi-shield-lock me-2"></i>Xác thực PIN</h5>
            </div>
            <div class="card-body">
                <p class="text-muted small">Nhập mã PIN để xem thông tin CCCD và GPLX của khách hàng.</p>
                <div id="pinSection">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Mã PIN Admin</label>
                        <div class="input-group">
                            <input type="password" id="adminPin" class="form-control" placeholder="Nhập mã PIN..." maxlength="6">
                            <button class="btn btn-outline-warning" type="button" onclick="togglePinVisibility()">
                                <i class="bi bi-eye" id="pinIcon"></i>
                            </button>
                        </div>
                    </div>
                    <button type="button" class="btn btn-warning w-100 fw-bold" onclick="verifyPin()">
                        <i class="bi bi-unlock me-2"></i>Xác minh & Xem thông tin
                    </button>
                    <div id="pinError" class="text-danger small mt-2 d-none">
                        <i class="bi bi-exclamation-circle me-1"></i>PIN không đúng. Vui lòng thử lại.
                    </div>
                </div>
            </div>
        </div>

        <!-- User Info Card -->
        <div class="card shadow-sm mb-4 border-0" style="border-radius: 16px;">
            <div class="card-header bg-gradient py-3" style="background: linear-gradient(135deg, #4e73df 0%, #224abe 100%); border-radius: 16px 16px 0 0;">
                <div class="d-flex align-items-center">
                    <div class="avatar rounded-circle bg-white text-primary d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px; font-size: 1.5rem; font-weight: bold;">
                        @Model.Name?.FirstOrDefault()
                    </div>
                    <div>
                        <h5 class="mb-0 text-white fw-bold">@Model.Name</h5>
                        <small class="text-white-50">@Model.Email</small>
                    </div>
                </div>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5 text-muted">Vai trò</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-@(Model.Role == "Admin" ? "danger" : Model.Role == "Partner" ? "warning text-dark" : "info")">
                            @Model.Role
                        </span>
                    </dd>
                    
                    <dt class="col-sm-5 text-muted">Số CCCD</dt>
                    <dd class="col-sm-7" id="citizenIdDisplay">
                        <span class="text-warning fw-bold"><i class="bi bi-lock me-1"></i>●●●●●●●●</span>
                    </dd>
                    
                    <dt class="col-sm-5 text-muted">Số GPLX</dt>
                    <dd class="col-sm-7" id="licenseDisplay">
                        <span class="text-warning fw-bold"><i class="bi bi-lock me-1"></i>●●●●●●●●</span>
                    </dd>
                    
                    <dt class="col-sm-5 text-muted">Ngày sinh</dt>
                    <dd class="col-sm-7">@(Model.DateOfBirth?.ToString("dd/MM/yyyy") ?? "-")</dd>
                    
                    <dt class="col-sm-5 text-muted">Giới tính</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Gender) ? "-" : Model.Gender)</dd>
                    
                    <dt class="col-sm-5 text-muted">Địa chỉ</dt>
                    <dd class="col-sm-7">@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</dd>
                    
                    <dt class="col-sm-5 text-muted">Ngày đăng ký</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
        </div>

        <!-- Hidden citizen data for JS to access -->
        <input type="hidden" id="hiddenCitizenId" value="@Model.CitizenId" />
        <input type="hidden" id="hiddenLicense" value="@Model.DrivingLicenseNumber" />

        <!-- Action Buttons -->
        @if (Model.VerificationStatus == "Pending")
        {
            <div class="card shadow-sm border-0" style="border-radius: 16px;">
                <div class="card-header bg-light py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-gear me-2"></i>Thao tác</h5>
                </div>
                <div class="card-body">
                    <!-- Approve Form -->
                    <form asp-action="ApproveEkyc" asp-area="Admin" method="post" class="mb-3">
                        <input type="hidden" name="id" value="@Model.UserID" />
                        <button type="submit" class="btn btn-success w-100 fw-bold py-2" style="border-radius: 10px;">
                            <i class="bi bi-check-circle-fill me-2"></i>Duyệt eKYC
                        </button>
                    </form>

                    <!-- Reject Form -->
                    <form asp-action="RejectEkyc" asp-area="Admin" method="post">
                        <input type="hidden" name="id" value="@Model.UserID" />
                        <div class="mb-3">
                            <label class="form-label small text-muted fw-bold">Lý do từ chối (tùy chọn)</label>
                            <textarea name="reason" class="form-control" rows="2" placeholder="VD: Ảnh mờ, thông tin không khớp..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-outline-danger w-100 fw-bold py-2" style="border-radius: 10px;">
                            <i class="bi bi-x-circle me-2"></i>Từ chối
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>

    <!-- Right Column - Document Images -->
    <div class="col-lg-8">
        <div class="row g-4">
            <!-- CCCD Mặt trước -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100 border-0" style="border-radius: 16px;">
                    <div class="card-header bg-primary text-white py-3" style="border-radius: 16px 16px 0 0;">
                        <h6 class="mb-0"><i class="bi bi-credit-card-2-front me-2"></i>CCCD Mặt trước</h6>
                    </div>
                    <div class="card-body p-2">
                        @if (!string.IsNullOrEmpty(Model.IdCardFrontUrl))
                        {
                            <a href="@Model.IdCardFrontUrl" target="_blank">
                                <img src="@Model.IdCardFrontUrl" class="img-fluid rounded id-card-img" alt="CCCD mặt trước" style="max-height: 250px; width: 100%; object-fit: contain; background: #f8f9fa;">
                            </a>
                        }
                        else
                        {
                            <div class="text-center text-muted py-5 bg-light rounded">
                                <i class="bi bi-image fs-1"></i>
                                <p class="mb-0 mt-2">Chưa tải lên</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- CCCD Mặt sau -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100 border-0" style="border-radius: 16px;">
                    <div class="card-header bg-primary text-white py-3" style="border-radius: 16px 16px 0 0;">
                        <h6 class="mb-0"><i class="bi bi-credit-card-2-back me-2"></i>CCCD Mặt sau</h6>
                    </div>
                    <div class="card-body p-2">
                        @if (!string.IsNullOrEmpty(Model.IdCardBackUrl))
                        {
                            <a href="@Model.IdCardBackUrl" target="_blank">
                                <img src="@Model.IdCardBackUrl" class="img-fluid rounded id-card-img" alt="CCCD mặt sau" style="max-height: 250px; width: 100%; object-fit: contain; background: #f8f9fa;">
                            </a>
                        }
                        else
                        {
                            <div class="text-center text-muted py-5 bg-light rounded">
                                <i class="bi bi-image fs-1"></i>
                                <p class="mb-0 mt-2">Chưa tải lên</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- GPLX Mặt trước -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100 border-0" style="border-radius: 16px;">
                    <div class="card-header bg-info text-white py-3" style="border-radius: 16px 16px 0 0;">
                        <h6 class="mb-0"><i class="bi bi-card-text me-2"></i>Giấy phép lái xe (Mặt trước)</h6>
                    </div>
                    <div class="card-body p-2">
                        @if (!string.IsNullOrEmpty(Model.DrivingLicenseUrl))
                        {
                            <a href="@Model.DrivingLicenseUrl" target="_blank">
                                <img src="@Model.DrivingLicenseUrl" class="img-fluid rounded id-card-img" alt="GPLX mặt trước" style="max-height: 250px; width: 100%; object-fit: contain; background: #f8f9fa;">
                            </a>
                        }
                        else
                        {
                            <div class="text-center text-muted py-5 bg-light rounded">
                                <i class="bi bi-image fs-1"></i>
                                <p class="mb-0 mt-2">Chưa tải lên</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- GPLX Mặt sau -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100 border-0" style="border-radius: 16px;">
                    <div class="card-header bg-info text-white py-3" style="border-radius: 16px 16px 0 0;">
                        <h6 class="mb-0"><i class="bi bi-card-text me-2"></i>Giấy phép lái xe (Mặt sau)</h6>
                    </div>
                    <div class="card-body p-2">
                        @if (!string.IsNullOrEmpty(Model.DrivingLicenseBackUrl))
                        {
                            <a href="@Model.DrivingLicenseBackUrl" target="_blank">
                                <img src="@Model.DrivingLicenseBackUrl" class="img-fluid rounded id-card-img" alt="GPLX mặt sau" style="max-height: 250px; width: 100%; object-fit: contain; background: #f8f9fa;">
                            </a>
                        }
                        else
                        {
                            <div class="text-center text-muted py-5 bg-light rounded">
                                <i class="bi bi-image fs-1"></i>
                                <p class="mb-0 mt-2">Chưa tải lên</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Selfie -->
            <div class="col-md-6">
                <div class="card shadow-sm h-100 border-0" style="border-radius: 16px;">
                    <div class="card-header bg-dark py-3" style="border-radius: 16px 16px 0 0;">
                        <h6 class="mb-0"><i class="bi bi-person me-2"></i>Ảnh chân dung (Selfie)</h6>
                    </div>
                    <div class="card-body p-2">
                        @if (!string.IsNullOrEmpty(Model.FaceUrl))
                        {
                            <a href="@Model.FaceUrl" target="_blank">
                                <img src="@Model.FaceUrl" class="img-fluid rounded" alt="Ảnh chân dung" style="max-height: 250px; width: 100%; object-fit: contain; background: #f8f9fa;">
                            </a>
                        }
                        else
                        {
                            <div class="text-center text-muted py-5 bg-light rounded">
                                <i class="bi bi-image fs-1"></i>
                                <p class="mb-0 mt-2">Chưa tải lên</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .avatar {
        font-size: 1.5rem;
        font-weight: bold;
    }
    .card {
        transition: transform 0.2s;
    }
    .card:hover {
        transform: translateY(-2px);
    }
    .img-fluid {
        cursor: zoom-in;
    }
    .blurred {
        filter: blur(8px);
        transition: filter 0.3s;
    }
    .blurred.revealed {
        filter: blur(0);
    }
    .locked-overlay {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        background: rgba(0,0,0,0.7);
        padding: 15px 25px;
        border-radius: 10px;
        color: white;
        z-index: 10;
    }
</style>

@section Scripts {
    <script>
        // Admin PIN for viewing sensitive data (for demo - in production, this should be validated server-side)
        const ADMIN_PIN = '123456';

        function togglePinVisibility() {
            const pinInput = document.getElementById('adminPin');
            const pinIcon = document.getElementById('pinIcon');
            if (pinInput.type === 'password') {
                pinInput.type = 'text';
                pinIcon.className = 'bi bi-eye-slash';
            } else {
                pinInput.type = 'password';
                pinIcon.className = 'bi bi-eye';
            }
        }

        function verifyPin() {
            const enteredPin = document.getElementById('adminPin').value;
            const errorDiv = document.getElementById('pinError');
            
            if (enteredPin === ADMIN_PIN) {
                // Hide error if shown
                errorDiv.classList.add('d-none');
                
                // Reveal citizen ID and license
                const citizenIdDisplay = document.getElementById('citizenIdDisplay');
                const licenseDisplay = document.getElementById('licenseDisplay');
                const hiddenCitizenId = document.getElementById('hiddenCitizenId').value;
                const hiddenLicense = document.getElementById('hiddenLicense').value;
                
                if (hiddenCitizenId) {
                    citizenIdDisplay.innerHTML = '<code class="text-success fw-bold">' + hiddenCitizenId + '</code>';
                } else {
                    citizenIdDisplay.innerHTML = '<span class="text-muted">Chưa có</span>';
                }
                
                if (hiddenLicense) {
                    licenseDisplay.innerHTML = '<code class="text-success fw-bold">' + hiddenLicense + '</code>';
                } else {
                    licenseDisplay.innerHTML = '<span class="text-muted">Chưa có</span>';
                }
                
                // Hide PIN section
                document.getElementById('pinSection').innerHTML = 
                    '<div class="alert alert-success py-2 mb-0"><i class="bi bi-check-circle me-2"></i>Đã xác minh thành công!</div>';
                
                // Blur images and show lock overlay
                const images = document.querySelectorAll('.id-card-img');
                images.forEach(function(img) {
                    img.classList.add('blurred');
                    // Add lock overlay if not exists
                    if (!img.nextElementSibling || !img.nextElementSibling.classList.contains('locked-overlay')) {
                        const overlay = document.createElement('div');
                        overlay.className = 'locked-overlay';
                        overlay.innerHTML = '<i class="bi bi-lock-fill me-2"></i>Đã mở khóa';
                        img.parentElement.style.position = 'relative';
                        img.parentElement.appendChild(overlay);
                    }
                });
                
                // Allow clicking images to reveal
                setTimeout(function() {
                    const overlays = document.querySelectorAll('.locked-overlay');
                    overlays.forEach(function(overlay) {
                        overlay.style.cursor = 'pointer';
                        overlay.addEventListener('click', function() {
                            this.previousElementSibling.classList.add('revealed');
                            this.style.display = 'none';
                        });
                    });
                }, 100);
                
            } else {
                errorDiv.classList.remove('d-none');
                document.getElementById('adminPin').value = '';
                document.getElementById('adminPin').focus();
            }
        }

        // Allow Enter key to submit PIN
        document.getElementById('adminPin').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                verifyPin();
            }
        });

        // Auto-focus PIN input on page load
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('adminPin').focus();
        });
    </script>
}
