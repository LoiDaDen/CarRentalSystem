@model IEnumerable<CarRentalSystem.Models.User>
@{
    ViewData["Title"] = "Duyệt eKYC";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    
    var pendingCount = Model.Count(u => u.VerificationStatus == "Pending");
    var verifiedCount = Model.Count(u => u.VerificationStatus == "Verified");
    var rejectedCount = Model.Count(u => u.VerificationStatus == "Rejected");
}

<!-- Page Heading -->
<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">
        <i class="bi bi-shield-check text-primary me-2"></i>Duyệt eKYC
    </h1>
    <div class="d-flex gap-2">
        <span class="badge bg-warning fs-6 px-3 py-2">
            <i class="bi bi-clock me-1"></i>@pendingCount chờ duyệt
        </span>
        <span class="badge bg-success fs-6 px-3 py-2">
            <i class="bi bi-check-circle me-1"></i>@verifiedCount đã duyệt
        </span>
        <span class="badge bg-danger fs-6 px-3 py-2">
            <i class="bi bi-x-circle me-1"></i>@rejectedCount từ chối
        </span>
    </div>
</div>

<!-- Alerts -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Warning"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card shadow-sm">
        <div class="card-body text-center py-5">
            <div class="mb-4">
                <i class="bi bi-inbox-fill text-muted" style="font-size: 4rem;"></i>
            </div>
            <h4 class="text-muted mb-2">Không có hồ sơ eKYC nào</h4>
            <p class="text-muted small">Tất cả hồ sơ đã được xử lý hoặc chưa có ai nộp.</p>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var user in Model)
        {
            <div class="col-xl-4 col-lg-6">
                <div class="card shadow-sm h-100 border-0" style="border-radius: 16px; overflow: hidden;">
                    <!-- Card Header -->
                    <div class="card-header bg-gradient py-3" style="background: linear-gradient(135deg, #4e73df 0%, #224abe 100%);">
                        <div class="d-flex align-items-center">
                            <div class="avatar rounded-circle bg-white text-primary d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px; font-weight: bold;">
                                @user.Name?.FirstOrDefault()
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="mb-0 text-white fw-bold">@user.Name</h5>
                                <small class="text-white-50">@user.Email</small>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Card Body -->
                    <div class="card-body">
                        <!-- Status Badge -->
                        <div class="mb-3">
                            @if (user.VerificationStatus == "Pending")
                            {
                                <span class="badge bg-warning text-dark px-3 py-2">
                                    <i class="bi bi-clock-fill me-1"></i>Chờ duyệt
                                </span>
                            }
                            else if (user.VerificationStatus == "Verified")
                            {
                                <span class="badge bg-success px-3 py-2">
                                    <i class="bi bi-check-circle-fill me-1"></i>Đã duyệt
                                </span>
                            }
                            else if (user.VerificationStatus == "Rejected")
                            {
                                <span class="badge bg-danger px-3 py-2">
                                    <i class="bi bi-x-circle-fill me-1"></i>Từ chối
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary px-3 py-2">
                                    <i class="bi bi-hourglass me-1"></i>Chưa nộp
                                </span>
                            }
                            <span class="badge bg-light text-dark px-2 py-2 ms-1">
                                <i class="bi bi-person-badge me-1"></i>@user.Role
                            </span>
                        </div>
                        
                        <!-- Info -->
                        <div class="small">
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted"><i class="bi bi-credit-card me-2"></i>CCCD:</span>
                                <strong class="text-dark">@(string.IsNullOrEmpty(user.CitizenId) ? "Chưa có" : user.CitizenId)</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted"><i class="bi bi-car-front me-2"></i>GPLX:</span>
                                <strong class="text-dark">@(string.IsNullOrEmpty(user.DrivingLicenseNumber) ? "Chưa có" : user.DrivingLicenseNumber)</strong>
                            </div>
                            <div class="d-flex justify-content-between py-2 border-bottom">
                                <span class="text-muted"><i class="bi bi-calendar3 me-2"></i>Ngày nộp:</span>
                                <strong class="text-dark">@user.CreatedAt.ToString("dd/MM/yyyy HH:mm")</strong>
                            </div>
                        </div>
                        
                        <!-- Document Preview Thumbnails -->
                        <div class="mt-3">
                            <small class="text-muted fw-bold">Tài liệu đã tải:</small>
                            <div class="d-flex gap-2 mt-2">
                                @if (!string.IsNullOrEmpty(user.IdCardFrontUrl))
                                {
                                    <div class="text-center">
                                        <img src="@user.IdCardFrontUrl" loading="lazy" class="rounded" style="width: 50px; height: 35px; object-fit: cover;" alt="CCCD trước">
                                        <small class="d-block text-muted small">CCCD trước</small>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(user.IdCardBackUrl))
                                {
                                    <div class="text-center">
                                        <img src="@user.IdCardBackUrl" loading="lazy" class="rounded" style="width: 50px; height: 35px; object-fit: cover;" alt="CCCD sau">
                                        <small class="d-block text-muted small">CCCD sau</small>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(user.DrivingLicenseUrl))
                                {
                                    <div class="text-center">
                                        <img src="@user.DrivingLicenseUrl" loading="lazy" class="rounded" style="width: 50px; height: 35px; object-fit: cover;" alt="GPLX trước">
                                        <small class="d-block text-muted small">GPLX trước</small>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(user.DrivingLicenseBackUrl))
                                {
                                    <div class="text-center">
                                        <img src="@user.DrivingLicenseBackUrl" loading="lazy" class="rounded" style="width: 50px; height: 35px; object-fit: cover;" alt="GPLX sau">
                                        <small class="d-block text-muted small">GPLX sau</small>
                                    </div>
                                }
                                @if (!string.IsNullOrEmpty(user.FaceUrl))
                                {
                                    <div class="text-center">
                                        <img src="@user.FaceUrl" loading="lazy" class="rounded" style="width: 50px; height: 35px; object-fit: cover;" alt="Selfie">
                                        <small class="d-block text-muted small">Selfie</small>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <!-- Card Footer -->
                    <div class="card-footer bg-white border-top">
                        <a asp-action="EkycDetails" asp-route-id="@user.UserID" class="btn btn-primary btn-sm w-100 fw-bold">
                            <i class="bi bi-eye me-2"></i>Xem chi tiết & Duyệt
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .avatar {
        font-size: 1.2rem;
    }
</style>
