@model IEnumerable<CarRentalSystem.Models.User>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Yêu cầu làm Đối tác";
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <h2 class="fw-bold text-dark mb-1">Yêu cầu làm Đối tác</h2>
        <p class="text-muted">Danh sách người dùng đăng ký trở thành Đối tác (Partner) đang chờ xác minh eKYC.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <div class="opacity-25 mb-3">
                <i class="bi bi-person-check display-1"></i>
            </div>
            <h4 class="text-muted fw-normal">Không có yêu cầu nào đang chờ duyệt</h4>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var user in Model)
            {
                <div class="col-md-6 col-xxl-4">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center mb-4">
                                <img src="https://ui-avatars.com/api/?name=@(user.Name)&background=random&color=fff" class="rounded-circle me-3" width="60" height="60">
                                <div>
                                    <h5 class="fw-bold mb-0">@user.Name</h5>
                                    <p class="text-muted small mb-0">@user.Email</p>
                                    <span class="badge bg-light text-dark border small mt-1">Đăng ký: @user.CreatedAt.ToString("dd/MM/yyyy")</span>
                                </div>
                            </div>

                            <div class="row g-2 mb-4">
                                <div class="col-12">
                                    <div class="bg-light p-3 rounded-3">
                                        <div class="text-muted x-small text-uppercase fw-bold mb-2">Giấy tờ định danh (eKYC)</div>
                                        <div class="d-flex gap-2">
                                            @if (!string.IsNullOrEmpty(user.IdCardFrontUrl)) {
                                                <a href="@user.IdCardFrontUrl" target="_blank" class="btn btn-sm btn-outline-primary px-3 rounded-pill">Mặt trước</a>
                                            }
                                            else {
                                                <span class="text-danger small"><i class="bi bi-exclamation-triangle me-1"></i>Thiếu CMND/CCCD</span>
                                            }
                                            
                                            @if (!string.IsNullOrEmpty(user.DrivingLicenseUrl)) {
                                                <a href="@user.DrivingLicenseUrl" target="_blank" class="btn btn-sm btn-outline-primary px-3 rounded-pill">Bằng lái</a>
                                            }
                                            else {
                                                <span class="text-danger small"><i class="bi bi-exclamation-triangle me-1"></i>Thiếu Bằng lái</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-2 mt-auto">
                                <form asp-action="ToggleVerify" asp-route-id="@user.UserID" method="post" class="flex-grow-1">
                                    <button type="submit" class="btn btn-primary w-100 rounded-pill fw-bold">Duyệt eKYC</button>
                                </form>
                                <form asp-action="ToggleBlacklist" asp-route-id="@user.UserID" method="post" class="flex-grow-1">
                                    <button type="submit" class="btn btn-outline-danger w-100 rounded-pill">Từ chối/Chặn</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .x-small { font-size: 0.75rem; letter-spacing: 0.5px; }
</style>
