@model IEnumerable<CarRentalSystem.Models.Promotion>
@{
    ViewData["Title"] = "Quản lý Khuyến mãi";
    Layout = "_AdminLayout";
}

<style>
    .fw-800 { font-weight: 800; }
    .table-promo td { padding: 1rem 1.25rem; vertical-align: middle; }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-3">
        <i class="bi bi-check-circle-fill text-success"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h2 class="fw-800 mb-1" style="letter-spacing: -1px;">Mã Khuyến Mãi</h2>
        <p class="text-muted mb-0">Tạo mới và quản lý các chiến dịch giảm giá, voucher.</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Promotions" asp-action="TrashBin" class="btn btn-outline-secondary shadow-sm px-4 py-2 rounded-3 fw-bold">
            <i class="bi bi-trash3 me-2"></i>Thùng rác
        </a>
        <a asp-area="Admin" asp-controller="Promotions" asp-action="Create" class="btn btn-primary shadow-sm px-4 py-2 rounded-3 fw-bold">
            <i class="bi bi-tag-fill me-2"></i>Thêm mã mới
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-promo">
            <thead style="background: #f8fafd;">
                <tr class="text-muted small text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.8px;">
                    <th class="ps-4">Mã Code</th>
                    <th>Mức Giảm</th>
                    <th>Tối đa</th>
                    <th>Thời hạn</th>
                    <th>Đã dùng</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="badge bg-light text-dark border px-3 py-2 fw-bold" style="font-family: monospace; font-size: 0.9rem;">
                                <i class="bi bi-ticket-perforated me-1 text-primary"></i>@p.PromoCode
                            </span>
                        </td>
                        <td class="fw-800 text-danger">
                            -@p.DiscountPercent.ToString("0.##")%
                        </td>
                        <td>
                            <small class="text-muted">@(p.MaxDiscountAmount.HasValue ? p.MaxDiscountAmount.Value.ToString("N0") + "đ" : "Không giới hạn")</small>
                        </td>
                        <td class="small">
                            <div class="fw-600">@p.ValidFrom.ToString("dd/MM/yyyy")</div>
                            <div class="text-muted">@p.ValidUntil.ToString("dd/MM/yyyy")</div>
                        </td>
                        <td>
                            <div class="progress" style="height: 6px; width: 80px; margin-bottom: 4px;">
                                <div class="progress-bar @(p.UsedCount >= p.UsageLimit ? "bg-danger" : "bg-primary")" role="progressbar" style="width: @((p.UsedCount * 100) / p.UsageLimit)%"></div>
                            </div>
                            <small class="text-muted fw-bold">@p.UsedCount / @p.UsageLimit</small>
                        </td>
                        <td>
                            @if (p.IsActive)
                            {
                                @if (p.ValidUntil < DateTime.Now)
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1">Hết hạn</span>
                                }
                                else if (p.UsedCount >= p.UsageLimit)
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-1">Hết lượt</span>
                                }
                                else
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1 mb-1 d-inline-block">Hoạt động</span>
                                }
                            }
                            else
                            {
                                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1">Đã tắt</span>
                            }
                            
                        </td>
                        <td class="text-end pe-4">
                            <form asp-action="ToggleStatus" asp-route-id="@p.PromotionID" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-light rounded-3 shadow-sm px-2 me-1" title="@(p.IsActive ? "Tắt mã" : "Bật mã")">
                                    <i class="bi @(p.IsActive ? "bi-pause-circle text-warning" : "bi-play-circle text-success")"></i>
                                </button>
                            </form>
                            <a asp-action="Edit" asp-route-id="@p.PromotionID" class="btn btn-sm btn-light rounded-3 shadow-sm px-2 me-1">
                                <i class="bi bi-pencil-square text-primary"></i>
                            </a>
                            <button type="button" class="btn btn-sm btn-light text-danger rounded-3 shadow-sm px-2" data-bs-toggle="modal" data-bs-target="#deleteModal-@p.PromotionID">
                                <i class="bi bi-trash3"></i>
                            </button>

                            <!-- Delete Modal -->
                            <div class="modal fade text-start" id="deleteModal-@p.PromotionID" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered modal-sm">
                                    <div class="modal-content border-0 shadow-lg rounded-4 text-center p-4">
                                        <div class="mb-3">
                                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10" style="width:60px;height:60px;">
                                                <i class="bi bi-trash3-fill text-danger fs-3"></i>
                                            </span>
                                        </div>
                                        <h6 class="fw-800 mb-2">Xóa mã @p.PromoCode?</h6>
                                        <p class="text-muted small mb-4">Hành động này không thể hoàn tác.</p>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-light flex-grow-1 rounded-3 fw-bold" data-bs-dismiss="modal">Hủy</button>
                                            <form asp-action="Delete" asp-route-id="@p.PromotionID" method="post" class="flex-grow-1">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-danger w-100 rounded-3 fw-bold">Xóa</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-tags display-4 opacity-10 d-block mb-3"></i>
                            <p class="fw-bold opacity-50 mb-0">Chưa có mã khuyến mãi nào</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
