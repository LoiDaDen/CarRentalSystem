@model CarRentalSystem.Models.AuditLog
@{
    ViewData["Title"] = "Chi tiết Audit Log #" + Model.AuditLogID;
    Layout = "_AdminLayout";
}

<div class="theme-admin">
<style>
    .theme-admin .card { background: var(--admin-card-bg); border: 1px solid var(--admin-border-color); border-radius: 16px; }
    .theme-admin .card-header { background: var(--admin-surface-200); border-bottom: 1px solid var(--admin-border-color); }
    .theme-admin .table-borderless td, .theme-admin .table-borderless th { color: var(--admin-text); }
    .theme-admin .text-muted { color: var(--admin-text-secondary) !important; }
    .theme-admin pre { background: var(--admin-surface-200); color: var(--admin-text); }
</style>

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4><i class="bi bi-shield-check" style="color: var(--admin-primary);"></i> Chi tiết Audit Log #@Model.AuditLogID</h4>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
    </div>

    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-semibold">
                    <i class="bi bi-info-circle"></i> Thông tin chung
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tr>
                            <th width="140" class="text-muted">Hành động:</th>
                            <td>
                                @{
                                    var badge = Model.Action switch
                                    {
                                        "Create" => "bg-success",
                                        "Update" => "bg-warning text-dark",
                                        "Delete" => "bg-danger",
                                        "Login" => "bg-info",
                                        _ => "bg-primary"
                                    };
                                }
                                <span class="badge @badge fs-6">@Model.Action</span>
                            </td>
                        </tr>
                        <tr><th class="text-muted">Module:</th><td><strong>@Model.EntityType</strong></td></tr>
                        <tr><th class="text-muted">Mã thực thể:</th><td>@(Model.EntityId?.ToString() ?? "N/A")</td></tr>
                        <tr><th class="text-muted">Thời gian:</th><td>@Model.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")</td></tr>
                        <tr><th class="text-muted">Mô tả:</th><td>@Model.Description</td></tr>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-semibold">
                    <i class="bi bi-person"></i> Người thực hiện
                </div>
                <div class="card-body">
                    <table class="table table-borderless mb-0">
                        <tr><th width="140" class="text-muted">Người dùng:</th><td><strong>@(Model.UserName ?? "Anonymous")</strong></td></tr>
                        <tr><th class="text-muted">Mã người dùng:</th><td>@(Model.UserId?.ToString() ?? "N/A")</td></tr>
                        <tr><th class="text-muted">Địa chỉ IP:</th><td><code>@Model.IpAddress</code></td></tr>
                        <tr><th class="text-muted">Yêu cầu:</th><td><code>@Model.RequestUrl</code></td></tr>
                        <tr><th class="text-muted">User-Agent:</th><td class="small">@(Model.UserAgent ?? "N/A")</td></tr>
                    </table>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.OldValues) || !string.IsNullOrEmpty(Model.NewValues))
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-header fw-semibold">
                        <i class="bi bi-arrow-left-right"></i> Thay đổi dữ liệu
                    </div>
                    <div class="card-body">
                        <div class="row">
                            @if (!string.IsNullOrEmpty(Model.OldValues))
                            {
                                <div class="col-md-6">
                                    <h6 class="text-danger"><i class="bi bi-dash-circle"></i> Giá trị cũ</h6>
                                    <pre class="bg-light p-3 rounded" style="max-height:300px; overflow:auto;">@Model.OldValues</pre>
                                </div>
                            }
                            @if (!string.IsNullOrEmpty(Model.NewValues))
                            {
                                <div class="col-md-6">
                                    <h6 class="text-success"><i class="bi bi-plus-circle"></i> Giá trị mới</h6>
                                    <pre class="bg-light p-3 rounded" style="max-height:300px; overflow:auto;">@Model.NewValues</pre>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
</div>
