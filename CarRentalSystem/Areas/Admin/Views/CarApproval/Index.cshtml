@model IEnumerable<CarRentalSystem.Models.Car>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Duyệt Xe Mới";
    var currentRole = ViewBag.CurrentRole as string ?? "Admin";
    var canApprove = ViewBag.CanApprove as bool? ?? false;
}

<div class="container-fluid py-4">
    <div class="mb-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold text-dark mb-1">Duyệt Xe Mới</h2>
                <p class="text-muted mb-0">Xem xét các xe đối tác vừa đăng tải lên sàn trước khi cho phép hoạt động.</p>
            </div>
            @if (!canApprove)
            {
                <div class="badge bg-info px-3 py-2 rounded-pill">
                    <i class="bi bi-eye me-1"></i>Chế độ xem (Staff)
                </div>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 mb-4 shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 mb-4 shadow-sm" role="alert">
            <i class="bi bi-x-circle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center">
            <div class="opacity-25 mb-3">
                <i class="bi bi-check2-circle display-1"></i>
            </div>
            <h4 class="text-muted fw-normal">Hiện không có xe nào đang chờ duyệt</h4>
            @if (!canApprove)
            {
                <p class="text-muted small mt-2">Bạn chỉ có quyền xem danh sách xe chờ duyệt trong khu vực của mình.</p>
            }
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var car in Model)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100">
                        @if (!string.IsNullOrEmpty(car.ImageURL))
                        {
                            <img src="@car.ImageURL" class="card-img-top" alt="@car.CarName" style="height: 200px; object-fit: cover;">
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 200px;">
                                <i class="bi bi-car-front text-secondary" style="font-size: 4rem;"></i>
                            </div>
                        }
                        <div class="card-body p-4">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h5 class="fw-bold mb-0 text-truncate" style="max-width: 200px;">@car.CarName</h5>
                                <span class="badge bg-warning text-dark px-2 rounded-pill">Chờ duyệt</span>
                            </div>
                            <p class="text-muted small mb-3">
                                <i class="bi bi-person me-1"></i>Chủ xe: <strong>@(car.Owner?.Name ?? "N/A")</strong>
                            </p>

                            <ul class="list-unstyled small mb-4">
                                @if (car.CarBrand != null)
                                {
                                    <li class="mb-1"><i class="bi bi-tag me-2 text-secondary"></i>Hãng: @car.CarBrand.Name</li>
                                }
                                @if (!string.IsNullOrEmpty(car.LicensePlate))
                                {
                                    <li class="mb-1"><i class="bi bi-hash me-2 text-secondary"></i>Biển số: <code>@car.LicensePlate</code></li>
                                }
                                @if (!string.IsNullOrEmpty(car.VIN))
                                {
                                    <li class="mb-1"><i class="bi bi-upc-scan me-2 text-secondary"></i>Số khung: <code>@car.VIN</code></li>
                                }
                                <li class="mb-1"><i class="bi bi-cash me-2 text-secondary"></i>Giá: <strong class="text-success">@car.PricePerDay.ToString("N0")đ</strong>/ngày</li>
                                @if (car.Location != null)
                                {
                                    <li class="mb-1"><i class="bi bi-geo-alt me-2 text-secondary"></i>Vị trí: <span class="badge bg-light text-dark border">@car.Location.Name</span></li>
                                }
                                @if (car.CreatedAt != default)
                                {
                                    <li class="mb-1"><i class="bi bi-clock me-2 text-secondary"></i>Ngày đăng: @car.CreatedAt.ToString("dd/MM/yyyy HH:mm")</li>
                                }
                            </ul>

                            @if (!string.IsNullOrEmpty(car.Description))
                            {
                                <div class="bg-light p-3 rounded-3 mb-4">
                                    <small class="text-muted">@car.Description</small>
                                </div>
                            }

                            @if (canApprove)
                            {
                                <div class="d-flex gap-2">
                                    <form asp-action="Approve" asp-route-id="@car.CarID" method="post" class="flex-grow-1">
                                        <button type="submit" class="btn btn-success w-100 rounded-pill fw-bold">
                                            <i class="bi bi-check-circle me-1"></i>Duyệt
                                        </button>
                                    </form>
                                    <form asp-action="Reject" asp-route-id="@car.CarID" method="post" class="flex-grow-1">
                                        <button type="submit" class="btn btn-outline-danger w-100 rounded-pill fw-bold">
                                            <i class="bi bi-x-circle me-1"></i>Từ chối
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-items-center justify-content-center gap-2 text-muted small py-2">
                                    <i class="bi bi-info-circle"></i>
                                    <span>Staff chỉ có quyền xem. Vui lòng liên hệ Manager để duyệt xe.</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
