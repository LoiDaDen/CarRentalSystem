@model IEnumerable<CarRentalSystem.Models.Car>
@{ 
    ViewData["Title"] = "Quản lý Đội xe"; 
    Layout = "_AdminLayout";
}

<style>
    .fw-800 { font-weight: 800; }
    .table-car td { padding: 1rem 1.25rem; vertical-align: middle; }
    .car-avatar { width: 52px; height: 52px; border-radius: 14px; object-fit: cover; background: #f1f5f9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; }
    .status-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; margin-right: 6px; }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-3" role="alert">
        <i class="bi bi-check-circle-fill text-success"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">Quản lý Đội xe</h2>
        <p class="text-muted mb-0">Xem và quản lý tất cả phương tiện trong hệ thống.</p>
    </div>
    <a asp-area="Admin" asp-controller="Car" asp-action="Create" class="btn btn-primary shadow-sm px-4 py-2 rounded-3 fw-bold">
        <i class="bi bi-plus-lg me-2"></i>Thêm xe mới
    </a>
</div>

<!-- Bộ lọc -->
<div class="card border-0 shadow-sm rounded-4 mb-4 p-3 bg-white">
    <form method="get" asp-action="Manage" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label text-muted small fw-bold text-uppercase">Hãng xe</label>
            <select name="brandId" class="form-select border-1 fw-bold text-dark" style="border-radius: 10px;" onchange="this.form.submit()">
                <option value="">Tất cả hãng xe</option>
                @if(ViewBag.Brands != null)
                {
                    foreach(var brand in ViewBag.Brands)
                    {
                        <option value="@brand.BrandID" selected="@(ViewBag.CurrentBrandId == brand.BrandID)">@brand.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label text-muted small fw-bold text-uppercase">Khu vực / Tỉnh thành</label>
            <select name="locationId" class="form-select border-1 fw-bold text-dark" style="border-radius: 10px;" onchange="this.form.submit()">
                <option value="">Tất cả khu vực</option>
                @if(ViewBag.Locations != null)
                {
                    foreach(var loc in ViewBag.Locations)
                    {
                        <option value="@loc.LocationID" selected="@(ViewBag.CurrentLocationId == loc.LocationID)">@loc.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-4 text-end">
            @if(ViewBag.CurrentBrandId != null || ViewBag.CurrentLocationId != null)
            {
                <a asp-action="Manage" class="btn btn-light text-danger fw-bold rounded-3 px-4 py-2">
                    <i class="bi bi-x-circle me-1"></i> Bỏ lọc
                </a>
            }
        </div>
    </form>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 table-car">
            <thead style="background: #f8fafd;">
                <tr class="text-muted small text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.8px;">
                    <th class="ps-4">Phương tiện</th>
                    <th>Biển số / VIN</th>
                    <th>Loại / Nhiên liệu</th>
                    <th>Giá/Ngày</th>
                    <th>Trạng thái</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var car in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-3">
                                <div class="car-avatar">
                                    @if (car.CarImages?.Any() == true)
                                    {
                                        <img src="@car.CarImages.First().ImageUrl" alt="@car.CarName" style="width:100%;height:100%;object-fit:cover;">
                                    }
                                    else
                                    {
                                        <i class="bi bi-car-front text-primary" style="font-size:1.4rem;"></i>
                                    }
                                </div>
                                <div>
                                    <div class="fw-800 text-dark d-flex align-items-center gap-2 mb-1">
                                        <span>@car.CarBrand?.Name @car.CarName</span>
                                        @if(car.OwnerID == null)
                                        {
                                            <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25" style="font-size: 0.65rem;"><i class="bi bi-building"></i> Hệ Thống</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25" style="font-size: 0.65rem;"><i class="bi bi-person-badge"></i> Đối Tác @(car.Owner?.Name != null ? "- " + car.Owner.Name : "")</span>
                                        }
                                    </div>
                                    <small class="text-muted"><i class="bi bi-people me-1"></i>@car.Seats chỗ · @car.Transmission</small>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-white text-dark border border-2 px-3 py-1 d-block mb-1" style="font-family: monospace; border-radius: 8px; max-width: 130px;">
                                <i class="bi bi-card-text me-1 text-primary"></i>@car.LicensePlate
                            </span>
                            <span class="text-muted" style="font-size: 0.72rem; font-family: monospace;">
                                <i class="bi bi-hash me-1"></i>@(car.VIN?.Substring(0, Math.Min(8, car.VIN?.Length ?? 0)))...
                            </span>
                        </td>
                        <td>
                            <div class="fw-600 small">@car.CarType?.Name</div>
                            <small class="text-muted"><i class="bi bi-fuel-pump me-1"></i>@car.FuelType</small>
                        </td>
                        <td class="fw-800 text-primary">@car.PricePerDay.ToString("N0")<small class="fw-normal text-muted"> đ</small></td>
                        <td>
                            @{
                                var (statusBg, statusText, dotColor) = car.CarStatus?.Name switch {
                                    "Available"   => ("bg-success bg-opacity-10 text-success", "Sẵn sàng", "#10b981"),
                                    "Rented"      => ("bg-warning bg-opacity-10 text-warning", "Đang thuê", "#f59e0b"),
                                    "Maintenance" => ("bg-danger bg-opacity-10 text-danger", "Bảo trì", "#ef4444"),
                                    _             => ("bg-secondary bg-opacity-10 text-secondary", car.CarStatus?.Name ?? "Unknown", "#6b7280")
                                };
                            }
                            <span class="badge @statusBg px-3 py-2 rounded-pill fw-600" style="font-size: 0.77rem;">
                                <span class="status-dot" style="background: @dotColor;"></span>@statusText
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex gap-2 justify-content-end">
                                <a asp-area="Admin" asp-controller="Car" asp-action="Edit" asp-route-id="@car.CarID"
                                   class="btn btn-sm btn-light rounded-3 shadow-sm px-3" title="Chỉnh sửa">
                                    <i class="bi bi-pencil-square me-1"></i>Sửa
                                </a>
                                <button type="button" class="btn btn-sm btn-light text-danger rounded-3 shadow-sm px-3"
                                        data-bs-toggle="modal" data-bs-target="#deleteModal-@car.CarID" title="Xóa">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>

                    <!-- Delete Confirm Modal -->
                    <div class="modal fade" id="deleteModal-@car.CarID" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered modal-sm">
                            <div class="modal-content border-0 shadow-lg rounded-4">
                                <div class="modal-body p-4 text-center">
                                    <div class="mb-3">
                                        <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10" style="width:64px;height:64px;">
                                            <i class="bi bi-trash3-fill text-danger fs-3"></i>
                                        </span>
                                    </div>
                                    <h6 class="fw-800 mb-1">Xóa xe này?</h6>
                                    <p class="text-muted small mb-4">@car.CarBrand?.Name @car.CarName sẽ bị xóa vĩnh viễn khỏi hệ thống.</p>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-light flex-grow-1 rounded-3" data-bs-dismiss="modal">Hủy</button>
                                        <form asp-area="Admin" asp-controller="Car" asp-action="Delete" asp-route-id="@car.CarID" method="post" class="flex-grow-1">
                                            <button type="submit" class="btn btn-danger w-100 rounded-3 fw-bold">Xóa</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-car-front display-4 opacity-10 d-block mb-3"></i>
                            <p class="fw-bold opacity-50 mb-2">Chưa có xe nào trong hệ thống</p>
                            <a asp-area="Admin" asp-controller="Car" asp-action="Create" class="btn btn-primary rounded-3 px-4 btn-sm">Thêm xe đầu tiên</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
