@model CarRentalSystem.Models.Car
@{
    ViewData["Title"] = "Chỉnh sửa xe";
    Layout = "_AdminLayout";
}

<div class="theme-admin">
<style>
    .theme-admin .form-control, .theme-admin .form-select { border-radius: 12px; border: 1.5px solid var(--admin-border-color); padding: 0.75rem 1rem; font-weight: 500; transition: border-color 0.2s, box-shadow 0.2s; background: var(--admin-surface-100); color: var(--admin-text); }
    .theme-admin .form-control:focus, .theme-admin .form-select:focus { border-color: var(--admin-primary); box-shadow: 0 0 0 3px rgba(59,130,246,0.12); }
    .theme-admin .form-label { font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.6px; color: var(--admin-text-secondary); margin-bottom: 0.5rem; }
    .theme-admin .section-card { background: var(--admin-card-bg); border-radius: 20px; padding: 1.75rem; border: 1px solid var(--admin-border-color); box-shadow: var(--admin-shadow); margin-bottom: 1.5rem; }
    .theme-admin .section-title { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--admin-primary); padding-bottom: 1rem; border-bottom: 1px solid var(--admin-border-color); margin-bottom: 1.5rem; }
    .theme-admin .upload-area { border: 2px dashed var(--admin-border-color); border-radius: 16px; padding: 2rem; text-align: center; cursor: pointer; transition: all 0.3s ease; }
    .theme-admin .upload-area:hover { border-color: var(--admin-primary); background: var(--admin-primary-50); }
    .theme-admin .toggle-card { border: 1.5px solid var(--admin-border-color); border-radius: 12px; padding: 1rem 1.25rem; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: space-between; background: var(--admin-surface-100); }
    .theme-admin .toggle-card:has(input:checked) { border-color: var(--admin-primary); background: var(--admin-primary-50); }
    .theme-admin #mapPicker { height: 300px; border-radius: 12px; z-index: 1; border: 1px solid var(--admin-border-color); }
    .theme-admin .image-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .theme-admin .image-item { position: relative; border-radius: 12px; overflow: hidden; height: 100px; border: 1px solid var(--admin-border-color); }
    .theme-admin .image-item img { width: 100%; height: 100%; object-fit: cover; }
    .theme-admin .btn-delete-img { position: absolute; top: 5px; right: 5px; padding: 0.2rem 0.4rem; background: rgba(239, 68, 68, 0.9); border: none; border-radius: 6px; color: white; cursor: pointer; }
    .theme-admin .preview-container { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 10px; }
    .theme-admin .preview-item { width: 60px; height: 60px; border-radius: 8px; object-fit: cover; border: 1px solid var(--admin-border-color); }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">Chỉnh sửa: @Model.CarBrand?.Name @Model.CarName</h2>
        <p class="text-muted mb-0">Cập nhật thông tin phương tiện.</p>
    </div>
    <a asp-area="Admin" asp-controller="Car" asp-action="Manage" class="btn btn-light rounded-3 px-4 py-2 fw-bold border">
        <i class="bi bi-arrow-left me-2"></i>Quay lại
    </a>
</div>

<form asp-area="Admin" asp-controller="Car" asp-action="Edit" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
    <input type="hidden" asp-for="CarID" />
    <input type="hidden" asp-for="CreatedAt" />
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="section-card">
                <div class="section-title"><i class="bi bi-info-circle me-2"></i>Thông tin cơ bản</div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Hãng xe <span class="text-danger">*</span></label>
                        <select asp-for="BrandID" asp-items="ViewBag.Brands" class="form-select" required>
                            <option value="">-- Chọn hãng --</option>
                        </select>
                        <span asp-validation-for="BrandID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tên xe <span class="text-danger">*</span></label>
                        <input asp-for="CarName" class="form-control" required />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Loại xe <span class="text-danger">*</span></label>
                        <select asp-for="CarTypeID" asp-items="ViewBag.CarTypes" class="form-select" required>
                            <option value="">-- Chọn loại --</option>
                        </select>
                        <span asp-validation-for="CarTypeID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Số chỗ</label>
                        <input type="number" asp-for="Seats" class="form-control" min="2" max="16" />
                    </div>
                </div>
            </div>

            <div class="section-card">
                <div class="section-title"><i class="bi bi-gear me-2"></i>Thông số kỹ thuật</div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Nhiên liệu</label>
                        <select asp-for="FuelType" class="form-select">
                            <option value="Xăng" selected="@(Model.FuelType == "Xăng" ? "selected" : null)">⛽ Xăng</option>
                            <option value="Dầu" selected="@(Model.FuelType == "Dầu" ? "selected" : null)">🛢️ Dầu</option>
                            <option value="Điện" selected="@(Model.FuelType == "Điện" ? "selected" : null)">⚡ Điện</option>
                            <option value="Hybrid" selected="@(Model.FuelType == "Hybrid" ? "selected" : null)">🔋 Hybrid</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Hộp số</label>
                        <select asp-for="Transmission" class="form-select">
                            <option value="Tự động" selected="@(Model.Transmission == "Tự động" ? "selected" : null)">Số tự động</option>
                            <option value="Số sàn" selected="@(Model.Transmission == "Số sàn" ? "selected" : null)">Số sàn</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mức tiêu hao</label>
                        <div class="input-group">
                            @{ var rawFuelAd = Model.FuelConsumption?.Replace("L/100km", "")?.Replace("kWh/100km", "")?.Replace(" ", "") ?? "8.0"; }
                            <input name="FuelConsumption" id="FuelConsumption" class="form-control" placeholder="Vd: 8.0" value="@rawFuelAd" />
                            <span class="input-group-text bg-light fw-bold text-muted" id="fuelUnitLabel">L/100km</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Biển số xe</label>
                        <input asp-for="LicensePlate" class="form-control" style="font-family: monospace;" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">VIN (Số khung)</label>
                        <input asp-for="VIN" class="form-control" maxlength="17" style="font-family: monospace;" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Odometer (KM)</label>
                        <input type="number" asp-for="CurrentOdometer" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày bảo dưỡng tiếp theo</label>
                        <input type="date" asp-for="NextMaintenanceDate" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngay dang kiem tiep theo</label>
                        <input type="date" asp-for="NextInspectionDate" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="section-card">
                <div class="section-title"><i class="bi bi-text-left me-2"></i>Mô tả xe</div>
                <textarea asp-for="Description" class="form-control" rows="4"></textarea>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="section-card">
                <div class="section-title"><i class="bi bi-currency-exchange me-2"></i>Giá & Trạng thái</div>
                <div class="mb-3">
                    <label class="form-label">Giá thuê/ngày (VNĐ)</label>
                    <div class="input-group">
                        <input type="number" asp-for="PricePerDay" class="form-control" required />
                        <span class="input-group-text bg-light border fw-bold">đ</span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Gia thue/gio tu dong (VND)</label>
                    <div class="input-group">
                        <input type="number" asp-for="PricePerHour" id="PricePerHourDisplay" class="form-control" readonly />
                        <span class="input-group-text bg-light border fw-bold">d</span>
                    </div>
                    <small class="text-muted">He thong tinh bang gia ngay chia 8 gio.</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">Giá ưu đãi</label>
                    <div class="input-group">
                        <input type="number" asp-for="DiscountPrice" class="form-control" />
                        <span class="input-group-text bg-light border fw-bold">đ</span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Khu vực (Tỉnh/Thành)</label>
                    <select asp-for="LocationID" asp-items="ViewBag.Locations" class="form-select" required>
                    </select>
                </div>
                
                <div class="mb-4">
                    <label class="form-label">Vị trí giao nhận chính xác <span class="text-danger">*</span></label>
                    <div class="input-group mb-2">
                        <input type="text" asp-for="CarAddress" id="carAddressInput" class="form-control" placeholder="Tìm hoặc chọn trên bản đồ..." required readonly />
                        <button class="btn btn-outline-primary" type="button" id="btnGetCurrentLocation" title="Lấy vị trí của tôi">
                            <i class="bi bi-crosshair"></i>
                        </button>
                    </div>
                    <div id="mapPicker" class="mb-2"></div>
                    <small class="text-muted d-block mb-2">Di chuyển ghim đỏ để thay đổi vị trí bãi đỗ xe/nơi giao nhận xe.</small>
                    <input type="hidden" asp-for="Latitude" id="latInput" />
                    <input type="hidden" asp-for="Longitude" id="lngInput" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Trạng thái</label>
                    <select asp-for="CarStatusID" asp-items="ViewBag.CarStatuses" class="form-select">
                    </select>
                </div>
                <label class="toggle-card">
                    <div>
                        <div class="fw-bold small">Xe Premium</div>
                        <small class="text-muted">Hiển thị badge PREMIUM</small>
                    </div>
                    <input type="checkbox" asp-for="IsPremium" />
                </label>
            </div>

            <!-- Hình ảnh hiện tại -->
            <div class="section-card">
                <div class="section-title"><i class="bi bi-images me-2"></i>Ảnh hiện tại</div>
                @if (Model.CarImages?.Any() == true)
                {
                    <div class="image-grid" id="existingImages">
                        @foreach (var img in Model.CarImages)
                        {
                            <div class="image-item" id="img-@img.ImageID">
                                <img src="@img.ImageUrl" />
                                <button type="button" class="btn-delete-img" onclick="deleteImage(@img.ImageID)">
                                    <i class="bi bi-trash3-fill"></i>
                                </button>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted small text-center py-3">Chưa có ảnh nào.</div>
                }
            </div>
            
            <div class="section-card">
                <div class="section-title"><i class="bi bi-image me-2"></i>Thêm ảnh mới</div>
                <label class="upload-area d-block" for="imageFiles">
                    <i class="bi bi-cloud-upload fs-2 text-muted opacity-50 d-block mb-1"></i>
                    <div class="fw-bold text-muted small">Chọn thêm ảnh</div>
                    <div id="previewContainer" class="preview-container"></div>
                </label>
                <input type="file" name="imageFiles" id="imageFiles" class="d-none" accept="image/*" multiple onchange="previewImages(this)" />
            </div>

            <div class="d-flex gap-3">
                <a asp-area="Admin" asp-controller="Car" asp-action="Manage" class="btn btn-light flex-grow-1 rounded-3 py-3 fw-bold border">Hủy</a>
                <button type="submit" class="btn btn-primary flex-grow-1 rounded-3 py-3 fw-bold shadow-sm">
                    <i class="bi bi-check-lg me-2"></i>Lưu thay đổi
                </button>
            </div>
        </div>
    </div>
</form>
</div>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    function previewImages(input) {
        const container = document.getElementById('previewContainer');
        container.innerHTML = '';
        if (input.files && input.files.length > 0) {
            Array.from(input.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'preview-item';
                    container.appendChild(img);
                };
                reader.readAsDataURL(file);
            });
        }
    }

    function deleteImage(imageId) {
        if (confirm('Xóa ảnh này?')) {
            fetch('/Admin/Car/DeleteImage?id=' + imageId, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const el = document.getElementById('img-' + imageId);
                    el.remove();
                } else {
                    alert('Lỗi khi xóa ảnh.');
                }
            })
            .catch(err => alert('Lỗi kết nối.'));
        }
    }

    // --- MAP PICKER LOGIC ---
    document.addEventListener("DOMContentLoaded", function () {
        var defaultLat = @(Model.Latitude ?? 10.7769);
        var defaultLng = @(Model.Longitude ?? 106.7009);
        var initialAddress = "@(Html.Raw(Model.CarAddress ?? ""))";

        if (typeof SmartMap !== 'undefined') {
            const picker = SmartMap.initPickerMap({
                containerId: 'mapPicker',
                btnLocationId: 'btnGetCurrentLocation',
                latInputId: 'latInput',
                lngInputId: 'lngInput',
                addressInputId: 'carAddressInput',
                locationDropdownId: 'LocationID'
            });

            if (picker) {
                picker.map.setView([defaultLat, defaultLng], 14);
                picker.marker.setLatLng([defaultLat, defaultLng]);
                document.getElementById('latInput').value = defaultLat;
                document.getElementById('lngInput').value = defaultLng;
                
                if (initialAddress) {
                    document.getElementById('carAddressInput').value = initialAddress;
                } else if (defaultLat == 10.7769) {
                    // Start geo-coding if it's default
                    const fakeEvent = { latlng: { lat: defaultLat, lng: defaultLng } };
                    picker.map.fire('click', fakeEvent);
                }
            }
        }
    });

    // --- PRICE AUTO-CALC LOGIC ---
    document.addEventListener("DOMContentLoaded", function () {
        const dayInput = document.getElementById('PricePerDay');
        const hourInput = document.getElementById('PricePerHourDisplay');
        const syncHourlyPrice = function () {
            if (!dayInput || !hourInput) return;
            const dayPrice = Number(dayInput.value || 0);
            hourInput.value = dayPrice > 0 ? Math.round(dayPrice / 8) : 0;
        };
        if (dayInput) {
            dayInput.addEventListener('input', syncHourlyPrice);
            syncHourlyPrice();
        }
    });

    // --- FUEL UNIT LOGIC ---
    document.addEventListener("DOMContentLoaded", function () {
        const fuelTypeSelect = document.getElementById('FuelType');
        const fuelUnitLabel = document.getElementById('fuelUnitLabel');
        if (fuelTypeSelect && fuelUnitLabel) {
            fuelTypeSelect.addEventListener('change', function (e) {
                fuelUnitLabel.innerText = e.target.value === 'Điện' ? 'kWh/100km' : 'L/100km';
            });
            fuelTypeSelect.dispatchEvent(new Event('change'));
        }
    });
</script>
}
