@model CarRentalSystem.Models.Car
@{
    ViewData["Title"] = "Thêm Xe Mới";
    Layout = "_AdminLayout";
    var amenities = ViewBag.Amenities as IEnumerable<CarRentalSystem.Models.CarAmenity> ?? Enumerable.Empty<CarRentalSystem.Models.CarAmenity>();
    var selectedAmenityIds = ViewBag.SelectedAmenityIds as ISet<int> ?? new HashSet<int>();
    var pendingNewAmenityNames = ViewBag.PendingNewAmenityNames as IEnumerable<string> ?? Enumerable.Empty<string>();
}

<div class="theme-admin">
<style>
    .theme-admin .form-control, .theme-admin .form-select { border-radius: 12px; border: 1.5px solid var(--admin-border-color); padding: 0.75rem 1rem; font-weight: 500; transition: border-color 0.2s, box-shadow 0.2s; background: var(--admin-surface-100); color: var(--admin-text); }
    .theme-admin .form-control:focus, .theme-admin .form-select:focus { border-color: var(--admin-primary); box-shadow: 0 0 0 3px rgba(59,130,246,0.12); }
    .theme-admin .form-label { font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.6px; color: var(--admin-text-secondary); margin-bottom: 0.5rem; }
    .theme-admin .section-card { background: var(--admin-card-bg); border-radius: 20px; padding: 1.75rem; border: 1px solid var(--admin-border-color); box-shadow: var(--admin-shadow); margin-bottom: 1.5rem; }
    .theme-admin .section-title { font-size: 0.75rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1px; color: var(--admin-primary); padding-bottom: 1rem; border-bottom: 1px solid var(--admin-border-color); margin-bottom: 1.5rem; }
    .theme-admin .upload-area { border: 2px dashed var(--admin-border-color); border-radius: 16px; padding: 2rem; text-align: center; cursor: pointer; transition: all 0.3s ease; }
    .theme-admin .upload-area:hover { border-color: var(--admin-primary); background: var(--admin-primary-50); }
    .theme-admin #mapPicker { height: 300px; border-radius: 12px; z-index: 1; border: 1px solid var(--admin-border-color); }
    .theme-admin .preview-container { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 15px; }
    .theme-admin .preview-item { width: 80px; height: 80px; border-radius: 8px; object-fit: cover; border: 1px solid var(--admin-border-color); }
    .theme-admin .toggle-card { border: 1.5px solid var(--admin-border-color); border-radius: 12px; padding: 1rem 1.25rem; cursor: pointer; transition: all 0.2s; display: flex; align-items: center; justify-content: space-between; background: var(--admin-surface-100); }
    .theme-admin .toggle-card:has(input:checked) { border-color: var(--admin-primary); background: var(--admin-primary-50); }
    .theme-admin .toggle-card input { width: 20px; height: 20px; }
    .theme-admin .feature-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
    .theme-admin .feature-option { border: 1.5px solid var(--admin-border-color); border-radius: 14px; padding: 0.85rem; background: var(--admin-surface-100); cursor: pointer; display: flex; align-items: center; gap: 0.65rem; min-height: 54px; transition: all 0.2s ease; }
    .theme-admin .feature-option:hover { border-color: var(--admin-primary); transform: translateY(-1px); }
    .theme-admin .feature-option:has(input:checked) { border-color: var(--admin-primary); background: var(--admin-primary-50); box-shadow: 0 8px 18px rgba(59,130,246,0.12); }
    .theme-admin .feature-option input { width: 18px; height: 18px; flex: 0 0 auto; }
    .theme-admin .feature-option i { color: var(--admin-primary); font-size: 1.1rem; }
    .theme-admin .new-feature-row { display: flex; gap: 8px; margin-top: 10px; }
    .theme-admin .new-feature-row .btn { flex: 0 0 auto; }
</style>

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">Thêm Xe Mới</h2>
        <p class="text-muted mb-0">Điền đầy đủ thông tin để thêm phương tiện vào đội xe.</p>
    </div>
    <a asp-area="Admin" asp-controller="Car" asp-action="Manage" class="btn btn-light rounded-3 px-4 py-2 fw-bold border">
        <i class="bi bi-arrow-left me-2"></i>Quay lại
    </a>
</div>

<form asp-area="Admin" asp-controller="Car" asp-action="Create" method="post" enctype="multipart/form-data">
    <div asp-validation-summary="All" class="text-danger fw-bold mb-3"></div>
    <div class="row g-4">
        <div class="col-lg-8">
            <!-- Thông tin cơ bản -->
            <div class="section-card">
                <div class="section-title"><i class="bi bi-info-circle me-2"></i>Thông tin cơ bản</div>
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label">Loại dịch vụ <span class="text-danger">*</span></label>
                        <select asp-for="ServiceTypeID" asp-items="ViewBag.ServiceTypes" class="form-select" required>
                            <option value="">-- Chọn loại dịch vụ --</option>
                        </select>
                        <small class="text-muted">Thuê xe tự lái không bao gồm tài xế. Xe có tài xế sẽ chờ duyệt riêng trước khi hoạt động.</small>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Hãng xe <span class="text-danger">*</span></label>
                        <select asp-for="BrandID" asp-items="ViewBag.Brands" class="form-select" required>
                            <option value="">-- Chọn hãng --</option>
                        </select>
                        <span asp-validation-for="BrandID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Tên xe (Dòng xe) <span class="text-danger">*</span></label>
                        <input asp-for="CarName" class="form-control" placeholder="Vd: Camry 2.5Q, Civic RS..." required />
                        <span asp-validation-for="CarName" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Loại xe <span class="text-danger">*</span></label>
                        <select asp-for="CarTypeID" asp-items="ViewBag.CarTypes" class="form-select" required>
                            <option value="">-- Chọn loại --</option>
                        </select>
                        <span asp-validation-for="CarTypeID" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Số chỗ ngồi <span class="text-danger">*</span></label>
                        <input type="number" asp-for="Seats" class="form-control" min="2" max="16" placeholder="5" required />
                        <span asp-validation-for="Seats" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Thông số kỹ thuật -->
            <div class="section-card">
                <div class="section-title"><i class="bi bi-gear me-2"></i>Thông số kỹ thuật</div>
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label">Nhiên liệu <span class="text-danger">*</span></label>
                        <select asp-for="FuelType" class="form-select">
                            <option value="Xăng">⛽ Xăng</option>
                            <option value="Dầu">🛢️ Dầu</option>
                            <option value="Điện">⚡ Điện</option>
                            <option value="Hybrid">🔋 Hybrid</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Hộp số <span class="text-danger">*</span></label>
                        <select asp-for="Transmission" class="form-select">
                            <option value="Tự động">Số tự động</option>
                            <option value="Số sàn">Số sàn</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Mức tiêu hao</label>
                        <div class="input-group">
                            <input asp-for="FuelConsumption" id="FuelConsumption" class="form-control" placeholder="Vd: 8.0" />
                            <span class="input-group-text bg-light fw-bold text-muted" id="fuelUnitLabel">L/100km</span>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Biển số xe <span class="text-danger">*</span></label>
                        <input asp-for="LicensePlate" class="form-control" placeholder="Vd: 51A-123.45" required style="font-family: monospace;" />
                        <span asp-validation-for="LicensePlate" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">VIN (Số khung) <span class="text-danger">*</span></label>
                        <input asp-for="VIN" class="form-control" placeholder="17 ký tự" maxlength="17" required style="font-family: monospace;" />
                        <span asp-validation-for="VIN" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Odometer hiện tại (KM)</label>
                        <input type="number" asp-for="CurrentOdometer" class="form-control" placeholder="0" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày bảo dưỡng tiếp theo</label>
                        <input type="date" asp-for="NextMaintenanceDate" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Ngày đăng kiểm tiếp theo <span class="text-danger">*</span></label>
                        <input type="date" asp-for="NextInspectionDate" class="form-control" required />
                        <span asp-validation-for="NextInspectionDate" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- Mô tả -->
            <div class="section-card">
                <div class="section-title"><i class="bi bi-text-left me-2"></i>Mô tả xe</div>
                <textarea asp-for="Description" class="form-control" rows="4" placeholder="Mô tả chi tiết về xe, tính năng nổi bật, lịch sử bảo dưỡng..."></textarea>
            </div>

            <div class="section-card">
                <div class="section-title"><i class="bi bi-stars me-2"></i>Tính năng xe</div>
                <div class="feature-grid">
                    @foreach (var amenity in amenities)
                    {
                        <label class="feature-option">
                            <input type="checkbox" name="AmenityIDs" value="@amenity.CarAmenityID" checked="@selectedAmenityIds.Contains(amenity.CarAmenityID)" />
                            <i class="bi @(string.IsNullOrWhiteSpace(amenity.Icon) ? "bi-check2-circle" : amenity.Icon)"></i>
                            <span class="fw-semibold small">@amenity.Name</span>
                        </label>
                    }
                </div>
                <div class="mt-4">
                    <label class="form-label">Thêm tính năng mới</label>
                    <div id="newFeatureList">
                        @foreach (var name in pendingNewAmenityNames)
                        {
                            <div class="new-feature-row">
                                <input type="text" name="NewAmenityNames" class="form-control" value="@name" placeholder="Ví dụ: Cảm biến điểm mù" maxlength="120" />
                                <button type="button" class="btn btn-outline-danger" onclick="removeFeatureRow(this)" title="Xóa dòng">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        }
                    </div>
                    <button type="button" class="btn btn-outline-primary rounded-3 fw-bold mt-3" id="btnAddFeature">
                        <i class="bi bi-plus-lg me-1"></i>Thêm từng tính năng
                    </button>
                    <small class="text-muted d-block mt-2">Tính năng mới sẽ được lưu vào danh sách dùng chung sau khi lưu xe.</small>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Giá & Kinh doanh -->
            <div class="section-card">
                <div class="section-title"><i class="bi bi-currency-exchange me-2"></i>Giá & Kinh doanh</div>
                <div class="mb-3">
                    <label class="form-label">Giá thuê/ngày (VNĐ) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input type="number" asp-for="PricePerDay" class="form-control" placeholder="500000" required />
                        <span class="input-group-text bg-light border fw-bold">đ</span>
                    </div>
                    <span asp-validation-for="PricePerDay" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label">Giá thuê/giờ tự động (VND)</label>
                    <div class="input-group">
                        <input type="number" asp-for="PricePerHour" id="PricePerHourDisplay" class="form-control" readonly />
                        <span class="input-group-text bg-light border fw-bold">d</span>
                    </div>
                    <small class="text-muted">Hệ thống tính bằng giá ngày chia 8 giờ.</small>
                </div>
                <div class="mb-3">
                    <label class="form-label">Giá ưu đãi (nếu có)</label>
                    <div class="input-group">
                        <input type="number" asp-for="DiscountPrice" class="form-control" placeholder="Để trống nếu không có" />
                        <span class="input-group-text bg-light border fw-bold">đ</span>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Khu vực (Tỉnh/Thành)</label>
                    <select asp-for="LocationID" asp-items="ViewBag.Locations" class="form-select" required>
                    </select>
                </div>
                
                <div class="mb-4">
                    <label class="form-label">Vị trí giao nhận chính xác <span class="text-danger">*</span></label>
                    <div class="input-group mb-2">
                        <input type="text" asp-for="CarAddress" id="carAddressInput" class="form-control" placeholder="Tìm hoặc chọn trên bản đồ..." required readonly />
                        <button class="btn btn-outline-primary" type="button" id="btnGetCurrentLocation" title="Lấy vị trí của tôi">
                            <i class="bi bi-crosshair"></i>
                        </button>
                    </div>
                    <div id="mapPicker" class="mb-2"></div>
                    <small class="text-muted d-block mb-2">Di chuyển ghim đỏ để chọn vị trí chính xác bãi đỗ xe/nơi giao xe.</small>
                    <input type="hidden" asp-for="Latitude" id="latInput" />
                    <input type="hidden" asp-for="Longitude" id="lngInput" />
                </div>

                <div class="mb-3">
                    <label class="form-label">Trạng thái</label>
                    <select asp-for="CarStatusID" asp-items="ViewBag.CarStatuses" class="form-select">
                    </select>
                </div>
                <label class="toggle-card mb-3">
                    <div>
                        <div class="fw-bold small">Xe Premium</div>
                        <small class="text-muted">Hiển thị badge PREMIUM trên xe</small>
                    </div>
                    <input type="checkbox" asp-for="IsPremium" />
                </label>
            </div>

            <!-- Ảnh xe -->
            <div class="section-card">
                <div class="section-title"><i class="bi bi-image me-2"></i>Ảnh xe (Có thể chọn nhiều)</div>
                <label class="upload-area d-block" for="imageFiles">
                    <div id="uploadPrompt">
                        <i class="bi bi-cloud-upload fs-1 text-muted opacity-50 d-block mb-2"></i>
                        <div class="fw-bold text-muted">Click để chọn ảnh</div>
                        <small class="text-muted">JPG, PNG, WEBP · Chọn nhiều ảnh</small>
                    </div>
                    <div id="previewContainer" class="preview-container"></div>
                </label>
                <input type="file" name="imageFiles" id="imageFiles" class="d-none" accept="image/*" multiple onchange="previewImages(this)" />
            </div>

            <!-- Submit -->
            <div class="d-flex gap-3">
                <a asp-area="Admin" asp-controller="Car" asp-action="Manage" class="btn btn-light flex-grow-1 rounded-3 py-3 fw-bold border">Hủy</a>
                <button type="submit" class="btn btn-primary flex-grow-1 rounded-3 py-3 fw-bold shadow-sm">
                    <i class="bi bi-save me-2"></i>Lưu xe
                </button>
            </div>
        </div>
    </div>
</form>

@section Scripts {
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
    function previewImages(input) {
        const container = document.getElementById('previewContainer');
        container.innerHTML = '';
        if (input.files && input.files.length > 0) {
            document.getElementById('uploadPrompt').style.display = 'none';
            Array.from(input.files).forEach(file => {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = document.createElement('img');
                    img.src = e.target.result;
                    img.className = 'preview-item';
                    container.appendChild(img);
                };
                reader.readAsDataURL(file);
            });
        } else {
            document.getElementById('uploadPrompt').style.display = 'block';
        }
    }

    function removeFeatureRow(button) {
        button.closest('.new-feature-row')?.remove();
    }

    document.getElementById('btnAddFeature')?.addEventListener('click', function () {
        const list = document.getElementById('newFeatureList');
        const row = document.createElement('div');
        row.className = 'new-feature-row';
        row.innerHTML = `
            <input type="text" name="NewAmenityNames" class="form-control" placeholder="Ví dụ: Cảm biến điểm mù" maxlength="120" />
            <button type="button" class="btn btn-outline-danger" onclick="removeFeatureRow(this)" title="Xóa dòng">
                <i class="bi bi-x-lg"></i>
            </button>`;
        list.appendChild(row);
        row.querySelector('input')?.focus();
    });

    // --- MAP PICKER LOGIC ---
    document.addEventListener("DOMContentLoaded", function () {
        var defaultLat = 10.7769;
        var defaultLng = 106.7009;

        if (typeof SmartMap !== 'undefined') {
            const picker = SmartMap.initPickerMap({
                containerId: 'mapPicker',
                btnLocationId: 'btnGetCurrentLocation',
                latInputId: 'latInput',
                lngInputId: 'lngInput',
                addressInputId: 'carAddressInput',
                locationDropdownId: 'LocationID'
            });

            if (picker) {
                picker.map.setView([defaultLat, defaultLng], 14);
                picker.marker.setLatLng([defaultLat, defaultLng]);
                document.getElementById('latInput').value = defaultLat;
                document.getElementById('lngInput').value = defaultLng;
                
                // Trigger auto-geocode to address
                const fakeEvent = { latlng: { lat: defaultLat, lng: defaultLng } };
                picker.map.fire('click', fakeEvent);
            }
        }
    });

    // --- PRICE AUTO-CALC LOGIC ---
    document.addEventListener("DOMContentLoaded", function () {
        const dayInput = document.getElementById('PricePerDay');
        const hourInput = document.getElementById('PricePerHourDisplay');
        const syncHourlyPrice = function () {
            if (!dayInput || !hourInput) return;
            const dayPrice = Number(dayInput.value || 0);
            hourInput.value = dayPrice > 0 ? Math.round(dayPrice / 8) : 0;
        };
        if (dayInput) {
            dayInput.addEventListener('input', syncHourlyPrice);
            syncHourlyPrice();
        }
    });

    // --- FUEL UNIT LOGIC ---
    document.addEventListener("DOMContentLoaded", function () {
        const fuelTypeSelect = document.getElementById('FuelType');
        const fuelUnitLabel = document.getElementById('fuelUnitLabel');
        if (fuelTypeSelect && fuelUnitLabel) {
            fuelTypeSelect.addEventListener('change', function (e) {
                fuelUnitLabel.innerText = e.target.value === 'Điện' ? 'kWh/100km' : 'L/100km';
            });
            fuelTypeSelect.dispatchEvent(new Event('change'));
        }
    });
</script>
}
