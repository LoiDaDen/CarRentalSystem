@using System.Globalization
@model CarRentalSystem.Models.Car
@{
    ViewData["Title"] = "Chi tiết Xe";
    Layout = "_AdminLayout";
    var car = Model;
    var mappedAmenities = car.CarAmenityMappings?
        .Where(mapping => !mapping.IsDeleted && mapping.CarAmenity != null)
        .OrderBy(mapping => mapping.CarAmenity!.DisplayOrder)
        .ThenBy(mapping => mapping.CarAmenity!.Name)
        .Select(mapping => mapping.CarAmenity!)
        .ToList() ?? new List<CarRentalSystem.Models.CarAmenity>();
    var mapLatitude = car.Latitude?.ToString(CultureInfo.InvariantCulture);
    var mapLongitude = car.Longitude?.ToString(CultureInfo.InvariantCulture);
}

<div class="theme-admin">
<div class="page-admin-cardetails">
    <!-- Breadcrumb & Actions -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Car" asp-action="Manage">Đội xe</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Chi tiết</li>
                </ol>
            </nav>
            <h2 class="fw-800 ls-neg-1 mb-1">
                <i class="bi bi-car-front-fill text-primary me-2"></i>@car.CarBrand?.Name @car.CarName
            </h2>
            <p class="text-muted mb-0">Xem thông tin chi tiết và lịch sử của phương tiện</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Admin" asp-controller="Car" asp-action="Edit" asp-route-id="@car.CarID" class="btn btn-warning shadow-sm px-4 py-2 rounded-3 fw-bold">
                <i class="bi bi-pencil me-2"></i>Sửa
            </a>
            <a asp-area="Admin" asp-controller="Car" asp-action="Manage" class="btn btn-outline-secondary px-4 py-2 rounded-3 fw-bold">
                <i class="bi bi-arrow-left me-2"></i>Quay lại
            </a>
            <form asp-action="Delete" asp-route-id="@car.CarID" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc chắn muốn đưa xe này vào thùng rác?');">
                <button type="submit" class="btn btn-danger shadow-sm px-4 py-2 rounded-3 fw-bold">
                    <i class="bi bi-trash me-2"></i>Xóa
                </button>
            </form>
        </div>
    </div>

    <!-- Main Content Grid -->
    <div class="row g-4">
        <!-- Left Column: Images & Map -->
        <div class="col-lg-8">
            <!-- Image Carousel -->
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
                <div class="card-header bg-white border-0 py-3 px-4">
                    <h5 class="fw-700 mb-0"><i class="bi bi-images me-2"></i>Hình ảnh</h5>
                </div>
                <div class="card-body p-0">
                    @if(car.CarImages != null && car.CarImages.Any())
                    {
                        <div id="carImagesCarousel" class="carousel slide" data-bs-ride="carousel">
                            <div class="carousel-inner">
                                @for(int i = 0; i < car.CarImages.Count; i++)
                                {
                                    var img = car.CarImages.ElementAt(i);
                                    <div class="carousel-item @(i == 0 ? "active" : "")">
                                        <img src="@img.ImageUrl" class="d-block w-100" style="max-height: 500px; object-fit: contain;" alt="@car.CarName">
                                    </div>
                                }
                            </div>
                            @if(car.CarImages.Count > 1)
                            {
                                <button class="carousel-control-prev" type="button" data-bs-target="#carImagesCarousel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon bg-dark bg-opacity-25 rounded-circle p-3" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>
                                <button class="carousel-control-next" type="button" data-bs-target="#carImagesCarousel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon bg-dark bg-opacity-25 rounded-circle p-3" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-5 bg-light">
                            <i class="bi bi-car-front text-muted" style="font-size: 4rem;"></i>
                            <p class="text-muted mt-2 mb-0">Chưa có hình ảnh</p>
                        </div>
                    }
                </div>
            </div>

            <!-- Map Location -->
            @if(car.Latitude.HasValue && car.Longitude.HasValue)
            {
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                    <div class="card-header bg-white border-0 py-3 px-4">
                        <h5 class="fw-700 mb-0"><i class="bi bi-geo-alt me-2"></i>Vị trí</h5>
                    </div>
                    <div class="card-body p-0">
                        <div id="map" style="height: 300px; width: 100%;"></div>
                        @if(!string.IsNullOrEmpty(car.CarAddress))
                        {
                            <div class="p-3 bg-light border-top">
                                <small class="text-muted"><i class="bi bi-geo-alt-fill me-1"></i>@car.CarAddress</small>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Right Column: Details -->
        <div class="col-lg-4">
            <!-- Vehicle Info Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body">
                    <h5 class="fw-700 mb-3"><i class="bi bi-info-circle me-2"></i>Thông tin cơ bản</h5>

                    <div class="mb-3">
                        <label class="text-muted small fw-bold text-uppercase mb-1">Biển số</label>
                        <div class="fw-600">@car.LicensePlate</div>
                    </div>

                    <div class="mb-3">
                        <label class="text-muted small fw-bold text-uppercase mb-1">VIN</label>
                        <div class="fw-600">@car.VIN</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="text-muted small fw-bold text-uppercase mb-1">Hãng xe</label>
                            <div>@car.CarBrand?.Name</div>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small fw-bold text-uppercase mb-1">Loại xe</label>
                            <div>@car.CarType?.Name</div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="text-muted small fw-bold text-uppercase mb-1">Số chỗ</label>
                            <div><i class="bi bi-people me-1"></i>@car.Seats</div>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small fw-bold text-uppercase mb-1">Hộp số</label>
                            <div>@car.Transmission</div>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="text-muted small fw-bold text-uppercase mb-1">Nhiên liệu</label>
                            <div>@car.FuelType</div>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small fw-bold text-uppercase mb-1">Trạng thái</label>
                            <div>
                                <span class="badge @(car.CarStatus?.Name == "Available" ? "bg-success" : car.CarStatus?.Name == "Booked" ? "bg-warning" : "bg-secondary")">
                                    @car.CarStatus?.Name
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Pricing Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body">
                    <h5 class="fw-700 mb-3"><i class="bi bi-cash me-2"></i>Giá thuê</h5>

                    <div class="row mb-2">
                        <div class="col-6">
                            <label class="text-muted small">Giá/ngày</label>
                            <div class="fw-700 text-primary fs-5">@string.Format("{0:N0}", car.PricePerDay)đ</div>
                        </div>
                        <div class="col-6">
                            <label class="text-muted small">Giá/giờ</label>
                            <div class="fw-700 text-primary fs-5">@string.Format("{0:N0}", car.PricePerHour)đ</div>
                        </div>
                    </div>

                    @if(car.DiscountPrice.HasValue)
                    {
                        <div class="alert alert-warning py-2 mt-2">
                            <i class="bi bi-tag-fill me-1"></i>
                            <strong>Giảm giá:</strong> @string.Format("{0:N0}", car.DiscountPrice)đ/ngày
                        </div>
                    }
                </div>
            </div>

            <!-- Stats Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body">
                    <h5 class="fw-700 mb-3"><i class="bi bi-bar-chart me-2"></i>Thống kê</h5>

                    <div class="row text-center">
                        <div class="col-6 mb-3">
                            <div class="bg-light rounded-3 p-3">
                                <div class="fs-4 fw-800 text-primary">@ViewBag.TotalBookings</div>
                                <small class="text-muted">Tổng đặt xe</small>
                            </div>
                        </div>
                        <div class="col-6 mb-3">
                            <div class="bg-light rounded-3 p-3">
                                <div class="fs-4 fw-800 text-success">@ViewBag.ActiveBookings</div>
                                <small class="text-muted">Đang hoạt động</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional Info Row -->
    <div class="row g-4 mt-2">
        <!-- Description -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <h5 class="fw-700 mb-3"><i class="bi bi-file-text me-2"></i>Mô tả</h5>
                    <p class="mb-0">@(string.IsNullOrEmpty(car.Description) ? "Chưa có mô tả" : car.Description)</p>
                </div>
            </div>
        </div>

        <!-- Features -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body">
                    <h5 class="fw-700 mb-3"><i class="bi bi-list-check me-2"></i>Tính năng</h5>
                    @if (mappedAmenities.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var amenity in mappedAmenities)
                            {
                                <span class="badge rounded-pill bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-3 py-2">
                                    <i class="bi @(string.IsNullOrWhiteSpace(amenity.Icon) ? "bi-check2-circle" : amenity.Icon) me-1"></i>@amenity.Name
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="mb-0">@(string.IsNullOrEmpty(car.Features) ? "Chưa có thông tin" : car.Features)</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            @if(car.Latitude.HasValue && car.Longitude.HasValue)
            {
                <text>
                SmartMap.initStaticMap('map', @mapLatitude, @mapLongitude, @Html.Raw(System.Text.Json.JsonSerializer.Serialize($"{car.CarBrand?.Name} {car.CarName}".Trim())));
                </text>
            }
        });
    </script>
}
