@model IEnumerable<CarRentalSystem.Models.Review>
@{
    ViewData["Title"] = "Kiểm duyệt Đánh giá";
    Layout = "_AdminLayout";
}

<div class="theme-admin">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="page-header mb-4">
        <div>
            <h2 class="fw-800 ls-neg-1 mb-1">
                <i class="bi bi-star me-2" style="color: var(--admin-warning);"></i>Quản lý Đánh Giá
            </h2>
            <p class="text-muted mb-0">Kiểm duyệt các phản hồi từ khách hàng về chất lượng xe.</p>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="small text-uppercase fw-bold" style="color: var(--admin-text-secondary);">
                        <th class="ps-4">Khách hàng / Xe</th>
                        <th class="text-center">Chất lượng</th>
                        <th style="max-width: 350px;">Nội dung</th>
                        <th class="text-center">Trạng thái</th>
                        <th>Thời gian</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold mb-1">@r.User?.Name</div>
                                <div class="small">
                                    <span class="badge bg-light border">
                                        <i class="bi bi-car-front-fill me-1" style="color: var(--admin-primary);"></i>@r.Car?.CarName
                                    </span>
                                </div>
                            </td>
                            <td class="text-center">
                                <div class="d-inline-flex gap-1" title="@r.Rating sao">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <i class="bi bi-star-fill" style="color: @(i <= r.Rating ? "var(--admin-warning)" : "var(--admin-text-muted)"); font-size: 1.1rem;"></i>
                                    }
                                </div>
                            </td>
                            <td style="max-width: 350px;">
                                <div class="small" style="word-wrap: break-word;">@r.Comment</div>
                            </td>
                            <td class="text-center">
                                @if (r.IsApproved)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-2 fw-bold" style="font-size: 0.77rem;">Đã duyệt</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fw-bold" style="font-size: 0.77rem;">Chờ duyệt</span>
                                }
                            </td>
                            <td class="small text-muted">
                                @r.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <form asp-action="ToggleApproval" asp-route-id="@r.ReviewID" method="post" class="m-0">
                                        <button type="submit" class="btn btn-sm @(r.IsApproved ? "btn-outline-warning" : "btn-success") rounded-3" title="@(r.IsApproved ? "Bỏ duyệt" : "Duyệt hiển thị")">
                                            <i class="bi @(r.IsApproved ? "bi-shield-lock" : "bi-check-circle-fill")"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-outline-danger btn-sm rounded-3" data-bs-toggle="modal" data-bs-target="#deleteModal-@r.ReviewID" title="Xóa đánh giá vi phạm">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>

                                <!-- Delete Modal -->
                                <div class="modal fade text-start" id="deleteModal-@r.ReviewID" tabindex="-1">
                                    <div class="modal-dialog modal-dialog-centered modal-sm">
                                        <div class="modal-content border-0 shadow-lg rounded-4 text-center p-4">
                                            <div class="mb-3">
                                                <span class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 60px; height: 60px; background: var(--admin-danger-100);">
                                                    <i class="bi bi-shield-x" style="color: var(--admin-danger); font-size: 1.5rem;"></i>
                                                </span>
                                            </div>
                                            <h6 class="fw-bold mb-2">Xóa đánh giá này?</h6>
                                            <p class="text-muted small mb-4">Chỉ nên xóa nếu đánh giá chứa từ ngữ vi phạm, spam hoặc sai sự thật.</p>
                                            <div class="d-flex gap-2">
                                                <button type="button" class="btn btn-outline-secondary flex-grow-1 rounded-3 fw-bold" data-bs-dismiss="modal">Hủy</button>
                                                <form asp-action="Delete" asp-route-id="@r.ReviewID" method="post" class="flex-grow-1">
                                                    <button type="submit" class="btn btn-danger w-100 rounded-3 fw-bold">Xóa</button>
                                                </form>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5">
                                <div class="empty-state">
                                    <i class="bi bi-chat-square-text display-4 opacity-10 d-block mb-3"></i>
                                    <p class="fw-bold opacity-50 mb-0">Chưa có đánh giá nào hệ thống</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
