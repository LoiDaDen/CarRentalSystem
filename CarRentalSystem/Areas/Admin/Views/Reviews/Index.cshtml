@model IEnumerable<CarRentalSystem.Models.Review>
@{
    ViewData["Title"] = "Kiểm duyệt Đánh giá";
    Layout = "_AdminLayout";
}

<style>
    .fw-800 { font-weight: 800; }
    .table-review td { padding: 1.25rem 1.25rem; vertical-align: middle; }
    .star-rating i { color: #e4e5e9; font-size: 1.1rem; }
    .star-rating i.active { color: #ffc107; }
</style>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-3">
        <i class="bi bi-check-circle-fill text-success"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h2 class="fw-800 mb-1" style="letter-spacing: -1px;">Quản lý Đánh Giá</h2>
        <p class="text-muted mb-0">Kiểm duyệt các phản hồi từ khách hàng về chất lượng xe.</p>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
        <table class="table align-middle mb-0 table-review">
            <thead style="background: #f8fafd;">
                <tr class="text-muted small text-uppercase fw-bold" style="font-size: 0.72rem; letter-spacing: 0.8px;">
                    <th class="ps-4">Khách hàng / Xe</th>
                    <th class="text-center">Chất lượng</th>
                    <th style="max-width: 350px;">Nội dung</th>
                    <th class="text-center">Trạng thái</th>
                    <th>Thời gian</th>
                    <th class="text-end pe-4">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-dark mb-1">@r.User?.Name</div>
                            <div class="small">
                                <span class="badge bg-light text-dark border"><i class="bi bi-car-front-fill me-1 text-primary"></i>@r.Car?.CarName</span>
                            </div>
                        </td>
                        <td class="text-center">
                            <div class="star-rating d-inline-flex gap-1" title="@r.Rating sao">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <i class="bi bi-star-fill @(i <= r.Rating ? "active" : "")"></i>
                                }
                            </div>
                        </td>
                        <td style="max-width: 350px;">
                            <div class="text-dark small lh-base" style="word-wrap: break-word;">
                                "@r.Comment"
                            </div>
                        </td>
                        <td class="text-center">
                            @if (r.IsApproved)
                            {
                                <span class="badge bg-success bg-opacity-15 text-success rounded-pill px-3 py-2 fw-bold" style="font-size:0.77rem;">Đã duyệt</span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-15 text-warning rounded-pill px-3 py-2 fw-bold" style="font-size:0.77rem;">Chờ duyệt</span>
                            }
                        </td>
                        <td class="small text-muted">
                            @r.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">
                                <form asp-action="ToggleApproval" asp-route-id="@r.ReviewID" method="post" class="m-0">
                                    <button type="submit" class="btn btn-sm @(r.IsApproved ? "btn-light text-warning" : "btn-success text-white") rounded-3 shadow-sm px-2" title="@(r.IsApproved ? "Bỏ duyệt" : "Duyệt hiển thị")">
                                        <i class="bi @(r.IsApproved ? "bi-shield-lock" : "bi-check-circle-fill")"></i>
                                    </button>
                                </form>
                                <button type="button" class="btn btn-sm btn-light text-danger rounded-3 shadow-sm px-2" data-bs-toggle="modal" data-bs-target="#deleteModal-@r.ReviewID" title="Xóa đánh giá vi phạm">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>

                            <!-- Delete Modal -->
                            <div class="modal fade text-start" id="deleteModal-@r.ReviewID" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered modal-sm">
                                    <div class="modal-content border-0 shadow-lg rounded-4 text-center p-4">
                                        <div class="mb-3">
                                            <span class="d-inline-flex align-items-center justify-content-center rounded-circle bg-danger bg-opacity-10" style="width:60px;height:60px;">
                                                <i class="bi bi-shield-x text-danger fs-3"></i>
                                            </span>
                                        </div>
                                        <h6 class="fw-800 mb-2">Xóa đánh giá này?</h6>
                                        <p class="text-muted small mb-4">Chỉ nên xóa nếu đánh giá chứa từ ngữ vi phạm, spam hoặc sai sự thật.</p>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-light flex-grow-1 rounded-3 fw-bold" data-bs-dismiss="modal">Hủy</button>
                                            <form asp-action="Delete" asp-route-id="@r.ReviewID" method="post" class="flex-grow-1">
                                                <button type="submit" class="btn btn-danger w-100 rounded-3 fw-bold">Xóa</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-chat-square-text display-4 opacity-10 d-block mb-3"></i>
                            <p class="fw-bold opacity-50 mb-0">Chưa có đánh giá nào hệ thống</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
