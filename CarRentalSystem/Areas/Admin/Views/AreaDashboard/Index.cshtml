@* CarRentalSystem/Areas/Admin/Views/AreaDashboard/Index.cshtml *@
@model List<CarRentalSystem.Areas.Admin.Controllers.AreaDashboardStats>
@{
    ViewData["Title"] = "Bảng điều khiển Khu vực";
    Layout = "_AdminLayout";

    var totalCars = Model.Sum(s => s.TotalCars);
    var totalAvail = Model.Sum(s => s.AvailableCars);
    var totalOrders = Model.Sum(s => s.MonthlyOrders);
    var totalRevenue = Model.Sum(s => s.MonthlyRevenue);
    var myAreaCount = Model.Count;
}

<div class="theme-admin">
<style>
    .theme-admin .area-card {
        border: 1.5px solid var(--admin-border-color);
        border-radius: 20px;
        transition: transform 0.2s, box-shadow 0.2s;
        overflow: hidden;
        background: var(--admin-card-bg);
    }
    .theme-admin .area-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 24px rgba(0,0,0,0.15);
    }
    .theme-admin .area-card-header {
        padding: 1.25rem 1.5rem;
        background: var(--admin-surface-200);
        border-bottom: 1px solid var(--admin-border-color);
    }
    .theme-admin .stat-badge {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }
    .theme-admin .stat-badge.blue { background: var(--admin-primary-50); color: var(--admin-primary); }
    .theme-admin .stat-badge.green { background: var(--admin-success-50); color: var(--admin-success); }
    .theme-admin .stat-badge.orange { background: var(--admin-warning-50); color: var(--admin-warning); }
    .theme-admin .stat-badge.purple { background: var(--admin-purple-50); color: var(--admin-purple); }
    .theme-admin .util-bar {
        height: 6px;
        border-radius: 3px;
        background: var(--admin-surface-200);
        overflow: hidden;
    }
    .theme-admin .util-bar-fill {
        height: 100%;
        border-radius: 3px;
        background: linear-gradient(90deg, var(--admin-primary), var(--admin-primary-500));
        transition: width 0.6s ease;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">
            <i class="bi bi-grid-3x3-gap-fill text-primary me-2"></i>Bảng điều khiển Khu vực
        </h2>
        <p class="text-muted mb-0">Tổng quan hoạt động các khu vực bạn quản lý.</p>
    </div>
    <div>
        <a asp-area="Admin" asp-controller="Area" asp-action="Index" class="btn btn-outline-primary rounded-3 fw-bold px-4">
            <i class="bi bi-list-ul me-2"></i>Danh sách Khu vực
        </a>
    </div>
</div>

<!-- Flash -->
@if (TempData["Info"] != null)
{
    <div class="alert alert-info border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-2">
        <i class="bi bi-info-circle-fill"></i>
        <span>@TempData["Info"]</span>
    </div>
}

<!-- Overview Stats -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 text-center" style="background: linear-gradient(135deg, #eff6ff, #fff);">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                <i class="bi bi-geo-alt-fill text-primary fs-5"></i>
                <h3 class="fw-800 text-primary mb-0">@myAreaCount</h3>
            </div>
            <small class="text-muted fw-bold text-uppercase" style="font-size:0.65rem; letter-spacing:0.8px;">Khu vực</small>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 text-center" style="background: linear-gradient(135deg, #dbeafe, #fff);">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                <i class="bi bi-car-front-fill text-info fs-5"></i>
                <h3 class="fw-800 text-info mb-0">@totalCars</h3>
            </div>
            <small class="text-muted fw-bold text-uppercase" style="font-size:0.65rem; letter-spacing:0.8px;">Tổng xe</small>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 text-center" style="background: linear-gradient(135deg, #fff7ed, #fff);">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                <i class="bi bi-receipt-cutoff text-warning fs-5"></i>
                <h3 class="fw-800 text-warning mb-0">@totalOrders</h3>
            </div>
            <small class="text-muted fw-bold text-uppercase" style="font-size:0.65rem; letter-spacing:0.8px;">Đơn / Tháng</small>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm rounded-4 p-3 text-center" style="background: linear-gradient(135deg, #f5f3ff, #fff);">
            <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                <i class="bi bi-currency-dollar text-purple fs-5" style="color:#7c3aed;"></i>
                <h3 class="fw-800 mb-0" style="color:#7c3aed; font-size:1.5rem;">@totalRevenue.ToString("N0")</h3>
            </div>
            <small class="text-muted fw-bold text-uppercase" style="font-size:0.65rem; letter-spacing:0.8px;">GMV Completed tháng</small>
        </div>
    </div>
</div>

<!-- Area Cards -->
@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-geo-alt fs-1 text-muted opacity-50 d-block mb-3"></i>
        <span class="text-muted">Chưa có khu vực nào được gán.</span>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var stat in Model)
        {
            var area = stat.Area;
            var utilPercent = stat.TotalCars > 0
                ? Math.Round((decimal)(stat.TotalCars - stat.AvailableCars) / stat.TotalCars * 100, 0)
                : 0;

            <div class="col-md-6 col-xl-4">
                <div class="area-card">
                    <!-- Header -->
                    <div class="area-card-header d-flex justify-content-between align-items-start">
                        <div class="d-flex align-items-center gap-3">
                            <div class="stat-badge @(area.Status == "active" ? "green" : "orange")">
                                <i class="bi @(area.Status == "active" ? "bi-check-circle-fill" : "bi-pause-circle-fill")"></i>
                            </div>
                            <div>
                                <h5 class="fw-bold mb-0" style="font-size: 1rem;">@area.Name</h5>
                                <span class="badge bg-dark rounded-3 px-2 py-1" style="font-size:0.68rem; font-family:monospace;">@area.Code</span>
                            </div>
                        </div>
                        @if (stat.IsAreaManager)
                        {
                            <span class="badge bg-danger rounded-pill px-3 py-1" style="font-size:0.68rem;">
                                <i class="bi bi-star-fill me-1"></i>Manager
                            </span>
                        }
                    </div>

                    <!-- Body -->
                    <div class="card-body p-3">
                        <!-- Mini stats row -->
                        <div class="row g-2 text-center mb-3">
                            <div class="col-4">
                                <div class="fw-bold text-dark" style="font-size:1.1rem;">@stat.TotalCars</div>
                                <small class="text-muted" style="font-size:0.68rem;">Tổng xe</small>
                            </div>
                            <div class="col-4">
                                <div class="fw-bold text-success" style="font-size:1.1rem;">@stat.AvailableCars</div>
                                <small class="text-muted" style="font-size:0.68rem;">Sẵn sàng</small>
                            </div>
                            <div class="col-4">
                                <div class="fw-bold text-warning" style="font-size:1.1rem;">@stat.MonthlyOrders</div>
                                <small class="text-muted" style="font-size:0.68rem;">Đơn/tháng</small>
                            </div>
                        </div>

                        <!-- Utilization -->
                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <small class="text-muted fw-bold text-uppercase" style="font-size:0.65rem; letter-spacing:0.5px;">Tỷ lệ sử dụng</small>
                                <small class="fw-bold text-primary">@utilPercent%</small>
                            </div>
                            <div class="util-bar">
                                <div class="util-bar-fill" style="width: @utilPercent%;"></div>
                            </div>
                        </div>

                        <!-- Completed-booking GMV -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <small class="text-muted">GMV Completed tháng</small>
                            <span class="fw-bold text-success">@stat.MonthlyRevenue.ToString("N0") ₫</span>
                        </div>

                        <!-- Info row -->
                        <div class="row g-2 small text-muted mb-3">
                            <div class="col-6">
                                <i class="bi bi-geo-alt me-1"></i>@stat.TotalLocations địa điểm
                            </div>
                            <div class="col-6">
                                <i class="bi bi-people me-1"></i>@stat.TotalStaffs nhân sự
                            </div>
                        </div>

                        <div class="row g-2 small mb-3">
                            <div class="col-6">
                                <span class="badge bg-success-subtle text-success border border-success-subtle w-100 py-2">
                                    <i class="bi bi-p-circle me-1"></i>@stat.VehiclesInside xe trong bãi
                                </span>
                            </div>
                            <div class="col-6">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle w-100 py-2">
                                    <i class="bi bi-camera-video me-1"></i>@stat.CameraEventsToday event
                                </span>
                            </div>
                            <div class="col-4">
                                <span class="badge bg-warning-subtle text-warning border border-warning-subtle w-100">@stat.UnknownPlateToday unknown</span>
                            </div>
                            <div class="col-4">
                                <span class="badge bg-info-subtle text-info border border-info-subtle w-100">@stat.LowConfidenceToday low</span>
                            </div>
                            <div class="col-4">
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle w-100">@stat.AreaMismatchToday mismatch</span>
                            </div>
                        </div>
                    </div>

                    <!-- Footer -->
                    <div class="card-footer border-0 bg-white rounded-bottom-4 p-3">
                        <div class="d-flex gap-2">
                            <a asp-area="Admin" asp-controller="Area" asp-action="Show" asp-route-id="@area.AreaID"
                               class="btn btn-primary btn-sm rounded-3 fw-bold flex-grow-1">
                                <i class="bi bi-graph-up me-1"></i>Chi tiết
                            </a>
                            @if (stat.IsAreaManager)
                            {
                                <a asp-area="Admin" asp-controller="Camera" asp-action="Index" asp-route-areaId="@area.AreaID"
                                   class="btn btn-outline-primary btn-sm rounded-3 fw-bold">
                                    <i class="bi bi-camera-video"></i>
                                </a>
                                <a asp-area="Admin" asp-controller="Area" asp-action="Edit" asp-route-id="@area.AreaID"
                                   class="btn btn-warning btn-sm rounded-3 text-dark fw-bold">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
</div>
