@model CarRentalSystem.Models.Driver
@{
    ViewData["Title"] = "Chỉnh sửa Tài xế";
    Layout = "_AdminLayout";
}

<div class="theme-admin">
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-pencil-square me-2"></i>Chỉnh sửa Tài xế</h4>
        <p class="text-muted mb-0 small">Cập nhật thông tin tài xế trong hệ thống</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.DriverID" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Họ tên <span class="text-danger">*</span></label>
                            <input type="text" name="FullName" value="@Model.FullName" class="form-control form-control-lg bg-light" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Số điện thoại</label>
                            <input type="text" name="Phone" value="@Model.Phone" class="form-control form-control-lg bg-light" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Email</label>
                            <input type="email" name="Email" value="@Model.Email" class="form-control form-control-lg bg-light" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Loại bằng lái</label>
                            <select name="LicenseType" class="form-select form-select-lg bg-light">
                                <option value="B1" selected="@(Model.LicenseType == "B1")">B1</option>
                                <option value="B2" selected="@(Model.LicenseType == "B2")">B2</option>
                                <option value="C" selected="@(Model.LicenseType == "C")">C</option>
                                <option value="D" selected="@(Model.LicenseType == "D")">D</option>
                                <option value="E" selected="@(Model.LicenseType == "E")">E</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Kinh nghiệm (năm)</label>
                            <input type="number" name="ExperienceYears" value="@Model.ExperienceYears" min="0" max="50" class="form-control form-control-lg bg-light" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Giá/ngày (₫)</label>
                            <input type="number" name="DailyRate" value="@Model.DailyRate" min="0" step="1000" class="form-control form-control-lg bg-light" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Giá/giờ (₫)</label>
                            <input type="number" name="HourlyRate" value="@Model.HourlyRate" min="0" step="1000" class="form-control form-control-lg bg-light" />
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold text-muted">Khu vực</label>
                            <select name="LocationID" class="form-select form-select-lg bg-light">
                                <option value="">— Chọn khu vực —</option>
                                @foreach (var loc in (List<CarRentalSystem.Models.Location>)ViewBag.Locations)
                                {
                                    <option value="@loc.LocationID" selected="@(loc.LocationID == Model.LocationID)">@loc.Name</option>
                                }
                            </select>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-success rounded-pill px-5 fw-bold" id="saveBtn">
                            <i class="bi bi-check-lg me-2"></i>Lưu thay đổi
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 p-4">
                <h6 class="fw-bold mb-0"><i class="bi bi-info-circle text-primary me-2"></i>Thông tin hệ thống</h6>
            </div>
            <div class="card-body p-4">
                <div class="mb-3">
                    <span class="text-muted small">Trạng thái tài xế</span>
                    <div class="mt-1">
                        @if (Model.IsLocked)
                        {
                            <span class="badge bg-danger rounded-pill px-3 py-2"><i class="bi bi-lock-fill me-1"></i>Đã khóa</span>
                        }
                        else if (!Model.IsApproved)
                        {
                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>
                        }
                        else if (Model.IsAvailable)
                        {
                            <span class="badge bg-success rounded-pill px-3 py-2"><i class="bi bi-check-circle me-1"></i>Sẵn sàng</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="bi bi-pause-circle me-1"></i>Tạm nghỉ</span>
                        }
                    </div>
                </div>
                <div class="mb-3">
                    <span class="text-muted small">Đánh giá</span>
                    <div class="fw-bold fs-5">@Model.Rating.ToString("N1") <span class="text-warning"><i class="bi bi-star-fill"></i></span></div>
                </div>
                <div class="mb-3">
                    <span class="text-muted small">Tổng chuyến</span>
                    <div class="fw-bold">@Model.TotalTrips</div>
                </div>
                <div class="mb-3">
                    <span class="text-muted small">Ngày đăng ký</span>
                    <div class="fw-bold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                @if (Model.LockedAt.HasValue)
                {
                    <div class="mb-3">
                        <span class="text-muted small">Bị khóa lúc</span>
                        <div class="fw-bold text-danger">@Model.LockedAt.Value.ToString("dd/MM/yyyy HH:mm")</div>
                    </div>
                }
                @if (Model.User != null)
                {
                    <hr />
                    <div class="mb-3">
                        <span class="text-muted small">Tài khoản liên kết</span>
                        <div class="fw-bold">@Model.User.Email</div>
                        <div class="small text-muted">@Model.User.Role</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
