@model CarRentalSystem.Models.Driver
@{
    ViewData["Title"] = "Chi tiết Tài xế - " + Model.FullName;
}

<div class="theme-admin">
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted mb-2 d-block small">
            <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
        </a>
        <h4 class="fw-bold mb-0"><i class="bi bi-person-badge me-2"></i>@Model.FullName</h4>
    </div>
    <div class="d-flex gap-2">
        @if (!Model.IsApproved)
        {
            <form asp-action="Approve" asp-route-id="@Model.DriverID" method="post">
                <button type="submit" class="btn btn-success"><i class="bi bi-check-lg me-1"></i>Duyệt</button>
            </form>
            <form asp-action="Reject" asp-route-id="@Model.DriverID" method="post">
                <button type="submit" class="btn btn-danger"><i class="bi bi-x-lg me-1"></i>Từ chối</button>
            </form>
        }
    </div>
</div>

<div class="row g-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body text-center p-4">
                @if (!string.IsNullOrEmpty(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl" alt="@Model.FullName" class="rounded-circle object-fit-cover mx-auto mb-3 d-block" style="width: 96px; height: 96px; border: 4px solid rgba(59,130,246,.15);">
                }
                else
                {
                    <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-3" style="width: 96px; height: 96px;">
                        <i class="bi bi-person-fill text-primary display-5"></i>
                    </div>
                }
                <h5 class="fw-bold">@Model.FullName</h5>
                <p class="text-muted mb-3">@(Model.Location?.Name ?? "Chưa chọn khu vực")</p>

                @if (Model.IsApproved)
                {
                    <span class="badge bg-success rounded-pill px-4 py-2 mb-3">
                        <i class="bi bi-check-circle me-1"></i>Đã duyệt
                    </span>
                }
                else
                {
                    <span class="badge bg-warning text-dark rounded-pill px-4 py-2 mb-3">
                        <i class="bi bi-hourglass-split me-1"></i>Chờ duyệt
                    </span>
                }

                <div class="d-flex justify-content-around mt-3 pt-3 border-top">
                    <div class="text-center">
                        <div class="display-6 fw-bold text-warning">@Model.Rating.ToString("N1")</div>
                        <small class="text-muted">Đánh giá</small>
                    </div>
                    <div class="text-center">
                        <div class="display-6 fw-bold text-primary">@Model.TotalTrips</div>
                        <small class="text-muted">Chuyến đi</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>Thông tin chi tiết</h6>
                <div class="row g-3">
                    <div class="col-6">
                        <small class="text-muted d-block">Họ tên</small>
                        <span class="fw-bold">@Model.FullName</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Số điện thoại</small>
                        <span class="fw-bold">@Model.Phone</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Email</small>
                        <span class="fw-bold">@(Model.Email ?? "—")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Loại bằng lái</small>
                        <span class="badge bg-info bg-opacity-10 text-info">@Model.LicenseType</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Kinh nghiệm</small>
                        <span class="fw-bold">@Model.ExperienceYears năm</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Giá / giờ</small>
                        <span class="fw-bold text-success">@(Model.HourlyRate > 0 ? Model.HourlyRate.ToString("N0") + " đ" : "Chưa cập nhật")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Giá / ngày</small>
                        <span class="fw-bold text-success">@(Model.DailyRate > 0 ? Model.DailyRate.ToString("N0") + " đ" : "Chưa cập nhật")</span>
                    </div>
                    <div class="col-6">
                        <small class="text-muted d-block">Ngày đăng ký</small>
                        <span class="fw-bold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <div class="col-12">
                            <small class="text-muted d-block">Giới thiệu</small>
                            <p class="mb-0">@Model.Description</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</div>
