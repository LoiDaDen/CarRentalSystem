<div class="theme-admin">
@model IEnumerable<CarRentalSystem.Models.DigitalContract>
@{ ViewData["Title"] = "Quản lý Hợp đồng số"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-file-earmark-medical-fill me-2 text-primary"></i>Quản lý Hợp Đồng Số</h2>
        <p class="text-muted">Kiểm soát và lưu trữ hợp đồng thuê xe điện tử.</p>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Mã HĐ</th>
                        <th>Khách thuê</th>
                        <th>Loại HĐ</th>
                        <th>Xe thuê</th>
                        <th>Ngày lập</th>
                        <th>Giá trị</th>
                        <th>Trạng thái Ký</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có hợp đồng nào.</td>
                        </tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-dark">@item.ContractNo</td>
                            <td>
                                <div class="fw-bold">@item.CustomerName</div>
                                <div class="small text-muted">CMND/CCCD: @item.CustomerIdentityCard</div>
                            </td>
                            <td>
                                @if(item.Booking != null && item.Booking.ContractType != null) {
                                    <span class="badge bg-info bg-opacity-10 text-info fw-bold border border-info border-opacity-25">@item.Booking.ContractType.Name</span>
                                } else {
                                    <span class="text-muted small">Cơ bản</span>
                                }
                            </td>
                            <td>
                                <div>@item.CarModel</div>
                                <div class="small fw-bold border border-secondary px-1 d-inline-block rounded-1">@item.CarLicensePlate</div>
                            </td>
                            <td>@item.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="fw-bold text-success">@item.TotalContractValue.ToString("N0") đ</td>
                            <td>
                                @if(item.IsSignedByCustomer) {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success px-2 py-1"><i class="bi bi-pencil-square me-1"></i>Đã ký</span>
                                } else {
                                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning px-2 py-1"><i class="bi bi-clock me-1"></i>Chờ khách ký</span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@item.DigitalContractID" class="btn btn-sm btn-outline-primary rounded-pill px-3">Chi tiết</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>
