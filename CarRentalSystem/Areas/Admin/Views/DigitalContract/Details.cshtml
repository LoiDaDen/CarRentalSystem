@model CarRentalSystem.Models.DigitalContract
@{ ViewData["Title"] = "Chi tiết Hợp đồng Điện tử"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }

@section Styles {
    <style>
        @@media print {
            /* Hide the sidebar, top navbar, buttons, and the reference info column */
            .admin-sidebar, .d-none.d-md-flex, .btn, button, a, .col-lg-4, #chatbot-widget {
                display: none !important;
            }
            /* Make the main content area white and full width */
            body, main {
                background: white !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .col-lg-8 {
                width: 100% !important;
            }
            /* Remove card shadows and borders for cleaner print */
            .card {
                border: none !important;
                box-shadow: none !important;
            }
            .card-body {
                padding: 0 !important;
            }
        }
    </style>
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1"><i class="bi bi-file-earmark-medical-fill me-2 text-primary"></i>Chi Tiết Hợp Đồng #@Model.ContractNo</h2>
        <a asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
    </div>
    <div>
        <button class="btn btn-outline-dark rounded-pill" onclick="window.print()"><i class="bi bi-printer me-2"></i>In Hợp đồng</button>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-5">
                    <h5 class="fw-bold mb-1">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</h5>
                    <h6 class="fw-bold text-decoration-underline mb-3">Độc Lập – Tự Do – Hạnh Phúc</h6>
                    <div class="mb-4">----------oOo----------</div>
                    <h3 class="fw-bold mb-2">HỢP ĐỒNG THUÊ XE</h3>
                    <p class="mb-1">Số: @Model.BookingID - @Model.ContractNo / HĐTX</p>
                    <p class="small font-italic">Hôm nay, ngày @Model.CreatedAt.ToString("dd") tháng @Model.CreatedAt.ToString("MM") năm @Model.CreatedAt.ToString("yyyy"), chúng tôi gồm:</p>
                </div>

                <div class="row mb-5">
                    <div class="col-6">
                        <h6 class="fw-bold text-primary mb-3 border-bottom pb-2">BÊN A (SmartRental VN)</h6>
                        <p class="mb-1 text-muted small">Đại diện tự động từ Hệ thống.</p>
                    </div>
                    <div class="col-6">
                        <h6 class="fw-bold text-primary mb-3 border-bottom pb-2">BÊN B (Khách thuê)</h6>
                        <p class="mb-1"><span class="text-muted small">Họ tên:</span> fw-bold>@Model.CustomerName</span></p>
                        <p class="mb-1"><span class="text-muted small">CCCD:</span> fw-bold>@Model.CustomerIdentityCard</span></p>
                        <p class="mb-1"><span class="text-muted small">Điện thoại:</span> @Model.CustomerPhone</p>
                        <p class="mb-1"><span class="text-muted small">Địa chỉ:</span> @Model.CustomerAddress</p>
                    </div>
                </div>

                <h6 class="fw-bold mb-3"><i class="bi bi-car-front me-2"></i>Nội dung thuê</h6>
                <div class="bg-light p-3 rounded-3 mb-4">
                    <div class="row g-2">
                        <div class="col-6"><span class="text-muted small">Kiểu xe:</span> <strong>@Model.CarModel</strong></div>
                        <div class="col-6"><span class="text-muted small">Biển số:</span> <strong>@Model.CarLicensePlate</strong></div>
                        <div class="col-6"><span class="text-muted small">Ngày nhận:</span> <strong>@Model.RentalStartDate.ToString("dd/MM/yyyy HH:mm")</strong></div>
                        <div class="col-6"><span class="text-muted small">Ngày trả:</span> <strong>@Model.RentalEndDate.ToString("dd/MM/yyyy HH:mm")</strong></div>
                    </div>
                </div>

                <h6 class="fw-bold mb-3"><i class="bi bi-cash-stack me-2"></i>Tài chính</h6>
                <div class="bg-light p-3 rounded-3 mb-4">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Đơn giá thuê (ngày):</span>
                        <strong>@Model.RentalPricePerDay.ToString("N0") VNĐ</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-muted small">Tiền cọc:</span>
                        <strong>@Model.DepositAmount.ToString("N0") VNĐ</strong>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="fw-bold">Tổng Giá Trị:</span>
                        <h5 class="fw-bold text-success mb-0">@Model.TotalContractValue.ToString("N0") VNĐ</h5>
                    </div>
                </div>

                <div class="row text-center mt-5">
                    <div class="col-6">
                        <h6 class="fw-bold mb-3">Chữ ký Bên A</h6>
                        @if(Model.IsSignedByOwner) {
                            <div class="text-success mb-2"><i class="bi bi-check-circle-fill fs-1"></i></div>
                            <span class="badge bg-success px-3 py-2">Đã xác nhận tự động</span><br>
                            <small class="text-muted mt-2 d-inline-block">@Model.OwnerSignDate?.ToString("dd/MM/yyyy HH:mm")</small>
                        } else {
                            <span class="badge bg-secondary px-3 py-2">Chưa xác nhận</span>
                        }
                    </div>
                    <div class="col-6 border-start">
                        <h6 class="fw-bold mb-3">Chữ ký Bên B</h6>
                        @if(Model.IsSignedByCustomer) {
                            <div class="text-primary mb-2"><i class="bi bi-check-circle-fill fs-1"></i></div>
                            <span class="badge bg-primary px-3 py-2">Khách đã ký</span><br>
                            <small class="text-muted mt-2 d-inline-block">@Model.CustomerSignDate?.ToString("dd/MM/yyyy HH:mm")</small>
                        } else {
                            <span class="badge bg-warning text-dark px-3 py-2">Chờ khách ký</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <!-- Sidebar Info mapping to Booking -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body">
                <h6 class="fw-bold mb-3">Thông tin Tham chiếu</h6>
                <div class="mb-3">
                    <label class="text-muted small">Mã lệnh đặt xe (BookingID)</label>
                    <div class="d-flex align-items-center justify-content-between">
                        <span class="fw-bold fs-5">#@Model.BookingID</span>
                        <a asp-controller="Booking" asp-action="Manage" class="btn btn-sm btn-light rounded-pill">Đến Booking <i class="bi bi-box-arrow-up-right"></i></a>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="text-muted small">Ngày lập hợp đồng</label>
                    <div class="fw-bold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                </div>
                <div class="alert alert-info border-0 p-3 rounded-3 small mb-0">
                    <i class="bi bi-info-circle-fill me-2"></i>Hợp đồng này có giá trị pháp lý tương đương bản giấy theo quy định số hóa trên hệ thống SmartRental.
                </div>
            </div>
        </div>
    </div>
</div>
