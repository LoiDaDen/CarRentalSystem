@model IEnumerable<CarRentalSystem.Models.Payment>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Lịch sử Giao dịch";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Lịch sử Giao dịch & Biến động Tiền</h2>
    <div class="text-muted small">Tất cả các nỗ lực thanh toán từ khách hàng</div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light text-muted small fw-bold">
                    <tr>
                        <th class="ps-4 py-3">NGÀY GIỜ</th>
                        <th class="py-3">KHÁCH HÀNG / ĐƠN HÀNG</th>
                        <th class="py-3 text-center">PHƯƠNG THỨC</th>
                        <th class="py-3 text-end">SỐ TIỀN</th>
                        <th class="py-3 text-center">TRẠNG THÁI</th>
                        <th class="py-3 pe-4 text-center">THAO TÁC</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold">@payment.PaymentDate.ToString("HH:mm")</div>
                                <small class="text-muted">@payment.PaymentDate.ToString("dd/MM/yyyy")</small>
                            </td>
                            <td>
                                <div class="fw-bold">@payment.Booking?.User?.Name</div>
                                <small class="text-muted">Đơn #@payment.BookingID - @payment.Booking?.Car?.CarBrand?.Name @payment.Booking?.Car?.CarName</small>
                            </td>
                            <td class="text-center">
                                @if (payment.PaymentMethod == "PayOS")
                                {
                                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary border-opacity-25 px-2">PayOS</span>
                                }
                                else
                                {
                                    <span class="badge bg-info bg-opacity-10 text-info border border-info border-opacity-25 px-2">@payment.PaymentMethod</span>
                                }
                            </td>
                            <td class="text-end fw-bold text-success">
                                @payment.Amount.ToString("N0") đ
                            </td>
                            <td class="text-center">
                                @{
                                    var badgeClass = payment.PaymentStatus switch {
                                        "Paid" => "bg-success",
                                        "Pending" => "bg-warning text-dark",
                                        "Failed" => "bg-danger",
                                        _ => "bg-secondary"
                                    };
                                }
                                <span class="badge @badgeClass rounded-pill px-3">@payment.PaymentStatus</span>
                            </td>
                            <td class="text-center pe-4">
                                @if (payment.PaymentStatus == "Pending")
                                {
                                    <form asp-area="Admin" asp-controller="Payment" asp-action="ConfirmPayment" method="post" onsubmit="return confirm('Xác nhận đã nhận được thanh toán này?');" class="d-inline">
                                        <input type="hidden" name="id" value="@payment.PaymentID" />
                                        <button type="submit" class="btn btn-sm btn-success rounded-pill">
                                            <i class="bi bi-check-circle me-1"></i>Xác nhận
                                        </button>
                                    </form>
                                }
                                <a href="/Admin/Booking/Details/@payment.BookingID" class="btn btn-sm btn-outline-dark rounded-pill">
                                    Xem đơn
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-wallet2 display-3 text-muted opacity-25"></i>
        <p class="text-muted mt-3">Chưa có dữ liệu giao dịch nào.</p>
    </div>
}
