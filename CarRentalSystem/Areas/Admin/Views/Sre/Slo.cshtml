@model CarRentalSystem.Services.SloDashboard
@{
    ViewData["Title"] = "SLO Dashboard";
}

<h2>SLO Dashboard</h2>
<p class="text-muted">Window: @Model.WindowStartUtc.ToString("u") - @Model.WindowEndUtc.ToString("u")</p>
<p><strong>Error budget remaining:</strong> @Model.ErrorBudgetRemainingPercent.ToString("N2")%</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Metric</th>
            <th>Value</th>
            <th>Target</th>
            <th>Status</th>
            <th>Description</th>
        </tr>
    </thead>
    <tbody>
    @foreach (var metric in Model.Metrics)
    {
        <tr>
            <td>@metric.Name</td>
            <td>@(metric.Value.HasValue ? $"{metric.Value:N2} {metric.Unit}" : "Unknown")</td>
            <td>@metric.Target.ToString("N2") @metric.Unit</td>
            <td>@metric.Status</td>
            <td>@metric.Description</td>
        </tr>
    }
    </tbody>
</table>
