<div class="theme-admin">
@{
    ViewData["Title"] = "Trung tâm Theo dõi Toàn cầu";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">Phòng Điều hành Đội xe</h2>
        <p class="text-muted mb-0"><i class="bi bi-broadcast text-danger pulse me-2"></i>Hệ thống đang giám sát trực tiếp</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary shadow-sm rounded-3 px-4" id="btnSimulate">
            <i class="bi bi-play-circle-fill me-2"></i>Mô phỏng di chuyển
        </button>
        <button class="btn btn-white border shadow-sm rounded-3">
            <i class="bi bi-funnel me-2"></i>Bộ lọc
        </button>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-9">
        <div class="card border-0 shadow-lg overflow-hidden rounded-4" style="height: 650px;">
            <div id="map" style="height: 100%; width: 100%;" class="bg-light"></div>
        </div>
    </div>
    <div class="col-lg-3">
        <h6 class="fw-800 text-uppercase ls-1 small mb-4 opacity-50">Tài sản đang hoạt động</h6>
        <div class="d-flex flex-column gap-3" id="asset-list">
            <div class="card border-0 shadow-sm p-3 bg-white border-start border-4 border-success rounded-3 transition-all hover-translate-x">
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-800 small text-dark">Toyota Vios G</span>
                    <span class="badge bg-success bg-opacity-10 text-success fw-bold p-1 px-2" style="font-size: 0.65rem;">Sẵn sàng</span>
                </div>
                <div class="small text-muted mb-3 d-flex align-items-center">
                    <i class="bi bi-speedometer2 me-2 text-primary"></i> 45 km/h
                    <span class="mx-2 opacity-25">|</span>
                    <i class="bi bi-battery-full me-1 text-success"></i> 85%
                </div>
                <div class="progress" style="height: 5px; border-radius: 10px;">
                    <div class="progress-bar bg-success" style="width: 85%;"></div>
                </div>
            </div>
            
            <div class="card border-0 shadow-sm p-3 bg-white border-start border-4 border-warning rounded-3 transition-all hover-translate-x">
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-800 small text-dark">Honda City RS</span>
                    <span class="badge bg-warning bg-opacity-10 text-warning fw-bold p-1 px-2" style="font-size: 0.65rem;">Nghỉ</span>
                </div>
                <div class="small text-muted mb-3 d-flex align-items-center">
                    <i class="bi bi-speedometer2 me-2 text-muted"></i> 0 km/h
                    <span class="mx-2 opacity-25">|</span>
                    <i class="bi bi-battery-half me-1 text-warning"></i> 40%
                </div>
                <div class="progress" style="height: 5px; border-radius: 10px;">
                    <div class="progress-bar bg-warning" style="width: 40%;"></div>
                </div>
            </div>

            <div class="card border-0 shadow-sm p-3 bg-white border-start border-4 border-primary rounded-3 transition-all hover-translate-x">
                <div class="d-flex justify-content-between mb-2">
                    <span class="fw-800 small text-dark">Ford Raptor</span>
                    <span class="badge bg-primary bg-opacity-10 text-primary fw-bold p-1 px-2" style="font-size: 0.65rem;">Di chuyển</span>
                </div>
                <div class="small text-muted mb-3 d-flex align-items-center">
                    <i class="bi bi-speedometer2 me-2 text-danger"></i> 92 km/h
                    <span class="mx-2 opacity-25">|</span>
                    <i class="bi bi-battery me-1 text-danger"></i> 12%
                </div>
                <div class="progress" style="height: 5px; border-radius: 10px;">
                    <div class="progress-bar bg-primary" style="width: 65%;"></div>
                </div>
            </div>
        </div>

        <div class="alert bg-white shadow-sm border-0 mt-4 rounded-4 p-4">
            <h6 class="fw-800 small mb-2"><i class="bi bi-info-circle-fill me-2 text-primary"></i> Ghi chú GPS</h6>
            <p class="small text-muted mb-0 lh-base">Vị trí được cập nhật mỗi 30 giây để tối ưu hóa thời lượng pin cho thiết bị phát tín hiệu.</p>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .pulse { animation: pulse-animation 2s infinite; }
        @@keyframes pulse-animation {
            0% { transform: scale(0.95); opacity: 0.5; }
            50% { transform: scale(1.05); opacity: 1; }
            100% { transform: scale(0.95); opacity: 0.5; }
        }
        .hover-translate-x:hover { transform: translateX(8px); }
        .transition-all { transition: all 0.3s ease; }
    </style>
}

@section Scripts {
    <script>
        let map;
        let markers = {};
        
        function initMap() {
            const baseMap = SmartMap.createMap('map', 10.762622, 106.660172, 13, { zoomControl: false });
            if (!baseMap) return;
            map = baseMap.map;
            L.control.zoom({ position: 'topright' }).addTo(map);
            updateLocations();
            setInterval(updateLocations, 5000);
        }

        async function updateLocations() {
            try {
                const response = await fetch('/Admin/Tracking/GetLiveLocations');
                const data = await response.json();
                
                data.forEach(car => {
                    const pos = [car.lat, car.lng];
                    if (markers[car.name]) {
                        markers[car.name].setLatLng(pos);
                    } else {
                        const color = car.status === 'Moving' ? '#2563eb' : '#f59e0b';
                        const marker = L.circleMarker(pos, {
                            radius: 9,
                            color: '#fff',
                            weight: 3,
                            fillColor: color,
                            fillOpacity: .95
                        }).addTo(map).bindPopup(`<strong>${car.name}</strong><br>${car.status}`);
                        markers[car.name] = marker;
                    }
                });
            } catch (e) { console.error("Telemetry failed", e); }
        }

        document.getElementById('btnSimulate').addEventListener('click', () => {
             updateLocations();
            alert("Luồng dữ liệu hành trình theo thời gian thực đã được kích hoạt.");
        });

        initMap();
    </script>
}
</div>
