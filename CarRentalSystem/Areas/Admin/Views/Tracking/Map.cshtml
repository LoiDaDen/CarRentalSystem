<div class="theme-admin">
@{
    ViewData["Title"] = "Vehicle Tracking Map";
}

<h2 class="mb-4">Theo dõi xe trực tiếp</h2>

<div class="row">
    <div class="col-md-9">
        <div class="card shadow-sm h-100">
            <div class="card-body p-0">
                <div id="map" style="height: 600px; width: 100%; border-radius: 4px;"></div>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white">
                <h5 class="mb-0">Theo dõi xe</h5>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label">Chọn mã xe</label>
                    <input type="number" id="carIdInput" class="form-control" placeholder="Nhập mã xe..." />
                </div>
                <button id="trackBtn" class="btn btn-primary w-100 mb-4">Tập trung vào xe</button>
                
                <h6 class="border-bottom pb-2">Nhật ký trạng thái</h6>
                <div id="statusLog" class="small text-muted" style="max-height: 350px; overflow-y: auto;">
                    <div>Hệ thống đang hoạt động. Đang giám sát đội xe...</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let map;
        let carMarker;

        function initMap() {
            const baseMap = SmartMap.createMap('map', 10.762622, 106.660172, 12);
            if (baseMap) map = baseMap.map;
        }

        $(document).ready(function() {
            initMap();
            $('#trackBtn').click(function() {
                var carId = $('#carIdInput').val();
                if (!carId || !map) return;

                $.get('/Admin/Tracking/GetCarLocation?carId=' + carId, function(data) {
                    if (data) {
                        const pos = [data.latitude, data.longitude];
                        
                        if (!carMarker) {
                            carMarker = L.marker(pos, { icon: SmartMap.getCarIcon() })
                                .addTo(map)
                                .bindPopup('Xe #' + carId)
                                .openPopup();
                        } else {
                            carMarker.setLatLng(pos);
                        }
                        
                        map.setView(pos, 15);
                        
                        $('#statusLog').prepend('<div class="mb-2">[' + new Date().toLocaleTimeString() + '] Xe #' + carId + ' ở tọa độ ' + data.latitude.toFixed(4) + ', ' + data.longitude.toFixed(4) + ' di chuyển với tốc độ ' + data.speed + ' km/h.</div>');
                    } else {
                        $('#statusLog').prepend('<div class="text-danger mb-2">[' + new Date().toLocaleTimeString() + '] Không có dữ liệu tracking cho xe #' + carId + '.</div>');
                    }
                });
            });
            
            // Auto update simulation every 10 seconds
            setInterval(function() {
                if ($('#carIdInput').val()) {
                     $('#trackBtn').click();
                }
            }, 10000);
        });
    </script>
}
</div>
