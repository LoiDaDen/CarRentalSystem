@* CarRentalSystem/Areas/Admin/Views/AreaManager/AllAreas.cshtml *@
@model IEnumerable<CarRentalSystem.Areas.Admin.Controllers.AreaManagerViewModel>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Quản lý Nhân sự Khu vực";

    var currentUserId = int.TryParse(
        User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        ?? User.FindFirst("sub")?.Value ?? User.FindFirst("UserID")?.Value,
        out var uid) ? uid : 0;

    string StatusBadge(string status) => status == "active"
        ? "<span class='badge bg-success rounded-pill px-3'><i class='bi bi-check-circle-fill me-1'></i>Đang hoạt động</span>"
        : "<span class='badge bg-danger rounded-pill px-3'><i class='bi bi-x-circle-fill me-1'></i>Tạm ngưng</span>";
}

<div class="theme-admin">
<!-- Page Header -->
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">
            <i class="bi bi-people-fill text-primary me-2"></i>Quản lý Nhân sự Khu vực
        </h2>
        <p class="text-muted mb-0">Chọn khu vực để xem và phân công nhân sự.</p>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     STEP 1: CHỌN KHU VỰC
══════════════════════════════════════════════════════════ -->
<div class="row g-4 mb-4" id="areaGrid">
    @if (!Model.Any())
    {
        <div class="col-12">
            <div class="alert alert-info border-0 rounded-4">
                <i class="bi bi-info-circle me-2"></i>Chưa có khu vực nào.
            </div>
        </div>
    }
    else
    {
        foreach (var area in Model)
        {
            <div class="col-md-6 col-xl-4">
                <div class="card border-0 shadow-sm rounded-4 h-100 area-card"
                     style="cursor:pointer; transition: all 0.2s;"
                     onclick='loadAreaDetail(@area.AreaID, @Json.Serialize(area.Name))'
                     id="area-card-@area.AreaID">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <h5 class="fw-bold mb-1">@area.Name</h5>
                                <span class="badge bg-dark rounded-3" style="font-size:0.7rem;">@area.Code</span>
                            </div>
                            @Html.Raw(StatusBadge(area.Status))
                        </div>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-pin-map me-1"></i>@area.Province
                        </p>
                        <div class="row g-2 text-center">
                            <div class="col-4">
                                <div class="bg-primary bg-opacity-10 rounded-3 py-2">
                                    <div class="fw-bold text-primary">@area.StaffCount</div>
                                    <small class="text-muted text-uppercase" style="font-size:0.6rem;">Nhân sự</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-success bg-opacity-10 rounded-3 py-2">
                                    <div class="fw-bold text-success">@area.LocationCount</div>
                                    <small class="text-muted text-uppercase" style="font-size:0.6rem;">Địa điểm</small>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="bg-warning bg-opacity-10 rounded-3 py-2">
                                    <div class="fw-bold text-warning">@(string.IsNullOrEmpty(area.ManagerName) ? "—" : "1")</div>
                                    <small class="text-muted text-uppercase" style="font-size:0.6rem;">Manager</small>
                                </div>
                            </div>
                        </div>
                        @if (!string.IsNullOrEmpty(area.ManagerName))
                        {
                            <div class="mt-3 text-center">
                                <small class="text-muted">
                                    <i class="bi bi-person-fill me-1"></i>@area.ManagerName
                                </small>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    }
</div>

<!-- ══════════════════════════════════════════════════════════
     STEP 2: CHI TIẾT KHU VỰC + NHÂN SỰ (AJAX)
══════════════════════════════════════════════════════════ -->
<div id="areaDetailSection" style="display:none;">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb small mb-1">
                    <li class="breadcrumb-item"><a href="#" onclick="hideAreaDetail(); return false;" class="text-decoration-none text-muted">Khu vực</a></li>
                    <li class="breadcrumb-item text-primary fw-bold" id="detailBreadcrumb">—</li>
                </ol>
            </nav>
            <h4 class="fw-bold mb-0" id="detailAreaName">—</h4>
        </div>
        <button class="btn btn-outline-secondary rounded-3" onclick="hideAreaDetail()">
            <i class="bi bi-arrow-left me-2"></i>Quay lại danh sách
        </button>
    </div>

    <!-- Stats -->
    <div class="row g-3 mb-4" id="detailStats"></div>

    <!-- Tabs: Nhân sự + Địa điểm -->
    <ul class="nav nav-tabs mb-3" id="detailTabs">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#tab-staffs-detail">
                <i class="bi bi-people-fill me-1"></i>Nhân sự
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#tab-locations-detail">
                <i class="bi bi-geo-alt-fill me-1"></i>Địa điểm
            </a>
        </li>
    </ul>

    <div class="tab-content">
        <!-- Tab: Nhân sự -->
        <div class="tab-pane fade show active" id="tab-staffs-detail">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-list-ul me-2 text-primary"></i>Danh sách nhân sự</h5>
                    <button class="btn btn-primary rounded-3 fw-bold btn-sm" onclick="openAddStaffModal()">
                        <i class="bi bi-person-plus me-2"></i>Thêm nhân sự
                    </button>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4 py-3 fw-bold text-muted text-uppercase small">#</th>
                                    <th class="py-3 fw-bold text-muted text-uppercase small">Nhân sự</th>
                                    <th class="py-3 fw-bold text-muted text-uppercase small">Vai trò HT</th>
                                    <th class="py-3 fw-bold text-muted text-uppercase small">Vai trò KV</th>
                                    <th class="py-3 fw-bold text-muted text-uppercase small">Ngày gán</th>
                                    <th class="py-3 fw-bold text-muted text-uppercase small text-end px-4">Thao tác</th>
                                </tr>
                            </thead>
                            <tbody id="staffTableBody">
                                <tr><td colspan="6" class="text-center py-4 text-muted"><i class="bi bi-hourglass-split me-2"></i>Đang tải...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tab: Địa điểm -->
        <div class="tab-pane fade" id="tab-locations-detail">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-geo-alt-fill me-2 text-primary"></i>Danh sách địa điểm</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th class="px-4 py-3 fw-bold text-muted text-uppercase small">Địa điểm</th>
                                    <th class="py-3 fw-bold text-muted text-uppercase small">Địa chỉ</th>
                                </tr>
                            </thead>
                            <tbody id="locationTableBody">
                                <tr><td colspan="2" class="text-center py-4 text-muted"><i class="bi bi-hourglass-split me-2"></i>Đang tải...</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     MODAL: THÊM NHÂN SỰ
══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="addStaffModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom bg-primary bg-opacity-10">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-person-plus text-primary me-2"></i>Thêm nhân sự vào khu vực
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small text-uppercase">
                        Khu vực <span class="text-danger">*</span>
                    </label>
                    <select id="addStaff_areaSelect" class="form-select rounded-3" onchange="loadAvailableUsers()">
                        @foreach (var area in Model)
                        {
                            <option value="@area.AreaID">@area.Name — @area.Province</option>
                        }
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small text-uppercase">
                        Chọn nhân sự <span class="text-danger">*</span>
                    </label>
                    <select name="UserID" id="addStaff_userSelect" class="form-select rounded-3" required>
                        <option value="">— Chọn nhân sự —</option>
                    </select>
                    <div class="form-text">Chỉ hiển thị user có vai trò Manager/Staff/Viewer chưa thuộc khu vực này.</div>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold text-muted small text-uppercase">
                        Vai trò trong khu vực <span class="text-danger">*</span>
                    </label>
                    <select name="RoleInArea" id="addStaff_roleSelect" class="form-select rounded-3" required>
                        <option value="viewer" selected>Viewer — Chỉ xem thống kê</option>
                        <option value="staff">Staff — Quản lý xe & đơn hàng</option>
                        <option value="manager">Manager — Quản lý toàn khu vực</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-3 px-4 fw-bold" onclick="submitAddStaff()">
                    <i class="bi bi-plus-lg me-2"></i>Thêm vào khu vực
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     MODAL: ĐỔI VAI TRÒ
══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="changeRoleModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom bg-primary bg-opacity-10">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-arrow-repeat text-primary me-2"></i>Đổi vai trò
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">
                    Chọn vai trò mới cho <strong id="roleModal_userName">—</strong>:
                </p>
                <input type="hidden" id="roleModal_staffId" />
                <div class="d-flex flex-column gap-2">
                    @foreach (var r in new[] {
                        ("viewer", "Viewer", "bg-secondary", "bi-eye", "Chỉ xem thống kê"),
                        ("staff", "Staff", "bg-warning text-dark", "bi-person-badge", "Quản lý xe & đơn hàng"),
                        ("manager", "Manager KV", "bg-danger", "bi-shield-check", "Quản lý toàn khu vực")
                    })
                    {
                        <label class="p-3 rounded-3 border role-option"
                               style="cursor:pointer;"
                               onclick="selectRoleOption(this, '@r.Item1')">
                            <input type="radio" name="NewRole" value="@r.Item1"
                                   id="role_@r.Item1"
                                   @(r.Item1 == "viewer" ? "checked" : "") />
                            <span class="badge @r.Item3 me-2">@r.Item1</span>
                            <strong>@r.Item2</strong>
                            <small class="text-muted ms-2">— @r.Item5</small>
                        </label>
                    }
                </div>
            </div>
            <div class="modal-footer border-top">
                <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-primary rounded-3 px-4 fw-bold" onclick="submitChangeRole()">
                    <i class="bi bi-check-lg me-2"></i>Xác nhận
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════════
     MODAL: GỠ NHÂN SỰ
══════════════════════════════════════════════════════════ -->
<div class="modal fade" id="removeStaffModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom bg-danger bg-opacity-10">
                <h5 class="modal-title fw-bold text-danger">
                    <i class="bi bi-exclamation-triangle me-2"></i>Xác nhận gỡ
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div class="mb-3">
                    <i class="bi bi-person-dash text-danger" style="font-size: 3rem;"></i>
                </div>
                <p class="mb-1">Bạn có chắc muốn gỡ <strong id="remove_userName">—</strong> khỏi khu vực này?</p>
                <p class="text-muted small mb-0">Hành động này có thể hoàn tác.</p>
                <input type="hidden" id="remove_staffId" />
            </div>
            <div class="modal-footer border-top justify-content-center">
                <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger rounded-3 px-4 fw-bold" onclick="submitRemoveStaff()">
                    <i class="bi bi-person-dash me-2"></i>Gỡ khỏi KV
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── State ────────────────────────────────────────────
        let currentAreaId = null;
        let currentAreaName = '';
        let currentAreaManagerId = null;

        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, ch => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            }[ch]));
        }

        function escapeJsString(value) {
            return String(value ?? '').replace(/[\\']/g, '\\$&').replace(/\r?\n/g, ' ');
        }

        // ── Chọn khu vực → load chi tiết ────────────────────
        async function loadAreaDetail(areaId, areaName) {
            currentAreaId = areaId;
            currentAreaName = areaName;

            // Highlight card
            document.querySelectorAll('.area-card').forEach(c => {
                c.classList.remove('border-primary', 'shadow');
                c.style.transform = '';
            });
            const card = document.getElementById('area-card-' + areaId);
            if (card) {
                card.classList.add('border-primary', 'shadow');
                card.style.transform = 'scale(1.02)';
            }

            // Show detail section
            document.getElementById('areaGrid').style.display = 'none';
            document.getElementById('areaDetailSection').style.display = 'block';
            document.getElementById('detailBreadcrumb').textContent = areaName;
            document.getElementById('detailAreaName').textContent = areaName;

            // Reset tabs
            const tabTrigger = new bootstrap.Tab(document.querySelector('#detailTabs .nav-link'));
            tabTrigger.show();

            await Promise.all([loadStaffTable(areaId), loadLocationTable(areaId), loadAreaStats(areaId)]);
        }

        function hideAreaDetail() {
            currentAreaId = null;
            currentAreaName = '';
            document.getElementById('areaDetailSection').style.display = 'none';
            document.getElementById('areaGrid').style.display = '';
            document.querySelectorAll('.area-card').forEach(c => {
                c.classList.remove('border-primary', 'shadow');
                c.style.transform = '';
            });
        }

        // ── Load Area Stats ──────────────────────────────────
        async function loadAreaStats(areaId) {
            try {
                const resp = await fetch(`/admin/areamanager/areasummary?id=${areaId}`);
                if (!resp.ok) return;
                const stats = await resp.json();
                const isActive = stats.status === 'active';
                document.getElementById('detailStats').innerHTML = `
                    <div class="col-md-3 col-6">
                        <div class="card border-0 shadow-sm rounded-4 text-center py-3" style="background:linear-gradient(135deg,#eff6ff,#dbeafe);">
                            <div class="text-primary mb-1"><i class="bi bi-people-fill fs-4"></i></div>
                            <h3 class="mb-0 fw-bolder text-primary">${stats.staffCount ?? 0}</h3>
                            <small class="text-muted fw-bold">Nhân sự</small>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="card border-0 shadow-sm rounded-4 text-center py-3" style="background:linear-gradient(135deg,#ecfdf5,#d1fae5);">
                            <div class="text-success mb-1"><i class="bi bi-geo-alt-fill fs-4"></i></div>
                            <h3 class="mb-0 fw-bolder text-success">${stats.locationCount ?? 0}</h3>
                            <small class="text-muted fw-bold">Địa điểm</small>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="card border-0 shadow-sm rounded-4 text-center py-3" style="background:linear-gradient(135deg,#fffbeb,#fef3c7);">
                            <div class="text-warning mb-1"><i class="bi bi-car-front-fill fs-4"></i></div>
                            <h3 class="mb-0 fw-bolder text-warning">${stats.totalCars ?? 0}</h3>
                            <small class="text-muted fw-bold">Tổng xe</small>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="card border-0 shadow-sm rounded-4 text-center py-3" style="background:linear-gradient(135deg,#f5f3ff,#ede9fe);">
                            <div class="text-success mb-1"><i class="bi bi-check-circle-fill fs-4"></i></div>
                            <h3 class="mb-0 fw-bolder" style="color:#7c3aed;">${stats.availableCars ?? 0}</h3>
                            <small class="text-muted fw-bold">Xe sẵn sàng</small>
                        </div>
                    </div>
                `;
                currentAreaManagerId = stats.managerId;
            } catch (e) {
                document.getElementById('detailStats').innerHTML = '';
            }
        }

        // ── Load Staff Table ──────────────────────────────────
        async function loadStaffTable(areaId) {
            const tbody = document.getElementById('staffTableBody');
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted"><i class="bi bi-hourglass-split me-2"></i>Đang tải...</td></tr>';

            try {
                const resp = await fetch(`/admin/areamanager/areadetail?id=${areaId}`);
                if (!resp.ok) { tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Lỗi tải dữ liệu.</td></tr>'; return; }

                const html = await resp.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const rows = doc.querySelectorAll('#staffTableBody tr');

                if (rows.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-5 text-muted"><i class="bi bi-people fs-1 d-block mb-2 opacity-50"></i>Chưa có nhân sự nào.</td></tr>';
                    return;
                }

                tbody.innerHTML = '';
                rows.forEach((row, idx) => {
                    const staffIdCell = row.querySelector('[onclick*="openRoleModal"]');
                    const staffId = staffIdCell ? parseInt(staffIdCell.getAttribute('onclick').match(/\d+/)[0]) : 0;
                    const cells = row.querySelectorAll('td');

                    // Extract data
                    const nameCell = row.querySelector('td:nth-child(2)');
                    const name = nameCell ? nameCell.textContent.trim() : '?';
                    const emailCell = row.querySelector('td:nth-child(2) small');
                    const email = emailCell ? emailCell.textContent.trim() : '';
                    const escapedName = escapeHtml(name);
                    const escapedEmail = escapeHtml(email);
                    const jsName = escapeHtml(escapeJsString(name));

                    // Re-build row with action buttons
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                        <td class="px-4 py-3 text-muted fw-bold">${idx + 1}</td>
                        <td class="py-3">
                            <div class="d-flex align-items-center gap-3">
                                <img src="https://ui-avatars.com/api/?name=${encodeURIComponent(name)}&background=0D8ABC&color=fff&size=40"
                                     alt="${escapedName}" class="rounded-circle shadow-sm" width="40" height="40">
                                <div>
                                    <div class="fw-bold">${escapedName}</div>
                                    <small class="text-muted">${escapedEmail}</small>
                                </div>
                            </div>
                        </td>
                        <td class="py-3">${cells[2] ? cells[2].innerHTML : '—'}</td>
                        <td class="py-3">${cells[3] ? cells[3].innerHTML : '—'}</td>
                        <td class="py-3 text-muted small">${cells[4] ? cells[4].innerHTML : '—'}</td>
                        <td class="py-3 text-end px-4">
                            <div class="d-flex justify-content-end gap-2">
                                <button class="btn btn-sm btn-outline-primary rounded-3 px-3"
                                        onclick="openRoleModal(${staffId}, '${jsName}')"
                                        title="Đổi vai trò">
                                    <i class="bi bi-arrow-repeat me-1"></i>Đổi vai trò
                                </button>
                                <button class="btn btn-sm btn-outline-danger rounded-3 px-3"
                                        onclick="openRemoveModal(${staffId}, '${jsName}')"
                                        title="Gỡ khỏi khu vực">
                                    <i class="bi bi-person-dash me-1"></i>Gỡ
                                </button>
                            </div>
                        </td>
                    `;
                    tbody.appendChild(tr);
                });
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-danger">Lỗi kết nối: ' + escapeHtml(e.message) + '</td></tr>';
            }
        }

        // ── Load Location Table ───────────────────────────────
        async function loadLocationTable(areaId) {
            const tbody = document.getElementById('locationTableBody');
            tbody.innerHTML = '<tr><td colspan="2" class="text-center py-4 text-muted"><i class="bi bi-hourglass-split me-2"></i>Đang tải...</td></tr>';

            try {
                const resp = await fetch(`/admin/areamanager/areadetail?id=${areaId}`);
                if (!resp.ok) { tbody.innerHTML = '<tr><td colspan="2" class="text-center py-4 text-danger">Lỗi tải dữ liệu.</td></tr>'; return; }

                const html = await resp.text();
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, 'text/html');
                const rows = doc.querySelectorAll('#locationTableBody tr');

                if (rows.length === 0 || (rows.length === 1 && rows[0].querySelector('td[colspan]'))) {
                    tbody.innerHTML = '<tr><td colspan="2" class="text-center py-5 text-muted"><i class="bi bi-geo-alt fs-1 d-block mb-2 opacity-50"></i>Chưa có địa điểm nào.</td></tr>';
                    return;
                }

                tbody.innerHTML = '';
                rows.forEach(row => {
                    const tr = document.createElement('tr');
                    tr.innerHTML = row.innerHTML;
                    tbody.appendChild(tr);
                });
            } catch (e) {
                tbody.innerHTML = '<tr><td colspan="2" class="text-center py-4 text-danger">Lỗi kết nối.</td></tr>';
            }
        }

        // ── Load Available Users for Area ───────────────────
        async function loadAvailableUsers(areaId) {
            const targetAreaId = areaId || currentAreaId || document.getElementById('addStaff_areaSelect').value;
            const select = document.getElementById('addStaff_userSelect');
            select.innerHTML = '<option value="">Đang tải...</option>';

            try {
                const resp = await fetch(`/admin/api/users?excludeArea=${targetAreaId}&roles=Manager,Staff,Viewer`);
                const data = await resp.json();
                const users = data.results || [];

                select.innerHTML = '<option value="">— Chọn nhân sự —</option>';
                if (users.length === 0) {
                    select.innerHTML = '<option value="">Không có user khả dụng</option>';
                    return;
                }
                users.forEach(u => {
                    const opt = document.createElement('option');
                    opt.value = u.id;
                    opt.textContent = `${u.name} (${u.email}) — ${u.role}`;
                    select.appendChild(opt);
                });
            } catch (e) {
                select.innerHTML = '<option value="">Lỗi tải dữ liệu</option>';
            }
        }

        // ── Open Add Staff Modal ─────────────────────────────
        function openAddStaffModal() {
            if (!currentAreaId) return;
            document.getElementById('addStaff_areaSelect').value = currentAreaId;
            loadAvailableUsers(currentAreaId);
            new bootstrap.Modal(document.getElementById('addStaffModal')).show();
        }

        // ── Submit Add Staff ─────────────────────────────────
        async function submitAddStaff() {
            const areaId = document.getElementById('addStaff_areaSelect').value;
            const userId = document.getElementById('addStaff_userSelect').value;
            const roleInArea = document.getElementById('addStaff_roleSelect').value;

            if (!userId) { alert('Vui lòng chọn nhân sự.'); return; }

            const formData = new FormData();
            formData.append('AreaID', areaId);
            formData.append('UserID', userId);
            formData.append('RoleInArea', roleInArea);

            // Get anti-forgery token
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                       || document.querySelector('meta[name="csrf-token"]')?.content;

            try {
                const resp = await fetch('/admin/areamanager/addstaff', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({ AreaID: parseInt(areaId), UserID: parseInt(userId), RoleInArea: roleInArea })
                });

                const result = await resp.json();

                if (resp.ok && result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('addStaffModal')).hide();
                    showToast(result.message || 'Thêm thành công!', 'success');
                    if (currentAreaId == areaId) {
                        await loadStaffTable(currentAreaId);
                        await loadAreaStats(currentAreaId);
                    }
                } else {
                    showToast(result.message || result.error || 'Có lỗi xảy ra.', 'danger');
                }
            } catch (e) {
                showToast('Lỗi kết nối: ' + e.message, 'danger');
            }
        }

        // ── Open Role Modal ──────────────────────────────────
        function openRoleModal(staffId, userName) {
            document.getElementById('roleModal_staffId').value = staffId;
            document.getElementById('roleModal_userName').textContent = userName || '—';
            document.querySelectorAll('input[name="NewRole"]')[0].checked = true;
            document.querySelectorAll('.role-option').forEach(el => {
                el.classList.remove('border-primary', 'bg-primary', 'bg-opacity-5');
            });
            document.querySelector('.role-option').classList.add('border-primary', 'bg-primary', 'bg-opacity-5');
            new bootstrap.Modal(document.getElementById('changeRoleModal')).show();
        }

        function selectRoleOption(el, role) {
            document.querySelectorAll('.role-option').forEach(e => {
                e.classList.remove('border-primary', 'bg-primary', 'bg-opacity-5');
            });
            el.classList.add('border-primary', 'bg-primary', 'bg-opacity-5');
            document.getElementById('role_' + role).checked = true;
        }

        // ── Submit Change Role ───────────────────────────────
        async function submitChangeRole() {
            const staffId = document.getElementById('roleModal_staffId').value;
            const newRole = document.querySelector('input[name="NewRole"]:checked')?.value;
            if (!staffId || !newRole) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                       || document.querySelector('meta[name="csrf-token"]')?.content;

            try {
                const resp = await fetch('/admin/areamanager/updatestaffrole', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token || ''
                    },
                    body: JSON.stringify({ id: parseInt(staffId), newRole: newRole })
                });

                const result = await resp.json();
                if (resp.ok && result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('changeRoleModal')).hide();
                    showToast(result.message || 'Cập nhật thành công!', 'success');
                    if (currentAreaId) await loadStaffTable(currentAreaId);
                } else {
                    showToast(result.message || 'Có lỗi xảy ra.', 'danger');
                }
            } catch (e) {
                showToast('Lỗi kết nối.', 'danger');
            }
        }

        // ── Open Remove Modal ────────────────────────────────
        function openRemoveModal(staffId, userName) {
            document.getElementById('remove_staffId').value = staffId;
            document.getElementById('remove_userName').textContent = userName || '—';
            new bootstrap.Modal(document.getElementById('removeStaffModal')).show();
        }

        // ── Submit Remove Staff ─────────────────────────────
        async function submitRemoveStaff() {
            const staffId = document.getElementById('remove_staffId').value;
            if (!staffId) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value
                       || document.querySelector('meta[name="csrf-token"]')?.content;

            try {
                const resp = await fetch('/admin/areamanager/removestaff?id=' + staffId, {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': token || '' }
                });

                const result = await resp.json();
                if (resp.ok && result.success) {
                    bootstrap.Modal.getInstance(document.getElementById('removeStaffModal')).hide();
                    showToast(result.message || 'Đã gỡ thành công!', 'success');
                    if (currentAreaId) {
                        await loadStaffTable(currentAreaId);
                        await loadAreaStats(currentAreaId);
                    }
                } else {
                    showToast(result.message || 'Có lỗi xảy ra.', 'danger');
                }
            } catch (e) {
                showToast('Lỗi kết nối.', 'danger');
            }
        }

        // ── Toast Helper ─────────────────────────────────────
        function showToast(message, type = 'info') {
            const colors = {
                success: 'bg-success',
                danger: 'bg-danger',
                warning: 'bg-warning text-dark',
                info: 'bg-info'
            };
            const icons = {
                success: 'bi-check-circle-fill',
                danger: 'bi-exclamation-triangle-fill',
                warning: 'bi-exclamation-triangle-fill',
                info: 'bi-info-circle-fill'
            };
            const toast = document.createElement('div');
            toast.className = `position-fixed bottom-0 end-0 m-3 alert ${colors[type] || 'bg-info'} border-0 rounded-4 shadow-lg d-flex align-items-center gap-2 animate__animated animate__fadeInUp`;
            toast.style.cssText = 'z-index:9999; min-width:280px;';
            toast.innerHTML = `
                <i class="bi ${icons[type] || 'bi-info-circle-fill'} text-white"></i>
                <span class="text-white fw-bold">${message}</span>
                <button class="btn-close btn-close-white ms-auto" onclick="this.parentElement.remove()"></button>
            `;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 4000);
        }

        // ── Init ─────────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', () => {
            // Pre-load available users for modal on page load
            if (document.getElementById('addStaff_areaSelect')) {
                loadAvailableUsers(document.getElementById('addStaff_areaSelect').value);
            }
        });
    </script>
}
</div>
