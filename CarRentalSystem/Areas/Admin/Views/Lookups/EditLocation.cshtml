@model CarRentalSystem.Models.Location
@{
    ViewData["Title"] = "Chỉnh sửa Địa điểm";
    Layout = "_AdminLayout";
}

<style>
    .form-control { border-radius: 12px; border: 1.5px solid #e2e8f0; padding: 0.75rem 1rem; font-weight: 500; transition: border-color 0.2s, box-shadow 0.2s; }
    .form-control:focus { border-color: #3b82f6; box-shadow: 0 0 0 3px rgba(59,130,246,0.12); }
    .form-label { font-weight: 700; font-size: 0.78rem; text-transform: uppercase; letter-spacing: 0.6px; color: #64748b; margin-bottom: 0.5rem; }
    .section-card { background: white; border-radius: 20px; padding: 1.75rem; border: 1px solid #f1f5f9; box-shadow: 0 2px 12px rgba(0,0,0,0.04); margin-bottom: 1.5rem; max-width: 600px; margin: 0 auto; }
</style>

<div class="d-flex justify-content-between align-items-center mb-5" style="max-width: 600px; margin: 0 auto;">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">Chỉnh sửa Địa điểm</h2>
        <p class="text-muted mb-0">Cập nhật thông tin địa điểm @Model.Name.</p>
    </div>
    <a asp-action="Index" asp-route-tab="locations" class="btn btn-light rounded-3 px-4 py-2 fw-bold border">
        <i class="bi bi-arrow-left me-2"></i>Quay lại
    </a>
</div>

<div class="section-card">
    <form asp-action="EditLocation" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
        <input type="hidden" asp-for="LocationID" />
        
        <div class="mb-3">
            <label class="form-label">Tên địa điểm <span class="text-danger">*</span></label>
            <input asp-for="Name" class="form-control" required />
            <span asp-validation-for="Name" class="text-danger small"></span>
        </div>
        
        <div class="mb-4">
            <label class="form-label">Địa chỉ chi tiết</label>
            <textarea asp-for="Address" class="form-control" rows="2"></textarea>
            <span asp-validation-for="Address" class="text-danger small"></span>
        </div>
        
        <button type="submit" class="btn btn-primary w-100 rounded-3 py-3 fw-bold shadow-sm">
            <i class="bi bi-check-lg me-2"></i>Lưu thay đổi
        </button>
    </form>
</div>
