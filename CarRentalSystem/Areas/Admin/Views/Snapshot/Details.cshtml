@* CarRentalSystem/Areas/Admin/Views/Snapshot/Details.cshtml *@
@model CarRentalSystem.Models.DbSnapshot
@{
    ViewData["Title"] = "Chi tiết Snapshot";
    Layout = "_AdminLayout";

    Dictionary<string, int>? tableStats = null;
    if (!string.IsNullOrEmpty(Model.DataJson))
    {
        try
        {
            var data = System.Text.Json.JsonSerializer.Deserialize<Dictionary<string, System.Text.Json.JsonElement>>(Model.DataJson);
            if (data != null)
            {
                tableStats = new Dictionary<string, int>();
                foreach (var kv in data)
                {
                    tableStats[kv.Key] = kv.Value.EnumerateArray().Count();
                }
            }
        }
        catch { }
    }
}

<!-- Breadcrumb -->
<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb small mb-1">
        <li class="breadcrumb-item"><a asp-area="Admin" asp-controller="Snapshot" asp-action="Index" class="text-decoration-none text-muted">Sao lưu & Phục hồi</a></li>
        <li class="breadcrumb-item text-primary fw-bold">@Model.Name</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">
            <i class="bi bi-archive text-primary me-2"></i>@Model.Name
        </h2>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <p class="text-muted mb-0">@Model.Description</p>
        }
    </div>
    <div class="d-flex gap-2">
        <a asp-area="Admin" asp-controller="Snapshot" asp-action="Index" class="btn btn-outline-secondary rounded-3 px-4 fw-bold">
            <i class="bi bi-arrow-left me-2"></i>Quay lại
        </a>
        @if (Model.Status == "Ready")
        {
            <a asp-area="Admin" asp-controller="Snapshot" asp-action="Download" asp-route-id="@Model.SnapshotID"
               class="btn btn-outline-primary rounded-3 px-4 fw-bold" download>
                <i class="bi bi-download me-2"></i>Tải về
            </a>
        }
    </div>
</div>

<!-- Info Card -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-body p-4">
        <div class="row g-4">
            <div class="col-md-3 text-center">
                <div class="text-primary mb-1"><i class="bi bi-archive fs-1"></i></div>
                <h4 class="fw-bolder text-primary mb-0">@Model.DataSizeFormatted</h4>
                <small class="text-muted fw-bold">Dung lượng</small>
            </div>
            <div class="col-md-3 text-center">
                <div class="text-success mb-1"><i class="bi bi-table fs-1"></i></div>
                <h4 class="fw-bolder text-success mb-0">@Model.TableCount</h4>
                <small class="text-muted fw-bold">Bảng dữ liệu</small>
            </div>
            <div class="col-md-3 text-center">
                <div class="text-info mb-1"><i class="bi bi-list-ul fs-1"></i></div>
                <h4 class="fw-bolder text-info mb-0">@Model.TotalRows.ToString("N0")</h4>
                <small class="text-muted fw-bold">Dòng dữ liệu</small>
            </div>
            <div class="col-md-3 text-center">
                <div class="mb-1">
                    @{
                        var statusColor = Model.Status switch
                        {
                            "Ready" => "text-success",
                            "Restored" => "text-info",
                            "Failed" => "text-danger",
                            _ => "text-warning"
                        };
                    }
                    <i class="bi bi-circle-fill fs-1 @statusColor"></i>
                </div>
                <h4 class="fw-bolder mb-0 @statusColor">@Model.Status</h4>
                <small class="text-muted fw-bold">Trạng thái</small>
            </div>
        </div>
        <hr class="my-4">
        <div class="row g-3 small">
            <div class="col-md-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-calendar3 text-muted"></i>
                    <span class="text-muted">Tạo lúc:</span>
                    <span class="fw-bold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm:ss")</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-tag text-muted"></i>
                    <span class="text-muted">Loại:</span>
                    <span class="badge bg-primary rounded-pill">@Model.SnapshotType</span>
                </div>
            </div>
            @if (Model.IsAutoGenerated)
            {
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-clock text-muted"></i>
                        <span class="badge bg-secondary rounded-pill">Tự động</span>
                    </div>
                </div>
            }
            @if (Model.RestoredAt.HasValue)
            {
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-arrow-counterclockwise text-info"></i>
                        <span class="text-muted">Phục hồi lúc:</span>
                        <span class="fw-bold text-info">@Model.RestoredAt.Value.ToString("dd/MM/yyyy HH:mm:ss")</span>
                    </div>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model.AppVersion))
            {
                <div class="col-md-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-code-square text-muted"></i>
                        <span class="text-muted">App version:</span>
                        <span class="fw-bold">@Model.AppVersion</span>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Table Breakdown -->
@if (tableStats != null && tableStats.Any())
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-white border-bottom py-3">
            <h5 class="mb-0 fw-bold"><i class="bi bi-table me-2 text-primary"></i>Chi tiết từng bảng</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 fw-bold text-muted text-uppercase small">#</th>
                            <th class="py-3 fw-bold text-muted text-uppercase small">Tên bảng</th>
                            <th class="py-3 fw-bold text-muted text-uppercase small text-end px-4">Số dòng</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            int idx = 1;
                            foreach (var kv in tableStats.OrderByDescending(kv => kv.Value))
                            {
                                <tr>
                                    <td class="px-4 py-3 text-muted fw-bold">@(idx++)</td>
                                    <td class="py-3">
                                        <code class="bg-light px-2 py-1 rounded text-dark">@kv.Key</code>
                                    </td>
                                    <td class="py-3 text-end px-4">
                                        <span class="badge bg-light text-dark rounded-pill px-3 py-2">
                                            @kv.Value.ToString("N0")
                                        </span>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <td colspan="2" class="px-4 py-3 fw-bold text-muted">Tổng cộng</td>
                            <td class="py-3 text-end px-4 fw-bold text-primary">
                                @tableStats.Values.Sum().ToString("N0")
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}

<!-- Actions -->
@if (Model.Status == "Ready")
{
    <div class="mt-4 d-flex gap-3 justify-content-end">
        <form asp-area="Admin" asp-controller="Snapshot" asp-action="Restore" method="post"
              onsubmit="return confirm('Phục hồi sẽ ghi đè dữ liệu hiện tại. Tiếp tục?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.SnapshotID" />
            <button type="submit" class="btn btn-success rounded-3 px-4 fw-bold shadow-sm">
                <i class="bi bi-arrow-counterclockwise me-2"></i>Phục hồi bản sao lưu này
            </button>
        </form>
        <form asp-area="Admin" asp-controller="Snapshot" asp-action="Delete" method="post"
              onsubmit="return confirm('Xóa vĩnh viễn bản sao lưu này?');">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.SnapshotID" />
            <button type="submit" class="btn btn-outline-danger rounded-3 px-4 fw-bold">
                <i class="bi bi-trash me-2"></i>Xóa
            </button>
        </form>
    </div>
}
