<div class="theme-admin">
@model CarRentalSystem.Models.PartnerContract
@{
    ViewData["Title"] = "Chi tiết Hợp đồng Đối tác";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-file-earmark-text me-2"></i>Hợp đồng Đối tác #@Model.ContractNo</h4>
        <p class="text-muted mb-0 small">
            Trạng thái:
            @if (Model.Status == "Pending")
            {
                <span class="badge bg-warning text-dark">Chờ ký</span>
            }
            else if (Model.Status == "Active")
            {
                <span class="badge bg-success">Đã ký</span>
            }
            else if (Model.Status == "Expired")
            {
                <span class="badge bg-secondary">Hết hạn</span>
            }
            else
            {
                <span class="badge bg-danger">Đã hủy</span>
            }
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
        <button onclick="window.print()" class="btn btn-outline-dark btn-sm rounded-pill px-3">
            <i class="bi bi-printer me-1"></i>In hợp đồng
        </button>
    </div>
</div>

<!-- Contract Document -->
<div class="card border-0 shadow-sm rounded-4 p-4" id="contractDocument">
    <div class="card-body" style="max-width: 800px; margin: 0 auto; font-family: 'Times New Roman', serif; font-size: 14px; line-height: 1.8;">

        <!-- Header -->
        <div class="text-center mb-4">
            <p class="mb-0 fw-bold" style="font-size: 13px;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</p>
            <p class="mb-2" style="font-size: 13px;"><strong>Độc lập - Tự do - Hạnh phúc</strong></p>
            <hr style="width: 150px; margin: 0 auto; border-top: 1px solid #000;">
        </div>

        <div class="text-center mb-4">
            <h5 class="fw-bold mb-1" style="font-size: 16px;">HỢP ĐỒNG HỢP TÁC KÝ GỬI & VẬN HÀNH XE TỰ LÁI</h5>
            <p class="mb-0" style="font-size: 13px;">(Số: @Model.ContractNo)</p>
        </div>

        <!-- BÊN A -->
        <div class="mb-3">
            <p class="fw-bold mb-2" style="text-decoration: underline;">BÊN A: ĐƠN VỊ VẬN HÀNH</p>
            <p class="mb-1">Họ và tên/Công ty: <strong>@Model.PartyAName</strong></p>
            <p class="mb-1">Địa chỉ: <strong>@(Model.PartyAAddress ?? "...................................")</strong></p>
        </div>

        <!-- BÊN B -->
        <div class="mb-4">
            <p class="fw-bold mb-2" style="text-decoration: underline;">BÊN B: CHỦ XE (ĐỐI TÁC)</p>
            <p class="mb-1">Họ và tên: <strong>@Model.PartyBFullName</strong> &nbsp;&nbsp; CCCD: <strong>@(Model.PartyBCCCD ?? "...................")</strong></p>
            @if (!string.IsNullOrEmpty(Model.VehicleInfo))
            {
                <p class="mb-1">Thông tin xe: <strong>@Model.VehicleInfo</strong> &nbsp;&nbsp; Biển số: <strong>@(Model.VehiclePlate ?? "...................")</strong></p>
            }
            @if (!string.IsNullOrEmpty(Model.VehicleCondition))
            {
                <p class="mb-1">Tình trạng xe hiện tại: <strong>@Model.VehicleCondition</strong></p>
            }
        </div>

        <!-- ĐIỀU KHOẢN -->
        <div class="mb-3">
            @if (!string.IsNullOrEmpty(Model.TermsContent))
            {
                @foreach (var line in Model.TermsContent.Split('\n'))
                {
                    if (line.StartsWith("ĐIỀU"))
                    {
                        <p class="fw-bold mt-3 mb-1">@line</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(line))
                    {
                        <p class="mb-1">@line</p>
                    }
                }
            }
        </div>

        <!-- Phân chia doanh thu -->
        <div class="mb-4 p-3 bg-light rounded-3">
            <p class="fw-bold mb-2"><i class="bi bi-pie-chart-fill me-2"></i>CHI TIẾT PHÂN CHIA DOANH THU (ĐIỀU 2)</p>
            <div class="row">
                <div class="col-md-4">
                    <p class="mb-1 small text-muted">Bên B (Chủ xe)</p>
                    <p class="fw-bold text-success fs-5">@Model.PartyBRevenuePercent%</p>
                </div>
                <div class="col-md-4">
                    <p class="mb-1 small text-muted">Bên A (Vận hành)</p>
                    <p class="fw-bold text-primary fs-5">@Model.PartyARevenuePercent%</p>
                </div>
                <div class="col-md-4">
                    <p class="mb-1 small text-muted">Kỳ thanh toán</p>
                    <p class="fw-bold">Ngày @Model.PaymentDay @Model.PaymentCycle</p>
                </div>
            </div>
        </div>

        <!-- Thời hạn -->
        <div class="mb-4 p-3 bg-light rounded-3">
            <p class="fw-bold mb-2"><i class="bi bi-calendar-check me-2"></i>THỜI HẠN HỢP ĐỒNG</p>
            <div class="row">
                <div class="col-md-6">
                    <p class="mb-1 small text-muted">Thời hạn</p>
                    <p class="fw-bold">@(Model.ContractDurationMonths == 0 ? "Vĩnh viễn" : $"{Model.ContractDurationMonths} tháng")</p>
                </div>
                <div class="col-md-6">
                    <p class="mb-1 small text-muted">Thời gian báo trước khi chấm dứt</p>
                    <p class="fw-bold">@Model.NoticePeriodDays ngày</p>
                </div>
            </div>
        </div>

        <!-- Ký tên -->
        <div class="row mt-5 pt-4 text-center" style="border-top: 1px dashed #ccc;">
            <div class="col-6">
                <p class="fw-bold mb-1">ĐẠI DIỆN BÊN A</p>
                <p class="small text-muted mb-3">(Ký tên, đóng dấu)</p>
                @if (Model.SignedByPartyA)
                {
                    <p class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>ĐÃ KÝ</p>
                    <p class="small text-muted">@Model.PartyASignDate?.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="fw-bold">@Model.PartyAName</p>
                }
                else
                {
                    <div style="height: 80px;"></div>
                }
            </div>
            <div class="col-6">
                <p class="fw-bold mb-1">ĐẠI DIỆN BÊN B</p>
                <p class="small text-muted mb-3">(Ký tên)</p>
                @if (Model.SignedByPartyB)
                {
                    <p class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>ĐÃ KÝ</p>
                    <p class="small text-muted">@Model.PartyBSignDate?.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="fw-bold">@Model.PartyBFullName</p>
                }
                else
                {
                    <p class="text-danger small"><i class="bi bi-x-circle me-1"></i>Chưa ký</p>
                    @if (Model.Status == "Pending")
                    {
                        var daysLeft = (Model.ExpiresAt - DateTime.Now).TotalDays;
                        if (daysLeft > 0)
                        {
                            <p class="badge bg-warning text-dark">Còn @Math.Ceiling(daysLeft) ngày để ký</p>
                        }
                        else
                        {
                            <p class="badge bg-danger">Đã quá hạn ký</p>
                        }
                    }
                }
            </div>
        </div>

        @if (Model.Status == "Cancelled")
        {
            <div class="alert alert-danger mt-4 mb-0">
                <i class="bi bi-x-circle-fill me-2"></i>
                <strong>Hợp đồng đã bị hủy</strong>
                @if (!string.IsNullOrEmpty(Model.CancelReason))
                {
                    <span> — Lý do: @Model.CancelReason</span>
                }
                @if (Model.CancelledAt.HasValue)
                {
                    <span class="small d-block mt-1">Ngày hủy: @Model.CancelledAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                }
            </div>
        }
    </div>
</div>

<style>
    @@media print {
        .admin-sidebar, .d-md-flex, .btn, .admin-link, nav, footer { display: none !important; }
        .admin-main-content { margin: 0 !important; padding: 0 !important; }
        #contractDocument { box-shadow: none !important; border: none !important; }
    }
</style>
</div>
