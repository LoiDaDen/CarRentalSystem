@model CarRentalSystem.Models.HolidayPricing
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Sửa Cấu Hình Giá Ngày Lễ";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 pb-0">
                <h4 class="fw-bold mb-1">
                    <i class="bi bi-pencil text-warning me-2"></i>Sửa Cấu Hình Giá Ngày Lễ
                </h4>
                <p class="text-muted small">ID: @Model.HolidayPricingID</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3"></div>
                    
                    <input type="hidden" asp-for="HolidayPricingID" />
                    
                    <div class="mb-4">
                        <label asp-for="HolidayName" class="form-label fw-bold"></label>
                        <input asp-for="HolidayName" class="form-control form-control-lg rounded-3" />
                        <span asp-validation-for="HolidayName" class="text-danger small"></span>
                    </div>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label asp-for="StartDate" class="form-label fw-bold"></label>
                            <input asp-for="StartDate" type="date" class="form-control rounded-3" />
                            <span asp-validation-for="StartDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="EndDate" class="form-label fw-bold"></label>
                            <input asp-for="EndDate" type="date" class="form-control rounded-3" />
                            <span asp-validation-for="EndDate" class="text-danger small"></span>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="PriceMultiplier" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <span class="input-group-text rounded-start-3">x</span>
                            <input asp-for="PriceMultiplier" type="number" step="0.01" min="1" max="5" class="form-control rounded-end-3" />
                        </div>
                        <span asp-validation-for="PriceMultiplier" class="text-danger small"></span>
                        <div class="form-text">
                            <span class="text-muted">Ví dụ: 1.5 = tăng 50%, 2.0 = tăng 100%</span>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="CarID" class="form-label fw-bold">Xe áp dụng</label>
                        <select asp-for="CarID" class="form-select rounded-3" asp-items="@(new SelectList(ViewBag.Cars, "CarID", "CarName"))">
                            <option value="">-- Tất cả xe --</option>
                        </select>
                        <div class="form-text">
                            <span class="text-muted">Để trống = áp dụng cho tất cả xe</span>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <div class="form-check">
                            <input asp-for="IsActive" class="form-check-input" />
                            <label asp-for="IsActive" class="form-check-label fw-bold">Kích hoạt</label>
                        </div>
                    </div>
                    
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-success btn-lg rounded-3 fw-bold flex-grow-1">
                            <i class="bi bi-check-lg me-2"></i>Lưu Thay Đổi
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-lg rounded-3 fw-bold">
                            <i class="bi bi-x-lg me-2"></i>Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
