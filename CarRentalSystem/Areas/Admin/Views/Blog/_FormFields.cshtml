@model AdminBlogFormViewModel

<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-bold">Tiêu đề</label>
                    <input asp-for="Title" class="form-control form-control-lg" />
                    <span asp-validation-for="Title" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Slug" class="form-label fw-bold">Slug SEO</label>
                    <input asp-for="Slug" class="form-control" placeholder="Để trống để tự tạo từ tiêu đề" />
                    <span asp-validation-for="Slug" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Summary" class="form-label fw-bold">Mô tả ngắn</label>
                    <textarea asp-for="Summary" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="Summary" class="text-danger small"></span>
                </div>
                <div class="mb-0">
                    <label asp-for="Content" class="form-label fw-bold">Nội dung bài viết</label>
                    <textarea asp-for="Content" rows="18" class="form-control font-monospace" placeholder="<h2>Tiêu đề mục</h2><p>Nội dung...</p>"></textarea>
                    <div class="form-text">Có thể nhập HTML cơ bản như h2, h3, p, ul, li để trình bày bài viết.</div>
                    <span asp-validation-for="Content" class="text-danger small"></span>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">SEO</h5>
                <div class="mb-3">
                    <label asp-for="MetaTitle" class="form-label fw-bold">Meta title</label>
                    <input asp-for="MetaTitle" class="form-control" />
                    <span asp-validation-for="MetaTitle" class="text-danger small"></span>
                </div>
                <div class="mb-0">
                    <label asp-for="MetaDescription" class="form-label fw-bold">Meta description</label>
                    <textarea asp-for="MetaDescription" rows="3" class="form-control"></textarea>
                    <span asp-validation-for="MetaDescription" class="text-danger small"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Xuất bản</h5>
                <div class="mb-3">
                    <label asp-for="CategoryID" class="form-label fw-bold">Danh mục</label>
                    <select asp-for="CategoryID" asp-items="ViewBag.Categories" class="form-select"></select>
                    <span asp-validation-for="CategoryID" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Status" class="form-label fw-bold">Trạng thái</label>
                    <select asp-for="Status" class="form-select">
                        <option value="@BlogStatusConstants.Draft">Draft</option>
                        <option value="@BlogStatusConstants.Published">Published</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label asp-for="PublishedDate" class="form-label fw-bold">Ngày đăng</label>
                    <input asp-for="PublishedDate" type="datetime-local" class="form-control" />
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label asp-for="ReadingTime" class="form-label fw-bold">Phút đọc</label>
                        <input asp-for="ReadingTime" type="number" min="1" class="form-control" />
                    </div>
                    <div class="col-6">
                        <label asp-for="AuthorName" class="form-label fw-bold">Tác giả</label>
                        <input asp-for="AuthorName" class="form-control" />
                    </div>
                </div>
                <div class="form-check form-switch mt-3">
                    <input asp-for="IsFeatured" class="form-check-input" />
                    <label asp-for="IsFeatured" class="form-check-label fw-bold">Bài viết nổi bật</label>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Tag</h5>
                <label asp-for="TagsCsv" class="form-label fw-bold">Tag, cách nhau bằng dấu phẩy</label>
                <input asp-for="TagsCsv" class="form-control" placeholder="thuê xe tự lái, xe 7 chỗ" />
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4">
                <h5 class="fw-bold mb-3">Hình ảnh</h5>
                <div class="mb-3">
                    <label asp-for="ThumbnailFile" class="form-label fw-bold">Upload thumbnail</label>
                    <input asp-for="ThumbnailFile" type="file" accept="image/jpeg,image/png,image/webp" class="form-control js-image-input" data-preview="thumbPreview" />
                    <input asp-for="ThumbnailUrl" class="form-control mt-2" placeholder="Hoặc nhập URL thumbnail" />
                    <input asp-for="ThumbnailAlt" class="form-control mt-2" placeholder="Alt thumbnail" />
                    <img id="thumbPreview" src="@Model.ThumbnailUrl" alt="" class="img-fluid rounded-3 mt-2 border" style="@(string.IsNullOrWhiteSpace(Model.ThumbnailUrl) ? "display:none;" : "") max-height:150px;object-fit:cover;" />
                </div>
                <div class="mb-0">
                    <label asp-for="CoverFile" class="form-label fw-bold">Upload cover</label>
                    <input asp-for="CoverFile" type="file" accept="image/jpeg,image/png,image/webp" class="form-control js-image-input" data-preview="coverPreview" />
                    <input asp-for="CoverImageUrl" class="form-control mt-2" placeholder="Hoặc nhập URL cover" />
                    <input asp-for="CoverImageAlt" class="form-control mt-2" placeholder="Alt cover" />
                    <img id="coverPreview" src="@Model.CoverImageUrl" alt="" class="img-fluid rounded-3 mt-2 border" style="@(string.IsNullOrWhiteSpace(Model.CoverImageUrl) ? "display:none;" : "") max-height:180px;object-fit:cover;" />
                </div>
            </div>
        </div>
    </div>
</div>
