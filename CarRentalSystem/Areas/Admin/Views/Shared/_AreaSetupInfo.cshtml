@* CarRentalSystem/Areas/Admin/Views/Shared/_AreaSetupInfo.cshtml *@
@using CarRentalSystem.Data
@using Microsoft.EntityFrameworkCore
@inject ApplicationDbContext Db
@{
    var allStaffs = await Db.AreaStaffs
        .IgnoreQueryFilters()
        .Where(asx => !asx.IsDeleted)
        .Include(asx => asx.User)
        .Include(asx => asx.Area)
        .ToListAsync();

    var allUsers = await Db.Users
        .Where(u => u.Role == "Manager" || u.Role == "Staff")
        .OrderBy(u => u.Role)
        .ThenBy(u => u.Name)
        .ToListAsync();
}

<style>
.role-badge { font-size: 0.7rem; padding: 3px 8px; border-radius: 20px; font-weight: 600; }
.role-mgr { background: #fee2e2; color: #dc2626; }
.role-staff { background: #dcfce7; color: #16a34a; }
.area-chip { font-size: 0.75rem; padding: 2px 8px; border-radius: 6px; font-weight: 500; }
.table-setup { font-size: 0.8rem; }
.table-setup thead th { background: #f8fafc; font-weight: 700; text-transform: uppercase; font-size: 0.7rem; letter-spacing: 0.5px; color: #64748b; border: none; padding-top: 0.75rem; padding-bottom: 0.75rem; }
.table-setup td { vertical-align: middle; border-color: #f1f5f9; padding-top: 0.75rem; padding-bottom: 0.75rem; }
</style>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="card-header bg-white border-0 py-3">
        <h5 class="fw-bold mb-0">
            <i class="bi bi-diagram-3-fill text-primary me-2"></i>Mapping: Tai khoan ↔ Khu vuc
        </h5>
        <p class="text-muted small mb-0 mt-1">Kiem tra tai khoan nao thuoc khu vuc nao</p>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0 table-setup">
            <thead>
                <tr>
                    <th class="ps-4">Tai khoan</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Khu vuc</th>
                    <th class="pe-4 text-end">Vai tro trong KV</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in allUsers)
                {
                    var userAssignments = allStaffs.Where(asx => asx.UserID == user.UserID).ToList();
                    var isMgr = user.Role == "Manager";
                    var rowStyle = isMgr ? "background: #fff9f9;" : "";

                    <tr style="@rowStyle">
                        <td class="ps-4">
                            <div class="d-flex align-items-center gap-2">
                                <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                     style="width:32px;height:32px;font-size:0.8rem; background:@(isMgr ? "#dc2626" : "#16a34a");">
                                    @(user.Name != null && user.Name.Length > 0 ? user.Name.Substring(0, 1).ToUpper() : "?")
                                </div>
                                <span class="fw-bold">@user.Name</span>
                            </div>
                        </td>
                        <td><code class="small">@user.Email</code></td>
                        <td>
                            @if (isMgr)
                            {
                                <span class="role-badge role-mgr">Manager</span>
                            }
                            else
                            {
                                <span class="role-badge role-staff">Staff</span>
                            }
                        </td>
                        <td>
                            @if (!userAssignments.Any())
                            {
                                <span class="text-danger small">
                                    <i class="bi bi-exclamation-triangle me-1"></i>Chua gan KV!
                                </span>
                            }
                            else
                            {
                                foreach (var asx in userAssignments)
                                {
                                    <div class="d-flex align-items-center gap-1 mb-1">
                                        <span class="badge bg-dark rounded-3 area-chip">@(asx.Area?.Code)</span>
                                        <span class="small">@(asx.Area?.Name)</span>
                                    </div>
                                }
                            }
                        </td>
                        <td class="pe-4 text-end">
                            @if (!userAssignments.Any())
                            {
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                foreach (var asx in userAssignments)
                                {
                                    if (asx.RoleInArea == "manager")
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill me-1" style="font-size:0.7rem;">
                                            <i class="bi bi-shield-fill me-1"></i>Manager
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill me-1" style="font-size:0.7rem;">
                                            @asx.RoleInArea
                                        </span>
                                    }
                                }
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
