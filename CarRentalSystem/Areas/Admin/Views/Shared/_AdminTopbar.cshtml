@{
    var pageTitle = ViewData["Title"]?.ToString() ?? ViewContext.RouteData.Values["controller"]?.ToString() ?? "Admin";
    var userName = User.Identity?.Name ?? "Quản trị viên";
    var initials = string.Concat(userName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
    if (string.IsNullOrWhiteSpace(initials)) initials = "AD";
}

<header class="admin-topbar">
    <div class="admin-topbar-leading">
        <button type="button" class="admin-icon-button" data-admin-sidebar-toggle aria-label="Thu gọn hoặc mở menu">
            <i class="bi bi-list"></i>
        </button>
        <div class="admin-page-heading">
            <small>Admin Portal</small>
            <strong>@pageTitle</strong>
        </div>
    </div>

    <div class="admin-topbar-search" data-admin-global-search>
        <i class="bi bi-search"></i>
        <input type="search" placeholder="Tìm nhanh trong bảng hiện tại..." data-admin-table-search aria-label="Tìm nhanh trong bảng hiện tại" />
        <kbd>Ctrl K</kbd>
    </div>

    <div class="admin-topbar-actions">
        <button type="button" class="admin-icon-button" data-tutorial-replay data-panel="Admin" title="Xem lại hướng dẫn" aria-label="Xem lại hướng dẫn">
            <i class="bi bi-question-circle"></i>
        </button>
        <button type="button" class="admin-icon-button" data-admin-theme-toggle title="Đổi giao diện" aria-label="Đổi giao diện sáng tối">
            <i class="bi bi-moon-stars" data-admin-theme-icon></i>
        </button>
        <div class="dropdown">
            <button class="admin-icon-button position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" data-admin-notification-button aria-label="Thông báo">
                <i class="bi bi-bell"></i>
                <span class="admin-notification-count d-none" data-admin-notification-count>0</span>
            </button>
            <div class="dropdown-menu dropdown-menu-end admin-notification-menu">
                <div class="admin-notification-header"><strong>Thông báo gần đây</strong><a asp-area="Admin" asp-controller="Booking" asp-action="Index">Xem bookings</a></div>
                <div class="admin-notification-list" data-admin-notification-list>
                    <div class="admin-notification-empty"><i class="bi bi-arrow-repeat"></i><span>Đang tải...</span></div>
                </div>
            </div>
        </div>
        <div class="dropdown">
            <button class="admin-user-menu" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                <span class="admin-user-avatar">@initials</span>
                <span class="admin-user-copy"><strong>@userName</strong><small>Administrator</small></span>
                <i class="bi bi-chevron-down"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end">
                <li><a class="dropdown-item" asp-area="" asp-controller="Auth" asp-action="Profile"><i class="bi bi-person"></i> Hồ sơ cá nhân</a></li>
                <li><a class="dropdown-item" asp-area="Admin" asp-controller="Lookups" asp-action="Index"><i class="bi bi-sliders2"></i> Danh mục hệ thống</a></li>
                <li><hr class="dropdown-divider" /></li>
                <li>
                    <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right"></i> Đăng xuất</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</header>
