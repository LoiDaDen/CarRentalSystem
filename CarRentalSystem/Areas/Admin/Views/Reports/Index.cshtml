@{
    ViewData["Title"] = "Báo cáo & Thống kê";
    Layout = "_AdminLayout";
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">Báo cáo & Thống kê</h2>
        <p class="text-muted mb-0">Phân tích hiệu suất kinh doanh và doanh thu hệ thống.</p>
    </div>
    <button class="btn btn-primary rounded-3 px-4 fw-bold shadow-sm" onclick="window.print()">
        <i class="bi bi-printer me-2"></i>Xuất báo cáo
    </button>
</div>

<!-- KPI Cards -->
<div class="row g-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-primary bg-opacity-10 p-2 rounded-3">
                    <i class="bi bi-currency-dollar text-primary fs-4"></i>
                </div>
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 small">Tháng này</span>
            </div>
            <h3 class="fw-800 mb-1">@(((decimal)ViewBag.MonthRevenue).ToString("N0"))<small class="fs-6 fw-bold"> đ</small></h3>
            <div class="text-muted small fw-bold text-uppercase ls-1" style="font-size:0.65rem;">Doanh thu tháng @DateTime.Now.Month</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-info bg-opacity-10 p-2 rounded-3">
                    <i class="bi bi-calendar-check text-info fs-4"></i>
                </div>
            </div>
            <h3 class="fw-800 mb-1">@ViewBag.NewBookingsThisMonth</h3>
            <div class="text-muted small fw-bold text-uppercase ls-1" style="font-size:0.65rem;">Đơn đặt mới tháng này</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-success bg-opacity-10 p-2 rounded-3">
                    <i class="bi bi-car-front text-success fs-4"></i>
                </div>
            </div>
            <h3 class="fw-800 mb-1">@ViewBag.RentedCars</h3>
            <div class="text-muted small fw-bold text-uppercase ls-1" style="font-size:0.65rem;">Xe đang cho thuê</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-danger bg-opacity-10 p-2 rounded-3">
                    <i class="bi bi-tools text-danger fs-4"></i>
                </div>
            </div>
            <h3 class="fw-800 mb-1">@ViewBag.MaintenanceCars</h3>
            <div class="text-muted small fw-bold text-uppercase ls-1" style="font-size:0.65rem;">Xe đang bảo trì</div>
        </div>
    </div>
</div>
