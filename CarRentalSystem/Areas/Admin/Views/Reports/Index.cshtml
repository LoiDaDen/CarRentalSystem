@{
    ViewData["Title"] = "Báo cáo & Thống kê";
    Layout = "_AdminLayout";
}

<div class="theme-admin">
    <!-- Page Header -->
    <div class="page-header mb-4">
        <div>
            <h2 class="fw-800 ls-neg-1 mb-1">Báo cáo & Thống kê</h2>
            <p class="text-muted mb-0">Phân tích hiệu suất vận hành và doanh thu ròng theo payment ledger.</p>
        </div>
        <button class="btn btn-primary rounded-3 px-4 fw-bold" onclick="window.print()">
            <i class="bi bi-printer me-2"></i>Xuất báo cáo
        </button>
    </div>

    <!-- KPI Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="admin-stat-card" style="border-left: 4px solid var(--admin-primary);">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="stat-icon-wrapper" style="background: var(--admin-primary-100); color: var(--admin-primary);">
                        <i class="bi bi-currency-dollar"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success rounded-pill px-2 py-1 small">Tháng này</span>
                </div>
                <h3 class="fw-800 mb-1">@(((decimal)ViewBag.MonthRevenue).ToString("N0"))<small class="fs-6 fw-bold" style="color: var(--admin-text-secondary);"> đ</small></h3>
                <div class="text-muted small fw-bold text-uppercase ls-1" style="font-size: 0.65rem;">Doanh thu ròng theo ledger tháng @DateTime.Now.Month</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="admin-stat-card" style="border-left: 4px solid var(--admin-info);">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="stat-icon-wrapper" style="background: var(--admin-info-100); color: var(--admin-info);">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                </div>
                <h3 class="fw-800 mb-1">@ViewBag.NewBookingsThisMonth</h3>
                <div class="text-muted small fw-bold text-uppercase ls-1" style="font-size: 0.65rem;">Đơn đặt mới tháng này</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="admin-stat-card" style="border-left: 4px solid var(--admin-success);">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="stat-icon-wrapper" style="background: var(--admin-success-100); color: var(--admin-success);">
                        <i class="bi bi-car-front"></i>
                    </div>
                </div>
                <h3 class="fw-800 mb-1">@ViewBag.RentedCars</h3>
                <div class="text-muted small fw-bold text-uppercase ls-1" style="font-size: 0.65rem;">Xe đang cho thuê</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="admin-stat-card" style="border-left: 4px solid var(--admin-danger);">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="stat-icon-wrapper" style="background: var(--admin-danger-100); color: var(--admin-danger);">
                        <i class="bi bi-tools"></i>
                    </div>
                </div>
                <h3 class="fw-800 mb-1">@ViewBag.MaintenanceCars</h3>
                <div class="text-muted small fw-bold text-uppercase ls-1" style="font-size: 0.65rem;">Xe đang bảo trì</div>
            </div>
        </div>
    </div>
</div>
