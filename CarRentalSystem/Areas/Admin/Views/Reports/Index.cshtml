@{
    ViewData["Title"] = "Báo cáo & Thống kê";
    Layout = "_AdminLayout";

    var revenueLabels = ViewBag.RevenueLabels as List<string>;
    var revenueData = ViewBag.RevenueData as List<decimal>;
    var statusGroups = ViewBag.StatusGroups as Dictionary<string, int>;
    var topCars = ViewBag.TopCars as List<CarRentalSystem.Areas.Admin.Models.TopCarViewModel>;
    var topCustomers = ViewBag.TopCustomers as List<CarRentalSystem.Areas.Admin.Models.TopCustomerViewModel>;
}

<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">Báo cáo & Thống kê</h2>
        <p class="text-muted mb-0">Phân tích hiệu suất kinh doanh và doanh thu hệ thống.</p>
    </div>
    <button class="btn btn-primary rounded-3 px-4 fw-bold shadow-sm" onclick="window.print()">
        <i class="bi bi-printer me-2"></i>Xuất báo cáo
    </button>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-primary bg-opacity-10 p-2 rounded-3">
                    <i class="bi bi-currency-dollar text-primary fs-4"></i>
                </div>
                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-2 py-1 small">Tháng này</span>
            </div>
            <h3 class="fw-800 mb-1">@(((decimal)ViewBag.MonthRevenue).ToString("N0"))<small class="fs-6 fw-bold"> đ</small></h3>
            <div class="text-muted small fw-bold text-uppercase ls-1" style="font-size:0.65rem;">Doanh thu tháng @DateTime.Now.Month</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-info bg-opacity-10 p-2 rounded-3">
                    <i class="bi bi-calendar-check text-info fs-4"></i>
                </div>
            </div>
            <h3 class="fw-800 mb-1">@ViewBag.NewBookingsThisMonth</h3>
            <div class="text-muted small fw-bold text-uppercase ls-1" style="font-size:0.65rem;">Đơn đặt mới tháng này</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-success bg-opacity-10 p-2 rounded-3">
                    <i class="bi bi-car-front text-success fs-4"></i>
                </div>
            </div>
            <h3 class="fw-800 mb-1">@ViewBag.RentedCars</h3>
            <div class="text-muted small fw-bold text-uppercase ls-1" style="font-size:0.65rem;">Xe đang cho thuê</div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div class="bg-danger bg-opacity-10 p-2 rounded-3">
                    <i class="bi bi-tools text-danger fs-4"></i>
                </div>
            </div>
            <h3 class="fw-800 mb-1">@ViewBag.MaintenanceCars</h3>
            <div class="text-muted small fw-bold text-uppercase ls-1" style="font-size:0.65rem;">Xe đang bảo trì</div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- Revenue Chart -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <h6 class="fw-800 mb-4 ls-1 text-uppercase text-muted" style="font-size:0.75rem;">Biểu đồ Doanh thu (Triệu VNĐ)</h6>
            <canvas id="revenueChart" style="max-height: 300px;"></canvas>
        </div>
    </div>
    <!-- Booking Search Mix -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm rounded-4 p-4 h-100">
            <h6 class="fw-800 mb-4 ls-1 text-uppercase text-muted" style="font-size:0.75rem;">Phân bổ trạng thái Đơn đặt</h6>
            <div class="d-flex align-items-center justify-content-center mb-4" style="height: 200px;">
                <canvas id="statusChart"></canvas>
            </div>
            <div class="mt-auto">
                <div class="d-flex justify-content-between mb-2 small">
                    <span class="text-muted">Tổng tích lũy</span>
                    <span class="fw-bold">@(((decimal)ViewBag.TotalRevenue).ToString("N0")) đ</span>
                </div>
                <div class="d-flex justify-content-between small">
                    <span class="text-muted">Tổng đơn đặt</span>
                    <span class="fw-bold">@ViewBag.TotalBookings</span>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Top 5 Cars -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="fw-800 mb-4 ls-1 text-uppercase text-muted" style="font-size:0.75rem;">Top 5 Xe Hiệu Suất Cao</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <tbody>
                        @foreach (var item in topCars)
                        {
                            <tr>
                                <td style="width:50px;">
                                    <div class="rounded-3 bg-light overflow-hidden" style="width:40px;height:40px;">
                                        @if (item.Car.CarImages?.Any() == true) {
                                            <img src="@item.Car.CarImages.First().ImageUrl" class="w-100 h-100 object-fit-cover">
                                        } else {
                                            <i class="bi bi-car-front fs-5 text-muted p-2 d-block"></i>
                                        }
                                    </div>
                                </td>
                                <td>
                                    <div class="fw-bold small">@item.Car.CarBrand?.Name @item.Car.CarName</div>
                                    <small class="text-muted">@item.Car.LicensePlate</small>
                                </td>
                                <td class="text-end">
                                    <div class="fw-bold small">@item.RentalCount lượt</div>
                                    <small class="text-primary fw-bold" style="font-size: 0.7rem;">@item.TotalRevenue.ToString("N0") đ</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Maintenance Summary -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm rounded-4 p-4 shadow-sm" style="border-left: 5px solid #ef4444 !important;">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h6 class="fw-800 ls-1 text-uppercase text-muted mb-0" style="font-size:0.75rem;">Nhật ký bảo trì gần đây</h6>
                <span class="badge bg-danger rounded-pill px-3 py-1 fw-bold">Chi phí năm: @(((decimal)ViewBag.MaintenanceCostYear).ToString("N0")) đ</span>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <tbody>
                        @foreach (var log in ViewBag.MaintenanceLogs as List<CarRentalSystem.Models.MaintenanceLog>)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold small">@log.Car?.CarBrand?.Name @log.Car?.CarName</div>
                                    <small class="text-muted">@log.Description</small>
                                </td>
                                <td class="text-end">
                                    <div class="small fw-500">@log.ServiceDate.ToString("dd/MM/yyyy")</div>
                                    <small class="text-danger fw-bold">@log.Cost.ToString("N0") đ</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Top 5 Customers -->
    <div class="col-lg-12 mt-4">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <h6 class="fw-800 mb-4 ls-1 text-uppercase text-muted" style="font-size:0.75rem;">Khách hàng VIP (Doanh thu cao nhất)</h6>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr class="small fw-bold text-muted">
                            <th class="ps-3">Khách hàng</th>
                            <th class="text-center">Số đơn</th>
                            <th class="text-end pe-3">Tổng chi tiêu</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in topCustomers)
                        {
                            <tr>
                                <td class="ps-3">
                                    <div class="d-flex align-items-center gap-2">
                                        <img src="https://ui-avatars.com/api/?name=@Uri.EscapeDataString(item.User?.Name ?? "?")&background=random" width="30" height="30" class="rounded-circle">
                                        <div>
                                            <div class="fw-bold small">@item.User?.Name</div>
                                            <small class="text-muted" style="font-size:0.7rem;">@item.User?.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="text-center fw-bold">@item.BookingCount</td>
                                <td class="text-end pe-3 fw-800 text-success">@item.TotalSpent.ToString("N0") đ</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        // Revenue Chart
        const ctxRev = document.getElementById('revenueChart').getContext('2d');
        new Chart(ctxRev, {
            type: 'line',
            data: {
                labels: @Html.Raw(Json.Serialize(revenueLabels)),
                datasets: [{
                    label: 'Doanh thu (Triệu VNĐ)',
                    data: @Html.Raw(Json.Serialize(revenueData)),
                    borderColor: '#3b82f6',
                    backgroundColor: 'rgba(59, 130, 246, 0.1)',
                    borderWidth: 3,
                    fill: true,
                    tension: 0.4,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#3b82f6',
                    pointBorderWidth: 2,
                    pointRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, grid: { borderDash: [5, 5] }, ticks: { font: { weight: 'bold' } } },
                    x: { grid: { display: false }, ticks: { font: { weight: 'bold' } } }
                }
            }
        });

        // Status Chart
        const ctxStatus = document.getElementById('statusChart').getContext('2d');
        new Chart(ctxStatus, {
            type: 'doughnut',
            data: {
                labels: ['Chờ duyệt', 'Xác nhận', 'Hoàn thành', 'Đã hủy'],
                datasets: [{
                    data: [@statusGroups["Pending"], @statusGroups["Confirmed"], @statusGroups["Completed"], @statusGroups["Cancelled"]],
                    backgroundColor: ['#f59e0b', '#06b6d4', '#10b981', '#ef4444'],
                    borderWidth: 0,
                    hoverOffset: 10
                }]
            },
            options: {
                responsive: true,
                cutout: '75%',
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { usePointStyle: true, padding: 20, font: { weight: 'bold', size: 11 } }
                    }
                }
            }
        });
    </script>
}
