@model List<CarRentalSystem.Models.Booking>
@{
    ViewData["Title"] = "Đơn xe trong khu vực";
    Layout = "_AdminLayout";
    var driverMap = ViewBag.DriverMap as Dictionary<int, CarRentalSystem.Models.Driver> ?? new Dictionary<int, CarRentalSystem.Models.Driver>();
    var statuses = ViewBag.BookingStatuses as List<CarRentalSystem.Models.BookingStatus> ?? new List<CarRentalSystem.Models.BookingStatus>();
    var currentRole = ViewBag.CurrentRole as string ?? "";
}

<div class="theme-admin">
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-geo-alt-fill me-2 text-primary"></i>Đơn xe trong khu vực</h4>
        <p class="text-muted mb-0 small">
            @if (currentRole == "Staff")
            {
                <text>Chỉ hiển thị đơn trong khu vực bạn được phân công quản lý.</text>
            }
            else
            {
                <text>Quản lý tất cả đơn xe theo khu vực.</text>
            }
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <span class="badge bg-dark bg-opacity-75 rounded-pill px-3 py-2">@Model.Count đơn</span>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Filter Bar -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">Tìm kiếm</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                       placeholder="Mã đơn, tên KH, biển số..." />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">Tất cả</option>
                    @foreach (var s in statuses)
                    {
                        <option value="@s.Name" selected="@(ViewBag.Status?.ToString() == s.Name ? "selected" : null)">@UiLabels.BookingStatus(s.Name)</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-bold text-muted">Ngày đặt</label>
                <input type="date" name="date" value="@ViewBag.Date" class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100 rounded-pill">
                    <i class="bi bi-filter me-1"></i>Lọc
                </button>
            </div>
            <div class="col-md-2">
                <a asp-action="Index" class="btn btn-outline-secondary w-100 rounded-pill">
                    <i class="bi bi-x-circle me-1"></i>Xóa lọc
                </a>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5">
        <i class="bi bi-clipboard-x display-1 text-muted opacity-25"></i>
        <h5 class="mt-3 text-muted">Không có đơn xe nào</h5>
        <p class="text-muted small">Không tìm thấy đơn nào phù hợp với điều kiện lọc.</p>
    </div>
}
else
{
    <div class="card border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Điểm đón</th>
                        <th>Điểm trả</th>
                        <th>Tài xế được gán</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center">Thời gian đặt</th>
                        <th class="text-end pe-4">Tổng tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        var driver = b.DriverBookingID.HasValue && driverMap.ContainsKey(b.DriverBookingID.Value)
                            ? driverMap[b.DriverBookingID.Value] : null;
                        var statusBadge = b.BookingStatus?.Name switch
                        {
                            "Draft" => "bg-secondary",
                            "Pending" => "bg-warning text-dark",
                            "Confirmed" => "bg-info",
                            "Active" => "bg-success",
                            "Completed" => "bg-primary",
                            "Cancelled" => "bg-danger",
                            _ => "bg-secondary"
                        };

                        <tr>
                            <td class="ps-4">
                                <a asp-area="Admin" asp-controller="Booking" asp-action="Details" asp-route-id="@b.BookingID"
                                   class="fw-bold text-primary text-decoration-none">#@b.BookingID</a>
                            </td>
                            <td>
                                <div class="fw-bold">@(b.User?.Name ?? "—")</div>
                                <small class="text-muted">@(b.User?.Phone ?? "")</small>
                            </td>
                            <td>
                                <div class="small">@(b.PickupLocation?.Name ?? b.DeliveryAddress ?? "—")</div>
                            </td>
                            <td>
                                <div class="small">@(b.ReturnLocation?.Name ?? "—")</div>
                            </td>
                            <td>
                                @if (driver != null)
                                {
                                    <div class="small fw-bold">@(driver.FullName)</div>
                                    <small class="text-muted">@(driver.Phone)</small>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa gán</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @statusBadge rounded-pill px-3 py-2">
                                    @UiLabels.BookingStatus(b.BookingStatus?.Name)
                                </span>
                            </td>
                            <td class="text-center">
                                <div class="small">@b.CreatedAt.ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@b.CreatedAt.ToString("HH:mm")</small>
                            </td>
                            <td class="text-end pe-4 fw-bold">@b.TotalPrice.ToString("N0")đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    }
</div>
}
