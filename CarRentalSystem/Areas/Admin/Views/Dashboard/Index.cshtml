@using CarRentalSystem.Areas.Admin.Models
@model DashboardViewModel
@{
    ViewData["Title"] = "Trung tâm Điều hành Smart Car";
    Layout = "_AdminLayout";
}

<div class="page-admin-dashboard">
<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">Tổng quan Hệ thống</h2>
        <p class="text-muted mb-0">Hiệu suất vận hành thời gian thực của đội xe và doanh thu.</p>
    </div>
    <div class="d-flex gap-3">
        <div class="bg-white px-3 py-2 rounded-4 shadow-sm border border-light d-flex align-items-center sys-time-box">
            <div class="me-3 bg-primary bg-opacity-10 p-2 rounded-3 text-primary">
                <i class="bi bi-clock-fill"></i>
            </div>
            <div>
                <small class="text-muted d-block fw-700 text-uppercase ls-1" style="font-size: 0.6rem;">Hệ thống</small>
                <span class="fw-800 small text-dark" id="liveTime">@DateTime.Now.ToString("HH:mm - dd/MM/yyyy")</span>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card stat-card stat-revenue h-100">
            <div class="position-relative z-1 text-white">
                <small class="text-white text-opacity-75 text-uppercase fw-700 ls-1 mb-2 d-block" style="font-size: 0.65rem;">Tổng Doanh thu</small>
                <h2 class="fw-800 mb-0 ls-neg-1">@Model.TotalRevenue.ToString("N0") <small class="fs-6 fw-light">đ</small></h2>
                <div class="mt-3 fs-6 p-2 rounded-pill bg-white bg-opacity-10 d-inline-flex align-items-center" style="font-size: 0.75rem !important;">
                    <i class="bi bi-graph-up-arrow me-1"></i> Tăng trưởng ổn định
                </div>
            </div>
            <i class="bi bi-currency-dollar position-absolute text-white opacity-10 stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-bookings h-100">
            <div class="position-relative z-1">
                <small class="text-muted text-uppercase fw-700 ls-1 mb-2 d-block" style="font-size: 0.65rem;">Tổng số chuyến xe</small>
                <h2 class="fw-800 mb-0 ls-neg-1">@Model.TotalBookings</h2>
                <div class="mt-3 fs-6 p-2 rounded-pill bg-success bg-opacity-10 d-inline-flex align-items-center text-success" style="font-size: 0.75rem !important;">
                    <i class="bi bi-bag-check-fill me-1"></i> Đang xử lý tốt
                </div>
            </div>
            <i class="bi bi-calendar-check position-absolute text-primary opacity-5 stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-fleet h-100">
            <div class="position-relative z-1">
                <small class="text-muted text-uppercase fw-700 ls-1 mb-2 d-block" style="font-size: 0.65rem;">Tình trạng Đội xe</small>
                <h2 class="fw-800 mb-0 ls-neg-1">@((Model.RentedCars * 100 / (Model.TotalCars > 0 ? Model.TotalCars : 1)))%</h2>
                <div class="mt-3 fs-6 p-2 rounded-pill bg-warning bg-opacity-10 d-inline-flex align-items-center text-warning" style="font-size: 0.75rem !important;">
                    <i class="bi bi-car-front-fill me-1"></i> @Model.RentedCars xe đang thuê
                </div>
            </div>
            <i class="bi bi-truck position-absolute text-warning opacity-5 stat-icon"></i>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card stat-card stat-available h-100">
            <div class="position-relative z-1">
                <small class="text-muted text-uppercase fw-700 ls-1 mb-2 d-block" style="font-size: 0.65rem;">Khả năng đáp ứng</small>
                <h2 class="fw-800 mb-0 ls-neg-1">@Model.AvailableCars</h2>
                <div class="mt-3 fs-6 p-2 rounded-pill bg-info bg-opacity-10 d-inline-flex align-items-center text-info" style="font-size: 0.75rem !important;">
                    <i class="bi bi-check2-circle me-1"></i> Xe sẵn sàng
                </div>
            </div>
            <i class="bi bi-box-seam position-absolute text-info opacity-5 stat-icon"></i>
        </div>
    </div>
    <div class="col-md-12 mt-4">
        <div class="card stat-card-deposit h-100">
            <div class="position-relative z-1 text-white d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-800 text-warning d-flex align-items-center mb-2"><i class="bi bi-shield-lock-fill me-2 fs-4"></i> Tài sản Cọc Đang Giữ chờ Phạt Nguội</h5>
                    <p class="text-white-50 mb-0 small">Hệ thống đang tạm giam <strong>@Model.TotalHeldDepositsCount</strong> khoản cọc chưa hoàn trả (Tối đa 15 ngày).</p>
                </div>
                <div class="text-end">
                    <h2 class="fw-800 mb-0 text-white ls-neg-1">@Model.TotalHeldDepositsAmount.ToString("N0") <small class="fs-6 fw-light text-white-50">đ</small></h2>
                </div>
            </div>
            <i class="bi bi-safe2 position-absolute text-white opacity-5 stat-icon-lg"></i>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- Chart Section -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4 h-100 chart-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h5 class="fw-800 ls-neg-1 mb-0">Phân tích Doanh thu</h5>
                    <small class="text-muted">Đơn vị: Triệu VNĐ</small>
                </div>
                <div class="btn-group p-1 bg-light rounded-4">
                    <button class="btn btn-white btn-sm shadow-sm rounded-3">6 Tháng</button>
                    <button class="btn btn-sm">Theo tuần</button>
                </div>
            </div>
            <div class="flex-grow-1 d-flex flex-column justify-content-center">
                <canvas id="revenueChart" style="height: 320px;"></canvas>
            </div>
        </div>
    </div>

    <!-- Top Performing Vehicles -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm p-4 h-100 top-cars-card">
            <h5 class="fw-800 ls-neg-1 mb-4">Xe Hiệu suất Cao</h5>
            <div class="d-flex flex-column gap-4">
                @foreach (var topCar in Model.TopCars)
                {
                    <div class="d-flex align-items-center p-3 rounded-4 bg-light bg-opacity-50 transition-all hover-translate-y top-car-item">
                        <div class="position-relative me-3">
                            <span class="position-absolute top-0 start-0 translate-middle badge rounded-pill bg-primary shadow-sm" style="font-size: 0.6rem;">#@(Model.TopCars.IndexOf(topCar) + 1)</span>
                            <div class="rounded-circle bg-white shadow-sm p-2 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                                <i class="bi bi-car-front text-primary fs-4"></i>
                            </div>
                        </div>
                        <div class="flex-grow-1">
                            <h6 class="fw-800 mb-0 small">@topCar.Car.CarBrand?.Name @topCar.Car.CarName</h6>
                            <small class="text-muted d-block">@topCar.RentalCount lượt thuê</small>
                        </div>
                        <div class="text-end">
                            <span class="fw-bold text-primary small">@((topCar.TotalRevenue / 1000000).ToString("N1")) tr</span>
                        </div>
                    </div>
                }
                @if (!Model.TopCars.Any())
                {
                    <div class="text-center py-4 text-muted opacity-50">Chưa có dữ liệu thuê xe.</div>
                }
            </div>
        </div>
    </div>
</div>
