@using CarRentalSystem.Areas.Admin.Models
@using CarRentalSystem.Models
@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard điều hành";
    string BookingTone(string? status) => status switch
    {
        BookingStatusConstants.Completed => "admin-status-success",
        BookingStatusConstants.Confirmed or BookingStatusConstants.Active => "admin-status-info",
        BookingStatusConstants.Pending or BookingStatusConstants.Unpaid => "admin-status-warning",
        BookingStatusConstants.Cancelled or BookingStatusConstants.Rejected or BookingStatusConstants.Expired => "admin-status-danger",
        _ => "admin-status-neutral"
    };
    string PaymentTone(string? status) => status switch
    {
        PaymentStatusConstants.Paid => "admin-status-success",
        PaymentStatusConstants.Pending or PaymentStatusConstants.Processing => "admin-status-warning",
        PaymentStatusConstants.Failed or PaymentStatusConstants.Cancelled => "admin-status-danger",
        _ => "admin-status-neutral"
    };
    string SupportTone(string? status) => status switch
    {
        SupportTicketStatusConstants.Resolved or SupportTicketStatusConstants.Closed => "admin-status-success",
        SupportTicketStatusConstants.InProgress => "admin-status-info",
        SupportTicketStatusConstants.Open => "admin-status-warning",
        _ => "admin-status-neutral"
    };
}

<script>
    window.dashboardData = @Html.Raw(Json.Serialize(new
    {
        depositLabels = Model.DepositLabels,
        depositData = Model.DepositData,
        bookingLabels = Model.BookingLabels.Select(UiLabels.BookingStatus),
        bookingData = Model.BookingData,
        carLabels = Model.CarLabels.Select(UiLabels.CarStatus),
        carData = Model.CarData
    }));
</script>

<div class="page-admin-dashboard">
    <div class="page-header">
        <div>
            <h2>Trung tâm điều hành</h2>
            <p>Tổng quan vận hành theo ngày nghiệp vụ Việt Nam @Model.BusinessDate.ToString("dd/MM/yyyy").</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Enterprise" asp-action="Index"><i class="bi bi-command"></i> Command center</a>
            <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="StartupKpi" asp-action="Index"><i class="bi bi-bullseye"></i> KPI startup</a>
            <a class="btn btn-primary" asp-area="Admin" asp-controller="Reports" asp-action="Index"><i class="bi bi-bar-chart"></i> Xem báo cáo</a>
        </div>
    </div>

    @if (Model.HasLoadError)
    {
        <div class="alert alert-warning admin-flash-alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@Model.LoadErrorMessage</span>
            <a class="btn btn-sm btn-outline-warning ms-auto" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Tải lại</a>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-xl-3 col-md-6"><a class="text-decoration-none" asp-area="Admin" asp-controller="User" asp-action="Index"><div class="admin-kpi-card"><span class="admin-kpi-icon"><i class="bi bi-people-fill"></i></span><div class="admin-kpi-value">@Model.TotalUsers.ToString("N0")</div><div class="admin-kpi-label">Tổng người dùng</div><div class="admin-kpi-note">@Model.PendingEkyc.ToString("N0") eKYC đang chờ</div></div></a></div>
        <div class="col-xl-3 col-md-6"><a class="text-decoration-none" asp-area="Admin" asp-controller="Car" asp-action="Manage"><div class="admin-kpi-card"><span class="admin-kpi-icon"><i class="bi bi-car-front-fill"></i></span><div class="admin-kpi-value">@Model.TotalCars.ToString("N0")</div><div class="admin-kpi-label">Tổng xe</div><div class="admin-kpi-note">@Model.AvailableCars.ToString("N0") xe sẵn sàng</div></div></a></div>
        <div class="col-xl-3 col-md-6"><a class="text-decoration-none" asp-area="Admin" asp-controller="Booking" asp-action="Index"><div class="admin-kpi-card"><span class="admin-kpi-icon"><i class="bi bi-calendar2-check-fill"></i></span><div class="admin-kpi-value">@Model.TodayBookings.ToString("N0")</div><div class="admin-kpi-label">Booking hôm nay</div><div class="admin-kpi-note">@Model.TotalBookings.ToString("N0") booking đang hiển thị</div></div></a></div>
        <div class="col-xl-3 col-md-6"><a class="text-decoration-none" asp-area="Admin" asp-controller="Reports" asp-action="Index"><div class="admin-kpi-card"><span class="admin-kpi-icon"><i class="bi bi-cash-coin"></i></span><div class="admin-kpi-value">@Model.TodayDepositAmount.ToString("N0") đ</div><div class="admin-kpi-label">Tiền cọc hôm nay</div><div class="admin-kpi-note">DepositCharge đã hạch toán</div></div></a></div>
        <div class="col-xl-3 col-md-6"><a class="text-decoration-none" asp-area="Admin" asp-controller="Booking" asp-action="Index" asp-route-status="@BookingStatusConstants.Pending"><div class="admin-kpi-card"><span class="admin-kpi-icon"><i class="bi bi-hourglass-split"></i></span><div class="admin-kpi-value">@Model.PendingBookings.ToString("N0")</div><div class="admin-kpi-label">Booking chờ xử lý</div><div class="admin-kpi-note">@Model.OverdueBookings.ToString("N0") lượt trả xe quá hạn</div></div></a></div>
        <div class="col-xl-3 col-md-6"><a class="text-decoration-none" asp-area="Admin" asp-controller="Car" asp-action="Manage"><div class="admin-kpi-card"><span class="admin-kpi-icon"><i class="bi bi-key-fill"></i></span><div class="admin-kpi-value">@Model.RentedCars.ToString("N0")</div><div class="admin-kpi-label">Xe đang thuê</div><div class="admin-kpi-note">@Model.CancellationRate30Days.ToString("N1")% tỷ lệ hủy 30 ngày</div></div></a></div>
        <div class="col-xl-3 col-md-6"><a class="text-decoration-none" asp-area="Admin" asp-controller="Maintenance" asp-action="Index"><div class="admin-kpi-card"><span class="admin-kpi-icon"><i class="bi bi-tools"></i></span><div class="admin-kpi-value">@Model.MaintenanceCars.ToString("N0")</div><div class="admin-kpi-label">Xe bảo trì</div><div class="admin-kpi-note">@Model.MaintenanceDueSoon.ToString("N0") xe đến hạn trong 14 ngày</div></div></a></div>
        <div class="col-xl-3 col-md-6"><a class="text-decoration-none" asp-area="Admin" asp-controller="Support" asp-action="Index"><div class="admin-kpi-card"><span class="admin-kpi-icon"><i class="bi bi-headset"></i></span><div class="admin-kpi-value">@Model.OpenSupportTickets.ToString("N0")</div><div class="admin-kpi-label">Ticket chưa xử lý</div><div class="admin-kpi-note">Theo hàng đợi Support</div></div></a></div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap mb-3">
                <div><h5 class="mb-1 fw-bold">Quick actions</h5><span class="text-muted small">Truy cập nhanh các hàng đợi cần xử lý.</span></div>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="CarApproval" asp-action="Index"><i class="bi bi-check2-square"></i> Duyệt xe (@Model.PendingApprovalCars)</a>
                <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Booking" asp-action="Index" asp-route-status="@BookingStatusConstants.Pending"><i class="bi bi-calendar-plus"></i> Booking mới</a>
                <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Payment" asp-action="Index"><i class="bi bi-credit-card"></i> Thanh toán</a>
                <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Support" asp-action="Index"><i class="bi bi-headset"></i> Support tickets</a>
                <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="StartupKpi" asp-action="Index"><i class="bi bi-bullseye"></i> KPI startup</a>
                <a class="btn btn-outline-primary" asp-area="Admin" asp-controller="Reports" asp-action="Index"><i class="bi bi-file-earmark-bar-graph"></i> Báo cáo</a>
            </div>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-lg-7">
            <div class="card h-100">
                <div class="card-header"><div><h5 class="mb-1 fw-bold">Tiền cọc 7 ngày</h5><small class="text-muted">Đơn vị: triệu VNĐ</small></div></div>
                <div class="card-body"><div class="admin-chart-height"><canvas id="revenueChart"></canvas></div></div>
            </div>
        </div>
        <div class="col-lg-5">
            <div class="row g-3 h-100">
                <div class="col-sm-6 col-lg-12 col-xl-6"><div class="card h-100"><div class="card-header"><h6 class="mb-0 fw-bold">Booking theo trạng thái</h6></div><div class="card-body"><div class="admin-chart-height admin-chart-height-sm"><canvas id="bookingsChart"></canvas></div></div></div></div>
                <div class="col-sm-6 col-lg-12 col-xl-6"><div class="card h-100"><div class="card-header"><h6 class="mb-0 fw-bold">Xe theo trạng thái</h6></div><div class="card-body"><div class="admin-chart-height admin-chart-height-sm"><canvas id="carsChart"></canvas></div></div></div></div>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header d-flex align-items-center justify-content-between"><h5 class="mb-0 fw-bold"><i class="bi bi-exclamation-triangle text-warning me-2"></i>Cảnh báo vận hành</h5><a asp-area="Admin" asp-controller="Enterprise" asp-action="Index" class="btn btn-sm btn-outline-secondary">Xem toàn bộ</a></div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-lg col-sm-6"><div class="admin-warning-tile"><span class="admin-status-badge @(Model.OverdueBookings > 0 ? "admin-status-danger" : "admin-status-success")">@Model.OverdueBookings</span><strong>Booking quá hạn</strong><small>Đang thuê nhưng quá ngày trả.</small></div></div>
                <div class="col-lg col-sm-6"><div class="admin-warning-tile"><span class="admin-status-badge @(Model.MaintenanceDueSoon > 0 ? "admin-status-warning" : "admin-status-success")">@Model.MaintenanceDueSoon</span><strong>Xe cần bảo trì</strong><small>Đến hạn trong 14 ngày tới.</small></div></div>
                <div class="col-lg col-sm-6"><div class="admin-warning-tile"><span class="admin-status-badge @(Model.StalePendingPayments > 0 ? "admin-status-danger" : "admin-status-success")">@Model.StalePendingPayments</span><strong>Payment pending lâu</strong><small>Chờ xử lý trên 24 giờ.</small></div></div>
                <div class="col-lg col-sm-6"><div class="admin-warning-tile"><span class="admin-status-badge @(Model.PendingEkyc > 0 ? "admin-status-warning" : "admin-status-success")">@Model.PendingEkyc</span><strong>eKYC chờ xác minh</strong><small>Khách hàng chưa đủ xác minh.</small></div></div>
                <div class="col-lg col-sm-6"><div class="admin-warning-tile"><span class="admin-status-badge @(Model.HighRiskUsers > 0 ? "admin-status-danger" : "admin-status-success")">@Model.HighRiskUsers</span><strong>Khách hàng rủi ro</strong><small>High/Critical trong 30 ngày.</small></div></div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between"><h5 class="mb-0 fw-bold">Booking mới nhất</h5><a asp-area="Admin" asp-controller="Booking" asp-action="Index" class="btn btn-sm btn-outline-secondary">Xem tất cả</a></div>
                @if (Model.RecentBookings.Count == 0) { <partial name="_AdminEmptyState" model="@(new EmptyStateViewModel { Icon = "bi-calendar-x", Title = "Chưa có booking", Message = "Booking mới sẽ xuất hiện tại đây." })" /> }
                else { <div class="table-responsive"><table class="table"><thead><tr><th>Mã</th><th>Khách hàng</th><th>Xe</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var item in Model.RecentBookings) { <tr><td>#@item.BookingID</td><td><strong>@(item.User?.Name ?? "—")</strong><small class="d-block text-muted">@item.CreatedAt.ToString("dd/MM HH:mm")</small></td><td>@(item.Car?.CarBrand?.Name) @(item.Car?.CarName)</td><td><span class="admin-status-badge @BookingTone(item.BookingStatus?.Name)">@UiLabels.BookingStatus(item.BookingStatus?.Name)</span></td><td><a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Booking" asp-action="Details" asp-route-id="@item.BookingID"><i class="bi bi-eye"></i></a></td></tr> }</tbody></table></div> }
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between"><h5 class="mb-0 fw-bold">Xe chờ duyệt</h5><a asp-area="Admin" asp-controller="CarApproval" asp-action="Index" class="btn btn-sm btn-outline-secondary">Mở hàng đợi</a></div>
                @if (Model.PendingCars.Count == 0) { <partial name="_AdminEmptyState" model="@(new EmptyStateViewModel { Icon = "bi-car-front", Title = "Không có xe chờ duyệt", Message = "Hàng đợi duyệt xe hiện đã được xử lý hết." })" /> }
                else { <div class="table-responsive"><table class="table"><thead><tr><th>Xe</th><th>Biển số</th><th>Chủ xe</th><th>Ngày gửi</th><th></th></tr></thead><tbody>@foreach (var item in Model.PendingCars) { <tr><td><strong>@item.CarBrand?.Name @item.CarName</strong></td><td>@item.LicensePlate</td><td>@(item.Owner?.Name ?? "Nền tảng")</td><td>@item.CreatedAt.ToString("dd/MM/yyyy")</td><td><a class="btn btn-sm btn-outline-primary" asp-area="Admin" asp-controller="Car" asp-action="Details" asp-route-id="@item.CarID"><i class="bi bi-eye"></i></a></td></tr> }</tbody></table></div> }
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between"><h5 class="mb-0 fw-bold">Thanh toán gần đây</h5><a asp-area="Admin" asp-controller="Payment" asp-action="Index" class="btn btn-sm btn-outline-secondary">Xem tất cả</a></div>
                @if (Model.RecentPayments.Count == 0) { <partial name="_AdminEmptyState" model="@(new EmptyStateViewModel { Icon = "bi-credit-card", Title = "Chưa có thanh toán", Message = "Giao dịch mới sẽ xuất hiện tại đây." })" /> }
                else { <div class="table-responsive"><table class="table"><thead><tr><th>Đơn</th><th>Khách hàng</th><th>Số tiền</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var item in Model.RecentPayments) { <tr><td>#@item.BookingID</td><td>@(item.Booking?.User?.Name ?? "—")</td><td><strong>@item.Amount.ToString("N0") đ</strong><small class="d-block text-muted">@item.PaymentDate.ToString("dd/MM HH:mm")</small></td><td><span class="admin-status-badge @PaymentTone(item.PaymentStatus)">@UiLabels.PaymentStatus(item.PaymentStatus)</span></td></tr> }</tbody></table></div> }
            </div>
        </div>
        <div class="col-xl-6">
            <div class="card h-100">
                <div class="card-header d-flex align-items-center justify-content-between"><h5 class="mb-0 fw-bold">Support tickets mới</h5><a asp-area="Admin" asp-controller="Support" asp-action="Index" class="btn btn-sm btn-outline-secondary">Mở queue</a></div>
                @if (Model.RecentSupportTickets.Count == 0) { <partial name="_AdminEmptyState" model="@(new EmptyStateViewModel { Icon = "bi-headset", Title = "Chưa có ticket", Message = "Ticket hỗ trợ mới sẽ xuất hiện tại đây." })" /> }
                else { <div class="table-responsive"><table class="table"><thead><tr><th>Ticket</th><th>Khách hàng</th><th>Ưu tiên</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var item in Model.RecentSupportTickets) { <tr><td><strong>#@item.SupportTicketID @item.Subject</strong><small class="d-block text-muted">@item.CreatedAt.ToString("dd/MM HH:mm")</small></td><td>@(item.User?.Name ?? "—")</td><td><span class="badge bg-secondary">@item.Priority</span></td><td><span class="admin-status-badge @SupportTone(item.Status)">@UiLabels.GenericStatus(item.Status)</span></td></tr> }</tbody></table></div> }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/chart.min.js"></script>
    <script src="~/js/admin/dashboard.js" asp-append-version="true"></script>
}
