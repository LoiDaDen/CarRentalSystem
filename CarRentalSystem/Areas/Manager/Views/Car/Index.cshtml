@model IReadOnlyList<Car>
@{
    ViewData["Title"] = "Quản lý xe";
}
<h1 class="portal-page-title h3 mb-4">Quản lý xe trong khu vực</h1>
<div class="portal-card"><div class="table-responsive"><table class="table portal-table"><thead><tr><th>Xe</th><th>Biển số</th><th>Địa điểm</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach(var car in Model){<tr><td>@car.CarBrand?.Name @car.CarName</td><td>@car.LicensePlate</td><td>@car.Location?.Name</td><td>@car.CarStatus?.Name</td><td class="portal-task-actions"><form asp-action="UpdateStatus" method="post"><input type="hidden" name="id" value="@car.CarID"/><input type="hidden" name="status" value="Available"/><button class="btn btn-sm btn-outline-success">Sẵn sàng</button></form><form asp-action="UpdateStatus" method="post"><input type="hidden" name="id" value="@car.CarID"/><input type="hidden" name="status" value="Maintenance"/><button class="btn btn-sm btn-outline-warning">Bảo trì</button></form></td></tr>}
</tbody></table></div></div>
