@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    string Active(string value) => controller == value ? "active" : "";
}
<aside class="portal-sidebar manager-sidebar" id="portalSidebar">
    <a asp-area="Manager" asp-controller="Dashboard" asp-action="Index" class="portal-brand">
        <img src="~/images/car_rental_logo.png" alt="" />
        <span><strong>Manager Portal</strong><small>Điều hành khu vực</small></span>
    </a>
    @await Html.PartialAsync("_ManagerAreaSelector")
    <nav class="portal-nav">
        <a class="@Active("Dashboard")" data-tutorial-target="manager-dashboard" asp-area="Manager" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-speedometer2"></i>Dashboard KPI</a>
        <a class="@Active("Booking")" data-tutorial-target="manager-bookings" asp-area="Manager" asp-controller="Booking" asp-action="Index"><i class="bi bi-calendar2-check"></i>Quản lý booking</a>
        <a class="@Active("Car")" asp-area="Manager" asp-controller="Car" asp-action="Index"><i class="bi bi-car-front"></i>Quản lý xe</a>
        <a class="@Active("CarApproval")" asp-area="Manager" asp-controller="CarApproval" asp-action="Index"><i class="bi bi-shield-check"></i>Duyệt xe</a>
        <a class="@Active("Staff")" data-tutorial-target="manager-staff" asp-area="Manager" asp-controller="Staff" asp-action="Index"><i class="bi bi-people"></i>Quản lý nhân viên</a>
        <a class="@Active("Operation")" data-tutorial-target="manager-operations" asp-area="Manager" asp-controller="Operation" asp-action="Index"><i class="bi bi-kanban"></i>Vận hành</a>
        <a class="@Active("Report")" data-tutorial-target="manager-reports" asp-area="Manager" asp-controller="Report" asp-action="Index"><i class="bi bi-bar-chart"></i>Báo cáo</a>
        <a class="@Active("Revenue")" data-tutorial-target="manager-revenue" asp-area="Manager" asp-controller="Revenue" asp-action="Index"><i class="bi bi-cash-stack"></i>GMV khu vực</a>
        <a class="@Active("Profile")" asp-area="Manager" asp-controller="Profile" asp-action="Index"><i class="bi bi-person"></i>Hồ sơ cá nhân</a>
    </nav>
</aside>
