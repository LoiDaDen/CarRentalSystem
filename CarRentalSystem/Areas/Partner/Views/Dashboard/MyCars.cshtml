@model IEnumerable<CarRentalSystem.Models.Car>
@{
    ViewData["Title"] = "Đội xe của tôi";
    Layout = "_AdminLayout"; // hoặc Partner layout tùy, tạm giữ
}

<div class="page-partner-mycars">
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-800 mb-1 text-dark">Đội xe của tôi</h4>
        <p class="text-muted mb-0 small">Quản lý và theo dõi tất cả xe trên sàn SmartRental.</p>
    </div>
    <a asp-area="Partner" asp-controller="Dashboard" asp-action="AddCar" class="btn btn-warning rounded-pill px-4 fw-bold shadow-sm">
        <i class="bi bi-plus-lg me-2"></i>Thêm xe mới
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center card border-0 shadow-sm rounded-4 p-5">
        <i class="bi bi-car-front display-3 text-muted opacity-25 mb-4 d-block"></i>
        <h5 class="text-dark fw-700">Bạn chưa có xe nào trên sàn</h5>
        <p class="text-muted mb-4">Đăng xe đầu tiên để bắt đầu kiếm thêm thu nhập thụ động!</p>
        <div class="d-flex justify-content-center gap-3">
            <a asp-area="Partner" asp-controller="Dashboard" asp-action="AddCar" class="btn btn-warning rounded-pill px-5 fw-bold">
                <i class="bi bi-plus-circle me-2"></i>Đăng xe ngay
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var car in Model)
        {
            var statusBadge = car.CarStatus?.Name switch {
                "Available" => "badge-available",
                "Rented" => "badge-rented",
                "Pending" => "badge-pending",
                "Maintenance" => "badge-maintenance",
                _ => "bg-secondary text-white"
            };
            var statusText = car.CarStatus?.Name switch {
                "Available" => "Sẵn sàng",
                "Rented" => "Đang cho thuê",
                "Pending" => "Chờ phê duyệt",
                "Maintenance" => "Đang bảo trì",
                _ => car.CarStatus?.Name
            };
            var statusIcon = car.CarStatus?.Name switch {
                "Available" => "bi-check-circle-fill",
                "Rented" => "bi-key-fill",
                "Pending" => "bi-hourglass-split",
                "Maintenance" => "bi-tools",
                _ => "bi-question-circle"
            };

            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 overflow-hidden h-100 car-card-partner">
                    <div class="position-relative">
                        @if (!string.IsNullOrEmpty(car.ImageURL))
                        {
                            <img src="@car.ImageURL" alt="@car.CarName" class="card-img-top car-img-partner" style="height:200px;object-fit:cover;">
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light car-img-placeholder-partner">
                                <i class="bi bi-car-front display-4 text-muted opacity-25"></i>
                            </div>
                        }
                        <div class="position-absolute top-0 end-0 m-3">
                            <span class="badge @statusBadge rounded-pill px-3 py-2 shadow-sm status-badge-partner">
                                <i class="bi @statusIcon me-1"></i>@statusText
                            </span>
                        </div>
                        @if (car.IsPremium)
                        {
                            <div class="position-absolute top-0 start-0 m-3">
                                <span class="badge bg-warning text-dark rounded-pill px-2 py-1" style="font-size:0.65rem;">
                                    <i class="bi bi-star-fill me-1"></i>Premium
                                </span>
                            </div>
                        }
                    </div>
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <h6 class="fw-800 mb-0 text-dark">@car.CarBrand?.Name @car.CarName</h6>
                                <small class="text-muted">@car.CarType?.Name • @car.Seats chỗ</small>
                            </div>
                            <div class="text-end">
                                <div class="fw-800 text-dark">@car.PricePerDay.ToString("N0")đ</div>
                                <small class="text-muted">/ngày</small>
                            </div>
                        </div>

                        <div class="row g-2 my-3">
                            <div class="col-4 text-center">
                                <div class="bg-light rounded-3 py-2 car-stat-box">
                                    <i class="bi bi-fuel-pump text-muted small d-block mb-1"></i>
                                    <span class="fw-600 text-dark" style="font-size:0.7rem;">@car.FuelType</span>
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="bg-light rounded-3 py-2 car-stat-box">
                                    <i class="bi bi-gear text-muted small d-block mb-1"></i>
                                    <span class="fw-600 text-dark" style="font-size:0.7rem;">@(car.Transmission == "Tự động" ? "Số AT" : "Số MT")</span>
                                </div>
                            </div>
                            <div class="col-4 text-center">
                                <div class="bg-light rounded-3 py-2 car-stat-box">
                                    <i class="bi bi-geo-alt text-muted small d-block mb-1"></i>
                                    <span class="fw-600 text-dark text-truncate d-block px-1" style="font-size:0.65rem;">@(car.Location?.Name?.Split(",")[0] ?? "N/A")</span>
                                </div>
                            </div>
                        </div>

                        <div class="small text-muted mb-3">
                            <i class="bi bi-credit-card me-1"></i>Biển số: <strong class="text-dark">@car.LicensePlate</strong>
                            &nbsp;&nbsp;<i class="bi bi-bar-chart me-1"></i>Hoa hồng: <strong>@car.CommissionRate%</strong>
                        </div>

                        <div class="d-flex gap-2">
                            <a asp-area="Partner" asp-controller="Dashboard" asp-action="EditCar" asp-route-id="@car.CarID" class="btn btn-outline-primary btn-sm rounded-pill px-3 fw-bold">
                                <i class="bi bi-pencil me-1"></i>Chỉnh sửa
                            </a>
                            <a asp-area="Partner" asp-controller="Dashboard" asp-action="CarDetails" asp-route-id="@car.CarID" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                <i class="bi bi-eye me-1"></i>Chi tiết
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}