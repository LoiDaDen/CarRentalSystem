@model CarRentalSystem.Models.PartnerContract
@{
    ViewData["Title"] = "Chi tiết Hợp đồng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-1"><i class="bi bi-file-earmark-text me-2"></i>Hợp đồng #@Model.ContractNo</h4>
        <p class="text-muted mb-0 small">
            Trạng thái:
            @if (Model.Status == "Pending") { <span class="badge bg-warning text-dark">Chờ ký</span> }
            else if (Model.Status == "Active") { <span class="badge bg-success">Đã ký</span> }
            else if (Model.Status == "Expired") { <span class="badge bg-secondary">Hết hạn</span> }
            else { <span class="badge bg-danger">Đã hủy</span> }
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Contract" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
            <i class="bi bi-arrow-left me-1"></i>Quay lại
        </a>
        <button onclick="window.print()" class="btn btn-outline-dark btn-sm rounded-pill px-3">
            <i class="bi bi-printer me-1"></i>In hợp đồng
        </button>
    </div>
</div>

<!-- Contract Document -->
<div class="card border-0 shadow-sm rounded-4 p-4" id="contractDocument">
    <div class="card-body" style="max-width: 800px; margin: 0 auto; font-family: 'Times New Roman', serif; font-size: 14px; line-height: 1.8;">

        <div class="text-center mb-4">
            <p class="mb-0 fw-bold" style="font-size: 13px;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</p>
            <p class="mb-2" style="font-size: 13px;"><strong>Độc lập - Tự do - Hạnh phúc</strong></p>
            <hr style="width: 150px; margin: 0 auto; border-top: 1px solid #000;">
        </div>

        <div class="text-center mb-4">
            <h5 class="fw-bold mb-1" style="font-size: 16px;">HỢP ĐỒNG HỢP TÁC KÝ GỬI & VẬN HÀNH XE TỰ LÁI</h5>
            <p class="mb-0" style="font-size: 13px;">(Số: @Model.ContractNo)</p>
        </div>

        <div class="mb-3">
            <p class="fw-bold mb-2" style="text-decoration: underline;">BÊN A: ĐƠN VỊ VẬN HÀNH</p>
            <p class="mb-1">Họ và tên/Công ty: <strong>@Model.PartyAName</strong></p>
            <p class="mb-1">Địa chỉ: <strong>@(Model.PartyAAddress ?? "...")</strong></p>
        </div>

        <div class="mb-4">
            <p class="fw-bold mb-2" style="text-decoration: underline;">BÊN B: CHỦ XE (ĐỐI TÁC)</p>
            <p class="mb-1">Họ và tên: <strong>@Model.PartyBFullName</strong> &nbsp;&nbsp; CCCD: <strong>@(Model.PartyBCCCD ?? "...")</strong></p>
            @if (!string.IsNullOrEmpty(Model.VehicleInfo))
            {
                <p class="mb-1">Thông tin xe: <strong>@Model.VehicleInfo</strong> &nbsp; Biển số: <strong>@(Model.VehiclePlate ?? "...")</strong></p>
            }
        </div>

        @if (!string.IsNullOrEmpty(Model.TermsContent))
        {
            <div class="mb-3">
                @foreach (var line in Model.TermsContent.Split('\n'))
                {
                    if (line.StartsWith("ĐIỀU")) { <p class="fw-bold mt-3 mb-1">@line</p> }
                    else if (!string.IsNullOrWhiteSpace(line)) { <p class="mb-1">@line</p> }
                }
            </div>
        }

        <!-- Revenue summary -->
        <div class="mb-4 p-3 bg-light rounded-3">
            <div class="row text-center">
                <div class="col-4">
                    <p class="small text-muted mb-1">Bên B (Chủ xe)</p>
                    <p class="fw-bold text-success fs-5 mb-0">@Model.PartyBRevenuePercent%</p>
                </div>
                <div class="col-4">
                    <p class="small text-muted mb-1">Bên A (Vận hành)</p>
                    <p class="fw-bold text-primary fs-5 mb-0">@Model.PartyARevenuePercent%</p>
                </div>
                <div class="col-4">
                    <p class="small text-muted mb-1">Thanh toán</p>
                    <p class="fw-bold fs-6 mb-0">Ngày @Model.PaymentDay @Model.PaymentCycle</p>
                </div>
            </div>
        </div>

        <!-- Signatures -->
        <div class="row mt-5 pt-4 text-center" style="border-top: 1px dashed #ccc;">
            <div class="col-6">
                <p class="fw-bold mb-1">ĐẠI DIỆN BÊN A</p>
                <p class="small text-muted mb-3">(Ký tên, đóng dấu)</p>
                @if (Model.SignedByPartyA)
                {
                    <p class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>ĐÃ KÝ</p>
                    <p class="small text-muted">@Model.PartyASignDate?.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="fw-bold">@Model.PartyAName</p>
                }
            </div>
            <div class="col-6">
                <p class="fw-bold mb-1">ĐẠI DIỆN BÊN B</p>
                <p class="small text-muted mb-3">(Ký tên)</p>
                @if (Model.SignedByPartyB)
                {
                    <p class="text-success fw-bold"><i class="bi bi-check-circle-fill me-1"></i>ĐÃ KÝ</p>
                    <p class="small text-muted">@Model.PartyBSignDate?.ToString("dd/MM/yyyy HH:mm")</p>
                    <p class="fw-bold">@Model.PartyBFullName</p>
                }
                else
                {
                    <p class="text-danger small"><i class="bi bi-x-circle me-1"></i>Chưa ký</p>
                }
            </div>
        </div>
    </div>
</div>

<style>
    @@media print {
        .admin-sidebar, .d-md-flex, .btn, .admin-link, nav, footer, .partner-sidebar { display: none !important; }
        .admin-main-content, .partner-main { margin: 0 !important; padding: 0 !important; }
        #contractDocument { box-shadow: none !important; border: none !important; }
    }
</style>
