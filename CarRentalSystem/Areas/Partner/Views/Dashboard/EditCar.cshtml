@model CarRentalSystem.Models.Car
@{
    ViewData["Title"] = "Chỉnh sửa thông tin xe";
    var locations = ViewBag.Locations as IEnumerable<CarRentalSystem.Models.Location>;
    var carTypes = ViewBag.CarTypes as IEnumerable<CarRentalSystem.Models.CarType>;
    var brands = ViewBag.Brands as IEnumerable<CarRentalSystem.Models.CarBrand>;
    var statuses = ViewBag.Statuses as IEnumerable<CarRentalSystem.Models.CarStatus>;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center mb-4">
            <a asp-area="Partner" asp-controller="Dashboard" asp-action="MyCars" class="btn btn-outline-secondary btn-sm me-3 rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Về danh sách xe
            </a>
            <div>
                <h2 class="fw-bold mb-0">Chỉnh sửa thông tin xe</h2>
                <p class="text-muted mb-0 small">Cập nhật thông tin, giá và ảnh xe của bạn.</p>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-3 mb-4">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-area="Partner" asp-controller="Dashboard" asp-action="EditCar"
                      method="post" enctype="multipart/form-data">
                    <input type="hidden" asp-for="CarID" />

                    <!-- ── Thông tin cơ bản ─────────────────── -->
                    <h5 class="fw-bold mb-4 border-bottom pb-2">
                        <i class="bi bi-info-circle text-primary me-2"></i>Thông tin cơ bản
                    </h5>
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label asp-for="CarName" class="form-label fw-bold">Tên xe <span class="text-danger">*</span></label>
                            <input asp-for="CarName" class="form-control form-control-lg bg-light" placeholder="VD: Honda City 2023" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="LicensePlate" class="form-label fw-bold">Biển số xe <span class="text-danger">*</span></label>
                            <input asp-for="LicensePlate" class="form-control form-control-lg bg-light" placeholder="VD: 51H-123.45" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PricePerDay" class="form-label fw-bold">Giá theo ngày (₫) <span class="text-danger">*</span></label>
                            <input asp-for="PricePerDay" type="number" class="form-control form-control-lg bg-light" placeholder="VD: 800000" required />
                        </div>
                        <div class="col-md-6">
                            <label asp-for="PricePerHour" class="form-label fw-bold">Giá theo giờ (₫)</label>
                            <input asp-for="PricePerHour" type="number" class="form-control form-control-lg bg-light" placeholder="VD: 100000" />
                        </div>
                    </div>

                    <!-- ── Phân loại ───────────────────────── -->
                    <h5 class="fw-bold mb-4 border-bottom pb-2">
                        <i class="bi bi-grid text-primary me-2"></i>Phân loại xe
                    </h5>
                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <label asp-for="BrandID" class="form-label fw-bold">Hãng xe</label>
                            <select asp-for="BrandID" class="form-select form-select-lg bg-light"
                                    asp-items="@(new SelectList(ViewBag.Brands, "BrandID", "Name"))"></select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="CarTypeID" class="form-label fw-bold">Loại xe</label>
                            <select asp-for="CarTypeID" class="form-select form-select-lg bg-light"
                                    asp-items="@(new SelectList(ViewBag.CarTypes, "CarTypeID", "Name"))"></select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Khu vực đăng ký (Tỉnh/Thành) <span class="text-danger">*</span></label>
                            <select asp-for="LocationID" id="LocationID" class="form-select form-select-lg bg-light" required style="pointer-events: none;">
                                @if (ViewBag.Locations != null) {
                                    @foreach(var loc in (IEnumerable<CarRentalSystem.Models.Location>)ViewBag.Locations) {
                                        <option value="@loc.LocationID" selected="@(loc.LocationID == Model.LocationID ? "selected" : null)">@loc.Name</option>
                                    }
                                }
                            </select>
                            <small class="text-muted d-block mt-1">Hệ thống tự động cập nhật khu vực dựa vào vị trí ghim trên Bản đồ.</small>
                        </div>
                        
                        <div class="col-md-12 mb-2 mt-4">
                            <label class="form-label fw-bold">Vị trí giao nhận chính xác <span class="text-danger">*</span></label>
                            <div class="input-group mb-2">
                                <input type="text" asp-for="CarAddress" id="carAddressInput" class="form-control" placeholder="Hãy nhập địa chỉ xe của bạn hoặc chọn trên bản đồ..." required />
                                <button class="btn btn-outline-primary" type="button" id="btnGetCurrentLocation" title="Lấy vị trí của tôi">
                                    <i class="bi bi-crosshair"></i>
                                </button>
                            </div>
                            <div id="mapPicker" class="mb-2" style="height: 300px; border-radius: 12px; z-index: 1; border: 1px solid #e2e8f0;"></div>
                            <small class="text-muted d-block mb-3">Di chuyển ghim đỏ để thay đổi vị trí bãi đỗ xe/nơi giao nhận xe.</small>
                            <input type="hidden" asp-for="Latitude" id="latInput" />
                            <input type="hidden" asp-for="Longitude" id="lngInput" />
                        </div>
                        
                        <div class="col-md-4">
                            <label asp-for="Transmission" class="form-label fw-bold">Hộp số</label>
                            <select asp-for="Transmission" class="form-select form-select-lg bg-light">
                                <option>Tự động</option>
                                <option>Số sàn</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="FuelType" class="form-label fw-bold">Nhiên liệu</label>
                            <select asp-for="FuelType" class="form-select form-select-lg bg-light">
                                <option>Xăng</option>
                                <option>Dầu</option>
                                <option>Điện</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="FuelConsumption" class="form-label fw-bold">Mức tiêu hao</label>
                            <div class="input-group">
                                @{ var rawFuel = Model.FuelConsumption?.Replace("L/100km", "")?.Replace("kWh/100km", "")?.Replace(" ", "") ?? "8.0"; }
                                <input name="FuelConsumption" id="FuelConsumption" class="form-control form-control-lg bg-light border-end-0" placeholder="VD: 8.0" value="@rawFuel" />
                                <span class="input-group-text bg-light text-muted fw-bold border-start-0" id="fuelUnitLabel">L/100km</span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="CarStatusID" class="form-label fw-bold">Trạng thái</label>
                            <select asp-for="CarStatusID" class="form-select form-select-lg bg-light"
                                    asp-items="@(new SelectList(ViewBag.Statuses, "CarStatusID", "Name"))"></select>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Seats" class="form-label fw-bold">Số chỗ ngồi</label>
                            <input asp-for="Seats" type="number" min="2" max="16" class="form-control form-control-lg bg-light" />
                        </div>
                    </div>

                    <!-- ── Mô tả ───────────────────────────── -->
                    <div class="mb-4">
                        <label asp-for="Description" class="form-label fw-bold">Mô tả chi tiết</label>
                        <textarea asp-for="Description" rows="4" class="form-control bg-light" placeholder="Nhập thêm thông tin về xe, các tiện ích đi kèm..."></textarea>
                    </div>

                    <!-- ── Ảnh xe ──────────────────────────── -->
                    <h5 class="fw-bold mb-4 border-bottom pb-2">
                        <i class="bi bi-camera text-primary me-2"></i>Ảnh xe
                    </h5>
                    <div class="mb-4">
                        @if (!string.IsNullOrEmpty(Model.ImageURL))
                        {
                            <div class="mb-3">
                                <p class="fw-semibold small text-muted mb-1">Ảnh hiện tại:</p>
                                <img id="currentImage" src="@Model.ImageURL" alt="Current car image"
                                     class="rounded-3 shadow-sm"
                                     style="max-height:220px;object-fit:cover;max-width:100%;" />
                            </div>
                        }

                        <!-- New image preview -->
                        <div id="imagePreviewBox" class="d-none mb-3">
                            <p class="fw-semibold small text-success mb-1"><i class="bi bi-arrow-repeat me-1"></i>Ảnh mới (chưa lưu):</p>
                            <img id="imagePreview" src="#" alt="New image preview"
                                 class="rounded-3 shadow-sm img-fluid"
                                 style="max-height:220px;object-fit:cover;" />
                        </div>

                        <label class="form-label fw-bold">Đổi ảnh xe <span class="text-muted fw-normal small">(bỏ trống để giữ ảnh cũ)</span></label>
                        <div class="upload-area border-2 rounded-3 p-3 text-center bg-light" id="uploadArea"
                             style="border-style:dashed !important;cursor:pointer;transition:background .2s;">
                            <i class="bi bi-cloud-upload fs-2 text-primary mb-1 d-block"></i>
                            <p class="mb-0 small">Kéo &amp; thả hoặc click để chọn ảnh mới</p>
                            <input type="file" name="imageFile" id="imageFile" accept="image/*"
                                   class="d-none" onchange="previewImage(this)" />
                        </div>
                        <div id="fileName" class="text-muted small mt-2"></div>
                    </div>

                    <!-- LocationID moved up to map section -->

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill fw-bold">
                            <i class="bi bi-save me-2"></i>Lưu thay đổi
                        </button>
                        <a asp-area="Partner" asp-controller="Dashboard" asp-action="MyCars" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .upload-area:hover { background-color: #e8f0fe !important; }
    .upload-area.drag-over { background-color: #d0e3ff !important; border-color: #0d6efd !important; }
</style>

@section Scripts {
<script>
    document.getElementById('uploadArea').addEventListener('click', function () {
        document.getElementById('imageFile').click();
    });

    var dropArea = document.getElementById('uploadArea');
    ['dragenter','dragover'].forEach(ev => dropArea.addEventListener(ev, e => {
        e.preventDefault(); dropArea.classList.add('drag-over');
    }));
    ['dragleave','drop'].forEach(ev => dropArea.addEventListener(ev, e => {
        e.preventDefault(); dropArea.classList.remove('drag-over');
    }));
    dropArea.addEventListener('drop', function (e) {
        var file = e.dataTransfer.files[0];
        if (file) {
            var input = document.getElementById('imageFile');
            var dt = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            previewImage(input);
        }
    });

    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('imagePreview').src = e.target.result;
                document.getElementById('imagePreviewBox').classList.remove('d-none');
                document.getElementById('fileName').textContent = '📎 ' + input.files[0].name;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // --- MAP PICKER LOGIC ---
    document.addEventListener("DOMContentLoaded", function () {
        var defaultLat = @(Model.Latitude ?? 10.7769);
        var defaultLng = @(Model.Longitude ?? 106.7009);
        var initialAddress = "@(Html.Raw(Model.CarAddress ?? ""))";

        if (typeof SmartMap !== 'undefined') {
            const picker = SmartMap.initPickerMap({
                containerId: 'mapPicker',
                btnLocationId: 'btnGetCurrentLocation',
                latInputId: 'latInput',
                lngInputId: 'lngInput',
                addressInputId: 'carAddressInput',
                locationDropdownId: 'LocationID'
            });

            if (picker) {
                picker.map.setView([defaultLat, defaultLng], 14);
                picker.marker.setLatLng([defaultLat, defaultLng]);
                document.getElementById('latInput').value = defaultLat;
                document.getElementById('lngInput').value = defaultLng;
                
                if (initialAddress) {
                    document.getElementById('carAddressInput').value = initialAddress;
                } else if (defaultLat == 10.7769) {
                    // Start geo-coding if it's default
                    const fakeEvent = { latlng: { lat: defaultLat, lng: defaultLng } };
                    picker.map.fire('click', fakeEvent);
                }
            }
        }
    });
    // --- FUEL UNIT LOGIC ---
    document.addEventListener("DOMContentLoaded", function () {
        const fuelTypeSelect = document.querySelector('select[name="FuelType"]');
        const fuelUnitLabel = document.getElementById('fuelUnitLabel');
        if (fuelTypeSelect && fuelUnitLabel) {
            fuelTypeSelect.addEventListener('change', function (e) {
                fuelUnitLabel.innerText = e.target.value === 'Điện' ? 'kWh/100km' : 'L/100km';
            });
            // Init
            fuelTypeSelect.dispatchEvent(new Event('change'));
        }
    });
</script>
}
