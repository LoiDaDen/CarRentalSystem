@model CarRentalSystem.Models.User
@{
    ViewData["Title"] = "Chờ xác nhận Partner";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="card-body p-5 text-center">
                    <div class="waiting-animation mb-4">
                        <i class="bi bi-hourglass-split text-warning" style="font-size: 5rem;"></i>
                    </div>

                    <h2 class="fw-bold text-warning mb-3">
                        <i class="bi bi-clock-history me-2"></i>Đang chờ xác nhận
                    </h2>

                    <p class="text-muted mb-4">
                        Tài khoản Partner của bạn đang được <strong>xem xét</strong> bởi đội ngũ quản trị.
                    </p>

                    <div class="alert alert-light border rounded-3 mb-4 text-start">
                        <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2 text-primary"></i>Điều cần biết:</h6>
                        <ul class="mb-0 text-muted small">
                            <li>Thời gian xử lý: <strong>1-2 ngày làm việc</strong></li>
                            <li>Bạn sẽ nhận được <strong>email thông báo</strong> khi được duyệt</li>
                            <li>Sau khi được duyệt, bạn có thể <strong>đăng xe</strong> và <strong>quản lý</strong> trên Partner Panel</li>
                        </ul>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary btn-lg rounded-pill">
                            <i class="bi bi-house me-2"></i>Về trang chủ
                        </a>
                        <a asp-area="" asp-controller="Auth" asp-action="Profile" class="btn btn-outline-secondary rounded-pill">
                            <i class="bi bi-person me-2"></i>Cập nhật hồ sơ
                        </a>
                    </div>
                </div>
            </div>

            <div class="text-center mt-4">
                <p class="text-muted small">
                    <i class="bi bi-question-circle me-1"></i>
                    Cần hỗ trợ? Liên hệ <a href="mailto:support@carental.com">support@carental.com</a>
                </p>
            </div>
        </div>
    </div>
</div>

<style>
    .waiting-animation {
        animation: pulse 2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.7; transform: scale(0.95); }
    }
</style>
