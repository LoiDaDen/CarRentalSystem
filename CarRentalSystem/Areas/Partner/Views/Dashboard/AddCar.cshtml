@{
    ViewData["Title"] = "Đăng xe lên sàn - SmartRental Partner";
    var locations = ViewBag.Locations as IEnumerable<CarRentalSystem.Models.Location>;
    var carTypes = ViewBag.CarTypes as IEnumerable<CarRentalSystem.Models.CarType>;
    var brands = ViewBag.Brands as IEnumerable<CarRentalSystem.Models.CarBrand>;
    var statuses = ViewBag.Statuses as IEnumerable<CarRentalSystem.Models.CarStatus>;
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center mb-4">
            <a asp-area="Partner" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm me-3 rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
            <div>
                <h2 class="fw-bold mb-0">Đăng xe mới lên sàn</h2>
                <p class="text-muted mb-0 small">Điền thông tin xe để bắt đầu kiếm thêm thu nhập.</p>
            </div>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-area="Partner" asp-controller="Dashboard" asp-action="AddCar"
                      method="post" enctype="multipart/form-data">

                    <!-- ── Thông tin cơ bản ─────────────────────── -->
                    <h5 class="fw-bold mb-4 border-bottom pb-2">
                        <i class="bi bi-info-circle text-primary me-2"></i>Thông tin cơ bản
                    </h5>
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Tên xe <span class="text-danger">*</span></label>
                            <input name="CarName" class="form-control form-control-lg bg-light" placeholder="VD: Toyota Camry 2022" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Biển số xe <span class="text-danger">*</span></label>
                            <input name="LicensePlate" class="form-control form-control-lg bg-light" placeholder="VD: 51A - 123.45" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số khung (VIN) <span class="text-danger">*</span></label>
                            <input name="VIN" class="form-control form-control-lg bg-light" placeholder="17 ký tự" maxlength="17" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Số chỗ ngồi</label>
                            <input name="Seats" type="number" min="2" max="16" class="form-control form-control-lg bg-light" value="5" />
                        </div>
                    </div>

                    <!-- ── Phân loại xe ────────────────────────── -->
                    <h5 class="fw-bold mb-4 border-bottom pb-2">
                        <i class="bi bi-grid text-primary me-2"></i>Phân loại xe
                    </h5>
                    <div class="row g-4 mb-4">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Thương hiệu</label>
                            <select name="BrandID" class="form-select form-select-lg bg-light">
                                @if (brands != null) {
                                    @foreach(var b in brands) {
                                        <option value="@b.BrandID">@b.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Loại xe</label>
                            <select name="CarTypeID" class="form-select form-select-lg bg-light">
                                @if (carTypes != null) {
                                    @foreach(var t in carTypes) {
                                        <option value="@t.CarTypeID">@t.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-12">
                            <label class="form-label fw-bold">Khu vực đăng ký (Tỉnh/Thành) <span class="text-danger">*</span></label>
                            <select name="LocationID" id="LocationID" class="form-select form-select-lg bg-light" required style="pointer-events: none;">
                                @if (locations != null) {
                                    @foreach(var loc in locations) {
                                        <option value="@loc.LocationID">@loc.Name</option>
                                    }
                                }
                            </select>
                            <small class="text-muted d-block mt-1">Hệ thống tự động nhận diện khu vực dựa vào vị trí ghim trên Bản đồ bên dưới.</small>
                        </div>

                        <div class="col-md-12 mb-2 mt-4">
                            <label class="form-label fw-bold">Vị trí giao nhận chính xác <span class="text-danger">*</span></label>
                            <div class="input-group mb-2">
                                <input type="text" name="CarAddress" id="carAddressInput" class="form-control" placeholder="Hãy nhập địa chỉ xe của bạn hoặc chọn trên bản đồ..." required />
                                <button class="btn btn-outline-primary" type="button" id="btnGetCurrentLocation" title="Lấy vị trí của tôi">
                                    <i class="bi bi-crosshair"></i>
                                </button>
                            </div>
                            <div id="mapPicker" class="mb-2" style="height: 300px; border-radius: 12px; z-index: 1; border: 1px solid #e2e8f0;"></div>
                            <small class="text-muted d-block mb-3">Di chuyển ghim đỏ để chọn vị trí chính xác bãi đỗ xe/nơi giao nhận xe.</small>
                            <input type="hidden" name="Latitude" id="latInput" />
                            <input type="hidden" name="Longitude" id="lngInput" />
                        </div>
                        
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Hộp số</label>
                            <select name="Transmission" class="form-select form-select-lg bg-light">
                                <option>Tự động</option>
                                <option>Số sàn</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Nhiên liệu</label>
                            <select name="FuelType" class="form-select form-select-lg bg-light">
                                <option>Xăng</option>
                                <option>Dầu</option>
                                <option>Điện</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Mức tiêu hao</label>
                            <div class="input-group">
                                <input name="FuelConsumption" class="form-control form-control-lg bg-light border-end-0" placeholder="VD: 8.0" value="8.0" />
                                <span class="input-group-text bg-light text-muted fw-bold border-start-0" id="fuelUnitLabel">L/100km</span>
                            </div>
                        </div>
                    </div>

                    <!-- ── Giá & mô tả ─────────────────────────── -->
                    <h5 class="fw-bold mb-4 border-bottom pb-2">
                        <i class="bi bi-tag text-primary me-2"></i>Giá cho thuê
                    </h5>
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giá theo ngày (₫) <span class="text-danger">*</span></label>
                            <input name="PricePerDay" type="number" min="0" class="form-control form-control-lg bg-light" placeholder="VD: 800000" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Giá theo giờ (₫)</label>
                            <input name="PricePerHour" type="number" min="0" class="form-control form-control-lg bg-light" placeholder="VD: 100000" />
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Mô tả xe</label>
                            <textarea name="Description" rows="4" class="form-control bg-light" placeholder="Mô tả tình trạng, trang bị, ưu điểm của xe..."></textarea>
                        </div>
                    </div>

                    <!-- ── Ảnh xe ──────────────────────────────── -->
                    <h5 class="fw-bold mb-4 border-bottom pb-2">
                        <i class="bi bi-camera text-primary me-2"></i>Ảnh xe
                    </h5>
                    <div class="mb-4">
                        <!-- Preview zone -->
                        <div id="imagePreviewBox" class="d-none mb-3 text-center">
                            <img id="imagePreview" src="#" alt="Preview" class="img-fluid rounded-3 shadow-sm" style="max-height:260px;object-fit:cover;" />
                        </div>

                        <label class="form-label fw-bold">Upload ảnh xe <span class="text-danger">*</span></label>
                        <div class="upload-area border-2 border-dashed rounded-3 p-4 text-center bg-light" id="uploadArea"
                             style="border-style:dashed !important;cursor:pointer;transition:background .2s;">
                            <i class="bi bi-cloud-upload fs-2 text-primary mb-2 d-block"></i>
                            <p class="mb-1 fw-semibold">Kéo &amp; thả hoặc click để chọn ảnh</p>
                            <p class="text-muted small mb-0">JPG, PNG, WEBP — tối đa 10MB</p>
                            <input type="file" name="imageFile" id="imageFile" accept="image/*"
                                   class="d-none" onchange="previewImage(this)" required />
                        </div>
                        <div id="fileName" class="text-muted small mt-2"></div>
                    </div>

                    <input type="hidden" name="CarStatusID" value="@(statuses?.FirstOrDefault(s => s.Name == "Available")?.CarStatusID ?? 1)" />
                    <input type="hidden" name="CurrentOdometer" value="0" />
                    <input type="hidden" name="IsPremium" value="false" />
                    
                    <!-- LocationID moved up to map section -->

                    <div class="alert alert-info rounded-3 mb-4">
                        <i class="bi bi-info-circle-fill me-2"></i>
                        SmartRental sẽ thu <strong>20% phí nền tảng</strong> trên mỗi giao dịch thành công. Bạn nhận <strong>80%</strong> doanh thu thực tế.
                    </div>

                    <div class="d-flex gap-3">
                        <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill fw-bold">
                            <i class="bi bi-cloud-upload me-2"></i> Đăng xe lên sàn
                        </button>
                        <a asp-area="Partner" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .upload-area:hover { background-color: #e8f0fe !important; }
    .upload-area.drag-over { background-color: #d0e3ff !important; border-color: #0d6efd !important; }
</style>

@section Scripts {
<script>
    // Click upload area → trigger file input
    document.getElementById('uploadArea').addEventListener('click', function () {
        document.getElementById('imageFile').click();
    });

    // Drag & Drop
    var dropArea = document.getElementById('uploadArea');
    ['dragenter','dragover'].forEach(ev => dropArea.addEventListener(ev, e => {
        e.preventDefault(); dropArea.classList.add('drag-over');
    }));
    ['dragleave','drop'].forEach(ev => dropArea.addEventListener(ev, e => {
        e.preventDefault(); dropArea.classList.remove('drag-over');
    }));
    dropArea.addEventListener('drop', function (e) {
        var file = e.dataTransfer.files[0];
        if (file) {
            var input = document.getElementById('imageFile');
            // Transfer file to input
            var dt = new DataTransfer();
            dt.items.add(file);
            input.files = dt.files;
            previewImage(input);
        }
    });

    function previewImage(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            reader.onload = function (e) {
                document.getElementById('imagePreview').src = e.target.result;
                document.getElementById('imagePreviewBox').classList.remove('d-none');
                document.getElementById('fileName').textContent = '📎 ' + input.files[0].name;
            };
            reader.readAsDataURL(input.files[0]);
        }
    }

    // --- MAP PICKER LOGIC ---
    document.addEventListener("DOMContentLoaded", function () {
        var defaultLat = 10.7769;
        var defaultLng = 106.7009;

        if (typeof SmartMap !== 'undefined') {
            const picker = SmartMap.initPickerMap({
                containerId: 'mapPicker',
                btnLocationId: 'btnGetCurrentLocation',
                latInputId: 'latInput',
                lngInputId: 'lngInput',
                addressInputId: 'carAddressInput',
                locationDropdownId: 'LocationID'
            });

            if (picker) {
                picker.map.setView([defaultLat, defaultLng], 14);
                picker.marker.setLatLng([defaultLat, defaultLng]);
                document.getElementById('latInput').value = defaultLat;
                document.getElementById('lngInput').value = defaultLng;
                
                // Trigger auto-geocode to address
                const fakeEvent = { latlng: { lat: defaultLat, lng: defaultLng } };
                picker.map.fire('click', fakeEvent);
            }
        }
    });
    // --- FUEL UNIT LOGIC ---
    document.addEventListener("DOMContentLoaded", function () {
        const fuelTypeSelect = document.querySelector('select[name="FuelType"]');
        const fuelUnitLabel = document.getElementById('fuelUnitLabel');
        if (fuelTypeSelect && fuelUnitLabel) {
            fuelTypeSelect.addEventListener('change', function (e) {
                fuelUnitLabel.innerText = e.target.value === 'Điện' ? 'kWh/100km' : 'L/100km';
            });
            // Init
            fuelTypeSelect.dispatchEvent(new Event('change'));
        }
    });
</script>
}
