@{
    ViewData["Title"] = "Trở thành Đối Tác SmartRental";
    Layout = "_Layout"; // Use main layout for registration landing page
}

<style>
    .partner-hero { background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%); border-radius: 28px; overflow: hidden; position: relative; }
    .partner-hero::before { content: ''; position: absolute; width: 400px; height: 400px; border-radius: 50%; background: radial-gradient(circle, rgba(245,158,11,0.15) 0%, transparent 70%); top: -100px; right: -100px; }
    .benefit-card { border-radius: 20px; transition: transform 0.3s ease, box-shadow 0.3s ease; }
    .benefit-card:hover { transform: translateY(-6px); box-shadow: 0 16px 40px rgba(0,0,0,.08) !important; }
    .step-circle { width: 48px; height: 48px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.1rem; flex-shrink: 0; }
    .fw-800 { font-weight: 800; }
</style>

<!-- Hero -->
<div class="partner-hero p-5 mb-5 text-white">
    <div class="row align-items-center">
        <div class="col-lg-7 position-relative z-1">
            <span class="badge bg-warning text-dark rounded-pill px-3 py-2 fw-bold mb-3 d-inline-block">
                <i class="bi bi-lightning-fill me-1"></i>Chương trình Đối tác SmartRental
            </span>
            <h1 class="fw-800 display-5 mb-3" style="letter-spacing: -1px;">
                Biến chiếc xe thành <span style="color: #f59e0b;">thu nhập thụ động</span>
            </h1>
            <p class="text-white-50 mb-4 fs-6">Đăng xe lên sàn SmartRental, chúng tôi lo việc tìm khách, bảo hiểm và hợp đồng điện tử. Bạn chỉ cần giao chìa khóa và nhận tiền.</p>
            <div class="d-flex gap-3 flex-wrap">
                <div class="d-flex align-items-center gap-2 text-white-50 small">
                    <i class="bi bi-check-circle-fill text-success"></i>Bảo vệ tài sản 100%
                </div>
                <div class="d-flex align-items-center gap-2 text-white-50 small">
                    <i class="bi bi-check-circle-fill text-success"></i>GPS real-time 24/7
                </div>
                <div class="d-flex align-items-center gap-2 text-white-50 small">
                    <i class="bi bi-check-circle-fill text-success"></i>Thanh toán tự động
                </div>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-flex justify-content-center">
            <div class="text-center">
                <div style="font-size: 5rem; filter: drop-shadow(0 0 30px rgba(245,158,11,0.4));">🚗</div>
                <div class="mt-3 px-4 py-3 rounded-4" style="background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.1);">
                    <div class="text-white-50 small text-uppercase fw-700" style="letter-spacing:1px; font-size:0.65rem;">Bạn nhận được</div>
                    <div class="fw-800 text-warning" style="font-size: 2.5rem;">80%</div>
                    <div class="text-white-50 small">trên mỗi chuyến hoàn thành</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Benefits -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card benefit-card border-0 shadow-sm h-100 p-4">
            <div class="rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width:56px;height:56px;background:rgba(16,185,129,0.1);">
                <i class="bi bi-cash-stack fs-3 text-success"></i>
            </div>
            <h5 class="fw-800">80% Doanh thu</h5>
            <p class="text-muted small mb-0">Bạn giữ lại 80% mỗi chuyến. Nền tảng chỉ thu 20% phí dịch vụ – minh bạch, không ẩn phí.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card benefit-card border-0 shadow-sm h-100 p-4">
            <div class="rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width:56px;height:56px;background:rgba(59,130,246,0.1);">
                <i class="bi bi-shield-check-fill fs-3 text-primary"></i>
            </div>
            <h5 class="fw-800">Bảo Vệ Tài Sản</h5>
            <p class="text-muted small mb-0">Hợp đồng điện tử ràng buộc, đặt cọc 15-30 triệu và hệ thống chụp ảnh kiểm tra khi giao/nhận xe.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card benefit-card border-0 shadow-sm h-100 p-4">
            <div class="rounded-3 d-inline-flex align-items-center justify-content-center mb-3" style="width:56px;height:56px;background:rgba(245,158,11,0.1);">
                <i class="bi bi-geo-alt-fill fs-3 text-warning"></i>
            </div>
            <h5 class="fw-800">Theo dõi GPS Live</h5>
            <p class="text-muted small mb-0">Biết xe đang ở đâu 24/7 qua hệ thống GPS tích hợp trực tiếp trên bảng điều khiển đối tác.</p>
        </div>
    </div>
</div>

<!-- How it works -->
<div class="card border-0 bg-light rounded-4 p-4 mb-5">
    <h5 class="fw-800 text-dark mb-4 text-center">Bắt đầu chỉ trong 4 bước</h5>
    <div class="row g-4">
        @{
            var steps = new[] {
                ("1", "#2563eb", "Đăng ký đối tác", "Điền thông tin và đồng ý điều khoản. Chỉ mất 2 phút."),
                ("2", "#10b981", "Đăng xe lên sàn", "Thêm thông tin xe, ảnh và giá thuê. Admin sẽ duyệt trong 24h."),
                ("3", "#f59e0b", "Nhận đơn đặt", "Khách hàng tìm và đặt xe của bạn. Bạn nhận thông báo ngay."),
                ("4", "#8b5cf6", "Nhận thanh toán", "Hoàn tất chuyến, tiền về tài khoản trong 48h làm việc.")
            };
        }
        @foreach (var (num, color, title, desc) in steps)
        {
            <div class="col-md-3 col-6">
                <div class="d-flex flex-column align-items-center text-center">
                    <div class="step-circle mb-3 text-white" style="background: @color;">@num</div>
                    <h6 class="fw-700 text-dark mb-1">@title</h6>
                    <p class="text-muted small mb-0">@desc</p>
                </div>
            </div>
        }
    </div>
</div>

<!-- Registration Form -->
<div class="row justify-content-center">
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-4 p-md-5">
                <h4 class="fw-800 text-dark mb-1"><i class="bi bi-file-earmark-check-fill text-warning me-2"></i>Điều khoản Đối tác</h4>
                <p class="text-muted small mb-4">Vui lòng đọc kỹ trước khi đăng ký.</p>

                <ul class="list-group list-group-flush mb-4">
                    <li class="list-group-item px-0 py-3 d-flex gap-3">
                        <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                        <span class="small">Xe phải được đăng kiểm hợp lệ và còn thời hạn bảo hiểm còn hiệu lực.</span>
                    </li>
                    <li class="list-group-item px-0 py-3 d-flex gap-3">
                        <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                        <span class="small">Chủ xe chịu trách nhiệm cung cấp thông tin xe trung thực và đầy đủ.</span>
                    </li>
                    <li class="list-group-item px-0 py-3 d-flex gap-3">
                        <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                        <span class="small">SmartRental thu 20% phí nền tảng. Thanh toán 80% còn lại trong 48h sau khi hoàn tất chuyến.</span>
                    </li>
                    <li class="list-group-item px-0 py-3 d-flex gap-3">
                        <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                        <span class="small">Xe vi phạm nghiêm trọng sẽ bị gỡ khỏi sàn và tài khoản sẽ bị khóa vĩnh viễn.</span>
                    </li>
                    <li class="list-group-item px-0 py-3 d-flex gap-3">
                        <i class="bi bi-check-circle-fill text-success fs-5 flex-shrink-0"></i>
                        <span class="small">Tài khoản đối tác cần hoàn tất eKYC (CCCD + GPLX) để được kích hoạt đăng xe.</span>
                    </li>
                </ul>

                <form asp-area="Partner" asp-controller="Dashboard" asp-action="Register" method="post" id="registerForm">
                    <div class="form-check mb-4 p-3 rounded-3" style="background: #f8fafc; border: 1px solid #e2e8f0;">
                        <input class="form-check-input" type="checkbox" id="agreeTerms" name="agreeTerms" required>
                        <label class="form-check-label fw-bold" for="agreeTerms">
                            Tôi đã đọc, hiểu và đồng ý với tất cả <strong class="text-primary">Điều khoản Đối tác</strong> của SmartRental.
                        </label>
                    </div>

                    <!-- Hợp đồng điện tử -->
                    <div class="card border-primary mb-4" style="border-width: 2px;">
                        <div class="card-header bg-primary text-white py-3">
                            <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-text me-2"></i>HỢP ĐỒNG HỢP TÁC ĐỐI TÁC</h5>
                        </div>
                        <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                            <div class="small">
                                <p class="fw-bold text-center mb-3">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM<br>Độc lập - Tự do - Hạnh phúc</p>

                                <p class="fw-bold text-center">HỢP ĐỒNG HỢP TÁC ĐỐI TÁC CHO THUÊ XE</p>
                                <p class="text-center text-muted">Số: ___________/2026/HĐHT-XT</p>

                                <p><strong>ĐIỀU 1: CÁC BÊN THAM GIA HỢP ĐỒNG</strong></p>
                                <p>BÊN A: Công ty TNHH Cho Thuê Xe CarRental<br>
                                Địa chỉ: TP. Hồ Chí Minh, Việt Nam<br>
                                (Sau đây gọi là "Bên A")</p>

                                <p>BÊN B: Thông tin tài khoản của Quý khách<br>
                                (Sau đây gọi là "Bên B")</p>

                                <p><strong>ĐIỀU 2: NỘI DUNG HỢP TÁC</strong></p>
                                <p>2.1. Bên B đồng ý ký gửi xe ô tô cho Bên A để thực hiện dịch vụ cho thuê xe tự lái trên nền tảng CarRental.</p>
                                <p>2.2. Bên A có trách nhiệm tìm kiếm khách hàng, thực hiện quy trình cho thuê, quản lý tài sản và thu tiền từ khách hàng.</p>

                                <p><strong>ĐIỀU 3: PHÂN CHIA DOANH THU</strong></p>
                                <p>3.1. Doanh thu từ việc cho thuê xe sẽ được chia như sau:</p>
                                <ul>
                                    <li><strong>Bên B (Chủ xe):</strong> Nhận 80% doanh thu</li>
                                    <li><strong>Bên A (Vận hành):</strong> Nhận 20% doanh thu (Phí quản lý, tìm khách và vận hành)</li>
                                </ul>
                                <p>3.2. Kỳ thanh toán: Bên A tổng kết và chuyển thanh toán cho Bên B vào ngày 05 hàng tháng.</p>

                                <p><strong>ĐIỀU 4: TRÁCH NHIỆM</strong></p>
                                <p>4.1. Bên B chịu trách nhiệm: Phí bảo hiểm vật chất xe, phí đường bộ, đăng kiểm, và các hư hỏng do hao mòn tự nhiên.</p>
                                <p>4.2. Bên A chịu trách nhiệm: Chi phí marketing, nhân sự giao nhận xe, vệ sinh xe cơ bản.</p>

                                <p><strong>ĐIỀU 5: THỜI HẠN VÀ CHẤM DỨT</strong></p>
                                <p>5.1. Hợp đồng có hiệu lực kể từ ngày ký.</p>
                                <p>5.2. Nếu một trong hai bên muốn chấm dứt, phải báo trước ít nhất 15 ngày.</p>

                                <p><strong>ĐIỀU 6: ĐIỀU KHOẢN KHÁC</strong></p>
                                <p>6.1. Xe phải được đăng kiểm hợp lệ và còn thời hạn bảo hiểm.</p>
                                <p>6.2. Xe vi phạm nghiêm trọng sẽ bị gỡ khỏi sàn.</p>
                                <p>6.3. Thanh toán cho Bên B trong vòng 48h sau khi hoàn tất chuyến.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Checkbox xác nhận ký hợp đồng -->
                    <div class="form-check mb-4 p-3 rounded-3 border border-danger" style="background: #fef2f2;">
                        <input class="form-check-input" type="checkbox" id="signContract" name="signContract" required>
                        <label class="form-check-label fw-bold text-danger" for="signContract">
                            <i class="bi bi-pen-fill me-1"></i>Tôi xác nhận đã đọc kỹ Hợp đồng Hợp tác Đối tác và đồng ý ký hợp đồng này bằng chữ ký điện tử.
                        </label>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning btn-lg rounded-pill py-3 fw-bold shadow-sm" id="btnRegister">
                            <i class="bi bi-pen me-2"></i>Ký Hợp Đồng & Đăng Ký Đối Tác
                        </button>
                        <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill py-2">
                            <i class="bi bi-x-lg me-2"></i>Hủy bỏ
                        </a>
                    </div>
                    <p class="text-center text-muted small mt-3 mb-0">
                        <i class="bi bi-info-circle me-1"></i>Nếu bạn không đồng ý ký hợp đồng, vui lòng nhấn "Hủy bỏ" để quay về trang chủ.
                    </p>
                </form>
            </div>
        </div>
    </div>
</div>
