@model CarRentalSystem.Models.User
@{
    ViewData["Title"] = "Hồ sơ Đối tác";
    var lat = Model.PartnerLatitude ?? 10.7769;
    var lng = Model.PartnerLongitude ?? 106.7009;
    var hasLocation = Model.PartnerLatitude.HasValue;
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<div class="row justify-content-center">
    <div class="col-lg-9">

        <div class="d-flex align-items-center mb-4">
            <a asp-area="Partner" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm me-3 rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
            <div>
                <h2 class="fw-bold mb-0">Hồ sơ Đối tác</h2>
                <p class="text-muted mb-0 small">Cập nhật thông tin và vị trí khu vực hoạt động của bạn.</p>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success rounded-3 mb-4">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            </div>
        }

        <form asp-area="Partner" asp-controller="Dashboard" asp-action="Profile" method="post">

            <!-- ── Thông tin cá nhân ──────────────────────────────────────── -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-4 border-bottom pb-2">
                        <i class="bi bi-person-circle text-primary me-2"></i>Thông tin cơ bản
                    </h5>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Họ & tên</label>
                            <input type="text" class="form-control bg-light" value="@Model.Name" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email</label>
                            <input type="email" class="form-control bg-light" value="@Model.Email" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số điện thoại</label>
                            <input type="tel" name="phone" class="form-control" value="@Model.Phone" placeholder="0912 345 678" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Vai trò</label>
                            <span class="form-control bg-light text-muted">@Model.Role</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ── Vị trí đối tác (bản đồ) ────────────────────────────────── -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-1 border-bottom pb-2">
                        <i class="bi bi-geo-alt-fill text-danger me-2"></i>Vị trí khu vực hoạt động
                    </h5>
                    <p class="text-muted small mb-3">
                        Click vào bản đồ để chọn vị trí khu vực bạn hoạt động. Địa chỉ sẽ được tự động điền.
                    </p>

                    <!-- Map container -->
                    <div id="partnerMap" style="height:380px;border-radius:12px;overflow:hidden;border:2px solid #dee2e6;" class="mb-3"></div>

                    <!-- Address display -->
                    <div class="input-group mb-2">
                        <span class="input-group-text bg-light"><i class="bi bi-pin-map text-danger"></i></span>
                        <input type="text" id="addressDisplay" name="partnerAddress"
                               class="form-control"
                               value="@Model.PartnerAddress"
                               placeholder="Click bản đồ để chọn vị trí..." readonly />
                        <button type="button" class="btn btn-outline-secondary" onclick="clearLocation()" title="Xóa vị trí">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </div>
                    <p class="text-muted x-small"><i class="bi bi-info-circle me-1"></i>Bạn cũng có thể gõ trực tiếp vào ô địa chỉ nếu muốn.</p>

                    <!-- Hidden coords -->
                    <input type="hidden" id="partnerLat" name="partnerLatitude" value="@(Model.PartnerLatitude?.ToString("G") ?? "")" />
                    <input type="hidden" id="partnerLng" name="partnerLongitude" value="@(Model.PartnerLongitude?.ToString("G") ?? "")" />
                </div>
            </div>

            <!-- ── eKYC Status ─────────────────────────────────────────────── -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2">
                        <i class="bi bi-shield-check text-success me-2"></i>Trạng thái xác minh (eKYC)
                    </h5>
                    <div class="d-flex align-items-center gap-3">
                        @if (Model.IsVerified)
                        {
                            <span class="badge bg-success fs-6 px-3 py-2 rounded-pill"><i class="bi bi-patch-check-fill me-1"></i>Đã xác minh</span>
                            <span class="text-muted small">Hồ sơ của bạn đã được Admin duyệt.</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark fs-6 px-3 py-2 rounded-pill"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>
                            <span class="text-muted small">Hồ sơ đang chờ Admin xác minh. Xe của bạn sẽ hiển thị sau khi được duyệt.</span>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill fw-bold">
                    <i class="bi bi-save me-2"></i>Lưu thay đổi
                </button>
                <a asp-area="Partner" asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-lg px-4 rounded-pill">
                    Hủy
                </a>
            </div>

        </form>
    </div>
</div>

<style>
    .x-small { font-size: 0.75rem; }
    #partnerMap { cursor: crosshair; }
    .leaflet-popup-content { font-size: 0.9rem; }
</style>

<script>
    // ── Initialize Leaflet Map ────────────────────────────────────────────────
    var initLat = @lat;
    var initLng = @lng;
    var hasLocation = @(hasLocation ? "true" : "false");

    var map = L.map('partnerMap').setView([initLat, initLng], hasLocation ? 15 : 12);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19
    }).addTo(map);

    var marker = null;

    // ── Restore existing marker if location already saved ─────────────────────
    if (hasLocation) {
        marker = L.marker([initLat, initLng], { draggable: true }).addTo(map);
        marker.on('dragend', function () {
            var pos = marker.getLatLng();
            reverseGeocode(pos.lat, pos.lng);
        });
    }

    // ── Click on map to set location ─────────────────────────────────────────
    map.on('click', function (e) {
        var lat = e.latlng.lat;
        var lng = e.latlng.lng;

        if (marker) {
            marker.setLatLng([lat, lng]);
        } else {
            marker = L.marker([lat, lng], { draggable: true }).addTo(map);
            marker.on('dragend', function () {
                var pos = marker.getLatLng();
                reverseGeocode(pos.lat, pos.lng);
            });
        }

        reverseGeocode(lat, lng);
    });

    // ── Nominatim Reverse Geocoding ──────────────────────────────────────────
    function reverseGeocode(lat, lng) {
        document.getElementById('partnerLat').value = lat;
        document.getElementById('partnerLng').value = lng;
        document.getElementById('addressDisplay').value = 'Đang lấy địa chỉ...';
        document.getElementById('addressDisplay').removeAttribute('readonly');

        var url = `https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}&accept-language=vi`;

        fetch(url, { headers: { 'Accept-Language': 'vi' } })
            .then(res => res.json())
            .then(data => {
                if (data && data.display_name) {
                    document.getElementById('addressDisplay').value = data.display_name;
                } else {
                    document.getElementById('addressDisplay').value = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                }
                document.getElementById('addressDisplay').setAttribute('readonly', 'readonly');
            })
            .catch(() => {
                document.getElementById('addressDisplay').value = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
                document.getElementById('addressDisplay').setAttribute('readonly', 'readonly');
            });
    }

    // ── Clear location ────────────────────────────────────────────────────────
    function clearLocation() {
        if (marker) { map.removeLayer(marker); marker = null; }
        document.getElementById('partnerLat').value = '';
        document.getElementById('partnerLng').value = '';
        document.getElementById('addressDisplay').value = '';
    }
</script>
