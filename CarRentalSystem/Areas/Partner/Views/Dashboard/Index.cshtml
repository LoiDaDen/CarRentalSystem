@{
    ViewData["Title"] = "Bảng điều khiển Đối Tác";
    var cars = ViewBag.Cars as IEnumerable<CarRentalSystem.Models.Car> ?? new List<CarRentalSystem.Models.Car>();
    decimal totalRevenue = ViewBag.TotalRevenue ?? 0m;
    decimal myEarnings = ViewBag.MyEarnings ?? 0m;
    int totalCars = ViewBag.TotalCars ?? 0;
    int activeBookings = ViewBag.ActiveBookings ?? 0;
    var commissionRate = cars.FirstOrDefault()?.CommissionRate ?? 20m;
    var partnerUser = ViewBag.PartnerUser as CarRentalSystem.Models.User;
}

<!-- Header -->
<div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-3">
    <div>
        <h4 class="fw-800 mb-1 text-dark">Tổng quan kinh doanh</h4>
        <p class="text-muted mb-0 small">Hiệu suất đội xe của bạn theo thời gian thực.</p>
        @if (partnerUser != null && !string.IsNullOrEmpty(partnerUser.PartnerAddress))
        {
            <div class="mt-1">
                <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill px-3 py-1 small">
                    <i class="bi bi-geo-alt-fill me-1"></i>@partnerUser.PartnerAddress.Split(',')[0].Trim()
                </span>
            </div>
        }
        else
        {
            <div class="mt-1">
                <a asp-area="Partner" asp-controller="Dashboard" asp-action="Profile"
                   class="badge bg-warning bg-opacity-10 text-warning rounded-pill px-3 py-1 small text-decoration-none">
                    <i class="bi bi-geo-alt me-1"></i>Chưa có vị trí — Click để cập nhật
                </a>
            </div>
        }
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-area="Partner" asp-controller="Dashboard" asp-action="Contract"
           class="btn btn-outline-primary btn-sm rounded-pill px-3" title="Hợp đồng">
            <i class="bi bi-file-earmark-text me-1"></i>Hợp đồng
        </a>
        <a asp-area="Partner" asp-controller="Dashboard" asp-action="Profile"
           class="btn btn-outline-secondary btn-sm rounded-pill px-3" title="Hồ sơ đối tác">
            <i class="bi bi-person-circle me-1"></i>Hồ sơ
        </a>
        <div class="d-flex align-items-center gap-2 bg-light px-3 py-2 rounded-pill border">
            <i class="bi bi-clock text-muted small"></i>
            <span class="small fw-600 text-muted" id="liveTime">@DateTime.Now.ToString("HH:mm - dd/MM/yyyy")</span>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card shadow-sm h-100" style="background: linear-gradient(135deg, #1d4ed8, #2563eb);">
            <div class="card-body p-4 text-white">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div class="small text-white text-opacity-75 fw-700 text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">Tổng số xe</div>
                        <h3 class="fw-800 mb-0">@totalCars</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-white bg-opacity-10" style="width:48px;height:48px;">
                        <i class="bi bi-car-front-fill fs-4"></i>
                    </div>
                </div>
                <div class="small text-white text-opacity-75">
                    <i class="bi bi-check-circle me-1"></i>Đang hoạt động trên sàn
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card shadow-sm h-100" style="background: linear-gradient(135deg, #059669, #10b981);">
            <div class="card-body p-4 text-white">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div class="small text-white text-opacity-75 fw-700 text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">Đang cho thuê</div>
                        <h3 class="fw-800 mb-0">@activeBookings</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-white bg-opacity-10" style="width:48px;height:48px;">
                        <i class="bi bi-calendar-check-fill fs-4"></i>
                    </div>
                </div>
                <div class="small text-white text-opacity-75">
                    <i class="bi bi-activity me-1"></i>Chuyến xe đang diễn ra
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card shadow-sm h-100" style="background: linear-gradient(135deg, #d97706, #f59e0b);">
            <div class="card-body p-4 text-white">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div class="small text-white text-opacity-75 fw-700 text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">Tổng doanh thu</div>
                        <h3 class="fw-800 mb-0" style="font-size: 1.5rem;">@((totalRevenue/1000000).ToString("N1"))M đ</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-white bg-opacity-10" style="width:48px;height:48px;">
                        <i class="bi bi-cash-stack fs-4"></i>
                    </div>
                </div>
                <div class="small text-white text-opacity-75">
                    <i class="bi bi-graph-up me-1"></i>Tổng giao dịch hoàn thành
                </div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card shadow-sm h-100" style="background: linear-gradient(135deg, #7c3aed, #a855f7);">
            <div class="card-body p-4 text-white">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div>
                        <div class="small text-white text-opacity-75 fw-700 text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">Thu nhập thực nhận</div>
                        <h3 class="fw-800 mb-0" style="font-size: 1.5rem;">@((myEarnings/1000000).ToString("N1"))M đ</h3>
                    </div>
                    <div class="rounded-3 d-flex align-items-center justify-content-center bg-white bg-opacity-10" style="width:48px;height:48px;">
                        <i class="bi bi-wallet2 fs-4"></i>
                    </div>
                </div>
                <div class="small text-white text-opacity-75">
                    <i class="bi bi-percent me-1"></i>Sau trừ @commissionRate% phí nền tảng
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Commission Banner -->
<div class="card border-0 shadow-sm mb-4 rounded-4 overflow-hidden" style="background: linear-gradient(135deg, #0f172a, #1e293b);">
    <div class="card-body p-4 d-flex justify-content-between align-items-center text-white">
        <div>
            <h6 class="fw-800 text-warning mb-1"><i class="bi bi-shield-check-fill me-2"></i>Chính sách hoa hồng minh bạch</h6>
            <p class="mb-0 text-white-50 small">Nền tảng giữ @commissionRate% hoa hồng. Bạn nhận được <strong class="text-success">@(100-commissionRate)%</strong> trên mỗi chuyến hoàn thành. Thanh toán trong 48h.</p>
        </div>
        <a asp-area="Partner" asp-controller="Dashboard" asp-action="Bookings" class="btn btn-outline-warning btn-sm rounded-pill px-4 fw-bold flex-shrink-0 ms-3">
            Xem thu nhập <i class="bi bi-arrow-right ms-1"></i>
        </a>
    </div>
</div>

<!-- Cars Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 rounded-top p-4">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h5 class="fw-800 mb-0 text-dark">Đội xe Hoạt động</h5>
                <small class="text-muted">Trạng thái tức thời của tất cả xe trên sàn</small>
            </div>
            <div class="d-flex gap-2">
                <a asp-area="Partner" asp-controller="Dashboard" asp-action="MyCars" class="btn btn-light btn-sm rounded-pill px-3 fw-600">
                    <i class="bi bi-grid me-1"></i>Xem tất cả
                </a>
                <a asp-area="Partner" asp-controller="Dashboard" asp-action="AddCar" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold">
                    <i class="bi bi-plus-lg me-1"></i>Thêm xe
                </a>
            </div>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!cars.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-car-front display-4 text-muted opacity-25 mb-3 d-block"></i>
                <h6 class="text-muted">Chưa có xe nào trên sàn</h6>
                <a asp-area="Partner" asp-controller="Dashboard" asp-action="AddCar" class="btn btn-warning rounded-pill px-4 mt-2">Đăng xe đầu tiên</a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead style="background:#f8fafc;">
                        <tr class="text-muted small text-uppercase" style="font-size:0.7rem; letter-spacing:0.5px;">
                            <th class="ps-4 py-3 border-0">Xe</th>
                            <th class="border-0">Biển số</th>
                            <th class="border-0">Loại</th>
                            <th class="border-0">Giá / Ngày</th>
                            <th class="border-0">Trạng thái</th>
                            <th class="text-end pe-4 border-0">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var car in cars.Take(8))
                        {
                            var statusBadge = car.CarStatus?.Name switch {
                                "Available" => "badge-available",
                                "Rented" => "badge-rented",
                                "Pending" => "badge-pending",
                                "Maintenance" => "badge-maintenance",
                                _ => "bg-secondary text-white"
                            };
                            var statusText = car.CarStatus?.Name switch {
                                "Available" => "Sẵn sàng",
                                "Rented" => "Đang thuê",
                                "Pending" => "Chờ duyệt",
                                "Maintenance" => "Bảo trì",
                                _ => car.CarStatus?.Name
                            };

                            <tr class="border-top border-light">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        @if (!string.IsNullOrEmpty(car.ImageURL))
                                        {
                                            <img src="@car.ImageURL" alt="@car.CarName" class="rounded-3" style="width:52px;height:40px;object-fit:cover;">
                                        }
                                        else
                                        {
                                            <div class="rounded-3 bg-light d-flex align-items-center justify-content-center" style="width:52px;height:40px;">
                                                <i class="bi bi-car-front text-muted"></i>
                                            </div>
                                        }
                                        <div>
                                            <div class="fw-700 text-dark small">@car.CarBrand?.Name @car.CarName</div>
                                            <small class="text-muted">@car.CarType?.Name • @car.Seats chỗ</small>
                                        </div>
                                    </div>
                                </td>
                                <td><span class="badge bg-light text-dark border fw-600">@car.LicensePlate</span></td>
                                <td class="small text-muted">@car.FuelType • @car.Transmission</td>
                                <td><span class="fw-700 text-dark">@car.PricePerDay.ToString("N0")đ</span></td>
                                <td>
                                    <span class="badge @statusBadge rounded-pill px-3 py-2" style="font-size:0.7rem;">
                                        <span class="me-1" style="display:inline-block;width:6px;height:6px;border-radius:50%;background:currentColor;"></span>
                                        @statusText
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <a asp-area="Partner" asp-controller="Dashboard" asp-action="EditCar" asp-route-id="@car.CarID" class="btn btn-sm btn-outline-primary rounded-pill px-3" title="Sửa thông tin">
                                            <i class="bi bi-pencil me-1"></i>Sửa
                                        </a>
                                        <a asp-area="" asp-controller="Car" asp-action="Details" asp-route-id="@car.CarID" class="btn btn-sm btn-light rounded-pill px-3" target="_blank" title="Xem trên sàn">
                                            <i class="bi bi-box-arrow-up-right"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        setInterval(() => {
            const now = new Date();
            const pad = n => n.toString().padStart(2, '0');
            document.getElementById('liveTime').textContent = `${pad(now.getHours())}:${pad(now.getMinutes())} - ${pad(now.getDate())}/${pad(now.getMonth()+1)}/${now.getFullYear()}`;
        }, 30000);
    </script>
}

<style>
    .fw-600 { font-weight: 600; }
    .fw-700 { font-weight: 700; }
    .fw-800 { font-weight: 800; }
    .stat-card { border-radius: 20px; transition: transform 0.25s ease, box-shadow 0.25s ease; }
    .stat-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,0.12) !important; }
    table { border-collapse: separate; border-spacing: 0; }
    .table-hover tbody tr:hover { background: #fafbff; }
    .badge-available { background: rgba(16,185,129,0.12); color: #059669; }
    .badge-rented { background: rgba(59,130,246,0.12); color: #2563eb; }
    .badge-pending { background: rgba(245,158,11,0.12); color: #d97706; }
    .badge-maintenance { background: rgba(239,68,68,0.12); color: #dc2626; }
</style>
