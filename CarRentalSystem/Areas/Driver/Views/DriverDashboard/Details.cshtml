@{
    ViewData["Title"] = "Chi tiết chuyến xe";
    var driverBooking = Model as CarRentalSystem.Models.DriverBooking;
    var booking = driverBooking?.Booking;
    var driver = driverBooking?.Driver;
    var now = DateTime.UtcNow;
    var isToday = booking?.StartDate.Date == now.Date;
    var canStart = driverBooking?.Status == "Confirmed" || driverBooking?.Status == "Pending";
    var canComplete = driverBooking?.Status == "Active";
    // Helper for safe date formatting
    string FormatDate(DateTime? dt, string format) => dt?.ToString(format) ?? "N/A";
    bool hasPickup = booking?.ActualPickupDate != null;
    bool hasReturn = booking?.ActualReturnDate != null;
}

<div class="trip-details">
    <!-- Back button -->
    <a asp-area="Driver" asp-controller="DriverDashboard" asp-action="Index" class="btn btn-light rounded-pill px-3 mb-4">
        <i class="bi bi-arrow-left me-1"></i>Quay lại danh sách
    </a>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Left Column: Trip Info -->
        <div class="col-lg-8">
            <!-- Status Card -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 overflow-hidden">
                <div class="card-header bg-white border-0 p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-800 mb-1 text-dark">
                                <i class="bi bi-car-front-fill text-primary me-2"></i>Thông tin chuyến xe
                            </h5>
                            <small class="text-muted">Mã đặt xe: #@booking?.BookingID</small>
                        </div>
                        @{
                            var statusBadge = driverBooking?.Status switch
                            {
                                "Pending" => "badge-pending",
                                "Confirmed" => "badge-confirmed",
                                "Active" => "badge-active",
                                "Completed" => "badge-completed",
                                "Cancelled" => "badge-cancelled",
                                _ => "bg-secondary text-white"
                            };
                            var statusText = driverBooking?.Status switch
                            {
                                "Pending" => "Chờ xác nhận",
                                "Confirmed" => "Đã xác nhận",
                                "Active" => "Đang hoạt động",
                                "Completed" => "Hoàn thành",
                                "Cancelled" => "Đã hủy",
                                _ => driverBooking?.Status
                            };
                        }
                        <span class="badge @statusBadge rounded-pill px-4 py-2" style="font-size: 0.85rem;">
                            <span class="me-1" style="display:inline-block;width:8px;height:8px;border-radius:50%;background:currentColor;"></span>
                            @statusText
                        </span>
                    </div>
                </div>
                <div class="card-body p-4">
                    <!-- Car Info -->
                    <div class="bg-light rounded-4 p-4 mb-4">
                        <div class="d-flex align-items-center gap-4">
                            @if (!string.IsNullOrEmpty(booking?.Car?.ImageURL))
                            {
                                <img src="@booking.Car.ImageURL" alt="@booking.Car.CarName" class="rounded-3" style="width:100px;height:75px;object-fit:cover;">
                            }
                            else
                            {
                                <div class="rounded-3 bg-white d-flex align-items-center justify-content-center" style="width:100px;height:75px;">
                                    <i class="bi bi-car-front fs-1 text-muted"></i>
                                </div>
                            }
                            <div>
                                <h5 class="fw-800 text-dark mb-1">
                                    @(booking?.Car != null ? $"{booking.Car.CarBrand?.Name} {booking.Car.CarName}" : "N/A")
                                </h5>
                                <div class="d-flex gap-3 flex-wrap">
                                    <span class="badge bg-white text-dark border rounded-pill px-3 py-2">
                                        <i class="bi bi-door-open me-1"></i>@booking?.Car?.Seats chỗ
                                    </span>
                                    <span class="badge bg-white text-dark border rounded-pill px-3 py-2">
                                        <i class="bi bi-gear me-1"></i>@booking?.Car?.Transmission
                                    </span>
                                    <span class="badge bg-white text-dark border rounded-pill px-3 py-2">
                                        <i class="bi bi-droplet me-1"></i>@booking?.Car?.FuelType
                                    </span>
                                </div>
                                @if (!string.IsNullOrEmpty(booking?.Car?.LicensePlate))
                                {
                                    <div class="mt-2">
                                        <span class="badge bg-dark text-white rounded-pill px-3 py-2">
                                            <i class="bi bi-123 me-1"></i>@booking.Car.LicensePlate
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Route -->
                    <div class="row g-4 mb-4">
                        <div class="col-md-6">
                            <div class="p-3 bg-success bg-opacity-10 rounded-4 border border-success border-opacity-25">
                                <div class="small text-success fw-700 text-uppercase mb-2">
                                    <i class="bi bi-geo-alt-fill me-1"></i>Điểm đón
                                </div>
                                <div class="fw-700 text-dark fs-6">@(booking?.PickupLocation?.Name ?? booking?.DeliveryAddress ?? "N/A")</div>
                                <div class="small text-muted mt-1">
                                    @FormatDate(booking?.StartDate, "HH:mm, dd/MM/yyyy")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 bg-danger bg-opacity-10 rounded-4 border border-danger border-opacity-25">
                                <div class="small text-danger fw-700 text-uppercase mb-2">
                                    <i class="bi bi-flag-fill me-1"></i>Điểm trả
                                </div>
                                <div class="fw-700 text-dark fs-6">@(booking?.ReturnLocation?.Name ?? "N/A")</div>
                                <div class="small text-muted mt-1">
                                    @FormatDate(booking?.EndDate, "HH:mm, dd/MM/yyyy")
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Trip Timeline -->
                    <div class="border-top pt-4">
                        <h6 class="fw-700 text-dark mb-3"><i class="bi bi-clock-history me-2"></i>Diễn biến chuyến</h6>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="text-center p-3 bg-light rounded-4">
                                    <i class="bi bi-calendar-plus fs-3 text-primary mb-2 d-block"></i>
                                    <div class="small text-muted">Ngày đặt</div>
                                    <div class="fw-700">@FormatDate(booking?.CreatedAt, "dd/MM/yyyy")</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-center p-3 bg-light rounded-4">
                                    <i class="bi bi-play-circle fs-3 @(hasPickup ? "text-success" : "text-muted") mb-2 d-block"></i>
                                    <div class="small text-muted">Bắt đầu</div>
                                    <div class="fw-700">@FormatDate(booking?.ActualPickupDate, "dd/MM HH:mm")</div>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="text-center p-3 bg-light rounded-4">
                                    <i class="bi bi-check-circle fs-3 @(hasReturn ? "text-success" : "text-muted") mb-2 d-block"></i>
                                    <div class="small text-muted">Kết thúc</div>
                                    <div class="fw-700">@FormatDate(booking?.ActualReturnDate, "dd/MM HH:mm")</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Action Buttons -->
            @if (canStart)
            {
                <div class="card border-success border-2 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-success bg-opacity-10 d-flex align-items-center justify-content-center" style="width:60px;height:60px;">
                                <i class="bi bi-play-circle-fill fs-2 text-success"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="fw-800 text-success mb-1">Bắt đầu chuyến đi</h5>
                                <p class="text-muted mb-0 small">Xác nhận khi bạn đã đón khách và bắt đầu hành trình.</p>
                            </div>
                            <form asp-area="Driver" asp-controller="DriverDashboard" asp-action="StartTrip" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@driverBooking?.DriverBookingID" />
                                <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 fw-bold booking-action-btn">
                                    <i class="bi bi-play-fill me-2"></i>Bắt đầu
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @if (canComplete)
            {
                <div class="card border-primary border-2 shadow-sm rounded-4 mb-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width:60px;height:60px;">
                                <i class="bi bi-check-circle-fill fs-2 text-primary"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="fw-800 text-primary mb-1">Hoàn thành chuyến đi</h5>
                                <p class="text-muted mb-0 small">Xác nhận khi bạn đã trả khách và kết thúc hành trình.</p>
                            </div>
                            <form asp-area="Driver" asp-controller="DriverDashboard" asp-action="CompleteTrip" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@driverBooking?.DriverBookingID" />
                                <button type="submit" class="btn btn-primary btn-lg rounded-pill px-5 fw-bold booking-action-btn">
                                    <i class="bi bi-check-lg me-2"></i>Hoàn thành
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }

            @if (driverBooking?.Status == "Pending" || driverBooking?.Status == "Confirmed")
            {
                <div class="card border-secondary shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <h6 class="fw-700 text-dark mb-1">Hủy phân công</h6>
                                <p class="text-muted mb-0 small">Nếu bạn không thể thực hiện chuyến đi này.</p>
                            </div>
                            <button class="btn btn-outline-danger rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#cancelModal">
                                <i class="bi bi-x-circle me-1"></i>Hủy
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Right Column: Customer & Payment Info -->
        <div class="col-lg-4">
            <!-- Customer Info -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-800 mb-0 text-dark">
                        <i class="bi bi-person-fill text-primary me-2"></i>Thông tin khách hàng
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center" style="width:56px;height:56px;">
                            <i class="bi bi-person fs-4 text-primary"></i>
                        </div>
                        <div>
                            <h6 class="fw-700 text-dark mb-1">@booking?.User?.Name</h6>
                            <small class="text-muted">@booking?.User?.Email</small>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(booking?.User?.Phone))
                    {
                        <div class="mb-2">
                            <i class="bi bi-telephone text-primary me-2"></i>
                            <span class="fw-600">@booking.User.Phone</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Payment Info -->
            <div class="card border-0 shadow-sm rounded-4 mb-4" style="background: linear-gradient(135deg, #1e293b, #334155);">
                <div class="card-body p-4 text-white">
                    <h5 class="fw-800 mb-3">
                        <i class="bi bi-wallet2 me-2"></i>Thông tin thanh toán
                    </h5>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-white border-opacity-10">
                        <span class="text-white-50">Tổng tiền thuê</span>
                        <span class="fw-700">@booking?.TotalPrice.ToString("N0")đ</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-white border-opacity-10">
                        <span class="text-white-50">Phí tài xế</span>
                        <span class="fw-700 text-warning">@driverBooking?.DriverFee.ToString("N0")đ</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-white border-opacity-10">
                        <span class="text-white-50">Đặt cọc</span>
                        <span class="fw-700">@booking?.DepositAmount.ToString("N0")đ</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center py-2">
                        <span class="text-white-50">Bảo hiểm</span>
                        <span class="fw-700">@booking?.InsuranceTier</span>
                    </div>
                </div>
            </div>

            <!-- Insurance Info -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-800 mb-0 text-dark">
                        <i class="bi bi-shield-check text-primary me-2"></i>Bảo hiểm
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        @{
                            var insuranceBadge = booking?.InsuranceTier switch
                            {
                                "Basic" => "bg-secondary",
                                "Premium" => "bg-primary",
                                "Full Cover" => "bg-success",
                                _ => "bg-secondary"
                            };
                        }
                        <span class="badge @insuranceBadge rounded-pill px-3 py-2">@booking?.InsuranceTier</span>
                    </div>
                    <p class="text-muted small mb-0">
                        @(booking?.InsuranceTier switch
                        {
                            "Basic" => "Bảo hiểm cơ bản, bồi thường thiệt hại thấp nhất.",
                            "Premium" => "Bảo hiểm nâng cao, bồi thường thiệt hại trung bình.",
                            "Full Cover" => "Bảo hiểm toàn diện, bồi thường cao nhất.",
                            _ => "Không có thông tin bảo hiểm."
                        })
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade" id="cancelModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-800">Xác nhận hủy phân công</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form asp-area="Driver" asp-controller="DriverDashboard" asp-action="CancelAssignment" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@driverBooking?.DriverBookingID" />
                <div class="modal-body">
                    <p class="text-muted">Bạn có chắc chắn muốn hủy nhận chuyến xe này? Hành động này không thể hoàn tác.</p>
                    <div class="mb-3">
                        <label class="form-label fw-600">Lý do hủy (tùy chọn)</label>
                        <textarea name="reason" class="form-control" rows="3" placeholder="Ví dụ: Gặp sự cố đột xuất..."></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Đóng</button>
                    <button type="submit" class="btn btn-danger rounded-pill">
                        <i class="bi bi-x-circle me-1"></i>Xác nhận hủy
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<style>
    .badge-pending { background: rgba(245,158,11,0.12); color: #d97706; }
    .badge-confirmed { background: rgba(37,99,235,0.12); color: #2563eb; }
    .badge-active { background: rgba(16,185,129,0.12); color: #059669; }
    .badge-completed { background: rgba(100,116,139,0.12); color: #64748b; }
    .badge-cancelled { background: rgba(239,68,68,0.12); color: #dc2626; }
</style>

<!-- Cancelled trip overlay modal -->
<div class="modal fade" id="tripCancelledModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-danger text-white border-0 rounded-top-4">
                <h5 class="modal-title"><i class="bi bi-exclamation-octagon me-2"></i>Thông báo</h5>
            </div>
            <div class="modal-body text-center p-4">
                <i class="bi bi-x-circle-fill text-danger display-3 mb-3"></i>
                <h5 class="fw-bold text-dark mb-2">Chuyến đi đã bị hủy</h5>
                <p class="text-muted mb-0">Khách hàng đã hủy chuyến đi này. Vui lòng quay về danh sách chuyến xe.</p>
            </div>
            <div class="modal-footer border-0">
                <a asp-area="Driver" asp-controller="DriverDashboard" asp-action="Index" class="btn btn-danger rounded-pill px-5 fw-bold">
                    <i class="bi bi-arrow-left me-1"></i>Đã hiểu
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// Polling: check if booking was cancelled by customer every 5 seconds
(function() {
    var driverBookingId = @((driverBooking?.DriverBookingID ?? 0));
    if (driverBookingId === 0) return;

    var cancelledStatuses = ['Cancelled', 'Rejected', 'Rejected by Admin'];
    var currentStatus = '@(driverBooking?.Status ?? "")';
    var isPendingOrConfirmed = currentStatus === 'Pending' || currentStatus === 'Confirmed';

    // Show cancelled modal if redirected from StartTrip with force flag
    var forceCancelled = '@(TempData["ForceCancelled"] ?? "")';
    if (forceCancelled === '1' && isPendingOrConfirmed) {
        var modal = new bootstrap.Modal(document.getElementById('tripCancelledModal'));
        modal.show();
        return; // No need to poll
    }

    // Only poll for pending/confirmed trips
    if (!isPendingOrConfirmed) return;

    function pollStatus() {
        fetch('@Url.Action("CheckBookingStatus", "DriverDashboard", new { area = "Driver" })?id=' + driverBookingId, {
            headers: { 'Accept': 'application/json' }
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success && data.isCancelled) {
                // Show cancellation modal
                var modal = new bootstrap.Modal(document.getElementById('tripCancelledModal'));
                modal.show();
                // Disable all action buttons
                document.querySelectorAll('.booking-action-btn').forEach(function(btn) {
                    btn.disabled = true;
                    btn.classList.add('disabled');
                });
            }
        })
        .catch(function() {});
    }

    // Poll every 5 seconds
    setInterval(pollStatus, 5000);
})();
</script>
}
