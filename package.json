{
  "name": "carrentalsystem-tests",
  "version": "1.0.0",
  "description": "Playwright E2E tests for Car Rental System",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-playwright.mjs test",
    "test:playwright": "node scripts/run-playwright.mjs test",
    "test:e2e:full": "node scripts/run-playwright.mjs test playwright/e2e/**/*.spec.{js,ts}",
    "test:e2e:smoke": "node scripts/run-playwright.mjs test playwright/e2e/smoke/**/*.spec.{js,ts}",
    "test:e2e:prod:preflight": "node scripts/run-playwright-production.mjs preflight",
    "test:e2e:prod:smoke": "node scripts/run-playwright-production.mjs smoke",
    "test:e2e:prod:full": "node scripts/run-playwright-production.mjs full",
    "test:e2e:prod:cleanup": "node scripts/run-playwright-production.mjs cleanup",
    "test:e2e:prod:report": "node scripts/report-playwright-traceability.mjs && node scripts/report-playwright-production.mjs",
    "testcases:extract": "node scripts/extract-playwright-testcases.mjs",
    "testcases:report": "node scripts/report-playwright-traceability.mjs"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pptxgenjs": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0"
  }
}
