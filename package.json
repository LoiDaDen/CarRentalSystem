{
  "name": "carrentalsystem-tests",
  "version": "1.0.0",
  "description": "Cypress E2E tests for Car Rental System",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "node scripts/run-cypress.mjs run",
    "test:cypress": "node scripts/run-cypress.mjs run",
    "test:e2e:full": "node scripts/run-cypress.mjs run --browser chrome --spec \"cypress/e2e/**/*.cy.{js,jsx,ts,tsx}\"",
    "test:e2e:sandbox": "node scripts/run-cypress.mjs run --browser chrome --spec \"cypress/e2e/11-sandbox-realtime/**/*.cy.{js,jsx,ts,tsx}\"",
    "testcases:extract": "node scripts/extract-cypress-testcases.mjs",
    "testcases:report": "node scripts/report-cypress-traceability.mjs"
  },
  "devDependencies": {
    "cypress": "^13.7.0"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "pptxgenjs": "^4.0.1"
  }
}
