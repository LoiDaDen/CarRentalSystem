# ============================================================
# CarRentalSystem — Docker Compose Environment Variables
# Sao chép file này thành .env và điền giá trị thực tế
# ============================================================

# ── SQL Server ────────────────────────────────────────────
SA_PASSWORD=YourStrong@Password123!

# ── Redis ────────────────────────────────────────────────
REDIS_PASSWORD=your-redis-password

# ── Hangfire Dashboard ─────────────────────────────────────
HANGFIRE_PASSWORD=YourHangfirePassword123!

# ── Encryption Key (đặt key ngẫu nhiên trong production) ─
ENCRYPTION_KEY=your-32-char-minimum-encryption-key-here!

# ── SMTP / Email ──────────────────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── FPT eKYC API ──────────────────────────────────────────
FPT_EKYC_URL=https://api.fpt.ai
FPT_EKYC_KEY=your-fpt-api-key

# ===== Groq AI Chat (Miễn phí, không giới hạn) =====
GROQ_API_KEY=your-groq-api-key

# ===== Legal feature gates =====
# false: chỉ dùng ledger nội bộ, không cho nạp/rút/giữ số dư như ví điện tử nếu chưa có giấy phép trung gian thanh toán.
Features__WalletStoredValue=false
# false: không bật luồng thuê xe có tài xế public nếu chưa có hồ sơ điều kiện kinh doanh vận tải.
Features__WithDriverPublicBooking=false

# ===== PayOS Payment Gateway =====
# Lấy từ https://payos.vn/
PayOS__ClientId=your-payos-client-id
PayOS__ApiKey=your-payos-api-key
PayOS__ChecksumKey=your-payos-checksum-key

# ===== Cypress vendor sandbox =====
CYPRESS_RESET_SECRET=local-cypress-reset
CYPRESS_USE_PAYOS_SANDBOX=false
CYPRESS_USE_FPT_SANDBOX=false
Cypress__UsePayOSSandbox=false
Cypress__UseFptSandbox=false
App__PublicBaseUrl=https://your-public-cypress-tunnel.example.com
FptAi__ApiKey=your-fpt-ai-sandbox-api-key
