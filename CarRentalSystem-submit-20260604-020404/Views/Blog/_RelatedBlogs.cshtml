@model IEnumerable<CarRentalSystem.Models.Blog>

@if (Model.Any())
{
    <section class="mt-5">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <h2 class="h4 fw-bold mb-0">Bài viết liên quan</h2>
            <a asp-controller="Blog" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-3 fw-bold">Xem tất cả</a>
        </div>
        <div class="row g-4">
            @foreach (var blog in Model)
            {
                <div class="col-md-4">
                    @await Html.PartialAsync("_BlogCard", blog)
                </div>
            }
        </div>
    </section>
}
