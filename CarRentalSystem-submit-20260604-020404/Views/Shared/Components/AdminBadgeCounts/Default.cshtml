@model CarRentalSystem.ViewComponents.AdminBadgeCounts

@*
    This component sets ViewBag values used by the sidebar.
    The sidebar reads from ViewBag which is set by the controller,
    so we populate ViewData here for the layout to use.
*@
@{
    ViewData["PendingDriverCount"] = Model.PendingDriverCount;
    ViewData["ContractBadgeCount"] = Model.ContractBadgeCount;
}
