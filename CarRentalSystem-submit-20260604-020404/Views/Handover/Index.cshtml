@{
    ViewData["Title"] = "Biên bản bàn giao";
    var booking = ViewBag.Booking as CarRentalSystem.Models.Booking;
    var records = ViewBag.HandoverRecords as IEnumerable<CarRentalSystem.Models.HandoverRecord>
        ?? Enumerable.Empty<CarRentalSystem.Models.HandoverRecord>();
}

<div class="container py-5" style="max-width: 960px;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Biên bản bàn giao</h2>
            <p class="text-muted mb-0">Theo dõi ảnh, chữ ký và trạng thái bàn giao của chuyến thuê.</p>
        </div>
        @if (booking != null)
        {
            <a asp-controller="Booking" asp-action="Details" asp-route-id="@booking.BookingID" class="btn btn-outline-secondary rounded-3">
                <i class="bi bi-arrow-left me-2"></i>Chi tiết đơn
            </a>
        }
    </div>

    @if (booking == null)
    {
        <div class="alert alert-warning rounded-3">Không tìm thấy chuyến thuê.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div>
                        <div class="text-muted small">Mã chuyến</div>
                        <h4 class="fw-bold mb-1">#@booking.BookingID - @booking.Car?.CarBrand?.Name @booking.Car?.CarName</h4>
                        <div class="text-muted">
                            @booking.StartDate.ToString("dd/MM/yyyy HH:mm") - @booking.EndDate.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                        @(booking.BookingStatus?.Name ?? "Unknown")
                    </span>
                </div>
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2 mb-4">
            <a asp-controller="Handover" asp-action="Capture" asp-route-bookingId="@booking.BookingID" asp-route-type="CheckIn"
               class="btn btn-primary rounded-3">
                <i class="bi bi-camera me-2"></i>Lập biên bản nhận xe
            </a>
            <a asp-controller="Handover" asp-action="Capture" asp-route-bookingId="@booking.BookingID" asp-route-type="CheckOut"
               class="btn btn-outline-primary rounded-3">
                <i class="bi bi-flag me-2"></i>Lập biên bản trả xe
            </a>
        </div>

        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 p-4 pb-0">
                <h5 class="fw-bold mb-0">Hồ sơ đã lưu</h5>
            </div>
            <div class="card-body p-4">
                @if (!records.Any())
                {
                    <div class="text-center text-muted py-4">
                        <i class="bi bi-folder2-open fs-1 d-block mb-2"></i>
                        Chưa có biên bản bàn giao nào cho chuyến thuê này.
                    </div>
                }
                else
                {
                    <div class="list-group list-group-flush">
                        @foreach (var record in records)
                        {
                            <a asp-controller="Handover" asp-action="ViewRecord" asp-route-id="@record.HandoverID"
                               class="list-group-item list-group-item-action d-flex align-items-center justify-content-between px-0">
                                <div>
                                    <div class="fw-bold">@record.Type</div>
                                    <div class="text-muted small">
                                        @record.RecordDate.ToString("dd/MM/yyyy HH:mm") - ODO @record.Odo km - Nhiên liệu @record.FuelLevel
                                    </div>
                                </div>
                                <i class="bi bi-chevron-right"></i>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>
