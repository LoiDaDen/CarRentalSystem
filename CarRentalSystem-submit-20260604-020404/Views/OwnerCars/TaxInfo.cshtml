@model CarRentalSystem.ViewModels.OwnerTaxInfoViewModel
@{
    ViewData["Title"] = "Thông tin khai thuế";
}

<div class="owner-portal">
    @await Html.PartialAsync("_OwnerPortalHeader", Model.Chrome)

    <section class="owner-panel">
        <h2>Thông tin khai thuế chủ xe</h2>
        <p class="owner-muted">V1 hiển thị thông tin tham chiếu từ hồ sơ tài khoản. Web chưa lưu riêng mã số thuế/hình thức cư trú để tránh tạo dữ liệu pháp lý chưa hoàn chỉnh.</p>

        <div class="owner-toolbar" style="grid-template-columns: repeat(2, minmax(0, 1fr)); box-shadow:none; margin-top:18px;">
            <div class="owner-field">
                <label>Loại hình kinh doanh</label>
                <select disabled>
                    <option>Cá nhân kinh doanh / Hộ kinh doanh</option>
                </select>
            </div>
            <div class="owner-field">
                <label>Loại hình cư trú</label>
                <select disabled>
                    <option>Cá nhân cư trú</option>
                </select>
            </div>
            <div class="owner-field">
                <label>Họ và tên</label>
                <input value="@Model.FullName" readonly />
            </div>
            <div class="owner-field">
                <label>Số điện thoại</label>
                <input value="@Model.Phone" readonly />
            </div>
            <div class="owner-field">
                <label>Email</label>
                <input value="@Model.Email" readonly />
            </div>
            <div class="owner-field">
                <label>Địa chỉ</label>
                <input value="@Model.Address" readonly />
            </div>
        </div>

        <div class="owner-badges">
            <span class="owner-badge info"><i class="bi bi-info-circle"></i> Thông tin thuế chi tiết sẽ được lưu khi có schema pháp lý riêng</span>
            <a class="owner-badge ok text-decoration-none" href="/docs/owner/khai-thue-cnkd-tmdt.pdf" target="_blank" rel="noopener">
                <i class="bi bi-download"></i> Tải cẩm nang quyết toán thuế
            </a>
        </div>
    </section>
</div>
