@model CarRentalSystem.Models.DigitalContract
@{
    ViewData["Title"] = "Hợp đồng số";
    var canSign = ViewBag.CanSign as bool? ?? false;
}

<div class="container py-4 py-lg-5" style="max-width: 960px;">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <div class="text-muted small text-uppercase fw-bold">Hợp đồng số</div>
            <h1 class="h3 fw-bold mb-0">@Model.ContractNo</h1>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (Model.BookingID.HasValue)
            {
                <a asp-controller="Booking" asp-action="Details" asp-route-id="@Model.BookingID" class="btn btn-outline-secondary rounded-3">
                    <i class="bi bi-arrow-left me-1"></i>Đơn thuê
                </a>
            }
            @if (!Model.IsSignedByCustomer && canSign)
            {
                <a asp-action="Sign" asp-route-id="@Model.DigitalContractID" class="btn btn-primary rounded-3 fw-bold">
                    <i class="bi bi-pen me-1"></i>Ký hợp đồng
                </a>
            }
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success rounded-3">@TempData["Success"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info rounded-3">@TempData["Info"]</div>
    }

    @await Html.PartialAsync("_ContractDocument", Model)
</div>
