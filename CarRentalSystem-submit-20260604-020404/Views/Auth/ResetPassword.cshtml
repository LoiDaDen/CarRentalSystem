@model CarRentalSystem.ViewModels.ResetPasswordViewModel
@{
    ViewData["Title"] = "Đặt lại mật khẩu";
    var successMessage = TempData["SuccessMessage"]?.ToString();
}

<div class="row justify-content-center align-items-center" style="min-height: 70vh;">
    <div class="col-md-6 col-lg-5">
        <div class="text-center mb-4">
            <h1 class="h3 fw-bold text-primary mb-2">Đặt lại mật khẩu</h1>
            <p class="text-muted mb-0">Nhập mã OTP đã gửi đến email và tạo mật khẩu mới.</p>
        </div>

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success border-0 shadow-sm mb-4">
                <i class="bi bi-check-circle me-2"></i>@successMessage
            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger border-0 shadow-sm mb-4">
                <i class="bi bi-exclamation-triangle me-2"></i>@ViewBag.Error
            </div>
        }

        <div class="card border-0 shadow-lg p-4 p-md-5 rounded-4">
            <form asp-action="ResetPassword" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="Email" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center gap-2 bg-light rounded-pill px-3 py-2 small fw-semibold text-primary">
                        <i class="bi bi-envelope-check"></i>
                        @Model.Email
                    </div>
                    <div class="form-text mt-2">Mã OTP có hiệu lực trong 5 phút.</div>
                </div>

                <div class="mb-3">
                    <label asp-for="Otp" class="form-label small fw-bold text-muted text-uppercase ls-1">Mã OTP</label>
                    <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-key text-muted"></i></span>
                        <input asp-for="Otp" class="form-control bg-transparent border-0 py-3 text-center fw-bold" maxlength="6" inputmode="numeric" autocomplete="one-time-code" placeholder="000000" autofocus />
                    </div>
                    <span asp-validation-for="Otp" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label small fw-bold text-muted text-uppercase ls-1">Mật khẩu mới</label>
                    <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-lock text-muted"></i></span>
                        <input asp-for="NewPassword" type="password" class="form-control bg-transparent border-0 py-3" autocomplete="new-password" placeholder="Tối thiểu 6 ký tự" />
                    </div>
                    <span asp-validation-for="NewPassword" class="text-danger small"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label small fw-bold text-muted text-uppercase ls-1">Xác nhận mật khẩu</label>
                    <div class="input-group bg-light rounded-3 overflow-hidden border-0">
                        <span class="input-group-text bg-transparent border-0"><i class="bi bi-shield-lock text-muted"></i></span>
                        <input asp-for="ConfirmPassword" type="password" class="form-control bg-transparent border-0 py-3" autocomplete="new-password" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill py-3 fw-bold">
                    <i class="bi bi-check-circle me-2"></i>Đổi mật khẩu
                </button>
            </form>

            <div class="d-flex justify-content-between mt-4 small">
                <a asp-action="ForgotPassword" class="text-decoration-none">
                    <i class="bi bi-arrow-clockwise me-1"></i>Gửi mã mới
                </a>
                <a asp-action="Login" class="text-decoration-none">
                    <i class="bi bi-arrow-left me-1"></i>Đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
