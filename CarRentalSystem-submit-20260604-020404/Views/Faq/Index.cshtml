@model CarRentalSystem.ViewModels.FaqIndexViewModel
@{
    ViewData["Title"] = "Câu hỏi thường gặp";
    var supportCategories = new[]
    {
        new { Label = "Tất cả", Slug = "all", Icon = "bi-grid" }
    }
    .Concat(Model.Sections.Select(section => new { Label = section.Title, Slug = section.Slug, Icon = section.Icon }))
    .ToList();
}

<section class="faq-page" data-faq-page>
    <div class="faq-hero">
        <div class="faq-hero-content">
            <span class="pt-eyebrow">Trung tâm trợ giúp</span>
            <h1 class="pt-title faq-title">Câu hỏi thường gặp khi thuê xe</h1>
            <p class="pt-subtitle faq-subtitle">
                Tìm nhanh câu trả lời về đặt xe, eKYC, thanh toán, nhận trả xe và các tình huống phát sinh trong chuyến đi.
            </p>
            <div class="faq-search-wrap" role="search">
                <i class="bi bi-search" aria-hidden="true"></i>
                <label class="visually-hidden" for="faqSearchInput">Tìm kiếm câu hỏi FAQ</label>
                <input id="faqSearchInput" class="faq-search-input" type="search" placeholder="Tìm theo từ khóa: đặt cọc, eKYC, hủy chuyến..." autocomplete="off" data-faq-search />
            </div>
            <div class="faq-hero-actions">
                <a class="btn btn-primary" asp-controller="Car" asp-action="Index">
                    <i class="bi bi-car-front me-2" aria-hidden="true"></i>Tìm xe phù hợp
                </a>
                <button class="btn btn-outline-primary" type="button" data-open-chatbot>
                    <i class="bi bi-chat-dots me-2" aria-hidden="true"></i>Hỏi trợ lý AI
                </button>
            </div>
        </div>
        <div class="faq-hero-panel" aria-label="Tóm tắt hỗ trợ">
            <div class="faq-panel-metric">
                <strong>@Model.TotalQuestions</strong>
                <span>câu hỏi phổ biến</span>
            </div>
            <div class="faq-panel-item">
                <i class="bi bi-lightning-charge" aria-hidden="true"></i>
                <div>
                    <strong>Trả lời nhanh</strong>
                    <span>Theo từng bước thuê xe thực tế</span>
                </div>
            </div>
            <div class="faq-panel-item">
                <i class="bi bi-shield-lock" aria-hidden="true"></i>
                <div>
                    <strong>Rõ trách nhiệm</strong>
                    <span>Giấy tờ, thanh toán, bàn giao và sự cố</span>
                </div>
            </div>
            <div class="faq-panel-item">
                <i class="bi bi-headset" aria-hidden="true"></i>
                <div>
                    <strong>Hỗ trợ tiếp</strong>
                    <span>Gửi yêu cầu nếu FAQ chưa đủ thông tin</span>
                </div>
            </div>
        </div>
    </div>

    <div class="faq-layout">
        <aside class="faq-sidebar" aria-label="Danh mục FAQ">
            <div class="faq-sidebar-inner">
                <div class="faq-sidebar-title">Danh mục</div>
                <div class="faq-category-list" role="tablist" aria-label="Lọc FAQ theo danh mục">
                    @foreach (var category in supportCategories)
                    {
                        <button class="faq-category-btn @(category.Slug == "all" ? "active" : "")" type="button" data-faq-category="@category.Slug" aria-pressed="@(category.Slug == "all" ? "true" : "false")">
                            <i class="bi @category.Icon" aria-hidden="true"></i>
                            <span>@category.Label</span>
                        </button>
                    }
                </div>
            </div>
        </aside>

        <div class="faq-content">
            <div class="faq-result-bar">
                <div>
                    <span class="pt-eyebrow">Kết quả</span>
                    <h2 class="h4 fw-bold mb-0">Giải đáp theo chủ đề</h2>
                </div>
                <span class="faq-result-count" data-faq-count>@Model.TotalQuestions câu hỏi</span>
            </div>

            <div class="faq-empty" data-faq-empty hidden>
                <i class="bi bi-search" aria-hidden="true"></i>
                <h3>Chưa tìm thấy câu hỏi phù hợp</h3>
                <p>Thử từ khóa ngắn hơn hoặc gửi yêu cầu hỗ trợ để đội ngũ CarRental kiểm tra giúp bạn.</p>
            </div>

            <div class="faq-section-stack">
                @for (var sectionIndex = 0; sectionIndex < Model.Sections.Count; sectionIndex++)
                {
                    var faqSection = Model.Sections[sectionIndex];
                    <section class="faq-section" data-faq-section="@faqSection.Slug">
                        <div class="faq-section-heading">
                            <div class="faq-section-icon">
                                <i class="bi @faqSection.Icon" aria-hidden="true"></i>
                            </div>
                            <div>
                                <h2>@faqSection.Title</h2>
                                <p>@faqSection.Description</p>
                            </div>
                        </div>

                        <div class="accordion faq-accordion" id="faqAccordion-@faqSection.Slug">
                            @for (var itemIndex = 0; itemIndex < faqSection.Items.Count; itemIndex++)
                            {
                                var item = faqSection.Items[itemIndex];
                                var itemId = $"faq-{faqSection.Slug}-{itemIndex}";
                                var collapseId = $"faq-collapse-{faqSection.Slug}-{itemIndex}";
                                <article class="accordion-item faq-item" data-faq-item data-faq-category="@faqSection.Slug" data-faq-text="@($"{faqSection.Title} {item.Badge} {item.Question} {item.Answer}".ToLowerInvariant())">
                                    <h3 class="accordion-header" id="@itemId">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId" aria-expanded="false" aria-controls="@collapseId">
                                            <span class="faq-item-badge">@item.Badge</span>
                                            <span>@item.Question</span>
                                        </button>
                                    </h3>
                                    <div id="@collapseId" class="accordion-collapse collapse" aria-labelledby="@itemId" data-bs-parent="#faqAccordion-@faqSection.Slug">
                                        <div class="accordion-body">
                                            @item.Answer
                                        </div>
                                    </div>
                                </article>
                            }
                        </div>
                    </section>
                }
            </div>
        </div>
    </div>

    <section class="faq-support-cta" aria-labelledby="faqSupportTitle">
        <div>
            <span class="pt-eyebrow">Cần hỗ trợ thêm?</span>
            <h2 id="faqSupportTitle">Gửi câu hỏi để đội ngũ CarRental xử lý đúng ngữ cảnh chuyến xe</h2>
            <p>
                Với vấn đề liên quan đến thanh toán, nhận trả xe, sự cố hoặc tranh chấp, hãy mô tả ngắn gọn và đính kèm mã đặt xe nếu có.
            </p>
        </div>
        <div class="faq-support-actions">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <button class="btn btn-primary" type="button" data-bs-toggle="modal" data-bs-target="#faqSupportModal">
                    <i class="bi bi-send-check me-2" aria-hidden="true"></i>Gửi yêu cầu hỗ trợ
                </button>
            }
            else
            {
                <a class="btn btn-primary" asp-controller="Auth" asp-action="Login" asp-route-returnUrl="/FAQ">
                    <i class="bi bi-box-arrow-in-right me-2" aria-hidden="true"></i>Đăng nhập để gửi yêu cầu
                </a>
            }
            <a class="btn btn-outline-primary" href="tel:19001234">
                <i class="bi bi-telephone me-2" aria-hidden="true"></i>1900 1234
            </a>
        </div>
    </section>
</section>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="modal fade" id="faqSupportModal" tabindex="-1" aria-labelledby="faqSupportModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content faq-support-modal">
                <div class="modal-header">
                    <div>
                        <span class="pt-eyebrow">Support ticket</span>
                        <h2 class="modal-title h5" id="faqSupportModalLabel">Gửi yêu cầu hỗ trợ</h2>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <form asp-controller="Support" asp-action="Create" method="post" id="faqSupportForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ticketType" value="General" />
                    <input type="hidden" name="priority" value="P2" />
                    <input type="hidden" name="bookingId" value="" />
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label" for="faqSupportSubject">Tiêu đề</label>
                            <input class="form-control" id="faqSupportSubject" name="subject" maxlength="200" required placeholder="Ví dụ: Cần hỗ trợ đổi giờ nhận xe" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="faqSupportDescription">Nội dung</label>
                            <textarea class="form-control" id="faqSupportDescription" name="description" rows="5" maxlength="4000" required placeholder="Mô tả vấn đề, mã đặt xe nếu có và thời điểm cần hỗ trợ."></textarea>
                        </div>
                        <div class="faq-form-status" role="status" aria-live="polite" data-faq-support-status></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Đóng</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-send me-2" aria-hidden="true"></i>Gửi yêu cầu
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Styles {
    <style>
        .faq-page {
            display: grid;
            gap: clamp(1.5rem, 3vw, 2.5rem);
        }

        .faq-hero {
            position: relative;
            display: grid;
            grid-template-columns: minmax(0, 1.35fr) minmax(300px, .65fr);
            gap: clamp(1rem, 3vw, 2rem);
            overflow: hidden;
            padding: clamp(1.5rem, 4vw, 3rem);
            border: 1px solid var(--pt-border);
            border-radius: var(--pt-radius-lg, 24px);
            background:
                linear-gradient(135deg, rgba(37, 99, 235, .12), rgba(16, 185, 129, .1)),
                linear-gradient(180deg, #ffffff, #f8fbff);
            box-shadow: var(--pt-shadow-sm);
        }

        .faq-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background-image:
                linear-gradient(rgba(37, 99, 235, .08) 1px, transparent 1px),
                linear-gradient(90deg, rgba(37, 99, 235, .08) 1px, transparent 1px);
            background-size: 44px 44px;
            mask-image: linear-gradient(120deg, rgba(0, 0, 0, .28), transparent 70%);
        }

        .faq-hero-content,
        .faq-hero-panel {
            position: relative;
            z-index: 1;
        }

        .faq-title {
            max-width: 820px;
            margin: .35rem 0 .75rem;
            font-size: clamp(2.1rem, 5vw, 4.5rem);
            line-height: 1.02;
        }

        .faq-subtitle {
            max-width: 720px;
            font-size: clamp(1rem, 1.6vw, 1.18rem);
        }

        .faq-search-wrap {
            display: flex;
            align-items: center;
            gap: .8rem;
            max-width: 780px;
            min-height: 58px;
            margin-top: 1.5rem;
            padding: 0 1rem;
            border: 1px solid var(--pt-border-strong);
            border-radius: 18px;
            background: #ffffff;
            box-shadow: 0 18px 45px rgba(15, 23, 42, .08);
        }

        .faq-search-wrap i {
            color: var(--pt-primary);
            font-size: 1.2rem;
        }

        .faq-search-input {
            width: 100%;
            min-width: 0;
            border: 0;
            outline: 0;
            color: var(--pt-text);
            font-weight: 650;
        }

        .faq-hero-actions {
            display: flex;
            flex-wrap: wrap;
            gap: .75rem;
            margin-top: 1.25rem;
        }

        .faq-hero-panel {
            align-self: stretch;
            display: grid;
            gap: .85rem;
            padding: 1rem;
            border: 1px solid rgba(255, 255, 255, .72);
            border-radius: 22px;
            background: rgba(255, 255, 255, .78);
            box-shadow: var(--pt-shadow-md);
            backdrop-filter: blur(12px);
        }

        .faq-panel-metric {
            padding: 1rem;
            border-radius: 18px;
            background: #0f172a;
            color: #ffffff;
        }

        .faq-panel-metric strong {
            display: block;
            font-size: 2.4rem;
            line-height: 1;
        }

        .faq-panel-metric span,
        .faq-panel-item span {
            display: block;
            color: rgba(255, 255, 255, .72);
            font-size: .9rem;
        }

        .faq-panel-item {
            display: flex;
            align-items: center;
            gap: .85rem;
            min-width: 0;
            padding: .85rem;
            border: 1px solid var(--pt-border);
            border-radius: 16px;
            background: #ffffff;
        }

        .faq-panel-item i,
        .faq-section-icon {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 42px;
            height: 42px;
            flex: 0 0 42px;
            border-radius: 14px;
            background: var(--pt-primary-soft);
            color: var(--pt-primary);
            font-size: 1.2rem;
        }

        .faq-panel-item span {
            color: var(--pt-muted);
        }

        .faq-layout {
            display: grid;
            grid-template-columns: 300px minmax(0, 1fr);
            gap: 1.25rem;
            align-items: start;
        }

        .faq-sidebar {
            position: sticky;
            top: 96px;
        }

        .faq-sidebar-inner,
        .faq-result-bar,
        .faq-section,
        .faq-support-cta,
        .faq-empty {
            border: 1px solid var(--pt-border);
            border-radius: var(--pt-radius);
            background: var(--pt-surface);
            box-shadow: var(--pt-shadow-sm);
        }

        .faq-sidebar-inner {
            padding: 1rem;
        }

        .faq-sidebar-title {
            margin-bottom: .8rem;
            color: var(--pt-text);
            font-weight: 850;
        }

        .faq-category-list {
            display: grid;
            gap: .45rem;
        }

        .faq-category-btn {
            display: flex;
            align-items: center;
            gap: .65rem;
            width: 100%;
            min-height: 46px;
            padding: .65rem .75rem;
            border: 1px solid transparent;
            border-radius: 14px;
            background: transparent;
            color: var(--pt-text-soft);
            font-weight: 750;
            text-align: left;
            transition: all .2s ease;
        }

        .faq-category-btn:hover,
        .faq-category-btn.active {
            border-color: #cfe0ff;
            background: var(--pt-primary-soft);
            color: var(--pt-primary);
        }

        .faq-content,
        .faq-section-stack {
            display: grid;
            gap: 1rem;
            min-width: 0;
        }

        .faq-result-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 1rem 1.15rem;
        }

        .faq-result-count {
            flex: 0 0 auto;
            padding: .45rem .8rem;
            border-radius: 999px;
            background: var(--pt-surface-soft);
            color: var(--pt-text-soft);
            font-weight: 800;
            font-size: .88rem;
        }

        .faq-section {
            padding: clamp(1rem, 2vw, 1.25rem);
        }

        .faq-section-heading {
            display: flex;
            gap: .9rem;
            margin-bottom: 1rem;
        }

        .faq-section-heading h2 {
            margin: 0;
            color: var(--pt-text);
            font-size: 1.22rem;
            font-weight: 850;
        }

        .faq-section-heading p {
            margin: .2rem 0 0;
            color: var(--pt-muted);
        }

        .faq-accordion {
            display: grid;
            gap: .6rem;
        }

        .faq-item {
            overflow: hidden;
            border: 1px solid var(--pt-border) !important;
            border-radius: 16px !important;
            background: #ffffff;
        }

        .faq-item .accordion-button {
            display: flex;
            gap: .7rem;
            align-items: center;
            min-height: 62px;
            padding: .9rem 1rem;
            background: #ffffff;
            color: var(--pt-text);
            font-weight: 800;
            box-shadow: none;
        }

        .faq-item .accordion-button:not(.collapsed) {
            background: linear-gradient(180deg, #ffffff, #f8fbff);
            color: var(--pt-primary);
        }

        .faq-item .accordion-button:focus {
            box-shadow: 0 0 0 3px rgba(37, 99, 235, .14);
        }

        .faq-item-badge {
            flex: 0 0 auto;
            padding: .28rem .58rem;
            border-radius: 999px;
            background: var(--pt-surface-soft);
            color: var(--pt-text-soft);
            font-size: .72rem;
            font-weight: 850;
        }

        .faq-item .accordion-body {
            padding: 0 1rem 1rem 1rem;
            color: var(--pt-text-soft);
            line-height: 1.72;
        }

        .faq-empty {
            padding: 2rem;
            text-align: center;
        }

        .faq-empty i {
            color: var(--pt-primary);
            font-size: 2rem;
        }

        .faq-empty h3 {
            margin: .75rem 0 .35rem;
            font-size: 1.25rem;
            font-weight: 850;
        }

        .faq-empty p {
            max-width: 520px;
            margin: 0 auto;
            color: var(--pt-muted);
        }

        .faq-support-cta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: clamp(1.25rem, 3vw, 2rem);
            background:
                linear-gradient(135deg, rgba(15, 23, 42, .96), rgba(30, 64, 175, .92)),
                #0f172a;
            color: #ffffff;
        }

        .faq-support-cta .pt-eyebrow {
            color: #93c5fd;
        }

        .faq-support-cta h2 {
            max-width: 760px;
            margin: .25rem 0 .5rem;
            font-weight: 850;
        }

        .faq-support-cta p {
            max-width: 740px;
            margin: 0;
            color: rgba(255, 255, 255, .72);
        }

        .faq-support-actions {
            display: flex;
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: .75rem;
        }

        .faq-support-cta .btn-outline-primary {
            border-color: rgba(255, 255, 255, .45);
            color: #ffffff;
        }

        .faq-support-cta .btn-outline-primary:hover {
            background: rgba(255, 255, 255, .1);
            border-color: #ffffff;
            color: #ffffff;
        }

        .faq-support-modal .modal-header,
        .faq-support-modal .modal-footer {
            border-color: var(--pt-border);
        }

        .faq-form-status {
            min-height: 1.5rem;
            color: var(--pt-muted);
            font-weight: 700;
        }

        .faq-form-status.is-success {
            color: var(--pt-accent);
        }

        .faq-form-status.is-error {
            color: var(--pt-danger, #dc2626);
        }

        @@media (max-width: 991.98px) {
            .faq-hero,
            .faq-layout {
                grid-template-columns: 1fr;
            }

            .faq-sidebar {
                position: static;
            }

            .faq-category-list {
                display: flex;
                gap: .5rem;
                overflow-x: auto;
                padding-bottom: .15rem;
                scroll-snap-type: x proximity;
            }

            .faq-category-btn {
                width: auto;
                flex: 0 0 auto;
                white-space: nowrap;
                scroll-snap-align: start;
            }

            .faq-support-cta {
                align-items: stretch;
                flex-direction: column;
            }

            .faq-support-actions {
                justify-content: flex-start;
            }
        }

        @@media (max-width: 575.98px) {
            .faq-hero {
                padding: 1.1rem;
            }

            .faq-title {
                font-size: 2.1rem;
            }

            .faq-search-wrap {
                min-height: 52px;
                border-radius: 16px;
            }

            .faq-hero-actions .btn,
            .faq-support-actions .btn {
                width: 100%;
            }

            .faq-result-bar {
                align-items: flex-start;
                flex-direction: column;
            }

            .faq-section-heading {
                align-items: flex-start;
            }

            .faq-item .accordion-button {
                align-items: flex-start;
                flex-direction: column;
            }
        }
    </style>
}

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const page = document.querySelector('[data-faq-page]');
            if (!page) return;

            const searchInput = page.querySelector('[data-faq-search]');
            const categoryButtons = Array.from(page.querySelectorAll('[data-faq-category]'));
            const sections = Array.from(page.querySelectorAll('[data-faq-section]'));
            const items = Array.from(page.querySelectorAll('[data-faq-item]'));
            const emptyState = page.querySelector('[data-faq-empty]');
            const countEl = page.querySelector('[data-faq-count]');
            let activeCategory = 'all';

            function normalize(value) {
                return (value || '')
                    .toString()
                    .toLocaleLowerCase('vi-VN')
                    .normalize('NFD')
                    .replace(/[\u0300-\u036f]/g, '')
                    .replace(/đ/g, 'd');
            }

            function setCategory(slug) {
                activeCategory = slug || 'all';
                categoryButtons.forEach(function (button) {
                    const isActive = button.dataset.faqCategory === activeCategory;
                    button.classList.toggle('active', isActive);
                    button.setAttribute('aria-pressed', isActive ? 'true' : 'false');
                });
                applyFilters();
            }

            function applyFilters() {
                const query = normalize(searchInput ? searchInput.value : '');
                let visibleCount = 0;

                items.forEach(function (item) {
                    const categoryMatch = activeCategory === 'all' || item.dataset.faqCategory === activeCategory;
                    const textMatch = !query || normalize(item.dataset.faqText).includes(query);
                    const visible = categoryMatch && textMatch;
                    item.hidden = !visible;
                    if (visible) visibleCount++;
                });

                sections.forEach(function (section) {
                    const visibleItems = section.querySelectorAll('[data-faq-item]:not([hidden])').length;
                    section.hidden = visibleItems === 0;
                });

                if (emptyState) emptyState.hidden = visibleCount > 0;
                if (countEl) countEl.textContent = visibleCount + (visibleCount === 1 ? ' câu hỏi' : ' câu hỏi');
            }

            categoryButtons.forEach(function (button) {
                button.addEventListener('click', function () {
                    setCategory(button.dataset.faqCategory);
                });
            });

            if (searchInput) {
                searchInput.addEventListener('input', applyFilters);
            }

            page.querySelectorAll('[data-open-chatbot]').forEach(function (button) {
                button.addEventListener('click', function () {
                    const widget = document.getElementById('chatbot-widget');
                    if (widget) {
                        widget.style.display = 'flex';
                        widget.style.flexDirection = 'column';
                        const input = document.getElementById('chat-input');
                        if (input) input.focus();
                    }
                });
            });

            const supportForm = document.getElementById('faqSupportForm');
            if (supportForm) {
                supportForm.addEventListener('submit', async function (event) {
                    event.preventDefault();
                    const status = supportForm.querySelector('[data-faq-support-status]');
                    const submitButton = supportForm.querySelector('button[type="submit"]');
                    const formData = new FormData(supportForm);

                    if (status) {
                        status.className = 'faq-form-status';
                        status.textContent = 'Đang gửi yêu cầu...';
                    }
                    if (submitButton) submitButton.disabled = true;

                    try {
                        const response = await fetch(supportForm.action, {
                            method: 'POST',
                            body: formData,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (!response.ok) throw new Error('Request failed');
                        const payload = await response.json();
                        if (!payload.success) throw new Error('Request failed');

                        if (status) {
                            status.className = 'faq-form-status is-success';
                            status.textContent = 'Đã gửi yêu cầu hỗ trợ. Mã ticket: #' + payload.ticketId;
                        }
                        supportForm.reset();
                    } catch (error) {
                        if (status) {
                            status.className = 'faq-form-status is-error';
                            status.textContent = 'Chưa gửi được yêu cầu. Vui lòng thử lại hoặc gọi hotline 1900 1234.';
                        }
                    } finally {
                        if (submitButton) submitButton.disabled = false;
                    }
                });
            }

            applyFilters();
        });
    </script>
}
