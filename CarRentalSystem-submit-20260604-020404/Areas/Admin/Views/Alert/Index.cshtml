@model IEnumerable<CarRentalSystem.Models.Alert>
@{
    ViewData["Title"] = "Cảnh báo An ninh";
    Layout = "_AdminLayout";
    var alerts = Model?.ToList() ?? new List<CarRentalSystem.Models.Alert>();
    var activeAlerts = alerts.Count(a => a.Status != "Resolved");
    var inspectionAlerts = alerts.Count(a => a.AlertType == "InspectionExpiring");
}

<div class="theme-admin">
<style>
    .alert-ops-header {
        display: flex;
        align-items: stretch;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 22px;
    }

    .alert-ops-summary {
        display: grid;
        grid-template-columns: repeat(3, minmax(120px, 1fr));
        gap: 10px;
        min-width: min(520px, 48%);
    }

    .alert-ops-card {
        padding: 14px;
        border: 1px solid var(--admin-border);
        border-radius: 8px;
        background: var(--admin-surface);
        box-shadow: 0 8px 20px rgba(15, 23, 42, .06);
    }

    .alert-ops-card span {
        color: var(--admin-text-muted);
        font-size: .72rem;
        font-weight: 850;
        text-transform: uppercase;
    }

    .alert-ops-card strong {
        display: block;
        margin-top: 4px;
        font-size: 1.45rem;
        line-height: 1;
    }

    .alert-table-card {
        border: 1px solid var(--admin-border);
        border-radius: 8px;
        overflow: hidden;
        background: var(--admin-surface);
        box-shadow: 0 8px 20px rgba(15, 23, 42, .06);
    }

    @@media (max-width: 991.98px) {
        .alert-ops-header {
            flex-direction: column;
        }

        .alert-ops-summary {
            min-width: 0;
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="alert-ops-header">
    <div>
        <div class="text-uppercase fw-bold text-primary mb-2" style="font-size:.72rem;letter-spacing:.08em;">Operations alert center</div>
        <h2 class="fw-800 mb-1">Giám sát An ninh & Vận hành</h2>
        <p class="text-muted mb-0">Theo dõi cảnh báo an ninh, đăng kiểm, bảo trì và quá hạn trả xe trong một màn hình.</p>
    </div>
    <div class="alert-ops-summary">
        <div class="alert-ops-card">
            <span>Tổng cảnh báo</span>
            <strong>@alerts.Count</strong>
        </div>
        <div class="alert-ops-card">
            <span>Đang mở</span>
            <strong class="text-warning">@activeAlerts</strong>
        </div>
        <div class="alert-ops-card">
            <span>Đăng kiểm</span>
            <strong class="text-danger">@inspectionAlerts</strong>
        </div>
    </div>
</div>

<div class="alert-table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light text-muted small text-uppercase fw-bold">
                <tr>
                    <th class="ps-4 py-3">Phương tiện</th>
                    <th class="py-3">Loại cảnh báo</th>
                    <th class="py-3">Thời điểm</th>
                    <th class="py-3">Trạng thái</th>
                    <th class="py-3">Mô tả</th>
                    <th class="pe-4 py-3 text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var alert in alerts)
                {
                    <tr>
                        <td class="ps-4">
                            <span class="fw-800 text-dark">@alert.Car.CarName</span><br />
                            <small class="text-muted">@alert.Car.LicensePlate</small>
                        </td>
                        <td>
                            @switch (alert.AlertType)
                            {
                                case "OffRoute":
                                    <span class="badge bg-warning bg-opacity-10 text-warning px-3 rounded-pill border border-warning border-opacity-25 ripple-warning">
                                        <i class="bi bi-compass me-1"></i> Sai lộ trình
                                    </span>
                                    break;
                                case "TheftRisk":
                                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 rounded-pill border border-danger border-opacity-25 ripple-danger">
                                        <i class="bi bi-incognito me-1"></i> Nguy cơ mất trộm
                                    </span>
                                    break;
                                case "SuspiciousStop":
                                    <span class="badge bg-dark bg-opacity-10 text-dark px-3 rounded-pill border border-dark border-opacity-25">
                                        <i class="bi bi-clock-history me-1"></i> Dừng lâu bất thường
                                    </span>
                                    break;
                                case "InspectionExpiring":
                                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 rounded-pill border border-danger border-opacity-25">
                                        <i class="bi bi-shield-exclamation me-1"></i> Đăng kiểm
                                    </span>
                                    break;
                                case "MaintenanceDue":
                                    <span class="badge bg-warning bg-opacity-10 text-warning px-3 rounded-pill border border-warning border-opacity-25">
                                        <i class="bi bi-tools me-1"></i> Bảo dưỡng
                                    </span>
                                    break;
                                case "OilChangeDue":
                                    <span class="badge bg-primary bg-opacity-10 text-primary px-3 rounded-pill border border-primary border-opacity-25">
                                        <i class="bi bi-droplet-half me-1"></i> Thay dầu
                                    </span>
                                    break;
                                case "OverdueReturn":
                                    <span class="badge bg-danger bg-opacity-10 text-danger px-3 rounded-pill border border-danger border-opacity-25">
                                        <i class="bi bi-clock-history me-1"></i> Quá hạn trả xe
                                    </span>
                                    break;
                                default:
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary px-3 rounded-pill">@alert.AlertType</span>
                                    break;
                            }
                        </td>
                        <td class="small text-muted">@alert.AlertTime.ToString("HH:mm - dd/MM/yyyy")</td>
                        <td>
                            @{
                                var statusClass = alert.Status switch
                                {
                                    "New" => "bg-info text-info",
                                    "Active" => "bg-warning text-warning",
                                    "Critical" => "bg-danger text-danger",
                                    "Resolved" => "bg-success text-success",
                                    _ => "bg-secondary text-secondary"
                                };
                                var statusText = alert.Status switch
                                {
                                    "New" => "Mới",
                                    "Active" => "Đang theo dõi",
                                    "Critical" => "Khẩn cấp",
                                    "Resolved" => "Đã xử lý",
                                    _ => alert.Status
                                };
                            }
                            <span class="badge @statusClass bg-opacity-10 fw-bold">@statusText</span>
                        </td>
                        <td><small class="text-muted">@alert.Description</small></td>
                        <td class="text-end pe-4">
                            @if (alert.Status != "Resolved")
                            {
                                <form asp-action="Resolve" asp-route-id="@alert.AlertID" method="post" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 fw-bold" style="font-size: 0.75rem;">
                                        <i class="bi bi-check-lg me-1"></i> Đánh dấu đã xong
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
</div>
