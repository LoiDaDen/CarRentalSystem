@model List<CarRentalSystem.Models.MembershipTier>
@{
    ViewData["Title"] = "Hạng Thành Viên & Hợp đồng";
    var contractTypes = ViewBag.ContractTypes as List<CarRentalSystem.Models.ContractType>;
}

<div class="theme-admin">
    <!-- Page Header -->
    <div class="page-header mb-4">
        <div>
            <h2 class="fw-800 ls-neg-1 mb-1">
                <i class="bi bi-gem me-2" style="color: var(--admin-info);"></i>Hạng Thành Viên & Hợp đồng
            </h2>
            <p class="text-muted mb-0">Quản lý chương trình khách hàng thân thiết & loại hợp đồng</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Membership Tiers Section -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-award me-2" style="color: var(--admin-primary);"></i>Hạng thành viên (@Model.Count hạng)
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                @foreach (var tier in Model)
                {
                    <div class="col-md-6 col-xl-4">
                        <div class="card h-100" style="border-left: 4px solid @tier.Color !important;">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <h6 class="fw-bold mb-0">
                                        <i class="bi @tier.Icon me-1" style="color: @tier.Color;"></i>
                                        @tier.Name
                                    </h6>
                                    <button class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#tierModal-@tier.MembershipTierID">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                </div>
                                <div class="small">
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Chi tiêu tối thiểu:</span>
                                        <span class="fw-bold">@tier.MinSpending.ToString("N0") đ</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Giảm giá:</span>
                                        <span class="fw-bold" style="color: var(--admin-success);">@tier.DiscountPercent%</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Free ship (km):</span>
                                        <span class="fw-bold">@tier.FreeDeliveryKm km</span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-1">
                                        <span class="text-muted">Giờ thuê miễn phí:</span>
                                        <span class="fw-bold">@tier.ExtraFreeHours h</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="text-muted">Hỗ trợ ưu tiên:</span>
                                        <span>@(tier.PrioritySupport ? "✅" : "❌")</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Edit Modal -->
                    <div class="modal fade" id="tierModal-@tier.MembershipTierID" tabindex="-1">
                        <div class="modal-dialog">
                            <form asp-action="UpdateTier" method="post">
                                <div class="modal-content rounded-4">
                                    <div class="modal-header border-0">
                                        <h5 class="modal-title fw-bold">Sửa hạng @tier.Name</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body">
                                        <input type="hidden" name="MembershipTierID" value="@tier.MembershipTierID" />
                                        <div class="row g-3">
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Tên hạng</label>
                                                <input type="text" name="Name" value="@tier.Name" class="form-control" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Màu sắc</label>
                                                <input type="color" name="Color" value="@tier.Color" class="form-control form-control-color w-100" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Chi tiêu tối thiểu (đ)</label>
                                                <input type="number" name="MinSpending" value="@tier.MinSpending" class="form-control" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Giảm giá (%)</label>
                                                <input type="number" step="0.01" name="DiscountPercent" value="@tier.DiscountPercent" class="form-control" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Free ship (km)</label>
                                                <input type="number" name="FreeDeliveryKm" value="@tier.FreeDeliveryKm" class="form-control" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Giờ miễn phí</label>
                                                <input type="number" name="ExtraFreeHours" value="@tier.ExtraFreeHours" class="form-control" />
                                            </div>
                                            <div class="col-6">
                                                <label class="form-label small fw-bold">Icon (bi-*)</label>
                                                <input type="text" name="Icon" value="@tier.Icon" class="form-control" />
                                            </div>
                                            <div class="col-6 d-flex align-items-end">
                                                <div class="form-check">
                                                    <input type="checkbox" name="PrioritySupport" value="true" class="form-check-input" @(tier.PrioritySupport ? "checked" : "") />
                                                    <label class="form-check-label small">Hỗ trợ ưu tiên</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0">
                                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                                        <button type="submit" class="btn btn-primary"><i class="bi bi-check me-1"></i>Lưu</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Contract Types Section -->
    <div class="card">
        <div class="card-header">
            <h5 class="fw-bold mb-0">
                <i class="bi bi-file-earmark-text me-2" style="color: var(--admin-primary);"></i>Loại hợp đồng (@(contractTypes?.Count ?? 0) loại)
            </h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr style="color: var(--admin-text-secondary);">
                            <th class="ps-4">Tên</th>
                            <th>Mô tả</th>
                            <th class="text-center">Giảm giá</th>
                            <th class="text-center">Thời hạn (ngày)</th>
                            <th class="text-center">Bảo trì</th>
                            <th class="text-center">Bảo hiểm</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-center">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (contractTypes != null)
                        {
                            @foreach (var ct in contractTypes)
                            {
                                <tr class="@(!ct.IsActive ? "opacity-50" : "")">
                                    <td class="ps-4 fw-bold">@ct.Name</td>
                                    <td class="small text-muted" style="max-width: 200px;">@ct.Description</td>
                                    <td class="text-center">
                                        <span class="badge bg-success-subtle text-success border border-success fw-bold">@ct.DiscountPercent%</span>
                                    </td>
                                    <td class="text-center small">@ct.MinDurationDays - @ct.MaxDurationDays</td>
                                    <td class="text-center">@ct.FreeMaintenanceCount lần</td>
                                    <td class="text-center">@(ct.FreeInsurance ? "✅" : "❌")</td>
                                    <td class="text-center">
                                        @if (ct.IsActive)
                                        {
                                            <span class="badge bg-success rounded-pill">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary rounded-pill">Tắt</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="ToggleContract" asp-route-id="@ct.ContractTypeID" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(ct.IsActive ? "Tắt" : "Bật")">
                                                <i class="bi @(ct.IsActive ? "bi-toggle-on text-success" : "bi-toggle-off")"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
