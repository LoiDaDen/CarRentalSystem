@model AdminBlogFormViewModel
@{
    ViewData["Title"] = "Sửa bài viết Blog";
    Layout = "_AdminLayout";
}

<div class="theme-admin">
    <div class="page-header mb-4">
        <div>
            <h2 class="fw-800 mb-1"><i class="bi bi-pencil-square me-2 text-primary"></i>Sửa bài viết Blog</h2>
            <p class="text-muted mb-0">Cập nhật nội dung, SEO, hình ảnh và trạng thái xuất bản.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="" asp-controller="Blog" asp-action="Detail" asp-route-slug="@Model.Slug" target="_blank" class="btn btn-outline-primary rounded-3 fw-bold">
                <i class="bi bi-eye me-1"></i>Preview
            </a>
            <a asp-action="Index" class="btn btn-outline-secondary rounded-3 fw-bold">Quay lại</a>
        </div>
    </div>

    <form asp-action="Edit" asp-route-id="@Model.BlogID" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input asp-for="BlogID" type="hidden" />
        @await Html.PartialAsync("_FormFields", Model)
        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-3 fw-bold px-4">Hủy</a>
            <button type="submit" class="btn btn-primary rounded-3 fw-bold px-4">Lưu thay đổi</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin/blog-form.js" asp-append-version="true"></script>
}
