@using CarRentalSystem.Helpers
@model PaginatedList<CarRentalSystem.Models.Area>
@{
    ViewData["Title"] = "Quản lý Khu vực";
    Layout = "_AdminLayout";

    var provinces = ViewBag.Provinces as List<string> ?? new();
    var currentSearch = ViewBag.CurrentSearch as string ?? "";
    var currentProvince = ViewBag.CurrentProvince as string ?? "";
    var currentStatus = ViewBag.CurrentStatus as string ?? "";

    int index = (Model.PageIndex - 1) * Model.PageSize + 1;
    var userAreaIds = ViewBag.UserAreaIds as List<int> ?? new();
    var currentUserId = int.TryParse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value
        ?? User.FindFirst("sub")?.Value ?? User.FindFirst("UserID")?.Value, out var uid) ? uid : 0;
}

<div class="theme-admin">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@TempData["Error"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="page-header mb-4">
        <div>
            <h2 class="fw-800 ls-neg-1 mb-1">
                <i class="bi bi-geo-alt-fill me-2" style="color: var(--admin-primary);"></i>Quản lý Khu vực
            </h2>
            <p class="text-muted mb-0">Phân chia và quản lý khu vực hoạt động trên toàn hệ thống.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Admin" asp-controller="Area" asp-action="Trash" class="btn btn-outline-danger rounded-3 px-4 fw-bold">
                <i class="bi bi-trash3 me-2"></i>Thùng rác
            </a>
            @if (User.IsInRole("Admin"))
            {
                <a asp-area="Admin" asp-controller="Area" asp-action="Create" class="btn btn-primary rounded-3 px-4 fw-bold">
                    <i class="bi bi-plus-lg me-2"></i>Thêm khu vực
                </a>
            }
        </div>
    </div>

    <!-- Filter Bar -->
    <div class="filter-bar">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold text-uppercase">Tìm kiếm</label>
                <div class="search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" value="@currentSearch"
                           class="form-control"
                           placeholder="Tên hoặc mã khu vực..." />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold text-uppercase">Tỉnh / Thành phố</label>
                <select name="province" class="form-select">
                    <option value="">— Tất cả tỉnh —</option>
                    @foreach (var prov in provinces)
                    {
                        <option value="@prov" selected="@(currentProvince == prov)">@prov</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold text-uppercase">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">— Tất cả —</option>
                    <option value="active" selected="@(currentStatus == "active")">Đang hoạt động</option>
                    <option value="inactive" selected="@(currentStatus == "inactive")">Tạm ngưng</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary rounded-3 fw-bold flex-grow-1">
                    <i class="bi bi-filter me-2"></i>Lọc
                </button>
                @if (!string.IsNullOrEmpty(currentSearch) || !string.IsNullOrEmpty(currentProvince) || !string.IsNullOrEmpty(currentStatus))
                {
                    <a asp-area="Admin" asp-controller="Area" asp-action="Index" class="btn btn-outline-secondary rounded-3">
                        <i class="bi bi-x-lg"></i>
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Stats Summary -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="admin-stat-card" style="border-left: 4px solid var(--admin-primary);">
                <h3 class="fw-800 mb-0" style="font-size: 1.75rem; color: var(--admin-primary);">@Model.TotalCount</h3>
                <small class="fw-bold text-uppercase" style="font-size: 0.7rem; color: var(--admin-text-muted); letter-spacing: 1px;">Tổng khu vực</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="admin-stat-card" style="border-left: 4px solid var(--admin-success);">
                <h3 class="fw-800 mb-0" style="font-size: 1.75rem; color: var(--admin-success);">@Model.Count(a => a.Status == "active")</h3>
                <small class="fw-bold text-uppercase" style="font-size: 0.7rem; color: var(--admin-text-muted); letter-spacing: 1px;">Đang hoạt động</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="admin-stat-card" style="border-left: 4px solid var(--admin-warning);">
                <h3 class="fw-800 mb-0" style="font-size: 1.75rem; color: var(--admin-warning);">@Model.Count(a => a.Status == "inactive")</h3>
                <small class="fw-bold text-uppercase" style="font-size: 0.7rem; color: var(--admin-text-muted); letter-spacing: 1px;">Tạm ngưng</small>
            </div>
        </div>
        <div class="col-md-3">
            <div class="admin-stat-card" style="border-left: 4px solid var(--admin-purple);">
                <h3 class="fw-800 mb-0" style="font-size: 1.75rem; color: var(--admin-purple);">@Model.Sum(a => a.AreaStaffs?.Count(st => !st.IsDeleted))</h3>
                <small class="fw-bold text-uppercase" style="font-size: 0.7rem; color: var(--admin-text-muted); letter-spacing: 1px;">Nhân sự quản lý</small>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr class="small text-uppercase fw-bold" style="color: var(--admin-text-secondary);">
                        <th class="ps-4">STT</th>
                        <th>Tên khu vực</th>
                        <th>Mã</th>
                        <th>Tỉnh / TP</th>
                        <th>Manager</th>
                        <th class="text-center">Địa điểm</th>
                        <th class="text-center">Xe</th>
                        <th class="text-center">Nhân sự</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <div class="empty-state">
                                    <i class="bi bi-geo-alt fs-1"></i>
                                    <p class="mt-2 mb-0">Chưa có khu vực nào.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    @foreach (var area in Model)
                    {
                        var activeStaffs = area.AreaStaffs?.Where(s => !s.IsDeleted).ToList() ?? new();
                        var activeLocations = area.AreaLocations?.Where(l => !l.IsDeleted).ToList() ?? new();
                        var totalCars = activeLocations.Sum(l => l.Location?.Cars?.Count(c => !c.IsDeleted) ?? 0);
                        var activeStatus = area.Status == "active";
                        var isMyAreaManager = activeStaffs.Any(s => s.UserID == currentUserId && s.RoleInArea == "manager");

                        <tr>
                            <td class="ps-4 text-muted fw-medium">@(index++)</td>
                            <td>
                                <div class="fw-bold">@area.Name</div>
                                <small class="text-muted">@area.Address</small>
                            </td>
                            <td>
                                <span class="badge bg-light border fw-bold d-block" style="font-family: monospace; font-size: 0.75rem;">
                                    @area.Code
                                </span>
                            </td>
                            <td>
                                <span class="fw-medium">@area.Province</span>
                            </td>
                            <td>
                                @if (area.Manager != null)
                                {
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white"
                                             style="width:28px;height:28px;font-size:0.7rem; font-weight:700; background: var(--admin-primary);">
                                            @area.Manager.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-medium small">@area.Manager.Name</div>
                                            <div class="text-muted" style="font-size:0.7rem;">@area.Manager.Email</div>
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-secondary rounded-3">@activeLocations.Count</span>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-info rounded-3">@totalCars</span>
                            </td>
                            <td class="text-center">
                                @{
                                    var displayStaffs = activeStaffs.Take(4).ToList();
                                    var extraCount = activeStaffs.Count - 4;
                                }
                                <div class="d-flex align-items-center justify-content-center gap-1 flex-wrap">
                                    @foreach (var s in displayStaffs)
                                    {
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white"
                                             style="width:28px;height:28px;font-size:0.65rem;font-weight:700; background:@(s.RoleInArea == "manager" ? "var(--admin-danger)" : s.RoleInArea == "staff" ? "var(--admin-warning)" : "var(--admin-text-muted)"); border:2px solid var(--admin-surface); cursor:default;"
                                             title="@s.User?.Name (@s.RoleInArea)">
                                            @(s.User?.Name?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                    }
                                    @if (extraCount > 0)
                                    {
                                        <div class="rounded-circle d-flex align-items-center justify-content-center border"
                                             style="width:28px;height:28px;font-size:0.6rem;font-weight:700; background: var(--admin-surface-2); color: var(--admin-text-muted); border-color: var(--admin-surface) !important;"
                                             title="+@extraCount nhân sự khác">
                                            +@extraCount
                                        </div>
                                    }
                                    @if (activeStaffs.Count == 0)
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </div>
                            </td>
                            <td>
                                @if (activeStatus)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-2 fw-bold" style="font-size:0.72rem;">
                                        <i class="bi bi-check-circle-fill me-1"></i>Đang hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger rounded-pill px-3 py-2 fw-bold" style="font-size:0.72rem;">
                                        <i class="bi bi-x-circle-fill me-1"></i>Tạm ngưng
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex gap-1 justify-content-end">
                                    <a asp-area="Admin" asp-controller="Area" asp-action="Show" asp-route-id="@area.AreaID"
                                       class="btn btn-outline-secondary btn-sm rounded-3" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (User.IsInRole("Admin"))
                                    {
                                        <a asp-area="Admin" asp-controller="Area" asp-action="Edit" asp-route-id="@area.AreaID"
                                           class="btn btn-outline-primary btn-sm rounded-3" title="Sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <form asp-area="Admin" asp-controller="Area" asp-action="Delete" asp-route-id="@area.AreaID"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Bạn có chắc muốn xóa khu vực &quot;@area.Name&quot; không?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-3" title="Xóa">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer border-0 rounded-bottom-4">
                <div class="d-flex justify-content-between align-items-center">
                    <div class="text-muted small">
                        Hiển thị <strong>@((Model.PageIndex - 1) * Model.PageSize + 1)</strong> – <strong>@Math.Min(Model.PageIndex * Model.PageSize, Model.TotalCount)</strong>
                        trong <strong>@Model.TotalCount</strong> khu vực
                    </div>
                    <nav>
                        <ul class="pagination pagination-sm mb-0 gap-1">
                            @if (Model.HasPreviousPage)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-3" asp-action="Index"
                                       asp-route-page="1"
                                       asp-route-search="@currentSearch"
                                       asp-route-province="@currentProvince"
                                       asp-route-status="@currentStatus">
                                        <i class="bi bi-chevron-double-left"></i>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link rounded-3" asp-action="Index"
                                       asp-route-page="@(Model.PageIndex - 1)"
                                       asp-route-search="@currentSearch"
                                       asp-route-province="@currentProvince"
                                       asp-route-status="@currentStatus">
                                        <i class="bi bi-chevron-left"></i>
                                    </a>
                                </li>
                            }

                            @foreach (var p in Model.GetPageRange(7))
                            {
                                <li class="page-item @(p == Model.PageIndex ? "active" : "")">
                                    <a class="page-link rounded-3"
                                       asp-action="Index"
                                       asp-route-page="@p"
                                       asp-route-search="@currentSearch"
                                       asp-route-province="@currentProvince"
                                       asp-route-status="@currentStatus">
                                        @p
                                    </a>
                                </li>
                            }

                            @if (Model.HasNextPage)
                            {
                                <li class="page-item">
                                    <a class="page-link rounded-3" asp-action="Index"
                                       asp-route-page="@(Model.PageIndex + 1)"
                                       asp-route-search="@currentSearch"
                                       asp-route-province="@currentProvince"
                                       asp-route-status="@currentStatus">
                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link rounded-3" asp-action="Index"
                                       asp-route-page="@Model.TotalPages"
                                       asp-route-search="@currentSearch"
                                       asp-route-province="@currentProvince"
                                       asp-route-status="@currentStatus">
                                        <i class="bi bi-chevron-double-right"></i>
                                    </a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            </div>
        }
    </div>
</div>
