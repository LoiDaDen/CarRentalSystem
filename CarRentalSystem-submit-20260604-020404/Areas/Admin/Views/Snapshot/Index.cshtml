<div class="theme-admin">
@* CarRentalSystem/Areas/Admin/Views/Snapshot/Index.cshtml *@
@model IEnumerable<CarRentalSystem.Models.DbSnapshot>
@{
    ViewData["Title"] = "Sao lưu & Phục hồi";
    Layout = "_AdminLayout";

    var readySnapshots = Model.Where(s => s.Status == "Ready").ToList();
    var otherSnapshots = Model.Where(s => s.Status != "Ready").ToList();
}

<!-- Flash Messages -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-2 animate__animated animate__fadeInDown">
        <i class="bi bi-check-circle-fill text-success"></i>
        <span>@TempData["Success"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-2 animate__animated animate__fadeInDown">
        <i class="bi bi-exclamation-triangle-fill text-danger"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h2 class="fw-800 ls-neg-1 mb-1">
            <i class="bi bi-database-check text-primary me-2"></i>Sao lưu & Phục hồi
        </h2>
        <p class="text-muted mb-0">Tạo, quản lý và phục hồi bản sao lưu dữ liệu hệ thống.</p>
    </div>
    <div class="d-flex gap-2">
        <button class="btn btn-primary rounded-3 px-4 fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#createSnapshotModal">
            <i class="bi bi-plus-lg me-2"></i>Tạo bản sao lưu
        </button>
    </div>
</div>

<!-- Info Banner -->
<div class="alert alert-info border-0 rounded-4 shadow-sm mb-4 d-flex align-items-start gap-3">
    <i class="bi bi-info-circle-fill text-info fs-4 mt-1"></i>
    <div>
        <strong>Hướng dẫn:</strong> Bản sao lưu lưu trữ toàn bộ dữ liệu dưới dạng JSON. Bạn có thể tải về để lưu trữ an toàn hoặc phục hồi khi cần.
        <br><small class="text-muted">Khuyến nghị tạo bản sao lưu trước khi thực hiện thay đổi lớn hoặc nâng cấp hệ thống.</small>
    </div>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4 text-center py-3">
            <div class="card-body">
                <div class="text-primary mb-1"><i class="bi bi-archive fs-2"></i></div>
                <h3 class="mb-0 fw-bolder text-primary">@readySnapshots.Count</h3>
                <small class="text-muted fw-bold">Bản sao lưu</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4 text-center py-3">
            <div class="card-body">
                <div class="text-success mb-1"><i class="bi bi-check-circle fs-2"></i></div>
                <h3 class="mb-0 fw-bolder text-success">@Model.Count(s => s.Status == "Restored")</h3>
                <small class="text-muted fw-bold">Đã phục hồi</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4 text-center py-3">
            <div class="card-body">
                <div class="text-secondary mb-1"><i class="bi bi-hdd fs-2"></i></div>
                <h3 class="mb-0 fw-bolder text-secondary">@Model.Sum(s => s.TotalRows).ToString("N0")</h3>
                <small class="text-muted fw-bold">Tổng dòng dữ liệu</small>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm rounded-4 text-center py-3">
            <div class="card-body">
                <div class="text-warning mb-1"><i class="bi bi-download fs-2"></i></div>
                <h3 class="mb-0 fw-bolder text-warning">@Model.Sum(s => s.DataSizeBytes).ToString("N0")</h3>
                <small class="text-muted fw-bold">Bytes đã lưu</small>
            </div>
        </div>
    </div>
</div>

<!-- Snapshots Table -->
<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white border-bottom py-3">
        <div class="d-flex align-items-center justify-content-between">
            <h5 class="mb-0 fw-bold"><i class="bi bi-list-ul me-2 text-primary"></i>Danh sách bản sao lưu</h5>
            <span class="badge bg-primary rounded-pill px-3 py-2">@Model.Count() bản</span>
        </div>
    </div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-archive text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-2 mb-0">Chưa có bản sao lưu nào. Hãy tạo bản sao lưu đầu tiên.</p>
                <button class="btn btn-primary mt-3" data-bs-toggle="modal" data-bs-target="#createSnapshotModal">
                    <i class="bi bi-plus-lg me-2"></i>Tạo bản sao lưu đầu tiên
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="px-4 py-3 fw-bold text-muted text-uppercase small">Bản sao lưu</th>
                            <th class="py-3 fw-bold text-muted text-uppercase small">Loại</th>
                            <th class="py-3 fw-bold text-muted text-uppercase small">Dung lượng</th>
                            <th class="py-3 fw-bold text-muted text-uppercase small">Dòng dữ liệu</th>
                            <th class="py-3 fw-bold text-muted text-uppercase small">Trạng thái</th>
                            <th class="py-3 fw-bold text-muted text-uppercase small">Ngày tạo</th>
                            <th class="py-3 fw-bold text-muted text-uppercase small text-end px-4">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            foreach (var snap in Model.OrderByDescending(s => s.CreatedAt))
                            {
                                var statusBadge = snap.Status switch
                                {
                                    "Ready" => "bg-success",
                                    "Restored" => "bg-info",
                                    "Creating" => "bg-warning text-dark",
                                    "Restoring" => "bg-warning text-dark",
                                    "Failed" => "bg-danger",
                                    "AutoDeleted" => "bg-secondary",
                                    _ => "bg-secondary"
                                };

                                var typeBadge = snap.SnapshotType switch
                                {
                                    "Full" => "bg-primary",
                                    "Partial" => "bg-secondary",
                                    "BeforeMigrate" => "bg-warning text-dark",
                                    _ => "bg-secondary"
                                };

                                <tr>
                                    <td class="px-4 py-3">
                                        <div class="fw-bold">@snap.Name</div>
                                        @if (!string.IsNullOrEmpty(snap.Description))
                                        {
                                            <small class="text-muted">@snap.Description</small>
                                        }
                                        @if (snap.IsAutoGenerated)
                                        {
                                            <span class="badge bg-light text-dark border ms-1" style="font-size:0.6rem;">
                                                <i class="bi bi-clock me-1"></i>Tự động
                                            </span>
                                        }
                                    </td>
                                    <td class="py-3">
                                        <span class="badge @typeBadge rounded-pill px-2">@snap.SnapshotType</span>
                                    </td>
                                    <td class="py-3 text-muted small">
                                        @snap.DataSizeFormatted
                                        <br>
                                        <small class="text-secondary">@snap.TableCount bảng</small>
                                    </td>
                                    <td class="py-3 text-muted small">
                                        @snap.TotalRows.ToString("N0")
                                    </td>
                                    <td class="py-3">
                                        <span class="badge @statusBadge rounded-pill px-2">@snap.Status</span>
                                        @if (snap.Status == "Restored" && snap.RestoredAt.HasValue)
                                        {
                                            <br><small class="text-muted">@snap.RestoredAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                        }
                                        @if (snap.IsExpired)
                                        {
                                            <br><small class="text-danger">Đã hết hạn</small>
                                        }
                                    </td>
                                    <td class="py-3 text-muted small">
                                        @snap.CreatedAt.ToString("dd/MM/yyyy")
                                        <br>
                                        <small>@snap.CreatedAt.ToString("HH:mm:ss")</small>
                                    </td>
                                    <td class="py-3 text-end px-4">
                                        <div class="d-flex justify-content-end gap-1">
                                            @if (snap.Status == "Ready")
                                            {
                                                <a asp-area="Admin" asp-controller="Snapshot" asp-action="Details" asp-route-id="@snap.SnapshotID"
                                                   class="btn btn-sm btn-outline-secondary rounded-3 px-2" title="Xem chi tiết">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a asp-area="Admin" asp-controller="Snapshot" asp-action="Download" asp-route-id="@snap.SnapshotID"
                                                   class="btn btn-sm btn-outline-primary rounded-3 px-2" title="Tải về" download>
                                                    <i class="bi bi-download"></i>
                                                </a>
                                                <button class="btn btn-sm btn-outline-success rounded-3 px-2"
                                                        onclick="confirmRestore(@snap.SnapshotID, '@snap.Name.Replace("'", "\\'")')"
                                                        title="Phục hồi">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger rounded-3 px-2"
                                                    onclick="confirmDelete(@snap.SnapshotID, '@snap.Name.Replace("'", "\\'")')"
                                                    title="Xóa">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- ═══════════════════════════════════════════════════
     MODAL: TẠO BẢN SAO LƯU
═══════════════════════════════════════════════════ -->
<div class="modal fade" id="createSnapshotModal" tabindex="-1" aria-labelledby="createSnapshotModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom bg-primary bg-opacity-10">
                <h5 class="modal-title fw-bold" id="createSnapshotModalLabel">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Tạo bản sao lưu mới
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-area="Admin" asp-controller="Snapshot" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">
                            Tên bản sao lưu <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="name" class="form-control rounded-3" placeholder="VD: Backup trước khi nâng cấp" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">Mô tả</label>
                        <textarea name="description" class="form-control rounded-3" rows="2" placeholder="Mô tả ngắn gọn về bản sao lưu này..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small text-uppercase">Loại sao lưu</label>
                        <select name="type" class="form-select rounded-3">
                            <option value="Full" selected>Full — Toàn bộ dữ liệu (khuyến nghị)</option>
                            <option value="Partial">Partial — Dữ liệu cơ bản (xe, đơn, KH)</option>
                            <option value="BeforeMigrate">BeforeMigrate — Trước khi migrate</option>
                        </select>
                    </div>
                    <div class="alert alert-warning border-0 small mb-0">
                        <i class="bi bi-exclamation-triangle me-1"></i>
                        Quá trình tạo bản sao lưu có thể mất vài phút tùy theo lượng dữ liệu.
                    </div>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-primary rounded-3 px-4 fw-bold" id="createBtn">
                        <i class="bi bi-archive me-2"></i>Tạo bản sao lưu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════
     MODAL: XÁC NHẬN PHỤC HỒI
═══════════════════════════════════════════════════ -->
<div class="modal fade" id="restoreModal" tabindex="-1" aria-labelledby="restoreModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom bg-warning bg-opacity-10">
                <h5 class="modal-title fw-bold text-warning" id="restoreModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Xác nhận phục hồi
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-area="Admin" asp-controller="Snapshot" asp-action="Restore" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="restore_snapId" />
                <div class="modal-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-arrow-counterclockwise text-warning" style="font-size: 3rem;"></i>
                    </div>
                    <p class="mb-1">Bạn có chắc muốn phục hồi bản sao lưu:</p>
                    <p class="fw-bold text-primary mb-1" id="restore_snapName">—</p>
                    <div class="alert alert-danger border-0 small mt-3 mb-0 text-start">
                        <strong><i class="bi bi-exclamation-octagon me-1"></i>Cảnh báo:</strong>
                        Việc phục hồi sẽ ghi đè dữ liệu hiện tại.
                        Hãy chắc chắn rằng bạn đã sao lưu dữ liệu hiện tại trước khi phục hồi.
                    </div>
                </div>
                <div class="modal-footer border-top justify-content-center">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-success rounded-3 px-4 fw-bold">
                        <i class="bi bi-arrow-counterclockwise me-2"></i>Phục hồi ngay
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════
     MODAL: XÁC NHẬN XÓA
═══════════════════════════════════════════════════ -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-bottom bg-danger bg-opacity-10">
                <h5 class="modal-title fw-bold text-danger" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Xóa bản sao lưu
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-area="Admin" asp-controller="Snapshot" asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="delete_snapId" />
                <div class="modal-body text-center">
                    <div class="mb-3">
                        <i class="bi bi-trash text-danger" style="font-size: 3rem;"></i>
                    </div>
                    <p class="mb-1">Bạn có chắc muốn xóa bản sao lưu:</p>
                    <p class="fw-bold text-danger mb-1" id="delete_snapName">—</p>
                    <p class="text-muted small mb-0">Hành động này không thể hoàn tác.</p>
                </div>
                <div class="modal-footer border-top justify-content-center">
                    <button type="button" class="btn btn-outline-secondary rounded-3 px-4" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-danger rounded-3 px-4 fw-bold">
                        <i class="bi bi-trash me-2"></i>Xóa vĩnh viễn
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function confirmRestore(id, name) {
            document.getElementById('restore_snapId').value = id;
            document.getElementById('restore_snapName').textContent = name;
            new bootstrap.Modal(document.getElementById('restoreModal')).show();
        }

        function confirmDelete(id, name) {
            document.getElementById('delete_snapId').value = id;
            document.getElementById('delete_snapName').textContent = name;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        }

        // Loading state on create
        document.querySelector('#createSnapshotModal form').addEventListener('submit', function () {
            var btn = document.getElementById('createBtn');
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Đang tạo...';
        });
    </script>
}
</div>
