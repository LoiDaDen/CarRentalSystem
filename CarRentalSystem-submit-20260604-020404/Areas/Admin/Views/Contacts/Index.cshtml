@model IEnumerable<CarRentalSystem.Models.ContactMessage>
@{
    ViewData["Title"] = "Hỗ trợ khách hàng";
    Layout = "_AdminLayout";
}

<div class="theme-admin">
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success border-0 rounded-4 shadow-sm mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-check-circle-fill"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Page Header -->
    <div class="page-header mb-4">
        <div>
            <h2 class="fw-800 ls-neg-1 mb-1">
                <i class="bi bi-envelope-paper-heart me-2" style="color: var(--admin-primary);"></i>Trung tâm hỗ trợ (CRM)
            </h2>
            <p class="text-muted mb-0">Quản lý các yêu cầu, thắc mắc từ khách hàng.</p>
        </div>
        <div class="d-flex gap-2">
            <span class="badge bg-danger rounded-pill px-3 py-2 fs-6">
                @Model.Count(m => !m.IsResolved) chưa xử lý
            </span>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr class="small text-uppercase fw-bold" style="color: var(--admin-text-secondary);">
                        <th class="ps-4">Khách hàng</th>
                        <th>Tiêu đề</th>
                        <th>Ngày gửi</th>
                        <th>Trạng thái</th>
                        <th class="text-end pe-4">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var msg in Model)
                    {
                        <tr style="cursor: pointer;" onclick="window.location.href='@Url.Action("Details", new { id = msg.MessageID })'">
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold" style="width: 40px; height: 40px; background: var(--admin-primary-100); color: var(--admin-primary);">
                                        @msg.Name.Substring(0, 1).ToUpper()
                                    </div>
                                    <div>
                                        <div class="fw-bold">@msg.Name</div>
                                        <small class="text-muted">@msg.Email</small>
                                    </div>
                                </div>
                            </td>
                            <td class="fw-semibold @(msg.IsResolved ? "text-muted" : "")">
                                @msg.Subject
                            </td>
                            <td class="small text-muted">
                                @msg.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td>
                                @if (msg.IsResolved)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success rounded-pill px-3 py-1">
                                        <i class="bi bi-check2-all me-1"></i>Đã phản hồi
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger rounded-pill px-3 py-1">
                                        <i class="bi bi-clock me-1"></i>Chưa xử lý
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="Details" asp-route-id="@msg.MessageID" class="btn btn-outline-primary btn-sm rounded-3 px-3" onclick="event.stopPropagation();">
                                    Xem
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="empty-state">
                                    <i class="bi bi-inbox display-4 opacity-10 d-block mb-3"></i>
                                    <p class="fw-bold opacity-50 mb-0">Hộp thư hỗ trợ đang trống</p>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
