# Copy this file to .env on the Windows bridge machine.
# Do not commit the real .env file.

NVR_PASSWORD=YOUR_NVR_PASSWORD

# Leave blank while the web app is not deployed. Set webhook.enabled=true in config.yaml
# only after WEBHOOK_URL and camera secrets are ready in the Admin Camera screen.
WEBHOOK_URL=
WEBHOOK_SECRET_CAM_IN_05=
WEBHOOK_SECRET_CAM_IN_13=
WEBHOOK_SECRET_CAM_OUT_02=
WEBHOOK_SECRET_CAM_OUT_03=
WEBHOOK_SECRET_CAM_OUT_15=
